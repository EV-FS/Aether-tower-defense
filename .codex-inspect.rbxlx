          <Item class="ModuleScript" referent="619">
            <Properties>
              <string name="Name">TowerService</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

--/Modules
local BaseTower = require(ServerScriptService.Server.Classes.Tower.BaseTower)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local Net = require(ReplicatedStorage.Shared.Net)
local PlaceValidator = require(ReplicatedStorage.Shared.Services.Entities.TowerService.Utils.PlaceValidator)
local TowerRegistry = require(script.Registry)

local DataService
local EconomyService

--/Variables
local towerClasses = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getSortedPlayers()
	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		if a.UserId == b.UserId then
			return a.Name < b.Name
		end
		return a.UserId < b.UserId
	end)

	return players
end

local function getPlayerSlot(player: Player): number
	for index, sortedPlayer in getSortedPlayers() do
		if sortedPlayer == player then
			return index
		end
	end

	return 0
end

-------------------------------------------------
--// TowerService
-------------------------------------------------
local TowerService = {}
TowerService.PlacedTowers = {}

function TowerService.GetTowerCount(player: Player, towerName: string)
	local playerData = TowerService.PlacedTowers[player.UserId]
	return (playerData and playerData[towerName]) or 0
end

function TowerService.SpawnTower(player: Player, towerName: string, towerKey: string, spawnLocation: Vector3)
	local towerModel = ReplicatedStorage.Assets.Towers:FindFirstChild(towerName)
	if not towerModel then
		warn(`{towerName}의 이름을 가진 모델을 찾을 수 없습니다.`)
		return
	end

	local borderRadius = towerModel.PrimaryPart.Size.X * 1.5
	local sendData = {
		["TowerName"] = towerName,
		["SpawnPosition"] = spawnLocation,
		["BorderRadius"] = borderRadius,
		["CurrentCash"] = EconomyService.GetCash(player),
		["CurrentCount"] = TowerService.GetTowerCount(player, towerName),
	}

	local canSpawn, errorMsg = PlaceValidator.CheckSpawn(sendData)
	if not canSpawn then
		warn(errorMsg)
		return
	end

	local towerInfo = TowerData.ByName[towerName]
	local newTower
	if towerClasses[towerName] then
		newTower = towerClasses[towerName].new(player, TowerRegistry.generateId(), towerName, towerKey, spawnLocation)
	else
		newTower = BaseTower.new(player, TowerRegistry.generateId(), towerName, towerKey, spawnLocation)
	end

	-- Only charge and count the placement after construction succeeds.
	EconomyService.SubtractCash(player, towerInfo.Stats[0].Cost)
	local placedCounts = TowerService.PlacedTowers[player.UserId]
	placedCounts[towerName] = (placedCounts[towerName] or 0) + 1

	newTower.SpendedCash = towerInfo.Stats[0].Cost

	newTower.Destroyed:Connect(function()
		newTower.IsDestroyed = true
		PlaceValidator.RemoveBorder(newTower.Id)
		TowerRegistry.remove(newTower.Id)

		placedCounts[towerName] -= 1
	end)

	local borderData = { x = spawnLocation.X, z = spawnLocation.Z, r = borderRadius }
	PlaceValidator.AddBorder(newTower.Id, borderData)
	TowerRegistry.add(newTower)

	return newTower
end

function TowerService.UpgradeTower(player: Player, towerId: number)
	local targetTower = TowerRegistry.get(towerId)

	if not targetTower or targetTower.Owner ~= player then
		warn(`비정상적인 업그레이드 시도: {player.Name}, {towerId}`)
		return false
	end

	local towerInfo = TowerData.ByName[targetTower.Name]
	local nextLevelStats = towerInfo.Stats[targetTower.Level + 1]
	if not nextLevelStats then
		return false
	end
	local nextCost = nextLevelStats.Cost
	if not nextCost then
		return false
	end

	if EconomyService.GetCash(player) < nextCost then
		return false
	end

	local success = targetTower:Upgrade(player)
	if success then
		targetTower.SpendedCash += nextCost
		EconomyService.SubtractCash(player, nextCost)

		Net.TowerService.TowerUpdated.FireAll({
			towerId = towerId,
			towerLevel = targetTower.Level,
		})
	end

	return success
end

function TowerService.SellTower(player: Player, towerId: number)
	local targetTower = TowerRegistry.get(towerId)

	if not targetTower or targetTower.Owner ~= player then
		warn(`비정상적인 판매 시도: {player.Name}, {towerId}`)
		return false
	end

	local success = targetTower:Sell(player)
	if success then
		EconomyService.AddCash(player, targetTower.SpendedCash / 2)
	end

	return success
end

function TowerService:DestroyAll()
	for _, tower in TowerRegistry.getAll() do
		tower:Destroy()
	end
end

function TowerService._SpawnNewTower(
	player: Player,
	data: { towerIndex: number, towerKey: string, spawnLocation: Vector3 }
)
	if
		typeof(data) ~= "table"
		or typeof(data.towerIndex) ~= "number"
		or typeof(data.towerKey) ~= "string"
		or typeof(data.spawnLocation) ~= "Vector3"
	then
		return
	end

	local towerInfo = TowerData.ByIndex[data.towerIndex]
	if not towerInfo then
		return
	end

	local playerData = DataService:GetData(player)
	local ownedTower = playerData
		and playerData.OwnedTowers[towerInfo.Name]
		and playerData.OwnedTowers[towerInfo.Name][data.towerKey]
	if not ownedTower then
		warn(`{player.Name} tried to spawn an unowned tower: {towerInfo.Name} ({data.towerKey})`)
		return
	end

	local isEquipped = false
	for _, equippedTower in pairs(playerData.Loadout or {}) do
		if equippedTower.Name == towerInfo.Name and equippedTower.Key == data.towerKey then
			isEquipped = true
			break
		end
	end
	if not isEquipped then
		warn(`{player.Name} tried to spawn an unequipped tower: {towerInfo.Name} ({data.towerKey})`)
		return
	end

	local towerClass = TowerService.SpawnTower(player, towerInfo.Name, data.towerKey, data.spawnLocation)
	if not towerClass then
		return
	end

	Net.TowerService.TowerSpawned.FireExcept(player, {
		towerId = towerClass.Id,
		towerIndex = data.towerIndex,
		ownerSlot = getPlayerSlot(player),
		spawnLocation = data.spawnLocation,
	})

	return towerClass.Id
end

function TowerService.Init(services)
	DataService = services:GetService("DataService")
	EconomyService = services:GetService("EconomyService")

	local ClassesFolder = ServerScriptService.Server.Classes.Tower
	if ClassesFolder then
		for _, module in ClassesFolder:GetChildren() do
			if module:IsA("ModuleScript") and module.Name ~= "BaseTower" then
				towerClasses[module.Name] = require(module)
			end
		end
	end
end

function TowerService.Start()
	for _, player in Players:GetPlayers() do
		TowerService.PlacedTowers[player.UserId] = {}
	end
	Players.PlayerAdded:Connect(function(player)
		TowerService.PlacedTowers[player.UserId] = {}
	end)
	Players.PlayerRemoving:Connect(function(player)
		TowerService.PlacedTowers[player.UserId] = nil
	end)

	Net.TowerService.SpawnNewTower.On(function(player, data)
		return TowerService._SpawnNewTower(player, data)
	end)

	Net.TowerService.UpgradeTower.On(function(player: Player, towerId: number)
		return TowerService.UpgradeTower(player, towerId)
	end)

	Net.TowerService.SellTower.On(function(player: Player, towerId: number)
		return TowerService.SellTower(player, towerId)
	end)

	Net.TowerService.SetTargetMode.On(function(player: Player, data)
		return TowerService.SetTargetMode(player, data)
	end)
end

function TowerService.SetTargetMode(player: Player, data: { towerId: number, targetMode: string }): boolean
	local targetTower = TowerRegistry.get(data.towerId)

	if not targetTower or targetTower.Owner ~= player then
		warn(`비정상적인 타겟 모드 변경 시도: {player.Name}, {data.towerId}`)
		return false
	end

	local validModes = { "First", "Last", "Strongest", "Weakest", "Closest", "Farthest", "Random" }
	if not table.find(validModes, data.targetMode) then
		warn(`잘못된 타겟 모드: {data.targetMode}`)
		return false
	end

	targetTower.TargetMode = data.targetMode

	Net.TowerService.TowerTargetModeUpdated.FireAll({
		towerId = data.towerId,
		targetMode = data.targetMode,
	})

	return true
end

return TowerService
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="620">
              <Properties>
                <string name="Name">Registry</string>
                <string name="Source"><![CDATA[-------------------------------------------------
--// TowerRegistry
-------------------------------------------------
local TowerRegistry = {}

local registry = {}
local currentTowerId = 0

function TowerRegistry.generateId(): number
	currentTowerId += 1
	return currentTowerId
end

function TowerRegistry.add(tower)
	if not tower or not tower.Id then
		return
	end
	registry[tower.Id] = tower
end

function TowerRegistry.get(towerId: number)
	return registry[towerId]
end

function TowerRegistry.getAll()
	return registry
end

function TowerRegistry.remove(towerId: number)
	registry[towerId] = nil
end

return TowerRegistry
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="621">
            <Properties>
              <string name="Name">UnitService</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

--/Modules
local BaseUnit = require(ServerScriptService.Server.Classes.Unit.BaseUnit)
local UnitData = require(ReplicatedStorage.Settings.Data.UnitData)
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local Net = require(ReplicatedStorage.Shared.Net)
local UnitRegistry = require(script.Registry)

local TimeService

--/Variables
local isActived = false
local connection

local unitClasses = {}

-------------------------------------------------
--// UnitService
-------------------------------------------------
local UnitService = {}

UnitService.Get = UnitRegistry.get
UnitService.GetAll = UnitRegistry.getAll

function UnitService.Spawn(
	summoner,
	name: string,
	pathAlpha: number?,
	isEnemyType: boolean?,
	customUnitStats: { [string]: any }?
)
	local self
	if unitClasses[name] then
		self = unitClasses[name].new(summoner, UnitRegistry.generateId(), name, pathAlpha, isEnemyType, customUnitStats)
	else
		self = BaseUnit.new(summoner, UnitRegistry.generateId(), name, pathAlpha, isEnemyType, customUnitStats)
	end

	self.Destroyed:Connect(function(forcing: boolean?)
		self.IsDestroyed = true
		if forcing then
			Net.UnitService.UnitDestroyed.FireAll(self.Id)
		end

		UnitRegistry.remove(self.Id)
	end)

	UnitRegistry.add(self)

	UnitService:StartMoveUnits()

	self.SendTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536

	local unitIndex
	if isEnemyType then
		unitIndex = EnemyData.ByName[self.Name].Index
	else
		unitIndex = UnitData.ByName[self.Name].Index
	end

	Net.UnitService.ReplicatedUnit.FireAll({
		unitId = self.Id,
		unitIndex = unitIndex,
		summonerId = summoner.Id,
		sendTimeMs = self.SendTimeMs,
		pathAlpha = self.PathAlpha and math.round(self.PathAlpha * 65535) or nil,
		isEnemyType = self.IsEnemyType,
	})

	return self
end

function UnitService:StartMoveUnits()
	if isActived then
		return
	end
	isActived = true

	connection = RunService.Heartbeat:Connect(function(dt)
		local toMoveUnits = UnitRegistry.getAll()

		if next(toMoveUnits) == nil then
			isActived = false

			connection:Disconnect()
			connection = nil

			return
		end

		local gameSpeed = TimeService:GetGameSpeed()
		for _, unit in pairs(toMoveUnits) do
			if not unit.PauseEndTime or os.clock() >= unit.PauseEndTime then
				local pathLength = GetPath:Get():GetPathLength()

				unit.PathAlpha -= ((unit.WalkSpeed * dt * gameSpeed) / pathLength)
				unit.PathAlpha = math.clamp(unit.PathAlpha, 0, 1)

				unit.Position = GetPath:Get():CalculateUniformPosition(unit.PathAlpha)
			end

			if unit.PathAlpha <= 0 then
				unit:Destroy()
			end
		end
	end)
end

function UnitService:DestroyAll()
	for _, unit in self.GetAll() do
		unit:Destroy(true)
	end
end

function UnitService.PlayerAdded(player: Player)
	for _, unit in UnitRegistry.getAll() do
		Net.UnitService.ReplicatedUnit.Fire(player, {
			unitId = unit.Id,
			unitIndex = UnitData.ByName[unit.Name].Index,
			summonerId = unit.SummonerId,
			sendTimeMs = unit.SendTimeMs or math.floor(workspace:GetServerTimeNow() * 1000) % 65536,
		})
	end
end

function UnitService.Init(services)
	TimeService = services:GetService("TimeService")

	local ClassesFolder = ServerScriptService.Server.Classes.Unit
	if ClassesFolder then
		for _, module in pairs(ClassesFolder:GetChildren()) do
			if module:IsA("ModuleScript") and module.Name ~= "BaseUnit" then
				unitClasses[module.Name] = require(module)
			end
		end
	end
end

function UnitService.Start() end

return UnitService
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="622">
              <Properties>
                <string name="Name">Registry</string>
                <string name="Source"><![CDATA[-------------------------------------------------
--// UnitRegistry
-------------------------------------------------
local UnitRegistry = {}

local registry = {}
local currentUnitId = 0

function UnitRegistry.generateId(): number
	currentUnitId += 1
	return currentUnitId
end

function UnitRegistry.add(unit)
	if not unit or not unit.Id then
		return
	end
	registry[unit.Id] = unit
end

function UnitRegistry.get(unitId: number)
	return registry[unitId]
end

function UnitRegistry.getAll()
	return registry
end

function UnitRegistry.remove(unitId: number)
	registry[unitId] = nil
end

return UnitRegistry
]]></string>
