        <Item class="Folder" referent="538">
          <Properties>
            <string name="Name">Game</string>
          </Properties>
          <Item class="ModuleScript" referent="539">
            <Properties>
              <string name="Name">BaseUI</string>
              <string name="Source"><![CDATA[--/Service
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local Fusion = require(ReplicatedStorage.Packages.Fusion)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)
local UISettings = require(ReplicatedStorage.Settings.Visuals.UISettings)
local Net = require(ReplicatedStorage.Shared.Net)

--/Fusion
local peek = Fusion.peek

--/UI Elements
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local Interface = PlayerGui:WaitForChild("Interface")
local InfoFrame = Interface:WaitForChild("Info")
local HealthBarFrame = InfoFrame:WaitForChild("HealthBar")
local BarFrame: GuiObject = HealthBarFrame:WaitForChild("Bar")
local WhiteBarFrame: GuiObject = HealthBarFrame:WaitForChild("WhiteBar")
local HealthText: TextLabel = HealthBarFrame:WaitForChild("Health")

--/Variables
local uiScope = Fusion.scoped(Fusion)
local MaxHealth = GameSettings.BaseHealth
local ChangedHealth = uiScope:Value(MaxHealth)

local fadeTask = nil

-------------------------------------------------
--// BaseUI
-------------------------------------------------
local BaseUI = {}

function BaseUI.HydrateUI()
	local targetHealthRatio = uiScope:Computed(function(use)
		return use(ChangedHealth) / use(MaxHealth)
	end)

	local whiteRatio = uiScope:Spring(targetHealthRatio, 12, 1)

	local targetTransparency = uiScope:Value(1)
	local fadeSpeed = uiScope:Value(TweenInfo.new(0))
	local smoothTransparency = uiScope:Tween(targetTransparency, fadeSpeed)

	uiScope:Hydrate(BarFrame)({
		Size = uiScope:Computed(function(use)
			return UDim2.fromScale(use(targetHealthRatio), 1)
		end),
	})

	uiScope:Hydrate(WhiteBarFrame)({
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = uiScope:Computed(function(use)
			return use(smoothTransparency)
		end),
		Size = uiScope:Computed(function(use)
			return UDim2.fromScale(use(whiteRatio), 1)
		end),
	})

	uiScope:Hydrate(HealthText)({
		Text = uiScope:Computed(function(use)
			return `{use(ChangedHealth)}/{use(MaxHealth)}`
		end),
	})

	local shakeOffset = uiScope:Value(Vector2.new(0, 0))
	local smoothShake = uiScope:Spring(shakeOffset, 80, 0.3)

	uiScope:Hydrate(HealthBarFrame)({
		Position = uiScope:Computed(function(use)
			local offset = use(smoothShake)
			return UDim2.new(0, offset.X, 0.029, offset.Y)
		end),
	})

	local previousHealth = peek(ChangedHealth)
	uiScope:Observer(ChangedHealth):onChange(function()
		local currentHp = peek(ChangedHealth)
		local damage = previousHealth - currentHp

		if damage > 0 then
			local intensity = math.clamp(damage / peek(MaxHealth), 0, 1) * UISettings.ShakeIntensity

			shakeOffset:set(Vector2.new(math.max(intensity, 5), 0))
			task.delay(0.05, function()
				shakeOffset:set(Vector2.new(0, 0))
			end)

			fadeSpeed:set(TweenInfo.new(0))
			targetTransparency:set(0.15)

			if fadeTask then
				task.cancel(fadeTask)
			end

			fadeTask = task.delay(0.05, function()
				fadeSpeed:set(TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut))
				targetTransparency:set(1)
			end)
		end

		previousHealth = currentHp
	end)
end

function BaseUI.Init()
	BaseUI.HydrateUI()
end

function BaseUI.Start()
	Net.BaseService.BaseHealthChanged.On(function(changed)
		ChangedHealth:set(math.max(changed, 0))
	end)
end

return BaseUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="540">
            <Properties>
              <string name="Name">EmoteUI</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local EmoteRadialMenu = require(ReplicatedStorage.Shared.Modules.UI.Emote.EmoteRadialMenu)
local EmoteOverlay = require(ReplicatedStorage.Shared.Modules.UI.Emote.EmoteOverlay)
local LocalEmotePlayer = require(ReplicatedStorage.Shared.Modules.UI.Emote.LocalEmotePlayer)

local create = Vide.create
local effect = Vide.effect
local source = Vide.source

local VIEW_ID = "EmoteWheel"
local UIController
local SprintClient
local emotePlayer
local emoteIcon = source(nil :: any)

local emoteSlots = {
	Emote1 = source(EmoteData.ByIndex[1]),
	Emote2 = source(EmoteData.ByIndex[2]),
	Emote3 = source(EmoteData.ByIndex[3]),
	Emote4 = source(EmoteData.ByIndex[4]),
}

local EmoteUI = {}

function EmoteUI.Open()
	if UIController and not UIController:IsOpen(VIEW_ID) then
		UIController:Open(VIEW_ID)
	end
end

function EmoteUI.Close()
	if UIController and UIController:IsOpen(VIEW_ID) then
		UIController:Close(VIEW_ID)
	end
end

function EmoteUI.BindTopbarIcon(icon: any)
	emoteIcon(icon)
end

function EmoteUI.OnSelected(emoteName: string)
	local emoteConfig = EmoteData.ByName[emoteName]
	if emotePlayer and emoteConfig and emotePlayer:CheckCooldown() then
		local didStart = emotePlayer:Start(emoteName, emoteConfig)
		if SprintClient then
			if didStart then
				SprintClient.Disable()
			else
				SprintClient.Enable()
			end
		end
	end
	EmoteUI.Close()
end

function EmoteUI.RenderUI()
	effect(function()
		local icon = emoteIcon()
		if not icon or not UIController then return end

		local isOpen = UIController:IsOpen(VIEW_ID)
		if isOpen and not icon.isSelected then
			icon:select()
		elseif not isOpen and icon.isSelected then
			icon:deselect()
		end
	end)

	return create("Frame")({
		Name = "EmoteUI",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),

		EmoteOverlay({
			Name = "EmoteOverlay",
			IsOpen = UIController:IsVisible(VIEW_ID),
			OnClose = EmoteUI.Close,
			Content = EmoteRadialMenu({
				Emote1 = emoteSlots.Emote1,
				Emote2 = emoteSlots.Emote2,
				Emote3 = emoteSlots.Emote3,
				Emote4 = emoteSlots.Emote4,
				OnSelected = EmoteUI.OnSelected,
			}),
		}),
	})
end

function EmoteUI.Init()
	UIController = ServiceRegistry:GetService("UIController")
	SprintClient = ServiceRegistry:GetService("SprintClient")
	emotePlayer = LocalEmotePlayer.new()
	emotePlayer.OnAutoStopped = function()
		if SprintClient then SprintClient.Enable() end
	end
end

function EmoteUI.Destroy()
	if emotePlayer then
		emotePlayer:Stop()
		emotePlayer = nil
	end
	if SprintClient then SprintClient.Enable() end
	emoteIcon(nil)
end

return EmoteUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="541">
            <Properties>
              <string name="Name">NotificationUI</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local LogMessage = require(ReplicatedStorage.UI.Components.LogMessage)

local create = Vide.create
local source = Vide.source
local values = Vide.values

local notification = source({})

local DEFAULT_LIFETIME = 3

local NotificationUI = {}

function NotificationUI.Pull(message: string, logType: string, lifeTime: number?)
	local newValue = table.clone(notification())
	local newLog = {
		Message = message or "",
		LogType = logType or "Normal",
		State = source("Entering"),
	}

	table.insert(newValue, newLog)
	notification(newValue)

	task.defer(function()
		newLog.State("Alive")
	end)

	task.delay(lifeTime or DEFAULT_LIFETIME, function()
		newLog.State("Leaving")

		task.wait(0.3)

		local current = table.clone(notification())
		local index = table.find(current, newLog)

		if index then
			table.remove(current, index)
			notification(current)
		end
	end)
end

function NotificationUI.RenderUI()
	return create("Frame")({
		Name = "Log",
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromScale(0.45, 0.8),
		ZIndex = 50,

		values(notification, function(value)
			return LogMessage({
				Message = value.Message,
				LogType = value.LogType,
				State = value.State,
			})
		end),

		create("UIListLayout")({
			Name = "UIListLayout",
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0.01, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),

		create("UIListLayout")({
			Name = "UIListLayout",
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0.01, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
		}),
	})
end

function NotificationUI.Init() end

function NotificationUI.Start() end

return NotificationUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="542">
            <Properties>
              <string name="Name">ResultUI</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local TweenService = game:GetService("TweenService")

--/Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local Fusion = require(ReplicatedStorage.Packages.Fusion)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local Net = require(ReplicatedStorage.Shared.Net.client)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)

local OnEvent = Fusion.OnEvent
local peek = Fusion.peek

local scope = Fusion.scoped(Fusion)

local clearVisible = scope:Value(false)
local isWin = scope:Value(false)
local coins = scope:Value(0)
local exp = scope:Value(0)
local gems = scope:Value(0)
local restartVoted = scope:Value(0)

local playerNumber = scope:Value(0)

local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local ClearFrame = PlayerGui:WaitForChild("Interface"):WaitForChild("GameClear")

local TWEEN_INFO = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local uiScale = ClearFrame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
uiScale.Parent = ClearFrame
uiScale.Scale = 0

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function clearTowerRewards()
	for _, child in pairs(ClearFrame.TowerExpGain:GetChildren()) do
		if child:IsA("Frame") and child.Name ~= "Template" then
			child:Destroy()
		end
	end
end

local function HydrateUI()
	scope:Hydrate(ClearFrame.Reward.RewardList.Coins)({
		Visible = scope:Computed(function(use)
			return if use(coins) > 0 then true else false
		end),
	})
	scope:Hydrate(ClearFrame.Reward.RewardList.Coins.Amount)({
		Text = scope:Computed(function(use)
			local coinsVal = use(coins)
			local gemsVal = use(gems)
			local formatted = `{NumberUtils.FormatComma(coinsVal)}C`
			if gemsVal > 0 then
				formatted ..= ` + {NumberUtils.FormatComma(gemsVal)} Gems`
			end
			return formatted
		end),
	})

	scope:Hydrate(ClearFrame.Reward.RewardList.Exp)({
		Visible = scope:Computed(function(use)
			return if use(exp) > 0 then true else false
		end),
	})
	scope:Hydrate(ClearFrame.Reward.RewardList.Exp.Amount)({
		Text = scope:Computed(function(use)
			return `{NumberUtils.FormatComma(use(exp))} Exp`
		end),
	})

	scope:Hydrate(ClearFrame.Title)({
		Text = scope:Computed(function(use)
			return if use(isWin) then "Victory" else "Defeat"
		end),
	})

	scope:Hydrate(ClearFrame.Replay)({
		[OnEvent("MouseButton1Click")] = function()
			Net.GameEvent.VoteRestart.Fire()
		end,
	})
	scope:Hydrate(ClearFrame.Replay.TextLabel)({
		Text = scope:Computed(function(use)
			return `Replay ({use(restartVoted)}/{math.floor(use(playerNumber) / 2) + 1})`
		end),
	})

	scope:Hydrate(ClearFrame.Lobby)({
		[OnEvent("MouseButton1Click")] = function()
			Net.GameEvent.TeleportToLobby.Fire()
		end,
	})
end

-------------------------------------------------
--// ResultUI
-------------------------------------------------
local ResultUI = {}

function ResultUI.Init()
	HydrateUI()
	playerNumber:set(#Players:GetPlayers())
	ClearFrame.Visible = false
	uiScale.Scale = 0
end

function ResultUI.Start()
	ClientSignals.GameOver:Connect(
		function(isWinVal: boolean, coinsVal: number, expVal: number, gemsVal: number, towers: any)
			clearTowerRewards()
			
			isWin:set(isWinVal)
			coins:set(coinsVal)
			exp:set(expVal)
			gems:set(gemsVal or 0)

			for _, towerInfo in towers do
				local template = ClearFrame.TowerExpGain.Template:Clone()
				template.Name = towerInfo.name
				template.Visible = true

				template.TowerName.Text = towerInfo.name

				local towerConfig = TowerData.ByName[towerInfo.name]
				if towerConfig and towerConfig.TowerImage then
					template.TowerImage.Image = towerConfig.TowerImage
				end

				if towerInfo.levelAfter > towerInfo.levelBefore then
					template.Level.Text =
						`Lv.{towerInfo.levelBefore} → {towerInfo.levelAfter} ({towerInfo.percentBefore}% → {towerInfo.percentAfter}%)`
				else
					template.Level.Text =
						`Lv.{towerInfo.levelAfter} ({towerInfo.percentBefore}% → {towerInfo.percentAfter}%)`
				end

				template.ExpProgress.Progress.Size = UDim2.fromScale(towerInfo.percentAfter / 100, 1)

				template.Parent = ClearFrame.TowerExpGain
			end
			
			ClearFrame.Visible = true
			TweenService:Create(uiScale, TWEEN_INFO, {Scale = 1}):Play()
			clearVisible:set(true)
		end
	)

	ClientSignals.Restarted:Connect(function()
		clearTowerRewards()
		ClearFrame.Visible = false
		uiScale.Scale = 0
		clearVisible:set(false)
		restartVoted:set(0)
	end)
	ClientSignals.RestartVoted:Connect(function(currentVote: number)
		restartVoted:set(currentVote or peek(restartVoted) + 1)
	end)

	Players.PlayerAdded:Connect(function()
		playerNumber:set(peek(playerNumber) + 1)
	end)

	Players.PlayerRemoving:Connect(function()
		playerNumber:set(peek(playerNumber) - 1)
	end)
end

return ResultUI
]]></string>
            </Properties>
            <Item class="Folder" referent="543">
              <Properties>
                <string name="Name">Components</string>
              </Properties>
              <Item class="ModuleScript" referent="544">
                <Properties>
                  <string name="Name">TowerExpGain</string>
                  <string name="Source"><![CDATA[return function(props) end
]]></string>
