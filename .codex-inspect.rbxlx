      <Item class="Folder" referent="606">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="Folder" referent="607">
          <Properties>
            <string name="Name">Core</string>
          </Properties>
          <Item class="ModuleScript" referent="608">
            <Properties>
              <string name="Name">BaseService</string>
              <string name="Source"><![CDATA[--/Services
local BaseService = {}

--/Modules
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EnemyService
local Signal = require(ReplicatedStorage.Packages.Signal)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)
local Net = require(ReplicatedStorage.Shared.Net)

--/Variables
BaseService.MaxHealth = GameSettings.BaseHealth
BaseService.Health = BaseService.MaxHealth

--/Signals
BaseService.HealthChanged = Signal.new()
BaseService.BaseDestroyed = Signal.new()

function BaseService:TakeDamage(amount: number)
	if self.Health <= 0 then
		return
	end

	self.Health = math.max(0, self.Health - amount)

	self.HealthChanged:Fire(self.Health, self.MaxHealth)
	Net.BaseService.BaseHealthChanged.FireAll(self.Health)

	if self.Health <= 0 then
		self.BaseDestroyed:Fire()
	end
end

function BaseService:OnEnemyReachedBase(enemy)
	local damage = enemy.Health or 1

	self:TakeDamage(damage)

	enemy:Destroy()
end

function BaseService:Reset()
	self.Health = self.MaxHealth
	self.HealthChanged:Fire(self.Health, self.MaxHealth)
	Net.BaseService.BaseHealthChanged.FireAll(self.Health)
end

function BaseService.Init(services)
	EnemyService = services:GetService("EnemyService")
end

function BaseService.Start()
	EnemyService.EnemyReached:Connect(function(enemy)
		BaseService:OnEnemyReachedBase(enemy)
	end)
end

return BaseService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="609">
            <Properties>
              <string name="Name">CutsceneProfiles</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Selection = require(ReplicatedStorage.Shared.Modules.Cutscene.FriendSelection)
local Profiles = {}

-- Session-owned, server-verified identities. Only descriptions + the selected ID
-- replicate, not the player's full friend list. No client-supplied user IDs.
function Profiles.Begin(state, actors)
	local folder = Instance.new("Folder")
	folder.Name = "ActorProfiles"
	folder.Parent = state
	local alive, entries = true, {}
	local random = Random.new()
	local function add(player)
		if not alive or entries[player] then return end
		local entry = Instance.new("Folder")
		entry.Name = tostring(player.UserId)
		entry.Parent = folder
		entries[player] = entry
		local roles = {}
		for _, role in actors do roles[role] = true end
		for role in roles do
			local slot = Instance.new("Folder")
			slot.Name = role
			slot.Parent = entry
			local done = false
			local function valid()
				return alive and not done and player.Parent == Players and slot.Parent ~= nil
			end
			task.delay(8, function()
				if valid() then
					done = true
					slot:SetAttribute("Status", "Timeout")
				end
			end)
			task.spawn(function()
				local ok, descriptionOrError = pcall(function()
					local userId = player.UserId
					if userId <= 0 then return nil end -- Studio test identities
					if role == "Friend" then
						local pages = Players:GetFriendsAsync(userId)
						repeat
							if not valid() then return nil end
							userId = Selection.FromPage(pages:GetCurrentPage(), player.UserId, function(count)
								return random:NextInteger(1, count)
							end)
							if userId or pages.IsFinished then break end
							pages:AdvanceToNextPageAsync()
						until false
						if not userId then return nil end
					end
					if not valid() then return nil end
					slot:SetAttribute("UserId", userId)
					-- Prefer the current in-game appearance for Self, including custom outfits.
					local humanoid = role == "Self" and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
					if humanoid and player:HasAppearanceLoaded() then return humanoid:GetAppliedDescription() end
					return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
				end)
				if not valid() then
					if ok and descriptionOrError then descriptionOrError:Destroy() end
					return
				end
				done = true
				if ok and descriptionOrError then
					descriptionOrError.Name = "Description"
					descriptionOrError.Parent = slot
					slot:SetAttribute("Status", "Ready")
				else
					slot:SetAttribute("Status", if ok then "Unavailable" else "Failed")
					if not ok then warn("[CutsceneProfiles] " .. player.Name .. "/" .. role .. ": " .. tostring(descriptionOrError)) end
				end
			end)
		end
	end
	local added = Players.PlayerAdded:Connect(add)
	local removing = Players.PlayerRemoving:Connect(function(player)
		local entry = entries[player]
		entries[player] = nil
		if entry then entry:Destroy() end
	end)
	for _, player in Players:GetPlayers() do add(player) end
	return function()
		alive = false
		added:Disconnect()
		removing:Disconnect()
		table.clear(entries)
	end
end
return Profiles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="610">
            <Properties>
              <string name="Name">GameService</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/Modules

local Promise = require(ReplicatedStorage.Packages.Promise)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)
local MapData = require(ReplicatedStorage.Settings.Data.MapData)
local ServerCutscene = require(script.Parent.ServerCutscene)
local CharacterGuard = require(script.Parent.Parent.Parent.CharacterGuard)
local SafeTeleport = require(ReplicatedStorage.Shared.Modules.Core.SafeTeleport)
local Net = require(ReplicatedStorage.Shared.Net)

local BaseService
local MapService
local WaveService
local EconomyService
local DataService

local TowerService
local EnemyService
local UnitService


-------------------------------------------------
--// GameService
-------------------------------------------------
local GameService = {}
GameService.Dependencies = {
	"BaseService",
	"MapService",
	"WaveService",
	"EconomyService",
	"DataService",
	"TowerService",
	"EnemyService",
	"UnitService",
}
GameService.Connections = {}
GameService.RestartList = {}
GameService.ReadyList = {}
GameService.SkipList = {}

GameService.SkipActive = false
GameService.IsGameRunning = false
GameService.IsMapLoading = false
GameService.IsMapLoaded = false

GameService.SelectedMap = nil
GameService.SelectedDifficulty = nil
GameService.StartPlayerCount = 1

function GameService:WaitForTeleportData()
	local function check()
		return Promise.new(function(resolve, reject)
			if self.SelectedMap ~= nil then
				resolve()
			else
				reject()
			end
		end)
	end
	return Promise.retryWithDelay(check, 300, 0.1)
end

function GameService:AllReady()
	local players = Players:GetPlayers()
	if #players == 0 then
		return false
	end

	for _, player in ipairs(players) do
		if not table.find(self.ReadyList, player) then
			return false
		end
	end
	return true
end

function GameService:FireReadyState()
	Net.GameEvent.ReadyVoted.FireAll(#self.ReadyList)
end

function GameService:PrepareMap()
	if self.IsMapLoaded then
		return
	end

	if self.IsMapLoading then
		while self.IsMapLoading do
			task.wait()
		end
		return
	end

	self.IsMapLoading = true
	local mapFolder = workspace:WaitForChild("Map")
	mapFolder:SetAttribute("GameplayReady", false)
	mapFolder:SetAttribute("LoadError", nil)

	if RunService:IsStudio() then
		self.SelectedMap = "Chapter 1"
		self.SelectedDifficulty = "Hard"
	end

	local success = self:WaitForTeleportData():await()
	if not success then
		warn("Failed to receive teleport data. Falling back to default map.")
		self.SelectedMap = "Chapter 1"
		self.SelectedDifficulty = "Normal"
	end

	ReplicatedStorage:SetAttribute("SelectedMap", self.SelectedMap)
	ReplicatedStorage:SetAttribute("SelectedDifficulty", self.SelectedDifficulty or "Normal")

	local mapInfo = MapData[self.SelectedMap]
	local introCutscene = mapInfo and mapInfo.IntroCutscene
	local preparedMap = nil
	ReplicatedStorage:SetAttribute("CutsceneEndedAt", nil)
	ReplicatedStorage:SetAttribute("CutsceneTransitionSeconds", nil)
	if introCutscene then
		local played, err = pcall(ServerCutscene.Play, introCutscene, function()
			preparedMap = MapService:PrepareMap(self.SelectedMap)
		end)
		if not played then
			MapService:DiscardPrepared(preparedMap)
			self.IsMapLoading = false
			mapFolder:SetAttribute("LoadError", string.sub(tostring(err), 1, 500))
			warn("[GameService] Map intro failed: " .. tostring(err))
			return
		end
	end

	local loaded, loadError = pcall(function()
		MapService:LoadMapAsync(self.SelectedMap, self.SelectedDifficulty, preparedMap)
		local characterStarted = os.clock()
		CharacterGuard.Release(mapFolder)
		mapFolder:SetAttribute("CharacterPrepareSeconds", os.clock() - characterStarted)
	end)
	if not loaded then
		self.IsMapLoading = false
		mapFolder:SetAttribute("LoadError", string.sub(tostring(loadError), 1, 500))
		warn("[GameService] Map preparation failed: " .. tostring(loadError))
		return
	end

	self.IsMapLoaded = true
	mapFolder:SetAttribute("GameplayReady", true)
	local endedAt = ReplicatedStorage:GetAttribute("CutsceneEndedAt")
	if endedAt then
		ReplicatedStorage:SetAttribute("CutsceneTransitionSeconds", workspace:GetServerTimeNow() - endedAt)
	end
	self.IsMapLoading = false
end

function GameService:StartGame()
	if self.IsGameRunning then
		return
	end
	self.IsGameRunning = true

	self.StartPlayerCount = math.max(1, #Players:GetPlayers())
	Net.GameEvent.GameInfoSynced.FireAll({
		Difficulty = self.SelectedDifficulty or "Normal",
		StartPlayerCount = self.StartPlayerCount,
	})

	self:PrepareMap()
	if not self.IsMapLoaded then
		self.IsGameRunning = false
		return
	end

	BaseService:Reset()

	WaveService:PlayRound(self.SelectedMap, self.SelectedDifficulty)
end

function GameService:GameOver(isWin: boolean)
	if not self.IsGameRunning then
		return
	end
	self.IsGameRunning = false

	WaveService:Stop()
	EnemyService:DestroyAll()
	UnitService:DestroyAll()

	for _, connection in pairs(self.Connections) do
		connection:Disconnect()
	end
	table.clear(self.Connections)

	local coins = 0
	local exp = 0
	local gems = 0
	local mapData = MapData[self.SelectedMap]

	if mapData then
		local mapRewards = mapData.Rewards and mapData.Rewards[self.SelectedDifficulty]

		if mapRewards then
			if isWin then
				coins = mapRewards.WinCoins or 0
				exp = mapRewards.WinExp or 0
				gems = mapRewards.WinGems or 0
			else
				local maxWave = WaveService:GetWaves()
				local currentWave = WaveService.CurrentWave
				local completionRatio = math.clamp(maxWave > 0 and (currentWave / maxWave) or 0, 0, 1)

				coins = math.floor((mapRewards.LoseCoinsPerWave or 0) * completionRatio)
				exp = math.floor((mapRewards.LoseExpPerWave or 0) * completionRatio)
				gems = 0
			end
		else
			warn(
				`[GameService] MapData에서 {self.SelectedMap}의 난이도 {self.SelectedDifficulty} 보상 정보를 찾을 수 없습니다.`
			)
		end
	else
		warn(`[GameService] MapData에서 {self.SelectedMap}의 보상 정보를 찾을 수 없습니다.`)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			local profile = DataService:GetProfile(player)
			if not profile then
				return
			end

			if coins > 0 then
				DataService:AddData(player, "Coins", coins)
			end
			if exp > 0 then
				DataService:AddData(player, "Exp", exp)
			end
			if gems > 0 then
				DataService:AddData(player, "Gems", gems)
			end

			if isWin then
				profile.Data.Wins = (profile.Data.Wins or 0) + 1
			end
		end)
	end

	Net.GameEvent.GameOver.FireAll({
		isWin = isWin,
		coins = coins,
		exp = exp,
		gems = gems,
	})
end

function GameService:RemoveFromRestartList(player: Player)
	local index = table.find(self.RestartList, player)
	if index then
		table.remove(self.RestartList, index)
	end
end

function GameService:RemoveFromReadyList(player: Player)
	local index = table.find(self.ReadyList, player)
	if index then
		table.remove(self.ReadyList, index)
	end
end

function GameService:RemoveFromSkipList(player: Player)
	local index = table.find(self.SkipList, player)
	if index then
		table.remove(self.SkipList, index)
	end
end

function GameService:TrySkip()
	if not self.IsGameRunning or not self.SkipActive then
		return
	end

	local totalPlayers = #Players:GetPlayers()
	if totalPlayers == 0 then
		return
	end

	local majority = math.floor(totalPlayers / 2) + 1
	if #self.SkipList < majority then
		return
	end

	self.SkipActive = false
	table.clear(self.SkipList)

	local currentWave = WaveService.CurrentWave
	local skipCash = GameSettings.SkipBonus * currentWave
	EconomyService.AddCashToAll(skipCash)

	WaveService:StartNextWave()
end

function GameService:TryStartGameWhenAllReady()
	if self.IsGameRunning then
		return
	end

	if not self:AllReady() then
		return
	end

	table.clear(self.ReadyList)
	self:FireReadyState()
	self:StartGame()
end

function GameService:RestartGame()
	if self.IsGameRunning then
		return
	end

	local totalPlayers = #Players:GetPlayers()
	if totalPlayers == 0 then
		return
	end

	local majority = math.floor(totalPlayers / 2) + 1
	if #self.RestartList < majority then
		return
	end

	table.clear(self.RestartList)
	table.clear(self.ReadyList)
	table.clear(self.SkipList)
	self.SkipActive = false

	TowerService:DestroyAll()
	EnemyService:DestroyAll()
	UnitService:DestroyAll()

	BaseService:Reset()

	EconomyService.SetCashToAll(GameSettings.StartMoney)
	Net.GameEvent.Restarted.FireAll()

	self:TryStartGameWhenAllReady()
end

function GameService.Init(services)
	BaseService = services:GetService("BaseService")
	MapService = services:GetService("MapService")
	WaveService = services:GetService("WaveService")
	EconomyService = services:GetService("EconomyService")
	DataService = services:GetService("DataService")

	TowerService = services:GetService("TowerService")
	EnemyService = services:GetService("EnemyService")
	UnitService = services:GetService("UnitService")
end

function GameService.Start()
	local function PlayerAdded(player: Player)
		local joinData = player:GetJoinData()
		local teleportData = joinData and joinData.TeleportData

		if teleportData and teleportData.Map and GameService.SelectedMap == nil then
			GameService.SelectedMap = teleportData.Map
		end

		if teleportData and teleportData.Difficulty and GameService.SelectedDifficulty == nil then
			GameService.SelectedDifficulty = teleportData.Difficulty
		end

		GameService:FireReadyState()
	end

	--/Player
	for _, player in ipairs(Players:GetPlayers()) do
		PlayerAdded(player)
	end
	Players.PlayerAdded:Connect(PlayerAdded)
	Players.PlayerRemoving:Connect(function(player)
		GameService:RemoveFromRestartList(player)
		GameService:RemoveFromReadyList(player)
		GameService:RemoveFromSkipList(player)
		task.defer(function()
			GameService:FireReadyState()

			Net.GameEvent.RestartVoted.FireAll(#GameService.RestartList)
			Net.GameEvent.SkipVoted.FireAll(#GameService.SkipList)

			GameService:RestartGame()
			GameService:TrySkip()
			GameService:TryStartGameWhenAllReady()
		end)
	end)

	--/Map
	task.defer(function()
		GameService:PrepareMap()
	end)

	--/Net
	BaseService.BaseDestroyed:Connect(function()
		GameService:GameOver(false)
	end)

	WaveService.WaveCompleted:Connect(function(waveNumber: number)
		if not GameService.IsGameRunning then
			return
		end

		local waveBonus = math.floor(500 / (1 + math.exp(-0.2 * (waveNumber - 20))))
		local reward = GameSettings.WaveReward * waveNumber + waveBonus
		EconomyService.AddCashToAll(reward)

		WaveService:StartNextWave()
	end)

	WaveService.WaveStarted:Connect(function(_: number)
		GameService.SkipActive = false
		table.clear(GameService.SkipList)
		Net.GameEvent.SkipVoted.FireAll(0)
	end)

	WaveService.CanSkip:Connect(function()
		if not GameService.IsGameRunning then
			return
		end

		GameService.SkipActive = true
		table.clear(GameService.SkipList)
		Net.GameEvent.CanSkip.FireAll()
	end)

	WaveService.AllWavesCompleted:Connect(function()
		if not GameService.IsGameRunning then
			return
		end
		GameService:GameOver(true)
	end)

	Net.GameEvent.VoteSkip.On(function(player: Player)
		if not GameService.IsGameRunning then
			return
		end

		if not GameService.SkipActive then
			return
		end

		if table.find(GameService.SkipList, player) then
			return
		end

		table.insert(GameService.SkipList, player)
		Net.GameEvent.SkipVoted.FireAll(#GameService.SkipList)

		GameService:TrySkip()
	end)

	Net.GameEvent.VoteRestart.On(function(player: Player)
		if GameService.IsGameRunning then
			return
		end

		if table.find(GameService.RestartList, player) then
			return
		end

		table.insert(GameService.RestartList, player)
		Net.GameEvent.RestartVoted.FireAll(#GameService.RestartList)

		GameService:RestartGame()
	end)

	Net.GameEvent.Ready.On(function(player: Player)
		if GameService.IsGameRunning then
			return
		end

		if table.find(GameService.ReadyList, player) then
			return
		end

		table.insert(GameService.ReadyList, player)
		GameService:FireReadyState()
		GameService:TryStartGameWhenAllReady()
	end)

	Net.GameEvent.GetGameInfo.On(function()
		return {
			Difficulty = GameService.SelectedDifficulty or "Normal",
			StartPlayerCount = GameService.StartPlayerCount,
		}
	end)

	Net.GameEvent.TeleportToLobby.On(function(player: Player)
		GameService:RemoveFromRestartList(player)
		GameService:RemoveFromReadyList(player)

		task.spawn(function()
			local success, result = SafeTeleport(GameSettings.LobbyPlaceId, { player })
			if not success then
				warn("Teleport failed:", result)
			end
		end)
	end)
end

return GameService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="611">
            <Properties>
              <string name="Name">LootService</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LootData = require(ReplicatedStorage.Settings.Data.LootData)
local Net = require(ReplicatedStorage.Shared.Net)
local DataService
local EnemyService

local RANDOM = Random.new()

local LootService = {}

function LootService.Init(services)
	DataService = services:GetService("DataService")
	EnemyService = services:GetService("EnemyService")
end
function LootService.Start()
	EnemyService.EnemyDefeated:Connect(function(enemy)
		LootService:ProcessEnemyLoot(enemy)
	end)
end

function LootService:ProcessEnemyLoot(enemy: any)
	if not enemy or not enemy.IsDead then
		return
	end
	local dropPool = LootData[enemy.Name]
	if not dropPool then
		return
	end
	local activePlayers = Players:GetPlayers()
	if #activePlayers == 0 then
		return
	end

	for _, player in ipairs(activePlayers) do
		self:RollLootForPlayer(player, dropPool)
	end
end

function LootService:RollLootForPlayer(player: Player, dropPool: {any})
	for _, drop in ipairs(dropPool) do
		local roll = RANDOM:NextNumber()
		if roll > drop.Chance then
			continue
		end

		local amount = RANDOM:NextInteger(drop.MinAmount, drop.MaxAmount)
		self:AwardLoot(player, drop.ItemName, amount)
	end
end
function LootService:AwardLoot(player: Player, itemName: string, amount: number)
	DataService:AddData(player, "Inventory", amount, "Items", itemName)

	Net.LootService.ReplicateDrop.Fire(player, {
		itemName = itemName,
		amount = amount,
	})
end

return LootService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="612">
            <Properties>
              <string name="Name">MapService</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local SceneLifecycle = require(script.Parent.SceneLifecycle)
local AudioService
local WaveService

local MapService = {}
MapService.IsLoading = false
MapService.IsLoaded = false
MapService.LoadedMap = nil
MapService.LoadedRoots = {}
local waveConnection = nil

function MapService:PrepareMap(mapName: string)
	local started = os.clock()
	local source = assert(ReplicatedStorage.Assets.Maps:WaitForChild(mapName, 30), "Missing map: " .. mapName)
	local prepared = SceneLifecycle.Prepare(SceneLifecycle.Clone(source))
	prepared.MapName = mapName
	prepared.PrepareSeconds = os.clock() - started
	return prepared
end

function MapService:DiscardPrepared(prepared)
	SceneLifecycle.Discard(prepared)
end

function MapService:LoadMapAsync(mapName: string, difficulty: string?, prepared)
	while not WaveService or self.IsLoading do task.wait() end
	if self.IsLoaded and self.LoadedMap == mapName then
		self:DiscardPrepared(prepared)
		return
	end
	self.IsLoading = true
	local loadStarted = os.clock()
	self.IsLoaded = false
	local mapFolder = workspace:WaitForChild("Map")
	mapFolder:SetAttribute("MapReady", false)
	mapFolder:SetAttribute("LoadError", nil)
	mapFolder:SetAttribute("MapLoadSeconds", nil)
	local staging = prepared
	local ok, err = xpcall(function()
		if waveConnection then waveConnection:Disconnect(); waveConnection = nil end
		-- Delete only instances this service loaded, never unrelated Workspace objects.
		SceneLifecycle.Destroy(self.LoadedRoots)
		self.LoadedRoots = {}
		self.LoadedMap = nil
		staging = staging or self:PrepareMap(mapName)
		assert(staging.MapName == mapName, "Prepared map does not match selected map")
		mapFolder:SetAttribute("MapPrepareSeconds", staging.PrepareSeconds)
		self.LoadedRoots = SceneLifecycle.MountPrepared(staging, mapFolder)
		staging = nil

		local environmentFolder = mapFolder:FindFirstChild("Environment")
		local terrainRegion = environmentFolder and environmentFolder:FindFirstChildOfClass("TerrainRegion")
		if terrainRegion then
			-- TerrainRegion has no chunk-read API; this engine operation remains atomic.
			local started = os.clock()
			workspace.Terrain:PasteRegion(terrainRegion, workspace.Terrain.MaxExtents.Min, true)
			local elapsed = os.clock() - started
			if elapsed > 0.016 then
				warn(string.format("[MapService] Atomic Terrain PasteRegion %.1fms: %s", elapsed * 1000, mapName))
			end
			task.wait()
		end

		GetPath.Init()
		local bgmFolder = mapFolder:FindFirstChild("BGM")
		waveConnection = WaveService.WaveStarted:Connect(function()
			local currentBGM = bgmFolder and bgmFolder:FindFirstChild(tostring(WaveService.CurrentWave))
			if currentBGM then AudioService.SetBGMState(nil, nil, currentBGM.SoundId) end
		end)
		self.LoadedMap = mapName
		self.IsLoaded = true
		mapFolder:SetAttribute("SelectedMap", mapName)
		mapFolder:SetAttribute("SelectedDifficulty", difficulty or "Normal")
		mapFolder:SetAttribute("MapLoadSeconds", os.clock() - loadStarted)
		mapFolder:SetAttribute("MapReady", true)
	end, debug.traceback)
	if not ok then
		SceneLifecycle.Destroy(self.LoadedRoots)
		self.LoadedRoots = {}
		self:DiscardPrepared(staging)
		self.IsLoaded = false
		self.LoadedMap = nil
		mapFolder:SetAttribute("LoadError", string.sub(tostring(err), 1, 500))
	end
	self.IsLoading = false
	if not ok then error(err, 0) end
end

function MapService.Init(services)
	AudioService = services:GetService("AudioService")
	WaveService = services:GetService("WaveService")
end

function MapService.Start() end

return MapService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="613">
            <Properties>
              <string name="Name">SceneLifecycle</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local FrameBudget = require(ReplicatedStorage.Shared.Modules.Utils.FrameBudget)
local InstanceBatch = require(ReplicatedStorage.Shared.Modules.Utils.InstanceBatch)
local SceneLifecycle = {}

-- Soft Lua budget; a single engine operation/atomic rig may exceed this limit.
local function budget()
	local frameTime = 1 / 60
	local step = FrameBudget.new(function()
		frameTime = RunService.Heartbeat:Wait()
	end, 256, 0.002, nil, function()
		-- Back off if the server is already missing frames; never grow past 2ms.
		local slow = frameTime > 1 / 40
		return if slow then 128 else 256, if slow then 0.001 else 0.002
	end)
	-- One shared time budget avoids double-yielding when switching scan/write phases.
	-- A cheap off-world/scan operation costs 1/8 of a live mutation.
	return step, function() step(1 / 8) end
end

function SceneLifecycle.Visit(roots, callback)
	local _, scanStep = budget()
	InstanceBatch.Visit(roots, callback, scanStep)
end

function SceneLifecycle.Clone(source)
	local started = os.clock()
	local clone = assert(source:Clone(), "Scene source must be Archivable: " .. source:GetFullName())
	local elapsed = os.clock() - started
	if elapsed > 0.016 then
		warn(string.format("[SceneLifecycle] Atomic Clone %.1fms: %s", elapsed * 1000, source:GetFullName()))
	end
	RunService.Heartbeat:Wait()
	return clone
end

function SceneLifecycle.Destroy(roots, scriptsDisabled)
	local step, scanStep = budget()
	if not scriptsDisabled then
		InstanceBatch.Visit(roots, function(instance)
			if instance:IsA("BaseScript") then instance.Enabled = false end
		end, scanStep)
	end
	InstanceBatch.Destroy(roots, step, scanStep)
end

-- This phase never parents anything to Workspace. It can run while clients prepare
-- the intro, before its synchronized clock starts.
function SceneLifecycle.Prepare(clone, atomicRoots)
	local _, prepareStep = budget()
	local roots = clone:GetChildren()
	local heldParts, heldScripts = {}, {}
	local entries = InstanceBatch.Plan(clone, function(instance)
		return (atomicRoots and atomicRoots[instance])
			or not (instance:IsA("Model") or instance:IsA("Folder"))
	end, prepareStep)
	local ok, err = xpcall(function()
		InstanceBatch.Visit(roots, function(instance)
			if instance:IsA("BasePart") and not instance.Anchored then
				table.insert(heldParts, instance)
				instance.Anchored = true
			elseif instance:IsA("BaseScript") and instance.Enabled then
				table.insert(heldScripts, instance)
				instance.Enabled = false
			end
		end, prepareStep)
		InstanceBatch.Detach(entries, prepareStep)
	end, debug.traceback)
	if not ok then
		local owned = {}
		for _, entry in entries do table.insert(owned, entry.Instance) end
		SceneLifecycle.Destroy(owned)
		clone:Destroy()
		error(err, 0)
	end
	return { Clone = clone, Roots = roots, Entries = entries, Parts = heldParts, Scripts = heldScripts }
end

function SceneLifecycle.Discard(prepared)
	if not prepared or prepared.Consumed then return end
	prepared.Consumed = true
	local owned = {}
	for _, entry in prepared.Entries do table.insert(owned, entry.Instance) end
	SceneLifecycle.Destroy(owned)
	prepared.Clone:Destroy()
end

function SceneLifecycle.MountPrepared(prepared, destination)
	assert(not prepared.Consumed, "Prepared scene already consumed")
	local step, prepareStep = budget()
	local ok, err = xpcall(function()
		InstanceBatch.Mount(prepared.Clone, destination, prepared.Entries, step, prepareStep, true)
		for _, part in prepared.Parts do part.Anchored = false; step() end
		for _, scriptInstance in prepared.Scripts do scriptInstance.Enabled = true; step() end
	end, debug.traceback)
	if not ok then SceneLifecycle.Discard(prepared); error(err, 0) end
	prepared.Consumed = true
	prepared.Clone:Destroy() -- empty wrapper only
	return prepared.Roots
end

function SceneLifecycle.Mount(clone, destination, atomicRoots)
	return SceneLifecycle.MountPrepared(SceneLifecycle.Prepare(clone, atomicRoots), destination)
end

return SceneLifecycle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="614">
            <Properties>
              <string name="Name">ServerCutscene</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Data = require(ReplicatedStorage.Settings.Data.CutsceneData)
local PlaybackClock = require(ReplicatedStorage.Shared.Modules.Cutscene.PlaybackClock)
local ScenePaths = require(ReplicatedStorage.Shared.Modules.Cutscene.ScenePaths)
local SceneLifecycle = require(script.Parent.SceneLifecycle)
local CutsceneProfiles = require(script.Parent.CutsceneProfiles)
local Cleanup = require(ReplicatedStorage.Shared.Modules.Cutscene.Cleanup)
local ServerCutscene = {}

function ServerCutscene.Play(name: string, prepareNext)
	local config = assert(Data[name], "Unknown cutscene: " .. name)
	local fastMount = config.Lifecycle and config.Lifecycle.FastMount
	local fastCleanup = config.Lifecycle and config.Lifecycle.FastCleanup
	local roots, tracks, animations = {}, {}, {}
	local playbackTracks = {}
	local playbackConnection = nil
	local streamingContainer = nil
	local staging = nil
	local stopProfiles = nil
	local state = Instance.new("Folder")
	state.Name = "ActiveCutscene"
	state:SetAttribute("CutsceneName", name)
	local currentPhase = "Scene setup"
	local phaseStarted = os.clock()
	local function phase(value)
		print(string.format("[ServerCutscene] %s: %s -> %s (%.2fs)", name, currentPhase, value, os.clock() - phaseStarted))
		phaseStarted = os.clock()
		currentPhase = value
		state:SetAttribute("Phase", value)
		ReplicatedStorage:SetAttribute("CutscenePhase", value)
	end
	ReplicatedStorage:SetAttribute("CutsceneError", nil)
		local cameraValue = Instance.new("ObjectValue")
	cameraValue.Name = "CameraPart"
	cameraValue.Parent = state
	local ready = Instance.new("RemoteEvent")
	ready.Name = "CameraReady"
	ready.Parent = state
	local rigTracks = Instance.new("Folder")
	rigTracks.Name = "RigTracks"
	rigTracks.Parent = state
	local sceneRoots = Instance.new("Folder")
	sceneRoots.Name = "SceneRoots"
	sceneRoots.Parent = state
	local acknowledged = {}
	local stages, failures = {}, {}
	local connection = ready.OnServerEvent:Connect(function(player, kind, detail)
		if kind == nil then
			acknowledged[player] = true
		elseif (kind == "Stage" or kind == "Failed") and type(detail) == "string" then
			stages[player] = string.sub(detail, 1, 500)
			if kind == "Failed" then failures[player] = stages[player] end
		end
	end)
	local success, err = xpcall(function()
		phase("Scene setup")
		if config.Actors then stopProfiles = CutsceneProfiles.Begin(state, config.Actors) end
		local source = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Cutscenes")
		for _, segment in config.ScenePath do
			source = assert(source:WaitForChild(segment, 10), "Missing cutscene folder: " .. segment)
		end
		-- Clone together to preserve references between sibling rigs and objects.
		local clone = SceneLifecycle.Clone(source)
		staging = clone
		local function visit(targets, callback)
			if not fastMount then
				SceneLifecycle.Visit(targets, callback)
				return
			end
			-- Fast lifecycle explicitly trades a short spike for removing seconds of
			-- frame-budget waits before the intro can begin.
			for _, target in targets do
				callback(target)
				for _, descendant in target:GetDescendants() do callback(descendant) end
			end
		end
		-- Never guess which duplicate PlayerRig is the newly authored actor.
		local modelCounts = {}
		visit({ clone }, function(instance)
			if instance:IsA("Model") then modelCounts[instance.Name] = (modelCounts[instance.Name] or 0) + 1 end
		end)
		for targetName in config.Animations do
			local matches = modelCounts[targetName] or 0
			assert(matches == 1, "Expected exactly one cutscene model named " .. targetName .. "; found " .. matches)
		end
		local rigParts = {}
		local atomicRoots = {}
		for targetName in config.Animations do
			local rig = clone:FindFirstChild(targetName, true)
			if rig then
				atomicRoots[rig] = true
				visit({ rig }, function(instance)
					if instance:IsA("BasePart") then rigParts[instance] = true end
				end)
			end
		end
		-- Cutscene assets are scenery, not gameplay actors or spawn points.
		visit({ clone }, function(instance)
			if instance:IsA("BaseScript") then instance.Enabled = false end
			if instance:IsA("SpawnLocation") then instance.Enabled = false end
			if instance:IsA("BasePart") then
				instance.CanCollide = false
				instance.CanTouch = false
				-- Loose effect parts must not fall below FallenPartsDestroyHeight
				-- while clients prepare. Animated rigs retain their joint setup.
				if not rigParts[instance] then instance.Anchored = true end
			end
		end)
		for targetName in config.Animations do
			local rig = clone:FindFirstChild(targetName, true)
			if rig and rig:IsA("Model") then
				local root = rig:FindFirstChild("HumanoidRootPart") or rig.PrimaryPart
				if not root then
					local motor = rig:FindFirstChildWhichIsA("Motor6D", true)
					root = motor and motor.Part0
				end
				assert(root, "Missing rig root: " .. targetName)
				root.Anchored = true
			end
		end
		phase("Scene mount")
		if workspace.StreamingEnabled or fastMount then
			streamingContainer = Instance.new("Model")
			streamingContainer.Name = "CutsceneScene_" .. name
			streamingContainer.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
			if not fastMount then streamingContainer.Parent = workspace end
		end
		roots = clone:GetChildren()
		for _, root in roots do
			if root:IsA("Model") then root.ModelStreamingMode = Enum.ModelStreamingMode.Persistent end
		end
		if fastMount then
			-- Preserve complete rig/model trees; no leaf detachment or per-part waits.
			-- Requested tradeoff: one replication/physics spike instead of a long mount.
			for _, root in roots do root.Parent = streamingContainer end
			clone:Destroy() -- now-empty wrapper, not source assets
			streamingContainer.Parent = workspace
		else
			SceneLifecycle.Mount(clone, streamingContainer or workspace, atomicRoots)
		end
		staging = nil
		for _, root in roots do
			local sceneReference = Instance.new("ObjectValue")
			sceneReference.Name = root.Name
			sceneReference.Value = root
			sceneReference.Parent = sceneRoots
		end
		SceneLifecycle.Visit(roots, function(part)
			if part:IsA("BasePart") and not part.Anchored and part:CanSetNetworkOwnership() then
				part:SetNetworkOwner(nil)
			end
		end)
		-- Bind concrete targets on the server, including unique nested shorthand.
		-- ObjectValues let clients distinguish absent assets from pending replication.
		local targets = Instance.new("Folder")
		targets.Name = "VFXTargets"
		local targetCount = 0
		for key, path in ScenePaths.Collect(config.VFX and config.VFX.Events) do
			targetCount += 1
			local target, reason = ScenePaths.Resolve(roots, path)
			local reference = Instance.new("ObjectValue")
			reference.Name = tostring(targetCount)
			reference:SetAttribute("PathKey", key)
			if target then
				reference.Value = target
				reference:SetAttribute("DescendantCount", #target:GetDescendants())
			else
				reference:SetAttribute("Unavailable", reason)
				warn("[ServerCutscene] " .. name .. ": " .. reason .. "; fix the asset/path in CutsceneTracks")
			end
			reference.Parent = targets
		end
		state:SetAttribute("VFXTargetCount", targetCount)
		targets.Parent = state
		local function find(targetName)
			for _, root in roots do
				local result = if root.Name == targetName then root else root:FindFirstChild(targetName, true)
				if result then return result end
			end
			return nil
		end
		local cameraModel = assert(find(config.Camera.Model), "Missing camera model")
		local part = assert(cameraModel:FindFirstChild(config.Camera.Part, true), "Missing CamPart")
		assert(part:IsA("BasePart"), "CamPart must be a BasePart")
		cameraValue.Value = part
		local trackLabels, optionalTracks = {}, {}
		phase("Server animations")
		for targetName, id in config.Animations do
			local model = assert(find(targetName), "Missing rig: " .. targetName)
			local host = model:FindFirstChildWhichIsA("Humanoid", true)
				or model:FindFirstChildWhichIsA("AnimationController", true)
			if not host then
				host = Instance.new("AnimationController")
				host.Parent = model
			end
			local animator = host:FindFirstChildOfClass("Animator") or Instance.new("Animator")
			animator.Parent = host
			local animatorReference = Instance.new("ObjectValue")
			animatorReference.Name = targetName
			animatorReference.Value = animator
			animatorReference:SetAttribute("AnimationId", tostring(id))
			animatorReference:SetAttribute("Optional", config.Actors and config.Actors[targetName] ~= nil)
			local modelReference = Instance.new("ObjectValue")
			modelReference.Name = "Model"
			modelReference.Value = model
			modelReference.Parent = animatorReference
			animatorReference.Parent = rigTracks
			local animation = Instance.new("Animation")
			animation.AnimationId = "rbxassetid://" .. id
			table.insert(animations, animation)
			local track = animator:LoadAnimation(animation)
			trackLabels[track] = targetName .. " (" .. tostring(id) .. ")"
			optionalTracks[track] = config.Actors and config.Actors[targetName] ~= nil or false
			if targetName == config.Camera.Model then
				track.Name = "CutsceneCameraTrack"
			end
			track.Looped = false
			track.Priority = Enum.AnimationPriority.Action4
			table.insert(tracks, track)
		end
		assert(#tracks > 0, "Cutscene has no animations")
		local deadline = os.clock() + 20
		repeat
			local pending = {}
			for _, track in tracks do
				if track.Length <= 0 and not optionalTracks[track] then table.insert(pending, trackLabels[track]) end
			end
			if #pending == 0 then break end
			assert(os.clock() < deadline, "Animation load timed out; check asset permissions: " .. table.concat(pending, ", "))
			RunService.Heartbeat:Wait()
		until false
		for _, track in tracks do
			if track.Length <= 0 then
				warn("[ServerCutscene] Optional animation unavailable; using static authored actor: " .. trackLabels[track])
				continue
			end
			if track.Name == "CutsceneCameraTrack" then
				state:SetAttribute("CameraDuration", track.Length)
			end
			-- Replicate every paused track before clients acknowledge readiness.
			track:Play(0, 1, 0)
			track.TimePosition = 0
			table.insert(playbackTracks, track)
		end
		-- The camera defines the shot, not a longer character animation's idle tail.
		local duration = PlaybackClock.Duration(state:GetAttribute("CameraDuration"), config.MaxDuration)
		state:SetAttribute("Duration", duration)
		local requiredTrackCount = 0
		for _, reference in rigTracks:GetChildren() do
			if not reference:GetAttribute("Optional") then requiredTrackCount += 1 end
		end
		state:SetAttribute("TrackCount", requiredTrackCount)
		state.Parent = ReplicatedStorage
		-- Clients can preload the intro concurrently with off-world map preparation.
		-- Do not start the animation clock until preparation has finished (no Clone
		-- spike mid-animation). The next map is still NOT mounted into Workspace.
		phase("Off-world map preparation")
		if prepareNext then prepareNext() end
		phase("Client preparation")
		deadline = os.clock() + 60
		local nextReport = os.clock() + 5
		repeat
			local audience = Players:GetPlayers()
			local allReady = #audience > 0
			local pending = {}
			for _, player in audience do
				assert(not failures[player], player.Name .. ": " .. tostring(failures[player]))
				if not acknowledged[player] then
					allReady = false
					table.insert(pending, player.Name .. ": " .. (stages[player] or "No bootstrap response"))
				end
			end
			if allReady then break end
			if os.clock() >= nextReport then
				warn("[ServerCutscene] Waiting for clients: " .. table.concat(pending, "; "))
				nextReport = os.clock() + 5
			end
			assert(os.clock() < deadline, "Cutscene preparation timed out: " .. table.concat(pending, "; "))
			RunService.Heartbeat:Wait()
		until false
		-- Give the shared start timestamp time to reach the prepared clients.
		state:SetAttribute("StartedAt", workspace:GetServerTimeNow() + 0.5)
		phase("Playing")
		local playbackError = nil
		playbackConnection = RunService.PreAnimation:Connect(function()
			if playbackError then return end
			local ok, failure = pcall(PlaybackClock.Apply, playbackTracks, PlaybackClock.Elapsed(state, workspace:GetServerTimeNow()))
			if not ok then playbackError = failure end
		end)
		while PlaybackClock.Elapsed(state, workspace:GetServerTimeNow()) < duration do
			assert(not playbackError, tostring(playbackError))
			for player, failure in failures do
				if player.Parent == Players then error(player.Name .. ": " .. failure) end
			end
			RunService.Heartbeat:Wait()
		end
		ReplicatedStorage:SetAttribute("CutsceneEndedAt", workspace:GetServerTimeNow())
	end, debug.traceback)
	local failedPhase = currentPhase
	local cleanupStarted = os.clock()
	phase("Cleanup")
	Cleanup.Try("Ready listener", function() connection:Disconnect() end)
	if stopProfiles then Cleanup.Try("Profiles", stopProfiles) end
	if playbackConnection then Cleanup.Try("Playback listener", function() playbackConnection:Disconnect() end) end
	Cleanup.Try("Replicated session", function() state:Destroy() end)
	for _, track in tracks do
		Cleanup.Try("Stop rig animation", function() track:Stop(0) end)
		Cleanup.Try("Destroy rig animation", function() track:Destroy() end)
	end
	for _, animation in animations do Cleanup.Try("Animation asset", function() animation:Destroy() end) end
	if fastCleanup then
		-- Delete the owned container as a unit, including Models/Folders, not leaves
		-- spread over many frames. Never search/delete similarly named source assets.
		if streamingContainer then Cleanup.Try("Fast scene container", function() streamingContainer:Destroy() end) end
		for _, root in roots do Cleanup.Try("Fast owned root", function() root:Destroy() end) end
		if staging then Cleanup.Try("Fast staging scene", function() staging:Destroy() end); staging = nil end
	elseif not Cleanup.Try("Scene roots", function() SceneLifecycle.Destroy(roots, true) end) then
		for _, root in roots do
			if not Cleanup.Try("Retry scene root " .. root.Name, function() SceneLifecycle.Destroy({ root }, true) end) then
				-- Emergency path only: owned clone, never source assets or arbitrary Workspace models.
				Cleanup.Try("Remove failed owned root", function() root:Destroy() end)
			end
		end
	end
	if staging then Cleanup.Try("Staging scene", function() SceneLifecycle.Destroy({ staging }) end) end
	if streamingContainer then Cleanup.Try("Streaming container", function() streamingContainer:Destroy() end) end
	ReplicatedStorage:SetAttribute("CutsceneCleanupSeconds", os.clock() - cleanupStarted)
	ReplicatedStorage:SetAttribute("CutscenePhase", if success then "Finished" else "Failed: " .. failedPhase)
	if not success then
		local detail = "[" .. failedPhase .. "] " .. tostring(err)
		ReplicatedStorage:SetAttribute("CutsceneError", string.sub(detail, 1, 1000))
		error(detail, 0)
	end
end

return ServerCutscene
]]></string>
            </Properties>
