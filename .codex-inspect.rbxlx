        </Item>
        <Item class="Folder" referent="597">
          <Properties>
            <string name="Name">Unit</string>
          </Properties>
          <Item class="ModuleScript" referent="598">
            <Properties>
              <string name="Name">BaseUnit</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Signal = require(ReplicatedStorage.Packages.Signal)
local UnitData = require(ReplicatedStorage.Settings.Data.UnitData)
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local Net = require(ReplicatedStorage.Shared.Net)

-------------------------------------------------
--// BaseUnit
-------------------------------------------------
local BaseUnit = {}
BaseUnit.__index = BaseUnit

function BaseUnit.new(
	summoner,
	unitId: number,
	unitName: string,
	pathAlpha: number?,
	isEnemyType: boolean?,
	customUnitStats: { [string]: any }?
)
	local self = setmetatable({}, BaseUnit)

	self.Id = unitId
	self.Summoner = summoner
	self.SummonerId = summoner.Id

	self.Name = unitName
	self.PathAlpha = pathAlpha or 1
	self.IsEnemyType = isEnemyType
	self.TargetMode = "First"

	self.Position = GetPath:Get():CalculateUniformPosition(self.PathAlpha)

	self.Died = Signal.new()
	self.Destroyed = Signal.new()

	local targetData = isEnemyType and EnemyData.ByName[self.Name] or UnitData.ByName[self.Name]
	if targetData then
		self.BaseSpeed = targetData.WalkSpeed
		self.MaxHealth = targetData.MaxHealth
		self.Stats = targetData.Stats and TableUtils.DeepCopy(targetData.Stats)

		local custom = customUnitStats or (self.Summoner and self.Summoner.Stats and self.Summoner.Stats.UnitStats)
		if custom then
			if custom.MaxHealth then
				self.MaxHealth = custom.MaxHealth
			end
			if custom.WalkSpeed then
				self.BaseSpeed = custom.WalkSpeed
			end

			if self.Stats then
				for key, val in pairs(custom) do
					if key ~= "MaxHealth" and key ~= "WalkSpeed" then
						self.Stats[key] = val
					end
				end
			end
		end

		self.WalkSpeed = self.BaseSpeed
		self.Health = self.MaxHealth
	end

	self.Components = {}
	self:_AddComponent("CrashComponent")

	self:_ApplyNewStats()

	return self
end

function BaseUnit:TakeDamage(amount: number)
	if self.IsDead then
		return
	end

	self.Health -= amount

	Net.UnitService.OnDamaged.FireAll({
		unitId = self.Id,
		damaged = amount,
	})

	if self.Health <= 0 and not self.IsDead then
		self.IsDead = true
		self.Died:Fire()

		self:Destroy()
	end
end

function BaseUnit:Destroy(forcing: boolean?)
	for _, component in pairs(self.Components) do
		component:Destroy()
	end
	table.clear(self.Components)

	self.Destroyed:Fire(forcing)

	if self.Destroyed then
		task.defer(self.Destroyed.Destroy, self.Destroyed)
	end
end

function BaseUnit:_ApplyNewStats()
	if not self.Stats then
		return
	end

	local needsAttack = self.Stats.AttackType and self.Stats.Damage
	local needsExplosion = self.Stats.ExplosionRange and self.Stats.ExplosionDamage

	if needsAttack and not self.Components["AttackComponent"] then
		self:_AddComponent("AttackComponent")
	end
	if needsExplosion and not self.Components["ExplosionComponent"] then
		self:_AddComponent("ExplosionComponent")
	end
end

function BaseUnit:_AddComponent(componentName: string)
	if self.Components[componentName] then
		warn(`이미 '{componentName}' 컴포넌트가 존재함.`)
		return self.Components[componentName]
	end

	local targetComponent = script.Components:FindFirstChild(componentName)
	if not targetComponent then
		warn(`'{componentName}'는 존재하지 않는 컴포넌트임.`)
		return nil
	end

	local newComponent = require(targetComponent).new(self)
	self.Components[componentName] = newComponent

	if type(newComponent.Start) == "function" then
		newComponent:Start()
	end

	return newComponent
end

return BaseUnit
]]></string>
            </Properties>
            <Item class="Folder" referent="599">
              <Properties>
                <string name="Name">Components</string>
              </Properties>
              <Item class="ModuleScript" referent="600">
                <Properties>
                  <string name="Name">AttackComponent</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/Modules
local FindTarget = require(ReplicatedStorage.Shared.Modules.Core.FindTarget)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local Net = require(ReplicatedStorage.Shared.Net)
local TimeService

-------------------------------------------------
--// AttackComponent
-------------------------------------------------
local AttackComponent = {}
AttackComponent.__index = AttackComponent

function AttackComponent.new(unit)
	local self = setmetatable({}, AttackComponent)
	self.Unit = unit

	self.CooldownTimer = 0

	return self
end

function AttackComponent:Start()
	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	self.HeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		self.CooldownTimer -= dt * TimeService:GetGameSpeed()

		if self.CooldownTimer > 0 then
			return
		end

		local attackCount = 0
		local maxAttacksPerFrame = 3

		while self.CooldownTimer <= 0 and attackCount < maxAttacksPerFrame do
			local didAttack = self:_Attack()

			if didAttack then
				self.CooldownTimer += self.Unit.Stats.Cooldown
				attackCount += 1
			else
				self.CooldownTimer = 0
				break
			end
		end
	end)
end

function AttackComponent:Destroy()
	if self.HeartbeatConnection then
		self.HeartbeatConnection:Disconnect()
		self.HeartbeatConnection = nil
	end
end

function AttackComponent:_ExecuteAttack(attackType, target)
	if not self.Unit or self.Unit.IsDestroyed then
		return
	end

	if attackType == "Single" then
		self:_ApplyDamage(target)
	elseif attackType == "Splash" then
		self:_SplashAOEAttack(target)
	elseif attackType == "Angle" then
		self:_AngleAOEAttack(target)
	elseif attackType == "Line" then
		self:_LineAOEAttack(target)
	end
end

function AttackComponent:_Attack(): boolean
	local target = FindTarget.GetTarget(self.Unit)
	if not target then
		return false
	end

	local currentAttackType = self.Unit.Stats.AttackType
	local attackDelay = self.Unit.Stats.AttackDelay or 0

	Net.UnitService.OnAttackEnemy.FireAll({
		unitId = self.Unit.Id,
		enemyId = target.Id,
	})

	if self.Unit.Stats and self.Unit.Stats.StopWhenAttacking then
		self.Unit.PauseEndTime = os.clock() + 3
	end

	if attackDelay > 0 then
		TimeService = TimeService or ServiceRegistry:GetService("TimeService")
		TimeService.DeltaDelay(attackDelay):andThen(function()
			self:_ExecuteAttack(currentAttackType, target)
		end)
	else
		self:_ExecuteAttack(currentAttackType, target)
	end

	return true
end

function AttackComponent:_ApplyDamage(target)
	if not target or target.IsDestroyed then
		return
	end

	local damageContext = {
		Amount = self.Unit.Stats.Damage,
		Target = target,
	}

	self.Unit.Summoner:GetEvent("BeforeDamage"):Fire(damageContext)

	local actualDamage, isKilled = target:TakeDamage(damageContext.Amount)
	if actualDamage and actualDamage > 0 then
		self.Unit.Summoner:GetEvent("AfterDamaged"):Fire(target, actualDamage)
	end

	if isKilled then
		self.Unit.Summoner:GetEvent("Killed"):Fire(target)
	end
end

function AttackComponent:_SplashAOEAttack(target)
	local targetList = FindTarget.GetTargetInSplash(self.Stats, target.Position)

	self:_ApplyAOEDamage(targetList)
end

function AttackComponent:_AngleAOEAttack(target)
	local targetList = FindTarget.GetTargetInAngle(self.Unit, self.Stats, self.Unit.Position, target.Position)

	self:_ApplyAOEDamage(targetList)
end

function AttackComponent:_LineAOEAttack(target)
	local targetList = FindTarget.GetTargetInLine(self.Unit, self.Stats, target.Position)

	self:_ApplyAOEDamage(targetList)
end

function AttackComponent:_ApplyAOEDamage(targetList)
	for _, enemy in targetList do
		self:_ApplyDamage(enemy)
	end
end

return AttackComponent
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="601">
                <Properties>
                  <string name="Name">CrashComponent</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/Modules
local EnemyService
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)

--/Constants
local DEFAULT_CRASH_RANGE = 2.5

-------------------------------------------------
--// CrashComponent
-------------------------------------------------
local CrashComponent = {}
CrashComponent.__index = CrashComponent

function CrashComponent.new(unit)
	local self = setmetatable({}, CrashComponent)
	self.Unit = unit

	return self
end

function CrashComponent:Start()
	self.HeartbeatConnection = RunService.Heartbeat:Connect(function()
		self:_Crash()
	end)
end

function CrashComponent:Destroy()
	if self.HeartbeatConnection then
		self.HeartbeatConnection:Disconnect()
		self.HeartbeatConnection = nil
	end
end

function CrashComponent:_Crash()
	local unit = self.Unit
	if not unit or unit.IsDestroyed or unit.IsDead then
		return
	end

	local targetEnemy = self:_FindCrashTarget()
	if not targetEnemy then
		return
	end

	local unitHealth = unit.Health
	local enemyHealth = targetEnemy.Health

	local _, isKilled = targetEnemy:TakeDamage(unitHealth)
	if isKilled then
		self.Unit.Summoner:GetEvent("Killed"):Fire(targetEnemy)
	end

	unit:TakeDamage(enemyHealth)
end

function CrashComponent:_FindCrashTarget()
	EnemyService = EnemyService or ServiceRegistry:GetService("EnemyService")

	local unit = self.Unit
	local crashRange = (unit.Stats and unit.Stats.CrashRange) or unit.CrashRange or DEFAULT_CRASH_RANGE
	local unitPosition = unit.Position

	local closestEnemy = nil
	local closestDistance = math.huge

	local potentialEnemies = EnemyService.EnemyGrid:GetEntitiesInRange(unitPosition, crashRange)

	for _, enemy in potentialEnemies do
		if enemy.IsDead or enemy.IsDestroyed then
			continue
		end

		local offset = enemy.Position - unitPosition
		local distance = offset.X ^ 2 + offset.Z ^ 2

		if distance < closestDistance then
			closestEnemy = enemy
			closestDistance = distance
		end
	end

	return closestEnemy
end

return CrashComponent
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="602">
                <Properties>
                  <string name="Name">ExplosionComponent</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local FindTarget = require(ReplicatedStorage.Shared.Modules.Core.FindTarget)

-------------------------------------------------
--// ExplosionComponent
-------------------------------------------------
local ExplosionComponent = {}
ExplosionComponent.__index = ExplosionComponent

function ExplosionComponent.new(unit)
	local self = setmetatable({}, ExplosionComponent)
	self.Unit = unit

	return self
end

function ExplosionComponent:Start()
	self.DiedConnection = self.Unit.Died:Connect(function()
		self:Explosion()
	end)
end

function ExplosionComponent:Explosion()
	local affectEnemies = FindTarget.GetEnemiesInRange(self.Unit, self.Unit.Stats.ExplosionRange)

	for _, enemy in affectEnemies do
		local _, isKilled = enemy:TakeDamage(self.Unit.Stats.ExplosionDamage)

		if isKilled and self.Unit.Summoner then
			self.Unit.Summoner:GetEvent("Killed"):Fire(enemy)
		end
	end
end

function ExplosionComponent:Destroy()
	if self.DiedConnection then
		self.DiedConnection:Disconnect()
		self.DiedConnection = nil
	end
end

return ExplosionComponent
]]></string>
                </Properties>
