if not RunService:IsClient() then
    error("Client network module can only be required from the client.")
end

local Reliable: RemoteEvent = ReplicatedStorage:WaitForChild(BASE_EVENT_NAME .. "_RELIABLE_REMOTE") :: RemoteEvent
local Unreliable: UnreliableRemoteEvent = ReplicatedStorage:WaitForChild(BASE_EVENT_NAME .. "_UNRELIABLE_REMOTE") :: UnreliableRemoteEvent

local function StepReplication()
    if SendCursor &lt;= 0 then
        return
    end

    local Buffer = buffer.create(SendCursor)
    buffer.copy(Buffer, 0, SendBuffer, 0, SendCursor)
    Reliable:FireServer(Buffer, SendInstances)

    SendSize = 64
    SendCursor = 0
    SendOffset = 0
    SendBuffer = buffer.create(64)
    table.clear(SendInstances)
end
RunService.Heartbeat:Connect(StepReplication)
Reliable.OnClientEvent:Connect(function(Buffer: buffer, Instances: {Instance})
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstances = Instances
	RecieveInstanceCursor = 0
	local Size = buffer.len(RecieveBuffer)
	if SerdesThread and coroutine.status(SerdesThread) == "suspended" then
		warn(`[Blink]: Yielded in a Sync call. Event "{SerdesEvent}" uses a Sync call, consider using an Async call instead.`)
		coroutine.close(SerdesThread)
	end
	SerdesThread = coroutine.running()
	while (RecieveCursor &lt; Size) do
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		if Index == 0 then
			local Value: { enemyId: number, enemyIndex: number, sendTimeMs: number, isBoss: boolean?, startPathAlpha: number?, pathId: number } = SerdesFunctions.EnemyService_ReadEVENT_ReplicatedEnemy()
			if Events.Reliable[0] ~= nil then
				SerdesEvent = "ReplicatedEnemy"
				Events.Reliable[0](Value)
			else
				if #Queue.Reliable[0] &gt; 256 then
					warn("[Blink]: Event queue of \"ReplicatedEnemy\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[0], {Value} :: {any})
			end
		elseif Index == 1 then
			local Value: number = SerdesFunctions.EnemyService_ReadEVENT_DestroyEnemy()
			if Events.Reliable[1] ~= nil then
				SerdesEvent = "DestroyEnemy"
				Events.Reliable[1](Value)
			else
				if #Queue.Reliable[1] &gt; 256 then
					warn("[Blink]: Event queue of \"DestroyEnemy\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[1], {Value} :: {any})
			end
		elseif Index == 2 then
			local Value: { enemyId: number, WalkSpeed: number, sendTimeMs: number } = SerdesFunctions.EnemyService_ReadEVENT_UpdateSpeed()
			if Events.Reliable[2] ~= nil then
				SerdesEvent = "UpdateSpeed"
				Events.Reliable[2](Value)
			else
				if #Queue.Reliable[2] &gt; 256 then
					warn("[Blink]: Event queue of \"UpdateSpeed\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[2], {Value} :: {any})
			end
		elseif Index == 3 then
			local Value: { enemyId: number, MoveDirection: boolean, sendTimeMs: number } = SerdesFunctions.EnemyService_ReadEVENT_UpdateDirection()
			if Events.Reliable[3] ~= nil then
				SerdesEvent = "UpdateDirection"
				Events.Reliable[3](Value)
			else
				if #Queue.Reliable[3] &gt; 256 then
					warn("[Blink]: Event queue of \"UpdateDirection\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[3], {Value} :: {any})
			end
		elseif Index == 4 then
			local Value: { enemyId: number, studs: number } = SerdesFunctions.EnemyService_ReadEVENT_TakeKnockback()
			if Events.Reliable[4] ~= nil then
				SerdesEvent = "TakeKnockback"
