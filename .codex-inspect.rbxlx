              <Item class="ModuleScript" referent="481">
                <Properties>
                  <string name="Name">shockwave_ring</string>
                  <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local attr = require("../mod/attributes")
local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")

local Promise = require(ReplicatedStorage.Packages.Promise)
local ObjectCache = require("../obj/ObjectCache")

local rng = Random.new()

local ring = {}

local part_cache: ObjectCache.ObjectCache?

function ring.init(cache)
	part_cache = cache
end

function ring.deinit()
	part_cache = nil
end

function ring.emit(origin: Attachment, ref: Part, scope: types.scope)
	if not part_cache then
		return
	end

	local raydir = attr.get(origin, "RayDirection", vector.create(0, -50, 0))

	local rayColGroup = attr.get(origin, "RayCollisionGroup", "Default")
	local rayFilterTag = attr.get(origin, "FilterTag", "")
	local rayFilterType = attr.get(origin, "FilterType", "Exclude")

	local rayIgnoreWater = attr.get(origin, "IgnoreWater", true)
	local rayIgnoreCanCollide = attr.get(origin, "IgnoreCanCollide", false)

	local params = RaycastParams.new()
	params.CollisionGroup = rayColGroup
	params.IgnoreWater = rayIgnoreWater
	params.RespectCanCollide = not rayIgnoreCanCollide
	params.FilterType = Enum.RaycastFilterType[rayFilterType]
	params.FilterDescendantsInstances = CollectionService:GetTagged(rayFilterTag)

	if rayFilterType == "Exclude" then
		params:AddToFilter({ workspace.Terrain })
	end

	local emitDelay = attr.get(ref, "EmitDelay", 0)

	local radius = attr.get(ref, "Radius", 5)
	local segments = attr.get(ref, "Segments", 7)

	local lifetime = attr.getRange(ref, "Lifetime", NumberRange.new(2, 3), NumberRange.new(0, math.huge))

	local old_partOffset = attr.get(ref, "PartOffset", vector.zero, true)

	local baseOffset = attr.get(ref, "BaseOffset", old_partOffset)
	local offsetStart = attr.get(ref, "Offset_Start", old_partOffset)
	local offsetEnd = attr.get(ref, "Offset_End", old_partOffset)

	local offsetStartDuration = attr.get(ref, "Offset_Start_Duration", 0.5)
	local offsetEndDuration = attr.get(ref, "Offset_End_Duration", 0.5)

	local sizeScaleStart = attr.get(ref, "SizeScaleStart", vector.zero)
	local sizeScaleEnd = attr.get(ref, "SizeScaleEnd", vector.zero)

	local minSize = attr.get(ref, "MinSize", vector.create(2, 1, 2))
	local maxSize = attr.get(ref, "MaxSize", vector.create(3, 2, 3))

	local old_sizeCurve = attr.get(ref, "Size_Curve", utility.default_bezier, true)
	local old_sizeDuration = attr.get(ref, "Size_Duration", 0.5, true)

	local sizeStartCurve = attr.get(ref, "Size_Start_Curve", old_sizeCurve)
	local sizeEndCurve = attr.get(ref, "Size_End_Curve", old_sizeCurve)

	local sizeStartDuration = attr.get(ref, "Size_Start_Duration", old_sizeDuration)
	local sizeEndDuration = attr.get(ref, "Size_End_Duration", old_sizeDuration)

	local tpDuration = attr.get(ref, "Transparency_Duration", 0.5)

	local tpStart = attr.get(ref, "Transparency_Start", 0)
	local tpEnd = attr.get(ref, "Transparency_End", 0)

	if emitDelay > 0 then utility.gameWait(emitDelay) end

	local promises = {}
	local originCFrame = utility.getTransformedOriginExtents(origin)

	for i = 0, segments - 1 do
		local angle = i / segments * math.pi * 2

		local x = radius * math.cos(angle)
		local y = radius * math.sin(angle)

		local result = workspace:Raycast(
			(originCFrame * CFrame.new(x, 0, y)).Position,
			originCFrame:VectorToWorldSpace(raydir),
			params
		)

		if not result then
			continue
		end

		local width = rng:NextNumber(minSize.X, maxSize.X)

		local height = rng:NextNumber(minSize.Y, maxSize.Y)
		local length = rng:NextNumber(minSize.Z, maxSize.Z)

		local id = utility.getRandomId()

		local part = part_cache:get(id)

		local realPart = part._getReal()

		utility.copyProperties(ref, realPart, utility.COPY_PART_PROPERTIES)
		utility.copyProperties(ref, realPart, utility.COPY_EXTENDED_PART_PROPERTIES)

		if #ref:GetChildren() ~= 0 then
			local clone = ref:Clone()

			for _, child in clone:GetChildren() do
				child.Parent = realPart
			end

			clone:Destroy()
		end

		local emitOnFinish = scope.effects.prepareEmitOnFinish(part, scope)

		table.insert(scope, function()
			if part_cache then
				part_cache:free(id)
			end
		end)

		part.Color = result.Instance.Color
		part.Material = result.Material
		part.Transparency = result.Instance.Transparency

		if part.Transparency == 0 then
			part.Transparency = tpStart
		end

		part.Size = Vector3.zero

		local rx = -math.cos(angle)
		local rz = -math.sin(angle)

		local dir = originCFrame:VectorToWorldSpace(Vector3.new(rx, 0, rz))
		local right = dir:Cross(result.Normal).Unit

		local rotCF = CFrame.fromMatrix(result.Position, right, result.Normal)
			* CFrame.fromOrientation(-math.atan(height / length), 0, 0)

		part.CFrame = CFrame.new(offsetStart) * rotCF

		local sizeTween
		local offsetTween

		local currentOffset = Vector3.zero

		if offsetStart ~= baseOffset then
			offsetTween = tween.fromParams(
				attr.get(ref, "Offset_Start_Curve", utility.default_bezier),
				offsetStartDuration,
				function(alpha, deltaTime)
					currentOffset = offsetStart:Lerp(baseOffset, alpha)
					part.CFrame = CFrame.new(currentOffset) * rotCF
					return deltaTime
				end
			)

			table.insert(scope, sizeTween)
		end

		local size = Vector3.new(width, height, length)

		if size * sizeScaleStart ~= size then
			sizeTween = tween.fromParams(sizeStartCurve, sizeStartDuration, function(alpha, deltaTime)
				part.Size = (size * sizeScaleStart):Lerp(size, alpha)
				return deltaTime
			end)

			table.insert(scope, sizeTween)
		else
			part.Size = size * sizeScaleStart
		end

		local env = scope.effects.emitNested(part, scope.depth + 1, scope)
		table.insert(promises, env.Finished)

		task.delay(rng:NextNumber(lifetime.Min, lifetime.Max), function()
			if sizeTween then
				sizeTween:Disconnect()
			end

			if offsetTween then
				offsetTween:Disconnect()
			end

			local startSize = part.Size
			local startTp = part.Transparency

			if startSize ~= size * sizeScaleEnd then
				table.insert(
					scope,
					tween.fromParams(sizeEndCurve, sizeEndDuration, function(alpha, deltaTime)
						part.Size = startSize:Lerp(size * sizeScaleEnd, alpha)
						return deltaTime
					end)
				)
			end

			if currentOffset ~= offsetEnd then
				table.insert(
					scope,
					tween.fromParams(
						attr.get(ref, "Offset_End_Curve", utility.default_bezier),
						offsetEndDuration,
						function(alpha, deltaTime)
							part.CFrame = CFrame.new(currentOffset:Lerp(offsetEnd, alpha)) * rotCF
							return deltaTime
						end
					)
				)
			end

			if startTp ~= tpEnd then
				table.insert(
					scope,
					tween.fromParams(
						attr.get(ref, "Transparency_Curve", utility.default_bezier),
						tpDuration,
						function(alpha, deltaTime)
							part.Transparency = utility.lerp(startTp, tpEnd, alpha)
							return deltaTime
						end
					)
				)
			end

			local env = scope.effects.emitOnFinish(emitOnFinish, part, scope.depth + 1, scope)
			table.insert(promises, env.Finished)
		end)
	end

	task.wait(lifetime.Max)
	utility.gameWait(math.max(sizeEndDuration, offsetEndDuration))

	Promise.all(promises):await()
end

return ring
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="482">
                <Properties>
                  <string name="Name">sound</string>
                  <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local attr = require("../mod/attributes")

local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")
local Promise = require(ReplicatedStorage.Packages.Promise)

local rng = Random.new()

local sound = {}

local soundWidget: DockWidgetPluginGui?

local function selectRandomSound(ref: Sound): Sound?
	local poolTag = attr.get(ref, "SoundPoolTag", "")

	if poolTag == "" then
		return ref
	end

	local sounds = CollectionService:GetTagged(poolTag)

	local weights: { number } = {}
	local validSounds: { Sound } = {}

	local totalWeight = 0

	for _, obj in sounds do
		if not obj:IsA("Sound") then
			continue
		end

		table.insert(validSounds, obj)

		local weight = attr.get(obj, "SoundPoolWeight", 1)

		table.insert(weights, weight)
		totalWeight += weight
	end

	if #validSounds == 0 then
		return ref
	end

	if totalWeight > 0 then
		local roll = rng:NextNumber() * totalWeight
		local accumulated = 0

		for i, weight in weights do
			accumulated += weight

			if roll <= accumulated then
				return validSounds[i]
			end
		end
	end

	return validSounds[rng:NextInteger(1, #validSounds)]
end

local function createSoundClone(ref: Sound, sourceSound: Sound, scope: types.scope): (Sound, Part?)
	local clone = sourceSound:Clone()

	for _, tag in clone:GetTags() do
		clone:RemoveTag(tag)
	end

	local parent = ref:FindFirstAncestorWhichIsA("BasePart")

	local partClone

	if utility.PLUGIN_CONTEXT then
		if parent then
			partClone = Instance.new("Part")

			partClone.Name = "SoundEmitter"
			partClone.Anchored = true
			partClone.CanCollide = false
			partClone.CanQuery = false
			partClone.CanTouch = false
			partClone.Transparency = 1
			partClone.Size = Vector3.one
			partClone.CFrame = parent.CFrame
			partClone.Parent = soundWidget

			clone.Parent = partClone

			table.insert(scope, partClone)
		else
			clone.Parent = soundWidget
			table.insert(scope, clone)
		end
	else
		if parent then
			clone.Parent = parent
		else
			clone.Parent = workspace.Terrain
		end

		table.insert(scope, clone)
	end

	return clone, partClone
end

local function playSingleSound(
	ref: Sound,
	src: Sound,
	clone: Sound,
	partClone: Part?,
	scope: types.scope,
	emitDuration: number
): RBXScriptConnection?
	local currentSpeed = clone.PlaybackSpeed

	local volumeEnd = attr.get(src, "Volume_End", clone.Volume)
	local volumeStart = attr.get(src, "Volume_Start", clone.Volume)

	clone.Volume = volumeStart

	if volumeStart ~= volumeEnd then
		local volumeDuration = attr.get(src, "Volume_Duration", clone.TimeLength)

		table.insert(
			scope,
			tween.fromParams(
				attr.get(src, "Volume_Curve", utility.default_bezier),
				volumeDuration,
				function(alpha, deltaTime)
					clone.Volume = utility.lerp(volumeStart, volumeEnd, alpha)
					return deltaTime * currentSpeed
				end
			)
		)
	else
		clone.Volume = volumeStart
	end

	local speedEnd = attr.get(src, "Speed_End", clone.PlaybackSpeed)
	local speedStart = attr.get(src, "Speed_Start", clone.PlaybackSpeed)

	currentSpeed = speedStart

	local speedTween: RBXScriptConnection? = nil

	if speedStart ~= speedEnd then
		local speedDuration = attr.get(src, "Speed_Duration", clone.TimeLength)

		speedTween = tween.fromParams(
			attr.get(src, "Speed_Curve", utility.default_bezier),
			speedDuration,
			function(alpha, deltaTime)
				currentSpeed = utility.lerp(speedStart, speedEnd, alpha)
				clone.PlaybackSpeed = currentSpeed
				return deltaTime
			end
		)

		table.insert(scope, speedTween)
	else
		clone.PlaybackSpeed = speedStart
	end

	local rolloffEnd = attr.get(src, "RollOff_End", clone.RollOffMinDistance)
	local rolloffStart = attr.get(src, "RollOff_Start", clone.RollOffMinDistance)

	if rolloffStart ~= rolloffEnd then
		local rolloffDuration = attr.get(src, "RollOff_Duration", clone.TimeLength)

		table.insert(
			scope,
			tween.fromParams(
				attr.get(src, "RollOff_Curve", utility.default_bezier),
				rolloffDuration,
				function(alpha, deltaTime)
					clone.RollOffMinDistance = utility.lerp(rolloffStart, rolloffEnd, alpha)
					return deltaTime * currentSpeed
				end,
				speedTween
			)
		)
	end

	if clone.PlayOnRemove and not utility.PLUGIN_CONTEXT then
		clone:Destroy()
	else
		clone:Play()
	end

	if partClone then
		local parent = ref:FindFirstAncestorWhichIsA("BasePart")

		if parent then
			table.insert(
				scope,
				RunService.Heartbeat:Connect(function()
					if partClone.Parent then
						partClone.CFrame = parent.CFrame
					end
				end)
			)
		end
	end

	if emitDuration > 0 then
		utility.gameWait(emitDuration)
		clone:Stop()
	else
		tween.timer(clone.TimeLength, function(deltaTime, elapsed)
			return if clone.PlaybackSpeed > 0 or (elapsed > 0 and speedTween and speedTween.Connected)
				then deltaTime * clone.PlaybackSpeed
				else nil
		end, speedTween, scope, nil, false)
	end

	return speedTween
end

function sound.init()
	if not utility.PLUGIN_CONTEXT then
		return
	end

	local plugin = script:FindFirstAncestorOfClass("Plugin")

	if not plugin then
		return
	end

	soundWidget = plugin:CreateDockWidgetPluginGui(
		"VFXForgeSoundPlayer",
		DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, true, 200, 100, 100, 50)
	)

	if soundWidget then
		soundWidget.Name = "VFXForgeSoundPlayer"
	end
end

function sound.deinit()
	if soundWidget then
		soundWidget:Destroy()
		soundWidget = nil
	end
end

function sound.emit(ref: Sound, scope: types.scope)
	if ref.Playing then
		ref:Stop()
	end

	local isSource = attr.get(ref, "SoundPoolIsSource", false)
	local inheritPoolAttributes = attr.get(ref, "SoundPoolInheritAttributes", false)

	if inheritPoolAttributes then
		ref = not isSource and selectRandomSound(ref) or ref
	end

	local emitDelay = attr.get(ref, "EmitDelay", 0)
	local emitDuration = attr.get(ref, "EmitDuration", 0)

	local emitCount = attr.get(ref, "EmitCount", 1)
	local emitInterval = attr.getRange(ref, "EmitInterval", NumberRange.new(0, 0))

	local repeatCount = attr.get(ref, "RepeatCount", 1)
	local repeatInterval = attr.getRange(ref, "RepeatInterval", NumberRange.new(0, 0))

	if emitDelay > 0 then utility.gameWait(emitDelay) end

	local promises = {}

	for i = 1, emitCount do
		local sourceSound = inheritPoolAttributes and ref or (not isSource and selectRandomSound(ref) or ref)

		if not sourceSound then
			continue
		end

		local src = if inheritPoolAttributes and sourceSound ~= ref then sourceSound else ref

		for r = 1, repeatCount do
			table.insert(
				promises,
				Promise.new(function(resolve)
					local clone, partClone = createSoundClone(ref, sourceSound, scope)

					playSingleSound(ref, src, clone, partClone, scope, emitDuration)

					if partClone then
						partClone:Destroy()
					else
						clone:Destroy()
					end

					resolve()
				end)
			)

			if r < repeatCount and repeatInterval.Max > 0 then
				utility.gameWait(rng:NextNumber(repeatInterval.Min, repeatInterval.Max))
			end
		end

		if i < emitCount and emitInterval.Max > 0 then
			utility.gameWait(rng:NextNumber(emitInterval.Min, emitInterval.Max))
		end
	end

	Promise.all(promises):await()
end

return sound
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="483">
                <Properties>
                  <string name="Name">spin</string>
                  <string name="Source"><![CDATA[local attr = require("../mod/attributes")
local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")

local spin = {}

function spin.emit(ref: Model, scope: types.scope)
  if utility.isSpinModelStatic(ref) then
    return
  end

  local rotation = attr.get(ref, "SpinRotation", vector.zero) * utility.DEG_TO_RAD

  local scaleStart = attr.get(ref, "Scale_Start", 1)
  local scaleEnd = attr.get(ref, "Scale_End", 1)

  local emitDelay = attr.get(ref, "EmitDelay", 0)
  local resetDelay = attr.get(ref, "ResetDelay", 0)
  local resetOnFinish = attr.get(ref, "ResetOnFinish", true)

  local sync = attr.get(ref, "SyncPosition", false)
  local duration = attr.get(ref, "SpinDuration", 0.5)

  local speedDuration = attr.get(ref, "SpinSpeed_Duration", 0.1)

  local speedStart = attr.get(ref, "SpinSpeed_Start", 0)
  local speedEnd = attr.get(ref, "SpinSpeed_End", 1)

  local currentSpeed = speedStart

  if emitDelay > 0 then utility.gameWait(emitDelay) end

  local speedTween

  if speedStart ~= speedEnd then
    speedTween = tween.fromParams(
      attr.get(ref, "SpinSpeed_Curve", utility.default_bezier),
      speedDuration,
      function(alpha, deltaTime)
        currentSpeed = utility.lerp(speedStart, speedEnd, alpha)
        return deltaTime
      end
    )

    table.insert(scope, speedTween)
  end

  local originalPivot = ref:GetPivot()
  local originalScale = ref:GetScale()

  if scaleStart ~= scaleEnd then
    table.insert(
      scope,
      tween.fromParams(attr.get(ref, "Scale_Curve", utility.default_bezier), duration, function(alpha, deltaTime)
        ref:ScaleTo(utility.lerp(scaleStart, scaleEnd, alpha))
        return deltaTime
      end)
    )
  else
    ref:ScaleTo(scaleStart)
  end

  local parent = ref:FindFirstAncestorOfClass("Attachment") or ref:FindFirstAncestorWhichIsA("BasePart")

  if resetOnFinish then
    table.insert(scope, function()
      ref:PivotTo(parent and utility.getTransformedOriginExtents(parent) or originalPivot)
      ref:ScaleTo(originalScale)
    end)
  end

  rotation *= duration

  tween.timer(duration + resetDelay, function(deltaTime, elapsed)
    local alpha = math.clamp(elapsed / duration, 0, 1)

    local r = rotation * alpha
    local cf = (if parent and sync then utility.getTransformedOriginExtents(parent) else originalPivot)
      * CFrame.fromOrientation(r.x, r.y, r.z)

    ref:PivotTo(cf)

    return if currentSpeed > 0 or (elapsed > 0 and speedTween.Connected) then deltaTime * currentSpeed else nil
  end, speedTween, scope, utility.RENDER_PRIORITY + scope.depth)
end

return spin
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="484">
                <Properties>
                  <string name="Name">tweener</string>
                  <string name="Source"><![CDATA[local attr = require("../mod/attributes")
local lerp = require("../mod/lerp")
local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")

local rng = Random.new()

local tweener = {}

function tweener.emit(obj: RayValue, scope: types.scope, isAttribute: boolean)
  local target = utility.getTarget(obj)

  if not target then
    return
  end

  local name = obj.Name

  local emitDelay = attr.get(obj, "EmitDelay", 0)
  local resetOnFinish = attr.get(obj, "ResetOnFinish", true)

  local durationRange = attr.getRange(obj, "Duration", NumberRange.new(1, 1), NumberRange.new(0, math.huge))

  if emitDelay > 0 then
    utility.gameWait(emitDelay)
  end

  local endValue = attr.get(obj, "_END_VALUE", nil)
  local overrideStartValue = attr.get(obj, "_START_VALUE", nil)

  local startValue

  if isAttribute then
    startValue = attr.get(target, name, nil)
  else
    local ok, val = pcall(function()
      return target[name]
    end)

    if not ok then
      return
    end

    startValue = val
  end

  if overrideStartValue then
    startValue = overrideStartValue
  end

  local typeName = typeof(startValue)

  if typeName ~= typeof(endValue) then
    return
  end

  local duration = rng:NextNumber(durationRange.Min, durationRange.Max)

  local speedStart = attr.get(obj, "Speed_Start", 1)
  local speedEnd = attr.get(obj, "Speed_End", 1)

  local currentSpeed = speedStart

  local speedTween

  if speedStart ~= speedEnd then
    speedTween = tween.fromParams(
      attr.get(obj, "Speed_Curve", utility.default_bezier),
      attr.get(obj, "Speed_Duration", 0.1),
      function(alpha, deltaTime)
        currentSpeed = utility.lerp(speedStart, speedEnd, alpha)
        return deltaTime
      end
    )

    table.insert(scope, speedTween)
  end

  local lfunc = lerp[typeName] or lerp.Other

  local animator = if isAttribute
    then function(alpha, deltaTime)
      attr.set(target, name, lfunc(startValue, endValue, alpha))
      return deltaTime * currentSpeed
    end
    else function(alpha, deltaTime)
      target[name] = lfunc(startValue, endValue, alpha)
      return deltaTime * currentSpeed
    end

  table.insert(
    scope,
    tween.fromParams(
      attr.get(obj, "Easing_Curve", utility.linear_bezier),
      duration,
      animator,
      speedTween,
      nil,
      nil,
      utility.RENDER_PRIORITY + scope.depth
    )
  )

  if resetOnFinish then
    table.insert(scope, function()
      if isAttribute then
        attr.set(target, name, startValue)
      else
        target[name] = startValue
      end
    end)
  end

  tween.timer(duration, function(deltaTime, elapsed)
    return if currentSpeed > 0 or (elapsed > 0 and speedTween and speedTween.Connected)
      then deltaTime * currentSpeed
      else nil
  end, speedTween, scope)
end

return tweener
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="485">
              <Properties>
                <string name="Name">emitters</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Beam = require("./effects/beam")
local Spin = require("./effects/spin")
local Mesh = require("./effects/mesh")
local Sound = require("./effects/sound")
local Bezier = require("./effects/bezier")
local Screen = require("./effects/screen")
local Particle = require("./effects/particle")
local Lightning = require("./effects/lightning")
local CameraShake = require("./effects/camera_shake")
local Tweener = require("./effects/tweener")
local Randomizer = require("./effects/randomizer")
local ShockwaveRing = require("./effects/shockwave_ring")
local ShockwaveLine = require("./effects/shockwave_line")
local ShockwaveDebris = require("./effects/shockwave_debris")

local Promise = require(ReplicatedStorage.Packages.Promise)

local attr = require("./mod/attributes")
local types = require("./types")
local utility = require("./mod/utility")

local emitters = {}

local function processRandomizers(obj: Instance, scope: types.scope)
	local r_prop = obj:QueryDescendants(`> RayValue.{utility.PROPERTY_RANDOMIZER_TAG}`)
	local r_attr = obj:QueryDescendants(`> RayValue.{utility.ATTRIBUTE_RANDOMIZER_TAG}`)

	-- allow emitting the randomizer directly
	if obj:IsA("RayValue") then
		if obj:HasTag(utility.PROPERTY_RANDOMIZER_TAG) then
			table.insert(r_prop, obj)
		elseif obj:HasTag(utility.ATTRIBUTE_RANDOMIZER_TAG) then
			table.insert(r_attr, obj)
		end
	end

	for _, obj in r_prop do
		utility.try(`failed to emit property randomizer with error: %s`, Randomizer.emit, obj, scope, false)
	end

	for _, obj in r_attr do
		utility.try(`failed to emit attribute randomizer with error: %s`, Randomizer.emit, obj, scope, true)
	end
end

function emitters.particle(
	obj: ParticleEmitter,
	scope: types.scope,
	sharedUncMap: { [Instance]: number },
	sharedRefMap: { [Instance]: Instance },
	legacyScale: number
)
	-- EmitModule compatibility: an unannotated emitter emits one particle.
	-- An explicit zero still disables the burst (EmitDuration may run alone).
	local count = attr.get(obj, "EmitCount", 1)
	local duration = attr.get(obj, "EmitDuration", 0, true)

	if not count or (count <= 0 and duration <= 0) then
		return
	end

	if not obj:IsDescendantOf(workspace) then
		local parent, ancestor = utility.cloneParticleAncestry(obj, sharedRefMap)

		if not parent then
			return
		end

		local clone = obj:Clone()
		clone.Archivable = false
		clone.Parent = parent

		if not sharedUncMap[ancestor] then
			ancestor.Parent = workspace.Terrain
			sharedUncMap[ancestor] = 1
		else
			sharedUncMap[ancestor] += 1
		end

		table.insert(scope, function()
			sharedUncMap[ancestor] -= 1

			if sharedUncMap[ancestor] <= 0 then
				ancestor:Destroy()
			end
		end)

		utility.try(`failed to emit particle with error: %s`, Particle.emit, obj, clone, scope, legacyScale)
	else
		utility.try(`failed to emit particle with error: %s`, Particle.emit, obj, obj, scope, legacyScale)
	end
end

function emitters.beam(obj: Beam, scope: types.scope, legacyScale: number)
	local att0, att1 = obj.Attachment0, obj.Attachment1

	if not att0 or not att1 then
		return
	end

	local clone = obj:Clone()
	clone.Archivable = false
	clone.Parent = workspace.Terrain

	-- clone attachments for beams with scaled length
	local unscaled = NumberRange.new(1, 1)

	if
		attr.get(obj, "Length_Scale_Start", unscaled, true) ~= unscaled
		or attr.get(obj, "Length_Scale_End", unscaled, true) ~= unscaled
	then
		local a, b = att0:Clone(), att1:Clone()

		table.insert(scope, a)
		table.insert(scope, b)

		a.Name = "_ForgeTempAttachment"
		b.Name = "_ForgeTempAttachment"

		a:AddTag(utility.EMIT_EXCLUDE_TAG)
		b:AddTag(utility.EMIT_EXCLUDE_TAG)

		clone.Attachment0 = a
		clone.Attachment1 = b

		a.Parent = att0.Parent
		b.Parent = att1.Parent
	end

	table.insert(scope, clone)

	utility.try(`failed to emit beam with error: %s`, Beam.emit, obj, clone, scope, legacyScale)
end

function emitters.trail(obj: Trail)
	obj.Enabled = true
end

function emitters.bezier(obj: Instance, scope: types.scope, skipEnabledCheck: boolean?)
	local part = obj:FindFirstChildOfClass("Part")

	if not part then
		return
	end

	if not skipEnabledCheck and obj:GetAttribute("Enabled") then
		obj:SetAttribute("Enabled", false)
	end

	local clone = part:Clone()
	clone.Locked = true

	table.insert(scope, clone)

	utility.try(`failed to emit bezier with error: %s`, Bezier.emit, obj, clone, scope, skipEnabledCheck)
end

function emitters.lightning(obj: Instance, scope: types.scope, skipEnabledCheck: boolean?)
	local part = obj:FindFirstChildOfClass("Part")

	if not part then
		return
	end

	if not skipEnabledCheck and obj:GetAttribute("Enabled") then
		obj:SetAttribute("Enabled", false)
	end

	local clone = part:Clone()
	clone.Locked = true

	table.insert(scope, clone)

	utility.try(`failed to emit lightning with error: %s`, Lightning.emit, obj, clone, scope, skipEnabledCheck)
end

function emitters.mesh(
	obj: Instance,
	scope: types.scope,
	shared_part_cache: any,
	legacyScale: number,
	skipEnabledCheck: boolean?
)
	local start = obj:FindFirstChild("Start")

	if not start then
		return
	end

	if not skipEnabledCheck and obj:GetAttribute("Enabled") then
		obj:SetAttribute("Enabled", false)
	end

	local tasks = {}
	local context = (scope :: any)._context

	local useEmitDuration = obj:HasTag(utility.ENABLED_VFX_TAG) and attr.get(obj, "EmitDuration", 0) > 0
	local emitCount = if useEmitDuration and not skipEnabledCheck then 1 else attr.get(obj, "EmitCount", 1)

	for i = 1, emitCount do
		local promise = Promise.new(function(resolve)
			utility.try(
				`failed to emit mesh with error: %s`,
				Mesh.emit,
				obj,
				utility.assembleMeshVFX(start, scope, shared_part_cache),
				scope,
				legacyScale,
				skipEnabledCheck
			)

			resolve()
		end)

		table.insert(tasks, promise)

		if context then
			table.insert(context._promises, promise)
		end
	end

	Promise.all(tasks):await()
end

function emitters.spin(obj: Model, scope: types.scope)
	if utility.lock(obj) then
		return
	end

	utility.try(`failed to emit spinning model with error: %s`, Spin.emit, obj, scope)
	utility.unlock(obj)
end

function emitters.camera_shake(obj: RayValue, scope: types.scope)
	utility.try(`failed to emit camera shake with error: %s`, CameraShake.emit, obj, scope)
end

function emitters.property_tweener(obj: RayValue, scope: types.scope)
	if not obj.Parent or utility.lock(obj) then
		return
	end

	utility.try(`failed to emit property tweener with error: %s`, Tweener.emit, obj, scope, false)
	utility.unlock(obj)
end

function emitters.attribute_tweener(obj: RayValue, scope: types.scope)
	if not obj.Parent or utility.lock(obj) then
		return
	end

	utility.try(`failed to emit attribute tweener with error: %s`, Tweener.emit, obj, scope, true)
	utility.unlock(obj)
end

function emitters.screen(obj: BasePart, scope: types.scope)
	local ok, result = utility.try(`failed to emit screen effect with error: %s`, Screen.emit, obj, scope)

	return if ok then result else false
end

function emitters.shockwave_ring(att: Attachment, obj: Part, scope: types.scope)
	utility.try(`failed to emit shockwave ring with error: %s`, ShockwaveRing.emit, att, obj, scope)
end

function emitters.shockwave_debris(att: Attachment, obj: Part, scope: types.scope)
	utility.try(`failed to emit shockwave debris with error: %s`, ShockwaveDebris.emit, att, obj, scope)
end

function emitters.shockwave_line(att: Attachment, obj: Part, scope: types.scope)
	utility.try(`failed to emit shockwave line with error: %s`, ShockwaveLine.emit, att, obj, scope)
end

function emitters.sound(obj: Sound, scope: types.scope)
	local emitCount = attr.get(obj, "EmitCount", 1, true)

	if emitCount <= 0 then
		return
	end

	utility.try(`failed to emit sound with error: %s`, Sound.emit, obj, scope)
end

-- Dispatch function to determine which emitter to use and call it
function emitters.dispatch(
	obj: any, -- since we don't use IsA(...), we don't get type narrowing
	scope: types.scope,
	sharedUncMap: { [Instance]: number },
	sharedRefMap: { [Instance]: Instance },
	shared_part_cache: any,
	legacyScale: number
)
	local className = obj.ClassName

	processRandomizers(obj, scope)

	if className == "ParticleEmitter" then
		emitters.particle(obj, scope, sharedUncMap, sharedRefMap, legacyScale)
		return
	elseif className == "Beam" then
		emitters.beam(obj, scope, legacyScale)
		return
	elseif className == "Trail" then
		emitters.trail(obj)
		return
	elseif className == "Sound" then
		emitters.sound(obj, scope)
		return
	elseif className == "RayValue" then
		if obj:HasTag(utility.SCREENSHAKE_TAG) then
			emitters.camera_shake(obj, scope)
		elseif obj:HasTag(utility.ATTRIBUTE_TWEENER_TAG) then
			emitters.attribute_tweener(obj, scope)
		elseif obj:HasTag(utility.PROPERTY_RANDOMIZER_TAG) or obj:HasTag(utility.ATTRIBUTE_RANDOMIZER_TAG) then
		-- skip randomizer effects because they have already been emitted
		else
			-- fall back to property tweens for backwards compatibility
			emitters.property_tweener(obj, scope)
		end

		return
	end

	if obj:HasTag(utility.BEZIER_TAG) then
		emitters.bezier(obj, scope)
		return
	end

	if obj:HasTag(utility.LIGHTNING_TAG) then
		emitters.lightning(obj, scope)
		return
	end

	if className == "Model" then
		if utility.isMeshVFX(obj) then
			emitters.mesh(obj, scope, shared_part_cache, legacyScale)
		else
			emitters.spin(obj, scope)
		end

		return
	end

	if className == "Part" then
		local att = utility.findFirstClassWithTag(obj, "Attachment", utility.SHOCKWAVE_TAG)

		if att then
			local name = obj.Parent and obj.Parent.Name or ""

			if name == "Rings" then
				emitters.shockwave_ring(att, obj, scope)
			elseif name == "Debris" then
				emitters.shockwave_debris(att, obj, scope)
			elseif name == "Lines" then
				emitters.shockwave_line(att, obj, scope)
			end
		end
	end
end

-- Registry for enabled effects (effects that emit continuously)
type EnabledEffectConfig = {
	check: (obj: Instance) -> boolean,
	emit: (obj: Instance, scope: types.scope, shared_part_cache: any) -> (),
}

emitters.enabled_registry = {
	mesh = {
		check = function(obj: Instance)
			return utility.isMeshVFX(obj)
		end,
		emit = function(obj: Instance, scope: types.scope, shared_part_cache: any)
			emitters.mesh(obj, scope, shared_part_cache, 1, true)
		end,
	},

	bezier = {
		check = function(obj: Instance)
			return obj:HasTag(utility.BEZIER_TAG)
		end,
		emit = function(obj: Instance, scope: types.scope, shared_part_cache: any)
			emitters.bezier(obj, scope, true)
		end,
	},

	lightning = {
		check = function(obj: Instance)
			return obj:HasTag(utility.LIGHTNING_TAG)
		end,
		emit = function(obj: Instance, scope: types.scope, shared_part_cache: any)
			emitters.lightning(obj, scope, true)
		end,
	},
} :: { [string]: EnabledEffectConfig }

return emitters
]]></string>
              </Properties>
            </Item>
