			return nil :: any
		end
	),
	setFixedMenu: typeof(
		--[[
			Creates a menu that is always selected and has it's close button hidden.
			Pass an empty table &lt;code&gt;{}&lt;/code&gt; to remove the menu.
		]]
		function(self: Icon, icons: { Icon }): Icon
			return nil :: any
