        <Item class="Folder" referent="304">
          <Properties>
            <string name="Name">thom463s_particle-emitter-2d@0.0.6</string>
          </Properties>
          <Item class="ModuleScript" referent="305">
            <Properties>
              <string name="Name">particle-emitter-2d</string>
              <string name="Source"><![CDATA[const RunService = game:GetService("RunService")

const Particle = require("@self/Particle")
const Types = require("@self/Types")

const function evaluateEmissionDirection(enum: Enum.NormalId)
	const lookup = {
		[Enum.NormalId.Top] = "Top",
		[Enum.NormalId.Bottom] = "Bottom",
		[Enum.NormalId.Left] = "Left",
		[Enum.NormalId.Right] = "Right",
		[Enum.NormalId.Front] = "Top", -- UI has no z coordinate; default to Top
		[Enum.NormalId.Back] = "Top"   -- UI has no z coordinate; default to Top
	}
	
	return lookup[enum]
end

const function evaluateAcceleration(acceleration: Vector3)
	return Vector2.new(acceleration.X, acceleration.Y)
end

const function evaluateSpreadAngle(spreadAngle: Vector2)
	return math.max(spreadAngle.X, spreadAngle.Y)
end

const ParticleEmitter = {}
ParticleEmitter.__index = ParticleEmitter

function ParticleEmitter.new(): Types.ParticleEmitter
	const self: Types.ParticleEmitter = {}
	setmetatable(self, ParticleEmitter)
	
	self.Color = Color3.new(1, 1, 1)
	self.Size = 32
	self.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	self.Transparency = 0
	self.ZOffset = 1
	
	self.EmissionDirection = "Top"
	self.Enabled = true
	self.Lifetime = NumberRange.new(5, 10)
	self.Rate = 20
	self.Rotation = 0
	self.RotSpeed = 0
	self.Speed = 25
	self.SpreadAngle = 0
	
	self.Shape = Enum.ParticleEmitterShape.Box
	self.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	self.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	
	self.Acceleration = Vector2.zero
	self.AspectRatio = 1
	self.TimeScale = 1
	self.Drag = 0
	
	self._connection = nil
	self._particles = {}
	self._elapsed = 0
	
	return self
end

function ParticleEmitter.fromParticle(particleEmitter: ParticleEmitter): Types.ParticleEmitter
	const self = ParticleEmitter.new()

	self.Color = particleEmitter.Color
	self.Size = particleEmitter.Size
	self.Texture = particleEmitter.Texture
	self.Transparency = particleEmitter.Transparency
	self.ZOffset = particleEmitter.ZOffset
	
	self.Enabled = particleEmitter.Enabled
	self.Lifetime = particleEmitter.Lifetime
	self.Rate = particleEmitter.Rate
	self.Rotation = particleEmitter.Rotation
	self.RotSpeed = particleEmitter.RotSpeed
	self.Speed = particleEmitter.Speed
	
	self.Shape = particleEmitter.Shape
	self.ShapeInOut = particleEmitter.ShapeInOut
	self.ShapeStyle = particleEmitter.ShapeStyle
	
	self.TimeScale = particleEmitter.TimeScale
	self.Drag = particleEmitter.Drag
	
	self.EmissionDirection = evaluateEmissionDirection(particleEmitter.EmissionDirection)
	self.Acceleration = evaluateAcceleration(particleEmitter.Acceleration)
	self.SpreadAngle = evaluateSpreadAngle(particleEmitter.SpreadAngle)
	
	return self
end

function ParticleEmitter.clone(particleEmitter: Types.ParticleEmitter): Types.ParticleEmitter
	const self = ParticleEmitter.new()
	
	for key, value in particleEmitter do
		if not string.find(key :: any, "^_") then
			self[key] = value
		end
	end
	
	return self
end

function ParticleEmitter.Bind(self: ParticleEmitter, loop: Types.Loops): ()
	if self._connection then
		warn("This ParticleEmitter is already connected to a loop")
		return
	end
	
	if loop == "RenderStepped" then
		self._connection = RunService.RenderStepped:Connect(function(dt)
			self:Update(dt)
		end)
	elseif loop == "Stepped" then
		self._connection = RunService.Stepped:Connect(function(_, dt)
			self:Update(dt)
		end)
	elseif loop == "Heartbeat" then
		self._connection = RunService.Heartbeat:Connect(function(dt)
			self:Update(dt)
		end)
	end
end

function ParticleEmitter.Unbind(self: ParticleEmitter): ()
	if not self._connection then
		return
	end
	
	self._connection:Disconnect()
	self._connection = nil
end

function ParticleEmitter.Update(self: ParticleEmitter, deltaTime: number): ()
	deltaTime *= self.TimeScale
	
	if self.Enabled and self.Parent then
		self._elapsed += deltaTime
		if self._elapsed >= (1 / self.Rate) then
			self._elapsed = 0
			self:Emit(1)
		end
	else
		self._elapsed = 0
	end
	
	const alive = {}

	for _, particle in self._particles do
		if particle._elapsed > particle.Lifetime then
			particle:Destroy()
			continue
		end
		
		table.insert(alive, particle)
		particle:Update(deltaTime)
	end
	
	self._particles = alive
end

function ParticleEmitter.Emit(self: ParticleEmitter, particleCount: number?): ()
	for _ = 1, (particleCount or 10) do
		const particle = Particle.new(self)
		table.insert(self._particles, particle)
	end
end

function ParticleEmitter.BindToRenderStepped(self: ParticleEmitter): ()
	self:Bind("RenderStepped")
end

function ParticleEmitter.BindToHeartbeat(self: ParticleEmitter): ()
	self:Bind("Heartbeat")
end

function ParticleEmitter.BindToStepped(self: ParticleEmitter): ()
	self:Bind("Stepped")
end

function ParticleEmitter.Destroy(self: ParticleEmitter): ()
	for _, particle in ipairs(self._particles) do
		particle:Destroy()
	end
	
	if self._connection then
		self._connection:Disconnect()
	end
	
	table.clear(self)
	setmetatable(self, nil)
end

return ParticleEmitter
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="306">
              <Properties>
                <string name="Name">Particle</string>
                <string name="Source"><![CDATA[const Types = require("./Types")
const RANDOM = Random.new()

const function resolveNumber(input: NumberSequence | NumberRange | number)
	if typeof(input) == "NumberSequence" then
		const keypoint = input.Keypoints[1]
		return keypoint.Value
		
	elseif typeof(input) == "NumberRange" then
		return RANDOM:NextNumber(input.Min, input.Max)
		
	elseif typeof(input) == "number" then
		return input
	end
	
	return 0
end

const function resolveColor(input: ColorSequence | Color3)
	if typeof(input) == "ColorSequence" then
		const keypoint = input.Keypoints[1]
		return keypoint.Value
		
	elseif typeof(input) == "Color3" then
		return input
	end
	
	return Color3.new()
end

const function evalColorSequence(sequence: ColorSequence, t: number)
	if t <= 0 then
		return sequence.Keypoints[1].Value
	elseif t >= 1 then
		return sequence.Keypoints[#sequence.Keypoints].Value
	end
	
	for i = 1, #sequence.Keypoints - 1 do
		const thisKeypoint = sequence.Keypoints[i]
		const nextKeypoint = sequence.Keypoints[i + 1]
		if t >= thisKeypoint.Time and t < nextKeypoint.Time then
			const alpha = (t - thisKeypoint.Time) / (nextKeypoint.Time - thisKeypoint.Time)
			return Color3.new(
				(nextKeypoint.Value.R - thisKeypoint.Value.R) * alpha + thisKeypoint.Value.R,
				(nextKeypoint.Value.G - thisKeypoint.Value.G) * alpha + thisKeypoint.Value.G,
				(nextKeypoint.Value.B - thisKeypoint.Value.B) * alpha + thisKeypoint.Value.B
			)
		end
	end
	
	return sequence.Keypoints[#sequence.Keypoints].Value
end

const function evalNumberSequence(sequence: NumberSequence, t: number)
	if t <= 0 then
		return sequence.Keypoints[1].Value
	elseif t >= 1 then
		return sequence.Keypoints[#sequence.Keypoints].Value
	end
	
	for i = 1, #sequence.Keypoints - 1 do
		const currKeypoint = sequence.Keypoints[i]
		const nextKeypoint = sequence.Keypoints[i + 1]
		if t >= currKeypoint.Time and t < nextKeypoint.Time then
			const alpha = (t - currKeypoint.Time) / (nextKeypoint.Time - currKeypoint.Time)
			return currKeypoint.Value + (nextKeypoint.Value - currKeypoint.Value) * alpha
		end
	end
	
	return sequence.Keypoints[#sequence.Keypoints].Value
end

const function mapNumberSequence(sequence: NumberSequence)
	const keypoints = {}
	for _, keypoint in ipairs(sequence.Keypoints) do
		if keypoint.Envelope > 0 then
			const offset = RANDOM:NextNumber(-keypoint.Envelope, keypoint.Envelope)
			const new = NumberSequenceKeypoint.new(keypoint.Time, keypoint.Value + offset)
			table.insert(keypoints, new)
			
			continue
		end
		
		table.insert(keypoints, keypoint)
	end
	
	return NumberSequence.new(keypoints)
end

const function evalDirection(direction: Types.EmissionDirection)
	return if direction == "Top" then -Vector2.yAxis
		elseif direction == "Bottom" then Vector2.yAxis
		elseif direction == "Left" then -Vector2.xAxis
		elseif direction == "Right" then Vector2.xAxis
		else Vector2.zero
end

const function setupParticle(self: Types.Particle)
	const particleEmitter = self._particleEmitter
	
	if typeof(self.Size) == "NumberSequence" then
		self.Size = mapNumberSequence(particleEmitter.Size)
	end
	
	if typeof(self.Transparency) == "NumberSequence" then
		self.Transparency = mapNumberSequence(particleEmitter.Transparency)
	end
	
	const root = particleEmitter.Parent
	const scale = resolveNumber(self.Size)
	const color = resolveColor(self.Color)
	const transparency = resolveNumber(self.Transparency)
	
	const position = UDim2.fromOffset(
		RANDOM:NextNumber(0, root.AbsoluteSize.X),
		RANDOM:NextNumber(0, root.AbsoluteSize.Y)
	)

	const label = Instance.new("ImageLabel")
	label.Name = "Particle"
	label.AnchorPoint = Vector2.one / 2
	label.BackgroundTransparency = 1
	label.Position = position
	label.Rotation = self.Rotation
	label.Size = UDim2.fromOffset(scale, scale)
	label.ZIndex = self.ZOffset
	label.Image = self.Texture
	label.ImageTransparency = transparency
	label.ImageColor3 = color
	label.Parent = particleEmitter.Parent

	const ratio = Instance.new("UIAspectRatioConstraint")
	ratio.Name = "Ratio"
	ratio.AspectRatio = self.AspectRatio
	ratio.Parent = label

	self._position = Vector2.new(position.X.Offset, position.Y.Offset)
	self._label = label
end

const function updatePosition(self: Types.Particle, dt: number): ()
	const base = evalDirection(self.EmissionDirection)
	const theta = math.rad(self.SpreadAngle)

	const direction = Vector2.new(
		base.X * math.cos(theta) - base.Y * math.sin(theta),
		base.X * math.sin(theta) + base.Y * math.cos(theta)
	)

	self._currentAcceleration += self.Acceleration * dt

	if self.Drag > 0 then
		const decay = 0.5 ^ (dt / (1 / self.Drag))
		self._currentSpeed *= decay
	end

	self._position += (direction * self._currentSpeed * dt) + (self._currentAcceleration * dt)
end

const function updateVisual(self: Types.Particle, dt: number): ()
	local alpha = math.min(1, self._elapsed / self.Lifetime)
	local transparency = self.Transparency
	local color = self.Color
	local size = self.Size
	
	if typeof(self.Color) == "ColorSequence" then
		color = evalColorSequence(self.Color, alpha)
	end

	if typeof(self.Size) == "NumberSequence" then
		size = evalNumberSequence(self.Size, alpha)
	end

	if typeof(self.Transparency) == "NumberSequence" then
		transparency = evalNumberSequence(self.Transparency, alpha)
	end

	self._label.Size = UDim2.fromOffset(size, size)
	self._label.Position = UDim2.fromOffset(self._position.X, self._position.Y)
	self._label.ImageTransparency = transparency
	self._label.ImageColor3 = color
	self._label.Rotation += self.RotSpeed * dt
end

const Particle = {}
Particle.__index = Particle

function Particle.new(particleEmitter: Types.ParticleEmitter): Types.Particle
	const self: Types.Particle = {}
	setmetatable(self, Particle)
	
	self.Color = particleEmitter.Color
	self.Size = particleEmitter.Size
	self.Texture = particleEmitter.Texture
	self.Transparency = particleEmitter.Transparency
	self.ZOffset = resolveNumber(particleEmitter.ZOffset)
	
	self.EmissionDirection = particleEmitter.EmissionDirection
	self.Lifetime = resolveNumber(particleEmitter.Lifetime)
	self.Rotation = resolveNumber(particleEmitter.Rotation)
	self.RotSpeed = resolveNumber(particleEmitter.RotSpeed)
	self.Speed = resolveNumber(particleEmitter.Speed)
	
	self.SpreadAngle = RANDOM:NextNumber(
		-particleEmitter.SpreadAngle,
		particleEmitter.SpreadAngle
	)
	
	self.Shape = particleEmitter.Shape
	self.ShapeInOut = particleEmitter.ShapeInOut
	self.ShapeStyle = particleEmitter.ShapeStyle
	
	self.Acceleration = particleEmitter.Acceleration
	self.AspectRatio = particleEmitter.AspectRatio
	self.TimeScale = particleEmitter.TimeScale
	self.Drag = particleEmitter.Drag
	
	self._currentAcceleration = Vector2.zero
	self._particleEmitter = particleEmitter
	self._currentSpeed = self.Speed
	self._position = nil
	self._elapsed = 0
	self._label = nil
	
	setupParticle(self)
	
	return self
end

function Particle.Update(self: Types.Particle, dt: number): ()
	dt *= self.TimeScale
	self._elapsed += dt
	
	updatePosition(self, dt)
	updateVisual(self, dt)
end

function Particle.Destroy(self: Types.Particle): ()
	self._label:Destroy()
	
	table.clear(self)
	setmetatable(self, nil)
end

return Particle
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="307">
              <Properties>
                <string name="Name">Types</string>
                <string name="Source"><![CDATA[export type ParticleEmitter = {
	Color: ColorSequence | Color3,
	Size: NumberSequence | number,
	Texture: string,
	Transparency: NumberSequence | number,
	ZOffset: NumberRange | number,

	Parent: GuiBase2d,

	EmissionDirection: EmissionDirection,
	Enabled: boolean,
	Lifetime: NumberRange | number,
	Rate: number,
	Rotation: NumberRange | number,
	RotSpeed: NumberRange | number,
	Speed: NumberRange | number,
	SpreadAngle: number,

	Shape: Enum.ParticleEmitterShape,
	ShapeInOut: Enum.ParticleEmitterShapeInOut,
	ShapeStyle: Enum.ParticleEmitterShapeStyle,

	Acceleration: Vector2,
	Drag: number,
	TimeScale: number,
	AspectRatio: number,
	
	_connection: RBXScriptConnection?,
	_particles: {Particle},
	_elapsed: number,
	
	Bind: (self: ParticleEmitter, loop: Loops) -> (),
	BindToRenderStepped: (self: ParticleEmitter) -> (),
	BindToHeartbeat: (self: ParticleEmitter) -> (),
	BindToStepped: (self: ParticleEmitter) -> (),
	Unbind: (self: ParticleEmitter) -> (),
	Update: (self: ParticleEmitter, deltaTime: number) -> (),
	Emit: (self: ParticleEmitter, particleCount: number?) -> (),
	Destroy: (self: ParticleEmitter) -> ()
}

export type Particle = {
	Color: ColorSequence | Color3,
	Size: NumberSequence | number,
	Texture: string,
	Transparency: NumberSequence | number,
	ZOffset: number,

	EmissionDirection: EmissionDirection,
	Lifetime: number,
	Rotation: number,
	RotSpeed: number,
	Speed: number,
	SpreadAngle: number,

	Shape: Enum.ParticleEmitterShape,
	ShapeInOut: Enum.ParticleEmitterShapeInOut,
	ShapeStyle: Enum.ParticleEmitterShapeStyle,

	Acceleration: Vector2,
	AspectRatio: number,
	TimeScale: number,
	Drag: number,
	
	_currentAcceleration: Vector2,
	_particleEmitter: ParticleEmitter,
	_currentSpeed: number,
	_position: Vector2,
	_elapsed: number,
	_label: ImageLabel,
	
	Update: (self: Particle, dt: number) -> (),
	Destroy: (self: Particle) -> ()
}

export type EmissionDirection = "Top" | "Bottom" | "Left" | "Right"
export type Loops = "RenderStepped" | "Stepped" | "Heartbeat"

return nil
]]></string>
              </Properties>
