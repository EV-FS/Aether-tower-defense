        <Item class="ModuleScript" referent="351">
          <Properties>
            <string name="Name">GameSettings</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

return TableUtils.DeepFreeze({
	--GameService
	LobbyPlaceId = 82472147389912,
	StartMoney = 1300,
	WaveReward = 100, --(WaveReward * wave + waveBonus)
	SkipBonus = 100, --웨이브 스킵 시에 웨이브 보상

	--BaseService
	BaseHealth = 150, --기지 체력

	--WaveService
	SkipTime = 20, --웨이브 스킵 가능 시간
	WaveDuration = 60, --웨이브 자동 시작 시간

	--EnemyService
	SpawnDelay = 0.4, --기본 스폰 딜레이
})
]]></string>
