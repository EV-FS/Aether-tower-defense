			Mythic = 0,
			Absolute = 0,
		},
		Quests = {},
		TutorialCompleted = false,
		_NextId = 1,
		_StructureVersion = "v2",
		_StarterTowerReceived = false,
	},

	PUBLIC_DATA_KEYS = {
		Coins = true,
		Gems = true,
