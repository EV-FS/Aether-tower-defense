          <Item class="ModuleScript" referent="615">
            <Properties>
              <string name="Name">WaveService</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local Promise = require(ReplicatedStorage.Packages.Promise)
local Signal = require(ReplicatedStorage.Packages.Signal)
local EnemyService
local TimeService

--/Config
local WaveData = require(ReplicatedStorage.Settings.Data.WaveData)
local MapData = require(ReplicatedStorage.Settings.Data.MapData)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local Net = require(ReplicatedStorage.Shared.Net)

--/Variables
local spawnEnded = false
local skipPromise

-------------------------------------------------
--// WaveService
-------------------------------------------------
local WaveService = {}
WaveService.CurrentWave = 0
WaveService.ActiveSpawns = {}
WaveService.AutoStartPromise = nil
WaveService.SelectedMap = nil
WaveService.SelectedDifficulty = "Normal"

WaveService.WaveCompleted = Signal.new()
WaveService.WaveStarted = Signal.new()
WaveService.CanSkip = Signal.new()
WaveService.AllWavesCompleted = Signal.new()

function WaveService.onEnemyDefeated()
	if TableUtils.Length(EnemyService.GetAll()) <= 0 and spawnEnded then
		if skipPromise then
			skipPromise:cancel()
		end

		WaveService.WaveCompleted:Fire(WaveService.CurrentWave)
		Net.GameEvent.WaveCompleted.FireAll(WaveService.CurrentWave)
	end
end

function WaveService:GetWaves(mapName: string?, difficultyName: string?): number
	local map = mapName or (WaveService and WaveService.SelectedMap)
	local mapData = MapData[map]
	if not mapData then
		warn(`선택 된 {map}에 데이터가 존재하지 않습니다.`)
		return 0
	end

	local targetDifficulty = difficultyName or (WaveService and WaveService.SelectedDifficulty) or "Normal"
	return (mapData.DifficultyWaves and mapData.DifficultyWaves[targetDifficulty]) or 0
end

function WaveService:PlayRound(chapter: string, difficulty: string)
	self.SelectedMap = chapter
	self.SelectedDifficulty = difficulty or "Normal"

	self:StartNextWave()
end

function WaveService:StartNextWave()
	local maxWaves = self:GetWaves()
	if self.CurrentWave + 1 > maxWaves then
		self.AllWavesCompleted:Fire()
		return
	end

	if skipPromise then
		skipPromise:cancel()
		skipPromise = nil
	end

	if self.AutoStartPromise then
		self.AutoStartPromise:cancel()
		self.AutoStartPromise = nil
	end

	self.CurrentWave += 1
	self.WaveStarted:Fire(self.CurrentWave)
	Net.GameEvent.WaveStarted.FireAll(self.CurrentWave)

	spawnEnded = false

	if self.CurrentWave < maxWaves then
		TimeService = TimeService or ServiceRegistry:GetService("TimeService")

		skipPromise = TimeService.DeltaDelay(GameSettings.SkipTime):andThen(function()
			self.CanSkip:Fire()
		end)
		self.AutoStartPromise = TimeService.DeltaDelay(GameSettings.WaveDuration):andThen(function()
			self:StartNextWave()
		end)
	end
	self:PlayWave(self.CurrentWave)
end

function WaveService:PlayWave()
	local chapterData = WaveData[self.SelectedMap]
	if not chapterData then
		return
	end

	local waveData = chapterData[self.CurrentWave]
	if not waveData then
		return
	end

	local spawnPromise
	spawnPromise = Promise.each(waveData, function(enemy)
		return EnemyService.Spawn(enemy.Name, enemy.Count, enemy.Delay, enemy.IsBoss, enemy.Path)
	end)

	spawnPromise:andThen(function()
		local index = table.find(WaveService.ActiveSpawns, spawnPromise)
		if index then
			table.remove(WaveService.ActiveSpawns, index)
		end

		if #WaveService.ActiveSpawns == 0 then
			spawnEnded = true
		end
		WaveService.onEnemyDefeated()
	end)

	table.insert(WaveService.ActiveSpawns, spawnPromise)
end

function WaveService:Stop()
	for _, promise in ipairs(self.ActiveSpawns) do
		promise:cancel()
	end
	table.clear(self.ActiveSpawns)

	if skipPromise then
		skipPromise:cancel()
		skipPromise = nil
	end
	if self.AutoStartPromise then
		self.AutoStartPromise:cancel()
		self.AutoStartPromise = nil
	end

	self.CurrentWave = 0
	spawnEnded = false
end

function WaveService.Init(services)
	EnemyService = services:GetService("EnemyService")
end

function WaveService.Start()
	EnemyService.EnemyDefeated:Connect(WaveService.onEnemyDefeated)
end

return WaveService
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="616">
          <Properties>
            <string name="Name">Entities</string>
          </Properties>
          <Item class="ModuleScript" referent="617">
            <Properties>
              <string name="Name">EnemyService</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

--/Modules
local Promise = require(ReplicatedStorage.Packages.Promise)
local BaseEnemy = require(ServerScriptService.Server.Classes.Enemy.BaseEnemy)
local Signal = require(ReplicatedStorage.Packages.Signal)
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local SpatialHashGrid = require(ReplicatedStorage.Shared.Modules.Core.SpatialHashGrid)
local Net = require(ReplicatedStorage.Shared.Net)
local EnemyRegistry = require(script.Registry)

local TimeService

--/Variables
local isActived = false
local connection
local enemyClasses = {}

-------------------------------------------------
--// EnemyService
-------------------------------------------------
local EnemyService = {}
EnemyService.EnemyReached = Signal.new()
EnemyService.EnemyDefeated = Signal.new()

EnemyService.EnemyGrid = SpatialHashGrid.new(10)

EnemyService.Get = EnemyRegistry.get
EnemyService.GetAll = EnemyRegistry.getAll

function EnemyService.SetupNewEnemy(name: string, isBoss: boolean?, pathAlpha: number?, pathId: number?)
	local self
	if enemyClasses[name] then
		self = enemyClasses[name].new(EnemyRegistry.generateId(), name, isBoss, pathId, pathAlpha)
	else
		self = BaseEnemy.new(EnemyRegistry.generateId(), name, isBoss, pathId, pathAlpha)
	end

	self.Destroyed:Connect(function(forcing: boolean?)
		self.IsDestroyed = true
		EnemyService.EnemyGrid:Remove(self)
		if forcing then
			Net.EnemyService.DestroyEnemy.FireAll(self.Id)
		end

		EnemyRegistry.remove(self.Id)
		EnemyService.EnemyDefeated:Fire(self)
	end)

	EnemyRegistry.add(self)

	EnemyService:StartMoveEnemies()

	self.SendTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536
	Net.EnemyService.ReplicatedEnemy.FireAll({
		enemyId = self.Id,
		enemyIndex = EnemyData.ByName[self.Name].Index,
		sendTimeMs = self.SendTimeMs,
		isBoss = self.IsBoss,
		-- Omit the optional f32 for the usual start-at-zero spawn (saves 4 bytes).
		startPathAlpha = if self.PathAlpha == 0 then nil else self.PathAlpha,
		pathId = self.PathId,
	})
end

function EnemyService.Spawn(
	name: string,
	spawnCount: number?,
	spawnDelay: number?,
	isBoss: boolean?,
	path: (string | number)?
)
	-- Resolve names once per group, before starting the asynchronous spawn loop.
	local pathIds = GetPath:GetSpawnPathIds(isBoss, path)
	return Promise.new(function(resolve, _, onCancel)
		local isCancelled = false

		onCancel(function()
			isCancelled = true
		end)

		task.spawn(function()
			local timeOffset = 0
			local count = spawnCount or 1
			local targetDelay = spawnDelay or GameSettings.SpawnDelay
			for _ = 1, count or 1 do
				if isCancelled then
					return
				end

				-- Explicit routes override defaults; unnamed spawns only use numbered paths.
				for _, pathId in ipairs(pathIds) do
					if isCancelled then
						return
					end
					EnemyService.SetupNewEnemy(name, isBoss, nil, pathId)
				end

				local waitTime = targetDelay - timeOffset
				if waitTime > 0 then
					timeOffset = TimeService.DeltaWait(waitTime)
				else
					timeOffset = -waitTime
				end

				if isCancelled then
					return
				end
			end

			resolve()
		end)
	end)
end

function EnemyService:StartMoveEnemies()
	if isActived then
		return
	end
	isActived = true

	connection = RunService.Heartbeat:Connect(function(dt)
		local toMoveEnemies = EnemyRegistry.getAll()

		if next(toMoveEnemies) == nil then
			isActived = false

			connection:Disconnect()
			connection = nil

			return
		end

		local gameSpeed = TimeService:GetGameSpeed()
		for _, enemy in pairs(toMoveEnemies) do
			local path = GetPath:Get(enemy.PathId)
			local pathLength = path:GetPathLength()
			enemy.PathAlpha += ((enemy.WalkSpeed * dt * gameSpeed) / pathLength) * enemy.MoveDirection
			enemy.PathAlpha = math.clamp(enemy.PathAlpha, 0, 1)

			enemy.Position = path:CalculateUniformPosition(enemy.PathAlpha)
			self.EnemyGrid:Update(enemy, enemy.Position)

			if enemy.PathAlpha >= 1 then
				self.EnemyGrid:Remove(enemy)
				self.EnemyReached:Fire(enemy)
				enemy:Destroy()
			end
		end
	end)
end

function EnemyService:DestroyAll()
	local list = {}
	for _, enemy in pairs(EnemyService.GetAll()) do
		table.insert(list, enemy)
	end
	for _, enemy in ipairs(list) do
		enemy:Destroy(true)
	end
end

function EnemyService.PlayerAdded(player: Player)
	for _, enemy in EnemyRegistry.getAll() do
		Net.EnemyService.ReplicatedEnemy.Fire(player, {
			enemyId = enemy.Id,
			enemyIndex = EnemyData.ByName[enemy.Name].Index,
			sendTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536,
			isBoss = enemy.IsBoss,
			startPathAlpha = if enemy.PathAlpha == 0 then nil else enemy.PathAlpha,
			pathId = enemy.PathId,
		})
	end
end

function EnemyService.Init(services)
	TimeService = services:GetService("TimeService")

	local ClassesFolder = ServerScriptService.Server.Classes.Enemy
	if ClassesFolder then
		for _, module in ClassesFolder:GetChildren() do
			if module:IsA("ModuleScript") and module.Name ~= "BaseEnemy" then
				enemyClasses[module.Name] = require(module)
			end
		end
	end
end

function EnemyService.Start() end

return EnemyService
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="618">
              <Properties>
                <string name="Name">Registry</string>
                <string name="Source"><![CDATA[-------------------------------------------------
--// EnemyRegistry
-------------------------------------------------
local EnemyRegistry = {}

local registry = {}
local currentEnemyId = 0

function EnemyRegistry.generateId(): number
	currentEnemyId += 1
	return currentEnemyId
end

function EnemyRegistry.add(enemy)
	if not enemy or not enemy.Id then
		return
	end
	registry[enemy.Id] = enemy
end

function EnemyRegistry.get(enemyId: number)
	return registry[enemyId]
end

function EnemyRegistry.getAll()
	return registry
end

function EnemyRegistry.remove(enemyId: number)
	registry[enemyId] = nil
end

return EnemyRegistry
]]></string>
