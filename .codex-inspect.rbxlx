        <Item class="ModuleScript" referent="357">
          <Properties>
            <string name="Name">SFXRecipes</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

export type Options = {
	Type: "2D" | "3D",

	Delay: number?,
	Volume: number?,
	At: string?,
}

export type Step = {
	Sound: string,
	Type: "2D" | "3D",

	Delay: number?,
	Volume: number?,
	At: string?,
}

local function newStep(sound: string, options: Options): Step
	return TableUtils.DeepFreeze({
		Sound = sound,
		Type = options.Type,

		Delay = options.Delay,
		Volume = options.Volume,
		At = options.At,
	})
end

return TableUtils.DeepFreeze({
	["Knight"] = {
