              <Item class="ModuleScript" referent="495">
                <Properties>
                  <string name="Name">logger</string>
                  <string name="Source"><![CDATA[local function msg(...: string)
  return `[Forge Emit API]: {table.concat({ ... }, " ")}`
end

local logger = {}

function logger.error(...)
  error(msg(..., "\n"))
end

function logger.warn(...)
  warn(msg(...))
  warn(msg(debug.traceback("stack trace:")))
end

function logger.info(...)
  print(msg(...))
end

return logger
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="496">
                <Properties>
                  <string name="Name">recolor</string>
                  <string name="Source"><![CDATA[local colorProps = {
  Single = {
    Color3 = {
      "Decal",
      "Texture",
    },

    Color = {
      "Part",
      "Union",
      "MeshPart",

      "SpotLight",
      "PointLight",
      "SurfaceLight",

      "SurfaceAppearance",
    },
  },

  Sequence = {
    Color = {
      "Beam",
      "Trail",
      "ParticleEmitter",
    },
  },
}

local function warp(x: number)
  return ((x % 1) + 1) % 1
end

local function multiplyHue(h0: number, h1: number)
  local rotation = (h1 - 0.5) * 1
  return warp(h0 + rotation)
end

local function multiplyChannel(c0: number, c1: number)
  local t = 2 * c1 - 1

  if t >= 0 then
    return math.clamp(c0 + (1 - c0) * t, 0, 1)
  else
    return math.clamp(c0 - c0 * math.abs(t), 0, 1)
  end
end

local function normalizeColor(color: Color3)
  local r, g, b = color.R, color.G, color.B
  local f = math.max(1, r, g, b)
  return f, Color3.new(r / f, g / f, b / f)
end

local function multiplyRGB(color: Color3, factor: number)
  return Color3.new(color.R * factor, color.G * factor, color.B * factor)
end

local function recolorObj(obj: Instance, color: Color3, mode: string, isDirect: boolean)
  if not isDirect and obj:IsA("BasePart") then
    return
  end

  local hue, sat, val = color:ToHSV()

  for _, info in colorProps do
    for k, v in info do
      if not table.find(v, obj.ClassName) then
        continue
      end

      local c = obj[k]

      if mode == "multiply" then
        if typeof(c) == "Color3" then
          local f, col = normalizeColor(c)
          local h0, s0, v0 = col:ToHSV()

          local h2 = multiplyHue(h0, hue)
          local s2 = multiplyChannel(s0, sat)
          local v2 = multiplyChannel(v0, val)

          obj[k] = multiplyRGB(Color3.fromHSV(h2, s2, v2), f)
        elseif typeof(c) == "ColorSequence" then
          local res = {}

          for _, kp in c.Keypoints do
            local f, col = normalizeColor(kp.Value)
            local h0, s0, v0 = col:ToHSV()

            local h2 = multiplyHue(h0, hue)
            local s2 = multiplyChannel(s0, sat)
            local v2 = multiplyChannel(v0, val)

            table.insert(res, ColorSequenceKeypoint.new(kp.Time, multiplyRGB(Color3.fromHSV(h2, s2, v2), f)))
          end

          obj[k] = ColorSequence.new(res)
        end
      else
        if typeof(c) == "Color3" then
          local f = normalizeColor(c)
          obj[k] = Color3.new(color.R * f, color.G * f, color.B * f)
        elseif typeof(c) == "ColorSequence" then
          obj[k] = ColorSequence.new(color)
        end
      end
    end
  end
end

local function recolor(color: Color3, mode: "replace" | "multiply", ...: Instance)
  for _, instance in { ... } do
    recolorObj(instance, color, mode, true)

    for _, desc in instance:GetDescendants() do
      recolorObj(desc, color, mode, false)
    end
  end
end

return recolor
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="497">
                <Properties>
                  <string name="Name">resize</string>
                  <string name="Source"><![CDATA[local utility = require("./utility")

local resize = {}

function resize.apply(obj: Instance, factor: number)
  if obj:IsA("ParticleEmitter") then
    obj.Size = utility.scaleNumberSequence(obj.Size, factor)
    obj.Speed = NumberRange.new(obj.Speed.Min * factor, obj.Speed.Max * factor)
    obj.Acceleration *= factor
  elseif obj:IsA("Beam") then
    utility.scaleAttribute(obj, factor, "Width0_Start")
    utility.scaleAttribute(obj, factor, "Width1_Start")
    utility.scaleAttribute(obj, factor, "Width0_End")
    utility.scaleAttribute(obj, factor, "Width1_End")

    utility.scaleAttribute(obj, factor, "CurveSize0_Start")
    utility.scaleAttribute(obj, factor, "CurveSize1_Start")
    utility.scaleAttribute(obj, factor, "CurveSize0_End")
    utility.scaleAttribute(obj, factor, "CurveSize1_End")

    utility.scaleAttribute(obj, factor, "Length_Scale_Start")
    utility.scaleAttribute(obj, factor, "Length_Scale_End")

    obj.Width0 *= factor
    obj.Width1 *= factor
    obj.CurveSize0 *= factor
    obj.CurveSize1 *= factor

    local a0, a1 = obj.Attachment0, obj.Attachment1
    utility.scaleAttachmentDistance(a0, a1, factor)
  elseif obj:IsA("Trail") then
    local a0, a1 = obj.Attachment0, obj.Attachment1
    utility.scaleAttachmentDistance(a0, a1, factor)
  elseif obj:IsA("Sound") then
    obj.RollOffMinDistance *= factor
    obj.RollOffMaxDistance *= factor

    utility.scaleAttribute(obj, factor, "RollOff_Start")
    utility.scaleAttribute(obj, factor, "RollOff_End")
  elseif obj:IsA("Model") then
    if utility.isMeshVFX(obj) then
      local start = obj:FindFirstChild("Start")
      local goal = obj:FindFirstChild("End")

      if start and goal then
        start.Size *= factor
        goal.Size *= factor

        local startMesh = start:FindFirstChildOfClass("SpecialMesh")
        local goalMesh = goal:FindFirstChildOfClass("SpecialMesh")

        if startMesh and goalMesh then
          startMesh.Scale *= factor
          goalMesh.Scale *= factor
        end
      end
    else
      utility.scaleAttribute(obj, factor, "Scale_Start")
      utility.scaleAttribute(obj, factor, "Scale_End")
    end
  elseif obj:IsA("Attachment") and obj:HasTag(utility.LIGHTNING_TAG) then
    utility.scaleAttribute(obj, factor, "OffsetScale")
    utility.scaleAttribute(obj, factor, "Width_Start")
    utility.scaleAttribute(obj, factor, "Width_End")
  elseif
    obj:IsA("BasePart")
    and obj.Parent
    and utility.findFirstClassWithTag(obj.Parent, "Attachment", utility.SHOCKWAVE_TAG)
  then
    utility.scaleAttribute(obj, factor, "Radius")
    utility.scaleAttribute(obj, factor, "Length")
    utility.scaleAttribute(obj, factor, "MinSize")
    utility.scaleAttribute(obj, factor, "MaxSize")

    if obj:GetAttribute("LinearMagnitude") then
      obj.Size *= factor
      utility.scaleAttribute(obj, factor, "LinearMagnitude")
      utility.scaleAttribute(obj, factor, "AngularMagnitude")
    end
  elseif obj:IsA("RayValue") and obj:HasTag(utility.SCREENSHAKE_TAG) then
    utility.scaleAttribute(obj, factor, "Falloff")
  end
end

function resize.batch(factor: number, ...: Instance)
  for _, instance in { ... } do
    resize.apply(instance, factor)

    for _, desc in instance:GetDescendants() do
      resize.apply(desc, factor)
    end
  end
end

return resize
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="498">
                <Properties>
                  <string name="Name">retime</string>
                  <string name="Source"><![CDATA[local utility = require("./utility")

local retime = {}

function retime.apply(obj: Instance, factor: number, invFactor: number)
  if obj:IsA("ParticleEmitter") then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "TimeScale_Duration")

    obj.Speed = NumberRange.new(obj.Speed.Min * factor, obj.Speed.Max * factor)
    obj.RotSpeed = NumberRange.new(obj.RotSpeed.Min * factor, obj.RotSpeed.Max * factor)
    obj.Lifetime = NumberRange.new(obj.Lifetime.Min / factor, obj.Lifetime.Max / factor)

    obj.Acceleration *= factor ^ 2
    obj.Drag *= factor
    obj.Rate *= factor
  elseif obj:IsA("Beam") then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "EffectDuration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")
    utility.scaleAttribute(obj, invFactor, "Duration")

    obj.TextureSpeed *= factor
  elseif obj:IsA("Trail") then
    obj.Lifetime *= invFactor
  elseif obj:IsA("Sound") then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "EmitInterval")
    utility.scaleAttribute(obj, invFactor, "RepeatInterval")
    utility.scaleAttribute(obj, invFactor, "FadeOutTime")

    utility.scaleAttribute(obj, invFactor, "Volume_Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")
    utility.scaleAttribute(obj, invFactor, "RollOff_Duration")
  elseif obj:IsA("Model") then
    if utility.isMeshVFX(obj) then
      utility.scaleAttribute(obj, invFactor, "EmitDelay")
      utility.scaleAttribute(obj, invFactor, "DestroyDelay")
      utility.scaleAttribute(obj, invFactor, "EmitDuration")
      utility.scaleAttribute(obj, invFactor, "EffectDuration")
      utility.scaleAttribute(obj, invFactor, "Speed_Duration")
      utility.scaleAttribute(obj, invFactor, "Duration")

      utility.scaleAttribute(obj, factor, "Rate")
      utility.scaleAttribute(obj, factor, "Part_RotSpeed_Start")
      utility.scaleAttribute(obj, factor, "Part_RotSpeed_End")
    else
      utility.scaleAttribute(obj, factor, "SpinRotation")

      utility.scaleAttribute(obj, invFactor, "EmitDelay")
      utility.scaleAttribute(obj, invFactor, "ResetDelay")

      utility.scaleAttribute(obj, invFactor, "SpinDuration")
      utility.scaleAttribute(obj, invFactor, "Scale_Duration")
      utility.scaleAttribute(obj, invFactor, "SpinSpeed_Duration")
    end
  elseif obj:IsA("Attachment") and obj:HasTag(utility.BEZIER_TAG) then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "DestroyDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")

    utility.scaleAttribute(obj, factor, "ProjectileSpeed")
    utility.scaleAttribute(obj, invFactor, "ProjectileLifetime")
    utility.scaleAttribute(obj, factor, "Rate")
    utility.scaleAttribute(obj, factor, "Part_RotSpeed_Start")
    utility.scaleAttribute(obj, factor, "Part_RotSpeed_End")
  elseif obj:IsA("Attachment") and obj:HasTag(utility.LIGHTNING_TAG) then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "DestroyDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")

    utility.scaleAttribute(obj, invFactor, "Color_Duration")
    utility.scaleAttribute(obj, invFactor, "Fill_Color_Duration")
    utility.scaleAttribute(obj, invFactor, "Fade_In_Duration")
    utility.scaleAttribute(obj, invFactor, "Fade_Out_Duration")
    utility.scaleAttribute(obj, invFactor, "Dissipate_Duration")

    utility.scaleAttribute(obj, factor, "ProjectileSpeed")
    utility.scaleAttribute(obj, invFactor, "ProjectileLifetime")
    utility.scaleAttribute(obj, factor, "Rate")
    utility.scaleAttribute(obj, factor, "RefreshRate")
  elseif
    obj:IsA("BasePart")
    and obj.Parent
    and utility.findFirstClassWithTag(obj.Parent, "Attachment", utility.SHOCKWAVE_TAG)
  then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "Size_Duration")
    utility.scaleAttribute(obj, invFactor, "Transparency_Duration")
    utility.scaleAttribute(obj, invFactor, "Lifetime")
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, factor, "Rate_Start")
    utility.scaleAttribute(obj, factor, "Rate_End")
  elseif obj:IsA("RayValue") and obj:HasTag(utility.SCREENSHAKE_TAG) then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "Scale_Duration")
  elseif obj:IsA("RayValue") then
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
  end
end

function retime.batch(factor: number, ...: Instance)
  local invFactor = 1 / factor

  for _, instance in { ... } do
    retime.apply(instance, factor, invFactor)

    for _, desc in instance:GetDescendants() do
      retime.apply(desc, factor, invFactor)
    end
  end
end

return retime
]]></string>
