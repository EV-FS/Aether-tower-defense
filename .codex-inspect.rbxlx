        <Item class="ModuleScript" referent="320">
          <Properties>
            <string name="Name">DataConstants</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

return TableUtils.DeepFreeze({
	KST_OFFSET = 9 * 3600,
	MAX_LOADOUT_SIZE = 5,
	MAX_TOWER_LEVEL = 30,
	STARTER_TOWER = "Fighter",

	PROFILE_TEMPLATE = {
		Coins = 200,
		Gems = 0,
		Blossom = 0,
		Wins = 0,
		Level = 1,
		Exp = 0,
		OwnedTowers = {},
		Inventory = {
			Crates = {},
			Items = {},
			Skins = {},
			Emotes = {},
		},
		GamePasses = {},
		DevProducts = {},
		Loadout = {},
		Settings = {},
