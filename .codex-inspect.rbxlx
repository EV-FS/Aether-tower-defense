          <Item class="ModuleScript" referent="545">
            <Properties>
              <string name="Name">SpeedUI</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)

local TimeService
local currentSpeed = 1

local SpeedUI = {}

function SpeedUI.ChangeSpeed(newSpeed: number): boolean
	TimeService = TimeService or ServiceRegistry:GetService("TimeService")
	return TimeService:SetGameSpeed(newSpeed)
end

function SpeedUI.GetSpeed(): number
	return currentSpeed
end

function SpeedUI.Init()
	TimeService = ServiceRegistry:GetService("TimeService")
end

function SpeedUI.Start()
	currentSpeed = TimeService:GetGameSpeed()
	ClientSignals.GameSpeedChanged:Connect(function(newSpeed: number)
		currentSpeed = newSpeed
	end)
end

return SpeedUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="546">
            <Properties>
              <string name="Name">TopbarUI</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local TopbarFactory = require(ReplicatedStorage.Shared.Modules.UI.TopbarFactory)
local Net = require(ReplicatedStorage.Shared.Net.client)
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local EmoteUI = require(script.Parent.EmoteUI)
local SettingsUI = require(script.Parent.Parent.Settings.SettingsUI)
local SpeedUI = require(script.Parent.SpeedUI)

local TopbarUI = {}
local topbar = TopbarFactory.new()
local speedOptionIcons = {}
local exitRequested = false

local function updateSpeedLabels(speed: number)
	for optionSpeed, icon in speedOptionIcons do
		local prefix = if optionSpeed == speed then ">  " else ""
		icon:setLabel(`{prefix}{optionSpeed}x`)
	end
end

local function speedOption(speed: number)
	local icon = topbar:CreateLabel(`${speed}x`, `Set speed to {speed}x`)
	topbar:BindOneClick(icon, function()
		task.spawn(function()
			local success, changed = pcall(SpeedUI.ChangeSpeed, speed)
			if success and changed then
				updateSpeedLabels(speed)
			elseif not success then
				warn(`[TopbarUI] Failed to change speed: {changed}`)
			end
		end)
	end)
	speedOptionIcons[speed] = icon
	return icon
end

function TopbarUI.Start()
	local emoteIcon = topbar:CreateImage("Emote", "Emotes", 1)
	topbar:BindToggle(emoteIcon, EmoteUI.Open, EmoteUI.Close)
	EmoteUI.BindTopbarIcon(emoteIcon)

	local exitIcon = topbar:CreateImage("Exit", "Return to Lobby", 1, false)
	topbar:BindOneClick(exitIcon, function()
		if exitRequested then return end
		exitRequested = true
		Net.GameEvent.TeleportToLobby.Fire()
		task.delay(3, function()
			exitRequested = false
		end)
	end)

	local speedIcon = topbar:CreateImage("Speed", "Game Speed", 2, false)
	-- Preserve the speed artwork instead of TopbarPlus replacing it with an X.
	speedIcon:setImage(string.gsub(TopbarFactory.Assets.Speed, "rbxassetid://", ""), "Selected")
	speedIcon:setDropdown({ speedOption(1), speedOption(1.5), speedOption(2) })

	local settingsIcon = topbar:CreateImage("Settings", "Settings", 3, false)
	topbar:BindToggle(settingsIcon, SettingsUI.Open, SettingsUI.Close)
	SettingsUI.BindTopbarIcon(settingsIcon)

	topbar:CreateGroup({ exitIcon, speedIcon, settingsIcon }, 2)
	updateSpeedLabels(SpeedUI.GetSpeed())
	topbar:TrackConnection(ClientSignals.GameSpeedChanged:Connect(updateSpeedLabels))
end

function TopbarUI.Destroy()
	EmoteUI.BindTopbarIcon(nil)
	SettingsUI.BindTopbarIcon(nil)
	topbar:Destroy()
	table.clear(speedOptionIcons)
	exitRequested = false
end

return TopbarUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="547">
            <Properties>
              <string name="Name">VoteUI</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local TweenService = game:GetService("TweenService")

--/Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local Vide = require(ReplicatedStorage.Packages.Vide)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local useButtonEffect = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useButtonEffect)
local Net = require(ReplicatedStorage.Shared.Net)
local SettingsClient

--/Vide Variables
local create = Vide.create
local source = Vide.source
local effect = Vide.effect
local action = Vide.action

local CurrentMode = source("Ready")
local IsReady = source(false)
local IsVisible = source(true)
local IsOpen = source(false)
local ReadyCount = source(0)
local TotalPlayers = source(#Players:GetPlayers())

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function setPlayerCount()
	task.defer(function()
		TotalPlayers(#Players:GetPlayers())
	end)
end

-------------------------------------------------
--// ReadyUI
-- -------------------------------------------------
local ReadyUI = {}

function ReadyUI.RenderUI()
	return create("Frame")({
		Name = "SkipFrame",
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromScale(0.5, 0.082),
		Size = UDim2.fromScale(0.182, 0.047),
		Visible = IsVisible,
		ZIndex = 10,

		create("Frame")({
			Name = "Canvas",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.fromRGB(16, 16, 16),
			BackgroundTransparency = 0.25,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.95, 0.75),

			action(function(element)
				effect(function()
					local target = if IsOpen() then UDim2.fromScale(0.5, 0.5) else UDim2.fromScale(0.5, 1.5)
					TweenService
						:Create(element, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
							Position = target,
						})
						:Play()
				end)
			end),

			create("UICorner")({
				Name = "UICorner",
				CornerRadius = UDim.new(0.2, 0),
			}),

			create("UIShadow")({
				Name = "UIShadow",
				BlurRadius = UDim.new(0.1, 0),
				Transparency = 0.5,
			}),

			create("TextButton")({
				Name = "SkipButton",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = Color3.fromRGB(0, 255, 0),
				FontFace = Font.new(
					"rbxasset://fonts/families/SourceSansPro.json",
					Enum.FontWeight.Bold,
					Enum.FontStyle.Normal
				),
				Position = UDim2.fromScale(0.843633, 0.491121),
				RichText = true,
				Size = UDim2.fromScale(0.256, 0.55),
				Text = "",
				TextColor3 = Color3.new(),
				TextScaled = true,

				useButtonEffect(),

				MouseButton1Click = function()
					if IsReady() then
						return
					end

					IsReady(true)
					if CurrentMode() == "Ready" then
						Net.GameEvent.Ready.Fire()
					else
						Net.GameEvent.VoteSkip.Fire()
					end
				end,

				create("UICorner")({
					Name = "UICorner",
					CornerRadius = UDim.new(0.1, 0),
				}),

				create("UIStroke")({
					Name = "UIStroke",
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Color = Color3.fromRGB(0, 94, 0),
					StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
					Thickness = 0.05,
				}),

				create("Frame")({
					Name = "Frame",
					BackgroundColor3 = Color3.fromRGB(0, 143, 0),
					BackgroundTransparency = 0.5,
					Position = UDim2.fromScale(0, 0.473923),
					Size = UDim2.fromScale(1, 0.526077),

					create("UICorner")({
						Name = "UICorner",
						CornerRadius = UDim.new(0.2, 0),
					}),
				}),

				create("TextLabel")({
					Name = "Title",
					BackgroundTransparency = 1,
					FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json"),
					Position = UDim2.fromScale(0.145287, 0.215392),
					Size = UDim2.fromScale(0.702747, 0.553866),
					Text = function()
						if CurrentMode() == "Ready" then
							return IsReady() and "Ready!" or "Ready?"
						else
							return IsReady() and "Skipped!" or "Skip?"
						end
					end,
					TextColor3 = Color3.new(1, 1, 1),
					TextScaled = true,

					create("UIStroke")({
						Name = "UIStroke",
						StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
						Thickness = 0.15,
					}),
				}),
			}),

			create("TextLabel")({
				Name = "Amount",
				AnchorPoint = Vector2.new(0, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json"),
				Position = UDim2.fromScale(0.45, 0.5),
				RichText = true,
				Size = UDim2.fromScale(0.23, 0.394),
				Text = function()
					return `{ReadyCount()}/{TotalPlayers()}`
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				TextXAlignment = Enum.TextXAlignment.Left,

				create("UIStroke")({
					Name = "UIStroke",
					StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
					Thickness = 0.08,
				}),
			}),

			create("TextLabel")({
				Name = "Text",
				AnchorPoint = Vector2.new(0, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json"),
				Position = UDim2.fromScale(0.048, 0.5),
				RichText = true,
				Size = UDim2.fromScale(0.4, 0.4),
				Text = function()
					if CurrentMode() == "Ready" then
						return "Vote Start"
					else
						return "Skip Wave?"
					end
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				TextXAlignment = Enum.TextXAlignment.Left,

				create("UIStroke")({
					Name = "UIStroke",
					StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
					Thickness = 0.08,
				}),

				create("UIGradient")({
					Name = "UIGradient",
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 246, 0)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 157, 0)),
					}),
					Rotation = 90,
				}),
			}),
		}),

		create("UIAspectRatioConstraint")({
			Name = "UIAspectRatioConstraint",
			AspectRatio = 4.38584,
			AspectType = Enum.AspectType.ScaleWithParentSize,
		}),
	})
end

function ReadyUI.Init()
	SettingsClient = ServiceRegistry:GetService("SettingsClient")
end

function ReadyUI.Start()
	ClientSignals.ReadyVoted:Connect(function(readyCount)
		if CurrentMode() == "Ready" then
			ReadyCount(readyCount)
		end
	end)

	ClientSignals.SkipVoted:Connect(function(voteCount)
		if CurrentMode() == "Skip" then
			ReadyCount(voteCount)
		end
	end)

	ClientSignals.Restarted:Connect(function()
		CurrentMode("Ready")
		IsReady(false)
		ReadyCount(0)
		setPlayerCount()

		IsOpen(true)
		IsVisible(true)
	end)

	ClientSignals.WaveStarted:Connect(function()
		IsOpen(false)
		local mode = CurrentMode()
		task.delay(0.35, function()
			if CurrentMode() == mode then
				IsVisible(false)
			end
		end)
	end)

	ClientSignals.CanSkip:Connect(function()
		CurrentMode("Skip")
		IsReady(false)
		ReadyCount(0)
		IsOpen(true)
		IsVisible(true)

		if SettingsClient:GetSettings().AutoSkip == true then
			task.delay(0.35, function()
				if CurrentMode() == "Skip" then
					IsReady(true)
					Net.GameEvent.VoteSkip.Fire()
				end
			end)
		end
	end)

	Players.PlayerAdded:Connect(setPlayerCount)
	Players.PlayerRemoving:Connect(setPlayerCount)

	task.defer(function()
		IsOpen(true)
		IsVisible(true)
	end)
end

return ReadyUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="548">
            <Properties>
              <string name="Name">WaveUI</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

--/Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local Vide = require(ReplicatedStorage.Packages.Vide)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)
local MapData = require(ReplicatedStorage.Settings.Data.MapData)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local TimeService

local source = Vide.source

local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local Interface = PlayerGui:WaitForChild("Interface")
local InfoFrame = Interface:WaitForChild("Info")

--/UI Variables
local currentWave = source(0)
local maxWaves = source(0)
local timerSeconds = source(GameSettings.WaveDuration)
local timerVisible = source(true)

local countdownTask = nil

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getWaves(mapName: string?, difficultyName: string?): number
	local map = mapName or "Chapter 1"
	local mapData = MapData[map]
	if not mapData then
		return 0
	end
	local difficulty = difficultyName or "Normal"
	return (mapData.DifficultyWaves and mapData.DifficultyWaves[difficulty]) or 0
end

local function stopCountdown()
	if countdownTask then
		task.cancel(countdownTask)
		countdownTask = nil
	end
end

local function startCountdown()
	stopCountdown()

	timerVisible(currentWave() < maxWaves())
	timerSeconds(GameSettings.WaveDuration)

	if currentWave() >= maxWaves() then
		return
	end

	countdownTask = task.spawn(function()
		while true do
			TimeService.DeltaWait(1)

			timerSeconds(timerSeconds() - 1)
			if timerSeconds() <= 0 then
				break
			end
		end
	end)
end

-------------------------------------------------
--// WaveUI
-------------------------------------------------
local WaveUI = {}

function WaveUI.HydrateUI()
	local TimerLabel = InfoFrame:WaitForChild("Timer")
	local WaveLabel = InfoFrame:WaitForChild("Wave")

	Vide.apply(WaveLabel)({
		Text = function()
			return `Wave: {currentWave()}/{maxWaves()}`
		end,
	})

	Vide.apply(TimerLabel)({
		Text = function()
			return NumberUtils.FormatTime(timerSeconds())
		end,
		Visible = timerVisible,
	})
end

function WaveUI.Init()
	TimeService = ServiceRegistry:GetService("TimeService")

	Vide.mount(function()
		WaveUI.HydrateUI()
	end)

	task.spawn(function()
		local mapFolder = workspace:WaitForChild("Map")
		local function updateMaxWaves()
			local selectedMap = mapFolder:GetAttribute("SelectedMap") or "Chapter 1"
			local selectedDifficulty = mapFolder:GetAttribute("SelectedDifficulty") or "Normal"
			maxWaves(getWaves(selectedMap, selectedDifficulty))
		end

		updateMaxWaves()
		mapFolder:GetAttributeChangedSignal("SelectedMap"):Connect(updateMaxWaves)
		mapFolder:GetAttributeChangedSignal("SelectedDifficulty"):Connect(updateMaxWaves)
	end)
end

function WaveUI.Start()
	ClientSignals.GameOver:Connect(function()
		stopCountdown()
	end)

	ClientSignals.WaveStarted:Connect(function(waveNum: number)
		currentWave(waveNum)
		startCountdown()
	end)

	ClientSignals.Restarted:Connect(function()
		currentWave(0)
		stopCountdown()
		timerSeconds(GameSettings.WaveDuration)
		timerVisible(true)
	end)
end

return WaveUI
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="549">
          <Properties>
            <string name="Name">HUD</string>
          </Properties>
          <Item class="ModuleScript" referent="550">
            <Properties>
              <string name="Name">CashUI</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

--/Modules
local CashFrame = require(script.Components.CashFrame)
local Vide = require(ReplicatedStorage.Packages.Vide)
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local EconomyService

local source = Vide.source
local spring = Vide.spring

--/UI Variables
local playerCash = source(0)

-------------------------------------------------
--// CashUI
-------------------------------------------------
local CashUI = {}

function CashUI.RenderUI()
	local animatedCash = spring(playerCash, 0.1, 1)

	return CashFrame({ Cash = animatedCash })
end

function CashUI.Init()
	EconomyService = ServiceRegistry:GetService("EconomyService")
end

function CashUI.Start()
	playerCash(EconomyService.GetCash(Players.LocalPlayer))

	ClientSignals.CashChanged:Connect(function(val: number)
		playerCash(val)
	end)
end

return CashUI
]]></string>
            </Properties>
            <Item class="Folder" referent="551">
              <Properties>
                <string name="Name">Components</string>
              </Properties>
              <Item class="ModuleScript" referent="552">
                <Properties>
                  <string name="Name">CashFrame</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)

local create = Vide.create

export type CashFrameProps = {
	Cash: () -> number,
}

return function(props: CashFrameProps)
	return create("Frame")({
		Name = "CashFrame",
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Color3.new(),
		BorderColor3 = Color3.new(),
		BorderSizePixel = 0,
		Position = UDim2.new(0.5, 0, 0.915, -50),
		Size = UDim2.new(0.095, 60, 0.005, 50),

		create("TextLabel")({
			Name = "Money",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/GothamSSm.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.47, 0.5),
			Size = UDim2.fromScale(0.7, 0.7),
			Text = function()
				local roundedCash = math.round(props.Cash())
				return `${NumberUtils.FormatComma(roundedCash)}`
			end,
			TextColor3 = Color3.fromRGB(255, 217, 0),
			TextScaled = true,

			create("UIStroke")({
				Name = "UIStroke",
				StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
				Thickness = 0.1,
			}),

			create("UIGradient")({
				Name = "UIGradient",
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 162, 0)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 238, 0)),
				}),
				Rotation = -100,
			}),
		}),

		create("UIAspectRatioConstraint")({
			Name = "UIAspectRatioConstraint",
			AspectRatio = 6.23337,
		}),

		create("UIGradient")({
			Name = "UIGradient",
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.381),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
end
]]></string>
