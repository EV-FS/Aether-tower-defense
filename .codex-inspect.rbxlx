      <Item class="Folder" referent="570">
        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="571">
          <Properties>
            <string name="Name">TowerViewport</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ViewportModel = require(ReplicatedStorage.Shared.Modules.Utils.ViewportModel)

local cleanup = Vide.cleanup
local create = Vide.create
local effect = Vide.effect
local read = Vide.read
local source = Vide.source
local action = Vide.action

local DEFAULT_CAMERA_DIRECTION = Vector3.new(0, 0, -1)
local DEFAULT_FIELD_OF_VIEW = 35
local DEFAULT_FIT_PADDING = 1.1
local MINIMUM_BOUNDS_RADIUS = 0.01

type Reactive<T> = T | (() -> T)
type AnimationId = number | string

type ModelState = {
	Instance: Model,
	TowerName: string,
	FocusOffset: Vector3,
	BoundsRadius: number,
}

export type Props = {
	TowerName: Reactive<string?>,
	Name: string?,
	AnchorPoint: Reactive<Vector2>?,
	Position: Reactive<UDim2>?,
	Size: Reactive<UDim2>?,
	Visible: Reactive<boolean>?,
	ZIndex: Reactive<number>?,
	BackgroundColor3: Reactive<Color3>?,
	BackgroundTransparency: Reactive<number>?,
	ImageTransparency: Reactive<number>?,
	Ambient: Reactive<Color3>?,
	LightColor: Reactive<Color3>?,
	LightDirection: Reactive<Vector3>?,
	CameraDirection: Reactive<Vector3>?,
	FieldOfView: Reactive<number>?,
	FitPadding: Reactive<number>?,
	UseViewportModel: Reactive<boolean>?,
	UseCharacterBounds: Reactive<boolean>?,
	FocusYOffset: Reactive<number>?,
	ModelRotation: Reactive<number>?,
	AnimationName: Reactive<string?>?,
	AnimationLevel: Reactive<number?>?,
	AnimationId: Reactive<AnimationId?>?,
	AnimationLooped: Reactive<boolean>?,
	AnimationSpeed: Reactive<number>?,
	AnimationFadeTime: Reactive<number>?,
	OnModelChanged: ((Model?) -> ())?,
}

local function getTowerAsset(towerName: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local towers = assets and assets:FindFirstChild("Towers")
	local towerAsset = towers and towers:FindFirstChild(towerName)

	if not towerAsset or not towerAsset:IsA("Model") then
		warn(`[TowerViewport] Tower model "{towerName}" was not found in ReplicatedStorage.Assets.Towers.`)
		return nil
	end

	return towerAsset
end

local function findRootPart(model: Model): BasePart?
	if model.PrimaryPart then
		return model.PrimaryPart
	end

	local humanoidRootPart = model:FindFirstChild("HumanoidRootPart", true)
	if humanoidRootPart and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end

	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function prepareModel(model: Model, towerName: string): ModelState
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.CanCollide = false
			descendant.LocalTransparencyModifier = 0
		end
	end

	local rootPart = findRootPart(model)
	if rootPart then
		rootPart.Anchored = true
	end

	-- Every viewport owns its own WorldModel, so the model can use a stable local origin.
	model:PivotTo(CFrame.identity)

	local boundsCFrame, boundsSize = model:GetBoundingBox()
	return {
		Instance = model,
		TowerName = towerName,
		FocusOffset = boundsCFrame.Position + Vector3.new(0, boundsSize.Y * 0.05, 0),
		BoundsRadius = math.max(boundsSize.Magnitude * 0.5, MINIMUM_BOUNDS_RADIUS),
	}
end

local function getModelCFrame(rotation: number): CFrame
	return CFrame.Angles(0, math.rad(rotation), 0)
end

local function updateCamera(
	camera: Camera,
	modelState: ModelState,
	modelCFrame: CFrame,
	fieldOfView: number,
	cameraDirection: Vector3,
	fitPadding: number,
	focusYOffset: number
)
	local direction = if cameraDirection.Magnitude > 0 then cameraDirection.Unit else DEFAULT_CAMERA_DIRECTION
	local clampedFieldOfView = math.clamp(fieldOfView, 1, 120)
	local distance = modelState.BoundsRadius / math.sin(math.rad(clampedFieldOfView) * 0.5) * math.max(fitPadding, 0.5)
	local focus = modelCFrame:PointToWorldSpace(modelState.FocusOffset + Vector3.new(0, focusYOffset, 0))

	camera.FieldOfView = clampedFieldOfView
	camera.CFrame = CFrame.lookAt(focus + direction * distance, focus)
end

local function getAnimation(towerName: string, animationName: string, level: number?): Animation?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local animations = assets and assets:FindFirstChild("Animations")
	local towerAnimations = animations and animations:FindFirstChild(towerName)
	if not towerAnimations then
		return nil
	end

	if level then
		for currentLevel = level, 0, -1 do
			local animation = towerAnimations:FindFirstChild(`{animationName}_{currentLevel}`)
			if animation and animation:IsA("Animation") then
				return animation
			end
		end
	end

	local animation = towerAnimations:FindFirstChild(animationName)
	return if animation and animation:IsA("Animation") then animation else nil
end

local function createAnimation(
	towerName: string,
	animationId: AnimationId?,
	animationName: string?,
	animationLevel: number?
): Animation?
	if animationId ~= nil then
		local animation = Instance.new("Animation")
		local id = tostring(animationId)
		animation.AnimationId = if string.sub(id, 1, 13) == "rbxassetid://" then id else `rbxassetid://{id}`
		return animation
	end

	if not animationName or animationName == "" then
		return nil
	end

	local animation = getAnimation(towerName, animationName, animationLevel)
	if not animation then
		warn(`[TowerViewport] Animation "{animationName}" was not found for tower "{towerName}".`)
		return nil
	end

	return animation:Clone()
end

local function getAnimator(model: Model): Animator?
	local controller = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Humanoid")
	if not controller then
		return nil
	end

	local animator = controller:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end

	animator = Instance.new("Animator")
	animator.Parent = controller
	return animator
end

local function startAnimation(
	model: Model,
	animation: Animation,
	fadeTime: number,
	setActiveTrack: (AnimationTrack?) -> ()
): () -> ()
	local active = true
	local track: AnimationTrack?

	local thread = task.spawn(function()
		while active and not model:IsDescendantOf(game) do
			model.AncestryChanged:Wait()
		end
		if not active then
			return
		end

		local animator = getAnimator(model)
		if not animator then
			warn(`[TowerViewport] Tower "{model.Name}" has no AnimationController or Humanoid.`)
			return
		end

		local success, result = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if not success then
			warn(`[TowerViewport] Failed to load animation for tower "{model.Name}": {result}`)
			return
		end

		track = result
		track:Play(fadeTime)
		setActiveTrack(track)
	end)

	return function()
		active = false
		if coroutine.status(thread) ~= "dead" then
			task.cancel(thread)
		end

		setActiveTrack(nil)
		if track then
			track:Stop(0)
			track:Destroy()
		end
		animation:Destroy()
	end
end

--[[
	TowerViewport({
		TowerName = "Bacon",
		AnimationName = "Idle",
		ModelRotation = rotationSpring,
		Size = UDim2.fromScale(0.5, 0.5),
	})

	The model is cloned only when TowerName changes. Transform, camera, and playback
	properties can be static values or Vide getters without recreating the model.
]]
return function(props: Props)
	local camera = create("Camera")({ Name = "TowerCamera" })
	local worldModel = create("WorldModel")({ Name = "TowerWorld" })
	local modelState = source(nil :: ModelState?)
	local activeTrack = source(nil :: AnimationTrack?)
	local viewportFrame = source(nil :: ViewportFrame?)
	local viewportFitter = source(nil)
	local viewportFitterRevision = source(0)
	local fittedCamera: CFrame?
	local fittedCameraFitter = nil
	local fittedCameraRevision = -1
	local fittedFieldOfView: number?
	local fittedDirection: Vector3?

	-- Model ownership: clone once per tower and keep each viewport fully isolated.
	effect(function()
		local towerName = read(props.TowerName)
		modelState(nil)

		if not towerName or towerName == "" then
			return
		end

		local towerAsset = getTowerAsset(towerName)
		if not towerAsset then
			return
		end

		local model = towerAsset:Clone()
		local state = prepareModel(model, towerName)
		model.Parent = worldModel
		if props.OnModelChanged then
			props.OnModelChanged(model)
		end
		cleanup(function()
			if props.OnModelChanged then
				props.OnModelChanged(nil)
			end
			if modelState() == state then
				modelState(nil)
			end
			model:Destroy()
		end)
		modelState(state)
	end)

	-- ViewportModel caches the model bounds and derives a camera distance from the
	-- actual ViewportFrame dimensions. It is opt-in for views that need a tight fit.
	effect(function()
		local state = modelState()
		local frame = viewportFrame()
		viewportFitter(nil)
		if not read(props.UseViewportModel) or not state or not frame then
			return
		end
		local useCharacterBounds = read(props.UseCharacterBounds) == true
		-- Fit the final orientation immediately; do not show sphere bounds first
		-- and then reframe the animated pose half a second later.
		state.Instance:PivotTo(getModelCFrame(read(props.ModelRotation) or 0))
		local fitter = ViewportModel.new(frame, camera)
		fitter:SetModel(state.Instance, useCharacterBounds)
		viewportFitter(fitter)

		local sizeConnection = frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if frame.AbsoluteSize.X <= 0 or frame.AbsoluteSize.Y <= 0 or viewportFitter() ~= fitter then
				return
			end
			fitter:Calibrate()
			viewportFitterRevision(viewportFitterRevision() + 1)
		end)

		cleanup(function()
			sizeConnection:Disconnect()
			if viewportFitter() == fitter then
				viewportFitter(nil)
			end
		end)
	end)

	-- Spring updates only transform the existing clone and its camera.
	effect(function()
		local state = modelState()
		if not state then
			return
		end

		local modelCFrame = getModelCFrame(read(props.ModelRotation) or 0)
		state.Instance:PivotTo(modelCFrame)
		local fitter = viewportFitter()
		local fitPadding = math.max(read(props.FitPadding) or DEFAULT_FIT_PADDING, 0.5)
		if fitter then
			local fitterRevision = viewportFitterRevision()
			camera.FieldOfView = math.clamp(read(props.FieldOfView) or DEFAULT_FIELD_OF_VIEW, 1, 120)
			local direction = read(props.CameraDirection) or DEFAULT_CAMERA_DIRECTION
			direction = if direction.Magnitude > 0 then direction.Unit else DEFAULT_CAMERA_DIRECTION
			if fittedCameraFitter ~= fitter or fittedCameraRevision ~= fitterRevision
				or fittedFieldOfView ~= camera.FieldOfView or fittedDirection ~= direction then
				fitter:Calibrate()
				-- Use the model's part-level bounds instead of its bounding sphere. This
				-- avoids excessive empty space on tall or wide units.
				local orientation = CFrame.lookAt(Vector3.zero, -direction)
				fittedCamera = fitter:GetMinimumFitCFrame(orientation)
				fittedCameraFitter = fitter
				fittedCameraRevision = fitterRevision
				fittedFieldOfView = camera.FieldOfView
				fittedDirection = direction
			end

			local paddingDistance = fitter:GetFitDistance() * (fitPadding - 1)
			camera.CFrame = (fittedCamera :: CFrame) * CFrame.new(0, 0, paddingDistance)
			return
		end

		-- Cached bounds avoid an expensive GetBoundingBox call on every spring step.
		updateCamera(
			camera,
			state,
			modelCFrame,
			read(props.FieldOfView) or DEFAULT_FIELD_OF_VIEW,
			read(props.CameraDirection) or DEFAULT_CAMERA_DIRECTION,
			read(props.FitPadding) or DEFAULT_FIT_PADDING,
			read(props.FocusYOffset) or 0
		)
	end)

	-- Reload only when the model or selected animation changes.
	effect(function()
		local state = modelState()
		if not state then
			return
		end

		local animation = createAnimation(
			state.TowerName,
			read(props.AnimationId),
			read(props.AnimationName),
			read(props.AnimationLevel)
		)
		if not animation then
			return
		end

		cleanup(startAnimation(state.Instance, animation, read(props.AnimationFadeTime), activeTrack))
	end)

	-- Loop and speed updates are cheap and do not restart the animation.
	effect(function()
		local track = activeTrack()
		if not track then
			return
		end

		track.Looped = read(props.AnimationLooped) ~= false
		track:AdjustSpeed(read(props.AnimationSpeed) or 1)
	end)

	return create("ViewportFrame")({
		Name = props.Name or "TowerViewport",
		AnchorPoint = props.AnchorPoint,
		BackgroundColor3 = props.BackgroundColor3,
		BackgroundTransparency = props.BackgroundTransparency or 1,
		ImageTransparency = props.ImageTransparency or 0,
		BorderSizePixel = 0,
		Position = props.Position,
		Size = props.Size or UDim2.fromScale(1, 1),
		Visible = props.Visible,
		ZIndex = props.ZIndex,
		Ambient = props.Ambient or Color3.fromRGB(180, 180, 180),
		LightColor = props.LightColor or Color3.new(1, 1, 1),
		LightDirection = props.LightDirection or Vector3.new(-1, -1, -1),
		CurrentCamera = camera,
		action(function(instance)
			viewportFrame(instance)
		end),

		camera,
		worldModel,
	})
end
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="572">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="573">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="574">
        <Properties>
          <string name="Name">CharacterGuard</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SceneLifecycle = require(script.Parent.Services.Core.SceneLifecycle)
local Guard = {}
local autoLoads = Players.CharacterAutoLoads
Players.CharacterAutoLoads = false
local released = false
local held = {}
local connections = {}

local function hold(character)
	task.spawn(function()
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if released or not root or not character.Parent or held[character] then return end
		local shield = Instance.new("ForceField")
		shield.Visible = false
		shield.Parent = character
		held[character] = { Root = root, Anchored = root.Anchored, Shield = shield }
		root.Anchored = true
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function watch(player)
	table.insert(connections, player.CharacterAdded:Connect(hold))
	if player.Character then hold(player.Character) end
end
table.insert(connections, Players.PlayerAdded:Connect(watch))
for _, player in Players:GetPlayers() do watch(player) end

function Guard.Release(map)
	if released then return end
	-- Resolve a real standing surface before allowing character physics.
	local surface = nil
	local fallback = nil
	SceneLifecycle.Visit({ map }, function(instance)
		if instance:IsA("SpawnLocation") and instance.Enabled then
			surface = instance
		elseif instance:IsA("BasePart") and instance.Anchored and instance.CanCollide then
			if not fallback or instance.Size.X * instance.Size.Z > fallback.Size.X * fallback.Size.Z then
				fallback = instance
			end
		end
	end)
	surface = surface or fallback
	if not surface then
		SceneLifecycle.Visit({ workspace }, function(instance)
			if instance:IsA("SpawnLocation") and instance.Enabled then surface = instance end
		end)
	end
	assert(surface, "Map has no spawn or solid standing surface; characters remain protected")
	local destination = surface.CFrame * CFrame.new(0, surface.Size.Y / 2 + 5, 0)
	-- Keep new characters anchored until they have been placed on the loaded map.
	local players = Players:GetPlayers()
	local pending = #players
	local failures = {}
	for _, player in players do
		task.spawn(function()
			local ok, err = xpcall(function()
				if player.Parent ~= Players then return end
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if not humanoid or humanoid.Health <= 0 then
					player:LoadCharacterAsync()
					character = player.Character
				end
				if player.Parent ~= Players then return end
				assert(character, "Character failed to load")
				local root = assert(character:WaitForChild("HumanoidRootPart", 10), "Missing character root")
				-- CharacterAdded's asynchronous hold may still be pending.
				if not held[character] then
					local shield = Instance.new("ForceField")
					shield.Visible = false
					shield.Parent = character
					held[character] = { Root = root, Anchored = root.Anchored, Shield = shield }
				end
				root.Anchored = true
				character:PivotTo(destination)
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end, debug.traceback)
			if not ok and player.Parent == Players then table.insert(failures, player.Name .. ": " .. tostring(err)) end
			pending -= 1
		end)
	end
	while pending > 0 do RunService.Heartbeat:Wait() end
	assert(#failures == 0, "Character preparation failed; protection retained: " .. table.concat(failures, "; "))
	released = true
	for _, connection in connections do connection:Disconnect() end
	for character, saved in held do
		if character.Parent and saved.Root.Parent then saved.Root.Anchored = saved.Anchored end
		saved.Shield:Destroy()
	end
	table.clear(held)
	Players.CharacterAutoLoads = autoLoads
end

return Guard
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="575">
        <Properties>
          <string name="Name">Classes</string>
        </Properties>
        <Item class="Folder" referent="576">
          <Properties>
            <string name="Name">Enemy</string>
          </Properties>
          <Item class="ModuleScript" referent="577">
            <Properties>
              <string name="Name">BaseEnemy</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/Modules
local Debuffs = require(script.Debuffs)
local Signal = require(ReplicatedStorage.Packages.Signal)
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local Net = require(ReplicatedStorage.Shared.Net)

local TimeService
local EconomyService
local GameService

local DOT_TICK_INTERVAL = 0.5

--/Types
export type Enemy = {
	Id: number,
	Name: string,
	MoveDirection: number,
	PathAlpha: number,
	PathId: number,

	Position: Vector3,

	ActiveDebuffs: {},
	DotValues: {},

	IsDead: boolean,
	Destroyed: typeof(Signal.new()),

	BaseSpeed: number,
	WalkSpeed: number,
	MaxHealth: number,
	Health: number,
	IsBoss: boolean?,
}

local sortedDebuffs = {}
for name, data in pairs(Debuffs) do
	table.insert(sortedDebuffs, { Name = name, Priority = data.Priority or 0 })
end
table.sort(sortedDebuffs, function(a, b)
	return a.Priority < b.Priority
end)

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function GetHealthMultiplier(): number
	GameService = GameService or ServiceRegistry:GetService("GameService")

	local difficulty = GameService and GameService.SelectedDifficulty or "Normal"
	local playerCount = GameService and GameService.StartPlayerCount or 1

	local diffMultiplier = 1
	if difficulty == "Hard" then
		diffMultiplier = 2
	elseif difficulty == "Eternal" then
		diffMultiplier = 3
	end
	local playerMultiplier = 1 + ((playerCount - 1) * 0.5)

	return diffMultiplier * playerMultiplier
end

-------------------------------------------------
--// BaseEnemy
-------------------------------------------------
local BaseEnemy = {}
BaseEnemy.__index = BaseEnemy

function BaseEnemy.new(id, name, isBoss, pathId: number?, pathAlpha: number?): Enemy
	local self = setmetatable({}, BaseEnemy)

	self.Id = id
	self.Name = name
	self.MoveDirection = 1
	self.PathId = pathId or 1
	self.PathAlpha = pathAlpha or 0
	self.IsBoss = isBoss

	self.Position = GetPath:Get(self.PathId):CalculateUniformPosition(self.PathAlpha)

	self.ActiveDebuffs = {}
	self.DotValues = {}
	self._DebuffTime = 0

	self.IsDead = false
	self._connections = {}

	self.Destroyed = Signal.new()

	local targetData = EnemyData.ByName[self.Name]
	if targetData then
		self.BaseSpeed = targetData.WalkSpeed
		self.WalkSpeed = self.BaseSpeed
		self.MaxHealth = math.floor(targetData.MaxHealth * GetHealthMultiplier())
		self.Health = self.MaxHealth
	end

	return self
end

function BaseEnemy:ApplyDebuff(name: string, duration: number, power: number?, source: any?)
	if self.IsDead or self.IsDestroyed or not self.ActiveDebuffs then
		return
	end

	local debuffData = Debuffs[name]
	if not debuffData then
		return
	end
	if self.IsBoss and debuffData.IgnoreBoss then
		return
	end

	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	local currentTime = self._DebuffTime
	local currentEndTime = currentTime + duration
	local existing = self.ActiveDebuffs[name]

	if name == "Stun" then
		if self._StunImmune and currentTime < self._StunImmune then
			return
		else
			self._StunImmune = currentTime + duration * 1.5
		end
	end

	if existing then
		local existingPower = existing.Power or 0
		local newPower = power or 0
		if existing.EndTime >= currentEndTime and existingPower >= newPower then
			return
		end

		existing.EndTime = currentEndTime
		existing.Power = power
		existing.Source = source
	else
		self.ActiveDebuffs[name] = {
			EndTime = currentEndTime,
			NextTickAt = currentTime + DOT_TICK_INTERVAL,
			Power = power,
			Source = source,
		}
	end

	self:_RecalculateStats()
	self:_StartDebuffLoop()
end

function BaseEnemy:TakeKnockback(studs: number)
	if studs <= 0 or self.IsBoss then
		return
	end

	studs = math.floor(studs * 10) / 10

	local pathLength = GetPath:Get(self.PathId):GetPathLength()
	local knockbackAlpha = studs / pathLength

	local duration = 0.2
	local startTime = os.clock()
	local startAlpha = self.PathAlpha
	local targetAlpha = math.clamp(startAlpha - knockbackAlpha, 0, 1)

	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	task.spawn(function()
		while true do
			local elapsed = (os.clock() - startTime) * TimeService:GetGameSpeed()
			if elapsed >= duration then
				break
			end

			local t = elapsed / duration
			local easedT = t * (2 - t)
			self.PathAlpha = math.clamp(NumberUtils.Lerp(startAlpha, targetAlpha, easedT), 0, 1)
			task.wait()
		end
		self.PathAlpha = targetAlpha
	end)

	Net.EnemyService.TakeKnockback.FireAll({
		enemyId = self.Id,
		["studs"] = studs * 10,
	})
end

function BaseEnemy:TakeDamage(amount: number)
	if self.IsDead or self.Health <= 0 then
		return 0, false
	end

	local actualDamage = math.min(self.Health, amount)
	self.Health -= actualDamage

	Net.EnemyService.OnDamaged.FireAll({
		enemyId = self.Id,
		damaged = actualDamage,
	})

	if self.Health <= 0 and not self.IsDead then
		self.IsDead = true

		EconomyService = EconomyService or ServiceRegistry:GetService("EconomyService")
		EconomyService.AddKillCash(self.MaxHealth)
		self:Destroy()
	end

	return actualDamage, self.IsDead
end

function BaseEnemy:Destroy(forcing: boolean?)
	self:_StopDebuffLoop()

	for _, conn in ipairs(self._connections) do
		conn:Disconnect()
	end

	self._connections = {}
	self.ActiveDebuffs = nil

	self.Destroyed:Fire(forcing)
end

function BaseEnemy:_RecalculateStats()
	local oldSpeed = self.WalkSpeed
	local oldDirection = self.MoveDirection

	self.WalkSpeed = self.BaseSpeed
	self.MoveDirection = 1

	local newDotValues = {}

	for _, data in ipairs(sortedDebuffs) do
		local activeInfo = self.ActiveDebuffs[data.Name]
		if not activeInfo then
			continue
		end

		local logic = Debuffs[data.Name]
		if logic and logic.OnApplyStats then
			logic.OnApplyStats(self, activeInfo.Power, newDotValues)
		end
	end

	if oldSpeed ~= self.WalkSpeed then
		Net.EnemyService.UpdateSpeed.FireAll({
			enemyId = self.Id,
			WalkSpeed = self.WalkSpeed * 100,
			sendTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536,
		})
	end
	if oldDirection ~= self.MoveDirection then
		Net.EnemyService.UpdateDirection.FireAll({
			enemyId = self.Id,
			MoveDirection = (self.MoveDirection == 1),
			sendTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536,
		})
	end

	self.DotValues = newDotValues
end

function BaseEnemy:_StartDebuffLoop()
	if self._DebuffConnection then
		return
	end

	self._DebuffConnection = RunService.Heartbeat:Connect(function(dt)
		self._DebuffTime += dt * TimeService:GetGameSpeed()
		self:_UpdateDebuffs(self._DebuffTime)
	end)
end

function BaseEnemy:_StopDebuffLoop()
	if self._DebuffConnection then
		self._DebuffConnection:Disconnect()
		self._DebuffConnection = nil
	end
end

function BaseEnemy:_UpdateDebuffs(currentTime: number)
	if self.IsDead or not self.ActiveDebuffs then
		return
	end

	local requiresStatRecalculation = false

	for name, activeInfo in pairs(self.ActiveDebuffs) do
		local damage = self.DotValues[name]
		local finalTickTime = math.min(currentTime, activeInfo.EndTime)

		while damage and damage > 0 and activeInfo.NextTickAt <= finalTickTime do
			activeInfo.NextTickAt += DOT_TICK_INTERVAL

			local source = activeInfo.Source
			local _, isKilled = self:TakeDamage(damage)
			if isKilled then
				if source then
					source:GetEvent("Killed"):Fire(self)
				end
				return
			end
		end

		if currentTime >= activeInfo.EndTime then
			self.ActiveDebuffs[name] = nil
			requiresStatRecalculation = true
		end
	end

	if requiresStatRecalculation and self.ActiveDebuffs then
		self:_RecalculateStats()
	end

	if not self.ActiveDebuffs or not next(self.ActiveDebuffs) then
		self:_StopDebuffLoop()
		self._DebuffTime = 0
	end
end

return BaseEnemy
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="578">
              <Properties>
                <string name="Name">Debuffs</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

return TableUtils.DeepFreeze({
	["Burn"] = {
		Priority = 1,
		OnApplyStats = function(_, power, dotCollection)
			dotCollection.Burn = power
		end,
	},
	["Bleed"] = {
		Priority = 2,
		OnApplyStats = function(_, power, dotCollection)
			dotCollection.Bleed = power
		end,
	},
	["Slow"] = {
		Priority = 10,
		OnApplyStats = function(enemy, power)
			enemy.WalkSpeed = enemy.BaseSpeed * math.max(0, (100 - power) / 100)
		end,
	},

	["Stun"] = {
		Priority = 20,
		IgnoreBoss = true,
		OnApplyStats = function(enemy)
			enemy.WalkSpeed = 0
		end,
	},

	["Fear"] = {
		Priority = 30,
		IgnoreBoss = true,
		OnApplyStats = function(enemy)
			enemy.WalkSpeed = enemy.BaseSpeed
			enemy.MoveDirection = -1
		end,
	},
})
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="579">
            <Properties>
              <string name="Name">Necromancer Goblin</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local BaseEnemy = require(script.Parent.BaseEnemy)
local EnemyService
local TimeService

local NecromancerGoblin = setmetatable({}, BaseEnemy)
NecromancerGoblin.__index = NecromancerGoblin

function NecromancerGoblin.new(id: number, name: string, isBoss: boolean?, pathId: number?, pathAlpha: number?)
	local self = BaseEnemy.new(id, name, isBoss, pathId, pathAlpha)
	setmetatable(self, NecromancerGoblin)

	local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)

	self.Stats = EnemyData.ByName[name]
	self._LastSummonTime = os.clock()

	self.SummonCooldown = (self.Stats and self.Stats.SummonCooldown) or 5
	self.SummonCount = (self.Stats and self.Stats.SummonCount) or 3
	self.MinionName = (self.Stats and self.Stats.MinionName) or "Goblin"

	self._SummonConnection = RunService.Heartbeat:Connect(function()
		if self.IsDead or self.IsDestroyed then
			self:_StopSummoning()
			return
		end

		if os.clock() - self._LastSummonTime >= self.SummonCooldown then
			self._LastSummonTime = os.clock()
			self:Summon()
		end
	end)

	return self
end

function NecromancerGoblin:Summon()
	EnemyService = EnemyService or ServiceRegistry:GetService("EnemyService")
	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	task.spawn(function()
		for _ = 1, self.SummonCount do
			if self.IsDead or self.IsDestroyed then
				break
			end

			EnemyService.SetupNewEnemy(self.MinionName, false, self.PathAlpha, self.PathId)
			TimeService.DeltaWait(0.4)
		end
	end)
end

function NecromancerGoblin:_StopSummoning()
	if self._summonConnection then
		self._summonConnection:Disconnect()
		self._summonConnection = nil
	end
end

function NecromancerGoblin:Destroy(forcing: boolean?)
	self:_StopSummoning()
	BaseEnemy.Destroy(self, forcing)
end

return NecromancerGoblin
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="580">
          <Properties>
            <string name="Name">Tower</string>
          </Properties>
          <Item class="ModuleScript" referent="581">
            <Properties>
              <string name="Name">BaseTower</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Configs
local Signal = require(ReplicatedStorage.Packages.Signal)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local Net = require(ReplicatedStorage.Shared.Net)
local DataService

export type Tower = {
	Id: number,
	Name: string,
	TowerKey: string,
	Owner: Player,
	Level: number,
	MaxLevel: number,
	TargetMode: string,
	Position: Vector3,

	Destroyed: typeof(Signal.new()),

	Components: { [string]: any },
	Stats: { [string]: any },
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getSummonKey(i)
	return if i == 1 then "Summon" else "Summon_" .. i
end

-------------------------------------------------
--// BaseTower
-------------------------------------------------
local BaseTower = {}
BaseTower.__index = BaseTower

function BaseTower.new(
	player: Player,
	towerId: number,
	towerName: string,
	towerKey: string,
	position: Vector3
): Tower
	local self = setmetatable({}, BaseTower)

	self.Id = towerId
	self.Name = towerName
	self.TowerKey = towerKey
	self.Owner = player
	self.Level = 0
	self.MaxLevel = self:_CalculateMaxLevel()
	self.TargetMode = "First"
	self.Position = position

	self.Destroyed = Signal.new()

	self.Components = {}
	self.EventSignals = {}

	self:_ApplyNewStats()
	self:_AddTowerExp()

	return self
end

function BaseTower:Upgrade(player: Player): boolean
	if self.Owner ~= player or self.Level >= self.MaxLevel then
		return false
	end

	self.Level += 1
	self:_ApplyNewStats()
	self:GetEvent("LevelUp"):Fire(self.Level)

	return true
end

function BaseTower:Sell(player: Player): boolean
	if self.Owner ~= player then
		return false
	end

	self:Destroy()

	return true
end

function BaseTower:GetEvent(eventName: string)
	if not self.EventSignals[eventName] then
		self.EventSignals[eventName] = Signal.new()
	end
	return self.EventSignals[eventName]
end

function BaseTower:Destroy()
	if self.IsDestroyed then
		return
	end
	self.IsDestroyed = true

	for _, component in pairs(self.Components) do
		component:Destroy()
	end
	table.clear(self.Components)

	self.Destroyed:Fire()

	if self.EventSignals then
		for _, signal in pairs(self.EventSignals) do
			signal:Destroy()
		end
		table.clear(self.EventSignals)
	end
	if self.Destroyed then
		task.defer(self.Destroyed.Destroy, self.Destroyed)
	end

	Net.TowerService.TowerDestroyed.FireAll(self.Id)
end

function BaseTower:_AddTowerExp()
	if not self.Owner or not self.Owner:IsDescendantOf(Players) then
		return
	end

	DataService = DataService or ServiceRegistry:GetService("DataService")
	if self.TowerKey then
		self:GetEvent("Killed"):Connect(function(_)
			DataService:AdjustTower(self.Owner, self.Name, self.TowerKey, "Exp", 10)
		end)
	end
end

function BaseTower:_RecalculateStats()
	self.Stats = TableUtils.DeepCopy(TowerData.ByName[self.Name].Stats[self.Level])

	if self.Stats.Damage then
		self.Stats.Damage = math.floor(self.Stats.Damage)
	end
end

function BaseTower:_ApplyNewStats()
	self:_RecalculateStats()

	local needsAttack = self.Stats.AttackType and self.Stats.Damage
	local needsSecondaryAttack = self.Stats.Secondary and self.Stats.Secondary.AttackType
	local needsFarm = self.Stats.Income and self.Stats.IsFarm
	local needsBuff = self.Stats.DamageBuff or self.Stats.RangeBuff or self.Stats.CooldownBuff

	self:_SyncComponent("Attack", "AttackComponent", needsAttack, self.Stats)
	self:_SyncComponent("SecondaryAttack", "AttackComponent", needsSecondaryAttack, self.Stats.Secondary, 2)
	self:_SyncComponent("Farm", "FarmComponent", needsFarm)
	self:_SyncComponent("Buff", "BuffComponent", needsBuff)

	local passives = self.Stats.Passives or {}
	self:_SyncComponent("Passives", "PassiveComponent", TableUtils.Length(passives) > 0, passives)

	local summons = self.Stats.Summons or (self.Stats.SummonUnit and { self.Stats }) or {}

	local previousCount = self._activeSummonCount or 0
	self._activeSummonCount = #summons

	for i, config in ipairs(summons) do
		self:_SyncComponent(getSummonKey(i), "SummonComponent", config.SummonUnit ~= nil, config)
	end

	for i = #summons + 1, previousCount do
		self:_SyncComponent(getSummonKey(i), "SummonComponent", false)
	end
end

function BaseTower:_SyncComponent(key: string, componentName: string, shouldExist: boolean?, ...)
	local component = self.Components[key]

	if shouldExist then
		if not component then
			self:_AddComponent(key, componentName, ...)
			return
		end

		if component.SetStats and select("#", ...) > 0 then
			component:SetStats(...)
		end
		return
	end

	if component then
		component:Destroy()
		self.Components[key] = nil
	end
end

function BaseTower:_AddComponent(key: string, componentName: string, ...)
	if self.Components[key] then
		warn(`이미 '{key}' 컴포넌트가 존재함.`)
		return self.Components[key]
	end

	local targetComponent = script.Components:FindFirstChild(componentName)
	if not targetComponent then
		warn(`'{componentName}'는 존재하지 않는 컴포넌트임.`)
		return nil
	end

	local newComponent = require(targetComponent).new(self, ...)
	self.Components[key] = newComponent

	if type(newComponent.Start) == "function" then
		newComponent:Start()
	end

	return newComponent
end

function BaseTower:_CalculateMaxLevel(): number
	local maxLevel = 0
	local statsData = TowerData.ByName[self.Name].Stats

	for level in statsData do
		if level > maxLevel then
			maxLevel = level
		end
	end

	return maxLevel
end

return BaseTower
]]></string>
            </Properties>
            <Item class="Folder" referent="582">
              <Properties>
                <string name="Name">Components</string>
              </Properties>
              <Item class="ModuleScript" referent="583">
                <Properties>
                  <string name="Name">AttackComponent</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/Modules
local FindTarget = require(ReplicatedStorage.Shared.Modules.Core.FindTarget)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local Net = require(ReplicatedStorage.Shared.Net)

local TimeService

local function resolveHitStats(stats, hit)
	return {
		AttackType = hit.AttackType or stats.AttackType,
		Damage = math.max(0, math.floor(stats.Damage * (hit.DamageScale or 1))),

		Range = hit.Range or stats.Range,
		SplashRange = hit.SplashRange or stats.SplashRange,
		Angle = hit.Angle or stats.Angle,
		Width = hit.Width or stats.Width,
	}
end

-------------------------------------------------
--// AttackComponent
-------------------------------------------------
local AttackComponent = {}
AttackComponent.__index = AttackComponent

function AttackComponent.new(tower, stats, attackSlot)
	local self = setmetatable({}, AttackComponent)
	self.Tower = tower
	self.Stats = stats
	self.AttackSlot = attackSlot

	self.CooldownTimer = 0

	return self
end

function AttackComponent:SetStats(stats)
	self.Stats = stats
end

function AttackComponent:Start()
	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	self.HeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		self.CooldownTimer -= dt * TimeService:GetGameSpeed()

		if self.CooldownTimer > 0 then
			return
		end

		local attackCount = 0
		local maxAttacksPerFrame = 3

		while self.CooldownTimer <= 0 and attackCount < maxAttacksPerFrame do
			local didAttack = self:_Attack()

			if didAttack then
				self.CooldownTimer += self.Stats.Cooldown
				attackCount += 1
			else
				self.CooldownTimer = 0
				break
			end
		end
	end)
end

function AttackComponent:Destroy()
	if self.HeartbeatConnection then
		self.HeartbeatConnection:Disconnect()
		self.HeartbeatConnection = nil
	end
end

function AttackComponent:_ApplyDamage(target, hitStats, hitIndex, hitCount)
	if not target or target.IsDestroyed then
		return
	end

	local damageContext = {
		Amount = hitStats.Damage,
		Target = target,
		HitIndex = hitIndex,
		HitCount = hitCount,
		AttackSlot = self.AttackSlot,
	}

	self.Tower:GetEvent("BeforeDamage"):Fire(damageContext)

	local actualDamage, isKilled = target:TakeDamage(damageContext.Amount)
	if actualDamage and actualDamage > 0 then
		self.Tower:GetEvent("AfterDamaged"):Fire(target, actualDamage, damageContext)
	end

	if isKilled then
		self.Tower:GetEvent("Killed"):Fire(target)
	end
end

function AttackComponent:_DamageToEnemies(targetList, hitStats, hitIndex, hitCount)
	if not targetList then
		return
	end

	for _, enemy in targetList do
		self:_ApplyDamage(enemy, hitStats, hitIndex, hitCount)
	end
end

function AttackComponent:_ExecuteAttack(stats, hit, target, hitIndex, hitCount)
	if not self.Tower or self.Tower.IsDestroyed or not target then
		return
	end

	local hitStats = resolveHitStats(stats, hit)
	local attackType = hitStats.AttackType
	local targetPosition = target.Position
	local targetList

	if attackType == "Single" then
		targetList = { target }
	elseif attackType == "Splash" then
		targetList = FindTarget.GetTargetInSplash(hitStats, targetPosition)
	elseif attackType == "Angle" then
		targetList = FindTarget.GetTargetInAngle(self.Tower, hitStats, self.Tower.Position, targetPosition)
	elseif attackType == "Line" then
		targetList = FindTarget.GetTargetInLine(self.Tower, hitStats, targetPosition)
	else
		warn(`Unknown AttackType: {tostring(attackType)}`)
		return
	end

	self:_DamageToEnemies(targetList, hitStats, hitIndex, hitCount)
end

function AttackComponent:_Attack(): boolean
	local stats = table.clone(self.Stats)
	local target = FindTarget.GetTarget(self.Tower, stats.Range)
	if not target then
		return false
	end

	local hits = stats.Hits or {
		{
			Delay = stats.AttackDelay or 0,
			AttackType = stats.AttackType,
		},
	}

	Net.TowerService.OnAttackEnemy.FireAll({
		towerId = self.Tower.Id,
		enemyId = target.Id,
		attackSlot = self.AttackSlot,
	})

	for hitIndex, hit in hits do
		local currentHit = hit
		local currentHitIndex = hitIndex
		local hitDelay = currentHit.Delay or 0

		local function executeHit()
			self:_ExecuteAttack(stats, currentHit, target, currentHitIndex, #hits)
		end

		if hitDelay > 0 then
			TimeService.DeltaDelay(hitDelay):andThen(executeHit)
		else
			executeHit()
		end
	end

	return true
end

return AttackComponent
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="584">
                <Properties>
                  <string name="Name">BuffComponent</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

--/Modules
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local Registry = require(ServerScriptService.Server.Services.Entities.TowerService.Registry)
local TimeService

-------------------------------------------------
--// BuffComponent
-------------------------------------------------
local BuffComponent = {}
BuffComponent.__index = BuffComponent

function BuffComponent.new(tower)
	local self = setmetatable({}, BuffComponent)
	self.Tower = tower
	if not self.Tower.ActiveBuffs then
		self.Tower.ActiveBuffs = {}
	end

	self.LevelUpConnection = {}
	self.BuffedTowers = {}

	self.Tower:GetEvent("LevelUp"):Connect(function()
		for buffedTower, _ in pairs(self.BuffedTowers) do
			self:_ApplyBuff(buffedTower)
		end
		self:_UpdateBuff()
	end)

	return self
end

function BuffComponent:Start()
	local checkInterval = 0.2
	local timeLeft = 0

	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	self.HeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
		timeLeft -= dt * TimeService:GetGameSpeed()
		if timeLeft > 0 then
			return
		end
		timeLeft += checkInterval

		self:_UpdateBuff()
	end)
end

function BuffComponent:_UpdateBuff()
	local towersCurrentlyInRange = {}

	for _, tower in Registry.getAll() do
		if tower == self.Tower then
			continue
		end

		local offset = tower.Position - self.Tower.Position

		if offset.X ^ 2 + offset.Z ^ 2 <= self.Tower.Stats.Range ^ 2 then
			towersCurrentlyInRange[tower] = true

			if not self.BuffedTowers[tower] then
				self:_ApplyBuff(tower)
				self.BuffedTowers[tower] = true
			end
		end
	end

	for buffedTower, _ in pairs(self.BuffedTowers) do
		if not towersCurrentlyInRange[buffedTower] then
			self:_RemoveBuff(buffedTower)
			self.BuffedTowers[buffedTower] = nil
		end
	end
end

function BuffComponent:_ApplyBuff(targetTower)
	if self.LevelUpConnection[targetTower.Id] then
		self.LevelUpConnection[targetTower.Id]:Disconnect()
		self.LevelUpConnection[targetTower.Id] = nil
	end

	targetTower.ActiveBuffs[self.Tower] = {
		DamageBuff = self.Tower.Stats.DamageBuff or 0,
		RangeBuff = self.Tower.Stats.RangeBuff or 0,
		CooldownBuff = self.Tower.Stats.CooldownBuff or 0,
	}

	self.LevelUpConnection[targetTower.Id] = targetTower:GetEvent("LevelUp"):Connect(function()
		self:_ApplyBuff(targetTower)
	end)

	self:_SetTargetStats(targetTower)
end

function BuffComponent:_RemoveBuff(targetTower)
	if self.LevelUpConnection[targetTower.Id] then
		self.LevelUpConnection[targetTower.Id]:Disconnect()
		self.LevelUpConnection[targetTower.Id] = nil
	end

	targetTower.ActiveBuffs[self.Tower] = nil

	self:_SetTargetStats(targetTower)
end

function BuffComponent:_SetTargetStats(tower)
	local defaultStats = TowerData.ByName[tower.Name].Stats[tower.Level]

	local maxDamageBuff = 0
	local maxRangeBuff = 0
	local maxCooldownBuff = 0

	for _, buffData in pairs(tower.ActiveBuffs) do
		maxDamageBuff = math.max(maxDamageBuff, buffData.DamageBuff)
		maxRangeBuff = math.max(maxRangeBuff, buffData.RangeBuff)
		maxCooldownBuff = math.max(maxCooldownBuff, buffData.CooldownBuff)
	end

	tower.Stats.Damage = defaultStats.Damage * (1 + maxDamageBuff / 100)
	tower.Stats.Range = defaultStats.Range * (1 + maxRangeBuff / 100)
	tower.Stats.Cooldown = defaultStats.Cooldown * (1 - maxCooldownBuff / 100)
end

function BuffComponent:Destroy()
	if self.HeartbeatConnection then
		self.HeartbeatConnection:Disconnect()
		self.HeartbeatConnection = nil
	end

	for _, connection in pairs(self.LevelUpConnection) do
		connection:Disconnect()
	end
	table.clear(self.LevelUpConnection)

	for buffedTower, _ in pairs(self.BuffedTowers) do
		self:_RemoveBuff(buffedTower)
	end
	table.clear(self.BuffedTowers)
end

return BuffComponent
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="585">
                <Properties>
                  <string name="Name">FarmComponent</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
--/Modules
local EconomyService
local WaveService

-------------------------------------------------
--// FarmComponent
-------------------------------------------------
local FarmComponent = {}
FarmComponent.__index = FarmComponent

function FarmComponent.new(tower)
	local self = setmetatable({}, FarmComponent)
	self.Tower = tower

	return self
end

function FarmComponent:Start()
	EconomyService = EconomyService or ServiceRegistry:GetService("EconomyService")
	WaveService = WaveService or ServiceRegistry:GetService("WaveService")

	self.WaveConnection = WaveService.WaveStarted:Connect(function()
		EconomyService.AddCash(self.Tower.Owner, self.Tower.Stats.Income)
	end)
end

function FarmComponent:Destroy()
	if self.WaveConnection then
		self.WaveConnection:Disconnect()
		self.WaveConnection = nil
	end
end

return FarmComponent
]]></string>
