          <Item class="ModuleScript" referent="461">
            <Properties>
              <string name="Name">SliderModule</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Fusion = require(ReplicatedStorage.Packages.Fusion)

local peek = Fusion.peek
local OnEvent = Fusion.OnEvent

local function updateSliderPosition(inputPosition: Vector3, slider: Frame, handler: GuiButton, process: any?)
	local mouseX = inputPosition.X
	local frameLeft = slider.AbsolutePosition.X
	local frameWidth = slider.AbsoluteSize.X

	local percentage = math.clamp((mouseX - frameLeft) / frameWidth, 0, 1)

	handler.Position = UDim2.new(percentage, 0, handler.Position.Y.Scale, handler.Position.Y.Offset)

	if process then
		process:set(math.floor(percentage * 100))
	end
end

return function(scope, props: { Slider: Frame, Handler: GuiButton, Process: any?, OnRelease: ((value: number) -> ())? })
	local slider = props.Slider
	local handler = props.Handler
	local process = props.Process
	local onRelease = props.OnRelease

	local isDragging = scope:Value(false)

	local function stopDragging()
		if peek(isDragging) then
			isDragging:set(false)

			if onRelease and process then
				onRelease(peek(process))
			end
		end
	end

	table.insert(
		scope,
		slider.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				isDragging:set(true)
				updateSliderPosition(input.Position, slider, handler, process)
			end
		end)
	)

	scope:Hydrate(handler)({
		[OnEvent("InputBegan")] = function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				isDragging:set(true)
			end
		end,
		[OnEvent("MouseButton1Up")] = function()
			stopDragging()
		end,
	})

	table.insert(
		scope,
		UserInputService.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				stopDragging()
			end
		end)
	)

	table.insert(
		scope,
		UserInputService.InputChanged:Connect(function(input)
			if not peek(isDragging) then
				return
			end

			if
				input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			updateSliderPosition(input.Position, slider, handler, process)
		end)
	)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="462">
            <Properties>
              <string name="Name">TopbarFactory</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Topbarplus = require(ReplicatedStorage.Packages.Topbarplus)

local TopbarFactory = {}
local Factory = {}
Factory.__index = Factory

TopbarFactory.Assets = table.freeze({
	Emote = "rbxassetid://111864869864776",
	Exit = "rbxassetid://100029434862717",
	Speed = "rbxassetid://108383245414954",
	Settings = "rbxassetid://119479235757807",
})

local ICON_THEME = {
	{ "Widget", "DesiredWidth", 46 },
	{ "Widget", "MinimumWidth", 46 },
	{ "Widget", "MinimumHeight", 46 },
	{ "Widget", "BorderSize", 0 },
	{ "IconButton", "BackgroundColor3", Color3.fromRGB(20, 20, 23) },
	{ "IconButton", "BackgroundTransparency", 1 },
	{ "IconCorners", "CornerRadius", UDim.new(1, 0) },
	{ "IconImageScale", "Value", 0.5 },
	{ "IconSpot", "BackgroundColor3", Color3.fromRGB(18, 18, 21) },
	{ "IconSpot", "BackgroundTransparency", 0.08 },
	{ "IconSpot", "BackgroundTransparency", 0.08, "Selected" },
}

local GROUP_THEME = {
	{ "Widget", "DesiredWidth", 46 },
	{ "Widget", "MinimumWidth", 46 },
	{ "Widget", "MinimumHeight", 46 },
	{ "Widget", "BorderSize", 0 },
	{ "IconButton", "BackgroundColor3", Color3.fromRGB(20, 20, 23) },
	{ "IconButton", "BackgroundTransparency", 1 },
	{ "IconCorners", "CornerRadius", UDim.new(0, 17) },
	{ "IconImageScale", "Value", 0.5 },
	{ "IconSpot", "BackgroundTransparency", 1 },
	{ "IconSpot", "BackgroundTransparency", 1, "Selected" },
}

local GROUP_CONTAINER_THEME = {
	{ "Widget", "MinimumHeight", 46 },
	{ "Widget", "BorderSize", 0 },
	{ "IconButton", "BackgroundTransparency", 1 },
	{ "IconCorners", "CornerRadius", UDim.new(1, 0) },
	{ "Menu", "BackgroundColor3", Color3.fromRGB(18, 18, 21) },
	{ "Menu", "BackgroundTransparency", 0.08 },
	{ "MenuUIListLayout", "Padding", UDim.new(0, 0) },
}

function TopbarFactory.new()
	local rightHolder = Topbarplus.container.TopbarStandard.Holders.Right
	local rightLayout = rightHolder:FindFirstChildOfClass("UIListLayout")
	if rightLayout then
		rightLayout.Padding = UDim.new(0, 6)
	end

	return setmetatable({
		_icons = {},
		_connections = {},
	}, Factory)
end

function Factory:_rememberIcon(icon)
	table.insert(self._icons, icon)
	return icon
end

function Factory:TrackConnection(connection)
	table.insert(self._connections, connection)
	return connection
end

function Factory:CreateImage(assetName: string, caption: string, order: number, standalone: boolean?)
	local image = TopbarFactory.Assets[assetName] or assetName
	local icon = self:_rememberIcon(Topbarplus.new())
	icon:setImage(image)
	icon:setImageScale(0.54)
	icon:setCaption(caption)
	icon:setOrder(order)

	if standalone ~= false then
		icon:align("Right")
		icon:modifyTheme(ICON_THEME)
	end

	return icon
end


function Factory:CreateLabel(label: string, caption: string, width: number?)
	local icon = self:_rememberIcon(Topbarplus.new())
	icon:setLabel(label)
	icon:setWidth(width or 64)
	icon:setTextSize(15)
	icon:setCaption(caption)
	return icon
end

function Factory:CreateGroup(icons: { any }, order: number)
	local groupIcon = self:_rememberIcon(Topbarplus.new())
	groupIcon:align("Right")
	groupIcon:setOrder(order)
	groupIcon:modifyChildTheme(GROUP_THEME)
	groupIcon:setFixedMenu(icons)
	groupIcon:modifyTheme(GROUP_CONTAINER_THEME)

	local menu = groupIcon:getInstance("Menu")
	local menuCorner = Instance.new("UICorner")
	menuCorner.Name = "GroupCorner"
	menuCorner.CornerRadius = UDim.new(1, 0)
	menuCorner.Parent = menu

	return groupIcon
end

function Factory:BindToggle(icon, onOpen: () -> (), onClose: () -> ())
	self:TrackConnection(icon.selected:Connect(onOpen))
	self:TrackConnection(icon.deselected:Connect(onClose))
	return icon
end

function Factory:BindOneClick(icon, callback: () -> ())
	icon:oneClick()
	self:TrackConnection(icon.selected:Connect(callback))
	return icon
end

function Factory:Destroy()
	for index = #self._connections, 1, -1 do
		self._connections[index]:Disconnect()
	end
	table.clear(self._connections)

	for index = #self._icons, 1, -1 do
		self._icons[index]:destroy()
	end
	table.clear(self._icons)
end

return TopbarFactory
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="463">
          <Properties>
            <string name="Name">Utils</string>
          </Properties>
          <Item class="ModuleScript" referent="464">
            <Properties>
              <string name="Name">CharacterUtils</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")

local CharacterUtils = {}
CharacterUtils.HipHeight = {}

function CharacterUtils.GetHipHeight(character: Model): number
	if CharacterUtils.HipHeight[character] then
		return CharacterUtils.HipHeight[character]
	end

	local hipHeight = tonumber(character:GetAttribute("HipHeight"))
	if hipHeight then
		CharacterUtils.HipHeight[character] = hipHeight
		return hipHeight
	end

	local leftLeg = character:FindFirstChild("Left Leg")
	local primaryPart = character.PrimaryPart

	if not (leftLeg and primaryPart) then
		local humanoid = character:FindFirstChild("Humanoid")

		CharacterUtils.HipHeight[character] = humanoid.HipHeight or 2
		return humanoid.HipHeight or 2
	end

	CharacterUtils.HipHeight[character] = leftLeg.Size.Y + (primaryPart.Size.Y / 2)
	return leftLeg.Size.Y + (primaryPart.Size.Y / 2)
end

function CharacterUtils.LoadAvatar(rig: Model, user: number | string): boolean
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		warn("Rig에 Humanoid가 없음!")
		return false
	end

	local userId = nil
	if typeof(user) == "number" then
		userId = user
	else
		local success, id = pcall(function()
			return Players:GetUserIdFromNameAsync(user)
		end)
		if success then
			userId = id
		end
	end

	if not userId then
		warn("유효하지 않은 유저: " .. tostring(user))
		return false
	end

	local success, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserIdAsync(userId)
	end)

	if success and description then
		humanoid:ApplyDescriptionAsync(description)
		return true
	else
		warn("아바타 로드 실패 - UserID: " .. tostring(userId))
		return false
	end
end

function CharacterUtils.SetCollisionGroup(targetInstance: Instance, groupName: string, onApply: (part: BasePart) -> ()?)
	for _, object in targetInstance:GetDescendants() do
		if object:IsA("BasePart") then
			object.CollisionGroup = groupName

			if onApply then
				onApply(object)
			end
		end
	end

	targetInstance.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = groupName

			if onApply then
				onApply(part)
			end
		end
	end)
end

function CharacterUtils.RigInstance(part0: BasePart, part1: BasePart, offset: CFrame, isMotor: boolean?): Motor6D | Weld
	local weld
	if isMotor then
		weld = Instance.new("Motor6D")
	else
		weld = Instance.new("Weld")
	end
	weld.Enabled = false

	weld.Part0 = part0
	weld.Part1 = part1
	weld.C0 = offset

	weld.Parent = part0

	weld.Enabled = true

	return weld
end

return CharacterUtils
]]></string>
