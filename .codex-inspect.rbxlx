			},
		},
		["25000 Coins"] = {
			Id = 3597077765,
			Rewards = {
				{ Type = "Currency", Target = "Coins", Amount = 25000 },
			},
		},

		--/Gems
		["10 Gems"] = {
			Id = 3573263947,
			Rewards = {
				{ Type = "Currency", Target = "Gems", Amount = 10 },
			},
		},
		["50 Gems"] = {
			Id = 3573264174,
			Rewards = {
				{ Type = "Currency", Target = "Gems", Amount = 50 },
			},
		},
		["200 Gems"] = {
			Id = 3573264387,
			Rewards = {
				{ Type = "Currency", Target = "Gems", Amount = 200 },
			},
		},
		["500 Gems"] = {
			Id = 3597079530,
			Rewards = {
				{ Type = "Currency", Target = "Gems", Amount = 500 },
			},
		},
		["2000 Gems"] = {
			Id = 3597079795,
			Rewards = {
				{ Type = "Currency", Target = "Gems", Amount = 2000 },
			},
		},
	},
}

local PurchaseData = {
	ByName = RawPurchaseData,
	ById = {},
}

for category, items in pairs(RawPurchaseData) do
	for name, data in pairs(items) do
		data.Name = name
		data.Category = category

		if PurchaseData.ById[data.Id] then
			warn(`중복 Id: {data.Id} 감지. 기존: {PurchaseData.ById[data.Id].Name}, 신규: {name}`)
		end

		PurchaseData.ById[data.Id] = data
	end
end

return TableUtils.DeepFreeze(PurchaseData)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="336">
          <Properties>
            <string name="Name">QuestData</string>
            <string name="Source"><![CDATA[export type QuestConfig = {
	Id: string,
	Theme: string,
	Title: string,
	Description: string,
	TargetCurrency: string?,
	TargetAmount: number,
	NpcId: string?,
	Rewards: {
		Coins: number?,
		Gems: number?,
		Exp: number?,
		[string]: any,
	},
}

local QuestData: { [string]: QuestConfig } = {
	["BlossomCollector"] = {
		Id = "BlossomCollector",
		Theme = "EVENT",
		Title = "벚꽃 수집가",
		Description = "벚꽃 재화 1,500개 수집하기",
		TargetCurrency = "Blossom",
		TargetAmount = 1500,
		NpcId = "WanderingMerchant",
		Rewards = {
			Coins = 5000,
			Gems = 50,
			Exp = 200,
		},
	},
}

return QuestData
]]></string>
