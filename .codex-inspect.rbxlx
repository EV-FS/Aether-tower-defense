type BLINK_EVENTS_SYMBOL = typeof(Returns)
return Returns :: BLINK_EVENTS_SYMBOL</string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="365">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="Folder" referent="366">
          <Properties>
            <string name="Name">Entities</string>
          </Properties>
          <Item class="Folder" referent="367">
            <Properties>
              <string name="Name">EnemyService</string>
            </Properties>
            <Item class="ModuleScript" referent="368">
              <Properties>
                <string name="Name">EnemyClient</string>
                <string name="Source"><![CDATA[--/Services
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

--/Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local Net = require(ReplicatedStorage.Shared.Net)
local EnemyVisuals = require(script.EnemyVisuals)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local TimeService
local AnimationService
local GameClient
local VisualService

local RANDOM = Random.new()
local DEATH_EXTRA_DELAY = 2.0

local isActived = false
local ActivedEnemies = {}

local partsToMove = {}
local cframesToMove = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getPingTime(sendTimeMs: number): number
	local currentTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536
	local difference = (currentTimeMs - sendTimeMs) % 65536
	if difference > 32768 then
		difference -= 65536
	end

	return math.max(0, difference) / 1000
end

local function removeStunVisuals(enemy)
	if enemy.StunEffect then
		enemy.StunEffect:Destroy()
		enemy.StunEffect = nil
	end
end

local function getEnemyCFrame(model: Model, pathAlpha: number, offset: number, moveDirection: number?, pathId: number): CFrame
	local Height = CharacterUtils.GetHipHeight(model)
	local targetCFrame = GetPath:Get(pathId):CalculateUniformCFrame(pathAlpha) + Vector3.new(0, Height, 0)
	local cframeOffset = targetCFrame.RightVector * offset
	local finalCFrame = targetCFrame + cframeOffset

	if moveDirection and moveDirection < 0 then
		finalCFrame *= CFrame.Angles(0, math.rad(180), 0)
	end

	return finalCFrame
end

local function applyStunVisuals(enemy)
	if enemy.StunEffect then
		return
	end

	local stunModel = ReplicatedStorage.Assets.Visuals:FindFirstChild("Stun")
	if not stunModel then
		return
	end

	local stunEffect = stunModel:Clone()
	local rootPart = enemy.Model.PrimaryPart
	if not rootPart then
		stunEffect:Destroy()
		return
	end

	if stunEffect:IsA("BasePart") then
		stunEffect.Anchored = true
	end
	for _, part in stunEffect:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end

	local scale = 1
	local headPart = enemy.Model:FindFirstChild("Head")
	if headPart and headPart:IsA("BasePart") then
		scale = headPart.Size.Y
	else
		scale = rootPart.Size.Y / 2
	end

	if stunEffect:IsA("Model") then
		stunEffect:ScaleTo(scale)
	elseif stunEffect:IsA("BasePart") then
		stunEffect.Size = stunEffect.Size * scale
	end

	local targetCFrame
	if headPart and headPart:IsA("BasePart") then
		targetCFrame = CFrame.new(headPart.Position + Vector3.new(0, scale, 0))
	else
		local HipHeight = CharacterUtils.GetHipHeight(enemy.Model)
		targetCFrame = rootPart.CFrame + Vector3.new(0, HipHeight, 0)
	end

	if stunEffect:IsA("Model") then
		stunEffect:PivotTo(targetCFrame)
	elseif stunEffect:IsA("BasePart") then
		stunEffect.CFrame = targetCFrame
	end

	stunEffect.Parent = workspace:WaitForChild("Visuals")
	enemy.StunEffect = stunEffect
end

local function getHealthMultiplier(): number
	local difficulty = GameClient and GameClient.SelectedDifficulty or "Normal"
	local playerCount = GameClient and GameClient.StartPlayerCount or 1

	local diffMultiplier = 1
	if difficulty == "Hard" then
		diffMultiplier = 2
	elseif difficulty == "Eternal" then
		diffMultiplier = 3
	end
	local playerMultiplier = 1 + ((playerCount - 1) * 0.5)

	return diffMultiplier * playerMultiplier
end

-------------------------------------------------
--// EnemyClient
-------------------------------------------------
local EnemyClient = {}

function EnemyClient.Init(services)
	TimeService = services:GetService("TimeService")
	AnimationService = services:GetService("AnimationService")
	GameClient = services:GetService("GameClient")
	VisualService = services:GetService("VisualService")
end

function EnemyClient.Start()
	Net.EnemyService.ReplicatedEnemy.On(EnemyClient.newEnemy)
	Net.EnemyService.UpdateSpeed.On(EnemyClient._OnUpdateSpeed)
	Net.EnemyService.UpdateDirection.On(EnemyClient._OnUpdateDirection)
	Net.EnemyService.OnDamaged.On(EnemyClient._OnDamaged)
	Net.EnemyService.TakeKnockback.On(EnemyClient._TakeKnockback)
	Net.EnemyService.DestroyEnemy.On(function(enemyId: number)
		EnemyClient.Destroy(enemyId, true)
	end)

	ClientSignals.GameSpeedChanged:Connect(EnemyClient._OnGameSpeedChanged)
end

function EnemyClient.newEnemy(data: {
	enemyId: number,
	enemyIndex: number,
	sendTimeMs: number,
	isBoss: boolean?,
	startPathAlpha: number?,
	pathId: number,
})
	local enemyData = EnemyData.ByIndex[data.enemyIndex]
	if not enemyData then
		return
	end

	local enemyModel = ReplicatedStorage.Assets.Enemies:FindFirstChild(enemyData.Name)
	if not enemyModel then
		return
	end

	local clonedModel = enemyModel:Clone()
	clonedModel.Name = `Enemy_{data.enemyId}`
	clonedModel.PrimaryPart.Anchored = true

	local pathLength = GetPath:Get(data.pathId):GetPathLength()
	local pingTime = getPingTime(data.sendTimeMs)

	local offsetVal = RANDOM:NextNumber(-0.5, 0.5)

	local baseAlpha = data.startPathAlpha or 0
	local pathAlphaVal = baseAlpha + ((enemyData.WalkSpeed * pingTime * TimeService:GetGameSpeed()) / pathLength)
	pathAlphaVal = math.clamp(pathAlphaVal, 0, 1)

	local finalCFrame = getEnemyCFrame(clonedModel, pathAlphaVal, offsetVal, 1, data.pathId)
	clonedModel:PivotTo(finalCFrame)

	clonedModel.Parent = workspace.Enemies

	AnimationService.Load(clonedModel, enemyData.Name)
	AnimationService.Play(clonedModel, "Walk", nil, 0)

	CharacterUtils.SetCollisionGroup(clonedModel, "Enemy", function(part)
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end)

	VisualService.Play(enemyData.Name, "OnSpawn", 0, clonedModel, clonedModel)

	local healthMultiplier = getHealthMultiplier()
	ActivedEnemies[data.enemyId] = {
		Id = data.enemyId,
		Name = enemyData.Name,
		Model = clonedModel,

		BaseSpeed = enemyData.WalkSpeed,
		WalkSpeed = enemyData.WalkSpeed,
		PathAlpha = pathAlphaVal,
		PathId = data.pathId,
		Offset = offsetVal,
		MoveDirection = 1,

		MaxHealth = math.floor(enemyData.MaxHealth * healthMultiplier),
		Health = math.floor(enemyData.MaxHealth * healthMultiplier),

		IsBoss = data.isBoss,
	}

	if data.isBoss then
		ClientSignals.BossSpawned:Fire(ActivedEnemies[data.enemyId])
	end

	EnemyVisuals.Attach(data.enemyId, enemyData.Name, clonedModel, ActivedEnemies[data.enemyId].MaxHealth)

	EnemyClient.StartMoveLoop()
end

function EnemyClient.Destroy(enemyId: number, forcing: boolean?)
	local targetEnemy = ActivedEnemies[enemyId]
	if not targetEnemy then
		return
	end

	if targetEnemy.IsBoss then
		ClientSignals.BossDestroyed:Fire(enemyId)
	end

	EnemyVisuals.Destroy(enemyId)

	if targetEnemy.Model then
		if not forcing and AnimationService.GetTrack(targetEnemy.Model, "Death") then
			AnimationService.Stop(targetEnemy.Model)
			local track = AnimationService.Play(targetEnemy.Model, "Death") :: AnimationTrack

			local animLength = (track and track.Length > 0) and track.Length or 1.5
			local delayTime = animLength + DEATH_EXTRA_DELAY

			TimeService.DeltaDelay(math.max(0.01, animLength - 0.05)):andThen(function()
				track:AdjustSpeed(0)
			end)
			TimeService.DeltaDelay(delayTime):andThen(function()
				EnemyClient.DisappearModel(targetEnemy.Model)
			end)

			Debris:AddItem(targetEnemy.Model, delayTime + 5)
		else
			task.defer(EnemyClient.DisappearModel, targetEnemy.Model)
			Debris:AddItem(targetEnemy.Model, 5)
		end
	end

	removeStunVisuals(targetEnemy)

	ActivedEnemies[enemyId] = nil
end

function EnemyClient.StartMoveLoop()
	if isActived then
		return
	end
	isActived = true

	local connection
	connection = RunService.PreRender:Connect(function(dt)
		local hasEnemies = EnemyClient.MoveAllEnemies(dt)

		if not hasEnemies then
			isActived = false
			connection:Disconnect()
		end
	end)
end

function EnemyClient.MoveAllEnemies(dt)
	table.clear(partsToMove)
	table.clear(cframesToMove)

	local hasEnemies = false

	for id, enemy in pairs(ActivedEnemies) do
		hasEnemies = true

		local rootPart = enemy.Model.PrimaryPart
		if not rootPart then
			continue
		end

		local pathLength = GetPath:Get(enemy.PathId):GetPathLength()

		enemy.PathAlpha += ((enemy.WalkSpeed * dt * TimeService:GetGameSpeed()) / pathLength) * enemy.MoveDirection
		enemy.PathAlpha = math.clamp(enemy.PathAlpha, 0, 1)

		if enemy.PathAlpha >= 1 then
			EnemyClient.Destroy(id)
			continue
		end

		local finalCFrame = getEnemyCFrame(enemy.Model, enemy.PathAlpha, enemy.Offset, enemy.MoveDirection, enemy.PathId)

		table.insert(partsToMove, rootPart)
		table.insert(cframesToMove, finalCFrame)
	end

	if #partsToMove > 0 then
		workspace:BulkMoveTo(partsToMove, cframesToMove, Enum.BulkMoveMode.FireCFrameChanged)
	end

	return hasEnemies
end

function EnemyClient.DisappearModel(model)
	model.PrimaryPart:SetAttribute("Dead", true)

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.Transparency = 1
		end
	end
end

function EnemyClient._OnGameSpeedChanged(newSpeed: number, oldSpeed: number, pingTime: number)
	for _, enemy in pairs(ActivedEnemies) do
		local pathLength = GetPath:Get(enemy.PathId):GetPathLength()
		local pingOffset = (enemy.WalkSpeed * pingTime * (newSpeed - oldSpeed)) / pathLength

		enemy.PathAlpha += pingOffset
	end
end

function EnemyClient._OnUpdateSpeed(data: { enemyId: number, WalkSpeed: number, sendTimeMs: number })
	local updatedEnemy = ActivedEnemies[data.enemyId]
	if not updatedEnemy then
		return
	end

	local pingTime = getPingTime(data.sendTimeMs)

	local CalWalkSpeed = data.WalkSpeed / 100
	local pathLength = GetPath:Get(updatedEnemy.PathId):GetPathLength()

	local gameSpeed = TimeService:GetGameSpeed()
	local pingOffset = (updatedEnemy.WalkSpeed * pingTime * gameSpeed) / pathLength
	local alphaOffset = (CalWalkSpeed * pingTime * gameSpeed) / pathLength

	updatedEnemy.WalkSpeed = CalWalkSpeed
	updatedEnemy.PathAlpha += -pingOffset + alphaOffset

	local speedRatio = CalWalkSpeed / updatedEnemy.BaseSpeed
	local walkTrack = AnimationService.GetTrack(updatedEnemy.Model, "Walk")
	if walkTrack then
		walkTrack:AdjustSpeed(speedRatio)
	end

	if CalWalkSpeed == 0 then
		task.spawn(function()
			RunService.PreRender:Wait()
			task.defer(applyStunVisuals, updatedEnemy)
		end)
	else
		removeStunVisuals(updatedEnemy)
	end
end

function EnemyClient._OnUpdateDirection(data: { enemyId: number, MoveDirection: boolean, sendTimeMs: number })
	local updatedEnemy = ActivedEnemies[data.enemyId]
	if not updatedEnemy then
		return
	end

	local pingTime = getPingTime(data.sendTimeMs)

	local convertDirection = data.MoveDirection and 1 or -1
	local pathLength = GetPath:Get(updatedEnemy.PathId):GetPathLength()

	local pingOffset = (updatedEnemy.WalkSpeed * pingTime * TimeService:GetGameSpeed()) / pathLength

	updatedEnemy.MoveDirection = convertDirection
	updatedEnemy.PathAlpha -= pingOffset
end

function EnemyClient._TakeKnockback(data: { enemyId: number, studs: number })
	local updatedEnemy = ActivedEnemies[data.enemyId]
	if not updatedEnemy then
		return
	end

	local pathLength = GetPath:Get(updatedEnemy.PathId):GetPathLength()
	local converknockback = (data.studs / 10) / pathLength

	local duration = 0.2
	local startTime = os.clock()
	local startAlpha = updatedEnemy.PathAlpha
	local targetAlpha = math.clamp(startAlpha - converknockback, 0, 1)

	task.spawn(function()
		while true do
			local currentEnemy = ActivedEnemies[data.enemyId]
			if not currentEnemy then
				break
			end

			local elapsed = (os.clock() - startTime) * TimeService:GetGameSpeed()
			if elapsed >= duration then
				break
			end

			local t = elapsed / duration
			local easedT = t * (2 - t)
			currentEnemy.PathAlpha = math.clamp(NumberUtils.Lerp(startAlpha, targetAlpha, easedT), 0, 1)
			task.wait()
		end

		local finalEnemy = ActivedEnemies[data.enemyId]
		if finalEnemy then
			finalEnemy.PathAlpha = targetAlpha
		end
	end)
end

function EnemyClient._OnDamaged(data: { enemyId: number, damaged: number })
	local updatedEnemy = ActivedEnemies[data.enemyId]
	if not updatedEnemy then
		return
	end

	updatedEnemy.Health -= data.damaged
	EnemyVisuals.Update(data.enemyId, updatedEnemy.Health, updatedEnemy.MaxHealth)

	if updatedEnemy.IsBoss then
		ClientSignals.BossDamaged:Fire(data.enemyId, updatedEnemy.Health, updatedEnemy.MaxHealth)
	end

	if updatedEnemy.Health <= 0 then
		EnemyClient.Destroy(data.enemyId)
	end
end

return EnemyClient
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="369">
                <Properties>
                  <string name="Name">EnemyVisuals</string>
                  <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local InstanceCache = require(ReplicatedStorage.Shared.Modules.Core.InstanceCache)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local Visuals = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Visuals")
local HealthBarGui = Visuals:WaitForChild("HealthBarGui") :: BillboardGui
local CacheFolder = workspace:WaitForChild("Caches")

local BAR_OFFSET = 0.45
local CACHE_SIZE = 30
local TWEEN_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local HEALTH_HIGH_COLOR = Color3.fromRGB(72, 225, 119)
local HEALTH_MID_COLOR = Color3.fromRGB(255, 211, 77)
local HEALTH_LOW_COLOR = Color3.fromRGB(237, 70, 70)

type HealthBarState = {
	Gui: BillboardGui,
	Fill: Frame,
	HealthText: TextLabel,
	Tween: Tween?,
	MaxHealth: number,
}

local HealthBarStorage = InstanceCache.new(HealthBarGui, CACHE_SIZE, CacheFolder)
local healthBars: { [number]: HealthBarState } = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getAdornee(model: Model): (BasePart?, Vector3)
	local primaryPart = model.PrimaryPart
	if primaryPart then
		return primaryPart, Vector3.new(0, CharacterUtils.GetHipHeight(model) - BAR_OFFSET, 0)
	end

	return nil, Vector3.zero
end

local function getHealthColor(ratio: number): Color3
	if ratio > 0.5 then
		return HEALTH_MID_COLOR:Lerp(HEALTH_HIGH_COLOR, (ratio - 0.5) / 0.5)
	end

	return HEALTH_LOW_COLOR:Lerp(HEALTH_MID_COLOR, ratio / 0.5)
end

local function createBar(enemyModel: Model, enemyName: string, maxHealth: number): HealthBarState?
	local adornee, offset = getAdornee(enemyModel)
	if not adornee then
		return nil
	end

	local healthGui = HealthBarStorage:GetInstance() :: BillboardGui
	healthGui.Adornee = adornee
	healthGui.StudsOffsetWorldSpace = offset
	healthGui.Parent = playerGui:WaitForChild("Billboard")

	local nameText = healthGui:WaitForChild("EnemyName") :: TextLabel
	nameText.Text = enemyName

	local background = healthGui:WaitForChild("Background") :: Frame
	local fillBar = background:WaitForChild("Bar") :: Frame
	fillBar.BackgroundColor3 = HEALTH_HIGH_COLOR
	fillBar.Size = UDim2.fromScale(1, 1)

	local healthText = background:WaitForChild("Health") :: TextLabel
	healthText.Text = `{maxHealth}/{maxHealth}`

	healthGui.Enabled = true

	return {
		Gui = healthGui,
		Fill = fillBar,
		HealthText = healthText,
		Tween = nil,
		MaxHealth = maxHealth,
	}
end

-------------------------------------------------
--// EnemyVisuals
-------------------------------------------------
local EnemyVisuals = {}

function EnemyVisuals.Attach(enemyId: number, enemyName: string, enemyModel: Model, maxHealth: number)
	EnemyVisuals.Destroy(enemyId)

	if maxHealth <= 0 then
		return
	end

	local state = createBar(enemyModel, enemyName, maxHealth)
	if state then
		healthBars[enemyId] = state
	end
end

function EnemyVisuals.Update(enemyId: number, health: number, maxHealth: number?)
	local state = healthBars[enemyId]
	if not state then
		return
	end

	local targetMaxHealth = maxHealth or state.MaxHealth
	if targetMaxHealth <= 0 then
		return
	end

	state.MaxHealth = targetMaxHealth

	local ratio = math.clamp(health / targetMaxHealth, 0, 1)
	local targetHealth = math.clamp(health, 0, targetMaxHealth)
	local targetText = `{targetHealth}/{targetMaxHealth}`
	local targetSize = UDim2.fromScale(ratio, 1)
	local targetColor = getHealthColor(ratio)

	state.HealthText.Text = targetText

	if state.Tween then
		state.Tween:Cancel()
	end

	state.Tween = TweenService:Create(state.Fill, TWEEN_INFO, {
		BackgroundColor3 = targetColor,
		Size = targetSize,
	})
	state.Tween:Play()
end

function EnemyVisuals.Destroy(enemyId: number)
	local state = healthBars[enemyId]
	if not state then
		return
	end

	if state.Tween then
		state.Tween:Cancel()
		state.Tween = nil
	end

	if state.Gui then
		state.Gui.Enabled = false
		state.Gui.Adornee = nil
		HealthBarStorage:ReturnInstance(state.Gui)
	end

	healthBars[enemyId] = nil
end

return EnemyVisuals
]]></string>
                </Properties>
              </Item>
            </Item>
          </Item>
          <Item class="Folder" referent="370">
            <Properties>
              <string name="Name">TowerService</string>
            </Properties>
            <Item class="ModuleScript" referent="371">
              <Properties>
                <string name="Name">TowerClient</string>
                <string name="Source"><![CDATA[--/Services
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

--/Service Modules
local EconomyService
local InputService

--/Core Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local TowerPlacement = require(script.TowerPlacement)
local TowerRenderer = require(script.TowerRenderer)
local PlaceValidator = require(script.Parent.Utils.PlaceValidator)
local Net = require(ReplicatedStorage.Shared.Net)

--/Modules
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local MouseRayCast = require(ReplicatedStorage.Shared.Modules.Utils.MouseRayCast)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local NotificationService = require(ReplicatedStorage.Shared.Services.System.NotificationService)
local CreateRangeIndicator = require(script.Parent.Utils.CreateRangeIndicator)

--/Constants
local PLAYER = Players.LocalPlayer
local placementSession
local hoveredTowerModel
local selectedTowerId
local PlacementScope
local SelectionScope

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function findTaggedAncestor(instance: Instance): Model?
	local current = instance

	while current do
		if current:IsA("Model") and CollectionService:HasTag(current, "Tower") then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function getSortedPlayers()
	local players = Players:GetPlayers()
	table.sort(players, function(a, b)
		if a.UserId == b.UserId then
			return a.Name < b.Name
		end
		return a.UserId < b.UserId
	end)

	return players
end

local function getPlayerBySlot(slot: number): Player?
	return getSortedPlayers()[slot]
end

-------------------------------------------------
--// TowerClient
-------------------------------------------------
local TowerClient = {}
TowerClient.PlacedTowers = {}
TowerClient.ActiveTowers = {}

function TowerClient.Init(services)
	EconomyService = services:GetService("EconomyService")
	InputService = services:GetService("InputService")

	TowerRenderer.Init(services)
	TowerPlacement.Init(services, TowerClient.GetTowerCount)
	CreateRangeIndicator.Init()
end

function TowerClient.Start()
	TowerRenderer.Start()

	--/Input
	local iScope = InputService.Scope
	local iAction = InputService.Action
	local iInfo = InputService.Info

	PlacementScope = iScope("PlacementInput", {
		iAction("Spawn", iInfo({ Enum.UserInputType.MouseButton1, "DoubleTap" })),
		iAction("Rotate", iInfo({ Enum.KeyCode.R })),
		iAction("Cancel", iInfo({ Enum.KeyCode.X })),
	}):Disable()

	SelectionScope = iScope("SelectionInput", {
		iAction("Click", iInfo({ Enum.UserInputType.MouseButton1, "Touch" })),
	}):Enable()

	--/Connect
	RunService.PreRender:Connect(function()
		TowerClient._UpdateHoverState()

		if placementSession then
			placementSession:Update()
		end
	end)

	TowerClient._SetPlacementInput()
	TowerClient._SetSelectionInput()

	ClientSignals.SpawnRequested:Connect(function(towerName: string, towerKey: string)
		TowerClient.StartPlacement(towerName, towerKey)
	end)

	ClientSignals.UpgradeRequested:Connect(TowerClient.RequestUpgrade)
	ClientSignals.SellRequested:Connect(TowerClient.RequestSell)
	ClientSignals.ChangeTargetRequested:Connect(TowerClient.RequestSetTargetMode)

	Net.TowerService.OnAttackEnemy.On(TowerClient._OnAttackEnemy)
	Net.TowerService.TowerUpdated.On(TowerClient._TowerUpdated)
	Net.TowerService.TowerDestroyed.On(TowerClient.RemoveTower)
	Net.TowerService.TowerSpawned.On(TowerClient._TowerSpawned)
	Net.TowerService.TowerTargetModeUpdated.On(TowerClient._TowerTargetModeUpdated)
	Net.TowerService.PassiveTriggered.On(TowerClient._PassiveTriggered)
end

function TowerClient._SetPlacementInput()
	PlacementScope.Actions.Spawn.Began:Connect(TowerClient.RequestSpawn)
	PlacementScope.Actions.Rotate.Began:Connect(function()
		placementSession:Rotate()
	end)
	PlacementScope.Actions.Cancel.Began:Connect(function()
		placementSession:Destroy()
		placementSession = nil

		PlacementScope:Disable()
		SelectionScope:Enable()
	end)
end

function TowerClient._SetSelectionInput()
	SelectionScope.Actions.Click.Began:Connect(function()
		local result = MouseRayCast()

		if result and result.Instance then
			local model = findTaggedAncestor(result.Instance)
			if model then
				local towerId = model:GetAttribute("Id")
				local towerData = TowerClient.ActiveTowers[towerId]
				selectedTowerId = towerId

				TowerRenderer.ToggleRangeIndicator(true, towerId, towerData)
				ClientSignals.TowerSelected:Fire(towerId, towerData)
				return
			end
		end

		selectedTowerId = nil
		TowerRenderer.ToggleRangeIndicator(false)
		ClientSignals.TowerUnselected:Fire()
	end)
end

function TowerClient.GetTowerCount(towerName)
	return TowerClient.PlacedTowers[towerName] or 0
end

function TowerClient.StartPlacement(towerName: string, towerKey: string?)
	if placementSession then
		placementSession:Destroy()
	end

	if selectedTowerId then
		selectedTowerId = nil
		TowerRenderer.ToggleRangeIndicator(false)
		ClientSignals.TowerUnselected:Fire()
	end

	placementSession = TowerPlacement.new(towerName, towerKey)
	placementSession:Start()

	PlacementScope:Enable()
	SelectionScope:Disable()
end

function TowerClient.RegisterTower(player: Player?, towerId: number, data)
	TowerRenderer.Setup(towerId, data.towerModel, data.towerName, data.borderData)

	if player == PLAYER then
		TowerClient.PlacedTowers[data.towerName] = (TowerClient.PlacedTowers[data.towerName] or 0) + 1
		ClientSignals.TowerCountChanged:Fire(data.towerName, TowerClient.PlacedTowers[data.towerName])
	end

	TowerClient.ActiveTowers[towerId] = {
		Owner = player,
		Name = data.towerName,
		Model = data.towerModel,
		Position = data.position or Vector3.new(data.borderData.x, 0, data.borderData.z),
		Target = "First",
		Level = 0,
		Stats = TableUtils.DeepCopy(TowerData.ByName[data.towerName].Stats[0]),
	}

	PlaceValidator.AddBorder(towerId, data.borderData)
end

function TowerClient._CreateTowerModel(towerName: string, spawnPosition: Vector3, rotation: number?): Model?
	local towerAsset = ReplicatedStorage.Assets.Towers:FindFirstChild(towerName)
	if not towerAsset then
		return nil
	end

	local towerModel = towerAsset:Clone()
	if towerModel.PrimaryPart then
		towerModel.PrimaryPart.Anchored = true
	end

	local heightOffset = CharacterUtils.GetHipHeight(towerModel)
	local targetCFrame = CFrame.new(spawnPosition + Vector3.new(0, heightOffset, 0))
		* CFrame.Angles(0, math.rad(rotation or 0), 0)
	towerModel:PivotTo(targetCFrame)

	return towerModel
end

function TowerClient._TowerSpawned(data: {
	towerId: number,
	towerIndex: number,
	ownerSlot: number,
	spawnLocation: Vector3,
})
	if TowerClient.ActiveTowers[data.towerId] then
		return
	end

	local towerInfo = TowerData.ByIndex[data.towerIndex]
	if not towerInfo then
		return
	end

	local towerModel = TowerClient._CreateTowerModel(towerInfo.Name, data.spawnLocation)
	if not towerModel or not towerModel.PrimaryPart then
		return
	end

	local borderRadius = towerModel.PrimaryPart.Size.X * 1.5
	TowerClient.RegisterTower(getPlayerBySlot(data.ownerSlot), data.towerId, {
		towerName = towerInfo.Name,
		position = data.spawnLocation,
		borderData = {
			x = data.spawnLocation.X,
			z = data.spawnLocation.Z,
			r = borderRadius,
		},
		towerModel = towerModel,
	})
end

function TowerClient.RemoveTower(towerId: number)
	local towerData = TowerClient.ActiveTowers[towerId]
	if not towerData then
		return
	end

	if TowerClient.PlacedTowers[towerData.Name] then
		TowerClient.PlacedTowers[towerData.Name] = math.max(0, TowerClient.PlacedTowers[towerData.Name] - 1)
		ClientSignals.TowerCountChanged:Fire(towerData.Name, TowerClient.PlacedTowers[towerData.Name])
	end

	TowerRenderer.SellVisuals(towerId)
	TowerRenderer.Cleanup(towerId)
	PlaceValidator.RemoveBorder(towerId)

	TowerClient.ActiveTowers[towerId] = nil

	ClientSignals.TowerDestroyed:Fire(towerId)

	if hoveredTowerModel == towerData.Model then
		hoveredTowerModel = nil
	end

	if selectedTowerId == towerId then
		selectedTowerId = nil
	end
end

function TowerClient.RequestSpawn()
	if not placementSession then
		return
	end

	local placementData = placementSession:GetPlacementData()
	if not placementData then
		return
	end

	local towerName = placementSession.TowerName
	local towerKey = placementSession.TowerKey
	local spawnPosition = placementData.Position
	if typeof(towerKey) ~= "string" then
		warn(`Cannot spawn tower "{towerName}" without a tower key.`)
		return
	end

	local validationData = {
		["TowerName"] = towerName,
		["SpawnPosition"] = spawnPosition,
		["BorderRadius"] = placementData.BorderRadius,
		["CurrentCash"] = EconomyService.GetCash(PLAYER),
		["CurrentCount"] = TowerClient.GetTowerCount(towerName),
	}

	local canSpawn, errorMsg = PlaceValidator.CheckSpawn(validationData)
	if not canSpawn then
		NotificationService:Pull(PLAYER, errorMsg, "Error", 3)
		return
	end

	local spawnRequestData = {
		spawnLocation = spawnPosition,
		towerIndex = TowerData.ByName[towerName].Index,
		towerKey = towerKey,
	}

	local newTowerId = Net.TowerService.SpawnNewTower.Invoke(spawnRequestData):expect()

	if newTowerId then
		local newModel = TowerClient._CreateTowerModel(towerName, spawnPosition, placementData.Rotation)
		if not newModel then
			return
		end

		local borderData = {
			x = spawnPosition.X,
			z = spawnPosition.Z,
			r = placementData.BorderRadius,
		}

		local newTowerData = {
			towerName = towerName,
			position = spawnPosition,
			borderData = borderData,
			towerModel = newModel,
		}

		TowerClient.RegisterTower(PLAYER, newTowerId, newTowerData)

		placementSession:Destroy()
		placementSession = nil

		PlacementScope:Disable()
		SelectionScope:Enable()
	end
end

function TowerClient.RequestUpgrade(towerId)
	if placementSession then
		return false
	end

	local towerData = TowerClient.ActiveTowers[towerId]
	if not towerData or towerData._isUpgrading then
		return
	end

	towerData._isUpgrading = true

	local success = Net.TowerService.UpgradeTower.Invoke(towerId):expect()

	towerData._isUpgrading = false

	if not success then
		warn("업그레이드 실패.")
	end

	return success
end

function TowerClient.RequestSell(towerId)
	if placementSession then
		return false
	end

	local success = Net.TowerService.SellTower.Invoke(towerId):expect()
	if not success then
		warn("판매 실패.")
	end

	return success
end

function TowerClient.RequestSetTargetMode(towerId, targetMode)
	local success = Net.TowerService.SetTargetMode
		.Invoke({
			towerId = towerId,
			targetMode = targetMode,
		})
		:expect()

	if not success then
		warn("타겟 변경 실패.")
	end

	return success
end

function TowerClient._TowerTargetModeUpdated(data: { towerId: number, targetMode: string })
	local towerData = TowerClient.ActiveTowers[data.towerId]
	if not towerData then
		return
	end

	towerData.Target = data.targetMode
	if selectedTowerId == data.towerId then
		ClientSignals.TowerUpdated:Fire(data.towerId, towerData)
	end
end

function TowerClient._PassiveTriggered(data: { towerId: number, passiveType: string, arg: { [string]: any }? })
	local towerData = TowerClient.ActiveTowers[data.towerId]
	if not towerData then
		return
	end

	TowerRenderer.OnPassiveTriggered(data.towerId, data.passiveType, data.arg)
end

function TowerClient._OnAttackEnemy(data: { enemyId: number, towerId: number, attackSlot: number? })
	local towerData = TowerClient.ActiveTowers[data.towerId]
	local enemyModel = workspace.Enemies:FindFirstChild(`Enemy_{data.enemyId}`)

	if not towerData or not enemyModel then
		return
	end

	local attackVariant = nil
	local attackStats = towerData.Stats

	if data.attackSlot == 2 then
		attackStats = towerData.Stats.Secondary
		attackVariant = "Secondary"
	elseif data.attackSlot == 3 then
		attackStats = towerData.Stats.Tertiary
		attackVariant = "Tertiary"
	end

	TowerRenderer.OnAttack(data.towerId, enemyModel, attackStats, attackVariant)
end

function TowerClient._TowerUpdated(data: { towerId: number, towerLevel: number })
	local towerData = TowerClient.ActiveTowers[data.towerId]
	if not towerData then
		return
	end

	towerData.Level = data.towerLevel
	towerData.Stats = TableUtils.DeepCopy(TowerData.ByName[towerData.Name].Stats[data.towerLevel])

	TowerRenderer.UpgradeVisuals(data.towerLevel, data.towerId)
	if selectedTowerId == data.towerId then
		TowerRenderer.ToggleRangeIndicator(true, data.towerId, towerData)
	end

	ClientSignals.TowerUpdated:Fire(data.towerId, towerData)
end

function TowerClient._UpdateHoverState()
	local result = MouseRayCast()

	if result and result.Instance then
		local model = findTaggedAncestor(result.Instance)

		if model and CollectionService:HasTag(model, "Tower") then
			if model ~= hoveredTowerModel then
				if hoveredTowerModel then
					ClientSignals.TowerUnhovered:Fire()
				end
				hoveredTowerModel = model
				local towerId = model:GetAttribute("Id")
				local towerData = TowerClient.ActiveTowers[towerId]
				ClientSignals.TowerHovered:Fire(model, towerData)
			end
			return
		end
	end

	if hoveredTowerModel then
		hoveredTowerModel = nil
		ClientSignals.TowerUnhovered:Fire()
	end
end

return TowerClient
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="372">
                <Properties>
                  <string name="Name">TowerPlacement</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local MouseRayCast = require(ReplicatedStorage.Shared.Modules.Utils.MouseRayCast)
local CreateRangeIndicator = require(ReplicatedStorage.Shared.Services.Entities.TowerService.Utils.CreateRangeIndicator)
local PlaceValidator = require(ReplicatedStorage.Shared.Services.Entities.TowerService.Utils.PlaceValidator)
local AnimationService

local currentRotation = 0
local GROUND_VISUAL_OFFSET = 0.05

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function ToggleExistingBorders(isVisible)
	local placedBordersFolder = workspace.Visuals:FindFirstChild("Borders")

	if placedBordersFolder then
		for _, border in ipairs(placedBordersFolder:GetChildren()) do
			if border:FindFirstChild("SurfaceGui") then
				border.SurfaceGui.Enabled = isVisible
			end
		end
	end
end

-------------------------------------------------
--// TowerPlacement
-------------------------------------------------
local TowerPlacement = {}
TowerPlacement.__index = TowerPlacement

function TowerPlacement.Init(services, getTowerCountFunc: (towerName: string) -> number)
	AnimationService = services:GetService("AnimationService")
	TowerPlacement.GetCountTower = getTowerCountFunc
end

function TowerPlacement.new(towerName: string, towerKey: string?)
	local self = setmetatable({}, TowerPlacement)

	self.TowerName = towerName
	self.TowerKey = towerKey
	self.Config = TowerData.ByName[towerName]
	self.Stats = self.Config.Stats[0]
	self.Model = nil
	self.Rotation = currentRotation
	self.RangeIndicator = nil
	self.IsActive = false
	self.HeightOffset = 0
	self.LastTargetPosition = nil

	return self
end

function TowerPlacement:Start()
	local asset = ReplicatedStorage.Assets.Towers:FindFirstChild(self.TowerName)
	if not asset then
		warn(`{self.TowerName}을 가진 모델이 존재하지 않음.`)
		return
	end

	self.Model = asset:Clone()
	self.Model.Parent = workspace.CurrentCamera
	CharacterUtils.SetCollisionGroup(self.Model, "Tower", function(part)
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end)

	AnimationService.Load(self.Model, self.TowerName)
	AnimationService.Play(self.Model, "Idle", 0, 0)

	self.IsActive = true

	self.BorderRadius = self.Model.PrimaryPart.Size.X * 1.5
	self.HeightOffset = CharacterUtils.GetHipHeight(self.Model)

	self:_CreateVisuals()

	ToggleExistingBorders(true)
end

function TowerPlacement:Update()
	if not self.IsActive or not self.Model then
		return
	end

	local result = MouseRayCast(true)
	if not result or not result.Position then
		return
	end

	local targetPos = result.Position
	self.LastTargetPosition = targetPos

	local finalCFrame = CFrame.new(targetPos + Vector3.new(0, self.HeightOffset, 0))
		* CFrame.Angles(0, math.rad(self.Rotation), 0)

	self.Model:PivotTo(finalCFrame)

	if self.Border then
		self.Border.Position = targetPos + Vector3.new(0, GROUND_VISUAL_OFFSET, 0)
	end
	if self.RangeIndicator then
		self.RangeIndicator:UpdateRange(
			self.Model:GetPivot() - Vector3.new(0, self.HeightOffset, 0),
			nil,
			self.Model:GetPivot().Position
		)
	end

	self:_CheckValidation(targetPos)
end

function TowerPlacement:Rotate()
	if not self.IsActive then
		return
	end
	local rotateAngle = (self.Rotation + 90) % 360

	self.Rotation = rotateAngle
	currentRotation = rotateAngle
end

function TowerPlacement:Destroy()
	self.IsActive = false

	if self.Model then
		self.Model:Destroy()
	end
	if self.Border then
		self.Border:Destroy()
	end
	if self.RangeIndicator then
		self.RangeIndicator:Destroy()
	end

	self.Model = nil
	self.Highlight = nil
	self.Border = nil
	self.RangeIndicator = nil

	ToggleExistingBorders(false)
end

function TowerPlacement:GetPlacementData()
	if not self.Model then
		return nil
	end

	local result = MouseRayCast(true)
	local spawnPosition = if result and result.Position then result.Position else self.LastTargetPosition

	if not spawnPosition then
		return nil
	end

	return {
		TowerName = self.TowerName,
		Position = spawnPosition,
		Rotation = self.Rotation,
		BorderRadius = self.Model.PrimaryPart.Size.X * 1.5,
	}
end

function TowerPlacement:_CreateVisuals()
	self.Highlight = Instance.new("Highlight")
	self.Highlight.Parent = self.Model

	self.Border = ReplicatedStorage.Assets.Visuals.Border:Clone()
	self.Border.Size = Vector3.new(0.001, self.BorderRadius * 2.5, self.BorderRadius * 2.5)
	self.Border.Position = Vector3.new(0, GROUND_VISUAL_OFFSET, 0)
	self.Border.Parent = workspace.Visuals.Borders

	self.RangeIndicator = CreateRangeIndicator.newRange(
		self.Stats.Range,
		self.Model:GetPivot() - Vector3.new(0, self.HeightOffset, 0),
		self.Stats,
		self.Model:GetPivot().Position
	)
end

function TowerPlacement:_CheckValidation(targetPos)
	local checkData = {
		["TowerName"] = self.TowerName,
		["SpawnPosition"] = targetPos,
		["BorderRadius"] = self.BorderRadius,
		["CurrentCount"] = TowerPlacement.GetCountTower(self.TowerName),
	}

	local canSpawn = PlaceValidator.CheckSpawn(checkData, true)

	local mainColor = canSpawn and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
	local subColor = canSpawn and Color3.new(1, 1, 1) or Color3.new(1, 0.2, 0.2)

	if self.Highlight then
		self.Highlight.FillColor = mainColor
	end
	if self.Border then
		self.Border.SurfaceGui.ImageLabel.ImageColor3 = subColor
		self.Border.SurfaceGui.ImageLabel.UIStroke.Color = subColor
	end

	if self.RangeIndicator then
		self.RangeIndicator:SetColor(subColor)
	end
end

return TowerPlacement
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="373">
                <Properties>
                  <string name="Name">TowerRenderer</string>
                  <string name="Source"><![CDATA[--/ Services
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/ Modules
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local CreateRangeIndicator = require(ReplicatedStorage.Shared.Services.Entities.TowerService.Utils.CreateRangeIndicator)
local TimeService
local AnimationService
local VisualService

local GROUND_VISUAL_OFFSET = 0.05

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function SetAccessoryVisible(accessory, visible: boolean)
	local applyTrans = visible and 0 or 1
	local noDisplay = accessory:GetAttribute("NoDisplay")

	if accessory:IsA("BasePart") and not noDisplay then
		accessory.Transparency = applyTrans
	end
	if accessory:IsA("ParticleEmitter") and not noDisplay then
		accessory.Enabled = visible
	end

	for _, part in accessory:GetDescendants() do
		local partNoDisplay = part:GetAttribute("NoDisplay")
		if part:IsA("BasePart") and not partNoDisplay then
			part.Transparency = applyTrans
		end
		if part:IsA("ParticleEmitter") and not partNoDisplay then
			part.Enabled = visible
		end
	end
end

local function ResolveAttackSet(towerModel: Model, attackVariant: string?, towerLevel: number): (boolean, number?)
	local variant = attackVariant or ""
	local comboName = `{variant}AttackCombo1`
	local attackName = `{variant}Attack`

	for level = towerLevel, 0, -1 do
		if AnimationService.GetExactTrack(towerModel, comboName, level) then
			return true, level
		end

		if AnimationService.GetExactTrack(towerModel, attackName, level) then
			return false, level
		end
	end

	return AnimationService.GetExactTrack(towerModel, comboName) ~= nil, nil
end

local function GetMaxCombo(renderData, towerModel, attackVariant: string?, stats, comboLevel: number?): number
	local maxComboKey = `MaxCombo_{attackVariant or "Default"}`
	local maxCombo = renderData[maxComboKey]
	if not maxCombo then
		maxCombo = stats.ComboCount
		if not maxCombo then
			maxCombo = 0
			while true do
				local checkName = `{attackVariant or ""}AttackCombo{maxCombo + 1}`
				if AnimationService.GetExactTrack(towerModel, checkName, comboLevel) then
					maxCombo += 1
				else
					break
				end
			end
			maxCombo = math.max(1, maxCombo)
		end
		renderData[maxComboKey] = maxCombo
	end
	return maxCombo
end

local function ResolveHitRangeStats(stats, hit)
	return {
		AttackType = hit.AttackType or stats.AttackType,
		Range = hit.Range or stats.Range,
		SplashRange = hit.SplashRange or stats.SplashRange,
		Angle = hit.Angle or stats.Angle,
		Width = hit.Width or stats.Width,
	}
end

local function HasSameRangeShape(previous, current): boolean
	if not previous or not current then
		return previous == current
	end

	return previous.AttackType == current.AttackType
		and previous.Range == current.Range
		and previous.SplashRange == current.SplashRange
		and previous.Angle == current.Angle
		and previous.Width == current.Width
		and HasSameRangeShape(previous.Secondary, current.Secondary)
end

-------------------------------------------------
--// TowerRenderer
-------------------------------------------------
local TowerRenderer = {}
TowerRenderer.RenderStates = {}
TowerRenderer.PlacedBorders = {}
TowerRenderer.TrackingTowers = {}
TowerRenderer.SelectionHighlight = nil
TowerRenderer.CurrentRange = nil
TowerRenderer.CurrentRangeTowerId = nil
TowerRenderer.CurrentRangeStats = nil

function TowerRenderer.Init(services)
	AnimationService = services:GetService("AnimationService")
	VisualService = services:GetService("VisualService")
	TimeService = services:GetService("TimeService")
end

function TowerRenderer.Start()
	RunService.PreRender:Connect(function(dt)
		if next(TowerRenderer.TrackingTowers) == nil and not TowerRenderer.CurrentRange then
			return
		end

		for towerId, data in pairs(TowerRenderer.TrackingTowers) do
			data.RemainingTime -= dt * TimeService:GetGameSpeed()

			if
				data.RemainingTime <= 0
				or not data.TowerModel.Parent
				or not data.TargetPart.Parent
				or data.TargetPart:GetAttribute("Dead")
			then
				TowerRenderer.TrackingTowers[towerId] = nil
				continue
			end

			TowerRenderer.LookAt(data.TowerModel, data.TargetPart.Position)
		end

		if TowerRenderer.CurrentRange and TowerRenderer.CurrentRangeTowerId then
			local towerId = TowerRenderer.CurrentRangeTowerId
			local targetTower = TowerRenderer.RenderStates[towerId]
			if targetTower then
				local trackingData = TowerRenderer.TrackingTowers[towerId]
				local targetPos = trackingData and trackingData.TargetPart and trackingData.TargetPart.Position

				local offset = CharacterUtils.GetHipHeight(targetTower.Model)
				local towerCenter = targetTower.Model:GetPivot().Position
				TowerRenderer.CurrentRange:UpdateRange(
					targetTower.Model:GetPivot() - Vector3.new(0, offset, 0),
					targetPos,
					towerCenter
				)
			end
		end
	end)
end

function TowerRenderer.Setup(towerId: number, towerModel: Model, towerName: string, borderData)
	towerModel:SetAttribute("Id", towerId)
	towerModel:SetAttribute("TowerName", towerName)
	CollectionService:AddTag(towerModel, "Tower")

	CharacterUtils.SetCollisionGroup(towerModel, "Tower", function(part)
		part.CanCollide = false
		part.CanTouch = false
	end)
	towerModel.Parent = workspace.Towers

	AnimationService.Load(towerModel, towerName)

	if AnimationService.GetTrack(towerModel, "OnSpawn") then
		AnimationService.PlayOnce(towerModel, "OnSpawn", { Resume = "Idle" })
	else
		AnimationService.Play(towerModel, "Idle", 0, 0)
	end

	local towerInfo = TowerData.ByName[towerName]
	local towerRarity = towerInfo and towerInfo.Rarity
	if towerRarity then
		VisualService.Play("TowerShared", `Place_{towerRarity}`, nil, towerModel)
	end

	TowerRenderer.RenderStates[towerId] = {
		Accessories = {},
		RangeIndicator = nil,
		Model = towerModel,
		Name = towerName,
		Level = 0,
	}

	TowerRenderer.ApplyAppearence(0, towerId)
	TowerRenderer.AddBorder(towerId, borderData)

	if VisualService then
		VisualService.Play(towerName, "OnSpawn", 0, towerModel, towerModel)
	end
end

function TowerRenderer.UpgradeVisuals(towerLevel: number, towerId: number)
	local targetTower = TowerRenderer.RenderStates[towerId]
	if not targetTower then
		return
	end

	local towerInfo = TowerData.ByName[targetTower.Name]
	local towerRarity = towerInfo and towerInfo.Rarity
	if towerRarity then
		VisualService.Play("TowerShared", `Upgrade_{towerRarity}`, nil, targetTower.Model)
	end

	TowerRenderer.ApplyAppearence(towerLevel, towerId)
end

function TowerRenderer.SellVisuals(towerId: number)
	local targetTower = TowerRenderer.RenderStates[towerId]
	if not targetTower then
		return
	end

	VisualService.Play("TowerShared", `Sell`, nil, targetTower.Model)
end

function TowerRenderer.ApplyAppearence(towerLevel: number, towerId: number)
	local targetTower = TowerRenderer.RenderStates[towerId]
	if not targetTower then
		return
	end

	targetTower.Level = towerLevel
	targetTower.AttackRangeStats = {}

	for key in pairs(targetTower) do
		if string.match(key, "^MaxCombo_") or string.match(key, "^ComboIndex_") then
			targetTower[key] = nil
		end
	end
	local levelFolder = targetTower.Model:WaitForChild("Upgrades"):FindFirstChild(tostring(towerLevel))
	if not levelFolder then
		warn(`{towerLevel}레벨에 해당하는 외형이 존재하지 않음.`)
		return
	end

	local removeTargets = levelFolder:GetAttribute("Remove")
	if removeTargets then
		for targetName in string.gmatch(removeTargets, "[^,]+") do
			targetName = targetName:match("^%s*(.-)%s*$")
			if targetName == "" then
				continue
			end

			local targetAccessory = targetTower.Accessories[targetName]
			if targetAccessory then
				SetAccessoryVisible(targetAccessory, false)
			end
		end
	end

	for _, newAccessory in ipairs(levelFolder:GetChildren()) do
		SetAccessoryVisible(newAccessory, true)
		targetTower.Accessories[newAccessory.Name] = newAccessory
	end
end

function TowerRenderer.ToggleRangeIndicator(action: boolean, towerId: number?, towerData)
	local targetTower = TowerRenderer.RenderStates[towerId]

	if TowerRenderer.CurrentRange then
		TowerRenderer.CurrentRange:Destroy()
		TowerRenderer.CurrentRange = nil
	end
	TowerRenderer.CurrentRangeTowerId = nil
	TowerRenderer.CurrentRangeStats = nil

	if TowerRenderer.SelectionHighlight then
		TowerRenderer.SelectionHighlight.Adornee = nil
	end

	if action == false or not targetTower or not towerData then
		return
	end

	if not TowerRenderer.SelectionHighlight then
		TowerRenderer.SelectionHighlight = Instance.new("Highlight")
		TowerRenderer.SelectionHighlight.Name = "TowerSelectionHighlight"
		TowerRenderer.SelectionHighlight.FillTransparency = 0.8
		TowerRenderer.SelectionHighlight.OutlineTransparency = 0.2
		TowerRenderer.SelectionHighlight.FillColor = Color3.fromRGB(255, 255, 255)
		TowerRenderer.SelectionHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		TowerRenderer.SelectionHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		TowerRenderer.SelectionHighlight.Parent = workspace:FindFirstChild("Visuals") or workspace
	end

	if targetTower and targetTower.Model then
		TowerRenderer.SelectionHighlight.Adornee = targetTower.Model
	end

	TowerRenderer.CurrentRangeTowerId = towerId
	TowerRenderer.CurrentRangeStats = towerData.Stats
	TowerRenderer.RefreshRangeIndicator()
end

function TowerRenderer.RefreshRangeIndicator()
	local towerId = TowerRenderer.CurrentRangeTowerId
	local targetTower = TowerRenderer.RenderStates[towerId]
	local baseStats = TowerRenderer.CurrentRangeStats
	if not targetTower or not baseStats then
		return
	end

	local attackRangeStats = targetTower.AttackRangeStats
	local stats = table.clone(attackRangeStats.Default or baseStats)
	stats.Secondary = attackRangeStats.Secondary or baseStats.Secondary

	local previousRange = TowerRenderer.CurrentRange
	if previousRange and HasSameRangeShape(previousRange.TowerStats, stats) then
		return
	end

	local lastSplashPosition = previousRange and previousRange.LastSplashPosition
	local previousSecondary = previousRange and previousRange.SecondaryIndicator
	local lastSecondarySplashPosition = previousSecondary and previousSecondary.LastSplashPosition
	if previousRange then
		previousRange:Destroy()
	end

	local pivot = targetTower.Model:GetPivot()
	local offset = CharacterUtils.GetHipHeight(targetTower.Model)
	local groundPivot = pivot - Vector3.new(0, offset, 0)
	local range = CreateRangeIndicator.newRange(stats.Range, groundPivot, stats, pivot.Position)
	TowerRenderer.CurrentRange = range
	if range then
		range.LastSplashPosition = lastSplashPosition
		if range.SecondaryIndicator then
			range.SecondaryIndicator.LastSplashPosition = lastSecondarySplashPosition
		end

		local trackingData = TowerRenderer.TrackingTowers[towerId]
		local targetPos = trackingData and trackingData.TargetPart and trackingData.TargetPart.Position
		range:SetColor(Color3.new(1, 1, 1))
		range:UpdateRange(groundPivot, targetPos, pivot.Position)
	end
end

function TowerRenderer.AddBorder(towerId: number, borderData)
	local targetTower = TowerRenderer.RenderStates[towerId]

	local border = ReplicatedStorage.Assets.Visuals.Border:Clone()
	border.Name = "Border_" .. tostring(towerId)
	border.Size = Vector3.new(0.001, borderData.r * 2.5, borderData.r * 2.5)

	local offset = CharacterUtils.GetHipHeight(targetTower.Model) - GROUND_VISUAL_OFFSET
	border.Position = Vector3.new(borderData.x, targetTower.Model:GetPivot().Y - offset, borderData.z)

	border.Parent = workspace.Visuals.Borders

	if border:FindFirstChild("SurfaceGui") then
		border.SurfaceGui.ImageLabel.BackgroundColor3 = Color3.new(1, 0.2, 0.2)
		border.SurfaceGui.ImageLabel.BackgroundTransparency = 0.8
		border.SurfaceGui.ImageLabel.ImageTransparency = 1
		border.SurfaceGui.ImageLabel.UIStroke.Color = Color3.new(1, 0.2, 0.2)
		border.SurfaceGui.Enabled = false
	end

	TowerRenderer.PlacedBorders[towerId] = border
end

function TowerRenderer.LookAt(towerModel: Model, targetPosition: Vector3)
	if not towerModel or not targetPosition then
		return
	end

	local towerPivot = towerModel:GetPivot()
	local lookTarget = Vector3.new(targetPosition.X, towerPivot.Position.Y, targetPosition.Z)

	towerModel:PivotTo(CFrame.lookAt(towerPivot.Position, lookTarget))
end

function TowerRenderer.OnPassiveTriggered(towerId: number, passiveType: string, arg: { [string]: any }?)
	local targetTower = TowerRenderer.RenderStates[towerId]
	if not targetTower then
		return
	end

	local towerModel = targetTower.Model
	local eventName = `Passive{passiveType}`
	local targetModel = if typeof(arg) == "table" and arg.EnemyId
		then workspace.Enemies:FindFirstChild(`Enemy_{arg.EnemyId}`)
		else nil

	VisualService.Play(targetTower.Name, eventName, targetTower.Level, towerModel, targetModel)
end

function TowerRenderer.OnAttack(towerId: number, enemyModel: Model, stats, attackVariant: string?)
	local renderData = TowerRenderer.RenderStates[towerId]
	if not (renderData and enemyModel and enemyModel.PrimaryPart) then
		return
	end

	local towerModel = renderData.Model
	local targetPart = enemyModel.PrimaryPart
	local hits = stats.Hits
	local hasHitConfig = hits and #hits > 0
	local attackEndDelay = stats.AttackDelay or 0

	if hasHitConfig then
		attackEndDelay = 0
		for _, hit in hits do
			attackEndDelay = math.max(attackEndDelay, hit.Delay or 0)
		end
	end

	local variant = attackVariant or ""
	local rangeKey = attackVariant or "Default"
	local attackRangeStats = renderData.AttackRangeStats
	local function updateAttackRange(rangeStats)
		-- Ignore hits queued before an upgrade or removal; selection changes keep the current hit.
		if
			TowerRenderer.RenderStates[towerId] ~= renderData
			or renderData.AttackRangeStats ~= attackRangeStats
			or not towerModel.Parent
		then
			return
		end

		attackRangeStats[rangeKey] = rangeStats
		if TowerRenderer.CurrentRangeTowerId == towerId then
			TowerRenderer.RefreshRangeIndicator()
		end
	end

	-- Keep the last hit visible during cooldown, then restore the base shape for the next windup.
	updateAttackRange(stats)

	local usesCombo, comboLevel = ResolveAttackSet(towerModel, attackVariant, renderData.Level)
	local animName = `{variant}Attack`
	local comboIndex: number?
	local comboIndexKey = `ComboIndex_{attackVariant or "Default"}`

	if usesCombo then
		local maxCombo = GetMaxCombo(renderData, towerModel, attackVariant, stats, comboLevel)
		comboIndex = (renderData[comboIndexKey] or 0) % maxCombo + 1
		renderData[comboIndexKey] = comboIndex
		animName = `{variant}AttackCombo{comboIndex}`
	else
		renderData[comboIndexKey] = nil
	end

	AnimationService.PlayOnce(towerModel, animName, {
		Level = renderData.Level,
		Resume = "Idle",
	})

	local comboEventPrefix = if comboIndex then `{variant}AttackCombo{comboIndex}` else nil
	local function playAttackVisual(eventSuffix: string, range: number?, delay: number?)
		local fallbackEventName = `{variant}Attack{eventSuffix}`
		local eventName = if comboEventPrefix then `{comboEventPrefix}{eventSuffix}` else fallbackEventName

		VisualService.Play(
			renderData.Name,
			eventName,
			renderData.Level,
			towerModel,
			enemyModel,
			range,
			delay,
			if comboEventPrefix then fallbackEventName else nil
		)
	end

	playAttackVisual("Start", stats.Range)

	if hasHitConfig then
		for hitIndex, hit in hits do
			local hitDelay = hit.Delay or 0
			local visualDelay = if hitDelay > 0 then hitDelay else nil
			local hitRange = hit.Range or stats.Range
			local hitRangeStats = ResolveHitRangeStats(stats, hit)
			if hitDelay > 0 then
				TimeService.DeltaDelay(hitDelay):andThen(function()
					updateAttackRange(hitRangeStats)
				end)
			else
				updateAttackRange(hitRangeStats)
			end

			playAttackVisual("Hit", hitRange, visualDelay)
			playAttackVisual(`Hit{hitIndex}`, hitRange, visualDelay)
		end
	end

	playAttackVisual("End", stats.Range, if attackEndDelay > 0 then attackEndDelay else nil)

	if not targetPart:GetAttribute("Dead") then
		TowerRenderer.LookAt(towerModel, targetPart.Position)
		TowerRenderer.TrackingTowers[towerId] = {
			TowerModel = towerModel,
			TargetPart = targetPart,
			RemainingTime = attackEndDelay,
		}
	end
end

function TowerRenderer.Cleanup(towerId: number)
	local renderData = TowerRenderer.RenderStates[towerId]
	AnimationService.Clear(renderData.Model)

	if renderData and renderData.Model then
		renderData.Model:Destroy()
	end

	if TowerRenderer.PlacedBorders[towerId] then
		TowerRenderer.PlacedBorders[towerId]:Destroy()
		TowerRenderer.PlacedBorders[towerId] = nil
	end
	if TowerRenderer.CurrentRangeTowerId == towerId then
		TowerRenderer.ToggleRangeIndicator(false)
	end

	TowerRenderer.RenderStates[towerId] = nil
	TowerRenderer.TrackingTowers[towerId] = nil
end

return TowerRenderer
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="Folder" referent="374">
              <Properties>
                <string name="Name">Utils</string>
              </Properties>
              <Item class="ModuleScript" referent="375">
                <Properties>
                  <string name="Name">CreateRangeIndicator</string>
                  <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local ObjectCache = require(ReplicatedStorage.Packages.ObjectCache)

--/Folder
local Caches = workspace:WaitForChild("Caches")

--/Templates
local IndicatorPartTemplate =
	ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Visuals"):WaitForChild("IndicatorPart")
local SplashTemplate = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Visuals"):WaitForChild("Splash")

local CONSTANTS = {
	STORAGE_SIZE = 200,
	GROUND_OFFSET = 0.05,

	LINE_WIDTH = 0.2,

	CYLINDER_COLOR = Color3.fromRGB(255, 255, 255),
	CYLINDER_TRANSPARENCY = 0,

	BEAM_TEXTURE = "rbxassetid://118670921452598",
	BEAM_COLOR = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
	BEAM_WIDTH = 6,
	BEAM_TRANSPARENCY = NumberSequence.new(0.5),
	BEAM_LIGHT_EMISSION = 1,
	BEAM_TEXTURE_LENGTH = 5,
	BEAM_TEXTURE_SPEED = 2,

	CURVE_TANGENT_ANGLE = math.rad(30),
	CURVE_DISTANCE_RATIO = 0.3,
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function projectToGround(pos: Vector3 | CFrame): CFrame
	if typeof(pos) == "Vector3" then
		return CFrame.new(pos + Vector3.new(0, CONSTANTS.GROUND_OFFSET, 0))
	else
		return pos + Vector3.new(0, CONSTANTS.GROUND_OFFSET, 0)
	end
end

local function getCorrectedWidthLength(radius: number, halfWidth: number): number
	return math.sqrt(math.max(0, radius ^ 2 - halfWidth ^ 2))
end

local function getAngleCFrames(center: CFrame, radius: number, angle: number): (CFrame, CFrame)
	local angleOffset = math.rad(angle / 2)
	local left = center * CFrame.Angles(0, -angleOffset, 0) * CFrame.new(0, 0, -radius / 2)
	local right = center * CFrame.Angles(0, angleOffset, 0) * CFrame.new(0, 0, -radius / 2)
	return left, right
end

local function getWidthCFrames(center: CFrame, halfWidth: number, correctedLength: number): (CFrame, CFrame)
	local left = center * CFrame.new(-halfWidth, 0, -correctedLength / 2)
	local right = center * CFrame.new(halfWidth, 0, -correctedLength / 2)
	return left, right
end

local function setPartVisible(part: BasePart, visible: boolean)
	part.Transparency = visible and IndicatorPartTemplate.Transparency or 1

	local surfaceGui = part:FindFirstChildOfClass("SurfaceGui")
	if surfaceGui then
		surfaceGui.Enabled = visible
	end
end

local function updateBezierBeam(
	beam: Beam,
	att0: Attachment,
	att1: Attachment,
	towerPos: Vector3,
	targetPos: Vector3,
	dist: number
)
	if dist > 0.1 then
		att0.WorldCFrame = CFrame.lookAt(towerPos, targetPos)
			* CFrame.Angles(0, 0, math.rad(90))
			* CFrame.Angles(0, CONSTANTS.CURVE_TANGENT_ANGLE, 0)
		att1.WorldCFrame = CFrame.lookAt(targetPos, towerPos)
			* CFrame.Angles(0, 0, math.rad(-90))
			* CFrame.Angles(0, -CONSTANTS.CURVE_TANGENT_ANGLE, 0)

		beam.CurveSize0 = dist * CONSTANTS.CURVE_DISTANCE_RATIO
		beam.CurveSize1 = dist * CONSTANTS.CURVE_DISTANCE_RATIO
	else
		att0.WorldPosition = towerPos
		att1.WorldPosition = targetPos
		beam.CurveSize0 = 0
		beam.CurveSize1 = 0
	end
end

-------------------------------------------------
--// CreateRangeIndicator
-------------------------------------------------
local CreateRangeIndicator = {}
CreateRangeIndicator.__index = CreateRangeIndicator

local activeRanges = {}
local PartStorage
local currentStorageSize = CONSTANTS.STORAGE_SIZE

function CreateRangeIndicator.newRange(
	radius: number?,
	centerPosition: Vector3 | CFrame,
	towerStats: { [string]: any }?,
	towerCenterPosition: Vector3?
)
	if typeof(radius) ~= "number" or radius <= 0 then
		return nil
	end

	if not PartStorage then
		CreateRangeIndicator.Init()
	end

	local projectedCenter = projectToGround(centerPosition)

	local segmentLength = IndicatorPartTemplate.Size.X * 2
	local circumference = 2 * math.pi * radius
	local numberOfParts = math.max(1, math.floor(circumference / segmentLength))
	local angleStep = 360 / numberOfParts

	local totalActiveParts = 0
	for _, rangeData in pairs(activeRanges) do
		totalActiveParts += #rangeData.Parts
	end

	if numberOfParts + totalActiveParts > currentStorageSize then
		local amountToExpand = (numberOfParts + totalActiveParts) - currentStorageSize
		PartStorage:ExpandCache(amountToExpand)
		currentStorageSize = totalActiveParts + numberOfParts
	end

	local self = setmetatable({}, CreateRangeIndicator)
	self.Parts = {}
	self.BoundaryParts = {}
	self.CenterPosition = projectedCenter
	self.Radius = radius
	self.TowerStats = towerStats
	self.LastSplashPosition = nil
	self.SplashCylinder = nil
	self.SplashAttachment0 = nil
	self.SplashAttachment1 = nil
	self.SplashBeam = nil

	for i = 1, numberOfParts do
		local angle = math.rad(i * angleStep)
		local partCFrame = CFrame.new(projectedCenter.Position) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)

		local newPart = PartStorage:GetPart(partCFrame)
		newPart.Anchored = true
		newPart.CanCollide = false
		newPart.CanQuery = false
		newPart.CanTouch = false
		setPartVisible(newPart, true)

		table.insert(self.Parts, newPart)
	end

	if towerStats then
		local visualsFolder = workspace:FindFirstChild("Visuals") or Instance.new("Folder")
		if not visualsFolder.Parent then
			visualsFolder.Name = "Visuals"
			visualsFolder.Parent = workspace
		end

		local function spawnBoundaryPart(cframe: CFrame, size: Vector3)
			local newPart = IndicatorPartTemplate:Clone()
			newPart.Size = size
			newPart.CFrame = cframe
			newPart.Anchored = true
			newPart.CanCollide = false
			newPart.CanQuery = false
			newPart.CanTouch = false
			newPart.Parent = visualsFolder
			table.insert(self.BoundaryParts, newPart)
		end

		local lineHeight = IndicatorPartTemplate.Size.Y

		if towerStats.AttackType == "Angle" and towerStats.Angle and towerStats.Angle > 0 then
			local size = Vector3.new(CONSTANTS.LINE_WIDTH, lineHeight, radius)
			local leftCF, rightCF = getAngleCFrames(projectedCenter, radius, towerStats.Angle)
			spawnBoundaryPart(leftCF, size)
			spawnBoundaryPart(rightCF, size)
		elseif towerStats.AttackType == "Line" and towerStats.Width and towerStats.Width > 0 then
			local halfWidth = towerStats.Width / 2
			local correctedLength = getCorrectedWidthLength(radius, halfWidth)
			local size = Vector3.new(CONSTANTS.LINE_WIDTH, lineHeight, correctedLength)

			local leftCF, rightCF = getWidthCFrames(projectedCenter, halfWidth, correctedLength)
			spawnBoundaryPart(leftCF, size)
			spawnBoundaryPart(rightCF, size)
		end

		if towerStats.AttackType == "Splash" and towerStats.SplashRange and towerStats.SplashRange > 0 then
			local splashRange = towerStats.SplashRange

			local cylinder = SplashTemplate:Clone()
			cylinder.Name = "SplashCylinder"
			cylinder.Size = Vector3.new(0.05, splashRange * 2, splashRange * 2)
			cylinder.Transparency = 1
			cylinder.Anchored = true
			cylinder.CanCollide = false
			cylinder.CanQuery = false
			cylinder.CanTouch = false

			local surfaceGui = cylinder:FindFirstChildOfClass("SurfaceGui")
			if surfaceGui then
				surfaceGui.Enabled = true
				local imageLabel = surfaceGui:FindFirstChildOfClass("ImageLabel")
				if imageLabel then
					imageLabel.ImageColor3 = CONSTANTS.CYLINDER_COLOR
					imageLabel.ImageTransparency = CONSTANTS.CYLINDER_TRANSPARENCY
					local uiStroke = imageLabel:FindFirstChildOfClass("UIStroke")
					if uiStroke then
						uiStroke.Color = CONSTANTS.CYLINDER_COLOR
						uiStroke.Transparency = CONSTANTS.CYLINDER_TRANSPARENCY
					end
				end
			end

			cylinder.CFrame = projectedCenter * CFrame.Angles(0, 0, math.rad(90))
			cylinder.Parent = visualsFolder
			self.SplashCylinder = cylinder

			local att0 = Instance.new("Attachment")
			att0.Name = "SplashBeamAtt0"
			att0.WorldPosition = towerCenterPosition or (projectedCenter.Position + Vector3.new(0, 2, 0))
			att0.Parent = workspace.Terrain
			self.SplashAttachment0 = att0

			local att1 = Instance.new("Attachment")
			att1.Name = "SplashBeamAtt1"
			att1.Parent = cylinder
			self.SplashAttachment1 = att1

			local beam = Instance.new("Beam")
			beam.Name = "SplashBeam"
			beam.Segments = 30
			beam.Attachment0 = att0
			beam.Attachment1 = att1
			beam.Color = CONSTANTS.BEAM_COLOR
			beam.Width0 = CONSTANTS.BEAM_WIDTH
			beam.Width1 = CONSTANTS.BEAM_WIDTH
			beam.FaceCamera = false
			beam.Transparency = CONSTANTS.BEAM_TRANSPARENCY
			beam.Brightness = 3
			beam.LightEmission = CONSTANTS.BEAM_LIGHT_EMISSION
			beam.LightInfluence = 0
			beam.Texture = CONSTANTS.BEAM_TEXTURE
			beam.TextureMode = Enum.TextureMode.Wrap
			beam.TextureLength = CONSTANTS.BEAM_TEXTURE_LENGTH
			beam.TextureSpeed = CONSTANTS.BEAM_TEXTURE_SPEED
			beam.Enabled = true
			beam.Parent = cylinder
			self.SplashBeam = beam
		end
	end

	if
		towerStats
		and towerStats.Secondary
		and typeof(towerStats.Secondary) == "table"
		and towerStats.Secondary.Range
	then
		self.SecondaryIndicator = CreateRangeIndicator.newRange(
			towerStats.Secondary.Range,
			centerPosition,
			towerStats.Secondary,
			towerCenterPosition
		)
		if self.SecondaryIndicator then
			self.SecondaryIndicator:SetColor(Color3.fromRGB(0, 170, 255))
		end
	end

	table.insert(activeRanges, self)
	return self
end

function CreateRangeIndicator:Destroy()
	if self.SecondaryIndicator then
		self.SecondaryIndicator:Destroy()
		self.SecondaryIndicator = nil
	end

	for _, part in ipairs(self.Parts) do
		setPartVisible(part, false)
		PartStorage:ReturnPart(part)
	end
	self.Parts = {}

	if self.BoundaryParts then
		for _, part in ipairs(self.BoundaryParts) do
			part:Destroy()
		end
		self.BoundaryParts = {}
	end

	if self.SplashCylinder then
		self.SplashCylinder:Destroy()
		self.SplashCylinder = nil
	end

	if self.SplashAttachment0 then
		self.SplashAttachment0:Destroy()
		self.SplashAttachment0 = nil
	end

	local index = table.find(activeRanges, self)
	if index then
		table.remove(activeRanges, index)
	end
end

function CreateRangeIndicator:UpdateRange(
	newCenterPosition: Vector3 | CFrame,
	targetPosition: Vector3?,
	towerCenterPosition: Vector3?
)
	if self.SecondaryIndicator then
		self.SecondaryIndicator:UpdateRange(newCenterPosition, targetPosition, towerCenterPosition)
	end

	local projectedCenter = projectToGround(newCenterPosition)
	self.CenterPosition = projectedCenter

	local radius = self.Radius
	local numberOfParts = #self.Parts
	local angleStep = 360 / numberOfParts

	local unrotatedCenter = CFrame.new(projectedCenter.Position)
	for i, part in ipairs(self.Parts) do
		local angle = math.rad(i * angleStep)
		part.CFrame = unrotatedCenter * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -radius)
	end

	local towerStats = self.TowerStats
	if towerStats and self.BoundaryParts and #self.BoundaryParts > 0 then
		local lineHeight = IndicatorPartTemplate.Size.Y

		if towerStats.AttackType == "Angle" and towerStats.Angle and towerStats.Angle > 0 then
			local size = Vector3.new(CONSTANTS.LINE_WIDTH, lineHeight, radius)
			local leftCF, rightCF = getAngleCFrames(projectedCenter, radius, towerStats.Angle)

			if self.BoundaryParts[1] then
				self.BoundaryParts[1].Size = size
				self.BoundaryParts[1].CFrame = leftCF
			end
			if self.BoundaryParts[2] then
				self.BoundaryParts[2].Size = size
				self.BoundaryParts[2].CFrame = rightCF
			end
		elseif towerStats.AttackType == "Line" and towerStats.Width and towerStats.Width > 0 then
			local halfWidth = towerStats.Width / 2
			local correctedLength = getCorrectedWidthLength(radius, halfWidth)
			local size = Vector3.new(CONSTANTS.LINE_WIDTH, lineHeight, correctedLength)
			local leftCF, rightCF = getWidthCFrames(projectedCenter, halfWidth, correctedLength)

			if self.BoundaryParts[1] then
				self.BoundaryParts[1].Size = size
				self.BoundaryParts[1].CFrame = leftCF
			end
			if self.BoundaryParts[2] then
				self.BoundaryParts[2].Size = size
				self.BoundaryParts[2].CFrame = rightCF
			end
		end
	end

	if self.SplashCylinder then
		local groundY = projectedCenter.Position.Y
		local finalTargetPos: Vector3

		if targetPosition then
			finalTargetPos = Vector3.new(targetPosition.X, groundY, targetPosition.Z)
			self.LastSplashPosition = finalTargetPos
		else
			finalTargetPos = self.LastSplashPosition or projectedCenter.Position
		end

		self.SplashCylinder.CFrame = CFrame.new(finalTargetPos) * CFrame.Angles(0, 0, math.rad(90))

		if self.SplashAttachment0 and self.SplashAttachment1 then
			local towerPos = towerCenterPosition or (projectedCenter.Position + Vector3.new(0, 2, 0))
			local dist = (finalTargetPos - towerPos).Magnitude
			updateBezierBeam(
				self.SplashBeam,
				self.SplashAttachment0,
				self.SplashAttachment1,
				towerPos,
				finalTargetPos,
				dist
			)
		end
	end
end

function CreateRangeIndicator:SetColor(color: Color3)
	for _, part in ipairs(self.Parts) do
		part.SurfaceGui.Frame.BackgroundColor3 = color
	end
	if self.BoundaryParts then
		for _, part in ipairs(self.BoundaryParts) do
			part.SurfaceGui.Frame.BackgroundColor3 = color
		end
	end
	if self.SplashCylinder then
		local surfaceGui = self.SplashCylinder:FindFirstChildOfClass("SurfaceGui")
		if surfaceGui then
			local imageLabel = surfaceGui:FindFirstChildOfClass("ImageLabel")
			if imageLabel then
				imageLabel.ImageColor3 = color
				local uiStroke = imageLabel:FindFirstChildOfClass("UIStroke")
				if uiStroke then
					uiStroke.Color = color
				end
			end
		end
	end

	if self.SecondaryIndicator then
		local secondaryColor = color
		if color == Color3.new(1, 1, 1) then
			secondaryColor = Color3.fromRGB(0, 170, 255)
		elseif color == Color3.new(0, 1, 0) or color == Color3.fromRGB(0, 255, 0) then
			secondaryColor = Color3.fromRGB(0, 200, 100)
		end
		self.SecondaryIndicator:SetColor(secondaryColor)
	end
end

function CreateRangeIndicator.clearAllRanges()
	for _, rangeData in pairs(activeRanges) do
		rangeData:Destroy()
	end
	table.clear(activeRanges)
end

function CreateRangeIndicator.Init()
	PartStorage = ObjectCache.new(IndicatorPartTemplate, CONSTANTS.STORAGE_SIZE, Caches)
end

return CreateRangeIndicator
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="376">
                <Properties>
                  <string name="Name">PlaceValidator</string>
                  <string name="Source"><![CDATA[--/Services
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)

--/Constants
local OFFSET = 0.01

--/Variables
local borderCache = {}

--/Types
export type requestData = {
	TowerName: string,
	SpawnPosition: Vector3,
	BorderRadius: number,
	CurrentCash: number?,
	CurrentCount: number,
	IgnoreId: any?,
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------

local function isPointInPart(point: Vector3, part: BasePart?)
	if not part then
		return false
	end

	local objectPoint = part.CFrame:PointToObjectSpace(point)
	local halfSize = part.Size / 2

	return math.abs(objectPoint.X) <= halfSize.X + OFFSET
		and math.abs(objectPoint.Y) <= halfSize.Y + OFFSET
		and math.abs(objectPoint.Z) <= halfSize.Z + OFFSET
end

local function isPointInTowerArea(point: Vector3)
	for _, taggedInstance in CollectionService:GetTagged("TowerArea") do
		if not taggedInstance:IsA("BasePart") then
			continue
		end

		if not taggedInstance:IsDescendantOf(workspace) then
			continue
		end

		if isPointInPart(point, taggedInstance) then
			return true
		end
	end
	return false
end

local function isBorderOverlap(currentPos, radius, ignoreId)
	for id, data in pairs(borderCache) do
		if id == ignoreId then
			continue
		end

		local distSq = (currentPos.X - data.x) ^ 2 + (currentPos.Z - data.z) ^ 2
		local radiusSum = (radius + data.r) ^ 2

		if distSq < radiusSum then
			return true
		end
	end
	return false
end

-------------------------------------------------
--// PlaceValidator
-------------------------------------------------
local PlaceValidator = {}

function PlaceValidator.CheckSpawn(data: requestData, isPlaceHolder: boolean?)
	if not isPointInTowerArea(data.SpawnPosition) then
		return false, "You can't place here!"
	end

	if isBorderOverlap(data.SpawnPosition, data.BorderRadius, data.IgnoreId) then
		return false, "You can't place near towers!"
	end

	local towerInfo = TowerData.ByName[data.TowerName]
	if not towerInfo then
		return false, `[Game Error] Invalid tower "{data.TowerName}"!`
	end

	if not isPlaceHolder and data.CurrentCash < towerInfo.Stats[0].Cost then
		return false, `You don't enough {NumberUtils.FormatComma(towerInfo.Stats[0].Cost - data.CurrentCash)} cash!`
	end

	if data.CurrentCount >= towerInfo.MaxTowers then
		return false, `You can place only {towerInfo.MaxTowers} of this tower!`
	end

	return true
end

function PlaceValidator.AddBorder(id: any, borderData: { x: number, z: number, r: number })
	if not borderData.x or not borderData.z or not borderData.r then
		return
	end
	borderCache[id] = borderData
end

function PlaceValidator.RemoveBorder(id: any)
	borderCache[id] = nil
end

function PlaceValidator.ClearBorders()
	table.clear(borderCache)
end

return PlaceValidator
]]></string>
