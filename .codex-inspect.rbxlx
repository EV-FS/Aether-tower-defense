          <Item class="ModuleScript" referent="388">
            <Properties>
              <string name="Name">LootClient</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local Net = require(ReplicatedStorage.Shared.Net.client)

local NotificationService

-------------------------------------------------
--// LootClient
-------------------------------------------------
local LootClient = {}

function LootClient.Init(services)
	NotificationService = services:GetService("NotificationService")
end

function LootClient.Start()
	Net.LootService.ReplicateDrop.On(function(data)
		LootClient:AnimateDrop(data.itemName, data.amount)
	end)
end

function LootClient:AnimateDrop(itemName: string, amount: number)
	if NotificationService then
		NotificationService:Pull(nil, `+{itemName} x{amount}`, "Normal", 3)
	end
end

return LootClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="389">
            <Properties>
              <string name="Name">NotificationService</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DEFAULT_DURATION = 3

--/Modules
local Net = require(ReplicatedStorage.Shared.Net)
local NotificationUI = require(ReplicatedStorage.UI.Views.Game.NotificationUI)

-------------------------------------------------
--// NotificationService
-------------------------------------------------
local NotificationService = {}

function NotificationService:Pull(player: Player?, message: string, logType: string, duration: number?)
	if not RunService:IsClient() then
		if typeof(player) == "Instance" and player:IsA("Player") and message then
			Net.NotificationService.Popup.Fire(player, {
				Message = message,
				LogType = logType,
				DurationMs = (duration or DEFAULT_DURATION) * 1000,
			})
		end
		return
	end

	NotificationUI.Pull(message, logType, duration)
end

function NotificationService:PullAll(message: string, logType: string, duration: number?)
	if not RunService:IsClient() then
		Net.NotificationService.Popup.FireAll({
			Message = message,
			LogType = logType,
			DurationMs = (duration or DEFAULT_DURATION) * 1000,
		})
		return
	end

	for _, player in Players:GetPlayers() do
		self:Pull(player, message, logType, duration)
	end
end

function NotificationService.Init()
	if not RunService:IsClient() then
		return
	end

	Net.NotificationService.Popup.On(function(data)
		NotificationService:Pull(nil, data.Message, data.LogType, data.DurationMs)
	end)
end

return NotificationService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="390">
            <Properties>
              <string name="Name">SettingsClient</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Packages.Signal)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local Net = require(ReplicatedStorage.Shared.Net)
local SettingsData = require(ReplicatedStorage.Settings.Data.SettingsData)

local AudioService

local Settings = {}
local dirtySettings = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------

local SettingApplier = {
	Shadows = function(value: boolean)
		Lighting.GlobalShadows = value
	end,

	MusicVolume = function(value: number)
		if AudioService then
			AudioService.SetBGMState(nil, (value / 50))
		end
	end,
	SFXVolume = function(value: number)
		if AudioService then
			AudioService.SFXVolume = (value / 50)
		end
	end,
}

-------------------------------------------------
--// SettingsClient
-------------------------------------------------
local SettingsClient = {}
SettingsClient.SettingSignals = {}
SettingsClient.LoadedPromise = nil

function SettingsClient.ApplySetting(settingName: string, value: any)
	if Settings[settingName] == value then
		return value
	end

	Settings[settingName] = value
	dirtySettings[settingName] = true

	local handler = SettingApplier[settingName]
	if handler then
		task.spawn(handler, value)
	end

	SettingsClient:_FireChanged(settingName, value)
	SettingsClient._SaveSettings()

	return value
end

function SettingsClient.GetSettings()
	if SettingsClient.LoadedPromise then
		SettingsClient.LoadedPromise:expect()
	else
		SettingsClient.FetchSettings():expect()
	end

	return TableUtils.DeepCopy(Settings)
end

function SettingsClient.FetchSettings()
	if SettingsClient.LoadedPromise then
		return SettingsClient.LoadedPromise
	end

	SettingsClient.LoadedPromise = Net.SettingsService.GetSettings
		.Invoke()
		:andThen(function(playerSettings)
			if type(playerSettings) == "table" then
				Settings = playerSettings
			end
		end)
		:catch(function(err)
			warn(`설정값 불러오기 실패: {err}`)
			Settings = {}
		end)
		:andThen(function()
			for key, info in pairs(SettingsData.ByName) do
				if Settings[key] == nil then
					Settings[key] = info.Default
				end
			end

			for key, val in pairs(Settings) do
				local handler = SettingApplier[key]
				if handler then
					task.spawn(handler, val)
				end
			end

			return Settings
		end)

	return SettingsClient.LoadedPromise
end

function SettingsClient:GetChangedSignal(settingName: string)
	if not self.SettingSignals[settingName] then
		self.SettingSignals[settingName] = Signal.new()
	end

	return self.SettingSignals[settingName]
end

function SettingsClient:_FireChanged(settingName: string, value: any)
	local signal = self.SettingSignals[settingName]
	if signal then
		signal:Fire(value)
	end
end

function SettingsClient._SaveSettings()
	if not next(dirtySettings) then
		return
	end

	local savingKeys = {}
	for key in pairs(dirtySettings) do
		savingKeys[key] = Settings[key]
		dirtySettings[key] = nil
	end

	for key, val in pairs(savingKeys) do
		Net.SettingsService.SaveSetting
			.Invoke({
				SettingName = key,
				Value = val,
			})
			:catch(function(err)
				warn(`설정 저장 실패 ({key}):`, err)

				if Settings[key] == val then
					dirtySettings[key] = true
				end
			end)
	end
end

function SettingsClient.Init(services)
	AudioService = services:GetService("AudioService")
end

function SettingsClient.Start()
	SettingsClient.FetchSettings()
end

return SettingsClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="391">
            <Properties>
              <string name="Name">SprintClient</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local SetMobileStyle = require(ReplicatedStorage.Shared.Modules.UI.SetMobileStyle)

local camera = workspace.CurrentCamera
local player = Players.LocalPlayer
local normalSpeed = 16
local sprintSpeed = 64

local currentHumanoid: Humanoid? = nil
local isSprinting = false
local isEnabled = true

local SprintClient = {}

local function updateMobileVisual()
	local mobileButton = ContextActionService:GetButton("Sprint")
	if mobileButton then
		SetMobileStyle.SetToggleState(mobileButton, isSprinting and isEnabled)
	end
end

local function updateSpeed()
	if not currentHumanoid or not isEnabled then
		return
	end
	currentHumanoid.WalkSpeed = isSprinting and sprintSpeed or normalSpeed
	updateMobileVisual()
end

local function handleSprint(_, inputState)
	if not currentHumanoid or not isEnabled then
		return
	end

	if inputState == Enum.UserInputState.Begin then
		isSprinting = not isSprinting
		updateSpeed()
	end
end

function SprintClient.SetEnabled(enabled: boolean)
	isEnabled = enabled
	if not enabled then
		isSprinting = false
	end
	updateSpeed()
	updateMobileVisual()
end

function SprintClient.Enable()
	SprintClient.SetEnabled(true)
end

function SprintClient.Disable()
	SprintClient.SetEnabled(false)
end

function SprintClient.IsSprinting(): boolean
	return isSprinting
end

function SprintClient.IsEnabled(): boolean
	return isEnabled
end

function SprintClient.Init() end

function SprintClient.Start()
	local function onCharacterAdded(character: Model)
		currentHumanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
		if currentHumanoid and isEnabled then
			currentHumanoid.WalkSpeed = normalSpeed
		end
		isSprinting = false
	end

	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	ContextActionService:BindAction("Sprint", handleSprint, true, Enum.KeyCode.LeftShift)
	ContextActionService:SetImage("Sprint", "rbxassetid://95175163838191")

	if UserInputService.TouchEnabled then
		task.spawn(function()
			local mobileButton = nil
			for _ = 1, 10 do
				mobileButton = ContextActionService:GetButton("Sprint")
				if mobileButton then
					break
				end
				task.wait()
			end

			if mobileButton then
				local viewportX = camera.ViewportSize.X > 0 and camera.ViewportSize.X or 800
				local viewportY = camera.ViewportSize.Y > 0 and camera.ViewportSize.Y or 600

				local minAxis = math.min(viewportX, viewportY)
				local isSmallScreen = minAxis <= 500
				local buttonSize = isSmallScreen and 50 or 100

				mobileButton.Size = UDim2.fromOffset(buttonSize, buttonSize)
				ContextActionService:SetPosition("Sprint", UDim2.new(0.4, -buttonSize, 0.3, -buttonSize))

				SetMobileStyle.Toggle(mobileButton)
			end
		end)
	end
end

return SprintClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="392">
            <Properties>
              <string name="Name">TimeService</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

local Promise = require(ReplicatedStorage.Packages.Promise)
local Net = require(ReplicatedStorage.Shared.Net)

local ALLOWED_SPEED = { 1, 1.5, 2 }

local ClientSignals = nil

local latestSpeedChangeTime = 0
local latestSpeedCompensation = 0
local TimerConnection

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getPingTime(sendTimeMs: number): number
	local currentTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536
	local difference = (currentTimeMs - sendTimeMs) % 65536
	if difference > 32768 then
		difference -= 65536
	end
	return math.max(0, difference) / 1000
end

local function compensatePing(leftTime: number, lastCheckTime: number): (number, number)
	if latestSpeedChangeTime > lastCheckTime then
		leftTime -= latestSpeedCompensation
		lastCheckTime = latestSpeedChangeTime
	end
	return leftTime, lastCheckTime
end

-------------------------------------------------
--// TimeService
-------------------------------------------------
local TimeService = {}
TimeService.GameSpeed = 1
TimeService.GameTime = 0
TimeService.RealGameTime = 0
TimeService.IsTimerRunning = false

function TimeService.DeltaWait(duration: number): number
	local leftTime = duration
	local lastCheckTime = os.clock()

	while leftTime > 0 do
		leftTime -= RunService.Heartbeat:Wait() * TimeService.GameSpeed
		leftTime, lastCheckTime = compensatePing(leftTime, lastCheckTime)
	end

	return leftTime
end

function TimeService.DeltaDelay(duration: number)
	return Promise.new(function(resolve, _, onCancel)
		if duration <= 0 then
			return resolve()
		end

		local leftTime = duration
		local lastCheckTime = os.clock()
		local connection

		connection = RunService.Heartbeat:Connect(function(dt)
			leftTime -= dt * TimeService.GameSpeed
			leftTime, lastCheckTime = compensatePing(leftTime, lastCheckTime)

			if leftTime <= 0 then
				if connection then
					connection:Disconnect()
					connection = nil
				end
				resolve()
			end
		end)

		onCancel(function()
			if connection then
				connection:Disconnect()
				connection = nil
			end
		end)

		return
	end)
end

function TimeService:StartGameTimer()
	TimeService.GameTime = 0
	TimeService.RealGameTime = 0
	self:_RecordGameTime()
end

function TimeService:StopGameTimer()
	self:_StopRecording()
end

function TimeService:_RecordGameTime()
	if self.IsTimerRunning then
		return
	end
	self.IsTimerRunning = true

	TimerConnection = RunService.Heartbeat:Connect(function(dt)
		self.GameTime += dt * self.GameSpeed
		self.RealGameTime += dt
	end)
end

function TimeService:_StopRecording()
	if not self.IsTimerRunning then
		return
	end
	self.IsTimerRunning = false

	if TimerConnection then
		TimerConnection:Disconnect()
		TimerConnection = nil
	end
end

function TimeService:GetGameSpeed()
	return self.GameSpeed
end

function TimeService:SetGameSpeed(speed: number, pingTime: number?, isForce: boolean?): boolean
	if RunService:IsClient() and not isForce then
		local success = Net.TimeService.ChangeGameSpeed.Invoke(speed * 10):expect()
		return success == true
	end

	local oldSpeed = self.GameSpeed
	self.GameSpeed = speed

	if RunService:IsClient() then
		latestSpeedChangeTime = os.clock()
		latestSpeedCompensation = (pingTime or 0) * (speed - oldSpeed)

		if ClientSignals then
			ClientSignals.GameSpeedChanged:Fire(speed, oldSpeed, pingTime)
		end
	elseif RunService:IsServer() then
		Net.TimeService.GameSpeedChanged.FireAll({
			newSpeed = speed * 10,
			sendTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536,
		})
	end

	return true
end

function TimeService.Init()
	if RunService:IsClient() then
		ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
	end
end

function TimeService.Start()
	if RunService:IsClient() then
		Net.TimeService.GameSpeedChanged.On(function(data: { newSpeed: number, sendTimeMs: number })
			local convertNewSpeed = data.newSpeed / 10
			if typeof(convertNewSpeed) ~= "number" then
				return
			end

			local pingTime = getPingTime(data.sendTimeMs)
			TimeService:SetGameSpeed(convertNewSpeed, pingTime, true)
		end)
	elseif RunService:IsServer() then
		Net.TimeService.ChangeGameSpeed.On(function(_: Player, newSpeed: number): boolean
			local targetSpeed = newSpeed / 10
			if not table.find(ALLOWED_SPEED, targetSpeed) then
				return false
			end

			return TimeService:SetGameSpeed(targetSpeed)
		end)
	end
end

return TimeService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="393">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local source = Vide.source

local activeView = source(nil :: string?)
local isLocked = source(false)

local UIController = {}

function UIController:IsOpen(name: string): boolean
	return activeView() == name
end

function UIController:IsVisible(name: string): () -> boolean
	return function()
		return activeView() == name
	end
end

function UIController:GetActiveView(): string?
	return activeView()
end

function UIController:Open(name: string): boolean
	if isLocked() or name == "" then
		return false
	end

	activeView(name)
	return true
end

function UIController:Close(name: string): boolean
	if isLocked() or activeView() ~= name then
		return false
	end

	activeView(nil)
	return true
end

function UIController:CloseAll(): boolean
	if isLocked() or activeView() == nil then
		return false
	end

	activeView(nil)
	return true
end

function UIController:Toggle(name: string): boolean
	if self:IsOpen(name) then
		return self:Close(name)
	end

	return self:Open(name)
end

function UIController:Lock(locked: boolean)
	isLocked(locked)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="394">
            <Properties>
              <string name="Name">VFXService</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local VFXCaches = require(script.VFXCaches)
local VFXRecipes = require(ReplicatedStorage.Settings.Visuals.VFXRecipes)
local Steps = require(ReplicatedStorage.Settings.Visuals.VFXRecipes.Steps)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local ForgeVFX = require(ReplicatedStorage.Shared.Modules.Utils.ForgeVFX)
local CustomHandlers = require(script.CustomHandlers)
local TimeService

local RANDOM = Random.new()

local DEFAULT_LIFETIME = 2.5
local DEFAULT_PROJECTILE_SPEED = 300
local PROJECTILE_OFFSET = 0.2
local BEAM_CHECK_RATE = 1 / 15

export type Recipes = { Steps.Recipe }

local ActiveBeams = {}

local function getBezierPoint(t: number, p0: Vector3, p1: Vector3, p2: Vector3): Vector3
	local oneMinusT = 1 - t
	return oneMinusT * oneMinusT * p0 + 2 * oneMinusT * t * p1 + t * t * p2
end

local function getBezierTangent(t: number, p0: Vector3, p1: Vector3, p2: Vector3): Vector3
	return 2 * (1 - t) * (p1 - p0) + 2 * t * (p2 - p1)
end

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function resolveInstance(value: any, sourceModel: Model, targetModel: Model)
	if typeof(value) == "Instance" then
		return value
	end

	if type(value) ~= "string" then
		return
	end

	local parts = string.split(value, ".")
	local rootName = parts[1]

	local rootModel
	if rootName == "Source" then
		rootModel = sourceModel
	elseif rootName == "Target" then
		rootModel = targetModel
	else
		warn(`잘못된 경로: {rootName}`)
		return
	end

	if not rootModel or not rootModel.Parent then
		return
	end

	if #parts == 1 then
		return rootModel.PrimaryPart
	end

	local current = rootModel
	for i = 2, #parts do
		if parts[i] == "@Ground" then
			return current.PrimaryPart, true
		end

		current = current:FindFirstChild(parts[i])

		if not current then
			warn(`경로를 찾을 수 없음: {value}`)
			return
		end
	end

	return current
end

local function getAttachment(parentPart: BasePart)
	local attachment = parentPart:FindFirstChild("BeamAttachment")
	if attachment then
		return attachment
	end

	attachment = Instance.new("Attachment")
	attachment.Name = "BeamAttachment"
	attachment.Parent = parentPart

	return attachment
end

local function isAlive(model): boolean
	if not model or not model.PrimaryPart or not model:IsDescendantOf(workspace) then
		return false
	end

	return model.PrimaryPart:GetAttribute("Dead") ~= true
end

local function getBeamKey(recipe)
	return `{recipe.Effect}|{recipe.From}->{recipe.To}`
end

-------------------------------------------------
--// VFXService
-------------------------------------------------
local VFXService = {}

function VFXService.GetRecipes(sourceName: string, effectType: string, sourceLevel: number?): Recipes?
	local sourceRecipes = VFXRecipes[sourceName]
	if not sourceRecipes then
		return nil
	end

	local effectRecipes = sourceRecipes[effectType]
	if not effectRecipes then
		return nil
	end

	if effectRecipes[1] then
		return effectRecipes
	end

	local level = sourceLevel or 0

	for currentLevel = level, 0, -1 do
		local recipes = effectRecipes[currentLevel]

		if recipes then
			return recipes
		end
	end

	warn(`{sourceName}.{effectType}의 {level}레벨 이하 VFX 정보가 존재하지 않음.`)
	return nil
end

function VFXService.PlayVFX(vfxRecipes: Recipes, sourceModel: Model, targetModel: Model, range: number?, delay: number?)
	if typeof(vfxRecipes) ~= "table" then
		return
	end
	for _, recipe in vfxRecipes do
		if (recipe.Delay and recipe.Delay > 0) or delay then
			local delayedRecipe = table.clone(recipe)
			local totalDelay = (delay or 0) + (delayedRecipe.Delay or 0)

			delayedRecipe.Delay = nil

			TimeService.DeltaDelay(totalDelay):andThen(function()
				VFXService.PlayVFX({ delayedRecipe }, sourceModel, targetModel, range)
			end)

			continue
		end

		if recipe.Type == "Emit" then
			VFXService._PlayEmitType(recipe, sourceModel, targetModel)
		elseif recipe.Type == "Projectile" then
			VFXService._PlayProjectileType(recipe, sourceModel, targetModel)
		elseif recipe.Type == "Beam" then
			VFXService._PlayBeamType(recipe, sourceModel, targetModel, range)
		elseif recipe.Type == "Custom" then
			VFXService._PlayCustomType(recipe, sourceModel, targetModel)
		else
			warn(`알 수 없는 VFX Type: {recipe.Type}`)
		end
	end
end

function VFXService._PlayCustomType(recipe: Steps.CustomStep, sourceModel: Model, targetModel: Model)
	local handler = CustomHandlers[recipe.Effect]
	if handler then
		task.spawn(function()
			local success, err = pcall(handler, recipe, sourceModel, targetModel)
			if not success then
				warn(`커스텀 VFX 실행 실패 ({recipe.Effect}): {err}`)
			end
		end)
	else
		warn(`커스텀 VFX 핸들러를 찾을 수 없음: {recipe.Effect}`)
	end
end

function VFXService._PlayEmitType(recipe: Steps.EmitStep, sourceModel: Model, targetModel: Model)
	local playPart, isGround = resolveInstance(recipe.At, sourceModel, targetModel)
	if not playPart then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	local playCFrame
	if isGround then
		playCFrame = playPart.CFrame - Vector3.new(0, CharacterUtils.GetHipHeight(playPart.Parent), 0)
	else
		playCFrame = playPart.CFrame
	end

	if not playCFrame then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	local effect, runId = VFXCaches.Get(recipe.Effect, playCFrame)
	if not effect or not runId then
		return
	end

	if recipe.LockToSource then
		local connection
		local offset = playPart.CFrame:ToObjectSpace(playCFrame)
		connection = RunService.PreRender:Connect(function()
			if effect:GetAttribute("VFXRunId") ~= runId or not playPart:IsDescendantOf(workspace) then
				connection:Disconnect()
				return
			end
			VFXCaches.SetCFrame(effect, playPart.CFrame * offset)
		end)
	end

	ForgeVFX.emit(effect)
	VFXCaches.ReturnAfter(
		recipe.Effect,
		effect,
		runId,
		(recipe.Lifetime or DEFAULT_LIFETIME) / TimeService:GetGameSpeed()
	)
end

function VFXService._PlayProjectileType(recipe: Steps.ProjectileStep, sourceModel: Model, targetModel: Model)
	local sourceInstance = resolveInstance(recipe.From, sourceModel, targetModel)
	local targetInstance = resolveInstance(recipe.To, sourceModel, targetModel)
	if
		not sourceInstance
		or not sourceInstance:IsA("BasePart")
		or not targetInstance
		or not targetInstance:IsA("BasePart")
	then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	local sourceCFrame = sourceInstance.CFrame
	local targetCFrame = targetInstance.CFrame

	local startPos = sourceCFrame.Position
	local endPos = targetCFrame.Position
	local direction = endPos - startPos
	local distance = direction.Magnitude

	if distance <= 0 then
		return
	end

	local spawnCFrame = CFrame.lookAt(startPos, endPos)
	local effect, runId = VFXCaches.Get(recipe.Effect, spawnCFrame)
	if not effect or not runId then
		return
	end

	if not effect:IsA("BasePart") and not effect:IsA("Model") then
		warn(`Projectile effect must be a BasePart or Model: {recipe.Effect}`)
		VFXCaches.Return(recipe.Effect, effect)
		return
	end

	local travelTime
	if recipe.TravelTime then
		travelTime = recipe.TravelTime
	else
		travelTime = distance / (recipe.Speed or DEFAULT_PROJECTILE_SPEED)
	end

	local goalOffset = Vector3.new(
		RANDOM:NextNumber(-PROJECTILE_OFFSET, PROJECTILE_OFFSET),
		RANDOM:NextNumber(-PROJECTILE_OFFSET, PROJECTILE_OFFSET),
		RANDOM:NextNumber(-PROJECTILE_OFFSET, PROJECTILE_OFFSET)
	)
	local goalCFrame = CFrame.lookAt(endPos, endPos + direction.Unit) + goalOffset
	ForgeVFX.emit(effect)

	local isBezier = (recipe.CurveHeight and recipe.CurveHeight ~= 0)
		or (recipe.CurveOffset and recipe.CurveOffset ~= 0)

	if isBezier then
		local midPoint = (startPos + endPos) / 2
		local controlPoint = midPoint
		if recipe.CurveHeight then
			controlPoint = controlPoint + Vector3.new(0, recipe.CurveHeight, 0)
		end
		if recipe.CurveOffset then
			local directionUnit = direction.Magnitude > 0 and direction.Unit or Vector3.new(0, 0, 1)
			local up = Vector3.new(0, 1, 0)
			local side = directionUnit:Cross(up)

			if side.Magnitude > 0 then
				side = side.Unit
			else
				side = Vector3.new(1, 0, 0)
			end

			local randomSign = RANDOM:NextInteger(1, 2) == 1 and 1 or -1

			controlPoint = controlPoint + side * (recipe.CurveOffset * randomSign)
		end

		task.spawn(function()
			RunService.PreRender:Wait()

			local elapsed = 0
			local connection
			connection = RunService.PreRender:Connect(function(dt)
				if not effect or not effect.Parent or effect:GetAttribute("VFXRunId") ~= runId then
					connection:Disconnect()
					return
				end

				elapsed = math.min(travelTime, elapsed + dt * TimeService:GetGameSpeed())
				local t = elapsed / travelTime

				local currentPos = getBezierPoint(t, startPos, controlPoint, endPos + goalOffset)
				local tangent = getBezierTangent(t, startPos, controlPoint, endPos + goalOffset)

				if tangent.Magnitude > 0 then
					VFXCaches.SetCFrame(effect, CFrame.lookAt(currentPos, currentPos + tangent.Unit))
				else
					VFXCaches.SetCFrame(effect, CFrame.new(currentPos))
				end

				if elapsed >= travelTime then
					connection:Disconnect()

					if recipe.OnHit then
						VFXService.PlayVFX({ recipe.OnHit }, sourceModel, targetModel)
					end

					RunService.PreRender:Wait()
					VFXCaches.Return(recipe.Effect, effect)
				end
			end)
		end)
	else
		local tweenValue = Instance.new("CFrameValue")
		tweenValue.Value = spawnCFrame

		local tweenConnection = tweenValue:GetPropertyChangedSignal("Value"):Connect(function()
			if effect:GetAttribute("VFXRunId") == runId then
				VFXCaches.SetCFrame(effect, tweenValue.Value)
			end
		end)

		local tween = TweenService:Create(
			tweenValue,
			TweenInfo.new(travelTime / TimeService:GetGameSpeed(), Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Value = goalCFrame }
		)

		tween.Completed:Once(function()
			tweenConnection:Disconnect()
			tweenValue:Destroy()

			if effect:GetAttribute("VFXRunId") ~= runId then
				return
			end
			if recipe.OnHit then
				VFXService.PlayVFX({ recipe.OnHit }, sourceModel, targetModel)
			end

			RunService.PreRender:Wait()
			VFXCaches.Return(recipe.Effect, effect)
		end)

		task.spawn(function()
			RunService.PreRender:Wait()
			tween:Play()
		end)
	end
end

function VFXService._PlayBeamType(recipe: Steps.BeamStep, sourceModel: Model, targetModel: Model, range: number?)
	local beamKey = getBeamKey(recipe)
	if not ActiveBeams[sourceModel] then
		ActiveBeams[sourceModel] = {}
	end
	if ActiveBeams[sourceModel][beamKey] then
		return
	end
	if not isAlive(sourceModel) or not isAlive(targetModel) or targetModel:GetAttribute("DeadByBeam") then
		return
	end

	local fromInstance = resolveInstance(recipe.From, sourceModel, targetModel)
	local toInstance = resolveInstance(recipe.To, sourceModel, targetModel)
	if not fromInstance or not toInstance then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	if not fromInstance or not toInstance then
		warn(`Instance를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	if not fromInstance:IsA("BasePart") or not toInstance:IsA("BasePart") then
		warn(`Beam 위치는 BasePart여야 함: {recipe.Effect}`)
		return
	end

	local sourceAttachment = getAttachment(fromInstance)
	local targetAttachment = getAttachment(toInstance)

	local effect, runId = VFXCaches.Get(recipe.Effect, CFrame.new())
	if not effect or not runId then
		return
	end

	local state = {
		Target = targetModel,
		Effect = effect,
		RunId = runId,
		Connection = nil,
		Instances = {},
		Cleaned = false,
	}

	ActiveBeams[sourceModel][beamKey] = state

	local function track(instance: Instance)
		table.insert(state.Instances, instance)
		return instance
	end

	local effectContents: Instance = effect
	if effect:IsA("Model") and effect.PrimaryPart then
		effectContents = effect.PrimaryPart
	end

	local startAttach = effectContents:FindFirstChild("Start")
	local endAttach = effectContents:FindFirstChild("End")

	if startAttach then
		for _, eff in startAttach:GetChildren() do
			if not (eff:IsA("ParticleEmitter") or eff:IsA("Beam") or eff:IsA("Trail")) then
				continue
			end

			local clonedEff = track(eff:Clone())
			pcall(function()
				(clonedEff :: any).TimeScale = TimeService:GetGameSpeed()
			end)
			clonedEff.Parent = sourceAttachment
		end
	end

	if endAttach then
		for _, eff in endAttach:GetChildren() do
			if not (eff:IsA("ParticleEmitter") or eff:IsA("Beam") or eff:IsA("Trail")) then
				continue
			end

			local clonedEff = track(eff:Clone())
			pcall(function()
				(clonedEff :: any).TimeScale = TimeService:GetGameSpeed()
			end)
			clonedEff.Parent = targetAttachment
		end
	end

	for _, beam in effectContents:GetChildren() do
		if not beam:IsA("Beam") then
			continue
		end

		local clonedBeam = track(beam:Clone())
		clonedBeam.Attachment0 = sourceAttachment
		clonedBeam.Attachment1 = targetAttachment
		pcall(function()
			(clonedBeam :: any).TimeScale = TimeService:GetGameSpeed()
		end)
		clonedBeam.Enabled = true
		clonedBeam.Parent = sourceAttachment
	end

	ForgeVFX.emit(sourceAttachment)
	ForgeVFX.emit(targetAttachment)

	local function cleanup()
		if state.Cleaned then
			return
		end
		state.Cleaned = true

		if state.Connection then
			state.Connection:Disconnect()
			state.Connection = nil
		end

		for _, inst in state.Instances do
			if inst.Parent then
				inst:Destroy()
			end
		end

		table.clear(state.Instances)

		if ActiveBeams[sourceModel] then
			ActiveBeams[sourceModel][beamKey] = nil

			if not next(ActiveBeams[sourceModel]) then
				ActiveBeams[sourceModel] = nil
			end
		end

		if effect:GetAttribute("VFXRunId") == runId then
			VFXCaches.Return(recipe.Effect, effect)
		end
	end

	local passedTime = 0
	state.Connection = RunService.PreRender:Connect(function(dt)
		passedTime += dt
		if passedTime < BEAM_CHECK_RATE then
			return
		end
		passedTime = 0

		if not isAlive(sourceModel) or not isAlive(targetModel) then
			RunService.PreRender:Wait()
			if targetModel and targetModel.Parent then
				targetModel:SetAttribute("DeadByBeam", true)
			end
			cleanup()
			return
		end
		if not sourceAttachment:IsDescendantOf(workspace) or not targetAttachment:IsDescendantOf(workspace) then
			cleanup()
			return
		end

		if range then
			local offset = targetAttachment.WorldPosition - sourceAttachment.WorldPosition
			local distanceSq = offset.X * offset.X + offset.Z * offset.Z

			if distanceSq > range * range then
				cleanup()
				return
			end
		end
	end)
end

function VFXService.Init(services)
	TimeService = services:GetService("TimeService")
end

function VFXService.Start()
	ForgeVFX.init()

	local ClientSignals = require(game:GetService("StarterPlayer").StarterPlayerScripts.Client.ClientSignals)
	ClientSignals.GameSpeedChanged:Connect(function(newSpeed)
		for _, sourceBeams in pairs(ActiveBeams) do
			for _, state in pairs(sourceBeams) do
				for _, inst in ipairs(state.Instances) do
					if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
						pcall(function()
							(inst :: any).TimeScale = newSpeed
						end)
					end
				end
			end
		end
	end)
end

return VFXService
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="395">
              <Properties>
                <string name="Name">CustomHandlers</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local InstanceCache = require(ReplicatedStorage.Shared.Modules.Core.InstanceCache)
local TimeService = require(script.Parent.Parent.TimeService)
local CustomHandlers = {}

local KITSUNE_CLONE_ANIMATIONS = {
	[1] = "rbxassetid://133911301867999",
	[2] = "rbxassetid://110931334362071",
	[3] = "rbxassetid://128258077329376",
	[4] = "rbxassetid://88135449447525",
}
local KitsuneTracks = setmetatable({}, { __mode = "k" })

local function getSourceCFrame(source: Instance): CFrame
	if source:IsA("Model") then
		return if source.PrimaryPart then source.PrimaryPart.CFrame else source:GetPivot()
	end
	return (source :: BasePart).CFrame
end

local function playKitsuneAnimation(cloneModel: Model, cloneIndex: number): AnimationTrack?
	local animationId = KITSUNE_CLONE_ANIMATIONS[cloneIndex]
	if animationId == "" then
		return nil
	end

	local tracks = KitsuneTracks[cloneModel]
	if not tracks then
		tracks = {}
		KitsuneTracks[cloneModel] = tracks
	end

	local track = tracks[animationId]
	if not track then
		local controller = cloneModel:FindFirstChildOfClass("AnimationController")
			or cloneModel:FindFirstChildOfClass("Humanoid")
		if not controller then
			controller = Instance.new("AnimationController")
			controller.Parent = cloneModel
		end
		local animator = controller:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = controller
		end

		local animation = Instance.new("Animation")
		animation.AnimationId = animationId
		local success, result = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		animation:Destroy()
		if not success then
			warn(`Kitsune clone {cloneIndex} animation failed: {result}`)
			return nil
		end
		track = result
		tracks[animationId] = track
	end

	track.Looped = false
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0, 1, TimeService:GetGameSpeed())
	return track
end

function CustomHandlers.Hacked(_, sourceModel, targetModel)
	local target = targetModel or sourceModel
	if not target then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillColor = Color3.fromRGB(0, 241, 12)
	highlight.FillTransparency = -10
	highlight.OutlineTransparency = 1
	highlight.Parent = target

	for _, descendant: Instance in target:GetDescendants() do
		if descendant:IsA("SurfaceAppearance") or descendant:IsA("Texture") then
			descendant:Destroy()
		elseif descendant:IsA("MeshPart") then
			descendant.TextureID = ""
		end

		if descendant:IsA("BasePart") then
			if target.PrimaryPart == descendant or target.Name == "HumanoidRootPart" then
				descendant.Transparency = 1
				continue
			end
			descendant.Material = Enum.Material.Glass
			descendant.Color = Color3.new(0.25, 0.5, 0)
			descendant.Transparency = -10000
			descendant.Reflectance = 10000
		end
	end
end

function CustomHandlers.KitsuneCloneAttack(_, sourceModel)
	if not sourceModel or not sourceModel:IsDescendantOf(workspace) then
		return
	end
	if not sourceModel:IsA("Model") and not sourceModel:IsA("BasePart") then
		return
	end

	if not CustomHandlers.KitsunePool then
		local cloneModel = ReplicatedStorage.Assets.VFX.Towers["Kitsune Samurai"].KitsuneClone
		assert(cloneModel:IsA("Model"), "KitsuneClone must be a Model")
		CustomHandlers.KitsunePool = InstanceCache.new(cloneModel, 4, workspace:WaitForChild("Caches"))
	end

	local pool = CustomHandlers.KitsunePool
	local clones = {}
	local activeTracks = {}
	local sourceCFrame = getSourceCFrame(sourceModel)
	for cloneIndex = 1, 4 do
		local cloneModel = pool:GetInstance(sourceCFrame) :: Model
		cloneModel:SetAttribute("CloneIndex", cloneIndex)
		local root = cloneModel.PrimaryPart or cloneModel:FindFirstChild("HumanoidRootPart")
		for _, descendant in cloneModel:GetDescendants() do
			if descendant:IsA("BasePart") then
				if root then
					descendant.Anchored = descendant == root
				end
				descendant.CanCollide = false
				descendant.CanTouch = false
				descendant.CanQuery = false
			end
		end
		clones[cloneIndex] = cloneModel
	end

	local elapsed = 0
	local connection
	local speedConnection
	local function cleanup()
		connection:Disconnect()
		if speedConnection then
			speedConnection:Disconnect()
		end
		for _, track in activeTracks do
			track:Stop(0)
		end
		for _, cloneModel in clones do
			cloneModel:SetAttribute("CloneIndex", nil)
			pool:ReturnInstance(cloneModel)
		end
	end

	connection = RunService.PreRender:Connect(function(dt)
		elapsed += dt * TimeService:GetGameSpeed()
		if elapsed >= 2.5 or not sourceModel:IsDescendantOf(workspace) then
			cleanup()
			return
		end

		local currentCFrame = getSourceCFrame(sourceModel)
		for _, cloneModel in clones do
			cloneModel:PivotTo(currentCFrame)
		end
	end)

	local ClientSignals = require(game:GetService("StarterPlayer").StarterPlayerScripts.Client.ClientSignals)
	speedConnection = ClientSignals.GameSpeedChanged:Connect(function(newSpeed)
		for _, track in activeTracks do
			if track.IsPlaying then
				track:AdjustSpeed(newSpeed)
			end
		end
	end)

	for cloneIndex, cloneModel in clones do
		local track = playKitsuneAnimation(cloneModel, cloneIndex)
		if track then
			table.insert(activeTracks, track)
		end
	end
end

return CustomHandlers
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="396">
              <Properties>
                <string name="Name">VFXCaches</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InstanceCache = require(ReplicatedStorage.Shared.Modules.Core.InstanceCache)

local VFX_FOLDER = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("VFX")
local CACHE_FOLDER = workspace:WaitForChild("Caches")

local DEFAULT_POOL_SIZE = 50

type PoolData = {
	Storage: any,
	ActiveCount: number,
	Capacity: number,
}

local VFXCaches = {}

local Pools: { [string]: PoolData } = {}
local RunId = 0

local function getRootInstance(effect: Instance): Instance
	if effect:IsA("BasePart") and effect.Parent and effect.Parent:IsA("Model") and effect.Parent.PrimaryPart == effect then
		return effect.Parent
	end
	return effect
end

local function resetEffect(effect: Instance)
	local root = getRootInstance(effect)
	for _, object in root:GetDescendants() do
		if object:IsA("ParticleEmitter") then
			object.Enabled = false
			object:Clear()
		elseif object:IsA("Beam") or object:IsA("Trail") then
			object.Enabled = false
		elseif object:IsA("Sound") then
			object:Stop()
		end
	end
end

local function hide(effect: Instance)
	local root = getRootInstance(effect)
	if root:IsA("BasePart") then
		root:SetAttribute("VFX_OT", root.Transparency)
		root.Transparency = 1
	end

	for _, object in root:GetDescendants() do
		if object:IsA("BasePart") then
			object:SetAttribute("VFX_OT", object.Transparency)
			object.Transparency = 1
		end
	end
end

local function show(effect: Instance)
	local root = getRootInstance(effect)
	if root:IsA("BasePart") then
		local toSet = root:GetAttribute("VFX_OT")
		if toSet then
			root.Transparency = toSet
		end
	end

	for _, object in root:GetDescendants() do
		if object:IsA("BasePart") then
			local toSet = object:GetAttribute("VFX_OT")
			if toSet then
				object.Transparency = toSet
			end
		end
	end
end

function VFXCaches.GetTemplate(effectPath: string): Instance?
	local current: Instance? = VFX_FOLDER

	for name in string.gmatch(effectPath, "[^/]+") do
		current = current and current:FindFirstChild(name)

		if not current then
			warn(`Effect를 찾을 수 없음: {effectPath}`)
			return nil
		end
	end

	return current
end

function VFXCaches.SetCFrame(effect: Instance, cframe: CFrame)
	if effect:IsA("BasePart") then
		effect.CFrame = cframe
	elseif effect:IsA("Model") then
		effect:PivotTo(cframe)
	end
end

function VFXCaches.Get(effectPath: string, cframe: CFrame?, poolSize: number?): (Instance?, number?)
	local pool = Pools[effectPath]

	if not pool then
		local template = VFXCaches.GetTemplate(effectPath)

		if not template then
			return nil, nil
		end

		local size = poolSize or DEFAULT_POOL_SIZE

		pool = {
			Storage = InstanceCache.new(template, size, CACHE_FOLDER),
			ActiveCount = 0,
			Capacity = size,
		}

		Pools[effectPath] = pool
	end

	pool.ActiveCount += 1

	if pool.ActiveCount > pool.Capacity then
		pool.Storage:ExpandCache(1)
		pool.Capacity += 1
	end

	local effect = pool.Storage:GetInstance(cframe)

	if not effect then
		return nil, nil
	end

	RunId += 1

	effect:SetAttribute("VFXRunId", RunId)

	resetEffect(effect)
	show(effect)
	if cframe then
		VFXCaches.SetCFrame(effect, cframe)
	end

	return effect, RunId
end

function VFXCaches.Return(effectPath: string, effect: Instance)
	local pool = Pools[effectPath]
	if not pool then
		return
	end

	resetEffect(effect)
	hide(effect)
	effect:SetAttribute("VFXRunId", nil)

	task.delay(0.5, function()
		pool.ActiveCount = math.max(0, pool.ActiveCount - 1)
		pool.Storage:ReturnInstance(effect)
	end)
end

function VFXCaches.ReturnAfter(effectPath: string, effect: Instance, runId: number, lifetime: number)
	task.delay(lifetime, function()
		if effect:GetAttribute("VFXRunId") ~= runId then
			return
		end

		VFXCaches.Return(effectPath, effect)
	end)
end

return VFXCaches
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="397">
            <Properties>
              <string name="Name">VisualService</string>
              <string name="Source"><![CDATA[local VisualService = {}

local AudioService
local VFXService
local TimeService

function VisualService.Init(services)
	AudioService = services:GetService("AudioService")
	VFXService = services:GetService("VFXService")
	TimeService = services:GetService("TimeService")
end

function VisualService.Start() end

function VisualService.Play(
	name: string,
	eventName: string,
	level: number?,
	sourceModel: Model,
	targetModel: Model?,
	range: number?,
	delay: number?,
	fallbackEventName: string?
)
	local sfxRecipes = AudioService.GetRecipes(name, eventName, level)
	if not sfxRecipes and fallbackEventName then
		sfxRecipes = AudioService.GetRecipes(name, fallbackEventName, level)
	end

	if sfxRecipes then
		if delay and delay > 0 then
			TimeService.DeltaDelay(delay):andThen(function()
				AudioService.PlayFromRecipes(sfxRecipes, sourceModel, targetModel)
			end)
		else
			AudioService.PlayFromRecipes(sfxRecipes, sourceModel, targetModel)
		end
	end

	local vfxRecipes = VFXService.GetRecipes(name, eventName, level)
	if not vfxRecipes and fallbackEventName then
		vfxRecipes = VFXService.GetRecipes(name, fallbackEventName, level)
	end

	if vfxRecipes then
		VFXService.PlayVFX(vfxRecipes, sourceModel, targetModel, range, delay)
	end
end

return VisualService
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="398">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="Folder" referent="399">
          <Properties>
            <string name="Name">Core</string>
          </Properties>
          <Item class="ModuleScript" referent="400">
            <Properties>
              <string name="Name">BezierPath</string>
              <string name="Source"><![CDATA[local EPSILON = 100
local DEFAULT_CURVE_SIZE = 3
local CURVE_RESOLUTION = 1

type Section = {
	Positions: { Vector3 },
	Length: number,
	Type: number,
	TRanges: { number },
	AccumulatedDistance: number,
	DistanceLookup: { number },
}

type Methods = {
	CalculateUniformPosition: (self: Path, T: number) -> Vector3,
	CalculateUniformCFrame: (self: Path, T: number) -> CFrame,
	CalculateDerivative: (self: Path, T: number) -> Vector3,
	GetPathLength: (self: Path) -> number,
	CalculateClosestPoint: (self: Path, Position: Vector3, Iterations: number?) -> (CFrame, number),
	VisualizePath: (self: Path) -> (),
}

export type Path = {
	Sections: { Section },
	PathLength: number,
} & Methods

type Module = {
	new: (Waypoints: { Vector3 }, CurveSize: number) -> Path,
}

local BezierPath: Module = {} :: Module
local Methods: Methods = {} :: Methods

local function Map(Value: number, In_min: number, In_max: number, Out_min: number, Out_max: number): number
	return (Value - In_min) * (Out_max - Out_min) / (In_max - In_min) + Out_min
end

local function Bezier(p0: Vector3, p1: Vector3, p2: Vector3, t: number): Vector3
	return p1 + (1 - t) ^ 2 * (p0 - p1) + t ^ 2 * (p2 - p1)
end

local function BezierDerivative(p0: Vector3, p1: Vector3, p2: Vector3, t: number): Vector3
	return 2 * (1 - t) * (p1 - p0) + 2 * t * (p2 - p1)
end

local function Lerp(p0: Vector3, p1: Vector3, t: number): Vector3
	return p0 + t * (p1 - p0)
end

local function CalculateSectionPosition(Section: Section, T: number): Vector3
	local Positions = Section.Positions

	if Section.Type == 1 then
		return Lerp(Positions[1], Positions[2], T)
	else
		return Bezier(Positions[1], Positions[2], Positions[3], T)
	end
end

local function CalculateSectionDerivative(Section: Section, T: number): Vector3
	local Positions = Section.Positions

	return BezierDerivative(Positions[1], Positions[2], Positions[3], T)
end

local function CalculateSectionCFrame(Section: Section, T: number): CFrame
	local Position = CalculateSectionPosition(Section, T)
	local Derivative = CalculateSectionDerivative(Section, T)

	return CFrame.new(Position, Position + Derivative)
end

local function ClampCurveSize(Position1: Vector3, Position2: Vector3, CurveSize: number): number
	local Distance = (Position1 - Position2).Magnitude

	if Distance < CurveSize * 2 then
		return Distance / 2
	end

	return CurveSize
end

local function GetCurveSize(CurveSize: number | { number }, Index: number): number
	if typeof(CurveSize) == "number" then
		return CurveSize
	end

	return CurveSize[Index] or DEFAULT_CURVE_SIZE
end

local function SetupWaypoints(InputtedWaypoints: { Vector3 }, CurveSize: number | { number }): { Vector3 }
	local Waypoints = {}

	table.insert(Waypoints, InputtedWaypoints[1])

	for i = 2, #InputtedWaypoints - 1 do
		local GottenCurveSize = GetCurveSize(CurveSize, i - 1)
		local Position = InputtedWaypoints[i]
		local InputtedPreviousPosition = InputtedWaypoints[i - 1]
		local InputtedNextPosition = InputtedWaypoints[i + 1]

		local PreviousPosition = Position
			- (Position - InputtedPreviousPosition).Unit
				* ClampCurveSize(Position, InputtedPreviousPosition, GottenCurveSize)
		local NextPosition = Position
			- (Position - InputtedNextPosition).Unit
				* ClampCurveSize(Position, InputtedNextPosition, GottenCurveSize)

		table.insert(Waypoints, PreviousPosition)
		table.insert(Waypoints, Position)
		table.insert(Waypoints, NextPosition)
	end

	table.insert(Waypoints, InputtedWaypoints[#InputtedWaypoints])

	return Waypoints
end

local function CalculateSectionLength(Section: Section): number
	local Positions = Section.Positions

	if Section.Type == 1 then
		return (Positions[2] - Positions[1]).Magnitude
	else
		local Length = 0
		for T = 0, 1 - (1 / EPSILON), 1 / EPSILON do
			local Position1 = CalculateSectionPosition(Section, T)
			local Position2 = CalculateSectionPosition(Section, T + 1 / EPSILON)
			Length += (Position1 - Position2).Magnitude
		end
		return Length
	end
end

local function CalculatePathLength(Sections: { Section }): number
	local TotalLength = 0

	for _, Section in Sections do
		TotalLength += Section.Length
	end

	return TotalLength
end

local function CreateSectionsDistanceLookup(Sections: { Section })
	for _, Section in Sections do
		local AccumulatedDistance = Section.AccumulatedDistance

		if Section.Type == 1 then
			Section.DistanceLookup = { AccumulatedDistance, AccumulatedDistance + Section.Length }
			continue
		end

		local Segments = math.max(1, math.floor(Section.Length * CURVE_RESOLUTION))
		local PreviousPosition = CalculateSectionPosition(Section, 0)
		Section.DistanceLookup = table.create(Segments + 1)
		Section.DistanceLookup[1] = AccumulatedDistance

		for i = 1, Segments do
			local Position = CalculateSectionPosition(Section, i / Segments)
			local Distance = (Position - PreviousPosition).Magnitude
			AccumulatedDistance += Distance
			Section.DistanceLookup[i + 1] = AccumulatedDistance
			PreviousPosition = Position
		end
	end
end

local function CreateSections(BezierWaypoints: { Vector3 }): { Section }
	local Sections = {}

	local Index = 2
	local Step = 1

	while Index <= #BezierWaypoints do
		local SectionPositions = {}

		local PreviousPosition = BezierWaypoints[Index - 1]
		local Position = BezierWaypoints[Index]
		local NextPosition = BezierWaypoints[Index + 1]

		if Step == 1 then
			table.insert(SectionPositions, PreviousPosition)
			table.insert(SectionPositions, Position)
			table.insert(SectionPositions, Position)
		else
			table.insert(SectionPositions, PreviousPosition)
			table.insert(SectionPositions, Position)
			table.insert(SectionPositions, NextPosition)
		end

		local newSection = {
			AccumulatedDistance = 0,
			Positions = SectionPositions,
			Type = Step,
			Length = 0,
			TRanges = {},
			DistanceLookup = {},
		}

		newSection.Length = CalculateSectionLength(newSection)

		Index += Step
		Step = Step == 1 and 2 or 1

		table.insert(Sections, newSection)
	end

	return Sections
end

local function SetupSectionsT(PathLength: number, Sections: { Section })
	local AccumulatedT = 0

	for i = 1, #Sections do
		local Section = Sections[i]
		local PortionOfPath = Section.Length / PathLength
		Section.TRanges = { AccumulatedT, AccumulatedT + PortionOfPath }

		AccumulatedT += PortionOfPath
	end
end

local function SetupSectionsAccumulatedDistance(Sections: { Section })
	local AccumulatedDistance = 0

	for SectionIndex = 1, #Sections do
		local Section = Sections[SectionIndex]

		Section.AccumulatedDistance = AccumulatedDistance
		AccumulatedDistance += Section.Length
	end
end

local function MapT(Section: Section, PathLength: number, T: number): number
	if T >= 1 then
		return 1
	end
	if Section.Type == 1 then
		return ((T * PathLength) - Section.AccumulatedDistance) / Section.Length
	end

	local InputtedDistance = T * PathLength
	local Low = 1
	local High = #Section.DistanceLookup - 1

	while Low <= High do
		local i = math.floor((Low + High) / 2)
		local Distance = Section.DistanceLookup[i]
		local NextDistance = Section.DistanceLookup[i + 1]

		if InputtedDistance >= Distance and InputtedDistance <= NextDistance then
			local TotalSegments = #Section.DistanceLookup - 1

			return Map(InputtedDistance, Distance, NextDistance, (i - 1) / TotalSegments, i / TotalSegments)
		elseif InputtedDistance < Distance then
			High = i - 1
		else
			Low = i + 1
		end
	end

	return 1
end

local function GetSectionFromT(Sections: { Section }, T: number): Section
	for _, Section in Sections do
		if Section.TRanges[1] <= T and Section.TRanges[2] > T then
			return Section
		end
	end

	return Sections[#Sections]
end

local function LoadMethods(Object: {})
	for FunctionName, Function in Methods do
		Object[FunctionName] = Function
	end
end

function BezierPath.new(Waypoints: { Vector3 }, CurveSize: number | { number }): Path
	local BezierWaypoints = SetupWaypoints(Waypoints, CurveSize)

	local Sections = CreateSections(BezierWaypoints)
	local PathLength = CalculatePathLength(Sections)
	SetupSectionsT(PathLength, Sections)
	SetupSectionsAccumulatedDistance(Sections)
	CreateSectionsDistanceLookup(Sections)

	local newPath: Path = {
		Sections = Sections,
		PathLength = PathLength,
	} :: Path

	LoadMethods(newPath)

	return newPath
end

function Methods:GetPathLength(): number
	return self.PathLength
end

function Methods:CalculateUniformPosition(T: number): Vector3
	local Section = GetSectionFromT(self.Sections, T)
	local MappedT = MapT(Section, self.PathLength, T)

	return CalculateSectionPosition(Section, MappedT)
end

function Methods:CalculateUniformCFrame(T: number): CFrame
	local Section = GetSectionFromT(self.Sections, T)
	local MappedT = MapT(Section, self.PathLength, T)

	return CalculateSectionCFrame(Section, MappedT)
end

function Methods:CalculateDerivative(T: number): Vector3
	local Section = GetSectionFromT(self.Sections, T)
	local MappedT = MapT(Section, self.PathLength, T)

	return CalculateSectionDerivative(Section, MappedT)
end

function Methods:CalculateClosestPoint(Position: Vector3): (CFrame, number)
	local ClosestT = 0
	local ClosestDistance = math.huge

	for T = 0, 1, 1 / 100 do
		local PathPosition = self:CalculateUniformPosition(T)
		local Distance = (PathPosition - Position).Magnitude

		if Distance < ClosestDistance then
			ClosestDistance = Distance
			ClosestT = T
		end
	end

	return self:CalculateUniformCFrame(ClosestT), ClosestT
end

function Methods:VisualizePath()
	local isFirstSection = true

	for _, Section in self.Sections do
		if Section.Type == 1 then
			continue
		end
		local Segments = math.max(1, math.floor(Section.Length * CURVE_RESOLUTION))

		local startStep = isFirstSection and 0 or 1
		isFirstSection = false

		for i = startStep, Segments do
			local localT = i / Segments

			local Part = Instance.new("Part")
			Part.Anchored = true
			Part.Transparency = 0.5
			Part.CanCollide = false
			Part.Size = Vector3.one
			Part.Color = Color3.new(1, 0.235294, 0.247059)
			Part.Material = Enum.Material.SmoothPlastic

			Part.CFrame = CalculateSectionCFrame(Section, localT)
			Part.Parent = workspace
		end
	end
end

return BezierPath
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="401">
            <Properties>
              <string name="Name">FindTarget</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local EnemyService
-------------------------------------------------
--// TargetModes
-------------------------------------------------
local Closest = require(script.Mode.Closest)
local Farthest = require(script.Mode.Farthest)
local First = require(script.Mode.First)
local Last = require(script.Mode.Last)
local Strongest = require(script.Mode.Strongest)
local Weakest = require(script.Mode.Weakest)
local ServiceRegistry = require(script.Parent.ServiceRegistry)

local TargetModes = {
	["First"] = First,
	["Last"] = Last,
	["Strongest"] = Strongest,
	["Weakest"] = Weakest,
	["Closest"] = Closest,
	["Farthest"] = Farthest,
	Random = function(enemies)
		local count = TableUtils.Length(enemies)

		if next(enemies) then
			return enemies[Random.new():NextInteger(1, count)]
		else
			return nil
		end
	end,
}

-------------------------------------------------
--// FindTarget
-------------------------------------------------
local FindTarget = {}

function FindTarget.GetEnemiesInRange(self, range: number?)
	EnemyService = EnemyService or ServiceRegistry:GetService("EnemyService")

	local rangeLimit = range or self.Stats.Range

	local potentialEnemies = EnemyService.EnemyGrid:GetEntitiesInRange(self.Position, rangeLimit)

	local enemiesInRange = {}
	for _, enemy in potentialEnemies do
		if enemy.IsDead then
			continue
		end
		table.insert(enemiesInRange, enemy)
	end

	return enemiesInRange
end

function FindTarget.GetTarget(self, range: number?)
	local findFunction = TargetModes[self.TargetMode]
	if not findFunction then
		return nil
	end

	local enemies = FindTarget.GetEnemiesInRange(self, range)
	if self.TargetMode == "Random" then
		return findFunction(enemies)
	end

	local bestEnemy = nil
	for _, enemy in pairs(enemies) do
		if not bestEnemy or findFunction(self, bestEnemy, enemy) then
			bestEnemy = enemy
		end
	end

	return bestEnemy
end

function FindTarget.GetTargetInSplash(stats, targetPosition: Vector3)
	EnemyService = EnemyService or ServiceRegistry:GetService("EnemyService")
	local potentialEnemies = EnemyService.EnemyGrid:GetEntitiesInRange(targetPosition, stats.SplashRange)

	local enemiesInAOE = {}
	for _, enemy in potentialEnemies do
		if enemy.IsDead then
			continue
		end
		table.insert(enemiesInAOE, enemy)
	end

	return enemiesInAOE
end

function FindTarget.GetTargetInAngle(self, stats, startPosition: Vector3, targetPosition: Vector3)
	local enemiesInAngle = {}

	local flatTarget = Vector3.new(targetPosition.X, 0, targetPosition.Z)
	local flatStart = Vector3.new(startPosition.X, 0, startPosition.Z)
	local directionToMainTarget = (flatTarget - flatStart).Unit

	local cosAngle = math.cos(math.rad(stats.Angle / 2))

	for _, enemy in pairs(FindTarget.GetEnemiesInRange(self, stats.Range)) do
		if enemy.IsDead then
			continue
		end

		local directionToEnemy = (Vector3.new(enemy.Position.X, 0, enemy.Position.Z) - flatStart).Unit
		local enemyDot = directionToMainTarget:Dot(directionToEnemy)

		if enemyDot >= cosAngle then
			table.insert(enemiesInAngle, enemy)
		end
	end

	return enemiesInAngle
end

function FindTarget.GetTargetInLine(self, stats, targetPosition: Vector3)
	local enemiesInLine = {}

	local originPos = self.Position
	local targetPos = targetPosition

	local flatTargetPos = Vector3.new(targetPos.X, originPos.Y, targetPos.Z)
	local beamCFrame = CFrame.lookAt(originPos, flatTargetPos)

	for _, enemy in pairs(FindTarget.GetEnemiesInRange(self, stats.Range)) do
		if enemy.IsDead then
			continue
		end

		local localPos = beamCFrame:PointToObjectSpace(enemy.Position)

		if localPos.Z < 0 and math.abs(localPos.X) <= stats.Width / 2 then
			table.insert(enemiesInLine, enemy)
		end
	end

	return enemiesInLine
end

return FindTarget
]]></string>
            </Properties>
