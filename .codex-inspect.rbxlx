            <Item class="ModuleScript" referent="446">
              <Properties>
                <string name="Name">LocalEmotePlayer</string>
                <string name="Source"><![CDATA[--// Shared LocalEmotePlayer
-- Manages the local player's emote animation playback:
-- creating/playing/stopping tracks, saving/restoring walkspeed,
-- and auto-stopping on jump/freefall.
--
-- Does NOT handle networking or sprint control — that's the controller's job.
-- Exposes OnAutoStopped callback for the controller to hook into.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)

-------------------------------------------------
--// Types
-------------------------------------------------
type EmoteConfig = EmoteData.EmoteConfig

-------------------------------------------------
--// Constants
-------------------------------------------------
local EMOTE_COOLDOWN = 0.2
local localPlayer = Players.LocalPlayer

-------------------------------------------------
--// LocalEmotePlayer Class
-------------------------------------------------
local LocalEmotePlayer = {}
LocalEmotePlayer.__index = LocalEmotePlayer

export type LocalEmotePlayer = typeof(setmetatable({} :: {
	CurrentEmoteId: string?,
	CurrentTrack: AnimationTrack?,
	Connections: { RBXScriptConnection },
	SavedWalkSpeed: number?,
	LastEmoteTime: number,
	OnAutoStopped: (() -> ())?,
}, LocalEmotePlayer))

function LocalEmotePlayer.new(): LocalEmotePlayer
	return setmetatable({
		CurrentEmoteId = nil :: string?,
		CurrentTrack = nil :: AnimationTrack?,
		Connections = {} :: { RBXScriptConnection },
		SavedWalkSpeed = nil :: number?,
		LastEmoteTime = 0 :: number,
		OnAutoStopped = nil :: (() -> ())?,
	}, LocalEmotePlayer)
end

-------------------------------------------------
--// Public Methods
-------------------------------------------------

--[[ Returns true if cooldown has elapsed since the last emote request. ]]
function LocalEmotePlayer.CheckCooldown(self: LocalEmotePlayer): boolean
	local now = os.clock()
	if now - self.LastEmoteTime < EMOTE_COOLDOWN then
		return false
	end
	self.LastEmoteTime = now
	return true
end

--[[ Starts playing an emote animation on the local character.
     Skips if the same emote is already playing. ]]
function LocalEmotePlayer.Start(self: LocalEmotePlayer, emoteId: string, emoteConfig: EmoteConfig): boolean
	if self.CurrentEmoteId == emoteId and self.CurrentTrack and self.CurrentTrack.IsPlaying then
		return true
	end

	self:Stop()

	local character = localPlayer.Character
	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator or not humanoid then
		return false
	end

	-- Save walkspeed before modification
	if self.SavedWalkSpeed == nil then
		self.SavedWalkSpeed = humanoid.WalkSpeed
	end

	if emoteConfig.WalkSpeed then
		humanoid.WalkSpeed = emoteConfig.WalkSpeed
	end

	-- Auto-stop on jump or freefall
	local jumpConn = humanoid.Jumping:Connect(function(isJumping: boolean)
		if isJumping then
			self:_autoStop()
		end
	end)
	table.insert(self.Connections, jumpConn)

	local stateConn = humanoid.StateChanged:Connect(function(_, newState: Enum.HumanoidStateType)
		if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
			self:_autoStop()
		end
	end)
	table.insert(self.Connections, stateConn)

	-- Create and play animation
	local animation = Instance.new("Animation")
	animation.AnimationId = tostring(emoteConfig.AnimationId)
	animation.Parent = animator -- Prevent garbage collection

	local track = animator:LoadAnimation(animation)
	track.Priority = emoteConfig.Priority or Enum.AnimationPriority.Action
	track:AdjustSpeed(emoteConfig.PlaybackSpeed or 1)
	track:Play()

	self.CurrentTrack = track
	self.CurrentEmoteId = emoteId

	-- Auto-stop when track naturally ends
	local stopConn = track.Stopped:Once(function()
		if self.CurrentTrack == track then
			self:_autoStop()
		end
	end)
	table.insert(self.Connections, stopConn)

	return true
end

--[[ Stops the current emote and restores walkspeed.
     Does not trigger OnAutoStopped. ]]
function LocalEmotePlayer.Stop(self: LocalEmotePlayer)
	for _, conn in ipairs(self.Connections) do
		conn:Disconnect()
	end
	table.clear(self.Connections)

	if self.CurrentTrack then
		self.CurrentTrack:Stop(0)
		pcall(function()
			self.CurrentTrack:Destroy()
		end)
		self.CurrentTrack = nil
	end
	self.CurrentEmoteId = nil

	local character = localPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and self.SavedWalkSpeed ~= nil then
			humanoid.WalkSpeed = self.SavedWalkSpeed
		end
	end
	self.SavedWalkSpeed = nil
end

--[[ Returns true if an emote is currently playing. ]]
function LocalEmotePlayer.IsPlaying(self: LocalEmotePlayer): boolean
	return self.CurrentEmoteId ~= nil
end

-------------------------------------------------
--// Private Methods
-------------------------------------------------

--[[ Called on jump/freefall/track-end. Stops locally and notifies controller via callback. ]]
function LocalEmotePlayer._autoStop(self: LocalEmotePlayer)
	local hadEmote = self.CurrentEmoteId ~= nil
	self:Stop()

	if hadEmote and self.OnAutoStopped then
		self.OnAutoStopped()
	end
end

return LocalEmotePlayer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="447">
              <Properties>
                <string name="Name">PlayerCharacter</string>
                <string name="Source"><![CDATA[-- Shared character preview used by lobby and in-game emote wheels.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local source = Vide.source
local effect = Vide.effect
local cleanup = Vide.cleanup
local read = Vide.read

local characterCache: { [number]: Model } = {}
local loadingCallbacks: { [number]: { (Model) -> () } } = {}

export type Props = {
	UserId: (number | (() -> number))?,
	Origin: (CFrame | (() -> CFrame))?,
	UseWorldModel: (boolean | (() -> boolean))?,
	Children: any?,
	AnimationId: (number | string | (() -> number | string))?,
	PlaybackSpeed: number?,
}

local function fetchCharacterModel(userId: number, callback: (Model) -> ())
	local cachedModel = characterCache[userId]
	if cachedModel then
		callback(cachedModel:Clone())
		return
	end

	if loadingCallbacks[userId] then
		table.insert(loadingCallbacks[userId], callback)
		return
	end

	loadingCallbacks[userId] = { callback }

	task.spawn(function()
		local success, result = pcall(function()
			local description = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
			local r6Model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)

			return r6Model
		end)

		local callbacks = loadingCallbacks[userId]
		loadingCallbacks[userId] = nil

		if not success or not result then
			warn(`[PlayerCharacter] Failed to load character model for UserId {userId}: {result}`)
			return
		end

		if result.HumanoidRootPart then
			result.HumanoidRootPart.Anchored = true
		end

		local animateScript = result:FindFirstChild("Animate")
		if animateScript then
			animateScript:Destroy()
		end

		local healthScript = result:FindFirstChild("Health")
		if healthScript then
			healthScript:Destroy()
		end

		characterCache[userId] = result

		for _, cb in callbacks do
			cb(result:Clone())
		end
	end)
end

local function resetPose(model: Model, origin: CFrame?)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			descendant.Transform = CFrame.new()
		end
	end
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and origin then
		hrp.CFrame = origin
	elseif origin then
		model:PivotTo(origin)
	end
end

return function(props: Props)
	local userId = read(props.UserId) or (Players.LocalPlayer and Players.LocalPlayer.UserId) or 1
	local useWorldModel = read(props.UseWorldModel)
	local containerType = if useWorldModel then "WorldModel" else "Model"
	local character = source(nil :: Model?)

	fetchCharacterModel(userId, function(clonedModel)
		character(clonedModel)
	end)

	effect(function()
		local model = character()
		if not model then
			return
		end

		local origin = read(props.Origin) or CFrame.new(0, 0, 0)
		resetPose(model, origin)

		local rawAnimId = read(props.AnimationId)
		local playbackSpeed = read(props.PlaybackSpeed) or 1
		if not rawAnimId or rawAnimId == "" then
			return
		end

		local track
		local animation
		local active = true

		task.spawn(function()
			while active and not model:IsDescendantOf(game) do
				model.AncestryChanged:Wait()
			end
			if not active then
				return
			end

			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if not humanoid then
				return
			end

			local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
			animator.Parent = humanoid

			local animId = tostring(rawAnimId)
			animation = Instance.new("Animation")
			animation.AnimationId = if string.sub(animId, 1, 13) == "rbxassetid://"
				then animId
				else `rbxassetid://{animId}`

			track = animator:LoadAnimation(animation)
			track.Looped = true
			track.Priority = Enum.AnimationPriority.Action4
			track:AdjustSpeed(playbackSpeed)
			track:Play()
		end)

		cleanup(function()
			active = false
			if track then
				track:Stop()
				track:Destroy()
			end
			if animation then
				animation:Destroy()
			end
			if model and model.Parent then
				resetPose(model, origin)
			end
		end)
	end)

	cleanup(function()
		local model = character()
		if model then
			model:Destroy()
		end
	end)

	return create(containerType)({
		character,
		props.Children,
	})
end
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="448">
            <Properties>
              <string name="Name">Hooks</string>
            </Properties>
            <Item class="ModuleScript" referent="449">
              <Properties>
                <string name="Name">useButtonEffect</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)

local source = Vide.source
local spring = Vide.spring
local action = Vide.action
local create = Vide.create

local function useButtonEffect(pressedScale: number?, hoverScale: number?)
	local pScale = pressedScale or 0.95
	local hScale = hoverScale or 1.05

	return action(function(button: GuiButton)
		local isPressed = source(false)
		local isHovered = source(false)
		local isClicked = source(false)

		local down = button.MouseButton1Down:Connect(function()
			isPressed(true)
		end)

		local up = button.MouseButton1Up:Connect(function()
			isPressed(false)
		end)

		local enter = button.MouseEnter:Connect(function()
			isHovered(true)
		end)

		local leave = button.MouseLeave:Connect(function()
			isHovered(false)
			isPressed(false)
		end)

		local click = button.MouseButton1Click:Connect(function()
			isClicked(true)
			task.delay(0.05, function()
				isClicked(false)
			end)
		end)

		local scale = create("UIScale")({
			Parent = button,
			Scale = spring(function()
				if isPressed() or isClicked() then
					return pScale
				elseif isHovered() then
					return hScale
				end
				return 1
			end, 0.15, 0.5),
		})

		Vide.cleanup(function()
			down:Disconnect()
			up:Disconnect()
			enter:Disconnect()
			leave:Disconnect()
			click:Disconnect()
			scale:Destroy()
		end)
	end)
end

return useButtonEffect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="450">
              <Properties>
                <string name="Name">useColorSequenceCycle</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Vide = require(ReplicatedStorage.Packages.Vide)

local action = Vide.action
local cleanup = Vide.cleanup

type Reactive<T> = T | (() -> T)

type CycleState = {
	colorSequence: Reactive<ColorSequence>,
	transitionTime: Reactive<number>?,
	enabled: Reactive<boolean>?,
	activeSequence: ColorSequence,
	cycleStartedAt: number,
}

local UPDATE_INTERVAL = 1 / 30
local cycleStates: { [UIGradient]: CycleState } = {}
local renderConnection: RBXScriptConnection? = nil
local accumulatedTime = 0
local schedulerTime = 0

local function read<T>(value: Reactive<T>): T
	return if type(value) == "function" then (value :: () -> T)() else value
end

local function getCycledSequence(colorSequence: ColorSequence, elapsed: number, transitionTime: number): ColorSequence
	local keypoints = colorSequence.Keypoints
	local keypointCount = #keypoints
	if keypointCount < 2 then
		return colorSequence
	end

	local cycleProgress = (elapsed / transitionTime) % keypointCount
	local colorOffset = math.floor(cycleProgress)
	local alpha = cycleProgress - colorOffset
	local cycledKeypoints = table.create(keypointCount)

	for index, keypoint in keypoints do
		local currentIndex = ((index + colorOffset - 1) % keypointCount) + 1
		local nextIndex = (currentIndex % keypointCount) + 1
		local currentColor = keypoints[currentIndex].Value
		local nextColor = keypoints[nextIndex].Value

		cycledKeypoints[index] = ColorSequenceKeypoint.new(keypoint.Time, currentColor:Lerp(nextColor, alpha))
	end

	return ColorSequence.new(cycledKeypoints)
end

local function overlapsScrollingViewport(target: GuiObject, scrollingFrame: ScrollingFrame): boolean
	local targetMin = target.AbsolutePosition
	local targetMax = targetMin + target.AbsoluteSize
	local viewportMin = scrollingFrame.AbsolutePosition
	local viewportMax = viewportMin + scrollingFrame.AbsoluteWindowSize

	return targetMax.X > viewportMin.X
		and targetMin.X < viewportMax.X
		and targetMax.Y > viewportMin.Y
		and targetMin.Y < viewportMax.Y
end

local function isVisibleOnScreen(gradient: UIGradient): boolean
	if not gradient.Enabled then
		return false
	end

	local target = gradient.Parent
	if not target or not target:IsA("GuiObject") then
		return false
	end

	if target.AbsoluteSize.X <= 0 or target.AbsoluteSize.Y <= 0 then
		return false
	end

	local ancestor: Instance? = target
	while ancestor do
		if ancestor:IsA("GuiObject") then
			if not ancestor.Visible then
				return false
			end

			if ancestor:IsA("ScrollingFrame") and not overlapsScrollingViewport(target, ancestor) then
				return false
			end
		elseif ancestor:IsA("LayerCollector") and not ancestor.Enabled then
			return false
		end

		ancestor = ancestor.Parent
	end

	return true
end

local function stopSchedulerIfIdle()
	if next(cycleStates) ~= nil or not renderConnection then
		return
	end

	renderConnection:Disconnect()
	renderConnection = nil
	accumulatedTime = 0
end

local function startScheduler()
	if renderConnection then
		return
	end

	renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
		schedulerTime += deltaTime
		accumulatedTime += deltaTime

		if accumulatedTime < UPDATE_INTERVAL then
			return
		end

		accumulatedTime %= UPDATE_INTERVAL

		for gradient, state in cycleStates do
			if not gradient.Parent then
				cycleStates[gradient] = nil
				continue
			end

			if not isVisibleOnScreen(gradient) then
				continue
			end

			local nextSequence = read(state.colorSequence)
			if nextSequence ~= state.activeSequence then
				state.activeSequence = nextSequence
				state.cycleStartedAt = schedulerTime
			end

			if state.enabled and not read(state.enabled) then
				gradient.Color = state.activeSequence
				continue
			end

			local duration = math.max(if state.transitionTime then read(state.transitionTime) else 1, 0.01)
			local elapsed = schedulerTime - state.cycleStartedAt
			gradient.Color = getCycledSequence(state.activeSequence, elapsed, duration)
		end

		stopSchedulerIfIdle()
	end)
end

--[[
	create("UIGradient")({
		useColorSequenceCycle(ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 75, 75)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(115, 34, 34)),
		}), 0.8),
	})

	transitionTime is the time in seconds for each keypoint color to reach the next color.
	enabled can pause updates while the UI is hidden.
]]

local function useColorSequenceCycle(
	colorSequence: Reactive<ColorSequence>,
	transitionTime: Reactive<number>?,
	enabled: Reactive<boolean>?
)
	return action(function(instance: Instance)
		assert(instance:IsA("UIGradient"))

		local gradient = instance :: UIGradient
		local activeSequence = read(colorSequence)
		local state: CycleState = {
			colorSequence = colorSequence,
			transitionTime = transitionTime,
			enabled = enabled,
			activeSequence = activeSequence,
			cycleStartedAt = schedulerTime,
		}

		gradient.Color = activeSequence
		cycleStates[gradient] = state
		startScheduler()

		cleanup(function()
			if cycleStates[gradient] == state then
				cycleStates[gradient] = nil
			end

			stopSchedulerIfIdle()
		end)
	end)
end

return useColorSequenceCycle
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="451">
              <Properties>
                <string name="Name">useDiagonalShine</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

export type ShineMotion = {
	startPosition: UDim2?,
	endPosition: UDim2?,
	duration: number?,
	restInterval: number?,
}

local START_POSITION = UDim2.fromScale(-0.25, 0.5)
local END_POSITION = UDim2.fromScale(1.25, 0.5)
local TRAVEL_DURATION = 0.62
local REST_INTERVAL = 3.4

return function(
	getActive: Reactive<boolean>,
	getSpeed: Reactive<number>?,
	initialDelay: number?,
	motion: ShineMotion?
)
	return action(function(instance: Instance)
		assert(instance:IsA("GuiObject"), "useDiagonalShine must be used on a GuiObject")

		local shine = instance :: GuiObject
		local startPosition = if motion and motion.startPosition then motion.startPosition else START_POSITION
		local endPosition = if motion and motion.endPosition then motion.endPosition else END_POSITION
		local travelDuration = if motion and motion.duration then motion.duration else TRAVEL_DURATION
		local restInterval = if motion and motion.restInterval then motion.restInterval else REST_INTERVAL
		local isAlive = true
		local activeTween: Tween? = nil
		shine.Position = startPosition
		shine.Visible = false

		local shineThread = task.spawn(function()
			task.wait(initialDelay or 0)

			while isAlive and shine.Parent do
				if not read(getActive) then
					task.wait(0.2)
					continue
				end

				local speed = if getSpeed then math.max(read(getSpeed), 0.35) else 1
				shine.Position = startPosition
				shine.Visible = true

				local tween = TweenService:Create(
					shine,
					TweenInfo.new(travelDuration / speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ Position = endPosition }
				)
				activeTween = tween
				tween:Play()
				tween.Completed:Wait()
				activeTween = nil
				shine.Visible = false

				task.wait(restInterval / math.sqrt(speed))
			end
		end)

		cleanup(function()
			isAlive = false
			if activeTween then
				activeTween:Cancel()
				activeTween = nil
			end
			pcall(task.cancel, shineThread)
			shine.Visible = false
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="452">
              <Properties>
                <string name="Name">useIsInScrollWindow</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local IsInScrollWindow = require(script.Parent.Parent.IsInScrollWindow)

local action = Vide.action
local cleanup = Vide.cleanup
local source = Vide.source

type CacheEntry = {
	isInView: (() -> boolean) & ((boolean) -> boolean),
	users: number,
	disconnect: () -> (),
}

local cache: { [GuiObject]: CacheEntry } = {}

local function createEntry(instance: GuiObject): CacheEntry
	local isInView = source(false)
	local scrollFrame: ScrollingFrame? = nil
	local scrollConnections: { RBXScriptConnection } = {}

	local function clearScrollConnections()
		for _, connection in scrollConnections do
			connection:Disconnect()
		end

		table.clear(scrollConnections)
	end

	local function update()
		isInView(if scrollFrame then IsInScrollWindow(scrollFrame, instance) else false)
	end

	local function connectScrollFrame()
		local ancestor = instance:FindFirstAncestorOfClass("ScrollingFrame")
		if ancestor == scrollFrame then
			update()
			return
		end

		clearScrollConnections()
		scrollFrame = ancestor

		if not scrollFrame then
			update()
			return
		end

		table.insert(scrollConnections, scrollFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(update))

		table.insert(scrollConnections, scrollFrame:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(update))

		table.insert(scrollConnections, scrollFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(update))

		update()
	end

	local connections = {
		instance:GetPropertyChangedSignal("AbsolutePosition"):Connect(update),
		instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(update),
		instance.AncestryChanged:Connect(connectScrollFrame),
	}

	connectScrollFrame()

	local function disconnect()
		clearScrollConnections()

		for _, connection in connections do
			connection:Disconnect()
		end
	end

	return {
		["isInView"] = isInView,
		users = 0,
		disconnect = disconnect,
	}
end

local function useIsInScrollWindow()
	local currentEntry = source(nil :: CacheEntry?)

	local function isInView(): boolean
		local entry = currentEntry()
		return if entry then entry.isInView() else false
	end

	local bind = action(function(instance: GuiObject)
		local entry = cache[instance]
		if not entry then
			entry = createEntry(instance)
			cache[instance] = entry
		end

		entry.users += 1
		currentEntry(entry)

		cleanup(function()
			entry.users -= 1
			if entry.users == 0 then
				entry.disconnect()
				cache[instance] = nil
			end
		end)
	end)

	return isInView, bind
end

return useIsInScrollWindow
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="453">
              <Properties>
                <string name="Name">useRarityShine</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

local SHINE_COLORS = {
	Common = Color3.fromRGB(50, 45, 45),
	Rare = Color3.fromRGB(29, 34, 176),
	Epic = Color3.fromRGB(68, 59, 170),
	Legendary = Color3.fromRGB(158, 63, 153),
	Mythic = Color3.fromRGB(106, 67, 28),
	Exclusive = Color3.fromRGB(17, 0, 1),
	Absolute = Color3.fromRGB(233, 93, 224),
}

local SHINE_SPEED = 10
local SHINE_INTERVAL = 2
local SHINE_WIDTH = 1.1
local SHINE_HEIGHT = 1.55
local SHINE_TRANSPARENCY = 0.1
local START_X = -1.4
local END_X = 1.4

local function useRarityShine(getRarity: Reactive<string>)
	return action(function(instance: Instance)
		assert(instance:IsA("CanvasGroup"), "useRarityShine must be used on a CanvasGroup")

		local frame = instance :: CanvasGroup
		frame.ClipsDescendants = true

		local oldEffect = frame:FindFirstChild("ShineEffect")
		if oldEffect then
			oldEffect:Destroy()
		end

		local shineFolder = Instance.new("Folder")
		shineFolder.Name = "ShineEffect"
		shineFolder.Parent = frame

		local originalCorner = frame:FindFirstChildOfClass("UICorner")
		local shineNumber = 0
		local isAlive = true

		local function createShine()
			if not isAlive or not frame.Parent then
				return
			end

			shineNumber += 1

			local shine = Instance.new("Frame")
			shine.Name = `Shine_{shineNumber}`
			shine.BackgroundTransparency = 1
			shine.BorderSizePixel = 0
			shine.ClipsDescendants = true
			shine.Position = UDim2.fromScale(0, 0)
			shine.Size = UDim2.fromScale(1, 1)
			shine.ZIndex = 1
			shine.Parent = shineFolder

			if originalCorner then
				originalCorner:Clone().Parent = shine
			end

			local light = Instance.new("Frame")
			light.Name = "SoftGlow"
			local rarity = read(getRarity)
			light.BackgroundColor3 = SHINE_COLORS[rarity] or SHINE_COLORS.Common
			light.BackgroundTransparency = SHINE_TRANSPARENCY
			light.BorderSizePixel = 0
			light.Position = UDim2.fromScale(START_X, -0.275)
			light.Rotation = 18
			light.Size = UDim2.fromScale(SHINE_WIDTH, SHINE_HEIGHT)
			light.ZIndex = 2
			light.Parent = shine

			local gradient = Instance.new("UIGradient")
			gradient.Color = ColorSequence.new(Color3.new(1, 1, 1))
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.1, 1),
				NumberSequenceKeypoint.new(0.25, 0.97),
				NumberSequenceKeypoint.new(0.35, 0.88),
				NumberSequenceKeypoint.new(0.42, 0.7),
				NumberSequenceKeypoint.new(0.5, 0.52),
				NumberSequenceKeypoint.new(0.58, 0.7),
				NumberSequenceKeypoint.new(0.65, 0.88),
				NumberSequenceKeypoint.new(0.75, 0.97),
				NumberSequenceKeypoint.new(0.9, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = light

			local tween = TweenService:Create(
				light,
				TweenInfo.new(SHINE_SPEED, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
				{ Position = UDim2.fromScale(END_X, -0.275) }
			)

			tween.Completed:Connect(function()
				if shine.Parent then
					shine:Destroy()
				end
			end)
			tween:Play()
		end

		task.spawn(function()
			while isAlive and frame.Parent do
				createShine()
				task.wait(SHINE_INTERVAL)
			end
		end)

		cleanup(function()
			isAlive = false
			shineFolder:Destroy()
		end)
	end)
end

return useRarityShine
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="454">
              <Properties>
                <string name="Name">useRarityTextShimmer</string>
                <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local RarityGradient = require(ReplicatedStorage.Settings.Visuals.RarityGradient)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

local GOLD_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 248, 195)),
	ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 220, 85)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 178, 45)),
})

local function getCycledSequence(colorSequence: ColorSequence, elapsed: number, transitionTime: number): ColorSequence
	local keypoints = colorSequence.Keypoints
	local keypointCount = #keypoints
	if keypointCount < 2 then
		return colorSequence
	end

	local cycleProgress = (elapsed / transitionTime) % keypointCount
	local colorOffset = math.floor(cycleProgress)
	local alpha = cycleProgress - colorOffset
	local cycledKeypoints = table.create(keypointCount)

	for index, keypoint in keypoints do
		local currentIndex = ((index + colorOffset - 1) % keypointCount) + 1
		local nextIndex = (currentIndex % keypointCount) + 1
		local currentColor = keypoints[currentIndex].Value
		local nextColor = keypoints[nextIndex].Value

		cycledKeypoints[index] = ColorSequenceKeypoint.new(keypoint.Time, currentColor:Lerp(nextColor, alpha))
	end

	return ColorSequence.new(cycledKeypoints)
end

local function useGradientShimmer(
	getSequence: Reactive<ColorSequence>,
	getActive: Reactive<boolean>,
	getSpeed: Reactive<number>?
)
	return action(function(instance: Instance)
		assert(instance:IsA("UIGradient"), "useGradientShimmer must be used on a UIGradient")

		local gradient = instance :: UIGradient
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed += deltaTime

			local sequence = read(getSequence)
			local speed = if getSpeed then math.max(read(getSpeed), 0.2) else 0.75

			if read(getActive) then
				gradient.Rotation = (elapsed * 18 * speed) % 360
				gradient.Color = getCycledSequence(sequence, elapsed, 1.8 / speed)
			else
				gradient.Rotation = 90
				gradient.Color = sequence
			end
		end)

		cleanup(connection)
	end)
end

local function useRarityTextShimmer(
	getRarity: Reactive<string>,
	getActive: Reactive<boolean>,
	getSpeedScale: Reactive<number>?
)
	return action(function(instance: Instance)
		assert(instance:IsA("UIGradient"), "useRarityTextShimmer must be used on a UIGradient")

		local gradient = instance :: UIGradient
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed += deltaTime

			local rarity = read(getRarity)
			local sequence = RarityGradient.Gradients[rarity] or RarityGradient.Gradients.Common
			local speed = (RarityGradient.ShimmerSpeed[rarity] or 1) * (if getSpeedScale then read(getSpeedScale) else 1)

			if read(getActive) then
				gradient.Rotation = (elapsed * 24 * speed) % 360
				gradient.Color = getCycledSequence(sequence, elapsed, 1.55 / speed)
			else
				gradient.Rotation = 90
				gradient.Color = sequence
			end
		end)

		cleanup(connection)
	end)
end

local function useShineSweep(getActive: Reactive<boolean>, getSpeed: Reactive<number>?)
	return action(function(instance: Instance)
		assert(instance:IsA("GuiObject"), "useShineSweep must be used on a GuiObject")

		local target = instance :: GuiObject
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			if not read(getActive) then
				return
			end

			local speed = if getSpeed then math.max(read(getSpeed), 0.15) else 1
			elapsed += deltaTime * speed
			local progress = (elapsed % 2.1) / 2.1
			target.Position = UDim2.fromScale(0.06 + progress * 0.88, 0.5)
		end)

		cleanup(connection)
	end)
end

local function useRarityBorderPulse(getRarity: Reactive<string>, getActive: Reactive<boolean>, getIntensity: Reactive<number>?)
	return action(function(instance: Instance)
		assert(instance:IsA("UIStroke"), "useRarityBorderPulse must be used on a UIStroke")

		local stroke = instance :: UIStroke
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed += deltaTime

			if not read(getActive) then
				stroke.Transparency = 1
				return
			end

			local rarity = read(getRarity)
			local glow = RarityGradient.Glow[rarity] or RarityGradient.Glow.Common
			local speed = RarityGradient.ShimmerSpeed[rarity] or 1
			local intensity = if getIntensity then read(getIntensity) else 1
			local pulse = (math.sin(elapsed * 3.4 * speed) + 1) * 0.5

			stroke.Color = glow
			stroke.Transparency = 1 - (0.12 + pulse * 0.28) * intensity
		end)

		cleanup(connection)
	end)
end

return {
	Text = useRarityTextShimmer,
	Sweep = useShineSweep,
	BorderPulse = useRarityBorderPulse,
	Gold = function(getActive: Reactive<boolean>, getSpeed: Reactive<number>?)
		return useGradientShimmer(function()
			return GOLD_GRADIENT
		end, getActive, getSpeed)
	end,
	GoldGradient = GOLD_GRADIENT,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="455">
              <Properties>
                <string name="Name">useScale</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local SettingsClient = require(ReplicatedStorage.Shared.Services.System.SettingsClient)

local source = Vide.source
local create = Vide.create
local action = Vide.action
local cleanup = Vide.cleanup

local function useScale()
	return action(function(instance: GuiObject)
		local scaleValue = source(1)

		task.spawn(function()
			local settings = SettingsClient.GetSettings()
			if settings and settings.UIScale ~= nil then
				scaleValue(settings.UIScale / 100)
			end
		end)

		local connection = SettingsClient:GetChangedSignal("UIScale"):Connect(function(newValue)
			if type(newValue) == "number" then
				scaleValue(newValue / 100)
			end
		end)

		local scale = create("UIScale")({
			Parent = instance,
			Scale = scaleValue,
		})

		cleanup(function()
			connection:Disconnect()
			scale:Destroy()
		end)
	end)
end

return useScale
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="456">
              <Properties>
                <string name="Name">useSlider</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Vide = require(ReplicatedStorage.Packages.Vide)

local cleanup = Vide.cleanup
local source = Vide.source

local function updateSliderPosition(inputPosition: Vector3, slider: Frame, handler: GuiButton, valueSource: any)
	local mouseX = inputPosition.X
	local frameLeft = slider.AbsolutePosition.X
	local frameWidth = slider.AbsoluteSize.X

	local percentage = math.clamp((mouseX - frameLeft) / frameWidth, 0, 1)

	handler.Position = UDim2.new(percentage, 0, handler.Position.Y.Scale, handler.Position.Y.Offset)

	if valueSource then
		valueSource(math.floor(percentage * 100))
	end
end

return function(props: { Slider: Frame, Handler: GuiButton, Process: any?, OnRelease: ((value: number) -> ())? })
	local slider = props.Slider
	local handler = props.Handler
	local valueSource = props.Process
	local onRelease = props.OnRelease

	local isDragging = source(false)

	local function stopDragging()
		if isDragging() then
			isDragging(false)

			if onRelease and valueSource then
				onRelease(valueSource())
			end
		end
	end

	local sliderBegan = slider.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			isDragging(true)
			updateSliderPosition(input.Position, slider, handler, valueSource)
		end
	end)

	local handlerBegan = handler.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			isDragging(true)
		end
	end)

	local handlerUp = handler.MouseButton1Up:Connect(function()
		stopDragging()
	end)

	local inputEnded = UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stopDragging()
		end
	end)

	local inputChanged = UserInputService.InputChanged:Connect(function(input)
		if not isDragging() then
			return
		end

		if
			input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		updateSliderPosition(input.Position, slider, handler, valueSource)
	end)

	local disconnectAll = function()
		sliderBegan:Disconnect()
		handlerBegan:Disconnect()
		handlerUp:Disconnect()
		inputEnded:Disconnect()
		inputChanged:Disconnect()
	end

	local hasCleanupScope = pcall(function()
		cleanup(disconnectAll)
	end)

	if not hasCleanupScope then
		return disconnectAll
	end

	return nil
end
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="457">
            <Properties>
              <string name="Name">IsInScrollWindow</string>
              <string name="Source"><![CDATA[return function(scrollFrame: ScrollingFrame, button: GuiObject): boolean
	local framePos = scrollFrame.AbsolutePosition
	local frameSize = scrollFrame.AbsoluteWindowSize

	local buttonPos = button.AbsolutePosition
	local buttonSize = button.AbsoluteSize

	return buttonPos.X < framePos.X + frameSize.X
		and buttonPos.X + buttonSize.X > framePos.X
		and buttonPos.Y < framePos.Y + frameSize.Y
		and buttonPos.Y + buttonSize.Y > framePos.Y
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="458">
            <Properties>
              <string name="Name">PlayerOverheadService</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")

local GROUP_ID = 492293332
local DEVELOPER_MIN_RANK = 250
local DEFAULT_LEVEL = 1

local DISPLAY_DISTANCE = 100
-- Scale components on a BillboardGui are measured in world-space studs.
-- This makes the whole tag naturally shrink as the camera moves away.
local BILLBOARD_SIZE = UDim2.new(3.4, 0, 1.2, 0)
local BILLBOARD_OFFSET = Vector3.new(0, 2.55, 0)
local DISPLAY_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json")

type PlayerState = {
	billboard: BillboardGui?,
	titleLabel: TextLabel?,
	levelLabel: TextLabel?,
	titleConnection: RBXScriptConnection?,
	levelConnection: RBXScriptConnection?,
	leaderstatsConnection: RBXScriptConnection?,
	playerChildConnection: RBXScriptConnection?,
	characterConnection: RBXScriptConnection?,
}

local PlayerOverheadService = {}
local playerStates: { [Player]: PlayerState } = {}

local function disconnect(connection: RBXScriptConnection?)
	if connection then
		connection:Disconnect()
	end
end

local function addTextStroke(label: TextLabel, thicknessScale: number)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Color = Color3.fromRGB(12, 10, 18)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize
	stroke.Thickness = thicknessScale
	stroke.Transparency = 0
	stroke.Parent = label
end

local function createLabel(name: string, heightScale: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, heightScale)
	label.FontFace = DISPLAY_FONT
	label.TextScaled = true
	label.RichText = true
	label.TextWrapped = false
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center

	return label
end

local function escapeRichText(value: string): string
	return value:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
end

local function refreshTitle(player: Player)
	local state = playerStates[player]
	if not state or not state.titleLabel then return end
	local title = player:GetAttribute("ChatRoleTag")
	local visible = type(title) == "string" and title ~= ""
	state.titleLabel.Text = if visible then escapeRichText(title) else ""
	state.titleLabel.Visible = visible
end

local function currentLevel(player: Player): number
	local leaderstats = player:FindFirstChild("leaderstats")
	local levelValue = leaderstats and leaderstats:FindFirstChild("Level")
	if levelValue and levelValue:IsA("IntValue") then
		return math.max(1, levelValue.Value)
	end

	return DEFAULT_LEVEL
end

local function refreshLevel(player: Player)
	local state = playerStates[player]
	if state and state.levelLabel then
		state.levelLabel.Text = `Level {currentLevel(player)}`
	end
end

local function bindLevelValue(player: Player, levelValue: Instance?)
	local state = playerStates[player]
	if not state then
		return
	end

	disconnect(state.levelConnection)
	state.levelConnection = nil

	if levelValue and levelValue:IsA("IntValue") then
		state.levelConnection = levelValue:GetPropertyChangedSignal("Value"):Connect(function()
			refreshLevel(player)
		end)
	end

	refreshLevel(player)
end

local function bindLeaderstats(player: Player, leaderstats: Instance?)
	local state = playerStates[player]
	if not state then
		return
	end

	disconnect(state.leaderstatsConnection)
	state.leaderstatsConnection = nil

	if leaderstats then
		bindLevelValue(player, leaderstats:FindFirstChild("Level"))
		state.leaderstatsConnection = leaderstats.ChildAdded:Connect(function(child)
			if child.Name == "Level" then
				bindLevelValue(player, child)
			end
		end)
	else
		bindLevelValue(player, nil)
	end
end

local function createOverhead(player: Player, character: Model)
	local state = playerStates[player]
	if not state then
		return
	end

	local head = character:WaitForChild("Head", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not head or not head:IsA("BasePart") or not humanoid or not humanoid:IsA("Humanoid") then
		return
	end

	if player.Character ~= character then
		return
	end

	if state.billboard then
		state.billboard:Destroy()
	end

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PlayerOverhead"
	billboard.Adornee = head
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = DISPLAY_DISTANCE
	-- Keep the BillboardGui itself fully world-scaled. A positive upper limit
	-- freezes its minimum screen size and makes distant tags look pixel-fixed.
	billboard.DistanceLowerLimit = 0
	billboard.DistanceUpperLimit = -1
	billboard.DistanceStep = 0
	billboard.Size = BILLBOARD_SIZE
	billboard.SizeOffset = Vector2.zero
	billboard.StudsOffsetWorldSpace = BILLBOARD_OFFSET
	billboard.Parent = head

	local container = Instance.new("Frame")
	container.Name = "Container"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Parent = billboard

	local layout = Instance.new("UIListLayout")
	layout.Name = "Layout"
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Padding = UDim.new(-0.02, 0)
	layout.Parent = container

	local titleLabel = createLabel("Title", 0.26)
	titleLabel.LayoutOrder = 0
	-- These belong to the actual title, not only the shared name/level labels.
	titleLabel.TextScaled = true
	titleLabel.RichText = true
	titleLabel.TextColor3 = Color3.fromRGB(207, 139, 255)
	addTextStroke(titleLabel, 0.15)
	local titleGradient = Instance.new("UIGradient")
	titleGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 191, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(156, 104, 255)),
	})
	titleGradient.Parent = titleLabel
	titleLabel.Parent = container

	local levelLabel = createLabel("Level", 0.3)
	levelLabel.LayoutOrder = 1
	levelLabel.TextScaled = true
	levelLabel.RichText = true
	levelLabel.Text = `Level {currentLevel(player)}`
	levelLabel.TextColor3 = Color3.fromRGB(255, 182, 43)
	addTextStroke(levelLabel, 0.145)

	local levelGradient = Instance.new("UIGradient")
	levelGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 237, 106)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 169, 35)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 116, 24)),
	})
	levelGradient.Rotation = 90
	levelGradient.Parent = levelLabel
	levelLabel.Parent = container

	local nameLabel = createLabel("PlayerName", 0.37)
	nameLabel.LayoutOrder = 2
	nameLabel.TextScaled = true
	nameLabel.RichText = true
	nameLabel.Text = escapeRichText(player.DisplayName)
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	addTextStroke(nameLabel, 0.14)
	nameLabel.Parent = container

	state.billboard = billboard
	state.titleLabel = titleLabel
	state.levelLabel = levelLabel
	refreshTitle(player)
end

local function resolveDeveloperRole(player: Player)
	local success, rank = pcall(player.GetRankInGroupAsync, player, GROUP_ID)
	local isDeveloper = success and type(rank) == "number" and rank >= DEVELOPER_MIN_RANK
	player:SetAttribute("IsDeveloper", isDeveloper)

	if isDeveloper then
		local roleSuccess, roleName = pcall(player.GetRoleInGroupAsync, player, GROUP_ID)
		player:SetAttribute(
			"ChatRoleTag",
			if roleSuccess and type(roleName) == "string" and roleName ~= "" then roleName else "Developer"
		)
	else
		player:SetAttribute("ChatRoleTag", nil)
	end
	refreshTitle(player)

end

local function playerAdded(player: Player)
	if playerStates[player] then
		return
	end

	local state: PlayerState = {}
	playerStates[player] = state

	state.playerChildConnection = player.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then
			bindLeaderstats(player, child)
		end
	end)
	state.titleConnection = player:GetAttributeChangedSignal("ChatRoleTag"):Connect(function()
		refreshTitle(player)
	end)

	state.characterConnection = player.CharacterAdded:Connect(function(character)
		task.spawn(createOverhead, player, character)
	end)

	bindLeaderstats(player, player:FindFirstChild("leaderstats"))
	task.spawn(resolveDeveloperRole, player)

	if player.Character then
		task.spawn(createOverhead, player, player.Character)
	end
end

local function playerRemoving(player: Player)
	local state = playerStates[player]
	if not state then
		return
	end

	disconnect(state.levelConnection)
	disconnect(state.titleConnection)
	disconnect(state.leaderstatsConnection)
	disconnect(state.playerChildConnection)
	disconnect(state.characterConnection)
	if state.billboard then
		state.billboard:Destroy()
	end
	playerStates[player] = nil
end

function PlayerOverheadService.Start()
	for _, player in Players:GetPlayers() do
		playerAdded(player)
	end

	Players.PlayerAdded:Connect(playerAdded)
	Players.PlayerRemoving:Connect(playerRemoving)
end

return PlayerOverheadService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="459">
            <Properties>
              <string name="Name">SetMobileStyle</string>
              <string name="Source"><![CDATA[local SetMobileStyle = {}

local function updateToggleVisual(imageButton: ImageButton, toggled: boolean)
	local visualLabel = imageButton:FindFirstChild("MobileStyleVisual") :: ImageLabel?
	if not visualLabel then
		return
	end

	imageButton:SetAttribute("IsToggled", toggled)

	local imageLabel = imageButton:FindFirstChild("ActionIcon") :: ImageLabel?
	local textLabel = imageButton:FindFirstChild("ActionTitle") :: TextLabel?

	if toggled then
		visualLabel.ImageRectOffset = Vector2.new(146, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(0, 0, 0)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(0, 0, 0)
		end
	else
		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(1, 1, 1)
		end
	end
end

function SetMobileStyle.Default(imageButton: ImageButton)
	local imageLabel = imageButton:FindFirstChild("ActionIcon") :: ImageLabel?
	local textLabel = imageButton:FindFirstChild("ActionTitle") :: TextLabel?

	local visualLabel = imageButton:FindFirstChild("MobileStyleVisual") :: ImageLabel?
	if not visualLabel then
		visualLabel = Instance.new("ImageLabel")
		visualLabel.Name = "MobileStyleVisual"
		visualLabel.BackgroundTransparency = 1
		visualLabel.Image = "rbxassetid://130691448656069"
		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		visualLabel.Parent = imageButton
		visualLabel.ZIndex = -1
		visualLabel.Size = UDim2.fromScale(1, 1)
	end

	imageButton.ImageTransparency = 1

	if imageLabel then
		imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		imageLabel.ImageTransparency = 0.5
	end
	if textLabel then
		textLabel.TextColor3 = Color3.new(1, 1, 1)
		textLabel.TextTransparency = 0.5
	end

	local touchObject = nil
	imageButton.InputBegan:Connect(function(inputObject)
		if
			touchObject
			or inputObject.UserInputType ~= Enum.UserInputType.Touch
			or inputObject.UserInputState ~= Enum.UserInputState.Begin
		then
			return
		end

		touchObject = inputObject
		visualLabel.ImageRectOffset = Vector2.new(146, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(0, 0, 0)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(0, 0, 0)
		end
	end)

	imageButton.InputEnded:Connect(function(inputObject)
		if inputObject ~= touchObject then
			return
		end

		touchObject = nil

		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(1, 1, 1)
		end
	end)
end

function SetMobileStyle.SetToggleState(imageButton: ImageButton, toggled: boolean)
	updateToggleVisual(imageButton, toggled)
end

function SetMobileStyle.Toggle(imageButton: ImageButton)
	local imageLabel = imageButton:FindFirstChild("ActionIcon") :: ImageLabel?
	local textLabel = imageButton:FindFirstChild("ActionTitle") :: TextLabel?

	local visualLabel = imageButton:FindFirstChild("MobileStyleVisual") :: ImageLabel?
	if not visualLabel then
		visualLabel = Instance.new("ImageLabel")
		visualLabel.Name = "MobileStyleVisual"
		visualLabel.BackgroundTransparency = 1
		visualLabel.Image = "rbxassetid://130691448656069"
		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		visualLabel.Parent = imageButton
		visualLabel.ZIndex = -1
		visualLabel.Size = UDim2.fromScale(1, 1)
	end

	imageButton.ImageTransparency = 1

	if imageLabel then
		imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		imageLabel.ImageTransparency = 0.5
	end
	if textLabel then
		textLabel.TextColor3 = Color3.new(1, 1, 1)
		textLabel.TextTransparency = 0.5
	end

	updateToggleVisual(imageButton, imageButton:GetAttribute("IsToggled") == true)
end

return SetMobileStyle
]]></string>
            </Properties>
          </Item>
