	local BLOCK_START = Allocate(3)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 27)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	table.insert(SendInstances, if Value == nil then Null else Value)
end

function SerdesFunctions.SettingsService_ReadFUNCTION_DATA_SaveSetting(): ({ SettingName: string, Value: any })
	-- Read BLOCK: 2 bytes
	local BLOCK_START = Read(2)
	local Value = {} :: any
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	Value.SettingName = buffer.readstring(RecieveBuffer, Read(Length), Length)
	RecieveInstanceCursor += 1
	Value.Value = RecieveInstances[RecieveInstanceCursor]
	return Value
end

