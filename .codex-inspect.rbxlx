		end
	),
	setCaption: typeof(
		--[[
			Sets a caption. To remove, pass &lt;code&gt;nil&lt;/code&gt; as &lt;code&gt;text&lt;/code&gt;.
		]]
		function(self: Icon, text: string?): Icon
			return nil :: any
