          </Item>
          <Item class="Folder" referent="377">
            <Properties>
              <string name="Name">UnitService</string>
            </Properties>
            <Item class="ModuleScript" referent="378">
              <Properties>
                <string name="Name">UnitClient</string>
                <string name="Source"><![CDATA[--/Services
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")

--/Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local UnitData = require(ReplicatedStorage.Settings.Data.UnitData)
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local TowerClient = require(ReplicatedStorage.Shared.Services.Entities.TowerService.TowerClient)
local UnitRenderer = require(script.UnitRenderer)
local UnitVisuals = require(script.UnitVisuals)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local Net = require(ReplicatedStorage.Shared.Net)
local AnimationService
local VisualService
local TimeService

local RANDOM = Random.new()

local isActived = false
local ActivedUnits = {}

local partsToMove = {}
local cframesToMove = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getPingTime(sendTimeMs: number): number
	local currentTimeMs = math.floor(workspace:GetServerTimeNow() * 1000) % 65536
	local difference = (currentTimeMs - sendTimeMs) % 65536
	if difference > 32768 then
		difference -= 65536
	end

	return math.max(0, difference) / 1000
end

local function playSpawnEffects(summoner, clonedModel: Model, unitName: string)
	if summoner then
		VisualService.Play(summoner.Name, "Summon", summoner.Level, summoner.Model, clonedModel)
	end

	VisualService.Play(unitName, "OnSpawn", 0, clonedModel, clonedModel)
end

local function getUnitBaseStats(unitData, summoner)
	local walkSpeed = unitData.WalkSpeed
	local maxHealth = unitData.MaxHealth
	local stats = unitData.Stats and TableUtils.DeepCopy(unitData.Stats)

	local summonerStats = summoner and summoner.Stats
	if summonerStats then
		local custom = nil

		if summonerStats.Summons then
			for _, summonConfig in summonerStats.Summons do
				if summonConfig.SummonUnit == unitData.Name then
					custom = summonConfig.UnitStats
					break
				end
			end
		elseif summonerStats.SummonUnit == unitData.Name then
			custom = summonerStats.UnitStats
		end

		if custom then
			if custom.MaxHealth then
				maxHealth = custom.MaxHealth
			end
			if custom.WalkSpeed then
				walkSpeed = custom.WalkSpeed
			end

			if stats then
				for key, val in pairs(custom) do
					if key ~= "MaxHealth" and key ~= "WalkSpeed" then
						stats[key] = val
					end
				end
			end
		end
	end

	return walkSpeed, maxHealth, stats
end

-------------------------------------------------
--// UnitClient
-------------------------------------------------
local UnitClient = {}

function UnitClient.Init(services)
	UnitRenderer.Init(services)

	AnimationService = services:GetService("AnimationService")
	VisualService = services:GetService("VisualService")
	TimeService = services:GetService("TimeService")
end

function UnitClient.Start()
	UnitRenderer.Start()

	Net.UnitService.ReplicatedUnit.On(UnitClient.newUnit)
	Net.UnitService.UnitDestroyed.On(UnitClient.Destroy)
	Net.UnitService.OnAttackEnemy.On(UnitClient._OnAttackEnemy)
	Net.UnitService.OnDamaged.On(UnitClient._OnDamaged)

	ClientSignals.GameSpeedChanged:Connect(UnitClient._OnGameSpeedChanged)
end

function UnitClient.newUnit(data: {
	unitId: number,
	unitIndex: number,
	summonerId: number,
	sendTimeMs: number,
	pathAlpha: number?,
	isEnemyType: boolean?,
})
	local unitData = if data.isEnemyType then EnemyData.ByIndex[data.unitIndex] else UnitData.ByIndex[data.unitIndex]
	if not unitData then
		return
	end

	local unitModel = (if data.isEnemyType then ReplicatedStorage.Assets.Enemies else ReplicatedStorage.Assets.Units):FindFirstChild(
		unitData.Name
	)
	if not unitModel then
		return
	end

	local clonedModel = unitModel:Clone()
	clonedModel.Name = `Unit_{data.unitId}`
	clonedModel.PrimaryPart.Anchored = true
	clonedModel.Parent = workspace.Units

	AnimationService.Load(clonedModel, unitData.Name)
	AnimationService.Play(clonedModel, "Walk", nil, 0)

	CharacterUtils.SetCollisionGroup(clonedModel, "Unit", function(part)
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end)

	local summoner = TowerClient.ActiveTowers[data.summonerId]
	playSpawnEffects(summoner, clonedModel, unitData.Name)

	local pingTime = getPingTime(data.sendTimeMs)

	local walkSpeed, maxHealth, stats = getUnitBaseStats(unitData, summoner)

	local pathLength = GetPath:Get():GetPathLength()
	local startAlpha = data.pathAlpha and (data.pathAlpha / 65535) or 1

	ActivedUnits[data.unitId] = {
		Model = clonedModel,
		Name = unitData.Name,
		WalkSpeed = walkSpeed,
		MaxHealth = maxHealth,
		Health = maxHealth,
		Stats = stats,
		Offset = RANDOM:NextNumber(-0.5, 0.5),
		PathAlpha = startAlpha - (walkSpeed * pingTime * TimeService:GetGameSpeed()) / pathLength,
	}

	UnitVisuals.Attach(data.unitId, unitData.Name, clonedModel, maxHealth)

	UnitClient.StartMoveLoop()
end

function UnitClient.Destroy(unitId: number)
	local targetUnit = ActivedUnits[unitId]
	if not targetUnit then
		return
	end

	UnitVisuals.Destroy(unitId)
	UnitRenderer.Cleanup(unitId, targetUnit.Model)

	if targetUnit.Model then
		UnitClient.DisappearModel(targetUnit.Model)
		Debris:AddItem(targetUnit.Model, 5)
	end

	ActivedUnits[unitId] = nil
end

function UnitClient.StartMoveLoop()
	if isActived then
		return
	end
	isActived = true

	local connection
	connection = RunService.PreRender:Connect(function(dt)
		local hasUnits = UnitClient.MoveAllUnits(dt)

		if not hasUnits then
			isActived = false
			connection:Disconnect()
		end
	end)
end

function UnitClient.MoveAllUnits(dt)
	table.clear(partsToMove)
	table.clear(cframesToMove)

	local hasUnits = false

	for id, unit in pairs(ActivedUnits) do
		hasUnits = true

		local rootPart = unit.Model.PrimaryPart
		if not rootPart then
			continue
		end

		if not unit.PauseEndTime or os.clock() >= unit.PauseEndTime then
			if unit.IsPaused then
				unit.IsPaused = false
				AnimationService.Play(unit.Model, "Walk", nil, 0.1)
			end

			local pathLength = GetPath:Get():GetPathLength()

			unit.PathAlpha -= ((unit.WalkSpeed * dt * TimeService:GetGameSpeed()) / pathLength)
			unit.PathAlpha = math.clamp(unit.PathAlpha, 0, 1)
		else
			if not unit.IsPaused then
				unit.IsPaused = true
				AnimationService.Stop(unit.Model, "Walk")
			end
		end

		if unit.PathAlpha <= 0 then
			UnitClient.Destroy(id)
			continue
		end

		local Height = CharacterUtils.GetHipHeight(unit.Model)
		local targetCFrame = GetPath:Get():CalculateUniformCFrame(unit.PathAlpha) + Vector3.new(0, Height, 0)
		local cframeOffset = targetCFrame.RightVector * unit.Offset

		local finalCFrame = targetCFrame + cframeOffset

		if unit.LookEndTime and os.clock() < unit.LookEndTime and unit.TargetEnemy and unit.TargetEnemy.PrimaryPart then
			local lookPos = unit.TargetEnemy.PrimaryPart.Position
			local unitPos = finalCFrame.Position
			finalCFrame = CFrame.lookAt(unitPos, Vector3.new(lookPos.X, unitPos.Y, lookPos.Z))
		else
			finalCFrame *= CFrame.Angles(0, math.rad(180), 0)
		end

		table.insert(partsToMove, rootPart)
		table.insert(cframesToMove, finalCFrame)
	end

	if #partsToMove > 0 then
		workspace:BulkMoveTo(partsToMove, cframesToMove, Enum.BulkMoveMode.FireCFrameChanged)
	end

	return hasUnits
end

function UnitClient.DisappearModel(model)
	model.PrimaryPart.CFrame = CFrame.new(2 ^ 24, 2 ^ 24, 2 ^ 24)
end

function UnitClient._OnAttackEnemy(data: { enemyId: number, unitId: number })
	local unitData = ActivedUnits[data.unitId]
	local enemyModel = workspace.Enemies:FindFirstChild(`Enemy_{data.enemyId}`)

	if not unitData or not enemyModel then
		return
	end

	if unitData.Stats and unitData.Stats.StopWhenAttacking then
		unitData.PauseEndTime = os.clock() + 3
	end

	unitData.TargetEnemy = enemyModel
	unitData.LookEndTime = os.clock() + 3

	UnitRenderer.OnAttack(data.unitId, unitData.Model, unitData.Name, enemyModel, unitData.Stats)
end

function UnitClient._OnDamaged(data: { unitId: number, damaged: number })
	local updatedUnit = ActivedUnits[data.unitId]
	if not updatedUnit then
		return
	end

	updatedUnit.Health -= data.damaged
	UnitVisuals.Update(data.unitId, updatedUnit.Health, updatedUnit.MaxHealth)

	if updatedUnit.Health <= 0 then
		UnitClient.Destroy(data.unitId)
	end
end

function UnitClient._OnGameSpeedChanged(newSpeed: number, oldSpeed: number, pingTime: number)
	local pathLength = GetPath:Get():GetPathLength()

	for _, unit in pairs(ActivedUnits) do
		local pingOffset = (unit.WalkSpeed * pingTime * (newSpeed - oldSpeed)) / pathLength

		unit.PathAlpha -= pingOffset
	end
end

return UnitClient
]]></string>
              </Properties>
              <Item class="ModuleScript" referent="379">
                <Properties>
                  <string name="Name">UnitRenderer</string>
                  <string name="Source"><![CDATA[--/ Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)

--/ Modules
local TimeService
local AnimationService
local VisualService

-------------------------------------------------
--// UnitRenderer
-------------------------------------------------
local UnitRenderer = {}
UnitRenderer.TrackingUnits = {} -- { [unitId]: { UnitModel, TargetPart, EndTime } }

function UnitRenderer.Init(services)
	AnimationService = services:GetService("AnimationService")
	VisualService = services:GetService("VisualService")
end

function UnitRenderer.Start()
	RunService.PreRender:Connect(function()
		if next(UnitRenderer.TrackingUnits) == nil then
			return
		end

		local now = os.clock()
		for unitId, data in pairs(UnitRenderer.TrackingUnits) do
			if
				now > data.EndTime
				or not data.UnitModel.Parent
				or not data.TargetPart.Parent
				or data.TargetPart:GetAttribute("Dead")
			then
				UnitRenderer.TrackingUnits[unitId] = nil
				continue
			end

			UnitRenderer.LookAt(data.UnitModel, data.TargetPart.Position)
		end
	end)
end

function UnitRenderer.LookAt(unitModel: Model, targetPosition: Vector3)
	if not unitModel or not targetPosition then
		return
	end

	local unitPivot = unitModel:GetPivot()
	local lookTarget = Vector3.new(targetPosition.X, unitPivot.Position.Y, targetPosition.Z)

	unitModel:PivotTo(CFrame.lookAt(unitPivot.Position, lookTarget))
end

function UnitRenderer.OnAttack(
	unitId: number,
	unitModel: Model,
	unitName: string,
	enemyModel: Model,
	stats,
	attackVariant: string?
)
	if not (unitModel and enemyModel and enemyModel.PrimaryPart) then
		return
	end

	local targetPart = enemyModel.PrimaryPart
	local attackDelay = stats.AttackDelay or 0

	local variant = attackVariant or ""

	AnimationService.Play(unitModel, `{variant}Attack`)

	VisualService.Play(unitName, `{variant}AttackStart`, 0, unitModel, enemyModel, stats.Range)
	VisualService.Play(unitName, `{variant}AttackEnd`, 0, unitModel, enemyModel, stats.Range, attackDelay)

	if not targetPart:GetAttribute("Dead") then
		UnitRenderer.LookAt(unitModel, targetPart.Position)
		UnitRenderer.TrackingUnits[unitId] = {
			UnitModel = unitModel,
			TargetPart = targetPart,
			EndTime = os.clock() + attackDelay,
		}
	end
end

function UnitRenderer.Cleanup(unitId: number, unitModel: Model?)
	if unitModel then
		AnimationService.Clear(unitModel)
	end
	UnitRenderer.TrackingUnits[unitId] = nil
end

return UnitRenderer
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="380">
                <Properties>
                  <string name="Name">UnitVisuals</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local InstanceCache = require(ReplicatedStorage.Shared.Modules.Core.InstanceCache)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)

local Visuals = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Visuals")
local HealthBarGui = Visuals:WaitForChild("HealthBarGui") :: BillboardGui
local CacheFolder = workspace:WaitForChild("Caches")

local BAR_OFFSET = 0.45
local CACHE_SIZE = 30
local TWEEN_INFO = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local HEALTH_HIGH_COLOR = Color3.fromRGB(52, 152, 219)
local HEALTH_MID_COLOR = Color3.fromRGB(155, 89, 182)
local HEALTH_LOW_COLOR = Color3.fromRGB(237, 70, 70)

type HealthBarState = {
	Gui: BillboardGui,
	Fill: Frame,
	HealthText: TextLabel,
	Tween: Tween?,
	MaxHealth: number,
}

local HealthBarStorage = InstanceCache.new(HealthBarGui, CACHE_SIZE, CacheFolder)
local healthBars: { [number]: HealthBarState } = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getAdornee(model: Model): (BasePart?, Vector3)
	local primaryPart = model.PrimaryPart
	if primaryPart then
		return primaryPart, Vector3.new(0, CharacterUtils.GetHipHeight(model) - BAR_OFFSET, 0)
	end

	return nil, Vector3.zero
end

local function getHealthColor(ratio: number): Color3
	if ratio > 0.5 then
		return HEALTH_MID_COLOR:Lerp(HEALTH_HIGH_COLOR, (ratio - 0.5) / 0.5)
	end

	return HEALTH_LOW_COLOR:Lerp(HEALTH_MID_COLOR, ratio / 0.5)
end

local function createBar(unitModel: Model, unitName: string, maxHealth: number): HealthBarState?
	local adornee, offset = getAdornee(unitModel)
	if not adornee then
		return nil
	end

	local healthGui = HealthBarStorage:GetInstance() :: BillboardGui
	healthGui.Adornee = adornee
	healthGui.StudsOffsetWorldSpace = offset
	healthGui.Parent = adornee

	local nameText = healthGui:WaitForChild("EnemyName") :: TextLabel
	nameText.Text = unitName

	local background = healthGui:WaitForChild("Background") :: Frame
	local fillBar = background:WaitForChild("Bar") :: Frame
	fillBar.BackgroundColor3 = HEALTH_HIGH_COLOR
	fillBar.Size = UDim2.fromScale(1, 1)

	local healthText = background:WaitForChild("Health") :: TextLabel
	healthText.Text = `{maxHealth}/{maxHealth}`

	healthGui.Enabled = true

	return {
		Gui = healthGui,
		Fill = fillBar,
		HealthText = healthText,
		Tween = nil,
		MaxHealth = maxHealth,
	}
end

-------------------------------------------------
--// UnitVisuals
-------------------------------------------------
local UnitVisuals = {}

function UnitVisuals.Attach(unitId: number, unitName: string, unitModel: Model, maxHealth: number)
	UnitVisuals.Destroy(unitId)

	if maxHealth <= 0 then
		return
	end

	local state = createBar(unitModel, unitName, maxHealth)
	if state then
		healthBars[unitId] = state
	end
end

function UnitVisuals.Update(unitId: number, health: number, maxHealth: number?)
	local state = healthBars[unitId]
	if not state then
		return
	end

	local targetMaxHealth = maxHealth or state.MaxHealth
	if targetMaxHealth <= 0 then
		return
	end

	state.MaxHealth = targetMaxHealth

	local ratio = math.clamp(health / targetMaxHealth, 0, 1)
	local targetHealth = math.clamp(health, 0, targetMaxHealth)
	local targetText = `{targetHealth}/{targetMaxHealth}`
	local targetSize = UDim2.fromScale(ratio, 1)
	local targetColor = getHealthColor(ratio)

	state.HealthText.Text = targetText

	if state.Tween then
		state.Tween:Cancel()
	end

	state.Tween = TweenService:Create(state.Fill, TWEEN_INFO, {
		BackgroundColor3 = targetColor,
		Size = targetSize,
	})
	state.Tween:Play()
end

function UnitVisuals.Destroy(unitId: number)
	local state = healthBars[unitId]
	if not state then
		return
	end

	if state.Tween then
		state.Tween:Cancel()
		state.Tween = nil
	end

	if state.Gui then
		state.Gui.Enabled = false
		state.Gui.Adornee = nil
		HealthBarStorage:ReturnInstance(state.Gui)
	end

	healthBars[unitId] = nil
end

return UnitVisuals
]]></string>
                </Properties>
              </Item>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="381">
          <Properties>
            <string name="Name">System</string>
          </Properties>
          <Item class="ModuleScript" referent="382">
            <Properties>
              <string name="Name">AnimationService</string>
              <string name="Source"><![CDATA[--/Serivces
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

--/Variables
local ANIMATIONS = ReplicatedStorage.Assets.Animations
local Cache = {}
local currentSpeedMultiplier = 1

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function getAnimator(model: Model): Animator?
	local controller = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Humanoid")
	if not controller then
		warn(`Controller 없음: {model.Name}`)
		return nil
	end

	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end

	return animator
end

local function getTrack(tracks, name: string, level: number?): AnimationTrack?
	if level then
		for i = level, 0, -1 do
			local track = tracks[`{name}_{i}`]
			if track then
				return track
			end
		end
	end

	return tracks[name]
end

local function getExactTrack(tracks, name: string, level: number?): AnimationTrack?
	return tracks[if level ~= nil then `{name}_{level}` else name]
end

local function wrapTrack(realTrack: AnimationTrack, data)
	local wrapper = {
		_realTrack = realTrack,
	}

	function wrapper:AdjustSpeed(speed: number)
		data.TrackSpeeds[wrapper] = speed
		realTrack:AdjustSpeed(speed * currentSpeedMultiplier)
	end

	function wrapper:Play(...)
		realTrack:Play(...)
		local targetSpeed = data.TrackSpeeds[wrapper] or 1
		realTrack:AdjustSpeed(targetSpeed * currentSpeedMultiplier)
	end

	setmetatable(wrapper, {
		__index = function(_, key)
			local val = (realTrack :: any)[key]
			if type(val) == "function" then
				return function(_, ...)
					return val(realTrack, ...)
				end
			end
			return val
		end,
		__newindex = function(_, key, val)
			(realTrack :: any)[key] = val
		end,
		__eq = function(a, b)
			local realA = type(a) == "table" and a._realTrack or a
			local realB = type(b) == "table" and b._realTrack or b
			return realA == realB
		end,
	})

	return (wrapper :: any) :: AnimationTrack
end

-------------------------------------------------
--// AnimationSerivce
-------------------------------------------------
local AnimationService = {}

function AnimationService.Load(model: Model, folderName: string)
	AnimationService.Clear(model)

	if not model:IsDescendantOf(workspace) then
		warn(`{model.Name}이 Workspace 밖에 있음. AnimationTrack.Length 버그 가능.`)
	end

	local animator = getAnimator(model)
	local folder = ANIMATIONS:FindFirstChild(folderName)

	if not animator or not folder then
		return
	end

	local data = {
		Tracks = {},
		TrackSpeeds = {},
		Connection = nil,
	}

	for _, anim in ipairs(folder:GetChildren()) do
		if anim:IsA("Animation") then
			local realTrack = animator:LoadAnimation(anim)
			data.Tracks[anim.Name] = wrapTrack(realTrack, data)
		end
	end

	data.Connection = model.Destroying:Connect(function()
		AnimationService.Clear(model)
	end)

	Cache[model] = data

	return data.Tracks
end

function AnimationService.Play(model: Model, name: string, level: number?, fadeTime: number?): AnimationTrack?
	local data = Cache[model]
	if not data then
		return nil
	end

	local track = getTrack(data.Tracks, name, level)
	if not track then
		warn(`Animation 없음: {name}`)
		return nil
	end

	track:Play(fadeTime or 0)
	return track
end

function AnimationService.GetTrack(model: Model, name: string, level: number?): AnimationTrack?
	local data = Cache[model]
	if not data then
		return nil
	end

	return getTrack(data.Tracks, name, level)
end

function AnimationService.GetExactTrack(model: Model, name: string, level: number?): AnimationTrack?
	local data = Cache[model]
	if not data then
		return nil
	end

	return getExactTrack(data.Tracks, name, level)
end

function AnimationService.PlayOnce(model: Model, name: string, options)
	options = options or {}

	local data = Cache[model]
	if not data then
		return nil
	end

	local level = options.Level
	local fadeTime = options.FadeTime or 0
	local resumeName = options.Resume or "Idle"

	local track = getTrack(data.Tracks, name, level)
	if not track then
		warn(`Animation 없음: {name}`)
		return nil
	end

	local playOnceId = (data.CurrentPlayOnceId or 0) + 1
	data.CurrentPlayOnceId = playOnceId

	for _, activeTrack in pairs(data.Tracks) do
		if activeTrack ~= track and activeTrack.IsPlaying then
			activeTrack:Stop(fadeTime)
		end
	end

	track:Play(fadeTime)

	track.Stopped:Once(function()
		if not Cache[model] or data.CurrentPlayOnceId ~= playOnceId then
			return
		end

		AnimationService.Play(model, resumeName, level, fadeTime)
	end)

	return track
end

function AnimationService.Stop(model: Model, name: string?, fadeTime: number?)
	local data = Cache[model]
	if not data then
		return
	end

	for trackName, track in pairs(data.Tracks) do
		if not name or trackName == name or trackName:match(`^{name}_%d+$`) then
			track:Stop(fadeTime or 0)
		end
	end
end

function AnimationService.Clear(model: Model)
	local data = Cache[model]
	if not data then
		return
	end

	if data.Connection then
		data.Connection:Disconnect()
	end

	for _, track in pairs(data.Tracks) do
		track:Stop(0)
		track:Destroy()
	end

	Cache[model] = nil
end

function AnimationService.ClearAll()
	for model in pairs(Cache) do
		AnimationService.Clear(model)
	end
end

function AnimationService.Init(services) end

function AnimationService.Start()
	if RunService:IsClient() then
		local StarterPlayer = game:GetService("StarterPlayer")
		local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)

		ClientSignals.GameSpeedChanged:Connect(function(newSpeed)
			currentSpeedMultiplier = newSpeed
			for _, data in pairs(Cache) do
				for _, track in pairs(data.Tracks) do
					if track.IsPlaying then
						local targetSpeed = data.TrackSpeeds[track] or 1
						track._realTrack:AdjustSpeed(targetSpeed * currentSpeedMultiplier)
					end
				end
			end
		end)
	end
end

return AnimationService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="383">
            <Properties>
              <string name="Name">AudioService</string>
              <string name="Source"><![CDATA[--/Service
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

--/Modules
local SFXRecipes = require(ReplicatedStorage.Settings.Visuals.SFXRecipes)
local InstanceCache = require(ReplicatedStorage.Shared.Modules.Core.InstanceCache)
local TimeService

--/Variables
local Caches = workspace:WaitForChild("Caches")
local DeviceOutput = SoundService:WaitForChild("AudioDeviceOutput") or Instance.new("AudioDeviceOutput")
DeviceOutput.Parent = SoundService

local AudioFolder = SoundService:WaitForChild("Audio") or Instance.new("Folder")
AudioFolder.Parent = SoundService

--/Constants
local DEFAULT_DISTANCE = 1000
local DEFAULT_VOLUME = 1

local SFX_FOLDER = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("SFX")

--/Pools
local PlayerStorage
local EmitterStorage
local WireStorage
local FaderStorage
local ActivePlayers: { [AudioPlayer]: boolean } = {}

export type Recipes = { SFXRecipes.Step }

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function GetInverseAttenuation(minDist, maxDist)
	local attenuation = {}
	attenuation[0] = 1
	attenuation[minDist] = 1

	local steps = 5
	for i = 1, steps do
		local distance = minDist + (maxDist - minDist) * (i / steps)
		local volume = minDist / distance
		attenuation[distance] = math.clamp(volume, 0, 1)
	end

	attenuation[maxDist] = 0
	return attenuation
end

local function getSound(soundPath: string)
	local current: Instance? = SFX_FOLDER

	for name in string.gmatch(soundPath, "[^/]+") do
		current = current and current:FindFirstChild(name)

		if not current then
			warn(`Sound 에셋을 찾을 수 없음: {soundPath}`)
			return nil
		end
	end

	return current
end

local function resolveInstance(value: any, sourceModel: Model, targetModel: Model)
	if typeof(value) == "Instance" then
		return value
	end

	if type(value) ~= "string" then
		return
	end

	local parts = string.split(value, ".")
	local rootName = parts[1]

	local rootModel
	if rootName == "Source" then
		rootModel = sourceModel
	elseif rootName == "Target" then
		rootModel = targetModel
	else
		warn(`잘못된 경로: {rootName}`)
		return
	end

	if not rootModel or not rootModel.Parent then
		return
	end

	if #parts == 1 then
		return rootModel.PrimaryPart
	end

	local current = rootModel
	for i = 2, #parts do
		current = current:FindFirstChild(parts[i])

		if not current then
			warn(`경로를 찾을 수 없음: {value}`)
			return
		end
	end

	return current
end

-------------------------------------------------
--// AudioService
-------------------------------------------------
local AudioService = {}
AudioService.SFXVolume = 1

function AudioService.GetRecipes(sourceName: string, audioType: string, sourceLevel: number?): Recipes?
	local sourceRecipes = SFXRecipes[sourceName]
	if not sourceRecipes then
		return nil
	end

	local audioRecipes = sourceRecipes[audioType]
	if not audioRecipes then
		return nil
	end

	local level = sourceLevel or 0

	for currentLevel = level, 0, -1 do
		local recipes = audioRecipes[currentLevel]

		if recipes then
			return recipes
		end
	end

	return nil
end

function AudioService.PlayFromRecipes(soundRecipes: Recipes, sourceModel: Model, targetModel: Model)
	for _, recipe in soundRecipes do
		if recipe.Delay and recipe.Delay > 0 then
			local delayedRecipe = table.clone(recipe)
			delayedRecipe.Delay = nil

			TimeService.DeltaDelay(recipe.Delay):andThen(function()
				AudioService.PlayFromRecipes({ delayedRecipe }, sourceModel, targetModel)
			end)

			continue
		end

		local soundAsset = getSound(recipe.Sound)
		local soundId = soundAsset and soundAsset.SoundId or recipe.Sound
		local volume = recipe.Volume or (soundAsset and soundAsset.Volume) or 1

		if recipe.Type == "2D" then
			AudioService.PlayOn2D(soundId, volume)
		elseif recipe.Type == "3D" then
			local soundParent = resolveInstance(recipe.At, sourceModel, targetModel)
			if soundParent then
				AudioService.PlayOn3D(soundId, volume, nil, soundParent)
			end
		else
			warn(`알 수 없는 SFX Type: {recipe.Type}`)
		end
	end
end

function AudioService.PlayOn2D(soundId, volume: number?)
	soundId = typeof(soundId) == "string" and soundId or `rbxassetid://{soundId}`

	local audioPlayer: AudioPlayer = PlayerStorage:GetInstance()
	audioPlayer.Asset = soundId
	audioPlayer.Parent = SoundService

	local fader
	local faderWire

	if volume or AudioService.SFXVolume ~= 1 then
		fader = FaderStorage:GetInstance() :: AudioFader
		fader.Volume = (volume or 1) * AudioService.SFXVolume
		fader.Parent = SoundService

		faderWire = WireStorage:GetInstance() :: Wire
		faderWire.SourceInstance = fader
		faderWire.TargetInstance = DeviceOutput
		faderWire.Parent = SoundService
	end

	local wire: Wire = WireStorage:GetInstance()
	wire.SourceInstance = audioPlayer
	wire.TargetInstance = fader or DeviceOutput
	wire.Parent = SoundService

	audioPlayer.Ended:Once(function()
		ActivePlayers[audioPlayer] = nil
		PlayerStorage:ReturnInstance(audioPlayer)
		WireStorage:ReturnInstance(wire)

		if fader then
			FaderStorage:ReturnInstance(fader)
		end
		if faderWire then
			WireStorage:ReturnInstance(faderWire)
		end
	end)

	audioPlayer.PlaybackSpeed = TimeService:GetGameSpeed()
	ActivePlayers[audioPlayer] = true
	audioPlayer:Play()

	return audioPlayer
end

function AudioService.PlayOn3D(soundId, volume: number?, distance: number?, parent: Instance | Vector3)
	soundId = typeof(soundId) == "string" and soundId or `rbxassetid://{soundId}`

	local parentInst
	local isVector3 = typeof(parent) == "Vector3"

	if isVector3 then
		parentInst = Instance.new("Part")
		parentInst.Size = Vector3.zero
		parentInst.Transparency = 1
		parentInst.CanCollide = false
		parentInst.CanQuery = false
		parentInst.CanTouch = false
		parentInst.Anchored = true
		parentInst.Position = parent

		parentInst.Parent = workspace.Terrain
	else
		parentInst = parent
	end

	local audioPlayer: AudioPlayer = PlayerStorage:GetInstance()
	audioPlayer.Asset = soundId
	audioPlayer.Parent = SoundService

	local emitter: AudioEmitter = EmitterStorage:GetInstance()
	emitter:SetDistanceAttenuation(GetInverseAttenuation(0, distance or DEFAULT_DISTANCE))
	emitter.Parent = parentInst

	local fader
	local faderWire

	if volume or AudioService.SFXVolume ~= 1 then
		fader = FaderStorage:GetInstance()
		fader.Volume = (volume or 1) * AudioService.SFXVolume
		fader.Parent = parentInst

		faderWire = WireStorage:GetInstance()
		faderWire.SourceInstance = fader
		faderWire.TargetInstance = emitter
		faderWire.Parent = parentInst
	end

	local wire: Wire = WireStorage:GetInstance()
	wire.SourceInstance = audioPlayer
	wire.TargetInstance = fader or emitter
	wire.Parent = parentInst

	audioPlayer.Ended:Once(function()
		ActivePlayers[audioPlayer] = nil
		if isVector3 and parentInst then
			parentInst:Destroy()
		end

		PlayerStorage:ReturnInstance(audioPlayer)
		EmitterStorage:ReturnInstance(emitter)
		WireStorage:ReturnInstance(wire)

		if fader then
			FaderStorage:ReturnInstance(fader)
		end
		if faderWire then
			WireStorage:ReturnInstance(faderWire)
		end
	end)

	audioPlayer.PlaybackSpeed = TimeService:GetGameSpeed()
	ActivePlayers[audioPlayer] = true
	audioPlayer:Play()

	return audioPlayer
end

function AudioService.SetBGMState(playing: boolean?, volume: number?, newBGMId)
	local bgmSound: Sound = SoundService:WaitForChild("BGM")
	if newBGMId then
		newBGMId = typeof(newBGMId) == "string" and newBGMId or `rbxassetid://{newBGMId}`
		bgmSound.TimePosition = 0
	end

	bgmSound.Volume = volume or bgmSound.Volume
	bgmSound.SoundId = newBGMId or bgmSound.SoundId
	bgmSound.Looped = true

	bgmSound.Parent = SoundService

	if playing then
		bgmSound:Play()
	elseif playing == false then
		bgmSound:Stop()
	end
end

function AudioService.Init(services)
	TimeService = services:GetService("TimeService")

	PlayerStorage = InstanceCache.new(Instance.new("AudioPlayer"), 30, Caches)
	EmitterStorage = InstanceCache.new(Instance.new("AudioEmitter"), 30, Caches)
	WireStorage = InstanceCache.new(Instance.new("Wire"), 60, Caches)
	FaderStorage = InstanceCache.new(Instance.new("AudioFader"), 30, Caches)
end

function AudioService.Start()
	if RunService:IsClient() then
		local StarterPlayer = game:GetService("StarterPlayer")
		local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)

		ClientSignals.GameSpeedChanged:Connect(function(newSpeed)
			for audioPlayer in ActivePlayers do
				audioPlayer.PlaybackSpeed = newSpeed
			end
		end)
	end

	AudioService.SetBGMState(true, DEFAULT_VOLUME)
end

return AudioService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="384">
            <Properties>
              <string name="Name">CutsceneController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CutscenePlayer = require(ReplicatedStorage.Shared.Modules.Cutscene.CutscenePlayer)
local MapData = require(ReplicatedStorage.Settings.Data.MapData)

local CutsceneController = {}

local CUTSCENE_FINISHED_EVENT_NAME = "CutsceneFinished"
local playedCutscenes = {}
local isStarted = false

local function hideLoadingCover()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	for _, name in ipairs({ "LoadingBootstrap", "LoadingScreen" }) do
		local loadingGui = playerGui:FindFirstChild(name)
		if loadingGui and loadingGui:IsA("ScreenGui") then
			loadingGui.Enabled = false
		end
	end
end

local function playMapIntro(mapName: string?)
	local mapInfo = mapName and MapData[mapName]
	local cutsceneName = mapInfo and mapInfo.IntroCutscene
	if not cutsceneName or playedCutscenes[cutsceneName] then
		return
	end

	playedCutscenes[cutsceneName] = true
	task.spawn(function()
		hideLoadingCover()
		local didPlay = CutscenePlayer.Play(cutsceneName)
		if not didPlay then
			warn(`[CutsceneController] Failed to play "{cutsceneName}" for map "{mapName}".`)
		end

		local finishedEvent = ReplicatedStorage:FindFirstChild(CUTSCENE_FINISHED_EVENT_NAME)
		if finishedEvent and finishedEvent:IsA("RemoteEvent") then
			finishedEvent:FireServer(mapName, cutsceneName)
		end
	end)
end

function CutsceneController.Start()
	if isStarted then
		return
	end
	isStarted = true

	local mapFolder = workspace:WaitForChild("Map")

	playMapIntro(mapFolder:GetAttribute("SelectedMap"))
	mapFolder:GetAttributeChangedSignal("SelectedMap"):Connect(function()
		playMapIntro(mapFolder:GetAttribute("SelectedMap"))
	end)
end

function CutsceneController.Play(cutsceneName: string): boolean
	return CutscenePlayer.Play(cutsceneName)
end

function CutsceneController.Stop()
	CutscenePlayer.Stop()
end

return CutsceneController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="385">
            <Properties>
              <string name="Name">EconomyService</string>
              <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterPlayer = game:GetService("StarterPlayer")
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local GameSettings = require(ReplicatedStorage.Settings.Game.GameSettings)

local playerCash: { [number]: number } = {}

local function updateLeaderstats(player: Player)
	local leaderstats = player:FindFirstChild("leaderstats") or Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local CashValue = leaderstats:FindFirstChild("Cash") or Instance.new("IntValue")
	CashValue.Name = "Cash"
	CashValue.Parent = leaderstats

	CashValue.Value = playerCash[player.UserId]
end

-------------------------------------------------
--// EconomyService
-------------------------------------------------
local EconomyService = {}

function EconomyService.Init() end

function EconomyService.Start()
	if RunService:IsClient() then
		task.spawn(function()
			local player = Players.LocalPlayer
			local leaderstats = player:WaitForChild("leaderstats", 10)
			local cashValue = leaderstats:WaitForChild("Cash", 10)

			cashValue.Changed:Connect(function(newValue)
				ClientSignals.CashChanged:Fire(newValue)
			end)

			ClientSignals.CashChanged:Fire(cashValue.Value)
		end)
		return
	end

	local function onPlayerAdded(player: Player)
		EconomyService.SetCash(player, GameSettings.StartMoney)
		updateLeaderstats(player)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)

	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
end

function EconomyService.AddCash(player: Player, amount: number)
	if not playerCash[player.UserId] then
		return
	end

	playerCash[player.UserId] += amount

	updateLeaderstats(player)
end

function EconomyService.AddCashToAll(amount: number)
	for _, player in ipairs(Players:GetPlayers()) do
		EconomyService.AddCash(player, amount)
	end
end

function EconomyService.AddKillCash(enemyMaxHealth: number)
	EconomyService.AddCashToAll(math.round(2.8 * (enemyMaxHealth ^ 0.8)))
end

function EconomyService.SubtractCash(player: Player, amount: number, isForce: boolean | nil)
	if not playerCash[player.UserId] then
		return
	end

	if not isForce then
		if playerCash[player.UserId] < amount then
			return
		end
	end

	playerCash[player.UserId] -= amount

	updateLeaderstats(player)
end

function EconomyService.SetCash(player: Player, value: number | nil)
	local toValue = value or 0
	playerCash[player.UserId] = toValue

	updateLeaderstats(player)
end

function EconomyService.SetCashToAll(value: number | nil)
	for _, player in ipairs(Players:GetPlayers()) do
		EconomyService.SetCash(player, value)
	end
end

function EconomyService.GetCash(player): number
	if RunService:IsClient() then
		return player:WaitForChild("leaderstats").Cash.Value
	end

	return playerCash[player.UserId]
end

return EconomyService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="386">
            <Properties>
              <string name="Name">GameClient</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

--/Modules
local ClientSignals = require(StarterPlayer.StarterPlayerScripts.Client.ClientSignals)
local Net = require(ReplicatedStorage.Shared.Net)
local Promise = require(ReplicatedStorage.Packages.Promise)
local GetPath = require(ReplicatedStorage.Shared.Modules.Core.GetPath)

-------------------------------------------------
--// Tower Reward Calculator
-------------------------------------------------
local TowerRewardCalculator = {}
TowerRewardCalculator.Snapshot = {}

function TowerRewardCalculator.GetCumulativeExp(level: number, exp: number): number
	return exp + 50 * level * (level + 1)
end

function TowerRewardCalculator.FetchTowersAsync()
	return Promise.all({
		Net.DataService.GetDataValue.Invoke("Loadout"),
		Net.DataService.GetDataValue.Invoke("OwnedTowers"),
	}):andThen(function(results)
		local towers = {}
		local loadout = results[1]
		local ownedTowers = results[2]

		if not loadout or not ownedTowers then
			return towers
		end

		for _, slot in pairs(loadout) do
			if slot and slot.Name and slot.Key then
				local towerData = ownedTowers[slot.Name] and ownedTowers[slot.Name][slot.Key]
				if towerData then
					towers[slot.Key] = {
						Name = slot.Name,
						Lv = towerData.Lv,
						Exp = towerData.Exp,
					}
				end
			end
		end

		return towers
	end)
end

function TowerRewardCalculator.TakeSnapshot()
	TowerRewardCalculator.FetchTowersAsync():andThen(function(towers)
		TowerRewardCalculator.Snapshot = towers
	end)
end

function TowerRewardCalculator.CalculateGainedTowersAsync()
	return TowerRewardCalculator.FetchTowersAsync():andThen(function(currentTowers)
		local gainedTowers = {}
		for key, currentStats in currentTowers do
			local snap = TowerRewardCalculator.Snapshot[key]
			if snap then
				local startCumulative = TowerRewardCalculator.GetCumulativeExp(snap.Lv, snap.Exp)
				local endCumulative = TowerRewardCalculator.GetCumulativeExp(currentStats.Lv, currentStats.Exp)

				local percentBefore = math.floor((snap.Exp / (100 * (snap.Lv + 1))) * 100)
				local percentAfter = math.floor((currentStats.Exp / (100 * (currentStats.Lv + 1))) * 100)

				table.insert(gainedTowers, {
					name = currentStats.Name,
					gainedExp = endCumulative - startCumulative,
					levelBefore = snap.Lv,
					levelAfter = currentStats.Lv,
					percentBefore = percentBefore,
					percentAfter = percentAfter,
				})
			end
		end

		TowerRewardCalculator.Snapshot = currentTowers

		return gainedTowers
	end)
end

-------------------------------------------------
--// GameClient
-------------------------------------------------
local GameClient = {}
GameClient.SelectedDifficulty = "Normal"
GameClient.StartPlayerCount = 1
GameClient.IsGameStarted = false

function GameClient.UpdateGameInfo(data: { Difficulty: string, StartPlayerCount: number })
	GameClient.SelectedDifficulty = data.Difficulty
	GameClient.StartPlayerCount = data.StartPlayerCount
end

function GameClient.Start()
	TowerRewardCalculator.TakeSnapshot()

	Net.GameEvent.GetGameInfo.Invoke():andThen(GameClient.UpdateGameInfo):catch(function(err)
		warn("[GameClient] Failed to fetch initial GameInfo:", err)
	end)

	Net.GameEvent.GameInfoSynced.On(GameClient.UpdateGameInfo)

	-- Start path guidance arrows during preparation stage
	task.spawn(function()
		GetPath:StartGuide()
	end)

	Net.GameEvent.WaveStarted.On(function(waveNumber: number)
		ClientSignals.WaveStarted:Fire(waveNumber)
		GetPath:StopGuide()
	end)

	Net.GameEvent.WaveCompleted.On(function()
		ClientSignals.WaveCompleted:Fire()
	end)

	Net.GameEvent.GameOver.On(function(data: { coins: number, exp: number, gems: number, isWin: boolean })
		TowerRewardCalculator.CalculateGainedTowersAsync():andThen(function(gainedTowers)
			ClientSignals.GameOver:Fire(data.isWin, data.coins, data.exp, data.gems, gainedTowers)
		end)
	end)
	Net.GameEvent.Restarted.On(function()
		ClientSignals.Restarted:Fire()
		GetPath:StartGuide()
	end)

	Net.GameEvent.ReadyVoted.On(function(votedNumber: number)
		ClientSignals.ReadyVoted:Fire(votedNumber)
	end)
	Net.GameEvent.RestartVoted.On(function(votedNumber: number)
		ClientSignals.RestartVoted:Fire(votedNumber)
	end)
	Net.GameEvent.SkipVoted.On(function(votedNumber: number)
		ClientSignals.SkipVoted:Fire(votedNumber)
	end)

	Net.GameEvent.CanSkip.On(function()
		ClientSignals.CanSkip:Fire()
	end)
end

return GameClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="387">
            <Properties>
              <string name="Name">InputService</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local Input = require(ReplicatedStorage.Packages.Input)
local Signal = require(ReplicatedStorage.Packages.Signal)
local Fn = require(ReplicatedStorage.Shared.Modules.Utils.Fn)

local Keyboard = Input.Keyboard.new()
local Mouse = Input.Mouse.new()
local Touch = Input.Touch.new()

export type Scope = {
	Name: string,
	Actions: { [string]: Action },
	Enable: (self: Scope) -> nil,
	Disable: (self: Scope) -> nil,
}
export type Action = {
	Name: string,
	Scope: string?,
	ActionInfo: ActionInfo,
	Began: typeof(Signal.new()),
	Ended: typeof(Signal.new()),
}
export type ActionInfo = {
	KeyCodes: { Enum.KeyCode },
	GuiButtons: { GuiButton },
}

type Keycodes = Enum.KeyCode | Enum.UserInputState | "Touch" | "DoubleTap"

local KeyMap = {}
local ActivatedScopes = {}

local lastTapTime = 0
local DOUBLE_TAP_THRESHOLD = 0.25

-------------------------------------------------
--// InputService
-------------------------------------------------
local InputService = {}

function InputService.Scope(scopeName: string, actions: { [string]: Action }): Scope
	local self = {}
	self.Name = scopeName

	self.Actions = {}
	for _, action in actions do
		self.Actions[action.Name] = action
		action.Scope = self.Name
	end

	self.Enable = function()
		ActivatedScopes[self.Name] = true

		return self
	end
	self.Disable = function()
		ActivatedScopes[self.Name] = false

		return self
	end

	ActivatedScopes[self.Name] = false

	return self
end

function InputService.Action(actionName: string, actionInfo: ActionInfo): Action
	local self = {}
	self.Name = actionName
	self.ActionInfo = actionInfo

	self.Scope = nil

	self.Began = Signal.new()
	self.Ended = Signal.new()

	if actionInfo.KeyCodes then
		for _, keyCode in ipairs(actionInfo.KeyCodes) do
			if not KeyMap[keyCode] then
				KeyMap[keyCode] = {}
			end
			table.insert(KeyMap[keyCode], self)
		end
	end
	if actionInfo.GuiButtons then
		for _, button in ipairs(actionInfo.GuiButtons) do
			button.MouseButton1Down:Connect(Fn.Bind(InputService._HandleButton, self, "Began"))
			button.MouseButton1Up:Connect(Fn.Bind(InputService._HandleButton, self, "Ended"))
		end
	end

	return self
end

function InputService.Info(keyCodes: Keycodes?, guiButtons: { GuiButton }?): ActionInfo
	return { KeyCodes = keyCodes, GuiButtons = guiButtons }
end

function InputService._HandleInput(inputState: string, keyCode: Keycodes, processed: boolean?)
	if processed then
		return
	end

	local keyActions = KeyMap[keyCode]
	if not keyActions then
		return
	end

	for _, action in ipairs(keyActions) do
		if action.Scope and ActivatedScopes[action.Scope] == true then
			action[inputState]:Fire()
		end
	end
end

function InputService._HandleButton(action: Action, inputState: string)
	if action.Scope and ActivatedScopes[action.Scope] == true then
		action[inputState]:Fire()
	end
end

function InputService.Init() end

function InputService.Start()
	Keyboard.KeyDown:Connect(Fn.Bind(InputService._HandleInput, "Began"))
	Keyboard.KeyUp:Connect(Fn.Bind(InputService._HandleInput, "Ended"))

	Mouse.LeftDown:Connect(Fn.Bind(InputService._HandleInput, "Began", Enum.UserInputType.MouseButton1))
	Mouse.LeftUp:Connect(Fn.Bind(InputService._HandleInput, "Ended", Enum.UserInputType.MouseButton1))

	Touch.TouchStarted:Connect(function(_, processed: boolean?)
		InputService._HandleInput("Began", "Touch", processed)

		local currentTime = os.clock()
		if (currentTime - lastTapTime) <= DOUBLE_TAP_THRESHOLD then
			InputService._HandleInput("Began", "DoubleTap", processed)
		end
		lastTapTime = currentTime
	end)

	Touch.TouchEnded:Connect(Fn.Bind(InputService._HandleInput, "Ended", "Touch"))
end

return InputService
]]></string>
            </Properties>
