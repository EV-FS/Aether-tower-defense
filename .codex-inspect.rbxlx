      <Item class="Folder" referent="526">
        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="527">
          <Properties>
            <string name="Name">LogMessage</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local spring = Vide.spring

local LOG_COLOR = {
	Normal = {
		TextColor = Color3.new(1, 1, 1),
		StrokeColor = Color3.new(),
	},
	Error = {
		TextColor = Color3.fromRGB(255, 76, 79),
		StrokeColor = Color3.fromRGB(97, 0, 3),
	},
}

return function(props)
	return create("Frame")({
		Name = "Example",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(0.5, 0.025),

		create("TextLabel")({
			Name = "Title",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/GothamSSm.json",
				Enum.FontWeight.ExtraBold,
				Enum.FontStyle.Normal
			),
			RichText = true,
			Position = spring(function()
				local currentState = props.State()
				if currentState == "Entering" then
					return UDim2.fromScale(-1, 0)
				elseif currentState == "Alive" then
					return UDim2.fromScale(0, 0)
				elseif currentState == "Leaving" then
					return UDim2.fromScale(1, 0)
				end

				return UDim2.fromScale(0, 0)
			end, 0.3, 1),

			Size = UDim2.fromScale(1, 1),
			Text = props.Message or "",
			TextColor3 = LOG_COLOR[props.LogType or "Normal"].TextColor,
			TextScaled = true,
			TextTransparency = spring(function()
				return if props.State() == "Alive" then 0 else 1
			end, 0.3, 1),

			create("UIStroke")({
				Name = "UIStroke",
				Color = LOG_COLOR[props.LogType or "Normal"].StrokeColor,
				StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
				Thickness = 0.075,
				Transparency = spring(function()
					return if props.State() == "Alive" then 0 else 1
				end, 0.3, 1),
			}),
		}),
	})
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="528">
        <Properties>
          <string name="Name">LoadingFallbackController</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LoadingFallbackController = {}

local loadingGui: ScreenGui? = nil

local function mount()
	if loadingGui then
		return
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "LoadingScreen"
	gui.DisplayOrder = 10000
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false

	local background = Instance.new("Frame")
	background.Name = "Background"
	background.BackgroundColor3 = Color3.fromRGB(20, 13, 39)
	background.BorderSizePixel = 0
	background.Size = UDim2.fromScale(1, 1)
	background.Parent = gui

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 20, 55)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(18, 13, 36)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(38, 21, 63)),
	})
	gradient.Parent = background

	local label = Instance.new("TextLabel")
	label.Name = "LoadingText"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Position = UDim2.fromScale(0.5, 0.86)
	label.Size = UDim2.fromOffset(300, 50)
	label.Text = "Loading..."
	label.TextColor3 = Color3.fromRGB(240, 232, 255)
	label.TextScaled = true
	label.Parent = background

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	loadingGui = gui
end

function LoadingFallbackController.Show()
	mount()
end

function LoadingFallbackController.Hide()
	local gui = loadingGui
	if not gui then
		return
	end

	loadingGui = nil
	local background = gui:FindFirstChild("Background")
	if background and background:IsA("Frame") then
		TweenService:Create(background, TweenInfo.new(0.35), {
			BackgroundTransparency = 1,
		}):Play()
	end
	task.delay(0.35, function()
		gui:Destroy()
	end)
end

function LoadingFallbackController.Destroy()
	if loadingGui then
		loadingGui:Destroy()
		loadingGui = nil
	end
end

return LoadingFallbackController
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="529">
        <Properties>
          <string name="Name">UIController</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local source = Vide.source

local activeView = source(nil :: string?)
local isLocked = source(false)

local UIController = {}

function UIController:IsOpen(name: string): boolean
	return activeView() == name
end

function UIController:IsVisible(name: string): () -> boolean
	return function()
		return activeView() == name
	end
end

function UIController:GetActiveView(): string?
	return activeView()
end

function UIController:Open(name: string): boolean
	if isLocked() or name == "" then
		return false
	end

	activeView(name)
	return true
end

function UIController:Close(name: string): boolean
	if isLocked() or activeView() ~= name then
		return false
	end

	activeView(nil)
	return true
end

function UIController:CloseAll(): boolean
	if isLocked() or activeView() == nil then
		return false
	end

	activeView(nil)
	return true
end

function UIController:Toggle(name: string): boolean
	if self:IsOpen(name) then
		return self:Close(name)
	end

	return self:Open(name)
end

function UIController:Lock(locked: boolean)
	isLocked(locked)
end

return UIController
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="530">
        <Properties>
          <string name="Name">Utils</string>
        </Properties>
        <Item class="ModuleScript" referent="531">
          <Properties>
            <string name="Name">UIOffsetScaler</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local BASE_VIEWPORT_WIDTH = 1920

local UIOffsetScaler = {}

local screenStrokes = {}
local activeBillboards = {}

local resolutionScale = 1

local function UpdateResolutionScale()
	local sizeX = camera.ViewportSize.X
	resolutionScale = if sizeX and sizeX > 0 then sizeX / BASE_VIEWPORT_WIDTH else 1
end

local function applyStrokeScale(stroke: UIStroke, sizeScale: number?)
	if not stroke:IsDescendantOf(game) then
		return
	end

	local originalThickness = stroke:GetAttribute("OriginalThickness")
	if not originalThickness then
		originalThickness = stroke.Thickness
		stroke:SetAttribute("OriginalThickness", originalThickness)
	end

	local targetThickness = originalThickness * resolutionScale * (sizeScale or 1)

	if targetThickness < 0.5 then
		stroke.Enabled = false
	else
		stroke.Enabled = true
		stroke.Thickness = math.max(1, targetThickness)
	end
end

local function ProcessNewStroke(stroke: Instance)
	if not stroke:IsA("UIStroke") then
		return
	end

	task.defer(function()
		if not stroke:IsDescendantOf(game) then
			return
		end

		if stroke.StrokeSizingMode ~= Enum.StrokeSizingMode.ScaledSize then
			screenStrokes[stroke] = true
			applyStrokeScale(stroke)
		end
	end)
end

local function applyBillboardScale(billboard: BillboardGui)
	if not billboard:IsDescendantOf(game) then
		return
	end

	local originalSize = billboard:GetAttribute("OriginalSize")
	if not originalSize then
		originalSize = billboard.Size
		billboard:SetAttribute("OriginalSize", originalSize)
	end
	billboard.Size = UDim2.new(
		originalSize.X.Scale,
		originalSize.X.Offset * resolutionScale,
		originalSize.Y.Scale,
		originalSize.Y.Offset * resolutionScale
	)
end

local function ProcessNewBillboard(billboard: Instance)
	if not billboard:IsA("BillboardGui") then
		return
	end

	task.defer(function()
		if not billboard:IsDescendantOf(game) then
			return
		end

		applyBillboardScale(billboard)
		activeBillboards[billboard] = true
	end)
end

local function ProcessDescendant(descendant: Instance)
	if descendant:IsA("UIStroke") then
		ProcessNewStroke(descendant)
	elseif descendant:IsA("BillboardGui") then
		ProcessNewBillboard(descendant)
	end
end

function UIOffsetScaler.Init()
	UpdateResolutionScale()

	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		UpdateResolutionScale()

		for stroke in pairs(screenStrokes) do
			if stroke:IsDescendantOf(game) then
				applyStrokeScale(stroke)
			else
				screenStrokes[stroke] = nil
			end
		end

		for billboard in pairs(activeBillboards) do
			if billboard:IsDescendantOf(game) then
				applyBillboardScale(billboard)
			else
				activeBillboards[billboard] = nil
			end
		end
	end)

	playerGui.DescendantAdded:Connect(ProcessDescendant)

	for _, descendant in ipairs(playerGui:GetDescendants()) do
		ProcessDescendant(descendant)
	end
end

return UIOffsetScaler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="532">
          <Properties>
            <string name="Name">root.story</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local CashFrame = require(ReplicatedStorage.UI.Features.HUD.Cash.Components.CashFrame)

local source = Vide.source
local spring = Vide.spring
local mount = Vide.mount

return function(target)
	local testContainer = Instance.new("Frame")
	testContainer.Size = UDim2.fromScale(1, 1)
	testContainer.Position = UDim2.fromScale(0.5, 0.5)
	testContainer.AnchorPoint = Vector2.new(0.5, 0.5)
	testContainer.BackgroundTransparency = 1
	testContainer.Parent = target

	local mockCash = source(1000)

	local destroyVide = mount(function()
		return CashFrame({
			Cash = spring(mockCash, 0.175, 1),
		})
	end, testContainer)

	local thread = task.spawn(function()
		while true do
			task.wait(1)
			mockCash(mockCash() + 1000)
		end
	end)

	return function()
		task.cancel(thread)
		destroyVide()
		testContainer:Destroy()
	end
end
]]></string>
          </Properties>
        </Item>
