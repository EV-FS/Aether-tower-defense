function SerdesFunctions.GameEvent_ReadEVENT_GameOver(): ({ isWin: boolean, coins: number, exp: number, gems: number })
	-- Read BLOCK: 7 bytes
	local BLOCK_START = Read(7)
	local Value = {} :: any
	Value.isWin = (buffer.readu8(RecieveBuffer, BLOCK_START + 0) == 1)
	Value.coins = buffer.readu16(RecieveBuffer, BLOCK_START + 1)
	Value.exp = buffer.readu16(RecieveBuffer, BLOCK_START + 3)
	Value.gems = buffer.readu16(RecieveBuffer, BLOCK_START + 5)
	return Value
end

