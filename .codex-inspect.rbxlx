          <Item class="ModuleScript" referent="409">
            <Properties>
              <string name="Name">GetPath</string>
              <string name="Source"><![CDATA[local BezierPath = require(script.Parent.BezierPath)
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Guide = require(script.Guide)
local PathCatalog = require(script.PathCatalog)

local GetPath = {}
GetPath.CachedPath = nil
GetPath.PathLength = 0
GetPath.Paths = {}
GetPath.PathCount = 0
local catalog: PathCatalog.Catalog? = nil

local function waitForChild(parent: Instance, name: string): Instance
	return assert(parent:WaitForChild(name, 30), `경로 구성 요소를 찾을 수 없습니다: {parent:GetFullName()}.{name}`)
end

local function waitForAttribute(instance: Instance, name: string)
	local startedAt = os.clock()
	while instance:GetAttribute(name) == nil do
		assert(os.clock() - startedAt < 30, `경로 속성 로딩 대기 시간이 초과되었습니다: {name}`)
		task.wait(0.1)
	end
	return instance:GetAttribute(name)
end

local function buildPath(folder: Instance, isLegacy: boolean)
	local positions = {}
	local visited = {}
	local node = waitForChild(folder, "Start")
	while true do
		assert(node:IsA("BasePart") and node:IsDescendantOf(folder), `경로 노드는 해당 폴더 안의 BasePart여야 합니다: {folder:GetFullName()}`)
		-- Named paths can be children of the legacy Waypoints container, but their nodes belong to another route.
		assert(not isLegacy or node.Parent == folder, "기존 경로의 Next는 Waypoints에 직접 들어 있는 노드끼리 연결해야 합니다.")
		assert(not visited[node], `Next 연결이 순환하고 있습니다: {folder:GetFullName()}`)
		visited[node] = true
		table.insert(positions, node.Position)
		if node.Name == "End" then
			break
		end

		local nextValue = waitForChild(node, "Next")
		assert(nextValue:IsA("ObjectValue"), `Next는 ObjectValue여야 합니다: {node:GetFullName()}`)
		local startedAt = os.clock()
		while not nextValue.Value do
			assert(os.clock() - startedAt < 30, `Next가 가리키는 다음 노드를 찾을 수 없습니다: {node:GetFullName()}`)
			task.wait(0.1)
		end
		node = nextValue.Value
	end

	assert(#positions >= 2, `경로에는 Start와 End 노드가 필요합니다: {folder:GetFullName()}`)
	local path = BezierPath.new(positions, 3.5)
	assert(path:GetPathLength() > 0, `경로 길이가 0보다 커야 합니다: {folder:GetFullName()}`)
	return path
end

function GetPath:StartGuide()
	if not RunService:IsClient() then
		return
	end
	Guide.Start()
end

function GetPath:StopGuide()
	if not RunService:IsClient() then
		return
	end
	Guide.Stop()
end

function GetPath:Get(pathId: number?)
	local startedAt = os.clock()
	while not self.CachedPath do
		if os.clock() - startedAt > 60 then
			warn("경로 로딩 대기 시간이 초과되었습니다.")
			return nil
		end

		task.wait(0.1)
	end

	return assert(self.Paths[pathId or 1], `존재하지 않는 경로 ID입니다: {pathId or 1}`)
end

function GetPath:GetCount(): number
	assert(self:Get(), "경로가 아직 로드되지 않았습니다.")
	return self.PathCount
end

function GetPath:GetSpawnPathIds(isBoss: boolean?, path: (string | number)?): { number }
	assert(self:Get(), "경로가 아직 로드되지 않았습니다.")
	return PathCatalog.selectSpawnPaths(assert(catalog, "경로 목록이 아직 로드되지 않았습니다."), isBoss, path)
end

function GetPath.Init()
	local mapFolder = waitForChild(workspace, "Map")
	local waypointsFolder = waitForChild(mapFolder, "Waypoints")
	local manifest
	if RunService:IsServer() then
		local folderNames = {}
		for _, child in waypointsFolder:GetChildren() do
			if child:IsA("Folder") then
				table.insert(folderNames, child.Name)
			end
		end
		local start = waypointsFolder:FindFirstChild("Start")
		manifest = {
			Folders = folderNames,
			Legacy = start ~= nil and start:IsA("BasePart"),
		}
	else
		-- One map-level manifest; never guess IDs from partially replicated children.
		manifest = HttpService:JSONDecode(waitForAttribute(waypointsFolder, "PathManifest"))
	end

	local loadedCatalog = PathCatalog.new(manifest.Folders, manifest.Legacy)
	local paths = {}
	for id, name in ipairs(loadedCatalog.Names) do
		local isLegacy = loadedCatalog.IsLegacy and id == 1
		local folder = if isLegacy then waypointsFolder else waitForChild(waypointsFolder, name)
		paths[id] = buildPath(folder, isLegacy)
	end

	catalog = loadedCatalog
	GetPath.Paths = paths
	GetPath.PathCount = #loadedCatalog.Names
	GetPath.CachedPath = paths[1]
	GetPath.PathLength = GetPath.CachedPath:GetPathLength()
	if RunService:IsServer() then
		waypointsFolder:SetAttribute("PathManifest", HttpService:JSONEncode(manifest))
	end

	if RunService:IsClient() then
		Guide.Init(GetPath)
	end

	return GetPath.CachedPath
end

return GetPath
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="410">
              <Properties>
                <string name="Name">Guide</string>
                <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

--/Modules
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local TimeService

-------------------------------------------------
--// Guide Configuration & State
-------------------------------------------------
local Guide = {}
local GetPathModule = nil
local activeArrows = {}
local originalTransparencies = {}
local renderConnection = nil
local isShowing = false

local SPEED = 15
local SPACING = 25
local CLUSTER_OFFSET = 1.25
local HEIGHT_OFFSET = 0.05
local FADE_DURATION = 0.5

local assetsFolder = ReplicatedStorage:WaitForChild("Assets", 5)
local visualsFolder = assetsFolder and assetsFolder:WaitForChild("Visuals", 5)
local arrowTemplate = visualsFolder and visualsFolder:WaitForChild("Arrow", 5)

if not arrowTemplate then
	warn("[경로 안내] 화살표 템플릿을 찾을 수 없습니다: ReplicatedStorage.Assets.Visuals.Arrow")
end

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function positionArrow(arrow: Instance, cframe: CFrame)
	if arrow:IsA("Model") then
		arrow:PivotTo(cframe)
	elseif arrow:IsA("BasePart") then
		arrow.CFrame = cframe
	end
end

local function setupArrowForFade(arrow: Instance)
	local function recordAndHide(instance: Instance)
		if instance:IsA("BasePart") then
			originalTransparencies[instance] = instance.Transparency
			instance.Transparency = 1
		end
		for _, child in ipairs(instance:GetChildren()) do
			recordAndHide(child)
		end
	end
	recordAndHide(arrow)
end

local function fadeArrow(arrow: Instance, isFadeOut: boolean, duration: number)
	local function applyFade(instance: Instance)
		if instance:IsA("BasePart") then
			local targetTransparency = isFadeOut and 1 or (originalTransparencies[instance] or 0)
			TweenService:Create(instance, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = targetTransparency,
			}):Play()
		end
		for _, child in ipairs(instance:GetChildren()) do
			applyFade(child)
		end
	end
	applyFade(arrow)
end

local function cleanArrowTransparencies(arrow: Instance)
	local function clean(instance: Instance)
		if instance:IsA("BasePart") then
			originalTransparencies[instance] = nil
		end
		for _, child in ipairs(instance:GetChildren()) do
			clean(child)
		end
	end
	clean(arrow)
end

-------------------------------------------------
--// Public API
-------------------------------------------------
function Guide.Init(getPathModule)
	GetPathModule = getPathModule
end

function Guide.Start()
	if isShowing then
		return
	end
	isShowing = true

	if not GetPathModule:Get() then
		warn("[경로 안내] 경로가 아직 로드되지 않았습니다.")
		isShowing = false
		return
	end

	for _, arrow in ipairs(activeArrows) do
		cleanArrowTransparencies(arrow)
		arrow:Destroy()
	end
	table.clear(activeArrows)

	local pathGroups = {}
	for _, pathId in ipairs(GetPathModule:GetSpawnPathIds()) do
		local path = GetPathModule:Get(pathId)
		local pathLength = path:GetPathLength()
		local arrows = {}
		table.insert(pathGroups, { Path = path, Length = pathLength, Arrows = arrows })
		local numGroups = math.max(3, math.floor(pathLength / SPACING))
		for _ = 1, numGroups do
			for _ = 0, 2 do
				local arrow = arrowTemplate:Clone()
				setupArrowForFade(arrow)
				arrow.Parent = workspace.Visuals
				table.insert(activeArrows, arrow)
				table.insert(arrows, arrow)
				fadeArrow(arrow, false, FADE_DURATION)
			end
		end
	end

	TimeService = TimeService or ServiceRegistry:GetService("TimeService")

	local distanceTravelled = 0
	renderConnection = RunService.PreRender:Connect(function(dt)
		distanceTravelled += dt * SPEED * TimeService:GetGameSpeed()

		for _, group in ipairs(pathGroups) do
			local path = group.Path
			local pathLength = group.Length
			for k, arrow in ipairs(group.Arrows) do
				local i = math.ceil(k / 3)
				local j = (k - 1) % 3

				local mainDistance = (i - 1) * SPACING + distanceTravelled
				local arrowDistance = (mainDistance - j * CLUSTER_OFFSET) % pathLength
				if arrowDistance < 0 then
					arrowDistance += pathLength
				end

				local alpha = arrowDistance / pathLength
				local targetCFrame = path:CalculateUniformCFrame(alpha)
				local finalCFrame = (targetCFrame + Vector3.new(0, HEIGHT_OFFSET, 0)) * CFrame.Angles(0, math.rad(-90), 0)

				positionArrow(arrow, finalCFrame)
			end
		end
	end)
end

function Guide.Stop()
	if not isShowing then
		return
	end
	isShowing = false

	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end

	local arrowsToDestroy = activeArrows
	activeArrows = {}

	for _, arrow in ipairs(arrowsToDestroy) do
		task.spawn(function()
			fadeArrow(arrow, true, FADE_DURATION)
			task.wait(FADE_DURATION)
			cleanArrowTransparencies(arrow)
			arrow:Destroy()
		end)
	end
end

return Guide
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="411">
              <Properties>
                <string name="Name">PathCatalog</string>
                <string name="Source"><![CDATA[--!strict

-- Folder names are only resolved when loading a map or starting a spawn group.
-- Enemies and network packets keep the resulting u8 ID.
local PathCatalog = {}

export type Catalog = {
	Names: { string },
	IdByName: { [string]: number },
	DefaultIds: { number },
	IsLegacy: boolean,
}

function PathCatalog.new(folderNames: { string }, isLegacy: boolean): Catalog
	local seen = {}
	local numberedCount = 0
	local namedPaths = {}
	for _, name in ipairs(folderNames) do
		assert(name ~= "" and not seen[name], `경로 폴더 이름이 비어 있거나 중복됩니다: {name}`)
		seen[name] = true
		local id = tonumber(name)
		if id then
			assert(not isLegacy, "Waypoints에 직접 배치한 기존 경로 노드와 번호 경로 폴더를 함께 사용할 수 없습니다.")
			assert(
				id >= 1 and id <= 255 and id % 1 == 0 and tostring(id) == name,
				"번호 경로 폴더 이름은 1, 2, 3, ... 형식이어야 합니다. 최대 255까지 지원합니다."
			)
			numberedCount += 1
		else
			table.insert(namedPaths, name)
		end
	end

	local defaultCount = isLegacy and 1 or numberedCount
	assert(defaultCount > 0, "Waypoints에 기본 경로가 필요합니다. Start/End 노드 또는 1번 폴더를 추가하세요.")
	assert(defaultCount + #namedPaths <= 255, "맵 하나에 기본 경로와 전용 경로를 합쳐 최대 255개까지 사용할 수 있습니다.")

	local names = {}
	local defaultIds = {}
	for id = 1, defaultCount do
		local name = tostring(id)
		assert(isLegacy or seen[name], `{id}번 경로 폴더가 없습니다. 번호는 1부터 빠짐없이 지정하세요.`)
		names[id] = name
		defaultIds[id] = id
	end

	-- Keep the same IDs even if GetChildren/replication returns folders in another order.
	table.sort(namedPaths)
	for _, name in ipairs(namedPaths) do
		table.insert(names, name)
	end

	local idByName = {}
	for id, name in ipairs(names) do
		idByName[name] = id
	end

	return table.freeze({
		Names = table.freeze(names),
		IdByName = table.freeze(idByName),
		DefaultIds = table.freeze(defaultIds),
		IsLegacy = isLegacy,
	})
end

function PathCatalog.resolve(catalog: Catalog, path: string | number): number
	local id = if type(path) == "number" then path else catalog.IdByName[path]
	assert(id and catalog.Names[id], `존재하지 않는 경로입니다: {path}. 맵의 Waypoints 폴더를 확인하세요.`)
	return id
end

function PathCatalog.selectSpawnPaths(catalog: Catalog, isBoss: boolean?, path: (string | number)?): { number }
	if path ~= nil then
		return { PathCatalog.resolve(catalog, path) }
	end
	if isBoss then
		return { 1 }
	end

	return catalog.DefaultIds
end

return PathCatalog
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="412">
            <Properties>
              <string name="Name">Hitbox</string>
              <string name="Source"><![CDATA[--/Service
local RunService = game:GetService("RunService")

--/Types
export type Hitbox = {
	new: () -> newHitbox,
	Find: (self: newHitbox) -> nil,
	Start: (self: newHitbox, lifeTime: number?) -> nil,
	Stop: (self: newHitbox) -> nil,
}

export type newHitbox = {
	Size: Vector3,
	CFrame: BasePart | CFrame,
	Offset: CFrame,
	Visible: boolean,
	Humanoids: { Humanoid },
	Box: BasePart?,
	Connection: RBXScriptConnection?,
	IsInActor: boolean,
	onTouch: (humanoid: Humanoid) -> (),

	Start: (lifeTime: number?) -> nil,
	Stop: () -> nil,
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function CFrameConverter(input: CFrame | BasePart): CFrame
	if typeof(input) == "CFrame" then
		return input
	else
		return input.CFrame
	end
end

-------------------------------------------------
--// Hitbox
-------------------------------------------------
local Hitbox = {} :: Hitbox
Hitbox.__index = Hitbox

function Hitbox.new(): newHitbox
	local self = setmetatable({}, Hitbox)
	self.Size = Vector3.new(0, 0, 0)
	self.CFrame = CFrame.new(0, 0, 0)
	self.Offset = CFrame.new(0, 0, 0)
	self.Visible = true

	self.Humanoids = {}
	self.Box = nil
	self.Connection = nil
	self.IsInActor = false

	self.OverlapParams = OverlapParams.new()
	self.OverlapParams.FilterType = Enum.RaycastFilterType.Exclude
	self.OverlapParams.FilterDescendantsInstances = {}

	self.onTouch = function(humanoid: Humanoid)
		print(humanoid)
	end

	return self
end

function Hitbox:Visual()
	if not self.Visible then
		return
	end

	if not self.Box then
		local box = Instance.new("Part")
		box.Name = "HitboxVisual"
		box.Anchored = true
		box.CastShadow = false
		box.CanCollide = false
		box.CanQuery = false
		box.CanTouch = false
		box.Material = Enum.Material.Neon
		box.Color = Color3.new(1, 0, 0)
		box.Transparency = 0.5
		box.Parent = workspace
		self.Box = box
	end

	self.Box.Size = self.Size
	self.Box.CFrame = CFrameConverter(self.CFrame) * self.Offset
end

function Hitbox:Find()
	if self.IsInActor then
		task.desynchronize()
	end

	local touchingHumanoids = {}

	local queryCFrame = CFrameConverter(self.CFrame) * self.Offset
	local touchingParts = workspace:GetPartBoundsInBox(queryCFrame, self.Size, self.OverlapParams)
	for _, part in pairs(touchingParts) do
		local enemy = part.Parent
		if not enemy then
			continue
		end

		local humanoid = enemy:FindFirstChildOfClass("Humanoid")

		if humanoid and not table.find(self.Humanoids, humanoid) then
			if self.IsInActor then
				table.insert(touchingHumanoids, humanoid)
			else
				table.insert(self.Humanoids, humanoid)
				self.onTouch(humanoid)
			end
		end
	end

	if self.IsInActor then
		task.synchronize()

		if not self.Connection then
			return
		end

		for _, humanoid in pairs(touchingHumanoids) do
			if table.find(self.Humanoids, humanoid) then
				continue
			end

			table.insert(self.Humanoids, humanoid)
			self.onTouch(humanoid)
		end
	end
end

function Hitbox:Start(lifeTime: number?)
	local passedTime = 0

	if script:GetActor() then
		self.IsInActor = true
	end

	self.Connection = RunService.Heartbeat:Connect(function(dt)
		self:Find()
		self:Visual()

		if not lifeTime then
			return
		end

		passedTime += dt
		if passedTime >= lifeTime then
			self:Stop()
		end
	end)
end

function Hitbox:Stop()
	if self.Connection then
		self.Connection:Disconnect()
		self.Connection = nil
	end

	if self.Box then
		self.Box:Destroy()
		self.Connection = nil
	end

	self.onTouch = nil
	setmetatable(self, nil)

	self.Humanoids = {}
end

return Hitbox
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="413">
            <Properties>
              <string name="Name">InstanceCache</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local ObjectCache = require(ReplicatedStorage.Packages.ObjectCache)

-------------------------------------------------
--// InstanceCache
-------------------------------------------------
local InstanceCache = {}
InstanceCache.__index = InstanceCache

local FAR_AWAY_CFRAME = CFrame.new(2 ^ 24, 2 ^ 24, 2 ^ 24)

local function getObjectPart(inst: Instance): BasePart?
	return if inst:IsA("BasePart") then inst else nil
end

local function createInstance(template: Instance, folder: Instance): Instance
	local newInst = template:Clone()
	if newInst:IsA("Model") then
		newInst:PivotTo(FAR_AWAY_CFRAME)
	end
	newInst.Parent = folder
	return newInst
end

function InstanceCache:ExpandCache(amount: number?)
	local expandAmount = amount or self.PoolSize

	if self.ObjectCache then
		-- ObjectCache 1.4.6 removes one object from its free list while expanding.
		-- Capture that object through its internal helper and return it immediately.
		local objectPart = self.ObjectCache:_GetNew(expandAmount, false)
		if objectPart then
			self.ObjectCache:ReturnPart(objectPart)
		end
		return
	end

	for _ = 1, expandAmount do
		table.insert(self.Available, createInstance(self.Template, self.Folder))
	end
end

function InstanceCache:GetInstance(cframe: CFrame?): Instance
	if self.ObjectCache then
		local objectPart = self.ObjectCache:GetPart(cframe)
		self.InUse[objectPart] = true
		return objectPart
	end

	if #self.Available == 0 then
		warn("InstanceCache: cache exhausted; expanding")
		self:ExpandCache(math.ceil(self.PoolSize * 0.5))
	end

	local inst = table.remove(self.Available)
	if not inst or inst.Parent == nil then
		inst = createInstance(self.Template, self.Folder)
	end
	self.InUse[inst] = true
	if cframe and inst:IsA("Model") then
		inst:PivotTo(cframe)
	end

	return inst
end

function InstanceCache:ReturnInstance(inst: Instance)
	if self.ObjectCache then
		local objectPart = getObjectPart(inst)
		if not objectPart or not self.InUse[objectPart] then
			warn(`InstanceCache: {inst:GetFullName()} is not in use by this spatial cache`)
			return
		end

		self.InUse[objectPart] = nil
		self.ObjectCache:ReturnPart(objectPart)
		return
	end

	if not self.InUse[inst] then
		warn("InstanceCache: tried to return an instance that is not in use")
		return
	end

	self.InUse[inst] = nil

	local success = pcall(function()
		if inst:IsA("Model") then
			inst:PivotTo(FAR_AWAY_CFRAME)
		end
		inst.Parent = self.Folder
	end)

	if not success then
		table.insert(self.Available, createInstance(self.Template, self.Folder))
		return
	end

	if inst:IsA("AudioPlayer") then
		inst:Stop()
	elseif inst:IsA("GuiObject") then
		inst.Visible = false
	end

	table.insert(self.Available, inst)
end

function InstanceCache:IsInUse(inst: Instance): boolean
	if self.ObjectCache then
		local objectPart = getObjectPart(inst)
		return objectPart ~= nil and self.InUse[objectPart] == true
	end

	return self.InUse[inst] == true
end

function InstanceCache:Destroy()
	if self.ObjectCache then
		self.ObjectCache:Destroy()
		table.clear(self.InUse)
		return
	end

	for _, inst in self.Available do
		inst:Destroy()
	end
	for inst in self.InUse do
		inst:Destroy()
	end

	table.clear(self.Available)
	table.clear(self.InUse)
end

function InstanceCache.new(inst: Instance, cacheSize: number?, cachesFolder: Instance)
	local self = setmetatable({}, InstanceCache)

	self.Template = inst
	self.PoolSize = cacheSize or 10
	self.Folder = cachesFolder
	self.ObjectCache = nil

	self.Available = {}
	self.InUse = {}

	if inst:IsA("BasePart") then
		self.ObjectCache = ObjectCache.new(inst, self.PoolSize, cachesFolder)
		return self
	end

	self:ExpandCache(self.PoolSize)

	return self
end

return InstanceCache
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="414">
            <Properties>
              <string name="Name">SafeTeleport</string>
              <string name="Source"><![CDATA[local TeleportService = game:GetService("TeleportService")

local MAX_RETRIES = 5
local RETRY_DELAY = 3

TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
	warn(`{player.Name} 텔레포트 실패. 사유: {errorMessage}, {tostring(result)}`)
end)

return function(placeId, players, teleportOptions)
	local attempt = 0
	local success = false
	local errorMessage = ""

	repeat
		if typeof(placeId) ~= "number" then
			warn("플레이스의 Id가 숫자가 아님.")
			return
		end
		if typeof(players) ~= "table" or next(players) == nil then
			warn("플레이어 테이블이 비어있거나 테이블 타입이 아님.")
			return
		end

		attempt += 1

		success, errorMessage = pcall(function()
			return TeleportService:TeleportAsync(placeId, players, teleportOptions)
		end)

		if not success then
			warn("텔레포트 실패. 사유:", errorMessage)
			task.wait(RETRY_DELAY)
		end
	until success or attempt >= MAX_RETRIES

	if not success then
		warn("텔레포트 실패.")
	end

	return success, errorMessage
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="415">
            <Properties>
              <string name="Name">ServiceRegistry</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local Promise = require(ReplicatedStorage.Packages.Promise)

--/Types
type Service = {
	Init: (registry: any) -> ()?,
	Start: () -> ()?,
	Dependencies: { string }?,
	[string]: any,
}

export type ServiceRegistry = {
	RegisterServices: (self: ServiceRegistry, moduleList: { ModuleScript }) -> nil,
	GetService: (self: ServiceRegistry, serviceName: string) -> any,
	Start: (self: ServiceRegistry) -> any,
}

-------------------------------------------------
--// ServiceRegistry
-------------------------------------------------
local ServiceRegistry = {} :: ServiceRegistry
ServiceRegistry._modulesToLoad = {} :: { ModuleScript }
ServiceRegistry._services = {} :: { [string]: Service }
ServiceRegistry._isStarted = false

function ServiceRegistry:RegisterServices(moduleList: { ModuleScript })
	assert(not self._isStarted, "이미 시작된 후에는 서비스를 등록할 수 없음.")

	for _, moduleScript in ipairs(moduleList) do
		if moduleScript:IsA("ModuleScript") then
			table.insert(self._modulesToLoad, moduleScript)
		else
			warn(`{moduleScript.Name}은 ModuleScript가 아님.`)
		end
	end
end

function ServiceRegistry:GetService(serviceName: string): any
	local service = self._services[serviceName]
	assert(service, `"{serviceName}" 서비스를 찾을 수 없음.`)

	return service
end

local function sortServices(services: { [string]: Service }): { string }
	local sorted = {}
	local visited = {}
	local temp = {}

	local function visit(name: string)
		if temp[name] then
		end
		if not visited[name] then
			temp[name] = true
			local service = services[name]
			if service.Dependencies then
				for _, depName in ipairs(service.Dependencies) do
					if services[depName] then
						visit(depName)
					end
				end
			end
			temp[name] = nil
			visited[name] = true
			table.insert(sorted, name)
		end
	end

	for name in pairs(services) do
		visit(name)
	end
	return sorted
end

function ServiceRegistry:Start()
	assert(not self._isStarted, "프레임워크가 이미 가동 중임.")
	self._isStarted = true

	return Promise.new(function(resolve, reject)
		--/1. Require
		for _, moduleScript in ipairs(self._modulesToLoad) do
			local serviceName = moduleScript.Name
			local success, result = Promise.try(require, moduleScript):await()

			if not success then
				reject(`{serviceName} 모듈 스크립트 로드 실패: {result}`)
				return
			end

			if type(result) == "table" then
				self._services[serviceName] = result :: Service
			else
				warn(`{serviceName}이 테이블을 반환하지 않음.`)
			end
		end

		local sortedServiceNames = sortServices(self._services)

		--/2. Init
		for _, serviceName in ipairs(sortedServiceNames) do
			local service = self._services[serviceName]
			if type(service.Init) == "function" then
				local success, err = Promise.try(service.Init, self):await()

				if not success then
					reject(`{serviceName} Initialize 실행 중 에러: {err}`)
					return
				end
			end
		end

		--/3. Start
		for _, serviceName in ipairs(sortedServiceNames) do
			local service = self._services[serviceName]
			if type(service.Start) == "function" then
				task.spawn(function()
					Promise.try(service.Start):catch(function(err)
						warn(`{serviceName} Start 실행 중 에러: {err}`)
					end)
				end)
			end
		end

		resolve()
	end)
end

return ServiceRegistry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="416">
            <Properties>
              <string name="Name">SpatialHashGrid</string>
              <string name="Source"><![CDATA[--/Types
export type newHashGrid = {
	CellSize: number,
	Grid: {},
	EntityCells: {},

	Update: (entity: any, position: Vector3) -> nil,
	Remove: (entity: any) -> nil,
	GetEntitiesInRange: (position: Vector3, range: number) -> { any },
	Clear: () -> nil,
}

export type SpatialHashGrid = {
	new: (cellSize: number) -> newHashGrid,
	Update: (self: newHashGrid, entity: any, position: Vector3) -> nil,
	Remove: (self: newHashGrid, entity: any) -> nil,
	GetEntitiesInRange: (self: newHashGrid, position: Vector3, range: number) -> { any },
	Clear: (self: newHashGrid) -> nil,
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function GetCellKey(x: number, z: number, cellSize: number)
	local cx = math.floor(x / cellSize)
	local cz = math.floor(z / cellSize)
	return cx .. "," .. cz
end

-------------------------------------------------
--// SpaitalHashGrid
-------------------------------------------------
local SpatialHashGrid = {} :: SpatialHashGrid
SpatialHashGrid.__index = SpatialHashGrid

function SpatialHashGrid.new(cellSize: number)
	local self = setmetatable({}, SpatialHashGrid)
	self.CellSize = cellSize
	self.Grid = {}
	self.EntityCells = {}
	return self
end

function SpatialHashGrid:Update(entity, position: Vector3)
	local newKey = GetCellKey(position.X, position.Z, self.CellSize)
	local oldKey = self.EntityCells[entity]

	if oldKey == newKey then
		return
	end

	if oldKey then
		local cell = self.Grid[oldKey]
		if cell then
			cell[entity] = nil
			if next(cell) == nil then
				self.Grid[oldKey] = nil
			end
		end
	end

	if not self.Grid[newKey] then
		self.Grid[newKey] = {}
	end
	self.Grid[newKey][entity] = true
	self.EntityCells[entity] = newKey
end

function SpatialHashGrid:Remove(entity)
	local oldKey = self.EntityCells[entity]
	if oldKey then
		local cell = self.Grid[oldKey]
		if cell then
			cell[entity] = nil
			if next(cell) == nil then
				self.Grid[oldKey] = nil
			end
		end
		self.EntityCells[entity] = nil
	end
end

function SpatialHashGrid:GetEntitiesInRange(position: Vector3, range: number)
	local entities = {}
	local cellSize = self.CellSize

	local minX = math.floor((position.X - range) / cellSize)
	local maxX = math.floor((position.X + range) / cellSize)
	local minZ = math.floor((position.Z - range) / cellSize)
	local maxZ = math.floor((position.Z + range) / cellSize)

	local rangeSq = range ^ 2

	for cx = minX, maxX do
		for cz = minZ, maxZ do
			local cellKey = cx .. "," .. cz
			local cell = self.Grid[cellKey]
			if cell then
				for entity in pairs(cell) do
					local entityPos = entity.Position
					if entityPos then
						local dx = entityPos.X - position.X
						local dz = entityPos.Z - position.Z
						if dx ^ 2 + dz ^ 2 <= rangeSq then
							table.insert(entities, entity)
						end
					end
				end
			end
		end
	end

	return entities
end

function SpatialHashGrid:Clear()
	table.clear(self.Grid)
	table.clear(self.EntityCells)
end

return SpatialHashGrid
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="417">
          <Properties>
            <string name="Name">Cutscene</string>
          </Properties>
          <Item class="ModuleScript" referent="418">
            <Properties>
              <string name="Name">ActorView</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Cleanup = require(script.Parent.Cleanup)
local ActorView = {}
ActorView.__index = ActorView
local bodyNames = {
	HumanoidRootPart = true, Head = true, Torso = true,
	["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
	UpperTorso = true, LowerTorso = true,
	LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true,
	LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
	RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
}

local function dispose(actor)
	actor.Active = false
	if actor.Connection then actor.Connection:Disconnect(); actor.Connection = nil end
	for _, saved in actor.Hidden do
		Cleanup.Try("Restore actor appearance", function()
			if saved.Instance.Parent then saved.Instance[saved.Property] = saved.Value end
		end)
	end
	table.clear(actor.Hidden)
	if actor.Track then
		local index = table.find(actor.Tracks, actor.Track)
		if index then table.remove(actor.Tracks, index) end
		Cleanup.Try("Stop avatar track", function() actor.Track:Stop(0) end)
		Cleanup.Try("Destroy avatar track", function() actor.Track:Destroy() end)
		actor.Track = nil
	end
	if actor.Animation then Cleanup.Try("Avatar animation", function() actor.Animation:Destroy() end); actor.Animation = nil end
	if actor.Model then Cleanup.Try("Avatar model", function() actor.Model:Destroy() end); actor.Model = nil end
end

function ActorView.new(state, config, tracks, onCreated)
	local self = setmetatable({ Actors = {}, Closed = false }, ActorView)
	if onCreated then onCreated(self) end -- publish ownership BEFORE any yielding work
	self.StateConnection = state.AncestryChanged:Connect(function()
		if not state.Parent then self:Destroy() end
	end)
	local deadline = os.clock() + 12
	for name, role in config.Actors or {} do
		local actor = { Active = true, Finished = false, Hidden = {}, Tracks = tracks }
		table.insert(self.Actors, actor)
		local function valid()
			return actor.Active and not self.Closed and state.Parent ~= nil and os.clock() < deadline
		end
		local function alive()
			return actor.Active and not self.Closed and state.Parent ~= nil
		end
		task.spawn(function()
			local ok, err = pcall(function()
				local slot, template
				while valid() do
					local profiles = state:FindFirstChild("ActorProfiles")
					local profile = profiles and profiles:FindFirstChild(tostring(Players.LocalPlayer.UserId))
					slot = profile and profile:FindFirstChild(role)
					local refs = state:FindFirstChild("RigTracks")
					local ref = refs and refs:FindFirstChild(name)
					local modelRef = ref and ref:FindFirstChild("Model")
					template = modelRef and modelRef.Value
					if slot and slot:GetAttribute("Status") then
						if slot:GetAttribute("Status") ~= "Ready" then return end
						if template and slot:FindFirstChild("Description") then break end
					end
					RunService.Heartbeat:Wait()
				end
				if not valid() then return end
				local sourceRoot = template:FindFirstChild("HumanoidRootPart")
				local sourceHumanoid = template:FindFirstChildOfClass("Humanoid")
				assert(sourceRoot, name .. " requires HumanoidRootPart")
				local rigType = if role == "Friend" then Enum.HumanoidRigType.R6
					elseif sourceHumanoid then sourceHumanoid.RigType
					elseif template:FindFirstChild("UpperTorso") then Enum.HumanoidRigType.R15
					elseif template:FindFirstChild("Torso") then Enum.HumanoidRigType.R6 else nil
				assert(rigType, name .. " requires a standard R6 or R15 skeleton")
				local description = slot.Description:Clone()
				-- Keep authored staging/proportions; clothing, colors, body assets and accessories are personal.
				local authored = if sourceHumanoid then sourceHumanoid:GetAppliedDescription() else Instance.new("HumanoidDescription")
				for _, property in { "HeightScale", "WidthScale", "DepthScale", "HeadScale", "BodyTypeScale", "ProportionScale" } do
					description[property] = authored[property]
				end
				authored:Destroy()
				local made, result = pcall(function()
					return Players:CreateHumanoidModelFromDescriptionAsync(description, rigType)
				end)
				description:Destroy()
				assert(made, tostring(result))
				if not valid() then result:Destroy(); return end -- late API result cannot resurrect a scene
				actor.Model = result
				local model = result
				model.Name = "LocalCutscene_" .. name
				model:SetAttribute("ActorUserId", slot:GetAttribute("UserId"))
				local root = assert(model:FindFirstChild("HumanoidRootPart"), "Avatar has no root")
				local humanoid = assert(model:FindFirstChildOfClass("Humanoid"), "Avatar has no Humanoid")
				humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				humanoid.AutoRotate = false
				humanoid.BreakJointsOnDeath = false
				humanoid.EvaluateStateMachine = false
				local visibility = {}
				for _, item in model:GetDescendants() do
					if item:IsA("BaseScript") then item:Destroy()
					elseif item:IsA("BasePart") then
						item.Anchored = item == root
						item.CanCollide, item.CanTouch, item.CanQuery = false, false, false
						item.Massless = true
						visibility[item] = item.LocalTransparencyModifier
						item.LocalTransparencyModifier = 1
					end
				end
				model:ScaleTo(template:GetScale())
				model:PivotTo(sourceRoot.CFrame * root.CFrame:Inverse() * model:GetPivot())
				model.Parent = workspace -- local-only; never replaces the real Player.Character
				actor.Root, actor.SourceRoot = root, sourceRoot
				actor.Animation = Instance.new("Animation")
				actor.Animation.AnimationId = "rbxassetid://" .. config.Animations[name]
				local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
				actor.Track = animator:LoadAnimation(actor.Animation)
				actor.Track.Priority = Enum.AnimationPriority.Action4
				actor.Track.Looped = false
				actor.Track:Play(0, 1, 0)
				local animationDeadline = math.min(deadline, os.clock() + 2)
				while alive() and os.clock() < animationDeadline and actor.Track.Length <= 0 do RunService.Heartbeat:Wait() end
				if not alive() then return end
				if actor.Track.Length <= 0 then
					warn("[CutsceneActors] " .. name .. " animation unavailable; showing personalized static actor")
					Cleanup.Try("Unavailable avatar track", function() actor.Track:Stop(0); actor.Track:Destroy() end)
					actor.Track = nil
					actor.Animation:Destroy()
					actor.Animation = nil
				end
				-- Swap only after the replacement is fully ready. Keep source joints/VFX intact.
				local function hide(item)
					local owner = item
					local part = if item:IsA("BasePart") then item else item.Parent
					local isAppearance = part and part.Parent == template and bodyNames[part.Name] == true
					while owner and owner ~= template do
						if owner:IsA("Accessory") then
							isAppearance = true
							break
						end
						owner = owner.Parent
					end
					if not isAppearance then return end -- retain separately authored scene props/weapons
					local property = if item:IsA("BasePart") then "LocalTransparencyModifier"
						elseif item:IsA("Decal") then "Transparency" else nil
					if property then
						table.insert(actor.Hidden, { Instance = item, Property = property, Value = item[property] })
						item[property] = 1
					end
				end
				for _, item in template:GetDescendants() do hide(item) end
				actor.Connection = template.DescendantAdded:Connect(hide)
				if sourceHumanoid then
					table.insert(actor.Hidden, { Instance = sourceHumanoid, Property = "DisplayDistanceType", Value = sourceHumanoid.DisplayDistanceType })
					sourceHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				end
				for part, value in visibility do if part.Parent then part.LocalTransparencyModifier = value end end
				if actor.Track then table.insert(tracks, actor.Track) end -- same ECS PreAnimation clock
				actor.Committed = true
			end)
			actor.Finished = true
			if not actor.Committed then
				dispose(actor)
				warn("[CutsceneActors] " .. name .. ": using authored rig (" .. (if ok then "appearance unavailable" else tostring(err)) .. ")")
			end
		end)
	end
	while state.Parent and os.clock() < deadline do
		local finished = true
		for _, actor in self.Actors do if not actor.Finished then finished = false end end
		if finished then break end
		RunService.Heartbeat:Wait()
	end
	for _, actor in self.Actors do
		if not actor.Finished then dispose(actor) end
	end
	if not state.Parent then self:Destroy() end
	return self
end

function ActorView:PreAnimation()
	for _, actor in self.Actors do
		if actor.Committed and actor.Root and actor.Root.Parent and actor.SourceRoot.Parent then
			actor.Root.CFrame = actor.SourceRoot.CFrame
		end
	end
end

function ActorView:Destroy()
	if self.Closed then return end
	self.Closed = true
	if self.StateConnection then self.StateConnection:Disconnect(); self.StateConnection = nil end
	for _, actor in self.Actors do Cleanup.Try("Dispose avatar", function() dispose(actor) end) end
end

return ActorView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="419">
            <Properties>
              <string name="Name">Cleanup</string>
              <string name="Source"><![CDATA[-- Cleanup must continue even if a destroyed track/property rejects an operation.
local Cleanup = {}
function Cleanup.Try(label, callback, report)
	local ok, err = pcall(callback)
	if not ok then (report or warn)("[CutsceneCleanup] " .. label .. ": " .. tostring(err)) end
	return ok
end
function Cleanup.All(steps, report)
	local ok = true
	for _, step in steps do
		if not Cleanup.Try(step.Name, step.Run, report) then ok = false end
	end
	return ok
end
return Cleanup
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="420">
            <Properties>
              <string name="Name">ClientRigTracks</string>
              <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Cleanup = require(script.Parent.Cleanup)
local ClientRigTracks = {}
ClientRigTracks.__index = ClientRigTracks

function ClientRigTracks.new(state)
	return setmetatable({ State = state, Tracks = {}, Seen = {}, Entries = {}, Closed = false }, ClientRigTracks)
end

function ClientRigTracks:Prepare(ready)
	local deadline = os.clock() + 30
	local refs = assert(self.State:WaitForChild("RigTracks", 10), "RigTracks missing")
	local lastStatus = nil
	while self.State.Parent and not self.Closed do
		local loaded, pending = 0, {}
		for _, reference in refs:GetChildren() do
			local optional = reference:GetAttribute("Optional") == true
			local animator = reference.Value
			local id = reference:GetAttribute("AnimationId")
			local entry = self.Entries[reference]
			if animator and id and not entry then
				entry = { Animator = animator, Since = os.clock(), Tracks = {} }
				self.Entries[reference] = entry
				local function collect(track)
					if self.Closed then return end
					local animation = track.Animation
					if animation and animation.AnimationId:match("%d+") == id and not self.Seen[track] then
						self.Seen[track] = true
						table.insert(self.Tracks, track)
						table.insert(entry.Tracks, track)
					end
				end
				entry.Collect = collect
				entry.Connection = animator.AnimationPlayed:Connect(collect)
			end
			local available = false
			if entry then
				for _, track in animator:GetPlayingAnimationTracks() do entry.Collect(track) end
				for _, track in entry.Tracks do
					if track.Length > 0 and track.IsPlaying then available = true end
				end
				-- A paused server track may not arrive with its Animator. Load a local
				-- rendering fallback; later replicated copies join the SAME clock too.
				if not optional and not available and not entry.OwnedTrack and os.clock() - entry.Since >= 2 then
					entry.Animation = Instance.new("Animation")
					entry.Animation.AnimationId = "rbxassetid://" .. id
					entry.OwnedTrack = animator:LoadAnimation(entry.Animation)
					entry.OwnedTrack.Priority = Enum.AnimationPriority.Action4
					entry.OwnedTrack.Looped = false
					entry.Collect(entry.OwnedTrack)
					entry.OwnedTrack:Play(0, 1, 0)
				end
			end
			if available then
				if not optional then loaded += 1 end
			elseif not optional then
				table.insert(pending, reference.Name .. " (" .. tostring(id) .. ")")
			end
		end
		local expected = self.State:GetAttribute("TrackCount")
		if expected and expected > 0 and loaded == expected then return self.Tracks end
		local status = "Animation rigs " .. loaded .. "/" .. tostring(expected) .. ": " .. table.concat(pending, ", ")
		if status ~= lastStatus then ready:FireServer("Stage", status); lastStatus = status end
		assert(os.clock() < deadline, status .. "; check animation permissions and rig replication")
		RunService.Heartbeat:Wait()
	end
	return self.Tracks
end

function ClientRigTracks:Destroy()
	if self.Closed then return end
	self.Closed = true
	for _, entry in self.Entries do
		if entry.Connection then entry.Connection:Disconnect() end
		if entry.OwnedTrack then
			Cleanup.Try("Stop fallback animation", function() entry.OwnedTrack:Stop(0) end)
			Cleanup.Try("Destroy fallback animation", function() entry.OwnedTrack:Destroy() end)
		end
		if entry.Animation then entry.Animation:Destroy() end
	end
	table.clear(self.Entries)
end
return ClientRigTracks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="421">
            <Properties>
              <string name="Name">CutscenePlayer</string>
              <string name="Source"><![CDATA[local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CutsceneData = require(ReplicatedStorage.Settings.Data.CutsceneData)

local CUTSCENE_ROOT = { "Assets", "Cutscenes" }
local RENDER_STEP_NAME = "CutsceneCamera"

local CutscenePlayer = {}

local activeToken = 0
local activeScene: { Instance }? = nil
local activeTracks: { AnimationTrack }? = nil
local savedCameraState = nil

local function findPath(root: Instance, path: { string }): Instance?
	local current = root
	for _, name in ipairs(path) do
		local child = current:WaitForChild(name, 10)
		if not child then
			return nil
		end
		current = child
	end
	return current
end

local function findInScene(sceneRoots: { Instance }, name: string): Instance?
	for _, root in ipairs(sceneRoots) do
		if root.Name == name then
			return root
		end

		local descendant = root:FindFirstChild(name, true)
		if descendant then
			return descendant
		end
	end
	return nil
end

local function getAnimator(model: Model): Animator
	local animator = model:FindFirstChildWhichIsA("Animator", true)
	if animator then
		return animator
	end

	local animationHost = model:FindFirstChildWhichIsA("Humanoid", true)
		or model:FindFirstChildWhichIsA("AnimationController", true)

	if not animationHost then
		local animationController = Instance.new("AnimationController")
		animationController.Name = "CutsceneAnimationController"
		animationController.Parent = model
		animationHost = animationController
	end

	animator = Instance.new("Animator")
	animator.Parent = animationHost
	return animator
end

local function cloneScene(sceneSource: Instance): { Instance }
	local sceneRoots = {}

	for _, source in ipairs(sceneSource:GetChildren()) do
		local wasArchivable = source.Archivable
		source.Archivable = true
		local instance = source:Clone()
		source.Archivable = wasArchivable

		instance.Parent = workspace
		table.insert(sceneRoots, instance)
	end

	return sceneRoots
end

local function restoreCamera()
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)

	local camera = workspace.CurrentCamera
	local state = savedCameraState
	if camera and state then
		camera.CameraType = state.CameraType
		camera.CameraSubject = state.CameraSubject
		camera.CFrame = state.CFrame
		camera.Focus = state.Focus
		camera.FieldOfView = state.FieldOfView
	end

	savedCameraState = nil
end

local function cleanActiveCutscene()
	restoreCamera()

	if activeTracks then
		for _, track in ipairs(activeTracks) do
			track:Stop(0)
			track:Destroy()
		end
		activeTracks = nil
	end

	if activeScene then
		for _, instance in ipairs(activeScene) do
			instance:Destroy()
		end
		activeScene = nil
	end
end

local function loadAnimations(
	sceneRoots: { Instance },
	animations: { [string]: number }
): { AnimationTrack }
	local tracks = {}
	local animationInstances = {}
	local animationTargets = {}

	for targetName, animationId in animations do
		local target = findInScene(sceneRoots, targetName)
		if not target or not target:IsA("Model") then
			warn(`[CutscenePlayer] Animation target "{targetName}" was not found.`)
			continue
		end

		local animation = Instance.new("Animation")
		animation.Name = `{targetName}CutsceneAnimation`
		animation.AnimationId = `rbxassetid://{animationId}`
		table.insert(animationInstances, animation)
		animationTargets[animation] = target
	end

	pcall(function()
		ContentProvider:PreloadAsync(animationInstances)
	end)

	for _, animation in ipairs(animationInstances) do
		local target = animationTargets[animation]
		local targetName = target.Name
		if target and target:IsA("Model") then
			local success, track = pcall(function()
				return getAnimator(target):LoadAnimation(animation)
			end)

			if success then
				track.Priority = Enum.AnimationPriority.Action4
				track.Looped = false
				table.insert(tracks, track)
			else
				warn(`[CutscenePlayer] Failed to load animation for "{targetName}": {track}`)
			end
		end
		animation:Destroy()
	end

	return tracks
end

function CutscenePlayer.Stop()
	activeToken += 1
	cleanActiveCutscene()
end

function CutscenePlayer.Play(cutsceneName: string): boolean
	local config = CutsceneData[cutsceneName]
	if not config then
		warn(`[CutscenePlayer] Cutscene data "{cutsceneName}" does not exist.`)
		return false
	end

	CutscenePlayer.Stop()
	local token = activeToken

	local cutsceneRoot = findPath(ReplicatedStorage, CUTSCENE_ROOT)
	local sceneSource = cutsceneRoot and findPath(cutsceneRoot, config.ScenePath)
	if not sceneSource then
		warn(`[CutscenePlayer] Scene source for "{cutsceneName}" was not found.`)
		return false
	end

	local sceneRoots = cloneScene(sceneSource)
	activeScene = sceneRoots
	print(`[CutscenePlayer] Loaded {#sceneRoots} objects for "{cutsceneName}" into Workspace.`)

	local cameraModel = findInScene(sceneRoots, config.Camera.Model)
	local cameraPart = cameraModel and cameraModel:FindFirstChild(config.Camera.Part, true)
	if not cameraPart or not cameraPart:IsA("BasePart") then
		warn(`[CutscenePlayer] Camera part "{config.Camera.Model}.{config.Camera.Part}" was not found.`)
		cleanActiveCutscene()
		return false
	end

	local camera = workspace.CurrentCamera
	if not camera then
		warn("[CutscenePlayer] CurrentCamera is unavailable.")
		cleanActiveCutscene()
		return false
	end

	savedCameraState = {
		CameraType = camera.CameraType,
		CameraSubject = camera.CameraSubject,
		CFrame = camera.CFrame,
		Focus = camera.Focus,
		FieldOfView = camera.FieldOfView,
	}

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = cameraPart.CFrame
	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if cameraPart.Parent and workspace.CurrentCamera then
			workspace.CurrentCamera.CFrame = cameraPart.CFrame
		end
	end)

	local tracks = loadAnimations(sceneRoots, config.Animations)
	activeTracks = tracks

	for _, track in ipairs(tracks) do
		track:Play(0, 1, 1)
	end
	RunService.Heartbeat:Wait()

	local startedAt = os.clock()
	local maxDuration = config.MaxDuration or 60
	while activeToken == token and os.clock() - startedAt < maxDuration do
		local hasPlayingTrack = false
		for _, track in ipairs(tracks) do
			if track.IsPlaying then
				hasPlayingTrack = true
				break
			end
		end
		if not hasPlayingTrack then
			break
		end
		RunService.Heartbeat:Wait()
	end

	if activeToken == token then
		activeToken += 1
		cleanActiveCutscene()
	end

	return true
end

return CutscenePlayer
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="422">
            <Properties>
              <string name="Name">ECS</string>
            </Properties>
            <Item class="ModuleScript" referent="423">
              <Properties>
                <string name="Name">AudioSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)

return function(world)
	for entity, session, audio in world:query(Components.Session, Components.AudioTrack) do
		local start = session.State:GetAttribute("StartedAt")
		if audio.Started or not start or not session.State.Parent then continue end
		local elapsed = workspace:GetServerTimeNow() - start
		if elapsed < 0 or not audio.Sound.IsLoaded then continue end
		-- Seek once on start to compensate for a late frame; never seek every frame.
		if audio.Sound.TimeLength <= 0 or elapsed < audio.Sound.TimeLength then
			audio.Sound.TimePosition = elapsed
			audio.Sound:Play()
		end
		world:insert(entity, audio:patch({ Started = true }))
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="424">
              <Properties>
                <string name="Name">CameraRuntime</string>
                <string name="Source"><![CDATA[local Matter = require(game:GetService("ReplicatedStorage").Packages.Matter)
local Components = require(script.Parent.Components)
local SampleTrack = require(script.Parent.SampleTrack)
local CameraSystem = require(script.Parent.CameraSystem)
local VFXSystem = require(script.Parent.VFXSystem)
local AudioSystem = require(script.Parent.AudioSystem)
local ImpactSystem = require(script.Parent.ImpactSystem)
local ScreenEffectSystem = require(script.Parent.ScreenEffectSystem)
local ScreenEffects = require(script.Parent.Parent.ScreenEffects)
local ImpactFrames = require(script.Parent.Parent.ImpactFrames)
local VFXContext = require(script.Parent.Parent.VFXContext)
local PlaybackClock = require(script.Parent.Parent.PlaybackClock)
local Prepare = require(script.Parent.Parent.Prepare)
local ActorView = require(script.Parent.Parent.ActorView)
local Cleanup = require(script.Parent.Parent.Cleanup)

local CameraRuntime = {}
CameraRuntime.__index = CameraRuntime

function CameraRuntime.new(state, reference, config, tracks)
	local world = Matter.World.new()
	local entity = world:spawn(
		Components.Session({ State = state, Elapsed = 0 }),
		Components.CameraTarget({ Reference = reference })
	)
	local self = setmetatable({ World = world, Entity = entity, State = state, Tracks = tracks }, CameraRuntime)
	local ok, err = xpcall(function()
	local fov = config and config.Camera.FOV
	local vfx = config and config.VFX
	if fov then
		assert(not fov.FPS or fov.FPS > 0, "FOV FPS must be positive")
		world:insert(entity, Components.FOVTrack({
			Samples = fov.Samples, Keys = SampleTrack.Keys(fov.Samples), FPS = fov.FPS, Cuts = fov.Cuts,
		}))
	end
	local jobs = {}
	local actorView = nil
	if config and config.Actors then
		jobs.Actors = { Timeout = 15,
			Run = function() return ActorView.new(state, config, tracks, function(view) actorView = view; self.ActorView = view end) end,
			Cancel = function() if actorView then actorView:Destroy() end end,
		}
	end
	local sound = nil
	if config and config.Audio then
		sound = Instance.new("Sound")
		self.Sound = sound
		sound.Name = "CutsceneAudio"
		sound.SoundId = "rbxassetid://" .. config.Audio.SoundId
		sound.Volume = config.Audio.Volume or 1
		sound.Looped = false
		sound.Parent = game:GetService("SoundService")
		jobs.Audio = { Timeout = 8, Run = function()
			game:GetService("ContentProvider"):PreloadAsync({ sound })
		end }
		world:insert(entity, Components.AudioTrack({ Sound = sound, Started = false }))
	end
	if vfx then
		jobs.VFX = { Timeout = 25, Run = function() return VFXContext.new(state, vfx.Events) end }
	end
	if config and config.ImpactFrames then
		jobs.Impact = { Timeout = 10, Run = function() return ImpactFrames.new(config.ImpactFrames) end }
	end
	if config and config.ScreenEffects then
		jobs.Screen = { Timeout = 5, Run = function() return ScreenEffects.new(config.ScreenEffects) end }
	end
	local prepared = Prepare.All(jobs)
	local context = prepared.VFX and prepared.VFX.Success and prepared.VFX.Value or nil
	self.VFXContext = context
	self.ImpactView = prepared.Impact and prepared.Impact.Success and prepared.Impact.Value or nil
	self.ScreenView = prepared.Screen and prepared.Screen.Success and prepared.Screen.Value or nil
	if context then
		local keys = {}
		for frame in vfx.Events do table.insert(keys, frame) end
		table.sort(keys)
		world:insert(entity, Components.VFXTrack({
			Events = vfx.Events, Keys = keys, NextIndex = 1, EndFrame = vfx.EndFrame, FPS = vfx.FPS,
			Run = function(event) context:Run(event) end,
		}))
	end
	local impactView = prepared.Impact and prepared.Impact.Success and prepared.Impact.Value or nil
	local screenView = prepared.Screen and prepared.Screen.Success and prepared.Screen.Value or nil
	if screenView then
		local screen = config.ScreenEffects
		world:insert(entity, Components.ScreenEffectTrack({
			View = screenView, EndFrame = screen.EndFrame, FPS = screen.FPS,
		}))
	end
	if impactView then
		local impact = config.ImpactFrames
		world:insert(entity, Components.ImpactTrack({
			Events = impact.Events, EndFrame = impact.EndFrame, FPS = impact.FPS, View = impactView,
		}))
	end
	end, debug.traceback)
	if not ok then self:Destroy(); error(err, 0) end
	return self
end

-- Called before Animator evaluates poses. Rendering uses this exact sample.
function CameraRuntime:PreAnimation()
	if self.Destroyed or not self.State.Parent then return end
	if self.ActorView then self.ActorView:PreAnimation() end
	local elapsed = PlaybackClock.Elapsed(self.State, workspace:GetServerTimeNow())
	PlaybackClock.Apply(self.Tracks, elapsed)
	self.World:insert(self.Entity, Components.Session({ State = self.State, Elapsed = elapsed }))
end

function CameraRuntime:Step()
	CameraSystem(self.World)
	ScreenEffectSystem(self.World)
	ImpactSystem(self.World)
	AudioSystem(self.World)
	VFXSystem(self.World)
end

function CameraRuntime:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	if self.ActorView then Cleanup.Try("Actors", function() self.ActorView:Destroy() end); self.ActorView = nil end
	if self.ScreenView then
		Cleanup.Try("Screen effects", function() self.ScreenView:Destroy() end)
		self.ScreenView = nil
	end
	if self.VFXContext then
		Cleanup.Try("VFX", function() self.VFXContext:Destroy() end)
		self.VFXContext = nil
	end
	if self.ImpactView then
		Cleanup.Try("Impact images", function() self.ImpactView:Destroy() end)
		self.ImpactView = nil
	end
	if self.Sound then
		Cleanup.Try("Stop audio", function() self.Sound:Stop() end)
		Cleanup.Try("Destroy audio", function() self.Sound:Destroy() end)
		self.Sound = nil
	end
	Cleanup.Try("ECS session", function() self.World:despawn(self.Entity) end)
end

return CameraRuntime
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="425">
              <Properties>
                <string name="Name">CameraSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)
local SampleTrack = require(script.Parent.SampleTrack)

return function(world)
	local camera = workspace.CurrentCamera
	if not camera then return end
	for _, session, target in world:query(Components.Session, Components.CameraTarget) do
		local part = target.Reference.Value
		if session.State.Parent and part and part.Parent then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = part.CFrame
		end
	end
	for _, session, track in world:query(Components.Session, Components.FOVTrack) do
		if not session.State.Parent then continue end
		local elapsed = session.Elapsed
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS
		if not fps then
			fps = if duration and duration > 0 then track.Keys[#track.Keys] / duration else 0
		end
		camera.FieldOfView = math.clamp(
			SampleTrack.Read(track.Samples, track.Keys, elapsed * fps, track.Cuts), 1, 120
		)
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="426">
              <Properties>
                <string name="Name">Components</string>
                <string name="Source"><![CDATA[local Matter = require(game:GetService("ReplicatedStorage").Packages.Matter)

return {
	Session = Matter.component("CutsceneSession"),
	CameraTarget = Matter.component("CutsceneCameraTarget"),
	FOVTrack = Matter.component("CutsceneFOVTrack"),
	VFXTrack = Matter.component("CutsceneVFXTrack"),
	AudioTrack = Matter.component("CutsceneAudioTrack"),
	ImpactTrack = Matter.component("CutsceneImpactTrack"),
	ScreenEffectTrack = Matter.component("CutsceneScreenEffectTrack"),
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="427">
              <Properties>
                <string name="Name">CubicBezier</string>
                <string name="Source"><![CDATA[-- Solve x(t) = progress, then sample y(t); y may overshoot while x must be monotonic.
local CubicBezier = {}

function CubicBezier.Create(params)
	params = params or {}
	local x1, y1 = params.X1 or params.x1 or 0.25, params.Y1 or params.y1 or 0.1
	local x2, y2 = params.X2 or params.x2 or 0.25, params.Y2 or params.y2 or 1
	for _, value in { x1, y1, x2, y2 } do
		assert(type(value) == "number" and value == value and math.abs(value) < math.huge, "Bezier controls must be finite numbers")
	end
	assert(x1 >= 0 and x1 <= 1 and x2 >= 0 and x2 <= 1, "Bezier X controls must be in [0, 1]")
	local function sample(t, a, b)
		local inverse = 1 - t
		return 3 * inverse * inverse * t * a + 3 * inverse * t * t * b + t * t * t
	end
	return function(alpha)
		if alpha <= 0 then return 0 end
		if alpha >= 1 then return 1 end
		local guess = alpha
		for _ = 1, 6 do
			local errorX = sample(guess, x1, x2) - alpha
			if math.abs(errorX) < 1e-7 then return sample(guess, y1, y2) end
			local inverse = 1 - guess
			local derivative = 3 * inverse * inverse * x1 + 6 * inverse * guess * (x2 - x1)
				+ 3 * guess * guess * (1 - x2)
			if math.abs(derivative) < 1e-7 then break end
			local nextGuess = guess - errorX / derivative
			if nextGuess < 0 or nextGuess > 1 then break end
			guess = nextGuess
		end
		local low, high = 0, 1
		for _ = 1, 30 do
			guess = (low + high) * 0.5
			local x = sample(guess, x1, x2)
			if math.abs(x - alpha) < 1e-7 then break end
			if x < alpha then low = guess else high = guess end
		end
		return sample(guess, y1, y2)
	end
end

return CubicBezier
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="428">
              <Properties>
                <string name="Name">ImpactSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)
local ImpactTrack = require(script.Parent.ImpactTrack)

return function(world)
	for _, session, track in world:query(Components.Session, Components.ImpactTrack) do
		local startedAt = session.State:GetAttribute("StartedAt")
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS or (duration and duration > 0 and track.EndFrame / duration)
		if not session.State.Parent or not startedAt or workspace:GetServerTimeNow() < startedAt or not fps then
			track.View:Show(false, false)
			continue
		end
		-- Use the same PreAnimation sample as rig poses and FOV, without yielding/tweens.
		track.View:Show(ImpactTrack.Read(track.Events, track.View.Keys, session.Elapsed * fps), true)
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="429">
              <Properties>
                <string name="Name">ImpactTrack</string>
                <string name="Source"><![CDATA[-- A held image state, not a queue of callbacks: skipped frames never replay old flashes.
local ImpactTrack = {}

function ImpactTrack.Keys(events)
	local keys = {}
	for frame, imageId in pairs(events) do
		assert(type(frame) == "number" and frame >= 0 and frame % 1 == 0, "Impact frame must be a nonnegative integer")
		assert(imageId == false or (type(imageId) == "number" and imageId > 0 and imageId % 1 == 0), "Impact image must be an asset ID or false")
		table.insert(keys, frame)
	end
	table.sort(keys)
	return keys
end

function ImpactTrack.Read(events, keys, frame)
	local low, high = 1, #keys
	local result = false
	while low <= high do
		local middle = math.floor((low + high) / 2)
		if keys[middle] <= frame then
			result = events[keys[middle]]
			low = middle + 1
		else
			high = middle - 1
		end
	end
	return result
end

return ImpactTrack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="430">
              <Properties>
                <string name="Name">PropertyTrack</string>
                <string name="Source"><![CDATA[-- Stateless sampling: no private clock, connections, Tween instances or accumulated dt.
local PropertyTrack = {}

function PropertyTrack.Prepare(keys, expectedType, resolveEase)
	local prepared = {}
	local sequence = keys.Sequence or keys -- support old arrays and new Moon exports
	if keys.Default ~= nil then
		assert(typeof(keys.Default) == expectedType, "Property Default must be " .. expectedType)
		if expectedType == "number" then
			assert(keys.Default == keys.Default and math.abs(keys.Default) < math.huge, "Property Default must be finite")
		end
		prepared.Default = keys.Default
	end
	for _, key in ipairs(sequence) do
		assert(type(key.Frame) == "number" and key.Frame >= 0 and key.Frame < math.huge
			and key.Frame % 1 == 0, "Property key Frame must be a nonnegative integer")
		assert(typeof(key.Value) == expectedType, "Property key Value must be " .. expectedType)
		if expectedType == "number" then
			assert(key.Value == key.Value and math.abs(key.Value) < math.huge, "Property value must be finite")
		end
		table.insert(prepared, {
			Frame = key.Frame, Value = key.Value,
			Ease = if key.Ease and resolveEase then resolveEase(key.Ease) else nil,
		})
	end
	table.sort(prepared, function(a, b) return a.Frame < b.Frame end)
	for index = 2, #prepared do
		assert(prepared[index - 1].Frame ~= prepared[index].Frame, "Duplicate property key frame")
	end
	return prepared
end

function PropertyTrack.Read(track, frame)
	if #track == 0 then return track.Default end
	if frame <= track[1].Frame then return track[1].Value end
	if frame >= track[#track].Frame then return track[#track].Value end
	local low, high = 1, #track
	while high - low > 1 do
		local middle = math.floor((low + high) / 2)
		if track[middle].Frame <= frame then low = middle else high = middle end
	end
	local left, right = track[low], track[high]
	local kind = typeof(left.Value)
	-- Discrete values switch at the actual key, not early when an easing overshoots.
	if kind == "boolean" then return left.Value end
	local alpha = (frame - left.Frame) / (right.Frame - left.Frame)
	if left.Ease then alpha = left.Ease(alpha) end
	if kind == "number" then return left.Value + (right.Value - left.Value) * alpha end
	if kind == "Color3" or kind == "Vector2" or kind == "Vector3" then
		return left.Value:Lerp(right.Value, alpha)
	end
	return left.Value
end

return PropertyTrack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="431">
              <Properties>
                <string name="Name">SampleTrack</string>
                <string name="Source"><![CDATA[local SampleTrack = {}

function SampleTrack.Keys(samples)
	local keys = {}
	for frame, value in samples do
		assert(type(frame) == "number" and type(value) == "number", "FOV samples must be numeric")
		table.insert(keys, frame)
	end
	table.sort(keys)
	assert(#keys > 0, "Empty FOV track")
	return keys
end

function SampleTrack.Read(samples, keys, frame, cuts)
	if frame <= keys[1] then return samples[keys[1]] end
	if frame >= keys[#keys] then return samples[keys[#keys]] end
	local low, high = 1, #keys
	while high - low > 1 do
		local middle = math.floor((low + high) / 2)
		if keys[middle] <= frame then low = middle else high = middle end
	end
	local left, right = keys[low], keys[high]
	if cuts and cuts[right] then return samples[left] end
	local alpha = (frame - left) / (right - left)
	return samples[left] + (samples[right] - samples[left]) * alpha
end

return SampleTrack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="432">
              <Properties>
                <string name="Name">ScreenEffectSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)

return function(world)
	for _, session, track in world:query(Components.Session, Components.ScreenEffectTrack) do
		local start = session.State:GetAttribute("StartedAt")
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS or (duration and duration > 0 and track.EndFrame / duration)
		if not session.State.Parent or not start or workspace:GetServerTimeNow() < start or not fps then
			track.View:ApplyFrame(0, false)
			continue
		end
		-- Same PreAnimation sample as the camera pose, FOV and impact images.
		track.View:ApplyFrame(session.Elapsed * fps, true)
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="433">
              <Properties>
                <string name="Name">VFXSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)

return function(world)
	for entity, session, track in world:query(Components.Session, Components.VFXTrack) do
		local startedAt = session.State:GetAttribute("StartedAt")
		-- Frame zero fires only once the server's scheduled start is reached.
		if not session.State.Parent or not startedAt or workspace:GetServerTimeNow() < startedAt then continue end
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS or (duration and duration > 0 and track.EndFrame / duration)
		if not fps then continue end
		local frame = session.Elapsed * fps
		local nextIndex = track.NextIndex
		while nextIndex <= #track.Keys and track.Keys[nextIndex] <= frame do
			local event = track.Events[track.Keys[nextIndex]]
			nextIndex += 1
			-- Reserve the event before dispatching potentially yielding third-party VFX.
			task.spawn(track.Run, event)
		end
		if nextIndex ~= track.NextIndex then
			world:insert(entity, track:patch({ NextIndex = nextIndex }))
		end
	end
end
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="434">
            <Properties>
              <string name="Name">FriendSelection</string>
              <string name="Source"><![CDATA[-- Select only IDs returned by Roblox for this user's friends; never invent a fallback ID.
local FriendSelection = {}
function FriendSelection.FromPage(page, userId, randomIndex)
	local candidates, seen = {}, {}
	for _, item in page do
		local id = item.Id
		if type(id) == "number" and id > 0 and id % 1 == 0 and id ~= userId and not seen[id] then
			seen[id] = true
			table.insert(candidates, id)
		end
	end
	if #candidates == 0 then return nil end
	return candidates[randomIndex(#candidates)]
end
return FriendSelection
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="435">
            <Properties>
              <string name="Name">ImpactFrames</string>
              <string name="Source"><![CDATA[local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local Prepare = require(script.Parent.Prepare)
local ImpactTrack = require(script.Parent.ECS.ImpactTrack)

local ImpactFrames = {}
ImpactFrames.__index = ImpactFrames

function ImpactFrames.new(config)
	assert(config.EndFrame > 0, "ImpactFrames.EndFrame must be positive")
	assert(not config.FPS or config.FPS > 0, "ImpactFrames.FPS must be positive")
	local keys = ImpactTrack.Keys(config.Events)
	local gui = Instance.new("ScreenGui")
	gui.Name = "CutsceneImpactFrames"
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ClipToDeviceSafeArea = false
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10000
	gui.Enabled = false
	local images, assets = {}, {}
	for _, frame in ipairs(keys) do
		local imageId = config.Events[frame]
		if imageId and not images[imageId] then
			local label = Instance.new("ImageLabel")
			label.Name = tostring(imageId)
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.BorderSizePixel = 0
			label.Image = "rbxassetid://" .. imageId
			label.ScaleType = Enum.ScaleType.Stretch
			label.ZIndex = 1
			label.Visible = false
			label.Parent = gui
			images[imageId] = label
			table.insert(assets, label)
		end
	end
	local persistentImage = nil
	if config.PersistentImage then
		local settings = config.PersistentImage
		persistentImage = Instance.new("ImageLabel")
		persistentImage.Name = "PersistentImage"
		persistentImage.Size = UDim2.fromScale(1, 1)
		persistentImage.BackgroundTransparency = 1
		persistentImage.BorderSizePixel = 0
		persistentImage.Image = "rbxassetid://" .. settings.ImageId
		persistentImage.ImageTransparency = settings.ImageTransparency or 0
		persistentImage.ScaleType = Enum.ScaleType.Stretch
		persistentImage.ZIndex = 2
		persistentImage.Parent = gui
		table.insert(assets, persistentImage)
	end
	-- Preload the actual labels before the client acknowledges cutscene readiness.
	local loaded = Prepare.Try("Impact image preload", 8, function()
		local failed = {}
		ContentProvider:PreloadAsync(assets, function(assetId, status)
			if status ~= Enum.AssetFetchStatus.Success then
				table.insert(failed, assetId .. " (" .. status.Name .. ")")
			end
		end)
		assert(#failed == 0, "Impact images failed: " .. table.concat(failed, ", "))
	end)
	if not loaded then
		gui:Destroy()
		warn("[CutsceneImpactFrames] Disabled for this playback because images were not ready; check image permissions/network.")
		return nil
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return setmetatable({ Gui = gui, Images = images, Current = false, Keys = keys, PersistentImage = persistentImage }, ImpactFrames)
end

function ImpactFrames:Show(imageId, isPlaying)
	-- Hiding a timed impact must not hide the persistent overlay. Update even
	-- when the event stays false across the scheduled start/end boundary.
	self.Gui.Enabled = isPlaying and (imageId ~= false or self.PersistentImage ~= nil)
	if self.Current == imageId then return end
	if self.Current then self.Images[self.Current].Visible = false end
	if imageId then self.Images[imageId].Visible = true end
	self.Current = imageId
end

function ImpactFrames:Destroy()
	self.Gui.Enabled = false
	self.Gui:Destroy()
end

return ImpactFrames
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="436">
            <Properties>
              <string name="Name">PlaybackClock</string>
              <string name="Source"><![CDATA[local PlaybackClock = {}

function PlaybackClock.Elapsed(state, now)
	local start = state:GetAttribute("StartedAt")
	return if start then math.max(0, now - start) else 0
end

function PlaybackClock.Apply(tracks, elapsed)
	for _, track in tracks do
		-- Recover a stopped track instead of silently leaving the actor frozen.
		if not track.IsPlaying then track:Play(0, 1, 0) end
		-- No independent advancement between sampling and pose evaluation.
		track:AdjustSpeed(0)
		track.TimePosition = math.clamp(elapsed, 0, math.max(0, track.Length - 0.000001))
	end
end

function PlaybackClock.Duration(cameraLength, maximum)
	assert(type(cameraLength) == "number" and cameraLength > 0 and cameraLength < math.huge, "Invalid camera duration")
	maximum = maximum or 60
	assert(maximum > 0 and maximum < math.huge, "Invalid maximum duration")
	return math.min(cameraLength, maximum)
end

return PlaybackClock
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="437">
            <Properties>
              <string name="Name">Prepare</string>
              <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Prepare = {}

-- External asset loaders must not indefinitely prevent the camera-ready signal.
function Prepare.Try(label, timeout, callback, onCancel)
	local finished, success, result = false, false, nil
	local thread = task.spawn(function()
		success, result = pcall(callback)
		finished = true
	end)
	local deadline = os.clock() + timeout
	while not finished and os.clock() < deadline do RunService.Heartbeat:Wait() end
	if not finished then
		if onCancel then pcall(onCancel) end
		pcall(task.cancel, thread)
		warn("[CutscenePrepare] " .. label .. " timed out after " .. timeout .. "s")
		return false, nil
	end
	if not success then
		if onCancel then pcall(onCancel) end
		warn("[CutscenePrepare] " .. label .. ": " .. tostring(result))
	end
	return success, result
end

-- Independent bounded jobs share the preparation window instead of stacking it.
function Prepare.All(jobs)
	local results = {}
	local pending = 0
	for _ in jobs do pending += 1 end
	for name, job in jobs do
		task.spawn(function()
			local ok, value = Prepare.Try(name, job.Timeout, job.Run, job.Cancel)
			results[name] = { Success = ok, Value = value }
			pending -= 1
		end)
	end
	while pending > 0 do RunService.Heartbeat:Wait() end
	return results
end

return Prepare
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="438">
            <Properties>
              <string name="Name">ScenePaths</string>
              <string name="Source"><![CDATA[local ScenePaths = {}

function ScenePaths.Key(path)
	assert(#path > 0, "Empty VFX path")
	local segments = {}
	for _, name in path do
		assert(type(name) == "string" and name ~= "", "Invalid VFX path segment")
		table.insert(segments, #name .. ":" .. name)
	end
	return table.concat(segments)
end

function ScenePaths.Collect(events)
	local paths = {}
	for _, event in events or {} do
		for _, kind in { "Emit", "AbsoluteEmit" } do
			for _, path in event[kind] or {} do paths[ScenePaths.Key(path)] = path end
		end
	end
	return paths
end

-- Resolve only inside this scene. Exact paths win; shorthand must be unique.
function ScenePaths.Resolve(roots, path)
	local candidates = {}
	for _, root in roots do
		if root.Name == path[1] then table.insert(candidates, root) end
	end
	if #candidates == 0 then
		for _, root in roots do
			for _, child in root:GetDescendants() do
				if child.Name == path[1] then table.insert(candidates, child) end
			end
		end
	end
	for index = 2, #path do
		local nextCandidates = {}
		for _, current in candidates do
			for _, child in current:GetChildren() do
				if child.Name == path[index] then table.insert(nextCandidates, child) end
			end
		end
		candidates = nextCandidates
	end
	if #candidates == 1 then return candidates[1] end
	if #candidates == 0 then return nil, "Missing scene path: " .. table.concat(path, ".") end
	local names = {}
	for _, candidate in candidates do table.insert(names, candidate:GetFullName()) end
	return nil, "Ambiguous scene path: " .. table.concat(path, ".") .. " -> " .. table.concat(names, ", ")
end

return ScenePaths
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="439">
            <Properties>
              <string name="Name">ScreenEffects</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local PropertyTrack = require(script.Parent.ECS.PropertyTrack)
local CubicBezier = require(script.Parent.ECS.CubicBezier)

local ScreenEffects = {}
ScreenEffects.__index = ScreenEffects
local PROPERTY_TYPES = {
	Enabled = "boolean", Saturation = "number", Contrast = "number",
	Brightness = "number", TintColor = "Color3",
}

local function resolveEase(info)
	if type(info) == "table" and (info.Type == "Bezier" or info.Type == "CubicBezier") then
		local ok, curve = pcall(CubicBezier.Create, info.Params)
		if ok then return curve end
		warn("[CutsceneScreen] Invalid Bezier; using Linear: " .. tostring(curve))
		return nil
	end
	local ok, style, direction = pcall(function()
		local params = info.Params or {}
		return Enum.EasingStyle[info.Type or "Linear"],
			Enum.EasingDirection[params.Direction or params.Dir or "In"]
	end)
	if not ok or not style or not direction then
		warn("[CutsceneScreen] Invalid easing; using Linear")
		return nil
	end
	if style == Enum.EasingStyle.Linear then return nil end
	return function(alpha) return TweenService:GetValue(alpha, style, direction) end
end

function ScreenEffects.new(config)
	assert(config.EndFrame > 0 and config.EndFrame < math.huge, "ScreenEffects.EndFrame must be positive and finite")
	assert(not config.FPS or (config.FPS > 0 and config.FPS < math.huge), "ScreenEffects.FPS must be positive and finite")
	local tracks = {}
	-- Validate/copy before creating any instance; exported frozen data stays untouched.
	for property, keys in config.Tracks do
		local expectedType = assert(PROPERTY_TYPES[property], "Unsupported screen property: " .. property)
		tracks[property] = PropertyTrack.Prepare(keys, expectedType, resolveEase)
	end
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "CutsceneColorCorrection"
	effect.Enabled = false
	effect.Saturation = 0
	effect.Contrast = 0
	effect.Brightness = 0
	effect.TintColor = Color3.new(1, 1, 1)
	-- Local, session-owned instance: never overwrite the map's existing effects.
	effect.Parent = Lighting
	return setmetatable({ Effect = effect, Tracks = tracks, EndFrame = config.EndFrame }, ScreenEffects)
end

function ScreenEffects:ApplyFrame(frame, playing)
	if not playing then
		self.Effect.Enabled = false
		return
	end
	frame = math.clamp(frame, 0, self.EndFrame)
	local enabled = true
	for property, track in self.Tracks do
		local value = PropertyTrack.Read(track, frame)
		if value ~= nil then
			if property == "Enabled" then enabled = value else self.Effect[property] = value end
		end
	end
	self.Effect.Enabled = enabled
end

function ScreenEffects:Destroy()
	-- Neutralize before removal so a delayed render cannot show the last dark key.
	self.Effect.Enabled = false
	self.Effect.Brightness = 0
	self.Effect.Contrast = 0
	self.Effect.Saturation = 0
	self.Effect.TintColor = Color3.new(1, 1, 1)
	self.Effect:Destroy()
end

return ScreenEffects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="440">
            <Properties>
              <string name="Name">VFXContext</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ScenePaths = require(script.Parent.ScenePaths)
local VFXContext = {}
VFXContext.__index = VFXContext

function VFXContext.new(state, events)
	local wanted = ScenePaths.Collect(events)
	local targets, unavailable = {}, {}
	local deadline = os.clock() + 20
	local pending = {}
	repeat
		assert(state.Parent, "Cutscene removed during VFX preparation")
		table.clear(pending)
		local manifest = state:FindFirstChild("VFXTargets")
		local references = {}
		for _, reference in if manifest then manifest:GetChildren() else {} do
			local key = reference:GetAttribute("PathKey")
			if key then references[key] = reference end
		end
		for key, path in wanted do
			local reference = references[key]
			local reason = reference and reference:GetAttribute("Unavailable")
			local target = reference and reference.Value
			local descendantCount = reference and reference:GetAttribute("DescendantCount")
			if reason then
				unavailable[key] = reason
			elseif target and target:IsDescendantOf(workspace) and descendantCount
				and #target:GetDescendants() >= descendantCount then
				targets[key] = target
			else
				table.insert(pending, table.concat(path, "."))
			end
		end
		if #pending == 0 then break end
		assert(os.clock() < deadline, "VFX replication timed out: " .. table.concat(pending, ", "))
		RunService.Heartbeat:Wait()
	until false
	for _, reason in unavailable do warn("[CutsceneVFX] " .. reason .. " (disabled for this playback)") end
	local forge = require(ReplicatedStorage.Shared.Modules.Utils.EmitModule)
	forge.init()
	local particles = nil
	for _, event in events do
		if event.AbsoluteEmit then
			local module = ReplicatedStorage:WaitForChild("Part_Icles", 3)
			if module then
				local ok, result = pcall(require, module)
				if ok then particles = result else warn("[CutsceneVFX] " .. tostring(result)) end
			else
				warn("[CutsceneVFX] ReplicatedStorage.Part_Icles is missing; AbsoluteEmit is unavailable")
			end
			break
		end
	end
	return setmetatable({ State = state, Targets = targets, Forge = forge, Particles = particles,
		Handles = {}, Warned = {}, Destroyed = false }, VFXContext)
end

function VFXContext:Run(event)
	if self.Destroyed or not self.State.Parent then return end
	local function emitPaths(paths, callback)
		for _, path in paths or {} do
			if self.Destroyed or not self.State.Parent then return end
			local key = ScenePaths.Key(path)
			local target = self.Targets[key]
			if not target then continue end -- diagnosed during preparation
			if not target:IsDescendantOf(workspace) then
				if not self.Warned[key] then
					self.Warned[key] = true
					warn("[CutsceneVFX] Prepared target was removed: " .. table.concat(path, "."))
				end
				continue
			end
			local ok, result = pcall(callback, target)
			if not ok then
				warn("[CutsceneVFX] " .. table.concat(path, ".") .. ": " .. tostring(result))
			elseif type(result) == "table" and result.Clear and result.Finished then
				if self.Destroyed then result:Clear(); continue end
				self.Handles[result] = true
				result.Finished:finally(function() self.Handles[result] = nil end):catch(function(err)
					warn("[CutsceneVFX] Emit failed: " .. tostring(err))
				end)
			end
		end
	end
	emitPaths(event.Emit, function(target) return self.Forge.emit(target) end)
	if self.Particles and event.AbsoluteEmit then
		local ok, err = pcall(function() self.Particles:Activate() end)
		if not ok then warn("[CutsceneVFX] " .. tostring(err)); return end
		emitPaths(event.AbsoluteEmit, function(target) return self.Particles:AbsoluteEmit(target) end)
	end
end

function VFXContext:Destroy()
	self.Destroyed = true
	-- Snapshot because completion callbacks can remove handles during cancellation.
	local handles = {}
	for handle in self.Handles do table.insert(handles, handle) end
	for _, handle in handles do
		local ok, err = pcall(handle.Clear, handle)
		if not ok then warn("[CutsceneVFX] Cleanup: " .. tostring(err)) end
	end
	table.clear(self.Handles)
	table.clear(self.Targets)
end

return VFXContext
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="441">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="442">
            <Properties>
              <string name="Name">ButtonEffects</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local ButtonEffects = {}

local isPressing = false
local isClicked = false

local DEFAULT_SCALE = 1
local PRESSED_SCALE = 0.88
local TWEEN_INFO = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

type EffectOptions = {
	hoverScale: number?,
	pressScale: number?,
	period: number?,
	damping: number?,
}

function ButtonEffects.ApplyPressEffect(button, pressedScale)
	pressedScale = pressedScale or PRESSED_SCALE

	local scale = button:FindFirstChild("PressScale") or Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Scale = DEFAULT_SCALE
	scale.Parent = button

	local tween

	local function play(targetScale)
		if tween then
			tween:Cancel()
		end

		tween = TweenService:Create(scale, TWEEN_INFO, {
			Scale = targetScale,
		})

		tween:Play()
	end

	local down = button.MouseButton1Down:Connect(function()
		isPressing = true
		play(pressedScale)
	end)

	local up = button.MouseButton1Up:Connect(function()
		isPressing = false
		if not isClicked then
			play(DEFAULT_SCALE)
		end
	end)

	local leave = button.MouseLeave:Connect(function()
		play(DEFAULT_SCALE)
	end)

	local activated = button.MouseButton1Click:Connect(function()
		isClicked = true
		play(pressedScale)

		task.delay(0.05, function()
			isClicked = false
			if not isPressing then
				play(DEFAULT_SCALE)
			end
		end)
	end)

	return function()
		down:Disconnect()
		up:Disconnect()
		leave:Disconnect()
		activated:Disconnect()

		if tween then
			tween:Cancel()
		end

		scale.Scale = DEFAULT_SCALE
	end
end

return ButtonEffects
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="443">
            <Properties>
              <string name="Name">Emote</string>
            </Properties>
            <Item class="ModuleScript" referent="444">
              <Properties>
                <string name="Name">EmoteOverlay</string>
                <string name="Source"><![CDATA[-- Shared modal motion used by lobby and in-game emote wheels.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local spring = Vide.spring
local source = Vide.source
local effect = Vide.effect

export type Props = {
	Name: string,
	IsOpen: () -> boolean,
	OnClose: () -> (),
	Content: GuiObject,
}

return function(props: Props)
	local isMounted = source(false)
	local transition = 0

	effect(function()
		local isOpen = props.IsOpen()
		transition += 1
		local currentTransition = transition

		if isOpen then
			isMounted(true)
		else
			task.delay(0.48, function()
				if transition == currentTransition then
					isMounted(false)
				end
			end)
		end
	end)

	return create("Frame")({
		Name = props.Name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = isMounted,
		ZIndex = 20,

		create("TextButton")({
			Name = "Backdrop",
			Active = props.IsOpen,
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(7, 12, 22),
			BackgroundTransparency = spring(function()
				return if props.IsOpen() then 0.35 else 1
			end, 0.2, 0.9),
			Size = UDim2.fromScale(1, 1),
			Text = "",
			ZIndex = 20,
			Activated = props.OnClose,
		}),

		create("Frame")({
			Name = "Content",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = spring(function()
				return if props.IsOpen() then 0 else -3
			end, 0.35, 0.8),
			Size = spring(function()
				return if props.IsOpen() then UDim2.fromScale(1, 1) else UDim2.fromScale(0, 0)
			end, 0.48, 0.78),
			ZIndex = 30,
			props.Content,
		}),
	})
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="445">
              <Properties>
                <string name="Name">EmoteRadialMenu</string>
                <string name="Source"><![CDATA[-- Shared radial emote menu used in every place.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerCharacter = require(script.Parent.PlayerCharacter)
local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local show = Vide.show
local source = Vide.source
local spring = Vide.spring

export type EmoteData = {
	Id: string?,
	Name: string?,
	EmoteName: string?,
	DisplayName: string?,
	AnimationId: (number | string)?,
	PlaybackSpeed: number?,
}

export type Props = {
	Emote1: () -> EmoteData?,
	Emote2: () -> EmoteData?,
	Emote3: () -> EmoteData?,
	Emote4: () -> EmoteData?,
	UserId: ((() -> number?) | number)?,
	OnSelected: (emoteName: string) -> (),
}

type SlotConfig = {
	Index: number,
	Image: string,
	Shadow: string,
	Position: UDim2,
	AnchorPoint: Vector2,
	HighlightPosition: UDim2,
	ShadowPosition: UDim2,
	NamePosition: UDim2,
	NameSize: UDim2,
	TooltipPosition: UDim2,
}

local SLOT_CONFIGS: { SlotConfig } = {
	{
		Index = 1,
		Image = "rbxassetid://85375303952247",
		Shadow = "rbxassetid://75984171493972",
		Position = UDim2.fromScale(0.2355, 0.248),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(-0.0809784, -0.0563052),
		ShadowPosition = UDim2.fromScale(0.51564, 0.51378),
		NamePosition = UDim2.fromScale(0.302812, 0.740618),
		NameSize = UDim2.fromScale(0.451239, 0.140752),
		TooltipPosition = UDim2.fromScale(0.345753, 0.88137),
	},
	{
		Index = 2,
		Image = "rbxassetid://101263877757551",
		Shadow = "rbxassetid://133628792436402",
		Position = UDim2.fromScale(0.7585, 0.248),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(-0.284901, -0.0616716),
		ShadowPosition = UDim2.fromScale(0.494174, 0.508413),
		NamePosition = UDim2.fromScale(0.0827899, 0.729886),
		NameSize = UDim2.fromScale(0.813235, 0.140752),
		TooltipPosition = UDim2.fromScale(0.281357, 0.876003),
	},
	{
		Index = 3,
		Image = "rbxassetid://93847193101743",
		Shadow = "rbxassetid://101043806354019",
		Position = UDim2.fromScale(0.2355, 0.77),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(-0.113177, -0.329991),
		ShadowPosition = UDim2.fromScale(0.510274, 0.486948),
		NamePosition = UDim2.fromScale(0.14182, 0.0537204),
		NameSize = UDim2.fromScale(0.813235, 0.140752),
		TooltipPosition = UDim2.fromScale(0.340387, 0.199838),
	},
	{
		Index = 4,
		Image = "rbxassetid://119095003806239",
		Shadow = "rbxassetid://96998108143818",
		Position = UDim2.fromScale(0.7575, 0.77),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(-0.263436, -0.372922),
		ShadowPosition = UDim2.fromScale(0.510274, 0.486948),
		NamePosition = UDim2.fromScale(0.14182, 0.0537204),
		NameSize = UDim2.fromScale(0.813235, 0.140752),
		TooltipPosition = UDim2.fromScale(0.340387, 0.199838),
	},
}

local function createCamera(): Camera
	return create("Camera")({
		FieldOfView = 50,
		CFrame = CFrame.lookAt(Vector3.new(0, 0, -5.5), Vector3.new(0, -0.3, 0)),
	})
end

local function createGradient(color: Color3)
	return create("UIGradient")({
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, color),
			ColorSequenceKeypoint.new(1, color),
		}),
	})
end

return function(props: Props)
	local emoteGetters = { props.Emote1, props.Emote2, props.Emote3, props.Emote4 }
	local hoveredSlot = source(nil :: number?)
	local pressedSlot = source(nil :: number?)

	local slots = table.create(#SLOT_CONFIGS)

	for _, config in SLOT_CONFIGS do
		local emoteGetter = emoteGetters[config.Index]
		local camera = createCamera()
		local direction = Vector2.new(
			if config.Index % 2 == 1 then -1 else 1,
			if config.Index <= 2 then -1 else 1
		)
		local offset = spring(function()
			if hoveredSlot() == config.Index then
				return 0.03
			elseif hoveredSlot() ~= nil then
				return 0.012
			end
			return 0
		end, 0.18, 0.78)

		table.insert(slots, create("ImageButton")({
			Name = `Emote{config.Index}`,
			Active = true,
			AnchorPoint = config.AnchorPoint,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			ClipsDescendants = false,
			Image = config.Image,
			ImageTransparency = spring(function()
				return if hoveredSlot() == config.Index then 0 else 0.08
			end, 0.16, 0.82),
			Position = function()
				local amount = offset()
				return UDim2.fromScale(
					config.Position.X.Scale + direction.X * amount,
					config.Position.Y.Scale + direction.Y * amount
				)
			end,
			Rotation = spring(function()
				return if hoveredSlot() == config.Index then direction.X * 1.5 else 0
			end, 0.18, 0.78),
			Size = UDim2.fromScale(0.505, 0.522),
			ZIndex = 31,

			MouseEnter = function()
				hoveredSlot(config.Index)
			end,
			MouseLeave = function()
				if hoveredSlot() == config.Index then
					hoveredSlot(nil)
				end
				if pressedSlot() == config.Index then
					pressedSlot(nil)
				end
			end,
			MouseButton1Down = function()
				pressedSlot(config.Index)
			end,
			MouseButton1Up = function()
				if pressedSlot() == config.Index then
					pressedSlot(nil)
				end
			end,
			Activated = function()
				local emote = emoteGetter and emoteGetter()
				local emoteName = emote and (emote.EmoteName or emote.Name)
				if emoteName then
					props.OnSelected(emoteName)
				end
			end,

			create("UIAspectRatioConstraint")({}),
			create("UIScale")({
				Scale = spring(function()
					if pressedSlot() == config.Index then
						return 0.9
					elseif hoveredSlot() == config.Index then
						return 1.14
					end
					return 1
				end, 0.12, 0.72),
			}),

			create("UIGradient")({
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(86, 86, 86)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(86, 86, 86)),
				}),
			}),

			create("ViewportFrame")({
				BackgroundTransparency = 1,
				Position = UDim2.fromScale(0.0687055, 0.0416977),
				Size = UDim2.fromScale(0.886604, 0.916977),
				CurrentCamera = camera,
				ZIndex = 31,
				camera,

				show(emoteGetter, function()
					return PlayerCharacter({
						UseWorldModel = true,
						Origin = CFrame.new(0, -0.25, 1.5),
						AnimationId = function()
							local emote = emoteGetter()
							return if emote then emote.AnimationId else nil
						end,
						PlaybackSpeed = (emoteGetter() and emoteGetter().PlaybackSpeed) or 1,
					})
				end),
			}),

			create("ImageLabel")({
				Name = "HighLight",
				BackgroundTransparency = 1,
				Image = "rbxassetid://84600302742722",
				ImageTransparency = spring(function()
					return if hoveredSlot() == config.Index then 0 else 1
				end, 0.16, 0.82),
				Position = config.HighlightPosition,
				Size = UDim2.fromScale(1.37311, 1.32613),
				ZIndex = 1,
				create("UIAspectRatioConstraint")({}),
				createGradient(Color3.fromRGB(86, 86, 86)),
			}),

			create("ImageLabel")({
				Name = "Shadow",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = config.Shadow,
				Position = config.ShadowPosition,
				Size = UDim2.fromScale(0.96872, 0.941882),
				ZIndex = 33,
				create("UIAspectRatioConstraint")({}),
				createGradient(Color3.fromRGB(86, 86, 86)),
			}),

			create("TextLabel")({
				Name = "EmoteName",
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = config.NamePosition,
				Size = config.NameSize,
				Text = function()
					local emote = emoteGetter()
					return if emote then (emote.DisplayName or emote.EmoteName or "") else ""
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				ZIndex = 35,
				createGradient(Color3.fromRGB(135, 245, 255)),
				create("UIStroke")({ Thickness = 3 }),
			}),

			create("TextLabel")({
				Name = "ToolTip",
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = config.TooltipPosition,
				Size = UDim2.fromScale(0.333149, 0.085883),
				Text = "Tap to play",
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				ZIndex = 35,
				create("UIStroke")({ Thickness = 3 }),
				createGradient(Color3.fromRGB(193, 193, 193)),
			}),
		}))
	end

	return create("Frame")({
		Name = "Container",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 30,

		create("UIAspectRatioConstraint")({
			AspectRatio = 1.547,
			AspectType = Enum.AspectType.ScaleWithParentSize,
		}),

		create("Frame")({
			Name = "Main",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.423847, 0.640625),
			ZIndex = 30,

			create("UIAspectRatioConstraint")({}),
			unpack(slots),
		}),
	})
end
]]></string>
