		error("Server encountered an error.")
	end
	local Value = {} :: any
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 1)
	Value.Difficulty = buffer.readstring(RecieveBuffer, Read(Length), Length)
	Value.StartPlayerCount = buffer.readu8(RecieveBuffer, BLOCK_START + 3)
	return Value
end

function SerdesFunctions.GameEvent_ReadEVENT_GameInfoSynced(): ({ Difficulty: string, StartPlayerCount: number })
