}</string>
                  </Properties>
                </Item>
                <Item class="ModuleScript" referent="184">
                  <Properties>
                    <string name="Name">len</string>
                    <string name="Source">return {
	Name = "len";
	Aliases = {};
	Description = "Returns the length of a comma-separated list";
	Group = "DefaultUtil";
	Args = {
		{
			Type = "string";
			Name = "CSV";
