function SerdesFunctions.SettingsService_ReadFUNCTION_DATA_GetSettings(): (string?)
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	local Value
	if buffer.readu8(RecieveBuffer, BLOCK_START + 0) == 1 then
		-- Read BLOCK: 2 bytes
		local BLOCK_START = Read(2)
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
		Value = buffer.readstring(RecieveBuffer, Read(Length), Length)
	end
	return Value
end

function SerdesFunctions.SettingsService_WriteFUNCTION_RETURN_GetSettings(Value: any, InvocationIdentifier: number): ()
