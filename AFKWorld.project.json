{
  "name": "AFKWorld",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/AFKWorld/ReplicatedStorage",
      "Shared": {
        "$path": "src/lobby/shared",
        "Modules": {
          "$path": "src/Modules"
        }
      },
      "Settings": {
        "$path": "src/Settings"
      }
    },

    "ServerScriptService": {
      "$path": "src/AFKWorld/ServerScriptService",
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/AFKWorld/StarterPlayer/StarterPlayerScripts"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
