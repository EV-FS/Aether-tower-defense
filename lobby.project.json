{
  "name": "TowerDefense",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/lobby/shared",
        "Modules": {
          "$path": "src/Modules"
        }
      },
      "Settings": {
        "$path": "src/Settings"
      },
      "UI": {
        "$path": "src/lobby/UI"
      }
    },

    "ServerScriptService": {
      "ServerPackages": {
        "$path": "ServerPackages"
      },
      "Server": {
        "$path": "src/lobby/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/lobby/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}