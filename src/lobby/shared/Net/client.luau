			buffer.writestring(SendBuffer, SendOffset, Item_2, Length)
		end
		-- END ARRAY
	end
	buffer.writeu16(SendBuffer, BLOCK_START + 4, Elements_1)
end

function SerdesFunctions.CraftService_ReadFUNCTION_RETURN_Craft(): (boolean)
	-- Read BLOCK: 2 bytes
	local BLOCK_START = Read(2)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	local Value = (buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1)
	return Value
end

function SerdesFunctions.GlobalExistService_WriteFUNCTION_DATA_GetCount(Value: { category: string, itemName: string }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 6 bytes
	local BLOCK_START = Allocate(6)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 28)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	local Length = #Value.category
	buffer.writeu16(SendBuffer, BLOCK_START + 2, Length)
	Allocate(Length)
	buffer.writestring(SendBuffer, SendOffset, Value.category, Length)
	local Length = #Value.itemName
	buffer.writeu16(SendBuffer, BLOCK_START + 4, Length)
	Allocate(Length)
	buffer.writestring(SendBuffer, SendOffset, Value.itemName, Length)
end

function SerdesFunctions.GlobalExistService_ReadFUNCTION_RETURN_GetCount(): (number)
	-- Read BLOCK: 5 bytes
	local BLOCK_START = Read(5)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	local Value = buffer.readu32(RecieveBuffer, BLOCK_START + 1)
	return Value
end

function SerdesFunctions.GlobalExistService_ReadEVENT_CountUpdated(): ({ category: string, itemName: string, newCount: number })
	-- Read BLOCK: 8 bytes
	local BLOCK_START = Read(8)
	local Value = {} :: any
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
	Value.category = buffer.readstring(RecieveBuffer, Read(Length), Length)
	Length = buffer.readu16(RecieveBuffer, BLOCK_START + 2)
	Value.itemName = buffer.readstring(RecieveBuffer, Read(Length), Length)
	Value.newCount = buffer.readu32(RecieveBuffer, BLOCK_START + 4)
	return Value
end

