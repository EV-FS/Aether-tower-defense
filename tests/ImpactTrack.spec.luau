-- Run from the repository root: luau tests/ImpactTrack.spec.luau
local ImpactTrack = require("../src/Modules/Cutscene/ECS/ImpactTrack")
local events = require("../src/Settings/Data/CutsceneTracks/RaidIntroImpact")
local keys = ImpactTrack.Keys(events)

local function expect(frame, expected)
	assert(ImpactTrack.Read(events, keys, frame) == expected, "Unexpected impact image at frame " .. frame)
end

expect(-1, false)
expect(0, false)
expect(219.999, false)
expect(220, 119558621791086)
expect(222.999, 119558621791086)
expect(223, 90994462921654)
expect(224.999, 90994462921654)
expect(225, false)
expect(381.999, false)
expect(382, 125479400179904)
expect(382.999, 125479400179904)
expect(383, 98806036043147)
expect(386, 133611396797216)
expect(387.999, 133611396797216)
expect(388, false)
expect(393.999, false)
expect(394, false)
expect(840, false)

-- Seeking backwards and jumping across entire flashes do not queue old images.
expect(220, 119558621791086)
expect(390, false)
expect(0, false)
assert(ImpactTrack.Read({}, {}, 100) == false)
local zero = { [0] = 123, [1] = false }
assert(ImpactTrack.Read(zero, ImpactTrack.Keys(zero), 0) == 123)
assert(ImpactTrack.Read(zero, ImpactTrack.Keys(zero), 1) == false)
assert(not pcall(ImpactTrack.Keys, { [1.5] = 123 }))
assert(not pcall(ImpactTrack.Keys, { [-1] = 123 }))
assert(not pcall(ImpactTrack.Keys, { [1] = true }))
assert(not pcall(ImpactTrack.Keys, { [1] = 0 }))
print("ImpactTrack tests passed")
