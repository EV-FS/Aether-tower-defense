        <Item class="ModuleScript" referent="676">
          <Properties>
            <string name="Name">DialogueService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local NpcDialogueData = require(ReplicatedStorage:WaitForChild("Settings"):WaitForChild("Data"):WaitForChild("NpcDialogueData"))
local QuestData = require(ReplicatedStorage.Settings.Data.QuestData)
local DialogueService = {}
local QuestService
local DataService

local playerDialogueStates = {}

function DialogueService.Init(services)
	QuestService = services:GetService("QuestService")
	DataService = services:GetService("DataService")
end

function DialogueService.Start()
	-- ServiceRegistry compatibility
end

function DialogueService.StartDialogue(player, npcId)
	playerDialogueStates[player.UserId] = {
		NpcId = npcId,
		CurrentDialogueId = "Start",
	}
	Net.DialogueService.StartDialogue.Fire(player, npcId)
end

function DialogueService.HandleChoice(player, data)
	local state = playerDialogueStates[player.UserId]
	if not state or state.NpcId ~= data.NpcId then
		return
	end

	local npcData = NpcDialogueData[data.NpcId]
	if not npcData then
		return
	end

	local currentDialogue = npcData.DialogueTree[state.CurrentDialogueId]
	if not currentDialogue or not currentDialogue.Choices then
		return
	end

	local choice = currentDialogue.Choices[data.ChoiceIndex]
	if not choice then
		return
	end

	if choice.Next == "End" then
		playerDialogueStates[player.UserId] = nil
		Net.DialogueService.CloseDialogue.Fire(player)
		return
	end

	local nextId = choice.Next

	-- WanderingMerchant 퀘스트 분기 동적 처리
	if data.NpcId == "WanderingMerchant" then
		local npcQuests = QuestData.QueryNpc(data.NpcId)
		local questConfig = npcQuests[1]
		local questId = questConfig and questConfig.Id
		if not questId then
			return
		end
		if nextId == "Quest_Check" and QuestService and DataService then
			local playerData = DataService:GetData(player)
			local quests = playerData and playerData.Quests or {}
			local quest = quests[questId]

			if not quest or (not quest.Active and not quest.Claimed) then
				nextId = "Quest_Check"
			elseif quest.Active and not quest.Completed then
				nextId = "Quest_Progress"
			elseif quest.Active and quest.Completed and not quest.Claimed then
				nextId = "Quest_Ready"
			elseif quest.Claimed then
				nextId = "Quest_AlreadyDone"
			end
		elseif nextId == "Quest_Accepted" and QuestService then
			QuestService.AcceptQuest(player, questId)
		elseif nextId == "Quest_Completed" and QuestService then
			QuestService.ClaimQuest(player, questId)
		end
	end

	state.CurrentDialogueId = nextId
	Net.DialogueService.UpdateDialogueUI.Fire(player, {
		NpcId = data.NpcId,
		DialogueId = state.CurrentDialogueId,
	})
end

Net.DialogueService.ChooseDialogue.On(function(player, data)
	DialogueService.HandleChoice(player, data)
end)

return DialogueService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="677">
          <Properties>
            <string name="Name">EmojiService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EmojiData = require(ReplicatedStorage.Settings.Data.EmojiData)
local Net = require(ReplicatedStorage.Shared.Net.server)

local EMOJI_COOLDOWN = 0.5
local LOADOUT_COOLDOWN = 0.15
local MAX_SLOTS = 4
local LOADOUT_REMOTE_NAME = "EmojiLoadoutAction"

local lastEmojiTime: { [Player]: number } = {}
local lastLoadoutTime: { [Player]: number } = {}
local DataService

local EmojiService = {}

function EmojiService.ShowEmoji(player: Player, emojiId: string): boolean
	local emojiConfig = EmojiData.ByName[emojiId]
	if not emojiConfig then
		return false
	end
	local playerData = DataService:GetData(player)
	if not playerData or not playerData.Inventory or not playerData.Inventory.Emojis
		or (tonumber(playerData.Inventory.Emojis[emojiId]) or 0) <= 0 then
		return false
	end
	local equipped = false
	for _, equippedId in playerData.EmojiLoadout or {} do
		if equippedId == emojiId then equipped = true; break end
	end
	if not equipped then return false end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local now = os.clock()
	local lastUsed = lastEmojiTime[player] or -math.huge
	if now - lastUsed < EMOJI_COOLDOWN then
		return false
	end
	lastEmojiTime[player] = now

	Net.EmojiService.EmojiShown.FireAll({
		Player = player,
		EmojiId = emojiId,
	})
	return true
end

function EmojiService.UpdateLoadout(player: Player, request: any)
	if type(request) ~= "table" then return { Success = false, Message = "Invalid emoji request." } end
	local slot = request.Slot
	if type(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > MAX_SLOTS then
		return { Success = false, Message = "Invalid emoji slot." }
	end
	local now = os.clock()
	if now - (lastLoadoutTime[player] or -math.huge) < LOADOUT_COOLDOWN then
		return { Success = false, Message = "Please wait before changing another slot." }
	end
	lastLoadoutTime[player] = now
	local data = DataService:GetData(player)
	if not data then return { Success = false, Message = "Your data is still loading." } end
	local loadout = table.clone(data.EmojiLoadout or {})
	if request.Action == "Unequip" then
		loadout[tostring(slot)] = nil
		loadout[slot] = nil
	elseif request.Action == "Equip" then
		local emojiId = request.EmojiId
		if type(emojiId) ~= "string" or not EmojiData.ByName[emojiId]
			or not data.Inventory or not data.Inventory.Emojis
			or (tonumber(data.Inventory.Emojis[emojiId]) or 0) <= 0 then
			return { Success = false, Message = "You do not own this emoji." }
		end
		for existingSlot, equippedId in loadout do
			if equippedId == emojiId then loadout[existingSlot] = nil end
		end
		loadout[tostring(slot)] = emojiId
		loadout[slot] = nil
	else
		return { Success = false, Message = "Invalid emoji action." }
	end
	local saved = DataService:UpdateData(player, "EmojiLoadout", loadout)
	if type(saved) ~= "table" then
		return { Success = false, Message = "Your emoji slots could not be saved." }
	end
	return { Success = true, Message = if request.Action == "Equip" then `Equipped to slot {slot}.` else `Slot {slot} cleared.`, Loadout = saved }
end

function EmojiService.Init(services)
	DataService = services:GetService("DataService")
end

EmojiService.Dependencies = { "DataService" }

function EmojiService.Start()
	local folder = ReplicatedStorage:FindFirstChild("RuntimeRemotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "RuntimeRemotes"
		folder.Parent = ReplicatedStorage
	end
	local remote = folder:FindFirstChild(LOADOUT_REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteFunction")
		remote.Name = LOADOUT_REMOTE_NAME
		remote.Parent = folder
	end
	assert(remote:IsA("RemoteFunction"), "Emoji loadout remote must be a RemoteFunction")
	remote.OnServerInvoke = function(player: Player, request: any)
		return EmojiService.UpdateLoadout(player, request)
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		lastEmojiTime[player] = nil
		lastLoadoutTime[player] = nil
	end)

	Net.EmojiService.RequestShowEmoji.On(function(player: Player, data: any): boolean
		if type(data) ~= "table" or type(data.EmojiId) ~= "string" then return false end
		return EmojiService.ShowEmoji(player, data.EmojiId)
	end)
end

return EmojiService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="678">
          <Properties>
            <string name="Name">EmoteService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local EmotePropUtils = require(ReplicatedStorage.Shared.Modules.Utils.EmotePropUtils)
local Net = require(ReplicatedStorage.Shared.Net.server)
local DataService

local EMOTE_COOLDOWN = 0.2
local MAX_EMOTE_SLOTS = 4
local LOADOUT_REMOTE_NAME = "EmoteLoadoutAction"
local LOADOUT_REQUEST_COOLDOWN = 0.15

-------------------------------------------------
--// PlayerEmoteState Class
-------------------------------------------------
type EmoteConfig = EmoteData.EmoteConfig

local PlayerEmoteState = {}
PlayerEmoteState.__index = PlayerEmoteState

function PlayerEmoteState.new(player: Player)
	local self = setmetatable({
		Player = player,
		CurrentEmote = nil :: string?,
		SavedWalkSpeed = nil :: number?,
		Connections = {} :: { RBXScriptConnection },
		LastEmoteTime = 0 :: number,
	}, PlayerEmoteState)
	return self
end

function PlayerEmoteState:Play(emoteName: string, emoteConfig: EmoteConfig): boolean
	local now = os.clock()
	if now - self.LastEmoteTime < EMOTE_COOLDOWN then
		return false
	end
	self.LastEmoteTime = now

	local character = self.Player.Character
	if not character then
		return false
	end

	self:Stop(true)

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		self.SavedWalkSpeed = humanoid.WalkSpeed
	end

	self.CurrentEmote = emoteName
	character:SetAttribute("CurrentEmote", emoteName)

	if emoteConfig.Props then
		EmotePropUtils.AttachProps(character, emoteConfig.Props)
	end

	if humanoid then
		if emoteConfig.WalkSpeed then
			humanoid.WalkSpeed = emoteConfig.WalkSpeed
		end

		local conns: { RBXScriptConnection } = {}

		local jumpConn = humanoid.Jumping:Connect(function(isJump: boolean)
			if isJump then
				self:Stop()
			end
		end)
		table.insert(conns, jumpConn)

		local stateConn = humanoid.StateChanged:Connect(function(_, newState: Enum.HumanoidStateType)
			if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
				self:Stop()
			end
		end)
		table.insert(conns, stateConn)

		self.Connections = conns
	end

	Net.EmoteService.EmoteStarted.FireAll({ Player = self.Player, EmoteId = emoteName })
	return true
end

function PlayerEmoteState:Stop(suppressNotify: boolean?): boolean
	local hadEmote = self.CurrentEmote ~= nil

	for _, conn in ipairs(self.Connections) do
		conn:Disconnect()
	end
	table.clear(self.Connections)

	local character = self.Player.Character
	if character then
		character:SetAttribute("CurrentEmote", nil)
		EmotePropUtils.ClearProps(character)

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and self.SavedWalkSpeed ~= nil then
			humanoid.WalkSpeed = self.SavedWalkSpeed
		end
	end
	self.SavedWalkSpeed = nil
	self.CurrentEmote = nil

	if hadEmote and not suppressNotify then
		Net.EmoteService.EmoteStopped.FireAll({ Player = self.Player })
	end

	return true
end

function PlayerEmoteState:Destroy()
	self:Stop()
end

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function resolveEmoteName(targetEmote: number | string): string?
	if typeof(targetEmote) == "number" then
		local config = EmoteData.ByIndex[targetEmote]
		return if config then config.Name else nil
	end
	return targetEmote :: string
end

-------------------------------------------------
--// EmoteService
-------------------------------------------------
local EmoteService = {}
local playerStates: { [Player]: any } = {}
local lastLoadoutRequestAt: { [Player]: number } = {}

function EmoteService.AddEmote(player: Player, targetEmote: number | string)
	local emoteName = resolveEmoteName(targetEmote)
	if not emoteName or not EmoteData.ByName[emoteName] then
		warn(`존재하지 않는 이모트 {targetEmote}를 추가하려 시도함.`)
		return
	end

	DataService:AddData(player, "Inventory", 1, "Emotes", emoteName)
end

function EmoteService.RemoveEmote(player: Player, targetEmote: number | string)
	local emoteName = resolveEmoteName(targetEmote)
	if not emoteName or not EmoteData.ByName[emoteName] then
		warn(`존재하지 않는 이모트 {targetEmote}를 제거하려 시도함.`)
		return
	end

	local playerData = DataService:GetData(player)
	local playerEmote = playerData and playerData.Inventory and playerData.Inventory.Emotes[emoteName]
	if not playerEmote or playerEmote <= 0 then
		warn(`보유하지 않은 이모트 {emoteName}를 제거하려 시도함.`)
		return
	end

	DataService:AddData(player, "Inventory", -1, "Emotes", emoteName)

	if playerEmote <= 1 then
		local loadout = table.clone(playerData.EmoteLoadout or {})
		local changed = false
		for slot, equippedName in loadout do
			if equippedName == emoteName then
				loadout[slot] = nil
				changed = true
			end
		end
		if changed then
			DataService:UpdateData(player, "EmoteLoadout", loadout)
		end
	end
end

function EmoteService.PlayEmote(player: Player, targetEmote: number | string): boolean
	local emoteName = resolveEmoteName(targetEmote)
	local emoteConfig = emoteName and EmoteData.ByName[emoteName]
	if not emoteConfig or not emoteName then
		warn(`존재하지 않는 이모트 {targetEmote}를 재생하려 시도함.`)
		return false
	end

	local playerData = DataService:GetData(player)
	local isStudio = RunService:IsStudio()
	if not isStudio then
		local playerEmote = playerData and playerData.Inventory and playerData.Inventory.Emotes[emoteName]
		if not playerEmote or playerEmote <= 0 then
			warn(`보유하지 않은 이모트 {emoteName}를 재생하려 시도함.`)
			return false
		end
	end

	local isEquipped = false
	for _, equippedName in (playerData and playerData.EmoteLoadout) or {} do
		if equippedName == emoteName then
			isEquipped = true
			break
		end
	end
	if not isEquipped then
		return false
	end

	local state = playerStates[player]
	if not state then
		state = PlayerEmoteState.new(player)
		playerStates[player] = state
	end

	return state:Play(emoteName, emoteConfig)
end

function EmoteService.UpdateLoadout(player: Player, request: any)
	local now = os.clock()
	local previousRequest = lastLoadoutRequestAt[player]
	if previousRequest and now - previousRequest < LOADOUT_REQUEST_COOLDOWN then
		return { Success = false, Message = "Please wait a moment before changing another slot." }
	end
	lastLoadoutRequestAt[player] = now

	if type(request) ~= "table" then
		return { Success = false, Message = "Invalid emote request." }
	end

	local slot = tonumber(request.Slot)
	if not slot or slot % 1 ~= 0 or slot < 1 or slot > MAX_EMOTE_SLOTS then
		return { Success = false, Message = "Invalid emote slot." }
	end

	local playerData = DataService:GetData(player)
	if not playerData then
		return { Success = false, Message = "Your data is still loading." }
	end

	local loadout = table.clone(playerData.EmoteLoadout or {})
	if request.Action == "Unequip" then
		loadout[tostring(slot)] = nil
		loadout[slot] = nil
	elseif request.Action == "Equip" then
		local emoteName = request.EmoteName
		local ownedCount = type(emoteName) == "string"
			and playerData.Inventory
			and playerData.Inventory.Emotes
			and tonumber(playerData.Inventory.Emotes[emoteName])
		if not ownedCount or ownedCount <= 0 or not EmoteData.ByName[emoteName] then
			return { Success = false, Message = "You do not own this emote." }
		end

		for existingSlot, equippedName in loadout do
			if equippedName == emoteName then
				loadout[existingSlot] = nil
			end
		end
		loadout[tostring(slot)] = emoteName
		loadout[slot] = nil
	else
		return { Success = false, Message = "Invalid emote action." }
	end

	local savedLoadout = DataService:UpdateData(player, "EmoteLoadout", loadout)
	if type(savedLoadout) ~= "table" then
		return { Success = false, Message = "Your emote slots could not be saved." }
	end
	return {
		Success = true,
		Message = if request.Action == "Equip" then `Equipped to slot {slot}.` else `Slot {slot} cleared.`,
		Loadout = savedLoadout,
	}
end

function EmoteService.StopEmote(player: Player): boolean
	local state = playerStates[player]
	if state then
		return state:Stop()
	end
	return false
end

function EmoteService.Init(services)
	DataService = services:GetService("DataService")
end

EmoteService.Dependencies = { "DataService" }

function EmoteService.Start()
	local runtimeRemotes = ReplicatedStorage:FindFirstChild("RuntimeRemotes")
	if not runtimeRemotes then
		runtimeRemotes = Instance.new("Folder")
		runtimeRemotes.Name = "RuntimeRemotes"
		runtimeRemotes.Parent = ReplicatedStorage
	end
	local loadoutRemote = runtimeRemotes:FindFirstChild(LOADOUT_REMOTE_NAME)
	if not loadoutRemote then
		loadoutRemote = Instance.new("RemoteFunction")
		loadoutRemote.Name = LOADOUT_REMOTE_NAME
		loadoutRemote.Parent = runtimeRemotes
	end
	assert(loadoutRemote:IsA("RemoteFunction"), "Emote loadout remote must be a RemoteFunction")
	loadoutRemote.OnServerInvoke = function(player: Player, request: any)
		return EmoteService.UpdateLoadout(player, request)
	end

	local function onPlayerAdded(player: Player)
		playerStates[player] = PlayerEmoteState.new(player)

		player.CharacterRemoving:Connect(function()
			local state = playerStates[player]
			if state then
				state:Stop()
			end
		end)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)

	Players.PlayerRemoving:Connect(function(player: Player)
		lastLoadoutRequestAt[player] = nil
		local state = playerStates[player]
		if state then
			state:Destroy()
			playerStates[player] = nil
		end
	end)

	Net.EmoteService.RequestPlayEmote.On(function(player: Player, data: { EmoteId: string }): boolean
		return EmoteService.PlayEmote(player, data.EmoteId)
	end)

	Net.EmoteService.RequestStopEmote.On(function(player: Player): boolean
		return EmoteService.StopEmote(player)
	end)
end

return EmoteService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="679">
          <Properties>
            <string name="Name">EventShopService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EventShopData = require(ReplicatedStorage.Settings.Data.EventShopData)

local DataService

local REMOTES_FOLDER_NAME = "RuntimeRemotes"
local REMOTE_NAME = "EventShopPurchase"
local REQUEST_COOLDOWN = 0.25
local lastRequestAt: { [Player]: number } = {}

local EventShopService = {}

local function response(success: boolean, message: string, extra: { [string]: any }?)
	local result = extra or {}
	result.Success = success
	result.Message = message
	return result
end

function EventShopService:Purchase(player: Player, productId: any)
	local now = os.clock()
	local previous = lastRequestAt[player]
	if previous and now - previous < REQUEST_COOLDOWN then
		return response(false, "Please wait a moment.")
	end
	lastRequestAt[player] = now

	if typeof(productId) ~= "string" or #productId > 64 then
		return response(false, "Invalid event shop product.")
	end

	local product = EventShopData.ById[productId]
	if not product then
		return response(false, "This product is unavailable.")
	end

	local playerData = DataService:GetData(player)
	if not playerData then
		return response(false, "Your data is still loading.")
	end

	local inventory = playerData.Inventory or {}
	local category = inventory[product.RewardCategory] or {}
	if product.Unique and (category[product.RewardName] or 0) > 0 then
		return response(false, "You already own this reward.", { AlreadyOwned = true })
	end

	local balance = playerData.Blossom or 0
	if balance < product.Price then
		return response(false, `Collect {product.Price - balance} more Blossoms.`, {
			Balance = balance,
			Required = product.Price,
		})
	end

	local newBalance = DataService:AddData(player, "Blossom", -product.Price)
	if newBalance == nil then
		return response(false, "The purchase could not be completed.")
	end

	DataService:AddData(
		player,
		"Inventory",
		product.RewardAmount,
		product.RewardCategory,
		product.RewardName
	)

	return response(true, `Purchased {product.Title}!`, {
		Balance = newBalance,
		ProductId = product.Id,
		RewardName = product.RewardName,
		RewardAmount = product.RewardAmount,
	})
end

function EventShopService.Init(services)
	DataService = services:GetService("DataService")
end

EventShopService.Dependencies = { "DataService" }

function EventShopService.Start()
	local remotesFolder = ReplicatedStorage:FindFirstChild(REMOTES_FOLDER_NAME)
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = REMOTES_FOLDER_NAME
		remotesFolder.Parent = ReplicatedStorage
	end

	local remote = remotesFolder:FindFirstChild(REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteFunction")
		remote.Name = REMOTE_NAME
		remote.Parent = remotesFolder
	end
	assert(remote:IsA("RemoteFunction"), "EventShopPurchase runtime remote must be a RemoteFunction")

	remote.OnServerInvoke = function(player: Player, productId: any)
		return EventShopService:Purchase(player, productId)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastRequestAt[player] = nil
	end)
end

return EventShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="680">
          <Properties>
            <string name="Name">GiftService</string>
            <string name="Source"><![CDATA[--/Services
local MarketplaceService = game:GetService("MarketplaceService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local HttpService = game:GetService("HttpService")
local UserService = game:GetService("UserService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Net = require(ReplicatedStorage.Shared.Net)
local PurchaseData = require(ReplicatedStorage.Settings.Data.PurchaseData)
local DataService

--/Constants
local INTENT_TTL = 7200
local CANCEL_WINDOW = 30
local ALLOW_SELF_GIFT = true
local VERIFY_RECIPIENT = true
local VERIFY_FAIL_OPEN = false
local RATE_WINDOW = 10
local RATE_MAX = 3
local INVALID_CACHE_TTL = 60
local INVALID_CACHE_MAX = 500

local STORE_TTL = INTENT_TTL + 60
local RECEIPT_TTL = 30 * 24 * 3600

--/Variables
local IntentMap = MemoryStoreService:GetHashMap("GiftIntent_v1")
local ReceiptMap = MemoryStoreService:GetHashMap("GiftReceipt_v1")

local rateLimits: { [number]: { count: number, reset: number } } = {}
local invalidUserCache: { [number]: number } = {}
local invalidCacheCount = 0

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function isValidId(n: any): boolean
	return type(n) == "number" and n % 1 == 0 and n > 0
end

local function isGiftable(productId: number): boolean
	local product = PurchaseData.ById[productId]
	return product ~= nil and product.Category == "DevProducts" and product.Giftable ~= false
end

local function checkRate(userId: number): boolean
	local now = os.clock()
	local userRate = rateLimits[userId]

	if not userRate or now > userRate.reset then
		rateLimits[userId] = { count = 1, reset = now + RATE_WINDOW }
		return true
	end

	if userRate.count >= RATE_MAX then
		return false
	end

	userRate.count += 1
	return true
end

local function isCachedInvalid(id: number): boolean
	local ts = invalidUserCache[id]
	return ts ~= nil and (os.time() - ts) < INVALID_CACHE_TTL
end

local function markInvalid(id: number)
	if not invalidUserCache[id] then
		invalidCacheCount += 1
	end
	invalidUserCache[id] = os.time()

	if invalidCacheCount > INVALID_CACHE_MAX then
		table.clear(invalidUserCache)
		invalidCacheCount = 0
	end
end

local function intentIsLive(existing: any): boolean
	return type(existing) == "table"
		and existing.consumed ~= true
		and type(existing.expiresAt) == "number"
		and os.time() <= existing.expiresAt
end

local function acquireIntent(buyerId: number, intent: any): (boolean, string?)
	local ok, result = pcall(function()
		return IntentMap:UpdateAsync(tostring(buyerId), function(existing)
			if intentIsLive(existing) then
				return existing
			end
			return intent
		end, STORE_TTL)
	end)

	if not ok then
		return false, "memorystore_error"
	end

	if result and result.nonce == intent.nonce then
		return true
	end

	return false, "already_pending"
end

local function readIntent(buyerId: number): (boolean, any)
	local ok, intent = pcall(function()
		return IntentMap:GetAsync(tostring(buyerId))
	end)

	if not ok or not intentIsLive(intent) then
		return ok, nil
	end

	return true, intent
end

local function consumeIntent(buyerId: number, nonce: string)
	pcall(function()
		IntentMap:UpdateAsync(tostring(buyerId), function(existing)
			if existing and existing.nonce == nonce then
				existing.consumed = true
			end
			return existing
		end, STORE_TTL)
	end)
end

local function readReceipt(purchaseId: string): (boolean, any)
	local ok, rec = pcall(function()
		return ReceiptMap:GetAsync(purchaseId)
	end)

	if not ok then
		return false, nil
	end

	return true, rec
end

local function markReceipt(purchaseId: string, recipientId: number, nonce: string): boolean
	local ok = pcall(function()
		ReceiptMap:UpdateAsync(purchaseId, function(existing)
			if existing then
				return existing
			end
			return {
				recipientId = recipientId,
				nonce = nonce,
				ts = os.time(),
			}
		end, RECEIPT_TTL)
	end)
	return ok
end

local function notify(player: Player?, event: string, payload: any)
	if not player or not player.Parent then
		return
	end
	pcall(function()
		Net.GiftService[event]:Fire(player, payload)
	end)
end

-------------------------------------------------
--// GiftService
-------------------------------------------------
local GiftService = {}

function GiftService.Init(services)
	DataService = services:GetService("DataService")
end

function GiftService.Start()
	Net.GiftService.RequestGift.On(function(player: Player, productId: any, recipientId: any)
		return GiftService:PromptGift(player, productId, recipientId)
	end)

	Players.PlayerRemoving:Connect(function(player)
		rateLimits[player.UserId] = nil
	end)

	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
		if isPurchased or not isGiftable(productId) then
			return
		end

		pcall(function()
			IntentMap:UpdateAsync(tostring(userId), function(existing)
				if
					existing
					and not existing.consumed
					and existing.productId == productId
					and (os.time() - (existing.ts or 0)) <= CANCEL_WINDOW
				then
					existing.consumed = true
				end
				return existing
			end, STORE_TTL)
		end)
	end)
end

function GiftService:PromptGift(buyer: Player, productId: number, recipientId: number): (boolean, string?)
	if not isValidId(productId) or not isValidId(recipientId) then
		return false, "invalid_arguments"
	end
	if typeof(buyer) ~= "Instance" or not buyer:IsA("Player") then
		return false, "bad_buyer"
	end
	if not isGiftable(productId) then
		return false, "not_giftable"
	end
	if not ALLOW_SELF_GIFT and recipientId == buyer.UserId then
		return false, "self_gift_disabled"
	end

	if not checkRate(buyer.UserId) then
		return false, "rate_limited"
	end

	if VERIFY_RECIPIENT then
		if isCachedInvalid(recipientId) then
			return false, "recipient_not_found"
		end

		local ok, infos = pcall(function()
			return UserService:GetUserInfosByUserIdsAsync({ recipientId })
		end)

		if ok then
			if type(infos) ~= "table" or #infos == 0 then
				markInvalid(recipientId)
				return false, "recipient_not_found"
			end
		elseif not VERIFY_FAIL_OPEN then
			return false, "verify_unavailable"
		end
	end

	local now = os.time()
	local intent = {
		nonce = HttpService:GenerateGUID(false),
		recipientId = recipientId,
		productId = productId,
		ts = now,
		expiresAt = now + INTENT_TTL,
	}

	local acquired, why = acquireIntent(buyer.UserId, intent)
	if not acquired then
		return false, why
	end

	local promptOk = pcall(function()
		MarketplaceService:PromptProductPurchase(buyer, productId)
	end)

	if not promptOk then
		consumeIntent(buyer.UserId, intent.nonce)
		return false, "prompt_failed"
	end

	return true
end

function GiftService:HandleReceipt(receiptInfo: any): Enum.ProductPurchaseDecision?
	if type(receiptInfo) ~= "table" or not isValidId(receiptInfo.PlayerId) or not isValidId(receiptInfo.ProductId) then
		return nil
	end

	local playerId = receiptInfo.PlayerId
	local purchaseId = tostring(receiptInfo.PurchaseId)

	local recOk, rec = readReceipt(purchaseId)
	if not recOk then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if rec then
		if type(rec.nonce) == "string" then
			consumeIntent(playerId, rec.nonce)
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local ok, intent = readIntent(playerId)
	if not ok then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if not intent or intent.productId ~= receiptInfo.ProductId then
		return nil
	end

	local sendOk, delivered = pcall(function()
		return DataService:SendGift(intent.recipientId, {
			purchaseId = purchaseId,
			productId = receiptInfo.ProductId,
			fromUserId = playerId,
			ts = os.time(),
		})
	end)

	if not sendOk or delivered ~= true then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if not markReceipt(purchaseId, intent.recipientId, intent.nonce) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	consumeIntent(playerId, intent.nonce)
	notify(Players:GetPlayerByUserId(playerId), "GiftPurchaseComplete", {
		recipientId = intent.recipientId,
		productId = receiptInfo.ProductId,
	})

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return GiftService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="681">
          <Properties>
            <string name="Name">GlobalExistService</string>
            <string name="Source"><![CDATA[--/Services
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local MemoryStoreService = game:GetService("MemoryStoreService")

--/Settings
local DB_UPDATE_INTERVAL = 300
local MEM_UPDATE_INTERVAL = 10
local MSG_UPDATE_INTERVAL = 1
local REFRESH_INTERVAL = 120
local MEMORY_TTL = 86400

--/Variables
local ExistDataStore = DataStoreService:GetDataStore("GlobalExistCounter")
local ExistMemoryMap = MemoryStoreService:GetSortedMap("GlobalExistMemoryMap")

--/Caches
local dbPending = {}
local memPending = {}
local msgPending = {}
local globalCounts = {}

--/Constants
local RANDOM = Random.new()
local DATASTORE_KEY = "AllGlobalCounts"
local MESSAGING_TOPIC = "GlobalExistUpdateChannel"

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function MakeCombinedKey(category: string, itemName: string): string
	return category .. ":" .. itemName
end

--[[local function ParseCombinedKey(combinedKey: string): (string, string)
	local split = string.split(combinedKey, ":")
	return split[1], split[2]
end--]]

local function GetMemoryMapAll()
	local counts = {}
	local exclusiveLowerBound = nil

	while true do
		local success, items = pcall(function()
			return ExistMemoryMap:GetRangeAsync(Enum.SortDirection.Ascending, 100, exclusiveLowerBound)
		end)

		if not success or not items or #items == 0 then
			break
		end

		local lastKey = nil
		for _, item in items do
			counts[item.key] = item.value
			lastKey = item.key
		end

		if #items < 100 then
			break
		end

		exclusiveLowerBound = lastKey
	end

	return counts
end

local function SnapshotAndClear(pendingTable)
	local snapshot = {}
	local hasData = false
	for k, v in pairs(pendingTable) do
		if v ~= 0 then
			snapshot[k] = v
			pendingTable[k] -= v
			hasData = true
		end
	end
	return hasData, snapshot
end

local function AddCounts(targetTable, sourceTable)
	for k, v in pairs(sourceTable) do
		targetTable[k] = (targetTable[k] or 0) + v
	end
end
local function SetCounts(targetTable, sourceTable)
	for k, v in pairs(sourceTable) do
		targetTable[k] = v
	end
end

local function CreateLoop(interval, callback, addJitter)
	task.spawn(function()
		while true do
			local waitTime = interval
			if addJitter then
				waitTime += RANDOM:NextInteger(1, 15)
			end
			task.wait(waitTime)
			callback()
		end
	end)
end

local function FetchAllGlobalCounts()
	local counts = GetMemoryMapAll()
	if next(counts) then
		return counts
	end

	local success, data = pcall(function()
		return ExistDataStore:GetAsync(DATASTORE_KEY)
	end)

	if success and type(data) == "table" then
		for k, v in pairs(data) do
			counts[k] = v
			task.spawn(function()
				local ok, err = pcall(function()
					ExistMemoryMap:SetAsync(k, v, MEMORY_TTL)
				end)
				if not ok then
					warn(
						`ExistMemoryMap:SetAsync failed for key: "{tostring(k)}" (type: {typeof(k)}), value: {tostring(
							v
						)} (type: {typeof(v)}). Error: {err}`
					)
				end
			end)
		end
	end

	return counts
end

local function SavePendingData()
	local hasData, snapshot = SnapshotAndClear(dbPending)
	if not hasData then
		return
	end

	local success, updatedTable = pcall(function()
		return ExistDataStore:UpdateAsync(DATASTORE_KEY, function(oldTable)
			local currentTable = oldTable or {}
			AddCounts(currentTable, snapshot)
			return currentTable
		end)
	end)

	if success and type(updatedTable) == "table" then
		SetCounts(globalCounts, updatedTable)
	else
		AddCounts(dbPending, snapshot)
	end
end

local function SaveMemoryPendingData()
	local hasData, snapshot = SnapshotAndClear(memPending)
	if not hasData then
		return
	end

	for combinedKey, amount in pairs(snapshot) do
		task.spawn(function()
			local success = pcall(function()
				return ExistMemoryMap:IncrementAsync(combinedKey, amount, MEMORY_TTL)
			end)

			if not success then
				memPending[combinedKey] = (memPending[combinedKey] or 0) + amount
			end
		end)
	end
end

-------------------------------------------------
--// GlobalExistService
-------------------------------------------------
local GlobalExistService = {}

function GlobalExistService.Init() end

function GlobalExistService.Start()
	globalCounts = FetchAllGlobalCounts()

	pcall(function()
		MessagingService:SubscribeAsync(MESSAGING_TOPIC, function(message)
			local data = message.Data
			if not data or data.SenderJobId == game.JobId or not data.Updates then
				return
			end

			AddCounts(globalCounts, data.Updates)
		end)
	end)

	CreateLoop(DB_UPDATE_INTERVAL, SavePendingData, true)
	CreateLoop(MEM_UPDATE_INTERVAL, SaveMemoryPendingData)
	CreateLoop(MSG_UPDATE_INTERVAL, function()
		local hasData, snapshot = SnapshotAndClear(msgPending)
		if not hasData then
			return
		end

		pcall(function()
			MessagingService:PublishAsync(MESSAGING_TOPIC, {
				SenderJobId = game.JobId,
				Updates = snapshot,
			})
		end)
	end)

	CreateLoop(REFRESH_INTERVAL, function()
		local counts = GetMemoryMapAll()
		SetCounts(globalCounts, counts)
	end)

	game:BindToClose(function()
		SaveMemoryPendingData()
		SavePendingData()
	end)
end

function GlobalExistService:AddExistCount(category: string, itemName: string, amount: number?)
	local combinedKey = MakeCombinedKey(category, itemName)
	local change = amount or 1

	dbPending[combinedKey] = (dbPending[combinedKey] or 0) + change
	memPending[combinedKey] = (memPending[combinedKey] or 0) + change
	msgPending[combinedKey] = (msgPending[combinedKey] or 0) + change

	globalCounts[combinedKey] = (globalCounts[combinedKey] or 0) + change
end

function GlobalExistService:GetCount(category: string, itemName: string): number
	local combinedKey = MakeCombinedKey(category, itemName)
	return globalCounts[combinedKey] or 0
end

return GlobalExistService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="682">
          <Properties>
            <string name="Name">InventoryActionService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local AutoSellConfig = require(ReplicatedStorage.Settings.Data.AutoSellConfig)
local UnitSellRewards = require(ReplicatedStorage.Settings.Data.UnitSellRewards)

local DataService

local REMOTES_FOLDER_NAME = "RuntimeRemotes"
local REMOTE_NAME = "InventoryAction"
local REQUEST_COOLDOWN = 0.15
local MAX_TOWER_NAME_LENGTH = 80
local MAX_TOWER_KEY_ID = 4_294_967_295

local lastRequestAt: { [Player]: number } = {}
local random = Random.new()
local InventoryActionService = {}

local function response(success: boolean, message: string, extra: { [string]: any }?)
	local result = extra or {}
	result.Success = success
	result.Message = message
	return result
end

local function normalizeTowerKey(value: any): string?
	if typeof(value) ~= "string" and typeof(value) ~= "number" then
		return nil
	end

	local keyText = tostring(value)
	local keyIdText = string.match(keyText, "^t_(%d+)$") or string.match(keyText, "^(%d+)$")
	local keyId = if keyIdText then tonumber(keyIdText) else nil
	if not keyId or keyId % 1 ~= 0 or keyId < 0 or keyId > MAX_TOWER_KEY_ID then
		return nil
	end
	return `t_{keyId}`
end

function InventoryActionService:Perform(player: Player, data: any)
	local now = os.clock()
	local previous = lastRequestAt[player]
	if previous and now - previous < REQUEST_COOLDOWN then
		return response(false, "Please wait a moment.")
	end
	lastRequestAt[player] = now

	if typeof(data) ~= "table" then
		return response(false, "Invalid unit request.")
	end

	local action = data.Action
	local towerName = data.TowerName
	local towerKey = normalizeTowerKey(data.TowerKey)
	if
		(action ~= "ToggleUnitLock" and action ~= "SellUnit")
		or typeof(towerName) ~= "string"
		or towerName == ""
		or #towerName > MAX_TOWER_NAME_LENGTH
		or not towerKey
	then
		return response(false, "Invalid unit request.")
	end

	local playerData = DataService:GetData(player)
	if not playerData then
		return response(false, "Your data is still loading.")
	end

	local towersOfType = playerData.OwnedTowers[towerName]
	local tower = towersOfType and towersOfType[towerKey]
	if typeof(tower) ~= "table" then
		return response(false, "You do not own this unit.")
	end

	if action == "ToggleUnitLock" then
		local isLocked = tower.Locked ~= true
		DataService:UpdateData(player, "OwnedTowers", isLocked, towerName, towerKey, "Locked")
		return response(true, if isLocked then "Unit locked." else "Unit unlocked.", {
			Locked = isLocked,
		})
	end

	if tower.Locked == true then
		return response(false, "Unlock this unit before selling it.", { Locked = true })
	end

	local towerInfo = TowerData.ByName[towerName]
	local rarity = towerInfo and towerInfo.Rarity
	local autoSellEntry = rarity and AutoSellConfig.ByRarity[rarity]
	local sellPrice = towerInfo and (towerInfo.SellPrice or (autoSellEntry and autoSellEntry.Price))
	if typeof(sellPrice) ~= "number" or sellPrice <= 0 or sellPrice % 1 ~= 0 then
		return response(false, "This unit cannot be sold.")
	end

	DataService:RemoveTower(player, towerName, towerKey)
	local newCoins = DataService:AddData(player, "Coins", sellPrice)
	local shardStones = if UnitSellRewards.Roll(rarity or "", random) then 1 else 0
	if shardStones > 0 then
		DataService:AddData(player, "Inventory", shardStones, "Items", UnitSellRewards.ItemName)
	end
	return response(true, `Sold for {sellPrice} Coins.`, {
		Coins = newCoins,
		SellPrice = sellPrice,
		ShardStones = shardStones,
		Locked = false,
	})
end

function InventoryActionService.Init(services)
	DataService = services:GetService("DataService")
end

InventoryActionService.Dependencies = { "DataService" }

function InventoryActionService.Start()
	local remotesFolder = ReplicatedStorage:FindFirstChild(REMOTES_FOLDER_NAME)
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = REMOTES_FOLDER_NAME
		remotesFolder.Parent = ReplicatedStorage
	end

	local remote = remotesFolder:FindFirstChild(REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteFunction")
		remote.Name = REMOTE_NAME
		remote.Parent = remotesFolder
	end
	assert(remote:IsA("RemoteFunction"), "InventoryAction runtime remote must be a RemoteFunction")

	remote.OnServerInvoke = function(player: Player, data: any)
		return InventoryActionService:Perform(player, data)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastRequestAt[player] = nil
	end)
end

return InventoryActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="683">
          <Properties>
            <string name="Name">LoadoutService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local DataService

local MAX_LOADOUT_SIZE = 5

-------------------------------------------------
--// Local Function
-------------------------------------------------
local function isValidIndex(loadoutIndex: any): boolean
	return typeof(loadoutIndex) == "number" and loadoutIndex > 0 and loadoutIndex <= MAX_LOADOUT_SIZE
end

-------------------------------------------------
--// LoadoutService
-------------------------------------------------
local LoadoutService = {}

function LoadoutService:SetLoadout(player: Player, loadoutIndex: number | "Auto", towerName: string, towerKey: string)
	if loadoutIndex ~= "Auto" and not isValidIndex(loadoutIndex) then
		warn(`요청한 로드아웃 번호가 유효하지 않음.`)
		return false
	end

	if typeof(towerName) ~= "string" or typeof(towerKey) ~= "string" then
		warn(`요청한 타워 정보가 유효하지 않음.`)
		return false
	end

	local playerData = DataService:GetData(player)
	local ownedTowerMap = playerData.OwnedTowers[towerName]
	if not ownedTowerMap or not ownedTowerMap[towerKey] then
		warn(`소유하지 않은 타워를 로드아웃에 장착하려 함.`)
		return false
	end

	for index = 1, MAX_LOADOUT_SIZE do
		local strIndex = tostring(index)
		local equippedTower = playerData.Loadout[strIndex] or playerData.Loadout[index]
		if equippedTower and (equippedTower.Name == towerName or equippedTower.Key == towerKey) then
			DataService:UpdateData(player, "Loadout", nil, strIndex)
			DataService:UpdateData(player, "Loadout", nil, index)

			if loadoutIndex ~= "Auto" then
				break
			end
		end
	end

	if loadoutIndex == "Auto" then
		for index = 1, MAX_LOADOUT_SIZE do
			local strIndex = tostring(index)
			if not (playerData.Loadout[strIndex] or playerData.Loadout[index]) then
				loadoutIndex = index
				break
			end
		end

		if loadoutIndex == "Auto" then
			warn(`로드아웃이 가득 참.`)
			return false
		end
	end

	DataService:UpdateData(player, "Loadout", { Name = towerName, Key = towerKey }, tostring(loadoutIndex))

	return true
end

function LoadoutService:UnequipLoadout(player: Player, loadoutIndex: number | "All")
	if loadoutIndex == "All" then
		DataService:UpdateData(player, "Loadout", {})
		return true
	end
	if not isValidIndex(loadoutIndex) then
		warn(`요청한 로드아웃 번호가 유효하지 않음.`)
		return false
	end

	DataService:UpdateData(player, "Loadout", nil, tostring(loadoutIndex))
	DataService:UpdateData(player, "Loadout", nil, loadoutIndex)

	return true
end

function LoadoutService:UnequipTower(player: Player, towerName: string, towerKey: string)
	if typeof(towerName) ~= "string" then
		warn(`요청한 타워 이름이 유효하지 않음.`)
		return false
	end

	if towerKey ~= nil and typeof(towerKey) ~= "string" then
		warn(`요청한 타워 키가 유효하지 않음.`)
		return false
	end

	local playerData = DataService:GetData(player)
	for index = 1, MAX_LOADOUT_SIZE do
		local strIndex = tostring(index)
		local equippedTower = playerData.Loadout[strIndex] or playerData.Loadout[index]

		if not equippedTower then
			continue
		end

		local sameTower = if towerKey then equippedTower.Key == towerKey else equippedTower.Name == towerName

		if sameTower then
			LoadoutService:UnequipLoadout(player, index)
			return true
		end
	end

	warn(`장착 중인 타워를 찾을 수 없음: {towerName}`)
	return false
end

function LoadoutService.Init(services)
	DataService = services:GetService("DataService")
end

function LoadoutService.Start()
	Net.LoadoutService.SetLoadout.On(function(player: Player, data)
		if typeof(data) ~= "table" then
			return false
		end

		if data.requestType == "Equip" then
			local targetTower = data.targetTower
			if typeof(targetTower) ~= "table" then
				return false
			end

			if typeof(targetTower.towerName) ~= "string" or typeof(targetTower.towerKey) ~= "number" then
				return false
			end

			local targetKey = `t_{targetTower.towerKey}`
			return LoadoutService:SetLoadout(player, "Auto", targetTower.towerName, targetKey)
		end

		if data.requestType == "Unequip" then
			local targetTower = data.targetTower
			if typeof(targetTower) ~= "table" then
				return false
			end

			if typeof(targetTower.towerName) ~= "string" or typeof(targetTower.towerKey) ~= "number" then
				return false
			end

			local targetKey = `t_{targetTower.towerKey}`
			return LoadoutService:UnequipTower(player, targetTower.towerName, targetKey)
		end

		if data.requestType == "UnequipAll" then
			return LoadoutService:UnequipLoadout(player, "All")
		end

		return false
	end)
end

return LoadoutService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="684">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local MatchProtocol = require(ReplicatedStorage.Shared.Modules.Core.MatchProtocol)
local PartySettings = require(ReplicatedStorage.Settings.Game.PartySettings)

export type MatchRequest = {
	Members: { Player },
	Settings: MatchProtocol.Settings,
}
export type MatchState = "Preparing" | "Teleporting" | "Retryable" | "Closed"
export type MatchStatus = {
	State: MatchState,
	MatchId: string,
	ErrorCode: MatchProtocol.ErrorCode?,
}
export type MatchReceipt = { MatchId: string }
type Observer = (MatchStatus) -> ()
type MatchRecord = {
	Id: string,
	State: MatchState,
	Members: { [number]: Player },
	MemberCount: number,
	Settings: MatchProtocol.Settings,
	AccessCode: string?,
	Attempt: number,
	Pending: { [number]: boolean },
	HasDeparted: boolean,
	ExpiresAt: number?,
	Revision: number,
	OnChanged: Observer,
}

local MatchService = {}
local matches: { [string]: MatchRecord } = {}
local playerMatches: { [number]: string } = {}
local connections: { RBXScriptConnection } = {}

local function isCurrent(record: MatchRecord): boolean
	return matches[record.Id] == record
end

local function notify(record: MatchRecord, state: MatchState, errorCode: MatchProtocol.ErrorCode?)
	record.State = state
	record.Revision += 1
	local revision = record.Revision
	local status: MatchStatus = { State = state, MatchId = record.Id, ErrorCode = errorCode }
	-- Callers finish their own mutation before observing a transition. Stale queued
	-- transitions and subscriber exceptions cannot mutate or strand the match.
	task.defer(function()
		if record.Revision ~= revision then
			return
		end
		local ok, err = pcall(record.OnChanged :: any, status)
		if not ok then
			warn("[MatchService] Status observer failed:", err)
		end
	end)
end

local function close(record: MatchRecord, errorCode: MatchProtocol.ErrorCode?)
	if not isCurrent(record) then
		return
	end
	matches[record.Id] = nil
	for userId in record.Members do
		if playerMatches[userId] == record.Id then
			playerMatches[userId] = nil
		end
	end
	record.Members = {}
	record.Pending = {}
	notify(record, "Closed", errorCode)
end

local function remainingMembers(record: MatchRecord): { Player }
	local remaining = {}
	for userId, player in record.Members do
		if player.Parent == Players and playerMatches[userId] == record.Id then
			table.insert(remaining, player)
		end
	end
	return remaining
end

local beginAttempt: (MatchRecord) -> ()

local function finishAttempt(record: MatchRecord, attempt: number, errorCode: MatchProtocol.ErrorCode)
	if not isCurrent(record) or record.Attempt ~= attempt or record.State ~= "Teleporting" then
		return
	end
	if #remainingMembers(record) == 0 then
		close(record, nil)
		return
	end
	record.Pending = {}
	-- A departure only establishes that someone left this lobby, not that they
	-- reached the destination. No arrival/reward claims depend on this flag.
	notify(record, "Retryable", if record.HasDeparted then "TELEPORT_PARTIAL" else errorCode)
	if attempt < PartySettings.TeleportMaxAttempts then
		task.delay(PartySettings.TeleportRetryDelay, function()
			if isCurrent(record) and record.Attempt == attempt and (record.State :: MatchState) == "Retryable" then
				beginAttempt(record)
			end
		end)
	end
end

beginAttempt = function(record: MatchRecord)
	if not isCurrent(record) then
		return
	end
	if record.ExpiresAt and os.clock() >= record.ExpiresAt then
		close(record, "MATCH_EXPIRED")
		return
	end
	local members = remainingMembers(record)
	if #members == 0 then
		close(record, nil)
		return
	end
	record.Attempt += 1
	local attempt = record.Attempt
	record.Pending = {}
	for _, player in members do
		record.Pending[player.UserId] = true
	end
	notify(record, "Teleporting", nil)

	-- This watchdog also covers a TeleportAsync call that never returns.
	task.delay(PartySettings.TeleportAttemptTimeout, function()
		finishAttempt(record, attempt, "TELEPORT_TIMEOUT")
	end)
	task.defer(function()
		if not isCurrent(record) or record.Attempt ~= attempt or record.State ~= "Teleporting" then
			return
		end
		-- Recheck attendance after deferring; never submit a player who has left.
		local present = remainingMembers(record)
		if #present == 0 then
			close(record, nil)
			return
		end
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = record.AccessCode :: string
		local data = MatchProtocol.CreateTeleportData(record.Id, record.Settings, record.MemberCount)
		data.AttemptId = attempt
		options:SetTeleportData(data)
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(PartySettings.GamePlaceId, present, options)
		end)
		options:Destroy()
		if not ok and isCurrent(record) and record.Attempt == attempt and record.State == "Teleporting" then
			warn("[MatchService] Teleport request failed:", err)
			finishAttempt(record, attempt, "TELEPORT_FAILED")
		end
	end)
end

-- Non-yielding acceptance API shared by parties and future matchmaking. The
-- caller supplies already chosen members/settings; this service revalidates and
-- snapshots them before any asynchronous reservation or teleport can begin.
function MatchService:StartMatch(request: MatchRequest, onChanged: Observer): MatchProtocol.Result<MatchReceipt>
	if type(request) ~= "table" or type(request.Members) ~= "table" or type(onChanged) ~= "function" then
		return MatchProtocol.Failure("INVALID_ARGUMENT")
	end
	local settings, settingsError = MatchProtocol.ValidateStartSettings(request.Settings)
	if not settings then
		return MatchProtocol.Failure(settingsError :: MatchProtocol.ErrorCode)
	end
	local memberCount = #request.Members
	if memberCount < PartySettings.MinMembers then
		return MatchProtocol.Failure("PARTY_TOO_SMALL")
	end
	if memberCount > PartySettings.MaxMembers then
		return MatchProtocol.Failure("PARTY_FULL")
	end
	local members: { [number]: Player } = {}
	local actualCount = 0
	for index, player in request.Members do
		if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > memberCount then
			return MatchProtocol.Failure("INVALID_ARGUMENT")
		end
		if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
			return MatchProtocol.Failure("INVALID_PLAYER")
		end
		if members[player.UserId] then
			return MatchProtocol.Failure("INVALID_ARGUMENT")
		end
		if playerMatches[player.UserId] or player:GetAttribute("AFKTeleportPending") then
			return MatchProtocol.Failure("ALREADY_IN_MATCH")
		end
		members[player.UserId] = player
		actualCount += 1
	end
	if actualCount ~= memberCount then
		return MatchProtocol.Failure("INVALID_ARGUMENT")
	end
	if PartySettings.GamePlaceId <= 0 or PartySettings.GamePlaceId % 1 ~= 0 then
		return MatchProtocol.Failure("DESTINATION_NOT_CONFIGURED")
	end
	if RunService:IsStudio() then
		return MatchProtocol.Failure("STUDIO_TELEPORT_UNAVAILABLE")
	end

	local record: MatchRecord = {
		Id = HttpService:GenerateGUID(false),
		State = "Preparing",
		Members = members,
		MemberCount = memberCount,
		Settings = { Map = settings.Map, Difficulty = settings.Difficulty },
		AccessCode = nil,
		Attempt = 0,
		Pending = {},
		HasDeparted = false,
		ExpiresAt = nil,
		Revision = 0,
		OnChanged = onChanged,
	}
	matches[record.Id] = record
	for userId in members do
		playerMatches[userId] = record.Id
	end
	notify(record, "Preparing", nil)
	task.delay(PartySettings.ReservationTimeout, function()
		if isCurrent(record) and record.State == "Preparing" then
			close(record, "RESERVATION_FAILED")
		end
	end)
	task.defer(function()
		if not isCurrent(record) then
			return
		end
		local ok, accessCode = pcall(function()
			return TeleportService:ReserveServerAsync(PartySettings.GamePlaceId)
		end)
		-- A reservation can finish after timeout/disband; never teleport then.
		if not isCurrent(record) or record.State ~= "Preparing" then
			return
		end
		if not ok or type(accessCode) ~= "string" or accessCode == "" then
			warn("[MatchService] Server reservation failed")
			close(record, "RESERVATION_FAILED")
			return
		end
		record.AccessCode = accessCode
		record.ExpiresAt = os.clock() + PartySettings.MatchRetryLifetime
		task.delay(PartySettings.MatchRetryLifetime, function()
			close(record, "MATCH_EXPIRED")
		end)
		beginAttempt(record)
	end)
	return MatchProtocol.Success({ MatchId = record.Id })
end

function MatchService:RetryMatch(matchId: string): MatchProtocol.Result<MatchReceipt>
	if type(matchId) ~= "string" then
		return MatchProtocol.Failure("INVALID_ARGUMENT")
	end
	local record = matches[matchId]
	if not record then
		return MatchProtocol.Failure("MATCH_NOT_FOUND")
	end
	if record.ExpiresAt and os.clock() >= record.ExpiresAt then
		close(record, "MATCH_EXPIRED")
		return MatchProtocol.Failure("MATCH_EXPIRED")
	end
	if record.State ~= "Retryable" then
		return MatchProtocol.Failure("MATCH_BUSY")
	end
	if #remainingMembers(record) == 0 then
		close(record, nil)
		return MatchProtocol.Failure("NO_MEMBERS")
	end
	beginAttempt(record)
	return MatchProtocol.Success({ MatchId = record.Id })
end

function MatchService:IsPlayerBusy(player: Player): boolean
	return playerMatches[player.UserId] ~= nil
end

-- Synchronous guard for party mutations while asynchronous status delivery is
-- queued. Retryable membership changes remain allowed.
function MatchService:IsMatchBusy(matchId: string): boolean
	local record = matches[matchId]
	return record ~= nil and (record.State == "Preparing" or record.State == "Teleporting")
end

function MatchService:RemovePlayer(player: Player)
	local matchId = playerMatches[player.UserId]
	local record = if matchId then matches[matchId] else nil
	if not record then
		return
	end
	-- This is also called on PlayerRemoving, where Parent can still be Players.
	-- Explicit party removal during Retryable is not evidence of arrival either.
	if record.Attempt > 0 then
		record.HasDeparted = true
	end
	record.Members[player.UserId] = nil
	record.Pending[player.UserId] = nil
	playerMatches[player.UserId] = nil
	if next(record.Members) == nil then
		close(record, nil)
	elseif record.State == "Teleporting" and next(record.Pending) == nil then
		finishAttempt(record, record.Attempt, "TELEPORT_PARTIAL")
	end
end

function MatchService:CloseMatch(matchId: string)
	local record = matches[matchId]
	if record then
		close(record, nil)
	end
end

function MatchService.Init() end

function MatchService.Start()
	if #connections > 0 then
		return
	end
	table.insert(
		connections,
		Players.PlayerRemoving:Connect(function(player)
			MatchService:RemovePlayer(player)
		end)
	)
	table.insert(
		connections,
		TeleportService.TeleportInitFailed:Connect(function(player, _result, _message, placeId, options)
			local matchId = playerMatches[player.UserId]
			local record = if matchId then matches[matchId] else nil
			if not record or record.State ~= "Teleporting" or placeId ~= PartySettings.GamePlaceId or not options then
				return
			end
			local ok, data = pcall(function()
				return options:GetTeleportData()
			end)
			if not ok or type(data) ~= "table" or data.MatchId ~= record.Id or data.AttemptId ~= record.Attempt then
				return
			end
			if options.ReservedServerAccessCode ~= record.AccessCode or not record.Pending[player.UserId] then
				return
			end
			record.Pending[player.UserId] = nil
			-- Wait for every member to fail/leave or the watchdog before another
			-- batch. Multiple failure events cannot schedule parallel retries.
			if next(record.Pending) == nil then
				finishAttempt(record, record.Attempt, "TELEPORT_FAILED")
			end
		end)
	)
end

function MatchService.Destroy()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, record in matches do
		close(record, nil)
	end
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="685">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Signal = require(ReplicatedStorage.Packages.Signal)
local Protocol = require(ReplicatedStorage.Shared.Modules.Core.MatchProtocol)
local Config = require(ReplicatedStorage.Settings.Game.PartySettings)

type Settings = Protocol.Settings
type Result<T> = Protocol.Result<T>
type Snapshot = Protocol.PartySnapshot
type ErrorCode = Protocol.ErrorCode
type RateLimit = { Tokens: number, UpdatedAt: number }
export type ServerPartyEvent = { Kind: string, PartyId: string, Party: Snapshot?, Reason: string? }
type Party = {
	Id: string,
	Leader: Player,
	Members: { Player },
	Settings: Settings,
	State: Protocol.PartyState,
	Revision: number,
	MatchId: string?,
	ErrorCode: ErrorCode?,
}

local parties: { [string]: Party } = {}
local membership: { [Player]: Party } = {}
local sequences: { [Player]: number } = {}
local rateLimits: { [Player]: RateLimit } = {}
local connections: { RBXScriptConnection } = {}
local MatchService: any
local changedRemote: RemoteEvent?
local requestRemote: RemoteFunction?
local started = false

local PartyService = { Dependencies = { "MatchService" }, Changed = Signal.new() }

local function validPlayer(player: any): boolean
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

-- Every public read owns its tables. Callers cannot mutate the live party.
local function snapshot(party: Party): Snapshot
	local members = {}
	for _, player in party.Members do
		table.insert(members, { UserId = player.UserId, Name = player.Name, DisplayName = player.DisplayName })
	end
	return {
		Id = party.Id,
		LeaderUserId = party.Leader.UserId,
		Members = members,
		Settings = { Map = party.Settings.Map, Difficulty = party.Settings.Difficulty },
		State = party.State,
		Revision = party.Revision,
		MaxMembers = Config.MaxMembers,
		MatchId = party.MatchId,
		ErrorCode = party.ErrorCode,
	}
end

local function send(player: Player, kind: any, party: Party, reason: string?, includeParty: boolean)
	if not validPlayer(player) then
		return
	end
	sequences[player] = (sequences[player] or 0) + 1
	local event: Protocol.PartyEvent = {
		Kind = kind,
		PartyId = party.Id,
		Party = if includeParty then snapshot(party) else nil,
		Reason = reason,
		Sequence = sequences[player],
	}
	if changedRemote then
		changedRemote:FireClient(player, event)
	end
end

local function publish(party: Party, kind: any?, reason: string?)
	party.Revision += 1
	for _, player in party.Members do
		send(player, kind or "Updated", party, reason, true)
	end
	PartyService.Changed:Fire(
		{ Kind = kind or "Updated", PartyId = party.Id, Party = snapshot(party), Reason = reason } :: ServerPartyEvent
	)
end

local function getOwnedParty(player: Player): (Party?, ErrorCode?)
	if not validPlayer(player) then
		return nil, "INVALID_PLAYER"
	end
	local party = membership[player]
	if not party then
		return nil, "NOT_IN_PARTY"
	end
	if party.Leader ~= player then
		return nil, "NOT_LEADER"
	end
	return party, nil
end

local function destroyParty(party: Party, reason: string)
	parties[party.Id] = nil
	for _, player in party.Members do
		membership[player] = nil
		player:SetAttribute("PartyId", nil)
		send(player, "Disbanded", party, reason, false)
	end
	if party.MatchId then
		MatchService:CloseMatch(party.MatchId)
	end
	PartyService.Changed:Fire({ Kind = "Disbanded", PartyId = party.Id, Reason = reason } :: ServerPartyEvent)
end

local function removeMember(party: Party, player: Player, reason: string)
	local index = table.find(party.Members, player)
	if not index then
		return
	end
	table.remove(party.Members, index)
	membership[player] = nil
	player:SetAttribute("PartyId", nil)
	send(player, "Removed", party, reason, false)
	MatchService:RemovePlayer(player)
	if #party.Members == 0 then
		destroyParty(party, "EMPTY")
		return
	end
	-- Deterministic succession: the longest-standing remaining member becomes leader.
	if party.Leader == player then
		party.Leader = party.Members[1]
	end
	publish(party, "Updated", reason)
end

local function locked(party: Party): boolean
	return party.State == "Starting"
		or party.State == "Teleporting"
		or (party.MatchId ~= nil and MatchService:IsMatchBusy(party.MatchId))
end

local function validatePatch(current: Settings, patch: any): (Settings?, ErrorCode?)
	if type(patch) ~= "table" or next(patch) == nil then
		return nil, "INVALID_ARGUMENT"
	end
	for key in patch do
		if key ~= "Map" and key ~= "Difficulty" then
			return nil, "INVALID_ARGUMENT"
		end
	end
	return Protocol.ValidateSettings({
		Map = if patch.Map == nil then current.Map else patch.Map,
		Difficulty = if patch.Difficulty == nil then current.Difficulty else patch.Difficulty,
	})
end

function PartyService:CreateParty(player: Player, settings: Protocol.SettingsPatch?): Result<Snapshot>
	if not validPlayer(player) then
		return Protocol.Failure("INVALID_PLAYER")
	end
	if membership[player] then
		return Protocol.Failure("ALREADY_IN_PARTY")
	end
	if player:GetAttribute("AFKTeleportPending") or MatchService:IsPlayerBusy(player) then
		return Protocol.Failure("ALREADY_IN_MATCH")
	end
	local selected, code = validatePatch(
		{ Map = Config.DefaultMap, Difficulty = Config.DefaultDifficulty },
		if settings == nil then { Map = Config.DefaultMap, Difficulty = Config.DefaultDifficulty } else settings
	)
	if not selected then
		return Protocol.Failure(code :: ErrorCode)
	end
	local party: Party = {
		Id = HttpService:GenerateGUID(false),
		Leader = player,
		Members = { player },
		Settings = selected,
		State = "Open",
		Revision = 0,
	}
	parties[party.Id] = party
	membership[player] = party
	player:SetAttribute("PartyId", party.Id)
	publish(party, "Created")
	return Protocol.Success(snapshot(party))
end

function PartyService:JoinParty(player: Player, partyId: string): Result<Snapshot>
	if not validPlayer(player) then
		return Protocol.Failure("INVALID_PLAYER")
	end
	if type(partyId) ~= "string" or #partyId > 100 then
		return Protocol.Failure("INVALID_ARGUMENT")
	end
	if membership[player] then
		return Protocol.Failure("ALREADY_IN_PARTY")
	end
	if player:GetAttribute("AFKTeleportPending") or MatchService:IsPlayerBusy(player) then
		return Protocol.Failure("ALREADY_IN_MATCH")
	end
	local party = parties[partyId]
	if not party then
		return Protocol.Failure("PARTY_NOT_FOUND")
	end
	if party.State ~= "Open" then
		return Protocol.Failure("PARTY_BUSY")
	end
	if #party.Members >= Config.MaxMembers then
		return Protocol.Failure("PARTY_FULL")
	end
	-- No yielding work between capacity/membership checks and this insertion.
	table.insert(party.Members, player)
	membership[player] = party
	player:SetAttribute("PartyId", party.Id)
	publish(party, "Updated", "JOINED")
	return Protocol.Success(snapshot(party))
end

function PartyService:LeaveParty(player: Player): Result<Snapshot>
	local party = membership[player]
	if not party then
		return Protocol.Failure("NOT_IN_PARTY")
	end
	if locked(party) then
		return Protocol.Failure("PARTY_BUSY")
	end
	removeMember(party, player, "LEFT")
	return Protocol.Success(nil)
end

function PartyService:TransferLeadership(player: Player, userId: number): Result<Snapshot>
	local party, code = getOwnedParty(player)
	if not party then
		return Protocol.Failure(code :: ErrorCode)
	end
	if locked(party) then
		return Protocol.Failure("PARTY_BUSY")
	end
	if type(userId) ~= "number" or userId % 1 ~= 0 then
		return Protocol.Failure("INVALID_ARGUMENT")
	end
	for _, member in party.Members do
		if member.UserId == userId then
			party.Leader = member
			publish(party, "Updated", "LEADER_CHANGED")
			return Protocol.Success(snapshot(party))
		end
	end
	return Protocol.Failure("MEMBER_NOT_FOUND")
end

function PartyService:KickMember(player: Player, userId: number): Result<Snapshot>
	local party, code = getOwnedParty(player)
	if not party then
		return Protocol.Failure(code :: ErrorCode)
	end
	if locked(party) then
		return Protocol.Failure("PARTY_BUSY")
	end
	if type(userId) ~= "number" or userId % 1 ~= 0 then
		return Protocol.Failure("INVALID_ARGUMENT")
	end
	if userId == player.UserId then
		return Protocol.Failure("CANNOT_KICK_SELF")
	end
	for _, member in party.Members do
		if member.UserId == userId then
			removeMember(party, member, "KICKED")
			return Protocol.Success(snapshot(party))
		end
	end
	return Protocol.Failure("MEMBER_NOT_FOUND")
end

function PartyService:DisbandParty(player: Player): Result<Snapshot>
	local party, code = getOwnedParty(player)
	if not party then
		return Protocol.Failure(code :: ErrorCode)
	end
	if locked(party) then
		return Protocol.Failure("PARTY_BUSY")
	end
	destroyParty(party, "LEADER_DISBANDED")
	return Protocol.Success(nil)
end

function PartyService:UpdateSettings(player: Player, patch: Protocol.SettingsPatch): Result<Snapshot>
	local party, code = getOwnedParty(player)
	if not party then
		return Protocol.Failure(code :: ErrorCode)
	end
	if party.State ~= "Open" then
		return Protocol.Failure("PARTY_BUSY")
	end
	local settings, errorCode = validatePatch(party.Settings, patch)
	if not settings then
		return Protocol.Failure(errorCode :: ErrorCode)
	end
	party.Settings = settings
	party.ErrorCode = nil
	publish(party, "Updated", "SETTINGS_CHANGED")
	return Protocol.Success(snapshot(party))
end

function PartyService:StartParty(player: Player): Result<Snapshot>
	local party, code = getOwnedParty(player)
	if not party then
		return Protocol.Failure(code :: ErrorCode)
	end
	if locked(party) then
		return Protocol.Failure("PARTY_BUSY")
	end
	if party.State == "Retryable" and party.MatchId then
		local retry = MatchService:RetryMatch(party.MatchId)
		if not retry.Success then
			return Protocol.Failure(retry.Code)
		end
		party.State = "Teleporting"
		party.ErrorCode = nil
		publish(party, "Teleporting", "RETRYING")
		return Protocol.Success(snapshot(party))
	end
	local settings, errorCode = Protocol.ValidateStartSettings(party.Settings)
	if not settings then
		return Protocol.Failure(errorCode :: ErrorCode)
	end
	if #party.Members < Config.MinMembers then
		return Protocol.Failure("PARTY_TOO_SMALL")
	end
	for _, member in party.Members do
		if not validPlayer(member) or member:GetAttribute("AFKTeleportPending") then
			return Protocol.Failure("INVALID_PLAYER")
		end
	end
	-- Lock first. MatchService stores the immutable request before scheduling any yielding work.
	party.State = "Starting"
	party.ErrorCode = nil
	local result = MatchService:StartMatch(
		{ Members = table.clone(party.Members), Settings = settings },
		function(status)
			if parties[party.Id] ~= party or (party.MatchId and party.MatchId ~= status.MatchId) then
				return
			end
			party.ErrorCode = status.ErrorCode
			if status.State == "Closed" then
				if status.ErrorCode == "RESERVATION_FAILED" then
					party.State = "Open"
					party.MatchId = nil
					publish(party, "Updated", status.ErrorCode)
				else
					destroyParty(party, status.ErrorCode or "MATCH_CLOSED")
				end
				return
			end
			party.MatchId = status.MatchId
			party.State = if status.State == "Preparing" then "Starting" else status.State
			publish(party, if party.State == "Open" then "Updated" else "Teleporting", status.ErrorCode)
		end
	)
	if not result.Success then
		party.State = "Open"
		return Protocol.Failure(result.Code)
	end
	party.MatchId = result.Data.MatchId
	publish(party, "Teleporting", "STARTING")
	return Protocol.Success(snapshot(party))
end

function PartyService:GetParty(player: Player, partyId: string?): Result<Snapshot>
	if not validPlayer(player) then
		return Protocol.Failure("INVALID_PLAYER")
	end
	if partyId ~= nil and (type(partyId) ~= "string" or #partyId > 100) then
		return Protocol.Failure("INVALID_ARGUMENT")
	end
	local party = if partyId then parties[partyId] else membership[player]
	if partyId and not party then
		return Protocol.Failure("PARTY_NOT_FOUND")
	end
	return Protocol.Success(if party then snapshot(party) else nil)
end

function PartyService:ListParties(_player: Player?): Result<{ Snapshot }>
	local result = {}
	for _, party in parties do
		if party.State == "Open" then
			table.insert(result, snapshot(party))
		end
	end
	table.sort(result, function(a, b)
		return a.Id < b.Id
	end)
	return Protocol.Success(result)
end

local function allowRequest(player: Player): boolean
	local now = os.clock()
	local limit: RateLimit = rateLimits[player] or { Tokens = Config.RequestBurst, UpdatedAt = now }
	limit.Tokens = math.min(Config.RequestBurst, limit.Tokens + (now - limit.UpdatedAt) * Config.RequestsPerSecond)
	limit.UpdatedAt = now
	rateLimits[player] = limit
	if limit.Tokens < 1 then
		return false
	end
	limit.Tokens -= 1
	return true
end

function PartyService.Init(services)
	MatchService = services:GetService("MatchService")
end

function PartyService.Start()
	if started then
		return
	end
	started = true
	local folder = ReplicatedStorage:FindFirstChild("RuntimeRemotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "RuntimeRemotes"
		folder.Parent = ReplicatedStorage
	end
	local request = Instance.new("RemoteFunction")
	request.Name = "PartyRequest"
	local changed = Instance.new("RemoteEvent")
	changed.Name = "PartyChanged"
	requestRemote = request
	changedRemote = changed
	local actions: { [string]: any } = {
		CreateParty = PartyService.CreateParty,
		JoinParty = PartyService.JoinParty,
		LeaveParty = PartyService.LeaveParty,
		TransferLeadership = PartyService.TransferLeadership,
		KickMember = PartyService.KickMember,
		DisbandParty = PartyService.DisbandParty,
		UpdateSettings = PartyService.UpdateSettings,
		StartParty = PartyService.StartParty,
		GetParty = PartyService.GetParty,
		ListParties = PartyService.ListParties,
	}
	request.OnServerInvoke = function(player: Player, action: any, payload: any)
		if not allowRequest(player) then
			return Protocol.Failure("RATE_LIMITED")
		end
		if type(action) ~= "string" or not actions[action] then
			return Protocol.Failure("INVALID_ARGUMENT")
		end
		local ok, result = pcall(actions[action], PartyService, player, payload)
		if not ok then
			warn(`[PartyService] {action} failed: {result}`)
			return Protocol.Failure("INTERNAL_ERROR")
		end
		result.Sequence = sequences[player] or 0
		return result
	end
	changed.Parent = folder
	request.Parent = folder
	table.insert(
		connections,
		Players.PlayerRemoving:Connect(function(player)
			local party = membership[player]
			if party then
				removeMember(party, player, "DISCONNECTED")
			end
			sequences[player] = nil
			rateLimits[player] = nil
		end)
	)
end

function PartyService.Destroy()
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	for _, party in table.clone(parties) do
		destroyParty(party, "SERVICE_STOPPED")
	end
	if requestRemote then
		requestRemote:Destroy()
	end
	if changedRemote then
		changedRemote:Destroy()
	end
	requestRemote = nil
	changedRemote = nil
	table.clear(sequences)
	table.clear(rateLimits)
	PartyService.Changed:DisconnectAll()
	started = false
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="686">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuestData = require(ReplicatedStorage.Settings.Data.QuestData)

local DataService

local QuestService = {}

function QuestService.GetPlayerQuests(player: Player)
	if not DataService then
		return {}
	end
	local playerData = DataService:GetData(player)
	if not playerData then
		return {}
	end
	return playerData.Quests or {}
end

function QuestService.AcceptQuest(player: Player, questId: string): boolean
	local config = QuestData.Get(questId)
	if not config or not DataService then
		return false
	end

	local playerData = DataService:GetData(player)
	if not playerData then
		return false
	end

	if not playerData.Quests then
		playerData.Quests = {}
	end

	local currentQuest = playerData.Quests[questId]
	if currentQuest and (currentQuest.Active or currentQuest.Claimed) then
		return false
	end

	local initialProgress = 0
	local objective = config.Entity.Objective
	if objective.Kind == "Currency" and playerData[objective.Target] then
		initialProgress = math.min(playerData[objective.Target], objective.Amount)
	end

	local questState = {
		Active = true,
		Progress = initialProgress,
		Target = config.TargetAmount,
		Completed = initialProgress >= config.TargetAmount,
		Claimed = false,
	}

	DataService:UpdateData(player, "Quests", questState, questId)
	if questState.Completed and config.Entity.Lifecycle.AutoClaim then
		QuestService.ClaimQuest(player, questId)
	end
	return true
end

function QuestService.ClaimQuest(player: Player, questId: string): boolean
	local config = QuestData.Get(questId)
	if not config or not DataService then
		return false
	end

	local playerData = DataService:GetData(player)
	if not playerData or not playerData.Quests or not playerData.Quests[questId] then
		return false
	end

	local quest = playerData.Quests[questId]
	if not quest.Completed or quest.Claimed then
		return false
	end

	quest.Claimed = true
	quest.Active = false
	DataService:UpdateData(player, "Quests", quest, questId)

	for rewardName, amount in config.Rewards do
		if type(amount) == "number" and amount > 0 then
			DataService:AddData(player, rewardName, amount)
		end
	end

	return true
end

function QuestService.SetObjectiveProgress(player: Player, objectiveKind: string, target: string, amount: number)
	if not DataService then
		return
	end
	local playerData = DataService:GetData(player)
	if not playerData or not playerData.Quests then
		return
	end

	for _, config in QuestData.QueryObjective(objectiveKind, target) do
		local questId = config.Id
		local quest = playerData.Quests[questId]
		if quest and quest.Active and not quest.Claimed then
			local newProgress = math.min(amount, config.Entity.Objective.Amount)
			local completed = newProgress >= config.TargetAmount
			if quest.Progress ~= newProgress or quest.Completed ~= completed then
				quest.Progress = newProgress
				quest.Completed = completed
				DataService:UpdateData(player, "Quests", quest, questId)
				if completed and config.Entity.Lifecycle.AutoClaim then
					QuestService.ClaimQuest(player, questId)
				end
			end
		end
	end
end

function QuestService.UpdateProgress(player: Player, currencyName: string, amount: number)
	QuestService.SetObjectiveProgress(player, "Currency", currencyName, amount)
end

function QuestService.Init(services)
	DataService = services:GetService("DataService")
end

function QuestService.Start()
	if DataService then
		local subscribedCurrencies = {}
		for _, config in QuestData.QueryObjective("Currency") do
			local currencyName = config.Entity.Objective.Target
			if not subscribedCurrencies[currencyName] then
				subscribedCurrencies[currencyName] = true
				local capturedCurrency = currencyName
				DataService:GetChangedSignal(capturedCurrency):Connect(function(player, value)
					QuestService.SetObjectiveProgress(player, "Currency", capturedCurrency, value)
				end)
			end
		end

		local function acceptStarterQuests(player: Player)
			for _, config in QuestData.QueryLifecycle("AutoAccept") do
				QuestService.AcceptQuest(player, config.Id)
			end
		end

		for _, player in Players:GetPlayers() do
			task.spawn(acceptStarterQuests, player)
		end
		Players.PlayerAdded:Connect(function(player)
			task.spawn(acceptStarterQuests, player)
		end)
	end
end

return QuestService
]]></string>
          </Properties>
        </Item>
