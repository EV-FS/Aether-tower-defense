        <Item class="ModuleScript" referent="394">
          <Properties>
            <string name="Name">EventShopData</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local ItemData = require(ReplicatedStorage.Settings.Data.ItemData)
local RarityData = require(ReplicatedStorage.Settings.Data.RarityData)

export type Product = {
	Id: string,
	Title: string,
	Price: number,
	Image: string,
	RewardCategory: "Items" | "Skins",
	RewardName: string,
	RewardAmount: number,
	Unique: boolean?,
	LayoutOrder: number,
	Gradient: ColorSequence,
}

local function itemProduct(
	id: string,
	title: string,
	itemName: string,
	price: number,
	amount: number,
	layoutOrder: number
): Product
	local item = assert(ItemData.ByName[itemName], `Event shop item "{itemName}" is missing from ItemData`)
	return {
		Id = id,
		Title = title,
		Price = price,
		Image = item.ItemImage,
		RewardCategory = "Items",
		RewardName = itemName,
		RewardAmount = amount,
		LayoutOrder = layoutOrder,
		Gradient = RarityData.Get(item.Rarity).Presentation.Gradient,
	}
end

local products: { Product } = {
	itemProduct("IronBundle", "IRON x10", "Iron", 550, 10, 1),
	itemProduct("GoldBundle", "GOLD x5", "Gold", 2_000, 5, 2),
	itemProduct("DragonHeart", "DRAGON'S HEART", "Dragon's Heart", 4_500, 1, 3),
}

local EventShopData = {
	Products = products,
	ById = {} :: { [string]: Product },
}

for _, product in products do
	assert(EventShopData.ById[product.Id] == nil, `Duplicate event shop product id: {product.Id}`)
	EventShopData.ById[product.Id] = product
end

return TableUtils.DeepFreeze(EventShopData)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="395">
          <Properties>
            <string name="Name">ItemData</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local RarityData = require(ReplicatedStorage.Settings.Data.RarityData)

--/Types
export type ItemInfo = {
	Name: string,
	Index: number,
	Rarity: string,
	ItemImage: string,
	Description: string?,
}

export type ItemData = {
	ByName: { [string]: ItemInfo },
	ByIndex: { [number]: ItemInfo },
}

local ItemData = {
	ByName = {} :: { [string]: ItemInfo },
	ByIndex = {} :: { [number]: ItemInfo },
}

local itemFolder = script.Parent:FindFirstChild("Items")
assert(itemFolder and itemFolder:IsA("Folder"), "ItemData requires a Settings.Data.Items folder")

local itemModules = {}
for _, child in itemFolder:GetChildren() do
	if child:IsA("ModuleScript") then
		table.insert(itemModules, child)
	end
end
table.sort(itemModules, function(left, right)
	return left.Name < right.Name
end)

for _, itemModule in itemModules do
	local data = require(itemModule) :: ItemInfo
	local name = data.Name or itemModule.Name
	assert(ItemData.ByName[name] == nil, `Duplicate item name: {name}`)
	assert(ItemData.ByIndex[data.Index] == nil, `Duplicate item index: {data.Index}`)
	data.Name = name
	assert(RarityData.IsValid(data.Rarity), `Invalid rarity "{data.Rarity}" for item "{name}"`)
	ItemData.ByName[name] = data
	ItemData.ByIndex[data.Index] = data :: ItemInfo
end

return TableUtils.DeepFreeze(ItemData) :: ItemData
]]></string>
          </Properties>
        </Item>
