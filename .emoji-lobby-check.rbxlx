	end, container)

	local a = true
	local b = task.spawn(function()
		while a do
			isVisible(not isVisible())
			task.wait(if isVisible() then 1.5 else 0.5)
		end
	end)

	return function()
		a = false
		task.cancel(b)

		destroyVide()
		container:Destroy()
	end
