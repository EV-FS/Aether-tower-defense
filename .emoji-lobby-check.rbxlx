function SerdesFunctions.SummonService_ReadEVENT_BannerUpdated(): ({ NextRerollTime: number, Units: { { Rarity: string, Name: string, RateText: string } } })
	-- Read BLOCK: 6 bytes
	local BLOCK_START = Read(6)
	local Value = {} :: any
	Value.NextRerollTime = buffer.readu32(RecieveBuffer, BLOCK_START + 0)
	-- START ARRAY
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 4)
	if Length < 0 then error(`Expected "Length" to be larger than 0, got {Length} instead.`) end
	if Length > 65535 then error(`Expected "Length" to be smaller than 65535, got {Length} instead.`) end
	Value.Units = table.create(Length)
		-- Read BLOCK: 6 bytes
	local ARRAY_START_1 = Read(6 * Length)
	for Index = 1, Length do
		local Item_1 = {} :: any
		-- Read 2
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_0)
		Item_1.Rarity = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Read 2
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_1)
		Item_1.Name = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Read 2
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_2)
		Item_1.RateText = buffer.readstring(RecieveBuffer, Read(Length), Length)
		table.insert(Value.Units, Item_1)
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.SummonService_WriteFUNCTION_DATA_DoSummon(Value: number, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 3 bytes
	local BLOCK_START = Allocate(3)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 16)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	buffer.writeu8(SendBuffer, BLOCK_START + 2, Value)
end

function SerdesFunctions.SummonService_ReadFUNCTION_RETURN_DoSummon(): ({ Success: boolean, PulledUnits: { { UnitName: string, Rarity: string, Sold: boolean, SellPrice: number } } })
	-- Read BLOCK: 4 bytes
	local BLOCK_START = Read(4)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	local Value = {} :: any
	Value.Success = (buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1)
	-- START ARRAY
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 2)
	if Length < 0 then error(`Expected "Length" to be larger than 0, got {Length} instead.`) end
	if Length > 65535 then error(`Expected "Length" to be smaller than 65535, got {Length} instead.`) end
	Value.PulledUnits = table.create(Length)
		-- Read BLOCK: 9 bytes
	local ARRAY_START_1 = Read(9 * Length)
	for Index = 1, Length do
		local Item_1 = {} :: any
		-- Read 2
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_0)
		Item_1.UnitName = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Read 2
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_1)
		Item_1.Rarity = buffer.readstring(RecieveBuffer, Read(Length), Length)
		Item_1.Sold = (buffer.readu8(RecieveBuffer, ARRAY_START_1) == 1)
		ARRAY_START_1 += 1
		Item_1.SellPrice = buffer.readu32(RecieveBuffer, ARRAY_START_1)
		ARRAY_START_1 += 4
		table.insert(Value.PulledUnits, Item_1)
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.SummonService_WriteFUNCTION_DATA_GetBanner(Value: nil, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 2 bytes
