        <Item class="ModuleScript" referent="424">
          <Properties>
            <string name="Name">TraitData</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)

local entries = {
	{
		Name = "Fighter",
		Rarity = "Common",
		Chance = 44,
		Image = "rbxassetid://128095763141340",
		Description = "Damage increased by 5%",
		Effects = { { Handler = "DamageMultiflier", Value = 0.05 } },
	},
	{
		Name = "Eye",
		Rarity = "Common",
		Chance = 27.5,
		Image = "rbxassetid://86709310687030",
		Description = "Range increased by 7.5%",
		Effects = { { Handler = "RangeMultiflier", Value = 0.075 } },
	},
	{
		Name = "Speed",
		Rarity = "Rare",
		Chance = 17,
		Image = "rbxassetid://116920426143174",
		Description = "Cooldown reduced by 5%",
		Effects = { { Handler = "CooldownMultiflier", Value = 0.05 } },
	},
	{
		Name = "Crystal",
		Rarity = "Epic",
		Chance = 6.9,
		Image = "rbxassetid://121911060231688",
		Description = "Unit income increased by 10%",
		Effects = { { Handler = "IncomeMultiplier", Value = 0.10 } },
	},
	{
		Name = "Multi",
		Rarity = "Legendary",
		Chance = 3.5,
		Image = "rbxassetid://70438930373886",
		Description = "Summoned unit HP increased by 10%",
		Effects = { { Handler = "SummonHealthMultiplier", Value = 0.10 } },
	},
	{
		Name = "Hunter",
		Rarity = "Mythic",
		Chance = 0.8,
		Image = "rbxassetid://71987331447492",
		Description = "Damage and range increased by 15%",
		Effects = { { Handler = "DamageMultiflier", Value = 0.15 }, { Handler = "RangeMultiflier", Value = 0.15 } },
	},
	{
		Name = "Dragon",
		Rarity = "Absolute",
		Chance = 0.3,
		Image = "rbxassetid://82744947719375",
		Description = "Damage +30%, attack speed -15%, range +15%",
		Effects = {
			{ Handler = "DamageMultiflier", Value = 0.30 },
			{ Handler = "CooldownMultiflier", Value = 1 - 1 / 0.85 },
			{ Handler = "RangeMultiflier", Value = 0.15 },
		},
	},
}

local TraitData = { RollCost = 5, ByName = {}, ByIndex = entries }
local totalWeight = 0
for _, entry in entries do
	totalWeight += entry.Chance
end
assert(math.abs(totalWeight - 100) < 0.000001, "Trait probabilities must total 100%")
for index, entry in entries do
	entry.Index = index
	entry.Color = RarityRegistry.Get(entry.Rarity).Presentation.Color
	entry.Probability = entry.Chance / totalWeight * 100
	TraitData.ByName[entry.Name] = entry
end

-- Retired IDs are migrated at profile load; they are not available in the roll pool.
function TraitData.MigrateOwnedTowers(ownedTowers)
	local replacements = { Power = "Fighter", ["Ember Heart"] = "Hunter", Healing = "Dragon" }
	for _, towers in ownedTowers do
		for _, tower in towers do
			if type(tower) == "table" and replacements[tower.Trait] then
				tower.Trait = replacements[tower.Trait]
			end
		end
	end
end

return TableUtils.DeepFreeze(TraitData)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="425">
          <Properties>
            <string name="Name">UnitCatalog</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SummonConfig = require(ReplicatedStorage.Settings.Data.SummonConfig)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)

local DEFAULT_IMAGE = "rbxassetid://96421319964530"

local UnitCatalog = {}

function UnitCatalog.GetInfo(unitName: string)
	return TowerData.ByName[unitName]
end

function UnitCatalog.GetRarity(unitName: string): string
	local unitInfo = TowerData.ByName[unitName]
	if unitInfo and unitInfo.Rarity then
		return unitInfo.Rarity
	end

	return SummonConfig.LegacyUnitRarities[unitName] or "Unknown"
end

function UnitCatalog.GetImage(unitName: string): string
	if unitName == "" then
		return ""
	end

	local unitInfo = TowerData.ByName[unitName]
	if unitInfo and unitInfo.TowerImage and unitInfo.TowerImage ~= "" then
		return unitInfo.TowerImage
	end

	return SummonConfig.LegacyUnitImages[unitName] or DEFAULT_IMAGE
end

return table.freeze(UnitCatalog)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="426">
          <Properties>
            <string name="Name">UnitData</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

local RawUnitData = {
	["Knight Noob"] = {
		Index = 1,
		WalkSpeed = 3,
		MaxHealth = 400,
		Stats = {
			Damage = 50,
			Cooldown = 1,
			Range = 5,
			StopWhenAttacking = true,
			AttackDelay = 0.35,
			AttackType = "Single",
		},
	},
	["Archer Noob"] = {
		Index = 2,
		WalkSpeed = 3,
		MaxHealth = 400,
		Stats = {
			Damage = 200,
			Cooldown = 1.5,
			Range = 12,
			StopWhenAttacking = true,
			AttackDelay = 0.35,
			AttackType = "Single",
		},
	},
}

local UnitData = {
	ByName = RawUnitData,
	ByIndex = {},
}

for name, data in pairs(RawUnitData) do
	data.Name = name

	UnitData.ByIndex[data.Index] = data
end

return TableUtils.DeepFreeze(UnitData)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="427">
          <Properties>
            <string name="Name">UnitSellRewards</string>
            <string name="Source"><![CDATA[local CHANCES = table.freeze({
	Common = 0.005,
	Rare = 0.01,
	Epic = 0.04,
	Legendary = 0.20,
	Mythic = 1,
	Absolute = 1,
	Secret = 1,
})

local UnitSellRewards = {
	ItemName = "ShardStone",
	Chances = CHANCES,
}

function UnitSellRewards.Roll(rarity: string, random: Random): boolean
	local chance = CHANCES[rarity] or 0
	return chance >= 1 or (chance > 0 and random:NextNumber() < chance)
end

return table.freeze(UnitSellRewards)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="428">
          <Properties>
            <string name="Name">WaveData</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

-- Path omitted: normal enemies use every numbered route; bosses use route 1.
-- Fifth argument selects a single route, e.g. newEnemy("Goblin", 3, nil, false, "SpecialPath").
local function newEnemy(name: string, count: number?, delay: number?, isBoss: boolean?, path: (string | number)?)
	return {
		Name = name,
		Count = count,
		Delay = delay,
		IsBoss = isBoss,
		Path = path,
	}
end

