              <Item class="ModuleScript" referent="594">
                <Properties>
                  <string name="Name">spin</string>
                  <string name="Source"><![CDATA[local attr = require("../mod/attributes")
local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")

local spin = {}

function spin.emit(ref: Model, scope: types.scope)
  if utility.isSpinModelStatic(ref) then
    return
  end

  local rotation = attr.get(ref, "SpinRotation", vector.zero) * utility.DEG_TO_RAD

  local scaleStart = attr.get(ref, "Scale_Start", 1)
  local scaleEnd = attr.get(ref, "Scale_End", 1)

  local emitDelay = attr.get(ref, "EmitDelay", 0)
  local resetDelay = attr.get(ref, "ResetDelay", 0)
  local resetOnFinish = attr.get(ref, "ResetOnFinish", true)

  local sync = attr.get(ref, "SyncPosition", false)
  local duration = attr.get(ref, "SpinDuration", 0.5)

  local speedDuration = attr.get(ref, "SpinSpeed_Duration", 0.1)

  local speedStart = attr.get(ref, "SpinSpeed_Start", 0)
  local speedEnd = attr.get(ref, "SpinSpeed_End", 1)

  local currentSpeed = speedStart

  if emitDelay > 0 then utility.gameWait(emitDelay) end

  local speedTween

  if speedStart ~= speedEnd then
    speedTween = tween.fromParams(
      attr.get(ref, "SpinSpeed_Curve", utility.default_bezier),
      speedDuration,
      function(alpha, deltaTime)
        currentSpeed = utility.lerp(speedStart, speedEnd, alpha)
        return deltaTime
      end
    )

    table.insert(scope, speedTween)
  end

  local originalPivot = ref:GetPivot()
  local originalScale = ref:GetScale()

  if scaleStart ~= scaleEnd then
    table.insert(
      scope,
      tween.fromParams(attr.get(ref, "Scale_Curve", utility.default_bezier), duration, function(alpha, deltaTime)
        ref:ScaleTo(utility.lerp(scaleStart, scaleEnd, alpha))
        return deltaTime
      end)
    )
  else
    ref:ScaleTo(scaleStart)
  end

  local parent = ref:FindFirstAncestorOfClass("Attachment") or ref:FindFirstAncestorWhichIsA("BasePart")

  if resetOnFinish then
    table.insert(scope, function()
      ref:PivotTo(parent and utility.getTransformedOriginExtents(parent) or originalPivot)
      ref:ScaleTo(originalScale)
    end)
  end

  rotation *= duration

  tween.timer(duration + resetDelay, function(deltaTime, elapsed)
    local alpha = math.clamp(elapsed / duration, 0, 1)

    local r = rotation * alpha
    local cf = (if parent and sync then utility.getTransformedOriginExtents(parent) else originalPivot)
      * CFrame.fromOrientation(r.x, r.y, r.z)

    ref:PivotTo(cf)

    return if currentSpeed > 0 or (elapsed > 0 and speedTween.Connected) then deltaTime * currentSpeed else nil
  end, speedTween, scope, utility.RENDER_PRIORITY + scope.depth)
end

return spin
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="595">
                <Properties>
                  <string name="Name">tweener</string>
                  <string name="Source"><![CDATA[local attr = require("../mod/attributes")
local lerp = require("../mod/lerp")
local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")

local rng = Random.new()

local tweener = {}

function tweener.emit(obj: RayValue, scope: types.scope, isAttribute: boolean)
  local target = utility.getTarget(obj)

  if not target then
    return
  end

  local name = obj.Name

  local emitDelay = attr.get(obj, "EmitDelay", 0)
  local resetOnFinish = attr.get(obj, "ResetOnFinish", true)

  local durationRange = attr.getRange(obj, "Duration", NumberRange.new(1, 1), NumberRange.new(0, math.huge))

  if emitDelay > 0 then
    utility.gameWait(emitDelay)
  end

  local endValue = attr.get(obj, "_END_VALUE", nil)
  local overrideStartValue = attr.get(obj, "_START_VALUE", nil)

  local startValue

  if isAttribute then
    startValue = attr.get(target, name, nil)
  else
    local ok, val = pcall(function()
      return target[name]
    end)

    if not ok then
      return
    end

    startValue = val
  end

  if overrideStartValue then
    startValue = overrideStartValue
  end

  local typeName = typeof(startValue)

  if typeName ~= typeof(endValue) then
    return
  end

  local duration = rng:NextNumber(durationRange.Min, durationRange.Max)

  local speedStart = attr.get(obj, "Speed_Start", 1)
  local speedEnd = attr.get(obj, "Speed_End", 1)

  local currentSpeed = speedStart

  local speedTween

  if speedStart ~= speedEnd then
    speedTween = tween.fromParams(
      attr.get(obj, "Speed_Curve", utility.default_bezier),
      attr.get(obj, "Speed_Duration", 0.1),
      function(alpha, deltaTime)
        currentSpeed = utility.lerp(speedStart, speedEnd, alpha)
        return deltaTime
      end
    )

    table.insert(scope, speedTween)
  end

  local lfunc = lerp[typeName] or lerp.Other

  local animator = if isAttribute
    then function(alpha, deltaTime)
      attr.set(target, name, lfunc(startValue, endValue, alpha))
      return deltaTime * currentSpeed
    end
    else function(alpha, deltaTime)
      target[name] = lfunc(startValue, endValue, alpha)
      return deltaTime * currentSpeed
    end

  table.insert(
    scope,
    tween.fromParams(
      attr.get(obj, "Easing_Curve", utility.linear_bezier),
      duration,
      animator,
      speedTween,
      nil,
      nil,
      utility.RENDER_PRIORITY + scope.depth
    )
  )

  if resetOnFinish then
    table.insert(scope, function()
      if isAttribute then
        attr.set(target, name, startValue)
      else
        target[name] = startValue
      end
    end)
  end

  tween.timer(duration, function(deltaTime, elapsed)
    return if currentSpeed > 0 or (elapsed > 0 and speedTween and speedTween.Connected)
      then deltaTime * currentSpeed
      else nil
  end, speedTween, scope)
end

return tweener
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="596">
              <Properties>
                <string name="Name">emitters</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Beam = require("./effects/beam")
local Spin = require("./effects/spin")
local Mesh = require("./effects/mesh")
local Sound = require("./effects/sound")
local Bezier = require("./effects/bezier")
local Screen = require("./effects/screen")
local Particle = require("./effects/particle")
local Lightning = require("./effects/lightning")
local CameraShake = require("./effects/camera_shake")
local Tweener = require("./effects/tweener")
local Randomizer = require("./effects/randomizer")
local ShockwaveRing = require("./effects/shockwave_ring")
local ShockwaveLine = require("./effects/shockwave_line")
local ShockwaveDebris = require("./effects/shockwave_debris")

local Promise = require(ReplicatedStorage.Packages.Promise)

local attr = require("./mod/attributes")
local types = require("./types")
local utility = require("./mod/utility")

local emitters = {}

local function processRandomizers(obj: Instance, scope: types.scope)
	local r_prop = obj:QueryDescendants(`> RayValue.{utility.PROPERTY_RANDOMIZER_TAG}`)
	local r_attr = obj:QueryDescendants(`> RayValue.{utility.ATTRIBUTE_RANDOMIZER_TAG}`)

	-- allow emitting the randomizer directly
	if obj:IsA("RayValue") then
		if obj:HasTag(utility.PROPERTY_RANDOMIZER_TAG) then
			table.insert(r_prop, obj)
		elseif obj:HasTag(utility.ATTRIBUTE_RANDOMIZER_TAG) then
			table.insert(r_attr, obj)
		end
	end

	for _, obj in r_prop do
		utility.try(`failed to emit property randomizer with error: %s`, Randomizer.emit, obj, scope, false)
	end

	for _, obj in r_attr do
		utility.try(`failed to emit attribute randomizer with error: %s`, Randomizer.emit, obj, scope, true)
	end
end

function emitters.particle(
	obj: ParticleEmitter,
	scope: types.scope,
	sharedUncMap: { [Instance]: number },
	sharedRefMap: { [Instance]: Instance },
	legacyScale: number
)
	-- EmitModule compatibility: an unannotated emitter emits one particle.
	-- An explicit zero still disables the burst (EmitDuration may run alone).
	local count = attr.get(obj, "EmitCount", 1)
	local duration = attr.get(obj, "EmitDuration", 0, true)

	if not count or (count <= 0 and duration <= 0) then
		return
	end

	if not obj:IsDescendantOf(workspace) then
		local parent, ancestor = utility.cloneParticleAncestry(obj, sharedRefMap)

		if not parent then
			return
		end

		local clone = obj:Clone()
		clone.Archivable = false
		clone.Parent = parent

		if not sharedUncMap[ancestor] then
			ancestor.Parent = workspace.Terrain
			sharedUncMap[ancestor] = 1
		else
			sharedUncMap[ancestor] += 1
		end

		table.insert(scope, function()
			sharedUncMap[ancestor] -= 1

			if sharedUncMap[ancestor] <= 0 then
				ancestor:Destroy()
			end
		end)

		utility.try(`failed to emit particle with error: %s`, Particle.emit, obj, clone, scope, legacyScale)
	else
		utility.try(`failed to emit particle with error: %s`, Particle.emit, obj, obj, scope, legacyScale)
	end
end

function emitters.beam(obj: Beam, scope: types.scope, legacyScale: number)
	local att0, att1 = obj.Attachment0, obj.Attachment1

	if not att0 or not att1 then
		return
	end

	local clone = obj:Clone()
	clone.Archivable = false
	clone.Parent = workspace.Terrain

	-- clone attachments for beams with scaled length
	local unscaled = NumberRange.new(1, 1)

	if
		attr.get(obj, "Length_Scale_Start", unscaled, true) ~= unscaled
		or attr.get(obj, "Length_Scale_End", unscaled, true) ~= unscaled
	then
		local a, b = att0:Clone(), att1:Clone()

		table.insert(scope, a)
		table.insert(scope, b)

		a.Name = "_ForgeTempAttachment"
		b.Name = "_ForgeTempAttachment"

		a:AddTag(utility.EMIT_EXCLUDE_TAG)
		b:AddTag(utility.EMIT_EXCLUDE_TAG)

		clone.Attachment0 = a
		clone.Attachment1 = b

		a.Parent = att0.Parent
		b.Parent = att1.Parent
	end

	table.insert(scope, clone)

	utility.try(`failed to emit beam with error: %s`, Beam.emit, obj, clone, scope, legacyScale)
end

function emitters.trail(obj: Trail)
	obj.Enabled = true
end

function emitters.bezier(obj: Instance, scope: types.scope, skipEnabledCheck: boolean?)
	local part = obj:FindFirstChildOfClass("Part")

	if not part then
		return
	end

	if not skipEnabledCheck and obj:GetAttribute("Enabled") then
		obj:SetAttribute("Enabled", false)
	end

	local clone = part:Clone()
	clone.Locked = true

	table.insert(scope, clone)

	utility.try(`failed to emit bezier with error: %s`, Bezier.emit, obj, clone, scope, skipEnabledCheck)
end

function emitters.lightning(obj: Instance, scope: types.scope, skipEnabledCheck: boolean?)
	local part = obj:FindFirstChildOfClass("Part")

	if not part then
		return
	end

	if not skipEnabledCheck and obj:GetAttribute("Enabled") then
		obj:SetAttribute("Enabled", false)
	end

	local clone = part:Clone()
	clone.Locked = true

	table.insert(scope, clone)

	utility.try(`failed to emit lightning with error: %s`, Lightning.emit, obj, clone, scope, skipEnabledCheck)
end

function emitters.mesh(
	obj: Instance,
	scope: types.scope,
	shared_part_cache: any,
	legacyScale: number,
	skipEnabledCheck: boolean?
)
	local start = obj:FindFirstChild("Start")

	if not start then
		return
	end

	if not skipEnabledCheck and obj:GetAttribute("Enabled") then
		obj:SetAttribute("Enabled", false)
	end

	local tasks = {}
	local context = (scope :: any)._context

	local useEmitDuration = obj:HasTag(utility.ENABLED_VFX_TAG) and attr.get(obj, "EmitDuration", 0) > 0
	local emitCount = if useEmitDuration and not skipEnabledCheck then 1 else attr.get(obj, "EmitCount", 1)

	for i = 1, emitCount do
		local promise = Promise.new(function(resolve)
			utility.try(
				`failed to emit mesh with error: %s`,
				Mesh.emit,
				obj,
				utility.assembleMeshVFX(start, scope, shared_part_cache),
				scope,
				legacyScale,
				skipEnabledCheck
			)

			resolve()
		end)

		table.insert(tasks, promise)

		if context then
			table.insert(context._promises, promise)
		end
	end

	Promise.all(tasks):await()
end

function emitters.spin(obj: Model, scope: types.scope)
	if utility.lock(obj) then
		return
	end

	utility.try(`failed to emit spinning model with error: %s`, Spin.emit, obj, scope)
	utility.unlock(obj)
end

function emitters.camera_shake(obj: RayValue, scope: types.scope)
	utility.try(`failed to emit camera shake with error: %s`, CameraShake.emit, obj, scope)
end

function emitters.property_tweener(obj: RayValue, scope: types.scope)
	if not obj.Parent or utility.lock(obj) then
		return
	end

	utility.try(`failed to emit property tweener with error: %s`, Tweener.emit, obj, scope, false)
	utility.unlock(obj)
end

function emitters.attribute_tweener(obj: RayValue, scope: types.scope)
	if not obj.Parent or utility.lock(obj) then
		return
	end

	utility.try(`failed to emit attribute tweener with error: %s`, Tweener.emit, obj, scope, true)
	utility.unlock(obj)
end

function emitters.screen(obj: BasePart, scope: types.scope)
	local ok, result = utility.try(`failed to emit screen effect with error: %s`, Screen.emit, obj, scope)

	return if ok then result else false
end

function emitters.shockwave_ring(att: Attachment, obj: Part, scope: types.scope)
	utility.try(`failed to emit shockwave ring with error: %s`, ShockwaveRing.emit, att, obj, scope)
end

function emitters.shockwave_debris(att: Attachment, obj: Part, scope: types.scope)
	utility.try(`failed to emit shockwave debris with error: %s`, ShockwaveDebris.emit, att, obj, scope)
end

function emitters.shockwave_line(att: Attachment, obj: Part, scope: types.scope)
	utility.try(`failed to emit shockwave line with error: %s`, ShockwaveLine.emit, att, obj, scope)
end

function emitters.sound(obj: Sound, scope: types.scope)
	local emitCount = attr.get(obj, "EmitCount", 1, true)

	if emitCount <= 0 then
		return
	end

	utility.try(`failed to emit sound with error: %s`, Sound.emit, obj, scope)
end

-- Dispatch function to determine which emitter to use and call it
function emitters.dispatch(
	obj: any, -- since we don't use IsA(...), we don't get type narrowing
	scope: types.scope,
	sharedUncMap: { [Instance]: number },
	sharedRefMap: { [Instance]: Instance },
	shared_part_cache: any,
	legacyScale: number
)
	local className = obj.ClassName

	processRandomizers(obj, scope)

	if className == "ParticleEmitter" then
		emitters.particle(obj, scope, sharedUncMap, sharedRefMap, legacyScale)
		return
	elseif className == "Beam" then
		emitters.beam(obj, scope, legacyScale)
		return
	elseif className == "Trail" then
		emitters.trail(obj)
		return
	elseif className == "Sound" then
		emitters.sound(obj, scope)
		return
	elseif className == "RayValue" then
		if obj:HasTag(utility.SCREENSHAKE_TAG) then
			emitters.camera_shake(obj, scope)
		elseif obj:HasTag(utility.ATTRIBUTE_TWEENER_TAG) then
			emitters.attribute_tweener(obj, scope)
		elseif obj:HasTag(utility.PROPERTY_RANDOMIZER_TAG) or obj:HasTag(utility.ATTRIBUTE_RANDOMIZER_TAG) then
		-- skip randomizer effects because they have already been emitted
		else
			-- fall back to property tweens for backwards compatibility
			emitters.property_tweener(obj, scope)
		end

		return
	end

	if obj:HasTag(utility.BEZIER_TAG) then
		emitters.bezier(obj, scope)
		return
	end

	if obj:HasTag(utility.LIGHTNING_TAG) then
		emitters.lightning(obj, scope)
		return
	end

	if className == "Model" then
		if utility.isMeshVFX(obj) then
			emitters.mesh(obj, scope, shared_part_cache, legacyScale)
		else
			emitters.spin(obj, scope)
		end

		return
	end

	if className == "Part" then
		local att = utility.findFirstClassWithTag(obj, "Attachment", utility.SHOCKWAVE_TAG)

		if att then
			local name = obj.Parent and obj.Parent.Name or ""

			if name == "Rings" then
				emitters.shockwave_ring(att, obj, scope)
			elseif name == "Debris" then
				emitters.shockwave_debris(att, obj, scope)
			elseif name == "Lines" then
				emitters.shockwave_line(att, obj, scope)
			end
		end
	end
end

-- Registry for enabled effects (effects that emit continuously)
type EnabledEffectConfig = {
	check: (obj: Instance) -> boolean,
	emit: (obj: Instance, scope: types.scope, shared_part_cache: any) -> (),
}

emitters.enabled_registry = {
	mesh = {
		check = function(obj: Instance)
			return utility.isMeshVFX(obj)
		end,
		emit = function(obj: Instance, scope: types.scope, shared_part_cache: any)
			emitters.mesh(obj, scope, shared_part_cache, 1, true)
		end,
	},

	bezier = {
		check = function(obj: Instance)
			return obj:HasTag(utility.BEZIER_TAG)
		end,
		emit = function(obj: Instance, scope: types.scope, shared_part_cache: any)
			emitters.bezier(obj, scope, true)
		end,
	},

	lightning = {
		check = function(obj: Instance)
			return obj:HasTag(utility.LIGHTNING_TAG)
		end,
		emit = function(obj: Instance, scope: types.scope, shared_part_cache: any)
			emitters.lightning(obj, scope, true)
		end,
	},
} :: { [string]: EnabledEffectConfig }

return emitters
]]></string>
              </Properties>
            </Item>
            <Item class="Folder" referent="597">
              <Properties>
                <string name="Name">mod</string>
              </Properties>
              <Item class="ModuleScript" referent="598">
                <Properties>
                  <string name="Name">attributes</string>
                  <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local logger = require("./logger")

local IS_SERVER = RunService:IsServer()
local ATTR_CACHE_ID = "U"

type AttrCache = {
  [number]: {
    [string]: any,
  },
}

type AttrHooks = {
  [Instance]: {
    [string]: { (v: any) -> never },
  },
}

type RuntimeState = {
  [Instance]: {
    [string]: any,
  },
}

local Cache: AttrCache = {}
local Hooks: AttrHooks = {}
local State: RuntimeState = {}

local LastRefId = 0

local attr = {}

function attr.cache(obj: Instance)
  local prevId = obj:GetAttribute(ATTR_CACHE_ID)

  if prevId then
    logger.warn(`{obj} is already cached (id={prevId})`)
    return
  end

  local attributes = obj:GetAttributes()

  if next(attributes) == nil then
    return
  end

  LastRefId += 1

  local id = LastRefId
  local map = {}

  for k, v in attributes do
    if k == ATTR_CACHE_ID then
      continue
    end

    map[k] = v
    obj:SetAttribute(k, nil)
  end

  Cache[id] = map

  obj:SetAttribute(ATTR_CACHE_ID, id)
end

function attr.restore(obj: Instance)
  local id = obj:GetAttribute(ATTR_CACHE_ID)

  local cache = Cache[id]

  if not cache then
    logger.warn(`{obj} with cache id '{id}' doesn't have any cached attributes`)
    return
  end

  for k, v in cache do
    obj:SetAttribute(k, v)
  end

  obj:SetAttribute(ATTR_CACHE_ID, nil)
end

function attr.get<T>(obj: Instance, key: string, default: T, soft: boolean?, validate: ((v: unknown) -> T)?): T
  local id = obj:GetAttribute(ATTR_CACHE_ID)

  local cache = Cache[id]
  local value = cache and cache[key]

  if value ~= nil then
    return if validate then validate(value) else if value == nil then default else value
  end

  value = obj:GetAttribute(key)

  if validate then
    value = validate(value)
  elseif value == nil then
    value = default
  end

  if not soft and IS_SERVER then
    obj:SetAttribute(key, value)
  end

  return value
end

function attr.getRange(obj: Instance, key: string, default: NumberRange, clamp: NumberRange?, soft: boolean?)
  return attr.get(obj, key, default, soft, function(v)
    if typeof(v) ~= "NumberRange" then
      return default
    end

    if clamp then
      -- stylua: ignore
      return NumberRange.new(
        math.clamp(v.Min, clamp.Min, clamp.Max),
        math.clamp(v.Max, clamp.Min, clamp.Max)
      )
    end

    return v
  end)
end

function attr.getEnum<T>(obj: Instance, key: string, default: T, enums: { T }, soft: boolean?): T
  return attr.get(obj, key, default, soft, function(v)
    if v == nil or not table.find(enums, v) then
      return default
    end

    return v
  end)
end

function attr.set<T>(obj: Instance, key: string, value: T)
  local id = obj:GetAttribute(ATTR_CACHE_ID)

  local cache = Cache[id]

  if cache then
    cache[key] = value
  else
    obj:SetAttribute(key, value)
  end
end

function attr.isCached(obj: Instance): boolean
  return obj:GetAttribute(ATTR_CACHE_ID) ~= nil
end

function attr.getState<T>(obj: Instance, key: string, default: T): T
  local state = State[obj]
  local value = state and state[key]

  return if value ~= nil then value else default
end

function attr.setState<T>(obj: Instance, key: string, value: T)
  local state = State[obj]

  if not state then
    state = {}
    State[obj] = state
  end

  state[key] = value
end

function attr.clearState(obj: Instance)
  State[obj] = nil
end

function attr.trigger<T>(obj: Instance, key: string, value: T)
  local hooks = Hooks[obj]
  local callbacks = hooks and hooks[key]

  if not callbacks then
    return
  end

  for _, callback in callbacks do
    callback(value)
  end
end

function attr.hook<T>(obj: Instance, key: string, callback: (v: T) -> never)
  local hooks = Hooks[obj]

  if not hooks then
    hooks = {}
    Hooks[obj] = hooks
  end

  local callbacks = hooks[key]

  if not callbacks then
    callbacks = {}
    hooks[key] = callbacks
  end

  table.insert(callbacks, callback)

  local connection

  if not attr.isCached(obj) then
    connection = obj:GetAttributeChangedSignal(key):Connect(function()
      local value = obj:GetAttribute(key)
      callback(value)
    end)
  end

  return function()
    if connection then
      connection:Disconnect()
    end

    local index = table.find(callbacks, callback)

    if index then
      table.remove(callbacks, index)
    end

    if #callbacks == 0 then
      hooks[key] = nil
    end

    if next(hooks) == nil then
      Hooks[obj] = nil
    end
  end
end

return attr
]]></string>
