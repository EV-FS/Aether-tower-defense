					Thickness = 2,
					Transparency = ratesTransparency,
				}),

				create("TextLabel")({
					Name = "Title",
					BackgroundTransparency = 1,
					FontFace = DISPLAY_FONT,
					Position = UDim2.fromScale(0.09, 0.035),
					Size = UDim2.fromScale(0.82, 0.11),
					Text = "DROP RATES",
					TextColor3 = Color3.fromRGB(255, 244, 196),
					TextScaled = true,
					ZIndex = 22,

					create("UIStroke")({
