end

function SerdesFunctions.SummonService_ReadFUNCTION_RETURN_GetBanner(): ({ NextRerollTime: number, Units: { { Rarity: string, Name: string, RateText: string } } })
	-- Read BLOCK: 7 bytes
	local BLOCK_START = Read(7)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	local Value = {} :: any
	Value.NextRerollTime = buffer.readu32(RecieveBuffer, BLOCK_START + 1)
	-- START ARRAY
	local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 5)
	if Length < 0 then error(`Expected "Length" to be larger than 0, got {Length} instead.`) end
	if Length > 65535 then error(`Expected "Length" to be smaller than 65535, got {Length} instead.`) end
	Value.Units = table.create(Length)
		-- Read BLOCK: 6 bytes
	local ARRAY_START_1 = Read(6 * Length)
	for Index = 1, Length do
		local Item_1 = {} :: any
		-- Read 2
		local OPERATION_OFFSET_0 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_0)
		Item_1.Rarity = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Read 2
		local OPERATION_OFFSET_1 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_1)
		Item_1.Name = buffer.readstring(RecieveBuffer, Read(Length), Length)
		-- Read 2
		local OPERATION_OFFSET_2 = ARRAY_START_1
		ARRAY_START_1 += 2
		Length = buffer.readu16(RecieveBuffer, OPERATION_OFFSET_2)
		Item_1.RateText = buffer.readstring(RecieveBuffer, Read(Length), Length)
		table.insert(Value.Units, Item_1)
	end
	-- END ARRAY
	return Value
end

function SerdesFunctions.StoreService_ReadEVENT_BannerUpdated(): (any)
	RecieveInstanceCursor += 1
	local Value = RecieveInstances[RecieveInstanceCursor]
	return Value
end

function SerdesFunctions.LoadoutService_WriteFUNCTION_DATA_SetLoadout(Value: { requestType: ("Equip" | "Unequip" | "UnequipAll"), targetTower: { towerName: string, towerKey: number }? }, InvocationIdentifier: number): ()
	-- Allocate BLOCK: 4 bytes
	local BLOCK_START = Allocate(4)
	buffer.writeu8(SendBuffer, BLOCK_START + 0, 19)
	buffer.writeu8(SendBuffer, BLOCK_START + 1, InvocationIdentifier)
	if Value.requestType == "Equip" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 0)
	elseif Value.requestType == "Unequip" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 1)
	elseif Value.requestType == "UnequipAll" then
		buffer.writeu8(SendBuffer, BLOCK_START + 2, 2)
	else
		error(`Unexpected enum: {Value.requestType}, expected one of "Equip" or "Unequip" or "UnequipAll".`)
	end
	buffer.writeu8(SendBuffer, BLOCK_START + 3, Value.targetTower ~= nil and 1 or 0)
	if Value.targetTower ~= nil then
		-- Allocate BLOCK: 6 bytes
		local BLOCK_START = Allocate(6)
		local Length = #Value.targetTower.towerName
		buffer.writeu16(SendBuffer, BLOCK_START + 0, Length)
		Allocate(Length)
		buffer.writestring(SendBuffer, SendOffset, Value.targetTower.towerName, Length)
		buffer.writeu32(SendBuffer, BLOCK_START + 2, Value.targetTower.towerKey)
	end
end

function SerdesFunctions.LoadoutService_ReadFUNCTION_RETURN_SetLoadout(): (any)
	-- Read BLOCK: 1 bytes
	local BLOCK_START = Read(1)
	local Success = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Success ~= 1 then
		error("Server encountered an error.")
	end
	RecieveInstanceCursor += 1
	local Value = RecieveInstances[RecieveInstanceCursor]
	return Value
end

function SerdesFunctions.SettingsService_WriteFUNCTION_DATA_GetSettings(Value: string?, InvocationIdentifier: number): ()
