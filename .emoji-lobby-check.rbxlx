          <Item class="LocalScript" referent="712">
            <Properties>
              <string name="Name">DoubleJump</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local EmitModule = require(ReplicatedStorage.Shared.Modules.Utils.EmitModule)

local DEFAULT_JUMP_POWER = 50
local DOBULE_JUMP_MULTIFLIER = 1.2

local player = Players.LocalPlayer
local doubleJumpVFX = ReplicatedStorage:WaitForChild("DoubleJumpVFX") :: RemoteEvent
local humanoid = nil
local canDoubleJump = false
local hasDoubleJumped = false

EmitModule.init()

doubleJumpVFX.OnClientEvent:Connect(function(effect: Instance?)
	if not effect or not effect:IsDescendantOf(workspace) then
		warn("[DoubleJumpVFX] Replicated effect was not available on the client")
		return
	end

	local success, result = pcall(function()
		return EmitModule.emit(effect)
	end)
	if not success then
		warn(`[DoubleJumpVFX] EmitModule failed: {result}`)
	end
end)

local function setupCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	canDoubleJump = false
	hasDoubleJumped = false

	humanoid.StateChanged:Connect(function(_, newState)
		if newState == Enum.HumanoidStateType.Freefall then
			task.wait(0.1)
			canDoubleJump = true
		elseif newState == Enum.HumanoidStateType.Landed then
			canDoubleJump = false
			hasDoubleJumped = false
			humanoid.JumpPower = DEFAULT_JUMP_POWER
		end
	end)
end

setupCharacter(player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(setupCharacter)

UserInputService.JumpRequest:Connect(function()
	if player:GetAttribute("SummonControlsLocked") then
		return
	end

	if not humanoid or humanoid.Health <= 0 then
		return
	end

	if humanoid:GetState() ~= Enum.HumanoidStateType.Freefall or not canDoubleJump or hasDoubleJumped then
		return
	end

	hasDoubleJumped = true
	doubleJumpVFX:FireServer()
	humanoid.JumpPower = DEFAULT_JUMP_POWER * DOBULE_JUMP_MULTIFLIER
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end)
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="713">
            <Properties>
              <string name="Name">GroupReward</string>
              <string name="Source"><![CDATA[local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local Net = require(ReplicatedStorage.Shared.Net)
local NotificationService

local GROUP_ID = 492293332

local inProcessPlayer = {}

Net.GroupReward.SendPromptJoin.On(function()
	if inProcessPlayer[Players.LocalPlayer] then
		return
	end

	task.spawn(function()
		inProcessPlayer[Players.LocalPlayer] = true
		local success, result = pcall(function()
			return GroupService:PromptJoinAsync(GROUP_ID)
		end)

		if success then
			if result == Enum.GroupMembershipStatus.Joined then
				NotificationService = NotificationService or ServiceRegistry:GetService("NotificationService")
				NotificationService:Pull(
					Players.LocalPlayer,
					"Thanks for joining! Auto skip is now available.",
					"Normal"
				)
			end
		else
			warn("프롬프트 실패:", result)
		end
	end)
end)
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="714">
            <Properties>
              <string name="Name">HumanoidState</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local function setup(character: Model)
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
end

setup(Players.LocalPlayer.Character)

Players.PlayerAdded:Connect(function(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		setup(character)
	end)
end)
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="715">
            <Properties>
              <string name="Name">TimerClient</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")
local Net = require(ReplicatedStorage.Shared.Net)

local TimerTextLabel
local ShadowLabel

local function GetTimerLabels()
	local map = Workspace:FindFirstChild("MAP")
	local overheadPart = map and map:FindFirstChild("OverheadPart")
	local attachment = overheadPart and overheadPart:FindFirstChild("Attachment")
	local overheadUI = attachment and attachment:FindFirstChild("OverheadUI")
	local holderFrame = overheadUI and overheadUI:FindFirstChild("HolderFrame")
	local raidBossTimer = holderFrame and holderFrame:FindFirstChild("RaidBossTimer")

	TimerTextLabel = raidBossTimer and raidBossTimer:FindFirstChild("TimerText")
	ShadowLabel = raidBossTimer and raidBossTimer:FindFirstChild("Shadow")
end

GetTimerLabels()

local function UpdateTimer()
	local targetTime = ReplicatedStorage:GetAttribute("NextHourTimestamp")
	if not targetTime then 
		if TimerTextLabel then TimerTextLabel.Text = "--:--" end
		if ShadowLabel then ShadowLabel.Text = "--:--" end
		return 
	end

	local remaining = targetTime - os.time()
	if remaining < 0 then remaining = 0 end

	local minutes = math.floor(remaining / 60)
	local seconds = remaining % 60
	local formattedTime = string.format("%02d:%02d", minutes, seconds)
	
	if TimerTextLabel then TimerTextLabel.Text = formattedTime end
	if ShadowLabel then ShadowLabel.Text = formattedTime end
end

ReplicatedStorage:GetAttributeChangedSignal("NextHourTimestamp"):Connect(UpdateTimer)

Net.RaidService.RaidBossSpawned.On(function(data)
	local textChannels = TextChatService:WaitForChild("TextChannels", 10)
	local generalChannel = textChannels and textChannels:WaitForChild("RBXGeneral", 10)
	
	if generalChannel then
		generalChannel:DisplaySystemMessage(string.format("<font color='#FF4B4B'><b>[레이드]</b></font> 강력한 보스 <font color='#FFDF3A'><b>%s</b></font>가 곧 출현합니다! 준비하세요!", data.BossName))
	end
end)

UpdateTimer()

task.spawn(function()
	while true do
		UpdateTimer()
		task.wait(1)
	end
end)
]]></string>
            </Properties>
          </Item>
