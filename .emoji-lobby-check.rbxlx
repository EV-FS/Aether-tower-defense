          <Item class="ModuleScript" referent="373">
            <Properties>
              <string name="Name">DragonSlayer</string>
              <string name="Source"><![CDATA[-- The supplied LightingStyle, PrioritizeLightingQuality, and RBX_* migration
-- attributes are Studio/internal settings and cannot be changed by game scripts.
return {
	Properties = {
		Ambient = Color3.new(0.27450981736183167, 0.27450981736183167, 0.27450981736183167),
		Brightness = 3,
		ClockTime = 14.5,
		ColorShift_Bottom = Color3.new(0, 0, 0),
		ColorShift_Top = Color3.new(0, 0, 0),
		EnvironmentDiffuseScale = 1,
		EnvironmentSpecularScale = 1,
		ExposureCompensation = 0,
		FogColor = Color3.new(0.75294125080108643, 0.75294125080108643, 0.75294125080108643),
		FogEnd = 100000,
		FogStart = 0,
