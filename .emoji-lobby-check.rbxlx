local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local logger = require("@self/mod/logger")
local utility = require("@self/mod/utility")
local attributes = require("@self/mod/attributes")

local Sound = require("@self/effects/sound")
local Bezier = require("@self/effects/bezier")
local Lightning = require("@self/effects/lightning")
local CameraShake = require("@self/effects/camera_shake")
local ShockwaveRing = require("@self/effects/shockwave_ring")
local ShockwaveLine = require("@self/effects/shockwave_line")
local ShockwaveDebris = require("@self/effects/shockwave_debris")

local caches = require("@self/services/caches")
local effects = require("@self/services/effects")
local texture_loader = require("@self/services/texture_loader")
local enabled_effects = require("@self/services/enabled_effects")

local PluginContext = utility.PLUGIN_CONTEXT
local ServerContext = utility.SERVER_CONTEXT

type params = {
  TimeService: any?,
}

local api = {}

api.scope = {}
api.setup = false

function api.init(params: params?)
  if params and params.TimeService then
    utility.setTimeService(params.TimeService)
  end

  if api.setup then
    return
  end

  if ServerContext then
    task.spawn(function()
      local done = false
      local tries = 0

      local lastErr

      repeat
        tries += 1

        local ok, err = pcall(utility.setCollisionGroups, utility.COLLISION_GROUPS)

        done = ok
        lastErr = err

        if not done then
          task.wait(tries)
        end
      until done or tries >= 5

      if not done then
        logger.warn(
          `couldn't register necessary collision groups after {tries} tries with the last error being: {lastErr}`
        )
      end
    end)
  end

  api.setup = true

  if RunService:IsServer() and not PluginContext then
    return
  end

  api.caches = caches.init(api.scope)

  shared.vfx = api

  -- init services
  effects.init(api)

  texture_loader.init(api.scope)
  enabled_effects.init(api.scope, api.caches.shared_part, effects)

  -- init effects
  Sound.init()
  CameraShake.init()

  Bezier.init(api.caches.shared_part)
  Lightning.init(api.caches.shared_part)
  ShockwaveRing.init(api.caches.shared_part)
  ShockwaveLine.init(api.caches.shared_part)
  ShockwaveDebris.init(api.caches.shared_part)
end

function api.deinit()
  if not api.setup then
    return
  end

  api.setup = false

  shared.vfx = nil

  if RunService:IsServer() and not PluginContext then
    return
  end

  utility.cleanupScope(api.scope)

  effects.deinit()

  Sound.deinit()
  Bezier.deinit()
  Lightning.deinit()
  CameraShake.deinit()
  ShockwaveRing.deinit()
  ShockwaveLine.deinit()
  ShockwaveDebris.deinit()

  local cleanupObjects = CollectionService:GetTagged(utility.CLEANUP_TAG)

  for _, obj in cleanupObjects do
    obj:Destroy()
  end
end

local function fullEmit(scale: number, depth: number, ...: Instance)
  if not api.setup then
    logger.error("not initialized")
  end

  return effects.emitScaled(scale, depth, ...)
end

function api.emit(vfxOrScale: number | Instance, ...: Instance)
  if typeof(vfxOrScale) ~= "number" then
    return fullEmit(1, 0, vfxOrScale, ...)
  else
    return fullEmit(vfxOrScale, 0, ...)
  end
end

function api.emitWithDepth(depth: number, ...: Instance)
  return fullEmit(1, depth, ...)
end

function api.cacheAttributes(obj: Instance, shallow: boolean)
  if utility.SERVER_CONTEXT then
    logger.error("attributes can only be cached in a client-side context")
  end

  if not obj:IsDescendantOf(ReplicatedStorage) then
    logger.error("attributes can only be cached for VFX inside ReplicatedStorage")
  end

  attributes.cache(obj)

  if shallow then
    return
  end

  for _, v in obj:GetDescendants() do
    attributes.cache(v)
  end
end

function api.restoreAttributes(obj: Instance, shallow: boolean?)
  if utility.SERVER_CONTEXT then
    logger.error("attributes can only be restored in a client-side context")
  end

  attributes.restore(obj)

  if shallow then
    return
  end

  for _, v in obj:GetDescendants() do
    attributes.restore(v)
  end
end

local function setEnabled(obj: Instance, enabled: boolean)
  if obj:IsA("ParticleEmitter") then
    obj.Enabled = enabled
    return
  elseif obj:IsA("Beam") then
    obj.Enabled = enabled
    return
  end

  if attributes.isCached(obj) then
    attributes.trigger(obj, "Enabled", enabled)
  else
    obj:SetAttribute("Enabled", enabled)
  end
end

function api.enable(obj: Instance)
  setEnabled(obj, true)

  for _, v in obj:GetDescendants() do
    setEnabled(v, true)
  end
end

function api.disable(obj: Instance)
  setEnabled(obj, false)

  for _, v in obj:GetDescendants() do
    setEnabled(v, false)
  end
end

api.retime = require("@self/mod/retime").batch
api.resize = require("@self/mod/resize").batch
api.recolor = require("@self/mod/recolor")

return api
]]></string>
            </Properties>
            <Item class="Folder" referent="581">
              <Properties>
                <string name="Name">effects</string>
              </Properties>
              <Item class="ModuleScript" referent="582">
                <Properties>
                  <string name="Name">beam</string>
                  <string name="Source"><![CDATA[--!nolint LocalShadow
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local attr = require("../mod/attributes")
local tween = require("../mod/tween")
local types = require("../types")
local utility = require("../mod/utility")
local flipbook_common = require("../mod/common/flipbook")

local Promise = require(ReplicatedStorage.Packages.Promise)

local rng = Random.new()

local function getLegacyWidths(obj: Beam, scale: number)
	local w0 = attr.get(obj, "Width0", obj.Width0, true) * scale
	local w1 = attr.get(obj, "Width1", obj.Width1, true) * scale

	local s_w0 = attr.get(obj, "StartWidth0", obj.Width0, true) * scale
	local s_w1 = attr.get(obj, "StartWidth1", obj.Width1, true) * scale

	return w0, w1, s_w0, s_w1
end

local beam = {}

function beam.emit(ref: Beam, obj: Beam, scope: types.scope, scale: number)
	local emitOnFinish = scope.effects.prepareEmitOnFinish(obj, scope)

	local a1, a2, a3, a4 = getLegacyWidths(ref, scale)

	local w1 = attr.get(ref, "Width0_Start", a3)
	local w2 = attr.get(ref, "Width0_End", a1)
	local w3 = attr.get(ref, "Width1_Start", a4)
	local w4 = attr.get(ref, "Width1_End", a2)

	local c1 = attr.get(ref, "CurveSize0_Start", obj.CurveSize0)
	local c2 = attr.get(ref, "CurveSize0_End", obj.CurveSize0)
	local c3 = attr.get(ref, "CurveSize1_Start", obj.CurveSize1)
	local c4 = attr.get(ref, "CurveSize1_End", obj.CurveSize1)

	local emitDelay = attr.get(ref, "EmitDelay", 0)

	local legacy_duration = attr.get(ref, "Duration", 1, true)
	local legacy_tpScale = attr.get(ref, "EndTransparencyScale", 1, true)

	local durationRange = attr.getRange(
		ref,
		"EffectDuration",
		NumberRange.new(legacy_duration, legacy_duration),
		NumberRange.new(0, math.huge)
	)

	local lengthScaleRangeStart = attr.get(ref, "Length_Scale_Start", NumberRange.new(1, 1))
	local lengthScaleRangeEnd = attr.get(ref, "Length_Scale_End", NumberRange.new(1, 1))

	local texLengthStart = attr.get(ref, "Length_Texture_Start", ref.TextureLength)
	local textLengthEnd = attr.get(ref, "Length_Texture_End", ref.TextureLength)

	local duration = rng:NextNumber(durationRange.Min, durationRange.Max)

	local lengthScaleEnd = rng:NextNumber(lengthScaleRangeEnd.Min, lengthScaleRangeEnd.Max)
	local lengthScaleStart = rng:NextNumber(lengthScaleRangeStart.Min, lengthScaleRangeStart.Max)

	local tStart, tEnd =
		attr.get(ref, "Transparency_Scale_Start", 1), attr.get(ref, "Transparency_Scale_End", legacy_tpScale)

	local texSpeedStart = attr.get(ref, "Speed_Texture_Start", ref.TextureSpeed)
	local texSpeedEnd = attr.get(ref, "Speed_Texture_End", ref.TextureSpeed)

	local speedStart = attr.get(ref, "Speed_Start", 1)
	local speedEnd = attr.get(ref, "Speed_End", 1)

	local baseTexSpeed = obj.TextureSpeed

	if emitDelay > 0 then utility.gameWait(emitDelay) end

	obj.Enabled = true

	local promises = {}
	local currentSpeed = 1

	local speedTween

	local env = scope.effects.emitNested(obj, scope.depth + 1, scope)
	table.insert(promises, env.Finished)

	if texSpeedStart ~= texSpeedEnd then
		tween.fromParams(
			attr.get(ref, "Speed_Texture_Curve", utility.default_bezier),
			duration,
			function(alpha, deltaTime)
				baseTexSpeed = utility.lerp(texSpeedStart, texSpeedEnd, alpha)
				obj.TextureSpeed = baseTexSpeed * currentSpeed

				return deltaTime
			end
		)
	end

	if speedStart ~= speedEnd then
		speedTween = tween.fromParams(
			attr.get(ref, "Speed_Curve", utility.default_bezier),
			attr.get(obj, "Speed_Duration", 0.1),
			function(alpha, deltaTime)
				currentSpeed = utility.lerp(speedStart, speedEnd, alpha)

				obj.TextureSpeed = baseTexSpeed * currentSpeed

				return deltaTime
			end
		)

		table.insert(scope, speedTween)
	end

	local refTpKp = ref.Transparency.Keypoints

	local numKeypoints = #refTpKp
	local scaledKeypoints = table.create(numKeypoints)

	local keypointData = table.create(numKeypoints)

	for i, kp in refTpKp do
		keypointData[i] = {
			time = kp.Time,
			value = kp.Value,
			envelope = kp.Envelope,
		}
	end

	local lastTScale = nil

	local function setTScale(tscale: number)
		if lastTScale and math.abs(tscale - lastTScale) < 0.001 then
			return
		end

		lastTScale = tscale

		local offset = tscale > 1 and tscale - 1 or 1 - tscale

		for i, kd in keypointData do
			local value = kd.value
			local base = tscale > 1 and (1 - value) or -value

			scaledKeypoints[i] = NumberSequenceKeypoint.new(kd.time, value + base * offset, kd.envelope)
		end

		obj.Transparency = NumberSequence.new(scaledKeypoints)
	end

	local att0, att1 = obj.Attachment0, obj.Attachment1
	local cf0, cf1 = att0 and att0.CFrame, att1 and att1.CFrame

	local function setLengthScale(scale: number)
		if not cf0 or not cf1 then
			return
		end

		-- calculate the original offset vector from att0 to att1
		local offset = cf1.Position - cf0.Position
		local halfOffset = offset * 0.5

		-- calculate center point
		local center = cf0.Position + halfOffset

		-- scale the half-offsets and apply from center
		local scaledHalfOffset = halfOffset * scale

		att0.CFrame = CFrame.new(center - scaledHalfOffset) * (cf0 - cf0.Position)
		att1.CFrame = CFrame.new(center + scaledHalfOffset) * (cf1 - cf1.Position)
	end

	table.insert(scope, function()
		setLengthScale(1)
	end)

	if tStart ~= tEnd then
		table.insert(
			scope,
			tween.fromParams(
				attr.get(ref, "Transparency_Scale_Curve", utility.default_bezier),
				duration,
				function(alpha, deltaTime)
					setTScale(utility.lerp(tStart, tEnd, alpha))
					return deltaTime * currentSpeed
				end,
				speedTween
			)
		)
	elseif tStart ~= 1 then
		setTScale(tStart)
	end

	if texLengthStart ~= textLengthEnd then
		table.insert(
			scope,
			tween.fromParams(
				attr.get(ref, "Length_Texture_Curve", utility.default_bezier),
				duration,
				function(alpha, deltaTime)
					obj.TextureLength = utility.lerp(texLengthStart, textLengthEnd, alpha)
					return deltaTime * currentSpeed
				end,
				speedTween
			)
		)
	end

	if lengthScaleStart ~= lengthScaleEnd then
		table.insert(
			scope,
			tween.fromParams(
				attr.get(ref, "Length_Scale_Curve", utility.default_bezier),
				duration,
				function(alpha, deltaTime)
					local x = utility.lerp(lengthScaleStart, lengthScaleEnd, alpha)

					setLengthScale(x)

					return deltaTime * currentSpeed
				end,
				speedTween
			)
		)
	elseif texLengthStart ~= 1 then
		setLengthScale(lengthScaleStart)
	end

	if w1 ~= w2 then
		table.insert(
			scope,
			tween.fromParams(attr.get(ref, "Width0_Curve", utility.default_bezier), duration, function(alpha, deltaTime)
				obj.Width0 = utility.lerp(w1, w2, alpha)
				return deltaTime * currentSpeed
			end, speedTween)
		)
	else
		obj.Width0 = w1
	end

	if w3 ~= w4 then
		table.insert(
			scope,
			tween.fromParams(attr.get(ref, "Width1_Curve", utility.default_bezier), duration, function(alpha, deltaTime)
				obj.Width1 = utility.lerp(w3, w4, alpha)
				return deltaTime * currentSpeed
			end, speedTween)
		)
	else
		obj.Width1 = w3
	end

	if c1 ~= c2 then
		table.insert(
			scope,
			tween.fromParams(
				attr.get(ref, "CurveSize0_Curve", utility.default_bezier),
				duration,
				function(alpha, deltaTime)
					obj.CurveSize0 = utility.lerp(c1, c2, alpha)
					return deltaTime * currentSpeed
				end,
				speedTween
			)
		)
	else
		obj.Width0 = w1
	end

	if c3 ~= c4 then
		table.insert(
			scope,
			tween.fromParams(
				attr.get(ref, "CurveSize1_Curve", utility.default_bezier),
				duration,
				function(alpha, deltaTime)
					obj.CurveSize1 = utility.lerp(c3, c4, alpha)
					return deltaTime * currentSpeed
				end,
				speedTween
			)
		)
	else
		obj.Width1 = w3
	end

	-- flipbook support
	local flipbookDuration = 0
	local flipbook = flipbook_common.getFlipbookData(ref)

	if flipbook then
		local config = {
			ref = ref,
			frames = flipbook,
			speedTween = speedTween,
			effectDuration = duration,

			curve = attr.get(ref, "Flipbook_Change_Curve", utility.linear_bezier),
			duration = attr.get(ref, "Flipbook_Change_Duration", duration),

			getSpeed = function()
				return currentSpeed
			end,

			setTexture = function(texture)
				obj.Texture = texture
			end,
		}

		flipbookDuration = flipbook_common.getChangeDuration(config)

		table.insert(
			scope,
			tween.fromParams(config.curve, flipbookDuration, flipbook_common.createUpdateCallback(config), speedTween)
		)
	end

	tween.timer(math.max(duration, flipbookDuration), function(deltaTime, elapsed)
		return if currentSpeed > 0 or (elapsed > 0 and speedTween and speedTween.Connected)
			then deltaTime * currentSpeed
			else nil
	end, speedTween, scope)

	if emitOnFinish then
		local env = scope.effects.emitOnFinish(emitOnFinish, obj.Parent or workspace.Terrain, scope.depth + 1, scope)
		table.insert(promises, env.Finished)
	end

	Promise.all(promises):await()
end

return beam
]]></string>
                </Properties>
