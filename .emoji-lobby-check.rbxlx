          <Item class="ModuleScript" referent="502">
            <Properties>
              <string name="Name">InstanceCache</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local ObjectCache = require(ReplicatedStorage.Packages.ObjectCache)

-------------------------------------------------
--// InstanceCache
-------------------------------------------------
local InstanceCache = {}
InstanceCache.__index = InstanceCache

local FAR_AWAY_CFRAME = CFrame.new(2 ^ 24, 2 ^ 24, 2 ^ 24)

local function getObjectPart(inst: Instance): BasePart?
	return if inst:IsA("BasePart") then inst else nil
end

local function createInstance(template: Instance, folder: Instance): Instance
	local newInst = template:Clone()
	if newInst:IsA("Model") then
		newInst:PivotTo(FAR_AWAY_CFRAME)
	end
	newInst.Parent = folder
	return newInst
end

function InstanceCache:ExpandCache(amount: number?)
	local expandAmount = amount or self.PoolSize

	if self.ObjectCache then
		-- ObjectCache 1.4.6 removes one object from its free list while expanding.
		-- Capture that object through its internal helper and return it immediately.
		local objectPart = self.ObjectCache:_GetNew(expandAmount, false)
		if objectPart then
			self.ObjectCache:ReturnPart(objectPart)
		end
		return
	end

	for _ = 1, expandAmount do
		table.insert(self.Available, createInstance(self.Template, self.Folder))
	end
end

function InstanceCache:GetInstance(cframe: CFrame?): Instance
	if self.ObjectCache then
		local objectPart = self.ObjectCache:GetPart(cframe)
		self.InUse[objectPart] = true
		return objectPart
	end

	if #self.Available == 0 then
		warn("InstanceCache: cache exhausted; expanding")
		self:ExpandCache(math.ceil(self.PoolSize * 0.5))
	end

	local inst = table.remove(self.Available)
	if not inst or inst.Parent == nil then
		inst = createInstance(self.Template, self.Folder)
	end
	self.InUse[inst] = true
	if cframe and inst:IsA("Model") then
		inst:PivotTo(cframe)
	end

	return inst
end

function InstanceCache:ReturnInstance(inst: Instance)
	if self.ObjectCache then
		local objectPart = getObjectPart(inst)
		if not objectPart or not self.InUse[objectPart] then
			warn(`InstanceCache: {inst:GetFullName()} is not in use by this spatial cache`)
			return
		end

		self.InUse[objectPart] = nil
		self.ObjectCache:ReturnPart(objectPart)
		return
	end

	if not self.InUse[inst] then
		warn("InstanceCache: tried to return an instance that is not in use")
		return
	end

	self.InUse[inst] = nil

	local success = pcall(function()
		if inst:IsA("Model") then
			inst:PivotTo(FAR_AWAY_CFRAME)
		end
		inst.Parent = self.Folder
	end)

	if not success then
		table.insert(self.Available, createInstance(self.Template, self.Folder))
		return
	end

	if inst:IsA("AudioPlayer") then
		inst:Stop()
	elseif inst:IsA("GuiObject") then
		inst.Visible = false
	end

	table.insert(self.Available, inst)
end

function InstanceCache:IsInUse(inst: Instance): boolean
	if self.ObjectCache then
		local objectPart = getObjectPart(inst)
		return objectPart ~= nil and self.InUse[objectPart] == true
	end

	return self.InUse[inst] == true
end

function InstanceCache:Destroy()
	if self.ObjectCache then
		self.ObjectCache:Destroy()
		table.clear(self.InUse)
		return
	end

	for _, inst in self.Available do
		inst:Destroy()
	end
	for inst in self.InUse do
		inst:Destroy()
	end

	table.clear(self.Available)
	table.clear(self.InUse)
end

function InstanceCache.new(inst: Instance, cacheSize: number?, cachesFolder: Instance)
	local self = setmetatable({}, InstanceCache)

	self.Template = inst
	self.PoolSize = cacheSize or 10
	self.Folder = cachesFolder
	self.ObjectCache = nil

	self.Available = {}
	self.InUse = {}

	if inst:IsA("BasePart") then
		self.ObjectCache = ObjectCache.new(inst, self.PoolSize, cachesFolder)
		return self
	end

	self:ExpandCache(self.PoolSize)

	return self
end

return InstanceCache
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="503">
            <Properties>
              <string name="Name">MatchProtocol</string>
              <string name="Source"><![CDATA[--!strict
-- One wire contract for lobby UI, party management, and game-place admission.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapData = require(ReplicatedStorage.Settings.Data.MapData)
local WaveData = require(ReplicatedStorage.Settings.Data.WaveData)
local Config = require(ReplicatedStorage.Settings.Game.PartySettings)

export type Settings = { Map: string, Difficulty: string }
export type SettingsPatch = { Map: string?, Difficulty: string? }
export type ErrorCode =
	"OK"
	| "INVALID_ARGUMENT"
	| "INVALID_SETTINGS"
	| "INVALID_MAP"
	| "INVALID_DIFFICULTY"
	| "MAP_UNAVAILABLE"
	| "INVALID_TELEPORT_DATA"
	| "INVALID_PLAYER"
	| "ALREADY_IN_PARTY"
	| "NOT_IN_PARTY"
	| "PARTY_NOT_FOUND"
	| "PARTY_FULL"
	| "PARTY_TOO_SMALL"
	| "NOT_LEADER"
	| "MEMBER_NOT_FOUND"
	| "CANNOT_KICK_SELF"
	| "PARTY_BUSY"
	| "RATE_LIMITED"
	| "INTERNAL_ERROR"
	| "NETWORK_ERROR"
	| "REQUEST_TIMEOUT"
	| "NOT_READY"
	| "DESTINATION_NOT_CONFIGURED"
	| "STUDIO_TELEPORT_UNAVAILABLE"
	| "ALREADY_IN_MATCH"
	| "MATCH_NOT_FOUND"
	| "MATCH_BUSY"
	| "MATCH_EXPIRED"
	| "NO_MEMBERS"
	| "RESERVATION_FAILED"
	| "TELEPORT_FAILED"
	| "TELEPORT_PARTIAL"
	| "TELEPORT_TIMEOUT"

export type Result<T> = { Success: boolean, Code: ErrorCode, Data: T?, Sequence: number? }
export type PartyState = "Open" | "Starting" | "Teleporting" | "Retryable"
export type Member = { UserId: number, Name: string, DisplayName: string }
export type PartySnapshot = {
	Id: string,
	LeaderUserId: number,
	Members: { Member },
	Settings: Settings,
	State: PartyState,
	MaxMembers: number,
	Revision: number,
	MatchId: string?,
	ErrorCode: ErrorCode?,
}
export type PartyEvent = {
	Kind: "Created" | "Updated" | "Removed" | "Disbanded" | "Teleporting",
	PartyId: string,
	Party: PartySnapshot?,
	Reason: string?,
	Sequence: number,
}
export type TeleportData = {
	Version: number,
	MatchId: string,
	Map: string,
	Difficulty: string,
	MemberCount: number,
	AttemptId: number?, -- Transport correlation only; never changes match identity.
}
export type MatchRequest = { Members: { Player }, Settings: Settings }

local MatchProtocol = {}

function MatchProtocol.Success<T>(data: T?): Result<T>
	return { Success = true, Code = "OK", Data = data }
end

function MatchProtocol.Failure(code: ErrorCode): Result<any>
	return { Success = false, Code = code }
end

function MatchProtocol.ValidateSettings(value: any): (Settings?, ErrorCode?)
	if type(value) ~= "table" then
		return nil, "INVALID_ARGUMENT"
	end
	if type(value.Map) ~= "string" or #value.Map > 100 or not MapData[value.Map] then
		return nil, "INVALID_MAP"
	end
	local definition = MapData[value.Map]
	if type(value.Difficulty) ~= "string" or not table.find(definition.Difficulties, value.Difficulty) then
		return nil, "INVALID_DIFFICULTY"
	end
	local difficulty: MapData.Difficulty = value.Difficulty :: MapData.Difficulty
	local waves = definition.DifficultyWaves[difficulty]
	if type(waves) ~= "number" or waves < 1 or waves % 1 ~= 0 or not definition.Rewards[difficulty] then
		return nil, "MAP_UNAVAILABLE"
	end
	return { Map = value.Map, Difficulty = value.Difficulty }, nil
end

-- A selectable map can be unfinished. Do not send players to a round that cannot finish.
function MatchProtocol.ValidateStartSettings(value: any): (Settings?, ErrorCode?)
	local settings, code = MatchProtocol.ValidateSettings(value)
	if not settings then
		return nil, code :: ErrorCode?
	end
	local waves = WaveData[settings.Map]
	if type(waves) ~= "table" then
		return nil, "MAP_UNAVAILABLE"
	end
	for index = 1, MapData[settings.Map].DifficultyWaves[settings.Difficulty :: MapData.Difficulty] do
		if type(waves[index]) ~= "table" or #waves[index] == 0 then
			return nil, "MAP_UNAVAILABLE"
		end
	end
	return settings, nil
end

function MatchProtocol.CreateTeleportData(matchId: string, settings: Settings, memberCount: number): TeleportData
	return {
		Version = 1,
		MatchId = matchId,
		Map = settings.Map,
		Difficulty = settings.Difficulty,
		MemberCount = memberCount,
	}
end

function MatchProtocol.ValidateTeleportData(value: any): (TeleportData?, ErrorCode?)
	if
		type(value) ~= "table"
		or value.Version ~= 1
		or type(value.MatchId) ~= "string"
		or #value.MatchId ~= 36
		or not string.match(value.MatchId, "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$")
		or type(value.MemberCount) ~= "number"
		or value.MemberCount % 1 ~= 0
		or value.MemberCount < 1
		or value.MemberCount > Config.MaxMembers
	then
		return nil, "INVALID_TELEPORT_DATA"
	end
	if
		value.AttemptId ~= nil
		and (type(value.AttemptId) ~= "number" or value.AttemptId < 1 or value.AttemptId % 1 ~= 0)
	then
		return nil, "INVALID_TELEPORT_DATA"
	end
	local settings, code = MatchProtocol.ValidateStartSettings(value)
	if not settings then
		return nil, code :: ErrorCode?
	end
	local data = MatchProtocol.CreateTeleportData(value.MatchId, settings, value.MemberCount)
	data.AttemptId = value.AttemptId
	return data, nil
end

return table.freeze(MatchProtocol)
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="504">
            <Properties>
              <string name="Name">Rarity</string>
            </Properties>
            <Item class="ModuleScript" referent="505">
              <Properties>
                <string name="Name">RarityRegistry</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

export type RarityName = "Common" | "Rare" | "Epic" | "Legendary" | "Mythic" | "Absolute" | "Secret"

export type RarityEntity = {
	Identity: {
		Name: RarityName,
		DisplayName: string,
	},
	Progression: {
		Order: number,
		Power: number,
	},
	Presentation: {
		Color: Color3,
		Gradient: ColorSequence,
		Glow: Color3,
		ShimmerSpeed: number,
	},
}

local PresentationData = {
	Common = {
		Color = Color3.new(1, 1, 1),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(177, 158, 158)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 228, 228)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(177, 158, 158)),
		}),
		Glow = Color3.fromRGB(180, 180, 180),
		ShimmerSpeed = 1,
	},
	Rare = {
		Color = Color3.new(0, 1, 1),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(53, 76, 231)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(58, 212, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(53, 76, 231)),
		}),
		Glow = Color3.fromRGB(70, 120, 255),
		ShimmerSpeed = 1.5,
	},
	Epic = {
		Color = Color3.new(0.5, 0, 1),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(131, 0, 131)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 99, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(131, 0, 131)),
		}),
		Glow = Color3.fromRGB(210, 80, 255),
		ShimmerSpeed = 1.5,
	},
	Legendary = {
		Color = Color3.new(1, 1, 0),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(226, 88, 46)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 30)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(226, 88, 46)),
		}),
		Glow = Color3.fromRGB(255, 190, 70),
		ShimmerSpeed = 1.5,
	},
	Mythic = {
		Color = Color3.new(1, 0, 0),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(202, 0, 7)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 0, 234)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(218, 0, 4)),
		}),
		Glow = Color3.fromRGB(255, 60, 60),
		ShimmerSpeed = 1.5,
	},
	Absolute = {
		Color = Color3.new(0.15, 0.15, 1),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(239, 189, 255)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(185, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(239, 189, 255)),
		}),
		Glow = Color3.fromRGB(83, 46, 250),
		ShimmerSpeed = 1.25,
	},
	Secret = {
		Color = Color3.fromRGB(126, 0, 4),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(107, 0, 4)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 0, 8)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(107, 0, 4)),
		}),
		Glow = Color3.fromRGB(62, 0, 2),
		ShimmerSpeed = 1.5,
	},
	Coins = {
		Color = Color3.new(1, 0.65, 0),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 249, 140)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 128, 0)),
		}),
		Glow = Color3.new(1, 0.65, 0),
		ShimmerSpeed = 1.5,
	},
	Gems = {
		Color = Color3.fromRGB(0, 187, 255),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 187, 255)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(185, 227, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(153, 0, 255)),
		}),
		Glow = Color3.fromRGB(0, 187, 255),
		ShimmerSpeed = 1.5,
	},
	Exp = {
		Color = Color3.fromRGB(144, 255, 242),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(102, 255, 224)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(21, 150, 255)),
		}),
		Glow = Color3.fromRGB(144, 255, 242),
		ShimmerSpeed = 1.5,
	},
	Blossom = {
		Color = Color3.fromRGB(239, 181, 255),
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 112, 248)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(239, 181, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(243, 79, 255)),
		}),
		Glow = Color3.fromRGB(239, 181, 255),
		ShimmerSpeed = 1.5,
	},
}

-- Canonical progression order. All rarity-driven systems should derive their
-- low-to-high presentation from this list instead of declaring another order.
local ProgressionOrder = {
	"Common",
	"Rare",
	"Epic",
	"Legendary",
	"Mythic",
	"Absolute",
	"Secret",
	"Coins",
	"Gems",
	"Exp",
	"Blossom",
}

local ProgressionData = {}
for power, rarity in ProgressionOrder do
	ProgressionData[rarity] = {
		-- Existing card sorting displays the strongest rarity first.
		Order = #ProgressionOrder - power + 1,
		Power = power,
	}
end

local Definitions: { [string]: RarityEntity } = {}
for rarity, progression in ProgressionData do
	Definitions[rarity] = {
		Identity = { Name = rarity :: RarityName, DisplayName = rarity },
		Progression = progression,
		Presentation = PresentationData[rarity],
	}
end

local DisplayNames = {}
for rarity, entity in Definitions do
	DisplayNames[rarity] = entity.Identity.DisplayName
end

local DisplayOrder = table.create(#ProgressionOrder)
for index = #ProgressionOrder, 1, -1 do
	table.insert(DisplayOrder, ProgressionOrder[index])
end

local RarityRegistry = {}

function RarityRegistry.Get(rarity: string): RarityEntity
	return Definitions[rarity] or Definitions["Common"]
end

function RarityRegistry.IsValid(rarity: string): boolean
	return Definitions[rarity :: RarityName] ~= nil
end

function RarityRegistry.GetOrder(rarity: string): number
	return RarityRegistry.Get(rarity).Progression.Order
end

function RarityRegistry.GetDisplayName(rarity: string): string
	return RarityRegistry.Get(rarity).Identity.DisplayName
end

function RarityRegistry.Compare(left: string, right: string): boolean
	return RarityRegistry.GetOrder(left) < RarityRegistry.GetOrder(right)
end

function RarityRegistry.Sort(values: { string }): { string }
	local sorted = table.clone(values)
	table.sort(sorted, RarityRegistry.Compare)
	return sorted
end

RarityRegistry.DisplayNames = DisplayNames
RarityRegistry.Entities = Definitions
RarityRegistry.ProgressionOrder = ProgressionOrder
RarityRegistry.DisplayOrder = DisplayOrder

return TableUtils.DeepFreeze(RarityRegistry)
]]></string>
              </Properties>
