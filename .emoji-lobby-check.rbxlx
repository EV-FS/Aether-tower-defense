        <Item class="ModuleScript" referent="406">
          <Properties>
            <string name="Name">MapData</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

--/Types
export type Difficulty = "Normal" | "Hard" | "Eternal"

export type RewardDetail = {
	WinCoins: number,
	WinExp: number,
	WinGems: number,
	LoseCoinsPerWave: number,
	LoseExpPerWave: number,
}

export type MapInfo = {
	MapImage: string,
	IntroCutscene: string?,
	Difficulties: { Difficulty },
	DifficultyWaves: { [Difficulty]: number },
	Rewards: { [Difficulty]: RewardDetail },
}

