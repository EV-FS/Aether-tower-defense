      <Item class="Folder" referent="649">
        <Properties>
          <string name="Name">Scripts</string>
        </Properties>
        <Item class="Script" referent="650">
          <Properties>
            <string name="Name">AFKTeleport</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local TeleportService = game:GetService("TeleportService")

local Config = require(ReplicatedStorage.Settings.Game.AFKSettings)
local DataService = require(ServerScriptService.Server.Services.DataService)

local function getOrCreateRequestEvent(): RemoteEvent
	local existing = ReplicatedStorage:FindFirstChild("RequestAFKTeleport")
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end

	if existing then
		existing:Destroy()
	end

	local event = Instance.new("RemoteEvent")
	event.Name = "RequestAFKTeleport"
	event.Parent = ReplicatedStorage
	return event
end

local requestEvent = getOrCreateRequestEvent()

type TeleportState = {
	Attempts: number,
	RetryQueued: boolean,
}

local pending: { [Player]: TeleportState } = {}
local lastRequest: { [Player]: number } = {}

local attemptTeleport: (Player) -> ()

local function queueRetry(player: Player, state: TeleportState)
	if pending[player] ~= state or state.RetryQueued then
		return
	end

	if state.Attempts >= Config.TeleportRetryCount then
		pending[player] = nil
		return
	end

	state.RetryQueued = true
	task.delay(Config.TeleportRetryDelay, function()
		if pending[player] ~= state then
			return
		end

		state.RetryQueued = false
		attemptTeleport(player)
	end)
end

attemptTeleport = function(player: Player)
	local state = pending[player]
	if not state or not player:IsDescendantOf(Players) then
		pending[player] = nil
		return
	end

	state.Attempts += 1
	local playerData = DataService:GetData(player)
	DataService:SaveData(player)
	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({
		ReturnPlaceId = Config.LobbyPlaceId,
		HandoffVersion = 1,
		CoinsSnapshot = if playerData then playerData.Coins else nil,
		GemsSnapshot = if playerData then playerData.Gems else nil,
	})

	local success, err = pcall(function()
		TeleportService:TeleportAsync(Config.AFKPlaceId, { player }, options)
	end)
	if success then
		return
	end

	warn(`[AFK] Teleport attempt {state.Attempts} failed for {player.Name}: {err}`)
	queueRetry(player, state)
end

local function requestTeleport(player: Player)
	if pending[player] then
		return
	end

	local now = os.clock()
	if now - (lastRequest[player] or -math.huge) < Config.RequestCooldown then
		return
	end

	lastRequest[player] = now
	if RunService:IsStudio() then
		warn(`[AFK] {player.Name}: AFK 이동 요청 확인. 실제 이동은 게시된 게임에서 가능합니다.`)
		return
	end
	pending[player] = { Attempts = 0, RetryQueued = false }
	attemptTeleport(player)
end

requestEvent.OnServerEvent:Connect(requestTeleport)

-- Resolve the exact map target when triggered, including prompts under Attachments.
-- This also supports the part/prompt being inserted after this script starts.
ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
	local folder = workspace:FindFirstChild("ProximityPrompts")
	local part = folder and folder:FindFirstChild("Part")
	if not part or not part:IsA("BasePart") or not prompt:IsDescendantOf(part) or not prompt.Enabled then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
		return
	end

	local parent = prompt.Parent
	local position = if parent and parent:IsA("Attachment") then parent.WorldPosition
		elseif parent and parent:IsA("BasePart") then parent.Position else part.Position
	if (root.Position - position).Magnitude > prompt.MaxActivationDistance + 3 then
		return
	end
	requestTeleport(player)
end)

TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage, placeId)
	local state = pending[player]
	if not state or placeId ~= Config.AFKPlaceId then
		return
	end

	warn(`[AFK] Teleport initialization failed for {player.Name}: {result.Name} ({errorMessage})`)
	queueRetry(player, state)
end)

Players.PlayerRemoving:Connect(function(player)
	pending[player] = nil
	lastRequest[player] = nil
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="651">
          <Properties>
            <string name="Name">DoubleJumpVFX</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local remote = ReplicatedStorage:FindFirstChild("DoubleJumpVFX") or Instance.new("RemoteEvent")
remote.Name = "DoubleJumpVFX"
remote.Parent = ReplicatedStorage
local lastPlayed: { [Player]: number } = {}

local function playEffect(player: Player)
	local now = os.clock()
	if now - (lastPlayed[player] or 0) < 0.15 then
		return
	end
	lastPlayed[player] = now

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local effect = ServerStorage:FindFirstChild("Jump", true)
	if not character or not rootPart or not rootPart:IsA("BasePart") or not humanoid then
		warn(`[DoubleJumpVFX] Character was not ready for {player.Name}`)
		return
	end
	if not effect then
		warn("[DoubleJumpVFX] Missing ServerStorage descendant named Jump")
		return
	end

	local clone = effect:Clone()
	local effectPart: BasePart?
	local offset = CFrame.new(0, -humanoid.HipHeight - 1.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
	if clone:IsA("BasePart") then
		effectPart = clone
		clone.CFrame = rootPart.CFrame * offset
	elseif clone:IsA("Model") then
		effectPart = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
		if not effectPart then
			clone:Destroy()
			return
		end
		clone:PivotTo(rootPart.CFrame * offset)
	else
		warn(`[DoubleJumpVFX] Jump must be a BasePart or Model, got {clone.ClassName}`)
		clone:Destroy()
		return
	end

	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.Massless = true
			descendant.CanCollide = false
			descendant.CanTouch = false

			local weld = Instance.new("WeldConstraint")
			weld.Part0 = rootPart
			weld.Part1 = descendant
			weld.Parent = descendant
		end
	end
	if clone:IsA("BasePart") then
		clone.Anchored = false
		clone.Massless = true
		clone.CanCollide = false
		clone.CanTouch = false

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = rootPart
		weld.Part1 = clone
		weld.Parent = clone
	end
	clone.Parent = workspace

	-- Give the effect instance one replication frame before sending its reference.
	-- ForgeVFX must run on each client because camera effects and its local caches
	-- are intentionally unavailable in the server context.
	RunService.Heartbeat:Wait()
	remote:FireAllClients(clone)
	Debris:AddItem(clone, 5)
end

remote.OnServerEvent:Connect(playEffect)
Players.PlayerRemoving:Connect(function(player)
	lastPlayed[player] = nil
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="652">
          <Properties>
            <string name="Name">GroupReward</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local TouchZone = require(ReplicatedStorage.Shared.Modules.Utils.TouchZone)
local Net = require(ReplicatedStorage.Shared.Net)
local NotificationService

local touchZoneFolder = workspace:WaitForChild("TouchZone", 10)
local touchPart = touchZoneFolder and touchZoneFolder:WaitForChild("GroupTouch", 10)
if not touchPart or not touchPart:IsA("BasePart") then
	warn("[GroupReward] Workspace.TouchZone.GroupTouch BasePart가 없어 그룹 보상 터치 존을 비활성화합니다.")
	return
end

local GROUP_ID = 492293332

local InPlayer = {}

local zone = TouchZone.new(touchPart)
zone:Start()

zone.Touched:Connect(function(player: Player)
	InPlayer[player] = true

	if not player:IsInGroupAsync(GROUP_ID) then
		Net.GroupReward.SendPromptJoin.Fire(player)
		return
	end

	NotificationService = NotificationService or ServiceRegistry:GetService("NotificationService")
	NotificationService:Pull(player, "You are already a member of this group!", "Normal", 1)
end)

zone.TouchEnded:Connect(function(player: Player)
	InPlayer[player] = false
end)
]]></string>
          </Properties>
        </Item>
