            <Item class="ModuleScript" referent="663">
              <Properties>
                <string name="Name">ClearData</string>
                <string name="Source"><![CDATA[return {
	Name = "ClearData",
	Aliases = { "cd" },
	Description = "플레이어의 데이터를 초기화합니다.",
	Group = "Admin",

