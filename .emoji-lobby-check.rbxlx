              <Item class="ModuleScript" referent="614">
                <Properties>
                  <string name="Name">Bezier</string>
                  <string name="Source"><![CDATA[--!native
--!nocheck
--!optimize 2
type n = vector | number

local EASE_LUT_SIZE = 64

local NEWTON_MIN_TOL = 0.001
local NEWTON_MAX_ITER = 5

local function cubicBezier(p0: n, p1: n, p2: n, p3: n, t: n): n
  -- stylua: ignore
  return (1-t)^3*p0+3*(1-t)^2*t*p1+3*(1-t)*t^2*p2+t^3*p3
end

local function cubicBezierDerivative(p0: n, p1: n, p2: n, p3: n, t: n): n
  -- stylua: ignore
  return 3*(1-t)^2*(p1-p0)+6*(1-t)*t*(p2-p1)+3*t^2*(p3-p2)
end

local bezier = {}
bezier.__index = bezier

export type Bezier = typeof(bezier) & {
  points: { vector },
  cumulative_lengths: { number },
  ease_lut: { vector }?,

  length: number,
  accuracy: number,
  point_count: number,
}

function bezier.new(points: { vector }, samplingAccuracy: number?)
  local self = setmetatable({}, bezier)

  self.points = points
  self.accuracy = samplingAccuracy or 20

  self.point_count = 0
  self.cumulative_lengths = {}

  self:_recalculate()

  return self
end

function bezier.setPoints(self: Bezier, points: { vector })
  self.points = points
  self.ease_lut = nil

  self:_recalculate()
end

function bezier.getSegmentPoints(self: Bezier, index: number)
  if index < 1 or index > self.point_count - 1 then
    if index <= 0 then
      return vector.zero, vector.zero, vector.zero, vector.zero
    end

    error("attempt to get a non-existent segment at index " .. index)
  end

  local offset = (index - 1) * 4 - math.max(index - 2, 0)
  local start = math.max(offset, 1)

  local p0 = self.points[start]
  local p1 = self.points[start + 1]
  local p2 = self.points[start + 2]
  local p3 = self.points[start + 3]

  return p0, p1, p2, p3
end

function bezier.forSample(self: Bezier, size: number, callback: (pos: vector, i: number) -> ())
  local amount = self.length // size

  if amount == 0 then
    return
  end

  for i = 0, amount do
    local t = i / amount
    callback(self:getPositionArcSpace(t), i)
  end
end

function bezier.getPosition(self: Bezier, t: number)
  local i, u = self:getSegmentIndex(t)
  local p0, p1, p2, p3 = self:getSegmentPoints(i)

  return cubicBezier(p0, p1, p2, p3, u)
end

function bezier.getSegmentIndex(self: Bezier, t: number)
  t = math.clamp(t, 0, 1)

  local m = self.point_count - 1
  local s = t * m

  local i = math.min(math.floor(s) + 1, m)
  local u = s - math.floor(s)

  if t == 1 then
    u = 1
  end

  return i, u
end

-- only works with beziers whose input is the X axis
function bezier.getEasedSegmentIndex(self: Bezier, t: number)
  local i = self.point_count - 1
  local u = 1

  for j = 1, i do
    local p0, _, _, p3 = self:getSegmentPoints(j)

    local start = p0.x
    local stop = p3.x

    if t >= start and t < stop then
      i = j
      u = (t - start) / (stop - start)

      break
    end
  end

  return i, u
end

function bezier._getEaseRaw(self: Bezier, t: number)
  local i, s = self:getEasedSegmentIndex(t)
  local p0, p1, p2, p3 = self:getSegmentPoints(i)

  for i = 1, NEWTON_MAX_ITER do
    local x = cubicBezier(p0.x, p1.x, p2.x, p3.x, s)
    local dx = cubicBezierDerivative(p0.x, p1.x, p2.x, p3.x, s)

    if dx == 0 then
      break
    end

    local ds = (x - t) / dx
    s = s - ds

    if s < 0 then
      s = 0
    elseif s > 1 then
      s = 1
    end

    if math.abs(ds) < NEWTON_MIN_TOL then
      break
    end
  end

  return cubicBezier(p0, p1, p2, p3, s)
end

function bezier._buildEaseLUT(self: Bezier)
  local lut = table.create(EASE_LUT_SIZE + 1)

  for i = 0, EASE_LUT_SIZE do
    local t = i / EASE_LUT_SIZE
    lut[i] = self:_getEaseRaw(t)
  end

  self.ease_lut = lut
end

function bezier.getEase(self: Bezier, t: number)
  local lut = self.ease_lut

  if not lut then
    self:_buildEaseLUT()
    lut = self.ease_lut
  end

  t = math.clamp(t, 0, 1)

  local idx = t * EASE_LUT_SIZE

  local lo = math.floor(idx)
  local hi = math.min(lo + 1, EASE_LUT_SIZE)

  local frac = idx - lo

  local loVal = lut[lo]
  local hiVal = lut[hi]

  if not loVal or not hiVal then
    return self:_getEaseRaw(t)
  end

  return loVal:Lerp(hiVal, frac)
end

function bezier.getPositionArcSpace(self: Bezier, t: number)
  if self.length <= 0 then
    return self.points[1] or vector.zero
  end

  t = math.clamp(t, 0, 1)

  local targetLength = t * self.cumulative_lengths[self.accuracy + 1]
  local low, high, index = 1, self.accuracy + 1, nil

  while low < high do
    index = low + (high - low) // 2

    if self.cumulative_lengths[index] < targetLength then
      low = index + 1
    else
      high = index
    end
  end

  if self.cumulative_lengths[index] > targetLength and index > 1 then
    index -= 1
  end

  local lengthBefore = self.cumulative_lengths[index]

  if lengthBefore == targetLength then
    return self:getPosition((index - 1) / self.accuracy)
  else
    return self:getPosition(
      ((index - 1) + (targetLength - lengthBefore) / (self.cumulative_lengths[index + 1] - lengthBefore))
        / self.accuracy
    )
  end
end

function bezier._recalculate(self: Bezier)
  table.clear(self.cumulative_lengths)
  table.insert(self.cumulative_lengths, 0)

  local count = math.ceil(#self.points / 3)

  self.point_count = count

  local total = 0

  local prev: vector

  for j = 1, self.accuracy do
    local p = self:getPosition(j / self.accuracy)

    if not prev then
      prev = self:getPosition(0)
    end

    total += vector.magnitude(p - prev)
    prev = p

    table.insert(self.cumulative_lengths, total)
  end

  self.length = total

  for i, len in self.cumulative_lengths do
    self.cumulative_lengths[i] = len / total
  end
end

return bezier
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="615">
                <Properties>
                  <string name="Name">ObjectCache</string>
                  <string name="Source"><![CDATA[local utility = require("../mod/utility")

local RECYCLE_INTERVAL = 15

local cache = {}
cache.__index = cache

type item = {
  key: any,
  value: Instance,

  added: number,
  dependents: number,
}

type params = {
  size: number?,
  excess_lifetime: number?,
  on_free: ((item) -> ())?,
}

export type ObjectCache = typeof(cache) & {
  ref: Instance,
  parent: Instance?,

  params: params,

  amount: number,
  restore_amount: number,

  part_mode: boolean,

  item_map: { [any]: item },
  unused: { item },

  scope: { any },
}

local function reconcile(a, b)
  for k, v in b do
    if a[k] == nil then
      a[k] = v
    end
  end

  return a
end

local moveParts: { BasePart } = table.create(10_000)
local movePartCFrames: { CFrame } = table.create(10_000)

local partUpdateScheduled = false

local bulkPartMoveThread = coroutine.create(function()
  while true do
    workspace:BulkMoveTo(moveParts, movePartCFrames, Enum.BulkMoveMode.FireCFrameChanged)

    table.clear(moveParts)
    table.clear(movePartCFrames)

    partUpdateScheduled = false

    coroutine.yield()
  end
end)

function cache.new(ref: Instance, parent: Instance?, params: params?)
  local self = setmetatable({}, cache)

  self.ref = ref
  self.parent = parent

  self.amount = 0
  self.restore_amount = 0

  self.params = reconcile(params or {}, {
    size = 100,
    excess_lifetime = 30,
  })

  self.scope = { ref, parent }
  self.unused = table.create(self.params.size)
  self.item_map = {}

  self.part_mode = ref:IsA("BasePart")

  for _ = 1, self.params.size do
    self:_add()
  end

  table.insert(
    self.scope,
    task.spawn(function()
      while task.wait(RECYCLE_INTERVAL) do
        if self.restore_amount > 0 then
          for _ = 1, self.restore_amount do
            self:_add()
            self.restore_amount -= 1
          end
        end

        if self.amount <= self.params.size then
          continue
        end

        local offset = 0

        for i = 1, #self.unused do
          if self.amount <= self.params.size then
            break
          end

          i -= offset

          local item = self.unused[i]

          if item.dependents ~= 0 or (os.clock() - item.added) > self.params.excess_lifetime then
            continue
          end

          item:destroy()

          table.remove(self.unused, i)

          self.item_map[item.key] = nil
          self.amount -= 1

          offset += 1
        end
      end
    end)
  )

  return self
end

function cache._add(self: ObjectCache, key: any?, excess: boolean?)
  local obj = self.ref:Clone()
  obj.Archivable = false
  obj.Parent = self.parent

  local item = {
    key = key,
    value = obj,

    added = os.clock(),
    dependents = 1,
  }

  local ignoreDestroy = false

  function item:destroy()
    ignoreDestroy = true
    obj:Destroy()
  end

  self.amount += 1

  obj.Destroying:Connect(function()
    if ignoreDestroy then
      return
    end

    local index = table.find(self.unused, item)

    if index then
      table.remove(self.unused, index)
    end

    if item.key then
      self.item_map[item.key] = nil
    end

    self.amount -= 1
    self.restore_amount += 1
  end)

  if key then
    self.item_map[key] = item
  end

  if not excess then
    table.insert(self.unused, item)
  end

  return item
end

function cache.has(self: ObjectCache, key: any)
  return if self.item_map[key] then true else false
end

function cache.peek(self: ObjectCache, key: any)
  return self.item_map[key]
end

function cache.get(self: ObjectCache, key: any)
  if self:has(key) then
    local item = self:peek(key)

    if item then
      item.dependents += 1
    end

    return item.value
  end

  local item = table.remove(self.unused)

  if item then
    item.key = key
    item.added = os.clock()

    self.item_map[key] = item
  else
    item = self:_add(key, true)
  end

  if self.part_mode then
    local meta = {}

    function meta:__newindex(key, value)
      if key == "CFrame" then
        table.insert(moveParts, item.value)
        table.insert(movePartCFrames, value)

        if not partUpdateScheduled then
          partUpdateScheduled = true
          task.defer(bulkPartMoveThread)
        end
      else
        item.value[key] = value
      end
    end

    function meta:__index(key)
      local v = item.value[key]

      if typeof(v) == "function" then
        return function(_, ...)
          return v(item.value, ...)
        end
      else
        return v
      end
    end

    return setmetatable({
      _getReal = function()
        return item.value
      end,
    }, meta)
  else
    return item.value
  end
end

function cache.free(self: ObjectCache, key: any)
  local item = self.item_map[key]

  if not item then
    return
  end

  item.dependents = math.max(item.dependents - 1, 0)

  if item.dependents == 0 then
    item.added = os.clock()

    if self.params.on_free then
      self.params.on_free(item)
    end

    table.insert(self.unused, item)
  end
end

function cache.destroy(self: ObjectCache)
  utility.cleanupScope(self.scope)

  for _, item in self.item_map do
    item.value:Destroy()
  end

  table.clear(self.unused)
  table.clear(self.item_map)
end

return cache
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="Folder" referent="616">
              <Properties>
                <string name="Name">services</string>
              </Properties>
              <Item class="ModuleScript" referent="617">
                <Properties>
                  <string name="Name">caches</string>
                  <string name="Source"><![CDATA[local ObjectCache = require("../obj/ObjectCache")

local utility = require("../mod/utility")

local caches = {}

function caches.init(scope: { any })
  local shared_part_cache

  do
    local template = Instance.new("Part")
    template.Transparency = 1
    template.Anchored = true
    template.CanCollide = false
    template.CanQuery = false
    template.Locked = true

    local parent = Instance.new("Folder")
    parent.Name = "DO_NOT_REMOVE_ForgeSharedPartCache"
    parent.Archivable = false
    parent.Parent = workspace.Terrain

    utility.protectParent(scope, parent)

    shared_part_cache = ObjectCache.new(template, parent, {
      size = 150,
      on_free = function(item)
        local part = item.value

        part.Transparency = 1

        part.Anchored = true
        part.CanQuery = false
        part.CanCollide = false

        part.CollisionGroup = "ForgeMouseIgnore"

        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero

        part.Parent = parent

        -- this is probably not very good for performance lol
        -- but I don't think there's currently a more reasonable
        -- way of recycling parts
        part:ClearAllChildren()
      end,
    })
  end

  local result = {
    shared_part = shared_part_cache,
  }

  table.insert(scope, function()
    shared_part_cache:destroy()
  end)

  return result
end

return caches
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="618">
                <Properties>
                  <string name="Name">effects</string>
                  <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local types = require("../types")
local logger = require("../mod/logger")
local utility = require("../mod/utility")
local emitters = require("../emitters")

local Promise = require(ReplicatedStorage.Packages.Promise)

local EffectSelectors = table.concat({
	"Beam",
	"Trail",
	"Sound",
	"ParticleEmitter",

	-- Beziers
	`.{utility.BEZIER_TAG}`,

	-- Lightning bolts
	`.{utility.LIGHTNING_TAG}`,

	-- Spin models
	"Model",

	-- Camera shakes
	"RayValue",

	-- Screen effects
	"BasePart[$Enabled=true]",

	-- Shockwave effects
	"#Rings > Part",
	"#Lines > Part",
	"#Debris > Part",
}, ",")

local effects = {}

local api_ref: types.Api?

local NOOP = function() end

local EMPTY_ENV: types.EmitEnv = {
	Finished = Promise.resolve(),
	Clear = NOOP,
}

function effects.init(api: types.Api)
	api_ref = api
end

function effects.deinit()
	api_ref = nil
end

local function isScreenEffect(obj: Instance): boolean
	return obj:IsA("BasePart") and obj:GetAttribute("Enabled") == true
		and not utility.findFirstClassWithTag(obj, "Attachment", utility.SHOCKWAVE_TAG)
end

local function emitWithContext(depth: number, context: { _promises: { any }, Scale: number? }?, ...: Instance): types.EmitEnv
	if not api_ref or not api_ref.setup then
		logger.error("effects service not initialized")
		return EMPTY_ENV
	end

	local sharedUncMap: { [Instance]: number } = {}
	local sharedRefMap: { [Instance]: Instance } = {}

	local legacyScale = (context and context.Scale) or 1

	local list = { ... }
	local rootPromises = {}

	local function queryAndEmitDescendants(obj: Instance, baseDepth: number): { any }
		local allDesc = obj:QueryDescendants(EffectSelectors)
		local totalDesc = #allDesc

		if totalDesc == 0 then
			return {}
		end

		local promises = table.create(totalDesc)

		local skipCache: { [Instance]: boolean } = {}
		local depthCache: { [Instance]: number } = {}

		skipCache[obj] = false
		depthCache[obj] = baseDepth

		for _, desc in allDesc do
			if desc:HasTag(utility.EMIT_EXCLUDE_TAG) then continue end
			local ancestors = {}
			local current = desc.Parent

			while current and depthCache[current] == nil do
				table.insert(ancestors, current)
				current = current.Parent
			end

			if not current then continue end -- removed/reparented during dispatch
			local shouldSkip = skipCache[current]
			local currentDepth = depthCache[current]

			for i = #ancestors, 1, -1 do
				local ancestor = ancestors[i]

				currentDepth += 1
				depthCache[ancestor] = currentDepth

				if not shouldSkip then
					shouldSkip = utility.shouldSkipNested(ancestor) or ancestor:HasTag(utility.EMIT_EXCLUDE_TAG)
						or isScreenEffect(ancestor)
				end

				skipCache[ancestor] = shouldSkip
			end

			if not shouldSkip then
				-- Preserve recursive screen effects within folders/models, exactly once.
				if isScreenEffect(desc) then
					local nested = emitWithContext(depthCache[desc.Parent], context, desc)
					table.insert(promises, nested.Finished)
					continue
				end
				table.insert(
					promises,
					utility.createEmitPromise(effects, desc, depthCache[desc.Parent], function(scope)
						emitters.dispatch(
							desc,
							scope,
							sharedUncMap,
							sharedRefMap,
							api_ref.caches.shared_part,
							legacyScale
						)
					end, context)
				)
			end
		end

		return promises
	end

	for _, obj in list do
		if obj:HasTag(utility.EMIT_EXCLUDE_TAG) then continue end
		-- screen effects
		if isScreenEffect(obj) then
			if utility.lock(obj) then
				continue
			end

			local anc = obj:FindFirstAncestorOfClass("Model")

			if anc and not utility.isSpinModelStatic(anc) then
				utility.unlock(obj)
				continue
			end

			local lockThread = coroutine.running()

			local scope: { [any]: any } = {}
			scope.depth = depth
			scope.effects = effects
			scope._context = context

			local await = emitters.screen(obj, scope)

			if await then
				local innerPromises = queryAndEmitDescendants(obj, depth + 1)

				if #innerPromises > 0 then
					table.insert(
						rootPromises,
						Promise.all(innerPromises):finally(function()
							utility.unlock(obj, lockThread)
							utility.cleanupScope(scope)
						end)
					)
				else
					utility.unlock(obj, lockThread)
					utility.cleanupScope(scope)
				end
			else
				utility.unlock(obj, lockThread)
				utility.cleanupScope(scope)
			end
		-- other effects
		else
			table.insert(
				rootPromises,
				utility.createEmitPromise(effects, obj, depth, function(scope)
					emitters.dispatch(obj, scope, sharedUncMap, sharedRefMap, api_ref.caches.shared_part, legacyScale)
				end, context)
			)

			if not utility.shouldSkipNested(obj) then
				local descendantPromises = queryAndEmitDescendants(obj, depth + 1)

				for _, promise in descendantPromises do
					table.insert(rootPromises, promise)
				end
			end
		end
	end

	local env = {} :: types.EmitEnv

	env.Finished = Promise.all(rootPromises)
	env.Clear = if context
		then function()
			for _, promise in context._promises do
				promise:cancel()
			end
			env.Finished:cancel()
		end
		else NOOP

	return env
end

function effects.emit(depth: number, ...: Instance): types.EmitEnv
	local context = { _promises = {} }
	return emitWithContext(depth, context, ...)
end

function effects.emitScaled(scale: number, depth: number, ...: Instance): types.EmitEnv
	assert(scale > 0 and scale < math.huge, "Emit scale must be finite and positive")
	local context = { _promises = {}, Scale = scale }
	return emitWithContext(depth, context, ...)
end

function effects.prepareEmitFolder(obj: Instance, folderName: string, scope: types.scope): Folder?
	local folder = obj:FindFirstChild(folderName)

	if folder and folder:IsA("Folder") then
		folder.Parent = nil
		table.insert(scope, folder)
		return folder
	end

	return nil
end

function effects.prepareEmitOnFinish(obj: Instance, scope: types.scope): Folder?
	return effects.prepareEmitFolder(obj, "EmitOnFinish", scope)
end

function effects.emitNested(part: Instance, depth: number, parentScope: types.scope?): types.EmitEnv
	if not api_ref or not api_ref.setup then
		return EMPTY_ENV
	end

	local children = part:GetChildren()

	if #children == 0 then
		return EMPTY_ENV
	end

	local context = if parentScope then parentScope._context else nil
	return emitWithContext(depth, context, table.unpack(children))
end

function effects.emitFromFolder(
	folder: Folder?,
	targetParent: Instance,
	depth: number,
	parentScope: types.scope?
): types.EmitEnv
	if not folder then
		return EMPTY_ENV
	end

	local children = folder:GetChildren()

	if #children == 0 then
		return EMPTY_ENV
	end

	for _, child in children do
		child.Parent = targetParent
	end

	local context = if parentScope then parentScope._context else nil
	return emitWithContext(depth, context, table.unpack(children))
end

function effects.emitOnFinish(
	emitOnFinish: Folder?,
	targetParent: Instance,
	depth: number,
	parentScope: types.scope?
): types.EmitEnv
	return effects.emitFromFolder(emitOnFinish, targetParent, depth, parentScope)
end

return effects
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="619">
                <Properties>
                  <string name="Name">enabled_effects</string>
                  <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local attr = require("../mod/attributes")
local types = require("../types")
local utility = require("../mod/utility")
local emitters = require("../emitters")

local enabled_effects = {}

function enabled_effects.init(scope: types.scope, shared_part_cache: any, effects_service: any)
  local enabledScopes = {}
  local ancestryConnections: { [Instance]: RBXScriptConnection } = {}

  local function removeEnabledEffect(obj: Instance)
    local effectScope = enabledScopes[obj]

    if effectScope then
      utility.cleanupScope(effectScope)
    end

    enabledScopes[obj] = nil
  end

  local function removeEnabledEffectFull(obj: Instance)
    removeEnabledEffect(obj)

    local conn = ancestryConnections[obj]

    if conn then
      conn:Disconnect()
      ancestryConnections[obj] = nil
    end
  end

  local function addEnabledEffect(obj: Instance)
    -- Find which effect type this object is
    local effectConfig = nil

    for _, config in emitters.enabled_registry do
      if config.check(obj) then
        effectConfig = config
        break
      end
    end

    if not effectConfig then
      return
    end

    local tempScope = {} :: { any }
    local effectScope = {} :: { any }

    table.insert(effectScope, tempScope)

    enabledScopes[obj] = effectScope

    if not ancestryConnections[obj] then
      ancestryConnections[obj] = obj.AncestryChanged:Connect(function()
        if obj:IsDescendantOf(workspace) or (obj.Parent and obj.Parent:HasTag("AllowEmitting")) then
          if not enabledScopes[obj] then
            addEnabledEffect(obj)
          end
        else
          removeEnabledEffect(obj)
        end
      end)
    end

    local function onEnabled(enabled: boolean?)
      if enabled == nil then
        enabled = attr.get(obj, "Enabled", true)
      end

      local canEmit = utility.isForceEmitting(obj)
        or obj:IsDescendantOf(workspace)
        or (obj.Parent and obj.Parent:HasTag("AllowEmitting"))

      if enabled and not canEmit then
        return
      end

      if enabled then
        utility.cleanupScope(tempScope)

        local elapsed = math.huge
        local cancelToken = { _promises = {}, _scopes = {} }

        utility.setEnabledCancelToken(obj, cancelToken)

        table.insert(
          tempScope,
          RunService.RenderStepped:Connect(function(deltaTime)
            local rate = attr.get(obj, "Rate", 5)
            local speed = attr.getState(obj, "SpeedOverride", 1)

            if speed <= 0 or rate <= 0 then
              return
            end

            local interval = 1 / rate
            local gameDelta = utility.getGameDelta(deltaTime)

            if gameDelta <= 0 then
              return
            end

            if elapsed ~= math.huge then
              elapsed += gameDelta * speed
            end

            if elapsed < interval then
              return
            end

            elapsed = if elapsed == math.huge then 0 else elapsed % interval

            local emitScope = {}
            emitScope.depth = 0
            emitScope.effects = effects_service
            emitScope._context = cancelToken

            table.insert(cancelToken._scopes, emitScope)

            effectConfig.emit(obj, emitScope, shared_part_cache)

            local idx = table.find(cancelToken._scopes, emitScope)
            if idx then
              table.remove(cancelToken._scopes, idx)
            end

            utility.cleanupScope(emitScope)
          end)
        )
      else
        utility.cleanupScope(tempScope)
      end
    end

    table.insert(effectScope, attr.hook(obj, "Enabled", onEnabled))

    onEnabled()
  end

  for _, obj in CollectionService:GetTagged(utility.ENABLED_VFX_TAG) do
    addEnabledEffect(obj)
  end

  CollectionService:GetInstanceAddedSignal(utility.ENABLED_VFX_TAG):Connect(addEnabledEffect)
  CollectionService:GetInstanceRemovedSignal(utility.ENABLED_VFX_TAG):Connect(removeEnabledEffectFull)

  table.insert(scope, function()
    for obj, effectScope in enabledScopes do
      utility.cleanupScope(effectScope)
    end

    for obj, conn in ancestryConnections do
      conn:Disconnect()
    end

    table.clear(ancestryConnections)
  end)
end

return enabled_effects
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="620">
                <Properties>
                  <string name="Name">texture_loader</string>
                  <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")

local ObjectCache = require("../obj/ObjectCache")

local types = require("../types")
local utility = require("../mod/utility")
local flipbook_common = require("../mod/common/flipbook")

local texture_loader = {}

function texture_loader.init(scope: types.scope)
  local template = Instance.new("Decal")

  local parent = Instance.new("Part")
  parent.Name = "DO_NOT_REMOVE_ForgeTextureCache"
  parent.Transparency = 1
  parent.Size = Vector3.zero
  parent.Archivable = false
  parent.Anchored = true
  parent.CanCollide = false
  parent.CanQuery = false
  parent.Locked = true
  parent.Parent = workspace.Terrain

  utility.protectParent(scope, parent)

  local texture_cache = ObjectCache.new(template, parent, {
    size = 120 * 3,
    on_free = function(item)
      item.value.Texture = ""
    end,
  })

  local preloadScopes = {}

  local function createLoader(
    ref: Instance,
    collectTextures: (add: (tex: string) -> ()) -> (),
    conns: ((run: () -> ()) -> { RBXScriptConnection })?
  )
    local loadScope = {} :: { any }
    local snapshotScope = {} :: { any }

    table.insert(loadScope, snapshotScope)

    local function refresh()
      utility.cleanupScope(snapshotScope)

      local function add(tex: string)
        if tex == "" then
          return
        end

        local d = texture_cache:get(tex)
        d.Texture = tex

        table.insert(snapshotScope, function()
          texture_cache:free(tex)
        end)
      end

      collectTextures(add)
    end

    refresh()

    if utility.PLUGIN_CONTEXT and conns then
      local run = utility.reboundfn(1, refresh)

      for _, connection in conns(run) do
        table.insert(loadScope, connection)
      end
    end

    preloadScopes[ref] = loadScope
  end

  local function loadTextures(ref: Instance)
    if ref:IsDescendantOf(workspace.Terrain) then
      return
    end

    if utility.isMeshVFX(ref) then
      local obj = ref:FindFirstChild("Start")

      if not obj or not obj:IsA("BasePart") then
        return
      end

      createLoader(ref, function(add)
        local decals, flipbooks = utility.getMeshDecals(ref :: Model, obj)

        for _, d in decals do
          add(typeof(d) ~= "string" and d.Texture or d)
        end

        for v, list in flipbooks do
          local prefix = flipbook_common.getTexturePrefix(ref)

          for _, id in list do
            add(`{prefix}{id}`)
          end
        end
      end, function(run)
        return {
          obj.DescendantAdded:Connect(run),
          obj.DescendantRemoving:Connect(run),
        }
      end)
    elseif ref:IsA("Beam") then
      createLoader(ref, function(add)
        add(ref.Texture)

        local flipbook = flipbook_common.getFlipbookData(ref)

        if flipbook then
          local prefix = flipbook_common.getTexturePrefix(ref)

          for _, id in flipbook do
            add(`{prefix}{id}`)
          end
        end
      end, function(run)
        return {
          ref:GetPropertyChangedSignal("Texture"):Connect(run),
          ref.AttributeChanged:Connect(run),
        }
      end)
    else
      createLoader(ref, function(add)
        local function check(obj: Instance)
          if obj:IsA("ParticleEmitter") then
            add(obj.Texture)
          end
        end

        check(ref)

        for _, obj in ref:GetDescendants() do
          check(obj)
        end
      end, function(run)
        return {
          ref.DescendantAdded:Connect(run),
          ref.DescendantRemoving:Connect(run),
        }
      end)
    end
  end

  for _, ref in CollectionService:GetTagged(utility.TEXTURE_LOAD_TAG) do
    loadTextures(ref)
  end

  CollectionService:GetInstanceAddedSignal(utility.TEXTURE_LOAD_TAG):Connect(loadTextures)
  CollectionService:GetInstanceRemovedSignal(utility.TEXTURE_LOAD_TAG):Connect(function(ref)
    local loadScope = preloadScopes[ref]

    if loadScope then
      utility.cleanupScope(loadScope)
      preloadScopes[ref] = nil
    end
  end)

  table.insert(scope, function()
    texture_cache:destroy()

    for _, loadScope in preloadScopes do
      utility.cleanupScope(loadScope)
    end
  end)
end

return texture_loader
]]></string>
                </Properties>
              </Item>
            </Item>
            <Item class="ModuleScript" referent="621">
              <Properties>
                <string name="Name">types</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Promise = require(ReplicatedStorage.Packages.Promise)
local ObjectCache = require("./obj/ObjectCache")

export type scope = { any } & {
	depth: number,
	effects: EffectsService,
	_context: { _promises: { any } }?,
	_onCancel: { () -> () }?,
}

export type EmitEnv = {
	Finished: typeof(Promise.resolve()),
	Clear: (self: EmitEnv) -> (),
}

export type ApiCaches = {
	shared_part: ObjectCache.ObjectCache,
}

export type EffectsService = {
	init: (api: Api) -> (),
	deinit: () -> (),

	emit: (depth: number, ...Instance) -> EmitEnv,
	emitScaled: (scale: number, depth: number, ...Instance) -> EmitEnv,
	emitNested: (part: Instance, depth: number, parentScope: scope?) -> EmitEnv,
	emitFromFolder: (folder: Folder?, targetParent: Instance, depth: number, parentScope: scope?) -> EmitEnv,
	emitOnFinish: (emitOnFinish: Folder?, targetParent: Instance, depth: number, parentScope: scope?) -> EmitEnv,

	prepareEmitFolder: (obj: Instance, folderName: string, scope: scope) -> Folder?,
	prepareEmitOnFinish: (obj: Instance, scope: scope) -> Folder?,
}

export type Api = {
	setup: boolean,

	scope: { unknown },
	caches: ApiCaches,

	init: (params: any?) -> (),
	deinit: () -> (),

	emit: (vfxOrScale: number | Instance, ...Instance) -> EmitEnv,
	emitWithDepth: (depth: number, ...Instance) -> EmitEnv,
}

return {}
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="622">
            <Properties>
              <string name="Name">FrameBudget</string>
              <string name="Source"><![CDATA[-- Inject the yield/clock functions so scheduling can be tested without Roblox.
local FrameBudget = {}

function FrameBudget.new(yieldFrame, maxItems, maxSeconds, clock, limits)
	clock = clock or os.clock
	maxItems = maxItems or 64
	maxSeconds = maxSeconds or 0.002
	assert(maxItems > 0 and maxSeconds > 0, "Frame budget must be positive")
	local count, started = 0, clock()
	local itemLimit, timeLimit = maxItems, maxSeconds
	local function refresh()
		if limits then
			local items, seconds = limits()
			assert(items > 0 and seconds > 0, "Adaptive budget must be positive")
			itemLimit, timeLimit = math.min(maxItems, items), math.min(maxSeconds, seconds)
		end
	end
	refresh()
	return function(cost)
		count += cost or 1
		if count >= itemLimit or clock() - started >= timeLimit then
			yieldFrame()
			count, started = 0, clock()
			refresh()
		end
	end
end

return FrameBudget
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="623">
            <Properties>
              <string name="Name">InstanceBatch</string>
              <string name="Source"><![CDATA[-- Tree operations only: never clone nodes separately (would break cross-node references).
local InstanceBatch = {}

function InstanceBatch.Visit(roots, callback, step)
	local stack = table.clone(roots)
	local seen = {}
	while #stack > 0 do
		local instance = table.remove(stack)
		if seen[instance] then continue end
		seen[instance] = true
		for _, child in instance:GetChildren() do
			table.insert(stack, child)
			step()
		end
		callback(instance)
		step()
	end
end

function InstanceBatch.Plan(root, isAtomic, step)
	local entries = {}
	for _, child in root:GetChildren() do
		table.insert(entries, { Instance = child, Parent = root })
		step()
	end
	local index = 1
	while index <= #entries do
		local entry = entries[index]
		local instance = entry.Instance
		local atomic = isAtomic(instance)
		if not atomic and instance:IsA("Model") then
			entry.IsModel = true
			entry.PrimaryPart = instance.PrimaryPart
			entry.WorldPivot = instance.WorldPivot
		end
		if not atomic then
			for _, child in instance:GetChildren() do
				table.insert(entries, { Instance = child, Parent = instance })
				step()
			end
		end
		index += 1
		step()
	end
	return entries
end

-- Count ALL descendants, including trees parented beneath Parts/Attachments.
-- Build once in breadth-first order, then sum bottom-up in O(n). Never call
-- GetDescendants for every model (quadratic on deeply nested imported maps).
function InstanceBatch.PlanBounded(root, maxNodes, step, visit)
	assert(maxNodes >= 1, "Chunk size must be positive")
	local nodes = { { Instance = root, Count = 1 } }
	local index = 1
	while index <= #nodes do
		local node = nodes[index]
		if index > 1 and visit then visit(node.Instance) end
		for _, child in node.Instance:GetChildren() do
			table.insert(nodes, { Instance = child, ParentIndex = index, Count = 1 })
			step()
		end
		index += 1
		step()
	end
	for i = #nodes, 2, -1 do
		local node = nodes[i]
		nodes[node.ParentIndex].Count += node.Count
		step()
	end
	local entries = {}
	nodes[1].Split = true
	for i = 2, #nodes do
		local node = nodes[i]
		local parent = nodes[node.ParentIndex]
		if parent.Split then
			node.Split = node.Count > maxNodes
			local entry = {
				Instance = node.Instance,
				Parent = parent.Instance,
				-- Split containers are empty when mounted; intact subtrees cost
				-- their entire node count, not just one Parent assignment.
				Cost = if node.Split then 1 else node.Count,
			}
			if node.Split and node.Instance:IsA("Model") then
				entry.IsModel = true
				entry.PrimaryPart = node.Instance.PrimaryPart
				entry.WorldPivot = node.Instance.WorldPivot
			end
			table.insert(entries, entry)
		end
		step()
	end
	return entries, nodes[1].Count - 1
end

function InstanceBatch.Detach(entries, step)
	for index = #entries, 1, -1 do
		entries[index].Instance.Parent = nil
		step(entries[index].Cost or 1)
	end
end

function InstanceBatch.Mount(root, destination, entries, step, prepareStep, detached)
	prepareStep = prepareStep or step
	-- Off-world child-first detach, then parent-first mount in small batches.
	-- Each entry is the SAME clone, so ObjectValues/joints retain their references.
	if not detached then InstanceBatch.Detach(entries, prepareStep) end
	for _, entry in entries do
		entry.Instance.Parent = if entry.Parent == root then destination else entry.Parent
		step(entry.Cost or 1)
	end
	-- Roblox can clear PrimaryPart when it is detached across simulation steps.
	-- Restore model metadata after descendants exist; do NOT PivotTo/move geometry.
	for _, entry in entries do
		if entry.IsModel then
			entry.Instance.PrimaryPart = entry.PrimaryPart
			entry.Instance.WorldPivot = entry.WorldPivot
			step()
		end
	end
end

function InstanceBatch.Destroy(roots, step, scanStep)
	scanStep = scanStep or step
	local stack, seen = {}, {}
	for _, root in roots do
		table.insert(stack, { Instance = root })
		scanStep()
	end
	while #stack > 0 do
		local entry = table.remove(stack)
		local instance = entry.Instance
		if entry.Expanded then
			instance:Destroy()
			step()
		elseif not seen[instance] then
			seen[instance] = true
			table.insert(stack, { Instance = instance, Expanded = true })
			for _, child in instance:GetChildren() do
				table.insert(stack, { Instance = child })
				scanStep()
			end
			scanStep()
		end
	end
end

return InstanceBatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="624">
            <Properties>
              <string name="Name">ItemUtils</string>
              <string name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemData = require(ReplicatedStorage.Settings.Data.ItemData)

export type StackInventory = { [string]: number }

local function normalizeKey(value: any): string
	return string.lower(tostring(value)):gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
end

local canonicalNames = {}
for itemName in ItemData.ByName do
	canonicalNames[normalizeKey(itemName)] = itemName
end

local ItemUtils = {}

function ItemUtils.GetCanonicalName(value: any): string?
	if typeof(value) == "number" then
		local itemInfo = ItemData.ByIndex[value]
		return if itemInfo then itemInfo.Name else nil
	end
	return canonicalNames[normalizeKey(value)]
end

function ItemUtils.NormalizeStacks(rawItems: any): StackInventory
	local merged: StackInventory = {}
	if typeof(rawItems) ~= "table" then
		return merged
	end

	for rawName, rawAmount in rawItems do
		local canonicalName = ItemUtils.GetCanonicalName(rawName)
		local amount = tonumber(rawAmount)
		if canonicalName and amount and amount &gt; 0 then
			merged[canonicalName] = (merged[canonicalName] or 0) + math.floor(amount)
		end
	end

	return merged
end

return ItemUtils</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="625">
            <Properties>
              <string name="Name">MouseRayCast</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Input = require(ReplicatedStorage.Packages.Input)

local MAX_DISTANCE = 1000
local RAYCAST_PARAMS = RaycastParams.new()
RAYCAST_PARAMS.FilterType = Enum.RaycastFilterType.Exclude
RAYCAST_PARAMS.IgnoreWater = true

return function(isHolding: boolean?): RaycastResult
	if isHolding then
		RAYCAST_PARAMS.CollisionGroup = "HoldingTowerMouse"
	else
		RAYCAST_PARAMS.CollisionGroup = "Mouse"
	end

	local result = Input.Mouse:Raycast(RAYCAST_PARAMS, MAX_DISTANCE)

	return result
end
]]></string>
            </Properties>
