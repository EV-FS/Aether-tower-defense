        <Item class="ModuleScript" referent="447">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[--/Service
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")

--/Modules
local InstanceCache = require(ReplicatedStorage.Shared.Modules.Core.InstanceCache)

--/Variables
local Caches = workspace:FindFirstChild("Caches") or Instance.new("Folder")
Caches.Name = "Caches"
Caches.Parent = workspace

-- These objects are client-owned infrastructure. Waiting indefinitely for a
-- server copy here can stall every controller that is loaded after audio.
local DeviceOutput = SoundService:FindFirstChild("AudioDeviceOutput") or Instance.new("AudioDeviceOutput")
DeviceOutput.Name = "AudioDeviceOutput"
DeviceOutput.Parent = SoundService

local AudioFolder = SoundService:FindFirstChild("Audio") or Instance.new("Folder")
AudioFolder.Name = "Audio"
AudioFolder.Parent = SoundService

--/Constants
local DEFAULT_DISTANCE = 1000
local DEFAULT_VOLUME = 1

--/Pools
local PlayerStorage
local EmitterStorage
local WireStorage
local FaderStorage

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function GetInverseAttenuation(minDist: number, maxDist: number): { [number]: number }
	local attenuation: { [number]: number } = {}
	local rollOffMin = math.max(minDist, 10)
	attenuation[0] = 1
	attenuation[rollOffMin] = 1

	local steps = 5
	for i = 1, steps do
		local distance = rollOffMin + (maxDist - rollOffMin) * (i / steps)
		local volume = rollOffMin / distance
		attenuation[distance] = math.clamp(volume, 0, 1)
	end

	attenuation[maxDist] = 0
	return attenuation
end

local function setupAudioListener()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local listener = camera:FindFirstChildOfClass("AudioListener") or Instance.new("AudioListener")
	listener.Parent = camera

	local listenerWire = SoundService:FindFirstChild("AudioListenerWire") :: Wire?
	if listenerWire and listenerWire.SourceInstance == listener and listenerWire.TargetInstance == DeviceOutput then
		return
	end

	for _, wire in listener:GetConnectedWires("Output") do
		if wire.TargetInstance == DeviceOutput then
			return
		end
	end

	if not listenerWire then
		if #DeviceOutput:GetConnectedWires("Input") > 0 then
			return
		end

		listenerWire = Instance.new("Wire")
		listenerWire.Name = "AudioListenerWire"
		listenerWire.Parent = SoundService
	else
		-- 기존 카메라 Listener에서 분리한 뒤 새 Listener로 옮긴다.
		listenerWire.TargetInstance = nil
	end

	listenerWire.SourceInstance = listener
	listenerWire.TargetInstance = DeviceOutput
end

-------------------------------------------------
--// AudioController
-------------------------------------------------
local AudioController = {}
AudioController.SFXVolume = 1

function AudioController.PlayOn2D(soundId: any, volume: number?, looped: boolean?)
	soundId = typeof(soundId) == "string" and soundId or `rbxassetid://{soundId}`

	local audioPlayer: AudioPlayer = PlayerStorage:GetInstance()
	audioPlayer.PlaybackSpeed = 1
	audioPlayer.Asset = soundId
	audioPlayer.TimePosition = 0
	audioPlayer.Looping = looped == true
	pcall(function()
		audioPlayer.Parent = SoundService
	end)

	local fader: AudioFader?
	local faderWire: Wire?

	if volume or AudioController.SFXVolume ~= 1 then
		fader = FaderStorage:GetInstance() :: AudioFader
		fader.Volume = (volume or 1) * AudioController.SFXVolume
		fader.Parent = SoundService

		faderWire = WireStorage:GetInstance() :: Wire
		faderWire.SourceInstance = fader
		faderWire.TargetInstance = DeviceOutput
		faderWire.Parent = SoundService
	end

	local wire: Wire = WireStorage:GetInstance()
	wire.SourceInstance = audioPlayer
	wire.TargetInstance = fader or DeviceOutput
	wire.Parent = SoundService

	audioPlayer:Play()

	local isCleaned = false
	local endedConn: RBXScriptConnection?

	local function cleanup()
		if isCleaned then
			return
		end
		isCleaned = true

		if endedConn then
			endedConn:Disconnect()
			endedConn = nil
		end

		audioPlayer.Looping = false
		audioPlayer:Stop()
		audioPlayer.TimePosition = 0
		audioPlayer.PlaybackSpeed = 1
		PlayerStorage:ReturnInstance(audioPlayer)
		WireStorage:ReturnInstance(wire)

		if fader then
			FaderStorage:ReturnInstance(fader)
		end
		if faderWire then
			WireStorage:ReturnInstance(faderWire)
		end
	end

	endedConn = audioPlayer.Ended:Once(cleanup)

	return {
		Player = audioPlayer,
		Stop = cleanup,
	}
end

function AudioController.PlayOn3D(
	soundId: any,
	volume: number?,
	distance: number?,
	parent: Instance | Vector3,
	looped: boolean?,
	duckBGMDistance: number?
)
	soundId = typeof(soundId) == "string" and soundId or `rbxassetid://{soundId}`

	local parentInst: Instance
	local isVector3 = typeof(parent) == "Vector3"

	if isVector3 then
		local part = Instance.new("Part")
		part.Size = Vector3.zero
		part.Transparency = 1
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Anchored = true
		part.Position = parent
		part.Parent = workspace.Terrain
		parentInst = part
	else
		parentInst = parent
	end

	local audioPlayer: AudioPlayer = PlayerStorage:GetInstance()
	audioPlayer.PlaybackSpeed = 1
	audioPlayer.Asset = soundId
	audioPlayer.TimePosition = 0
	audioPlayer.Looping = looped == true
	pcall(function()
		audioPlayer.Parent = SoundService
	end)

	local emitter: AudioEmitter = EmitterStorage:GetInstance()
	emitter:SetDistanceAttenuation(GetInverseAttenuation(0, distance or DEFAULT_DISTANCE))
	emitter.Parent = parentInst

	local fader: AudioFader?
	local faderWire: Wire?

	if volume or AudioController.SFXVolume ~= 1 then
		fader = FaderStorage:GetInstance()
		if fader then
			fader.Volume = (volume or 1) * AudioController.SFXVolume
			fader.Parent = parentInst
		end

		faderWire = WireStorage:GetInstance()
		if faderWire and fader then
			faderWire.SourceInstance = fader
			faderWire.TargetInstance = emitter
			faderWire.Parent = parentInst
		end
	end

	local wire: Wire = WireStorage:GetInstance()
	wire.SourceInstance = audioPlayer
	wire.TargetInstance = fader or emitter
	wire.Parent = parentInst

	audioPlayer:Play()

	local bgmSound: Sound? = nil
	local originalBGMVolume: number? = nil
	local bgmDuckConnection: RBXScriptConnection? = nil
	if duckBGMDistance then
		bgmSound = SoundService:FindFirstChild("BGM") :: Sound?
		if bgmSound then
			originalBGMVolume = bgmSound.Volume
			local maxDistance = duckBGMDistance
			bgmDuckConnection = RunService.Heartbeat:Connect(function()
				local camera = workspace.CurrentCamera
				if not camera or not parentInst.Parent then
					return
				end

				local sourcePosition = if parentInst:IsA("BasePart")
					then parentInst.Position
					else camera.CFrame.Position
				local distanceFromSource = (camera.CFrame.Position - sourcePosition).Magnitude
				local proximity = math.clamp(1 - distanceFromSource / maxDistance, 0, 1)
				bgmSound.Volume = originalBGMVolume * (1 - proximity * 0.65)
			end)
		end
	end

	local isCleaned = false
	local endedConn: RBXScriptConnection?

	local function cleanup()
		if isCleaned then
			return
		end
		isCleaned = true
		if bgmDuckConnection then
			bgmDuckConnection:Disconnect()
			bgmDuckConnection = nil
		end
		if bgmSound and originalBGMVolume then
			bgmSound.Volume = originalBGMVolume
		end

		if endedConn then
			endedConn:Disconnect()
			endedConn = nil
		end

		if isVector3 and parentInst then
			parentInst:Destroy()
		end

		audioPlayer.Looping = false
		audioPlayer:Stop()
		audioPlayer.TimePosition = 0
		audioPlayer.PlaybackSpeed = 1
		PlayerStorage:ReturnInstance(audioPlayer)
		EmitterStorage:ReturnInstance(emitter)
		WireStorage:ReturnInstance(wire)

		if fader then
			FaderStorage:ReturnInstance(fader)
		end
		if faderWire then
			WireStorage:ReturnInstance(faderWire)
		end
	end

	endedConn = audioPlayer.Ended:Once(cleanup)

	return {
		Player = audioPlayer,
		Stop = cleanup,
	}
end

function AudioController.SetBGMState(playing: boolean?, volume: number?, newBGMId)
	local bgmSound = SoundService:FindFirstChild("BGM") :: Sound?
	if not bgmSound then
		bgmSound = Instance.new("Sound")
		bgmSound.Name = "BGM"
		bgmSound.Parent = SoundService
	end
	if newBGMId then
		newBGMId = typeof(newBGMId) == "string" and newBGMId or `rbxassetid://{newBGMId}`
		bgmSound.TimePosition = 0
	end

	bgmSound.Volume = volume or bgmSound.Volume
	bgmSound.SoundId = newBGMId or bgmSound.SoundId
	bgmSound.Looped = true

	bgmSound.Parent = SoundService

	if playing then
		bgmSound:Play()
	elseif playing == false then
		bgmSound:Stop()
	end
end

function AudioController.Init()
	-- Pools grow automatically. A small warm pool removes a large allocation
	-- spike from the loading screen without changing peak capacity.
	PlayerStorage = InstanceCache.new(Instance.new("AudioPlayer"), 6, Caches)
	EmitterStorage = InstanceCache.new(Instance.new("AudioEmitter"), 4, Caches)
	WireStorage = InstanceCache.new(Instance.new("Wire"), 12, Caches)
	FaderStorage = InstanceCache.new(Instance.new("AudioFader"), 4, Caches)

	setupAudioListener()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(setupAudioListener)

	AudioController.SetBGMState(true, DEFAULT_VOLUME)
end

return AudioController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="448">
          <Properties>
            <string name="Name">ChatController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local UI = require(ReplicatedStorage.UI)

local player = Players.LocalPlayer
local inputBar = TextChatService.ChatInputBarConfiguration

local KEYBOARD_OFFSET = CFrame.new(0, -0.051, 0) * CFrame.fromOrientation(math.rad(90), math.rad(90), 0)

local keyboard: BasePart? = nil
local keyboardWeld: Motor6D | Weld? = nil
local activeTrack: AnimationTrack? = nil
local activeAnimation: Animation? = nil
local activeSfx: any? = nil
local audioController: any? = nil
local chatId = 0
local isSending = false
local sendPending = false

local function escapeRichText(text: string): string
	local escaped = text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	return escaped
end

local function formatRoleTag(message: TextChatMessage): TextChatMessageProperties?
	local textSource = message.TextSource
	if not textSource then
		return nil
	end

	local messagePlayer = Players:GetPlayerByUserId(textSource.UserId)
	local roleName = messagePlayer and messagePlayer:GetAttribute("ChatRoleTag")
	if type(roleName) ~= "string" or roleName == "" then
		return nil
	end

	local properties = Instance.new("TextChatMessageProperties")
	properties.PrefixText = `<font color="#FFB6D9">[{escapeRichText(roleName)}]</font> {message.PrefixText}`
	return properties
end

local ChatController = {
	CurrentState = "Normal",
	AnimationIds = {
		Start = "rbxassetid://92643631657418",
		Loop = "rbxassetid://100699931808831",
		Enter = "rbxassetid://137895585559810",
	},
	SfxIds = {
		Start = "",
		Loop = "rbxassetid://7610391610",
		Enter = "rbxassetid://130990339683290",
	},
	Sfx = {
		Volume = 3,
		Distance = 50,
	},
	LoopSpeed = {
		Start = 1,
		Max = 10,
		Acceleration = 0.05,
	},
}

local function setState(state: string)
	ChatController.CurrentState = state
end

local function leaveHandAfterimages(speed)
	local character = player.Character
	if not character then
		return
	end

	for _, handName in { "Left Arm", "Right Arm" } do
		local hand = character:FindFirstChild(handName)
		if not hand or not hand:IsA("BasePart") then
			continue
		end

		local afterimage = hand:Clone()
		afterimage.Name = "ChatHandAfterimage"
		afterimage.Anchored = true
		afterimage.CanCollide = false
		afterimage.CanQuery = false
		afterimage.CanTouch = false
		afterimage.CastShadow = false
		afterimage.Transparency = 0.75
		afterimage.CFrame = hand.CFrame
		afterimage.Material = Enum.Material.Neon
		afterimage.Color = Color3.new(0, 1, 0.2)
		afterimage.Parent = workspace

		TweenService:Create(afterimage, TweenInfo.new(0.4 - speed * 0.01), { Color = Color3.new(0, 0.5, 1) }):Play()
		TweenService:Create(afterimage, TweenInfo.new(0.4 - speed * 0.01), { Transparency = 1 }):Play()
		Debris:AddItem(afterimage, 0.4 - speed * 0.01)
	end
end

local function startLoop(id: number)
	if id ~= chatId then
		return
	end

	setState("Typing")

	local track = ChatController.PlayAnimation(ChatController.AnimationIds.Loop, true)
	if not track then
		return
	end
	local sfx = ChatController.PlaySfx(ChatController.SfxIds.Loop, true)

	local speed = ChatController.LoopSpeed.Start
	local afterimageElapsed = 0
	track:AdjustSpeed(speed)

	local connection
	connection = RunService.PreRender:Connect(function(dt)
		if chatId ~= id or activeTrack ~= track then
			connection:Disconnect()
			connection = nil
		end

		speed = math.min(ChatController.LoopSpeed.Max, speed + ChatController.LoopSpeed.Acceleration * dt)
		track:AdjustSpeed(speed)

		if speed >= 2 then
			afterimageElapsed += dt
			local interval = 0.1 - speed * 0.01
			if afterimageElapsed >= interval then
				afterimageElapsed = 0
				leaveHandAfterimages(speed)
			end
		end

		if activeSfx == sfx and sfx.Player then
			sfx.Player.PlaybackSpeed = speed
		end
	end)
end

local function getAnimator(): Animator?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end

	return humanoid:FindFirstChildOfClass("Animator") :: Animator?
end

local function unrigKeyboard()
	if keyboardWeld then
		keyboardWeld:Destroy()
		keyboardWeld = nil
	end

	if keyboard then
		keyboard:Destroy()
		keyboard = nil
	end
end

local function rigKeyboard(): boolean
	if keyboard then
		return true
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local template = ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Props"):FindFirstChild("Keyboard")
	if not template or not template:IsA("BasePart") then
		warn("[ChatController] Missing Assets.Props.Keyboard")
		return false
	end

	local clone = template:Clone()
	clone.Anchored = false
	clone.CanCollide = false
	clone.Massless = true

	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
		end
	end

	clone.Parent = character
	keyboard = clone
	keyboardWeld = CharacterUtils.RigInstance(rootPart, clone, KEYBOARD_OFFSET, true)

	return true
end

function ChatController.StopSfx()
	if activeSfx then
		activeSfx.Stop()
		activeSfx = nil
	end
end

function ChatController.PlaySfx(soundId: string | number, looped: boolean?, emitter: Instance?)
	local assetId = tostring(soundId)
	emitter = emitter or keyboard or (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
	ChatController.StopSfx()

	if not audioController or assetId == "" or not emitter then
		return nil
	end

	local soundAsset = if string.find(assetId, "rbxassetid://", 1, true) then assetId else `rbxassetid://{assetId}`
	activeSfx =
		audioController.PlayOn3D(soundAsset, ChatController.Sfx.Volume, ChatController.Sfx.Distance, emitter, looped)

	return activeSfx
end

function ChatController.StopAnimation(fadeTime: number?)
	local track = activeTrack
	local animation = activeAnimation
	activeTrack = nil
	activeAnimation = nil

	if track then
		track:Stop(fadeTime or 0.1)
		track:Destroy()
	end
	if animation then
		animation:Destroy()
	end
end

function ChatController.PlayAnimation(animationId: string, looped: boolean?, onStopped: (() -> ())?): AnimationTrack?
	local animator = getAnimator()
	local assetId = tostring(animationId)
	if not animator or assetId == "" then
		return nil
	end

	ChatController.StopAnimation()

	local animation = Instance.new("Animation")
	animation.AnimationId = assetId
	animation.Parent = animator

	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = looped == true
	track:Play(0.1)

	activeTrack = track
	activeAnimation = animation

	track.Stopped:Once(function()
		if activeTrack ~= track then
			return
		end

		activeTrack = nil
		activeAnimation = nil
		track:Destroy()
		animation:Destroy()

		if onStopped then
			onStopped()
		end
	end)

	return track
end

function ChatController.OnChatStarted()
	chatId += 1
	local id = chatId

	ChatController.StopAnimation(0)
	unrigKeyboard()
	setState("Started")

	if not rigKeyboard() then
		setState("Normal")
		return
	end
	ChatController.PlaySfx(ChatController.SfxIds.Start)

	local startTrack = ChatController.PlayAnimation(ChatController.AnimationIds.Start, false, function()
		startLoop(id)
	end)

	if not startTrack then
		startLoop(id)
	end
end

function ChatController.OnChatCancelled()
	chatId += 1
	ChatController.StopAnimation()
	ChatController.StopSfx()
	unrigKeyboard()
	setState("Normal")
end

function ChatController.OnChatSent()
	if ChatController.CurrentState ~= "Started" and ChatController.CurrentState ~= "Typing" then
		return
	end

	chatId += 1
	local id = chatId
	setState("Sent")
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	ChatController.PlaySfx(ChatController.SfxIds.Enter, false, rootPart)

	local enterTrack = ChatController.PlayAnimation(ChatController.AnimationIds.Enter, false, function()
		if id ~= chatId then
			return
		end

		unrigKeyboard()
		setState("Normal")
	end)

	if not enterTrack then
		unrigKeyboard()
		setState("Normal")
	end
end

function ChatController.Init(registry)
	audioController = registry:GetService("AudioController")
end

function ChatController.Start()
	TextChatService.OnIncomingMessage = formatRoleTag

	UserInputService.InputBegan:Connect(function(input)
		if not inputBar.IsFocused then
			return
		end

		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			sendPending = true

			task.delay(0.1, function()
				if not sendPending or isSending then
					return
				end

				sendPending = false
				if not inputBar.IsFocused then
					ChatController.OnChatCancelled()
				end
			end)
		end
	end)

	inputBar:GetPropertyChangedSignal("IsFocused"):Connect(function()
		if inputBar.IsFocused then
			isSending = false
			sendPending = false
			ChatController.OnChatStarted()
		elseif not isSending and not sendPending then
			ChatController.OnChatCancelled()
		end
	end)

	TextChatService.SendingMessage:Connect(function(message: TextChatMessage)
		isSending = true
		sendPending = false
		ChatController.OnChatSent()

		if message.Text:match("^!L%s*$") then
			UI.ShowLoading()
			task.delay(8, UI.HideLoading)
		end
	end)

	player.CharacterAdded:Connect(ChatController.OnChatCancelled)
end

return ChatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="449">
          <Properties>
            <string name="Name">DashClient</string>
            <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local InputController = require(ReplicatedStorage.Shared.Controllers.InputController)
local EmitParticles = require(ReplicatedStorage.Shared.Modules.Utils.EmitParticles)

local DashInput
local PLAYER = Players.LocalPlayer
local DASH_COOLDOWN = 0.8

local DashTracks = {}
local LastDashTime = 0
local DASH_VFX_LIFETIME = 2

type DashDirection = "Forward" | "Backward" | "Left" | "Right"

local function GetDashDirection(dashVector: Vector2, rootPart: BasePart): DashDirection
	local lookVector = rootPart.CFrame.LookVector
	local rightVector = rootPart.CFrame.RightVector
	local forwardDot = dashVector.X * lookVector.X + dashVector.Y * lookVector.Z
	local rightDot = dashVector.X * rightVector.X + dashVector.Y * rightVector.Z

	if math.abs(forwardDot) >= math.abs(rightDot) then
		return if forwardDot >= 0 then "Forward" else "Backward"
	end

	return if rightDot >= 0 then "Right" else "Left"
end

local DashClient = {}
DashClient.DashInfo = {
	Forward = { Speed = 130, Duration = 0.2, AnimationId = "rbxassetid://112359286044213" },
	Backward = { Speed = 130, Duration = 0.2, AnimationId = "rbxassetid://99143998068665" },
	Left = { Speed = 130, Duration = 0.2, AnimationId = "rbxassetid://139209194154392 " },
	Right = { Speed = 130, Duration = 0.2, AnimationId = "rbxassetid://131581512006061" },
}

local function LoadDashTracks(character: Model)
	table.clear(DashTracks)

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	local animator = humanoid:WaitForChild("Animator") :: Animator

	for direction, dashInfo in DashClient.DashInfo do
		local animation = Instance.new("Animation")
		animation.Name = `Dash{direction}`
		animation.AnimationId = dashInfo.AnimationId
		animation.Parent = animator

		local track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		DashTracks[direction] = track
	end
end

local function PlayDashVFX(rootPart: BasePart, dashVector: Vector2)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local vfx = assets and assets:FindFirstChild("VFX")
	local template = vfx and vfx:FindFirstChild("Dash")
	if not template then
		return
	end

	local effect = template:Clone()
	if not effect:IsA("PVInstance") then
		warn("[DashClient] Assets.VFX.Dash must be a Model or BasePart")
		effect:Destroy()
		return
	end

	local direction = Vector3.new(dashVector.X, 0, dashVector.Y)
	effect:PivotTo(CFrame.lookAt(rootPart.Position, rootPart.Position + direction))
	effect.Parent = workspace

	EmitParticles(effect)
	Debris:AddItem(effect, DASH_VFX_LIFETIME)
end

function DashClient:Dash()
	if PLAYER:GetAttribute("SummonControlsLocked") then
		return
	end

	local character = PLAYER.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not rootPart or humanoid.Health <= 0 then
		return
	end

	local moveDirection = humanoid.MoveDirection
	local dashVector = Vector2.new(moveDirection.X, moveDirection.Z)

	if dashVector.Magnitude <= 0.001 then
		local lookVector = rootPart.CFrame.LookVector
		dashVector = Vector2.new(lookVector.X, lookVector.Z)
	end
	dashVector = dashVector.Unit

	local dashDirection = GetDashDirection(dashVector, rootPart)
	local dashInfo = self.DashInfo[dashDirection]
	local now = os.clock()
	if now - LastDashTime < DASH_COOLDOWN then
		return
	end
	LastDashTime = now

	DashTracks[dashDirection]:Play(0.1)
	PlayDashVFX(rootPart, dashVector)

	local dashAttachment = rootPart:FindFirstChild("DashAttachment") or Instance.new("Attachment")
	dashAttachment.Name = "DashAttachment"
	dashAttachment.Parent = rootPart

	local linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Name = "DashVelocity"
	linearVelocity.Attachment0 = dashAttachment
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector

	local force = rootPart.AssemblyMass * 2500
	linearVelocity.ForceLimitsEnabled = true
	linearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	linearVelocity.MaxAxesForce = Vector3.new(force, force, force)

	linearVelocity.VectorVelocity = Vector3.new(dashVector.X, 0, dashVector.Y) * dashInfo.Speed
	linearVelocity.Parent = dashAttachment

	Debris:AddItem(linearVelocity, dashInfo.Duration)
end

function DashClient.Init() end

function DashClient.Start()
	LoadDashTracks(PLAYER.Character or PLAYER.CharacterAdded:Wait())
	PLAYER.CharacterAdded:Connect(LoadDashTracks)

	local iScope = InputController.Scope
	local iAction = InputController.Action
	local iInfo = InputController.Info

	DashInput = iScope("DashInput", {
		iAction("Dash", iInfo({ Enum.KeyCode.Q })),
	}):Enable()

	DashInput.Actions.Dash.Began:Connect(function()
		DashClient:Dash()
	end)
end

return DashClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="450">
          <Properties>
            <string name="Name">DataClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage.Shared.Net.client)
local Vide = require(ReplicatedStorage.Packages.Vide)

local DataClient = {}

DataClient.Coins = Vide.source(0)
DataClient.Gems = Vide.source(0)
DataClient.Blossom = Vide.source(0)
DataClient.Level = Vide.source(1)
DataClient.Exp = Vide.source(0)
DataClient.Quests = Vide.source({})

function DataClient.ExpLogic(currentLevel: number): number
	return 50 * (currentLevel + math.ceil(currentLevel / 10)) + 50
end

function DataClient.GetMaxExp(): number
	return DataClient.ExpLogic(DataClient.Level())
end

function DataClient.FormatNumber(n: number): string
	local formatted = tostring(math.floor(n or 0))
	local k
	while true do
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return formatted
end

local function syncFromLeaderstats(player: Player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end

	local coins = leaderstats:FindFirstChild("Coins") :: IntValue?
	if coins then
		DataClient.Coins(coins.Value)
		coins:GetPropertyChangedSignal("Value"):Connect(function()
			DataClient.Coins(coins.Value)
		end)
	end

	local gems = leaderstats:FindFirstChild("Gems") :: IntValue?
	if gems then
		DataClient.Gems(gems.Value)
		gems:GetPropertyChangedSignal("Value"):Connect(function()
			DataClient.Gems(gems.Value)
		end)
	end

	local blossom = leaderstats:FindFirstChild("Blossom") :: IntValue?
	if blossom then
		DataClient.Blossom(blossom.Value)
		blossom:GetPropertyChangedSignal("Value"):Connect(function()
			DataClient.Blossom(blossom.Value)
		end)
	end

	local level = leaderstats:FindFirstChild("Level") :: IntValue?
	if level then
		DataClient.Level(level.Value)
		level:GetPropertyChangedSignal("Value"):Connect(function()
			DataClient.Level(level.Value)
		end)
	end
end

function DataClient.FetchQuests()
	task.spawn(function()
		local ok, quests = pcall(function()
			return Net.DataService.GetDataValue.Invoke("Quests"):expect()
		end)
		if ok and quests ~= nil then
			DataClient.Quests(quests or {})
		end
	end)
end

function DataClient.FetchAll()
	for _, key in ipairs({ "Coins", "Gems", "Blossom", "Level", "Exp", "Quests" }) do
		task.spawn(function()
			local ok, val = pcall(function()
				return Net.DataService.GetDataValue.Invoke(key):expect()
			end)
			if ok and val ~= nil then
				if key == "Coins" then
					DataClient.Coins(val)
				elseif key == "Gems" then
					DataClient.Gems(val)
				elseif key == "Blossom" then
					DataClient.Blossom(val)
				elseif key == "Level" then
					DataClient.Level(val)
				elseif key == "Exp" then
					DataClient.Exp(val)
				elseif key == "Quests" then
					DataClient.Quests(val or {})
				end
			end
		end)
	end
end

function DataClient.Init()
	local player = Players.LocalPlayer
	if not player then
		return
	end

	task.spawn(function()
		local leaderstats = player:WaitForChild("leaderstats", 5)
		if leaderstats then
			syncFromLeaderstats(player)
		end
		player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" then
				syncFromLeaderstats(player)
			end
		end)
	end)
end

function DataClient.Start()
	if not RunService:IsClient() then
		return
	end

	DataClient.FetchAll()

	Net.DataService.CurrencyChanged.On(function(data)
		if typeof(data) ~= "table" or not data.CurrencyName then
			return
		end

		if data.CurrencyName == "Coins" then
			DataClient.Coins(data.CurrencyValue)
		elseif data.CurrencyName == "Gems" then
			DataClient.Gems(data.CurrencyValue)
		elseif data.CurrencyName == "Blossom" then
			DataClient.Blossom(data.CurrencyValue)
			DataClient.FetchQuests()
		elseif data.CurrencyName == "Quests" then
			DataClient.FetchQuests()
		elseif data.CurrencyName == "Level" then
			DataClient.Level(data.CurrencyValue)
		elseif data.CurrencyName == "Exp" then
			DataClient.Exp(data.CurrencyValue)
		end
	end)
end

return DataClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="451">
          <Properties>
            <string name="Name">DialogueClient</string>
            <string name="Source"><![CDATA[-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage.Shared.Net.client)
local NpcDialogueData = require(ReplicatedStorage.Settings.Data.NpcDialogueData)
local AudioController = require(script.Parent.AudioController)
local SoundLibrary = require(ReplicatedStorage.Settings.Data.NPCS.Sounds.SoundLibrary)
local Vide = require(ReplicatedStorage.Packages.Vide)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)

local DialogueClient = {}
DialogueClient.IsOpen = Vide.source(false)
local UIController

local playerGui: PlayerGui?
local dialogueGui: ScreenGui?
local backdrop: Frame?
local choiceContainer: Frame?
local choiceTemplate: Frame?
local dialogueFrame: Frame?
local frameScale: UIScale?
local nameText: TextLabel?
local npcInfoText: TextLabel?
local contextText: TextLabel?
local fastButton: GuiButton?
local headerMidFrame: Frame?
local leftWing: ImageLabel?
local rightWing: ImageLabel?

local originalFramePosition = UDim2.fromScale(0.5, 0.747184)
local originalChoicePosition = UDim2.fromScale(0.79, 0)
local originalCameraFOV = 70

local CurrentNpcId: string?
local CurrentDialogueId: string?
local _isOpen = false
local _suppressClose = false
local _pendingClose = false
local _skipRequested = false
local _currentDialogueCoroutine: thread?
local _activeTweens: { Tween } = {}
local _wingPulseTween: Tween?

-------------------------------------------------
--// Helper Functions
-------------------------------------------------
local function findDescendant(instance: Instance?, name: string): Instance?
	if not instance then
		return nil
	end
	return instance:FindFirstChild(name, true)
end

local function stopAllTweens()
	for _, tw in ipairs(_activeTweens) do
		pcall(function()
			tw:Cancel()
		end)
	end
	table.clear(_activeTweens)
end

local function trackTween(tw: Tween): Tween
	table.insert(_activeTweens, tw)
	tw.Completed:Once(function()
		local idx = table.find(_activeTweens, tw)
		if idx then
			table.remove(_activeTweens, idx)
		end
	end)
	tw:Play()
	return tw
end

local function getChoiceContainer(root: Instance?): Frame?
	if not root then
		return nil
	end

	local container = root:FindFirstChild("DialogueChoiceFrame") or root:FindFirstChild("Frame")
	if container and container:IsA("Frame") then
		return container
	end

	for _, child in ipairs(root:GetChildren()) do
		if child:IsA("Frame") and (child.Name == "DialogueChoiceFrame" or child.Name == "Frame") then
			return child
		end
	end

	return nil
end

local function clearChoices(animateOut: boolean?)
	if not choiceContainer or not choiceTemplate then
		return
	end

	local clones = {}
	for _, child in ipairs(choiceContainer:GetChildren()) do
		if child ~= choiceTemplate and child.Name:match("^ChoiceClone") then
			table.insert(clones, child)
		end
	end

	if animateOut and #clones > 0 then
		for index, clone in ipairs(clones) do
			local scale = clone:FindFirstChildOfClass("UIScale")
			if scale then
				trackTween(TweenService:Create(
					scale,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Scale = 0.6 }
				))
			end
			task.delay(0.03 * (index - 1), function()
				pcall(function()
					local tw = trackTween(TweenService:Create(
						clone,
						TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
						{ Position = UDim2.new(1.5, 0, 0, 0), BackgroundTransparency = 1 }
					))
					tw.Completed:Once(function()
						clone:Destroy()
					end)
				end)
			end)
		end
	else
		for _, clone in ipairs(clones) do
			clone:Destroy()
		end
	end
end

local function setTextObject(textObject: Instance?, value: string?)
	if textObject and textObject:IsA("TextLabel") then
		textObject.Text = value or ""
	end
end

-------------------------------------------------
--// Camera Focus Transition (Cinematic Zoom)
-------------------------------------------------
local function setCameraDialogueMode(active: boolean)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	if active then
		originalCameraFOV = camera.FieldOfView
		trackTween(TweenService:Create(
			camera,
			TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ FieldOfView = 62 }
		))
	else
		trackTween(TweenService:Create(
			camera,
			TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ FieldOfView = originalCameraFOV or 70 }
		))
	end
end

-------------------------------------------------
--// Choice Creation & Staggered Swipe-in (싹- 싹- 싹-)
-------------------------------------------------
local function createChoiceClone(choice: { Text: string, Next: string, Action: string? }, index: number)
	if not choiceTemplate or not choiceContainer then
		return
	end

	local clone = choiceTemplate:Clone()
	clone.Name = "ChoiceClone" .. tostring(index)
	clone.LayoutOrder = index
	clone.Visible = true
	-- 초기 상태: 화면 오른쪽 밖 (1.6)에서 대기
	clone.Position = UDim2.new(1.6, 0, 0, 0)
	clone.BackgroundTransparency = 0.5
	clone.Parent = choiceContainer

	local choiceScale = clone:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	choiceScale.Name = "ChoiceScale"
	choiceScale.Scale = 0.8
	choiceScale.Parent = clone

	local stroke = clone:FindFirstChildOfClass("UIStroke")
	local textLabel: TextLabel? = nil
	local button: TextButton? = nil

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("TextLabel") and not textLabel then
			textLabel = desc
		elseif desc:IsA("TextButton") and not button then
			button = desc
		end
	end

	if textLabel then
		textLabel.Text = choice.Text or ""
		textLabel.RichText = true
		textLabel.TextScaled = true
		textLabel.TextTransparency = 0
		textLabel.TextColor3 = Color3.new(1, 1, 1)
	end

	-- 버튼 개별 트윈 충돌 방지 맵
	local itemTweens: { [Instance]: Tween } = {}
	local function playItemTween(instance: Instance, tweenInfo: TweenInfo, properties: { [string]: any }): Tween
		if itemTweens[instance] then
			pcall(function()
				itemTweens[instance]:Cancel()
			end)
		end
		local tw = TweenService:Create(instance, tweenInfo, properties)
		itemTweens[instance] = tw
		tw:Play()
		return tw
	end

	-- 🌟 핵심 연출: 오른쪽 밖에서 차례대로 "싹- 싹- 싹-" 날아와 찰지게 꽂히는 스와이프 등장
	task.delay((index - 1) * 0.08, function()
		if not clone.Parent then
			return
		end

		playItemTween(
			clone,
			TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0 }
		)
		playItemTween(
			choiceScale,
			TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1.0 }
		)
	end)

	-- 🌟 쫀득한 Hover / Press / Selection 인터랙션
	if button then
		local isHovered = false
		local isPressed = false

		button.MouseEnter:Connect(function()
			if isPressed then
				return
			end
			isHovered = true

			-- 마우스 올렸을 때: 왼쪽으로 살짝 튀어나옴 + 1.05x 확대 + 골드 테두리 발광
			playItemTween(
				clone,
				TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Position = UDim2.new(-0.06, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(65, 80, 100) }
			)
			playItemTween(
				choiceScale,
				TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Scale = 1.05 }
			)

			if stroke then
				playItemTween(
					stroke,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Color = Color3.fromRGB(255, 215, 75), Thickness = 2.8 }
				)
			end

			if textLabel then
				playItemTween(
					textLabel,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextColor3 = Color3.fromRGB(255, 240, 150), TextTransparency = 0 }
				)
			end
		end)

		button.MouseLeave:Connect(function()
			isHovered = false
			isPressed = false

			-- 마우스 나갈 때: 제자리로 100% 복귀
			playItemTween(
				clone,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Color3.fromRGB(45, 55, 64) }
			)
			playItemTween(
				choiceScale,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = 1.0 }
			)

			if stroke then
				playItemTween(
					stroke,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Color = Color3.fromRGB(120, 121, 105), Thickness = 2 }
				)
			end

			if textLabel then
				playItemTween(
					textLabel,
					TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ TextColor3 = Color3.new(1, 1, 1), TextTransparency = 0 }
				)
			end
		end)

		button.MouseButton1Down:Connect(function()
			isPressed = true
			playItemTween(
				choiceScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = 0.94 }
			)
			playItemTween(
				clone,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ BackgroundColor3 = Color3.fromRGB(35, 45, 55) }
			)
		end)

		button.MouseButton1Up:Connect(function()
			isPressed = false
			local targetScale = isHovered and 1.05 or 1.0
			local targetPos = isHovered and UDim2.new(-0.06, 0, 0, 0) or UDim2.new(0, 0, 0, 0)
			playItemTween(
				choiceScale,
				TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Scale = targetScale }
			)
			playItemTween(
				clone,
				TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Position = targetPos }
			)
		end)

		button.MouseButton1Click:Connect(function()
			-- 🌟 클릭 피드백: 선택한 버튼 팝핑 & 나머지 버튼 빠른 퇴장
			playItemTween(
				choiceScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = 1.08 }
			)
			playItemTween(
				clone,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ BackgroundColor3 = Color3.fromRGB(80, 100, 130) }
			)

			-- 다른 선택지들은 오른쪽으로 즉시 슬라이드 퇴장
			if choiceContainer then
				for _, other in ipairs(choiceContainer:GetChildren()) do
					if other ~= clone and other:IsA("GuiObject") and other ~= choiceTemplate then
						TweenService:Create(
							other,
							TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
							{ Position = UDim2.new(1.6, 0, 0, 0), BackgroundTransparency = 1 }
						):Play()
					end
				end
			end

			task.delay(0.12, function()
				DialogueClient.ChooseDialogue(index)
			end)
		end)
	end
end

-------------------------------------------------
--// Typewriter Animation
-------------------------------------------------
local function animateText(
	textObject: TextLabel,
	fullText: string,
	typingSoundName: string?,
	onChoicesTriggered: (() -> ())?,
	onComplete: (() -> ())?
)
	if _currentDialogueCoroutine then
		coroutine.close(_currentDialogueCoroutine)
	end

	_skipRequested = false

	_currentDialogueCoroutine = coroutine.create(function()
		textObject.Text = fullText
		textObject.MaxVisibleGraphemes = 0

		local sound = typingSoundName and pcall(function()
			return SoundLibrary(typingSoundName)
		end) and SoundLibrary(typingSoundName) or nil
		local soundId: string?
		if sound and typeof(sound) == "Instance" and sound:IsA("Sound") then
			soundId = sound.SoundId
		elseif sound and typeof(sound) == "string" then
			soundId = sound
		end

		local plainText = string.gsub(fullText, "<[^>]->", "")
		local utf8Len = utf8.len(plainText) or #plainText
		local triggerIndex = math.max(1, math.floor(utf8Len * 0.25))
		local choicesTriggered = false

		local i = 1
		while i <= utf8Len do
			textObject.MaxVisibleGraphemes = i

			if not _skipRequested and soundId and i % 2 == 1 then
				AudioController.PlayOn2D(soundId, 0.28)
			end

			if not choicesTriggered and i >= triggerIndex then
				choicesTriggered = true
				if onChoicesTriggered then
					pcall(onChoicesTriggered)
				end
			end

			local startByte = utf8.offset(plainText, i)
			local nextByte = utf8.offset(plainText, i + 1)
			local char = if startByte and nextByte
				then string.sub(plainText, startByte, nextByte - 1)
				elseif startByte then string.sub(plainText, startByte, #plainText)
				else ""

			local typingSpeed: number
			if _skipRequested then
				typingSpeed = 0.005
			else
				if char == "." or char == "," or char == "!" or char == "?" then
					typingSpeed = 0.22
				elseif char == " " then
					typingSpeed = 0.02
				else
					typingSpeed = 0.035
				end
			end

			task.wait(typingSpeed)
			i += 1
		end

		textObject.MaxVisibleGraphemes = -1

		if not choicesTriggered then
			choicesTriggered = true
			if onChoicesTriggered then
				pcall(onChoicesTriggered)
			end
		end

		if type(onComplete) == "function" then
			pcall(onComplete)
		end
	end)

	coroutine.resume(_currentDialogueCoroutine)
end

-------------------------------------------------
--// GUI Setup
-------------------------------------------------
local function setupGui()
	if dialogueGui and dialogueFrame and choiceContainer then
		return
	end

	if not playerGui then
		local player = Players.LocalPlayer
		if player then
			playerGui = player:WaitForChild("PlayerGui", 5) :: PlayerGui?
		end
	end

	if not playerGui then
		return
	end

	dialogueGui = playerGui:FindFirstChild("DialogueGui") or playerGui:WaitForChild("DialogueGui", 5) :: ScreenGui?
	if not dialogueGui then
		return
	end

	backdrop = findDescendant(dialogueGui, "Backdrop") :: Frame?
	dialogueFrame = findDescendant(dialogueGui, "DialogueFram") :: Frame?
	if dialogueFrame then
		frameScale = dialogueFrame:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		frameScale.Name = "FramScale"
		frameScale.Parent = dialogueFrame
		originalFramePosition = dialogueFrame.Position
	end

	nameText = findDescendant(dialogueFrame, "NameText") :: TextLabel?
	npcInfoText = findDescendant(dialogueFrame, "NpcInfoText") :: TextLabel?
	contextText = findDescendant(dialogueFrame, "Context") :: TextLabel?
	headerMidFrame = findDescendant(dialogueFrame, "MidFrame") :: Frame?

	if headerMidFrame then
		leftWing = headerMidFrame:FindFirstChild("LeftSide") :: ImageLabel?
		rightWing = headerMidFrame:FindFirstChild("RightSide") :: ImageLabel?
	end

	choiceContainer = getChoiceContainer(dialogueGui)
	if choiceContainer then
		originalChoicePosition = choiceContainer.Position
	end
	choiceTemplate = choiceContainer and choiceContainer:FindFirstChild("Template") :: Frame?

	fastButton = findDescendant(dialogueFrame, "FastButton") :: GuiButton?
	if fastButton and fastButton:IsA("GuiButton") then
		fastButton.MouseButton1Click:Connect(function()
			DialogueClient.SkipTyping()
		end)
	end

	if dialogueGui then
		dialogueGui.Enabled = false
	end
end

-------------------------------------------------
--// Open & Close Dialogue Functions
-------------------------------------------------
local function openDialogue(npcId: string, dialogueId: string, isNodeTransition: boolean?)
	if not dialogueGui or not dialogueFrame or not choiceContainer then
		setupGui()
	end

	if not dialogueGui or not dialogueFrame or not contextText then
		warn("[DialogueClient] Dialogue UI 요소를 찾을 수 없음")
		return
	end

	local npcData = NpcDialogueData[npcId]
	if not npcData then
		warn(string.format("[DialogueClient] 대화 데이터를 찾을 수 없음: %s", tostring(npcId)))
		return
	end

	local dialogue = npcData.DialogueTree[dialogueId]
	if not dialogue then
		warn(string.format("[DialogueClient] 대화 노드를 찾을 수 없음: %s.%s", tostring(npcId), tostring(dialogueId)))
		return
	end

	CurrentNpcId = npcId
	CurrentDialogueId = dialogueId

	setTextObject(nameText, npcData.Name or npcId)
	if npcInfoText then
		setTextObject(npcInfoText, npcData.Info or "")
		npcInfoText.Visible = (npcData.Info ~= nil and npcData.Info ~= "")
	end

	-- 이전 선택지 청소 (노드 전환 시 부드러운 퇴장)
	clearChoices(isNodeTransition == true)

	if not dialogue.Choices or #dialogue.Choices == 0 then
		DialogueClient.Close()
		return
	end

	dialogueGui.Enabled = true
	dialogueFrame.Visible = true

	-- 1. 대화창 진입 연출 (카메라 줌인 + 백드롭 + 대화창 슬라이드업)
	if not isNodeTransition or not _isOpen then
		_isOpen = true
		DialogueClient.IsOpen(true)
		stopAllTweens()

		-- 카메라 줌인
		setCameraDialogueMode(true)

		-- 백드롭 페이드인
		if backdrop then
			backdrop.BackgroundTransparency = 1
			trackTween(TweenService:Create(
				backdrop,
				TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ BackgroundTransparency = 0.45 }
			))
		end

		-- 모든 텍스트/장식 투명도 복구
		if contextText then
			contextText.TextTransparency = 0
		end
		if nameText then
			nameText.TextTransparency = 0
		end
		for _, desc in ipairs(dialogueFrame:GetDescendants()) do
			if desc:IsA("ImageLabel") then
				desc.ImageTransparency = 0
			end
		end

		-- 메인 대화창 아래에서 위로 쫀득하게 등장
		if frameScale then
			frameScale.Scale = 0.9
			trackTween(TweenService:Create(
				frameScale,
				TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Scale = 1 }
			))
		end

		dialogueFrame.Position = originalFramePosition + UDim2.fromScale(0, 0.18)
		dialogueFrame.BackgroundTransparency = 0.8
		trackTween(TweenService:Create(
			dialogueFrame,
			TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Position = originalFramePosition, BackgroundTransparency = 0.08 }
		))

		-- 이름표 날개 호흡 애니메이션
		if leftWing and rightWing then
			if _wingPulseTween then
				_wingPulseTween:Cancel()
			end
			_wingPulseTween = TweenService:Create(
				leftWing,
				TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageColor3 = Color3.fromRGB(255, 225, 80) }
			)
			_wingPulseTween:Play()
		end
	end

	if choiceContainer then
		choiceContainer.Visible = false
	end

	_suppressClose = true
	_pendingClose = false

	-- 2. 타이핑 애니메이션 및 완료 시 선택지 팝업 트리거
	animateText(
		contextText,
		dialogue.Text or "",
		npcData.TypingSoundName,
		function()
			-- 선택지 생성 및 표시
			if choiceContainer then
				choiceContainer.Visible = true
			end
			for index, choice in ipairs(dialogue.Choices) do
				createChoiceClone(choice, index)
			end
		end,
		function()
			_suppressClose = false
			if _pendingClose then
				_pendingClose = false
				DialogueClient.Close()
			end
		end
	)
end

-------------------------------------------------
--// Public Controller Methods
-------------------------------------------------
function DialogueClient.ChooseDialogue(choiceIndex: number)
	if not CurrentNpcId or not CurrentDialogueId then
		return
	end

	local npcData = NpcDialogueData[CurrentNpcId]
	local nextId: string?
	local actionName: string?
	if npcData and CurrentDialogueId then
		local current = npcData.DialogueTree[CurrentDialogueId]
		if current and current.Choices and current.Choices[choiceIndex] then
			nextId = current.Choices[choiceIndex].Next
			actionName = current.Choices[choiceIndex].Action
		end
	end

	Net.DialogueService.ChooseDialogue.Fire({
		NpcId = CurrentNpcId,
		ChoiceIndex = choiceIndex,
	})

	if nextId then
		if actionName == "OpenEventShop" then
			DialogueClient.Close()
			task.delay(0.28, function()
				if UIController then
					UIController:Open("EventShop")
				end
			end)
			return
		end
		if nextId == "End" then
			DialogueClient.Close()
		else
			openDialogue(CurrentNpcId, nextId, true)
		end
	end
end

function DialogueClient.SkipTyping()
	_skipRequested = true
end

function DialogueClient.Close()
	if not _isOpen and (not dialogueGui or not dialogueGui.Enabled) then
		return
	end

	_isOpen = false
	DialogueClient.IsOpen(false)
	_suppressClose = false
	_pendingClose = false
	_skipRequested = false

	if _currentDialogueCoroutine then
		coroutine.close(_currentDialogueCoroutine)
		_currentDialogueCoroutine = nil
	end

	if _wingPulseTween then
		_wingPulseTween:Cancel()
		_wingPulseTween = nil
	end

	stopAllTweens()

	-- 1. 카메라 원래 시야각으로 부드럽게 복귀
	setCameraDialogueMode(false)

	-- 2. 백드롭 페이드아웃
	if backdrop then
		trackTween(TweenService:Create(
			backdrop,
			TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 1 }
		))
	end

	-- 3. 선택지들 오른쪽으로 부드럽게 페이드아웃
	if choiceContainer then
		for _, child in ipairs(choiceContainer:GetChildren()) do
			if child:IsA("GuiObject") and child ~= choiceTemplate then
				trackTween(TweenService:Create(
					child,
					TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ Position = UDim2.new(1.6, 0, 0, 0), BackgroundTransparency = 1 }
				))
				for _, desc in ipairs(child:GetDescendants()) do
					if desc:IsA("TextLabel") then
						trackTween(TweenService:Create(
							desc,
							TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
							{ TextTransparency = 1 }
						))
					end
				end
			end
		end
	end

	-- 4. 메인 대화창 및 텍스트/아이콘 자연스럽게 슬라이드 다운 & 페이드아웃
	if dialogueFrame and dialogueGui then
		local offScreenPos = originalFramePosition + UDim2.fromScale(0, 0.25)
		local closeTween = trackTween(TweenService:Create(
			dialogueFrame,
			TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = offScreenPos, BackgroundTransparency = 1 }
		))

		if frameScale then
			trackTween(TweenService:Create(
				frameScale,
				TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Scale = 0.9 }
			))
		end

		if contextText then
			trackTween(TweenService:Create(
				contextText,
				TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ TextTransparency = 1 }
			))
		end

		if nameText then
			trackTween(TweenService:Create(
				nameText,
				TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ TextTransparency = 1 }
			))
		end

		if npcInfoText then
			trackTween(TweenService:Create(
				npcInfoText,
				TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ TextTransparency = 1 }
			))
		end

		for _, desc in ipairs(dialogueFrame:GetDescendants()) do
			if desc:IsA("ImageLabel") then
				trackTween(TweenService:Create(
					desc,
					TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					{ ImageTransparency = 1 }
				))
			end
		end

		closeTween.Completed:Once(function()
			if not _isOpen and dialogueGui then
				dialogueGui.Enabled = false
				dialogueFrame.Visible = false
				dialogueFrame.Position = originalFramePosition
				dialogueFrame.BackgroundTransparency = 0.08
				if frameScale then
					frameScale.Scale = 1
				end
				if contextText then
					contextText.TextTransparency = 0
				end
				if nameText then
					nameText.TextTransparency = 0
				end
				if npcInfoText then
					npcInfoText.TextTransparency = 0
				end
				for _, desc in ipairs(dialogueFrame:GetDescendants()) do
					if desc:IsA("ImageLabel") then
						desc.ImageTransparency = 0
					end
				end
				clearChoices(false)
			end
		end)
	else
		clearChoices(false)
	end

	CurrentNpcId = nil
	CurrentDialogueId = nil
end

function DialogueClient.Init()
	UIController = ServiceRegistry:GetService("UIController")
	local player = Players.LocalPlayer
	if not player then
		return
	end

	playerGui = player:WaitForChild("PlayerGui", 5) :: PlayerGui?
	task.spawn(setupGui)
end

function DialogueClient.Start()
	if not RunService:IsClient() then
		return
	end

	Net.DialogueService.StartDialogue.On(function(npcId)
		openDialogue(npcId, "Start")
	end)

	Net.DialogueService.UpdateDialogueUI.On(function(data)
		if typeof(data) ~= "table" or not data.NpcId or not data.DialogueId then
			return
		end
		openDialogue(data.NpcId, data.DialogueId, true)
	end)

	Net.DialogueService.CloseDialogue.On(function()
		if _suppressClose then
			_pendingClose = true
			return
		end
		DialogueClient.Close()
	end)
end

return DialogueClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="452">
          <Properties>
            <string name="Name">EmojiClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local EmojiData = require(ReplicatedStorage.Settings.Data.EmojiData)
local Net = require(ReplicatedStorage.Shared.Net.client)

local ENTER_TWEEN = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local EXIT_TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local MAX_DISTANCE = 90

local activeBillboards: { [Player]: BillboardGui } = {}

local EmojiClient = {}

local function destroyBillboard(player: Player)
	local billboard = activeBillboards[player]
	if billboard then
		billboard:Destroy()
		activeBillboards[player] = nil
	end
end

local function createEmojiContent(parent: Instance, emojiConfig: EmojiData.EmojiConfig)
	if emojiConfig.Image == "" then
		local symbol = Instance.new("TextLabel")
		symbol.Name = "EmojiSymbol"
		symbol.BackgroundTransparency = 1
		symbol.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
		symbol.Position = UDim2.fromScale(0.1, 0.1)
		symbol.Size = UDim2.fromScale(0.8, 0.8)
		symbol.Text = emojiConfig.Symbol
		symbol.TextColor3 = Color3.fromRGB(54, 117, 231)
		symbol.TextScaled = true
		symbol.Parent = parent
		return
	end
	local image = Instance.new("ImageLabel")
	image.Name = "EmojiImage"
	image.AnchorPoint = Vector2.new(0.5, 0.5)
	image.BackgroundTransparency = 1
	image.Image = emojiConfig.Image
	image.Position = UDim2.fromScale(0.5, 0.46)
	image.ScaleType = Enum.ScaleType.Fit
	image.Size = UDim2.fromScale(0.78, 0.78)
	image.Parent = parent
end

local function showEmojiForPlayer(player: Player, emojiId: string)
	local emojiConfig = EmojiData.ByName[emojiId]
	if not emojiConfig then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not adornee or not adornee:IsA("BasePart") then
		return
	end

	destroyBillboard(player)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EmojiBillboard"
	billboard.Adornee = adornee
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = MAX_DISTANCE
	billboard.Size = UDim2.fromScale(3, 6)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 0, 0)
	billboard.Parent = character

	local group = Instance.new("CanvasGroup")
	group.Name = "Bubble"
	group.AnchorPoint = Vector2.new(0.5, 0.5)
	group.BackgroundColor3 = Color3.fromRGB(247, 251, 255)
	group.GroupTransparency = 1
	group.BackgroundTransparency = 1
	group.Position = UDim2.fromScale(0.5, 0.43)
	group.Size = UDim2.fromScale(1, 0.5)
	group.Parent = billboard

	createEmojiContent(group, emojiConfig)

	local scale = Instance.new("UIScale")
	scale.Scale = 0.45
	scale.Parent = group

	activeBillboards[player] = billboard

	TweenService:Create(group, ENTER_TWEEN, { GroupTransparency = 0 }):Play()
	TweenService:Create(scale, ENTER_TWEEN, { Scale = 1 }):Play()
	TweenService:Create(billboard, ENTER_TWEEN, { StudsOffsetWorldSpace = Vector3.new(0, 2.5, 0) }):Play()

	task.delay(emojiConfig.Duration, function()
		if activeBillboards[player] ~= billboard or not billboard.Parent then
			return
		end

		TweenService:Create(group, EXIT_TWEEN, { GroupTransparency = 1 }):Play()
		local exitScale = TweenService:Create(scale, EXIT_TWEEN, { Scale = 0.75 })
		exitScale:Play()
		exitScale.Completed:Wait()

		if activeBillboards[player] == billboard then
			destroyBillboard(player)
		end
	end)
end

function EmojiClient.ShowEmoji(emojiId: string)
	local emojiConfig = EmojiData.ByName[emojiId]
	if not emojiConfig then
		warn(`[EmojiClient] Emoji data not found: {emojiId}`)
		return
	end

	Net.EmojiService.RequestShowEmoji
		.Invoke({ EmojiId = emojiId })
		:andThen(function(success: boolean)
			if not success then
				warn(`[EmojiClient] Server rejected emoji: {emojiId}`)
			end
		end)
		:catch(function(err: any)
			warn(`[EmojiClient] Network error: {err}`)
		end)
end

function EmojiClient.Init() end

function EmojiClient.Start()
	Net.EmojiService.EmojiShown.On(function(data: { Player: unknown, EmojiId: string })
		local targetPlayer = data.Player
		if typeof(targetPlayer) ~= "Instance" or not targetPlayer:IsA("Player") then
			return
		end

		showEmojiForPlayer(targetPlayer :: Player, data.EmojiId)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		destroyBillboard(player)
	end)
end

return EmojiClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="453">
          <Properties>
            <string name="Name">EmoteClient</string>
            <string name="Source"><![CDATA[--// EmoteClient Controller
-- Orchestrates the emote system: coordinates local playback,
-- network communication, sprint toggling, and per-player observation.
--
-- Public API (unchanged from previous architecture):
--   EmoteClient.PlayEmote(emoteId)     — Request server to play emote
--   EmoteClient.StopEmote()            — Stop emote and notify server
--   EmoteClient.StartLocalEmote(id)    — Start emote locally (server-confirmed)
--   EmoteClient.StopLocalEmote()       — Stop emote locally (no network)
--   EmoteClient.Init()                 — Initialize state
--   EmoteClient.Start()                — Start observation and net listeners

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-------------------------------------------------
--// Dependencies
-------------------------------------------------
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local Net = require(ReplicatedStorage.Shared.Net.client)
local CharacterUtils = require(script.CharacterUtils)
local ServiceUtils = require(script.ServiceUtils)
local CharacterEmoteObserver = require(script.CharacterEmoteObserver)
local LocalEmotePlayer = require(ReplicatedStorage.Shared.Modules.UI.Emote.LocalEmotePlayer)

-------------------------------------------------
--// State
-------------------------------------------------
local localPlayer = Players.LocalPlayer
local emotePlayer: LocalEmotePlayer.LocalEmotePlayer
local characterObservers: { [Player]: CharacterEmoteObserver.CharacterEmoteObserver } = {}

-------------------------------------------------
--// EmoteClient Controller
-------------------------------------------------
local EmoteClient = {}

--[[ Starts an emote on the local player (called when server confirms). ]]
function EmoteClient.StartLocalEmote(emoteId: string)
	local emoteConfig = EmoteData.ByName[emoteId]
	if not emoteConfig then
		warn(`[EmoteClient] Emote data not found: {emoteId}`)
		return
	end

	local didStart = emotePlayer:Start(emoteId, emoteConfig)
	local sprintCtrl = ServiceUtils.Get("SprintClient")
	if sprintCtrl then
		if didStart then
			sprintCtrl.Disable()
		else
			sprintCtrl.Enable()
		end
	end
end

--[[ Stops the local player's emote without notifying the server. ]]
function EmoteClient.StopLocalEmote()
	emotePlayer:Stop()
end

--[[ Requests the server to play an emote (with cooldown check). ]]
function EmoteClient.PlayEmote(emoteId: string)
	if not emotePlayer:CheckCooldown() then
		return
	end

	local emoteConfig = EmoteData.ByName[emoteId]
	if not emoteConfig then
		warn(`[EmoteClient] Emote data not found: {emoteId}`)
		return
	end

	Net.EmoteService.RequestPlayEmote
		.Invoke({ EmoteId = emoteId })
		:andThen(function(success: boolean)
			if not success then
				warn(`[EmoteClient] Server rejected emote: {emoteId}`)
			end
		end)
		:catch(function(err: any)
			warn(`[EmoteClient] Network error: {err}`)
		end)
end

--[[ Stops the current emote and notifies the server. ]]
function EmoteClient.StopEmote()
	local hadEmote = emotePlayer:IsPlaying()
	emotePlayer:Stop()

	if hadEmote then
		Net.EmoteService.RequestStopEmote.Invoke():catch(function(err: any)
			warn(`[EmoteClient] StopEmote error: {err}`)
		end)
	end

	local sprintCtrl = ServiceUtils.Get("SprintClient")
	if sprintCtrl then
		sprintCtrl.Enable()
	end
end

-------------------------------------------------
--// Lifecycle
-------------------------------------------------

function EmoteClient.Init()
	emotePlayer = LocalEmotePlayer.new()

	-- When emote auto-stops (jump/freefall/track ended), notify server & re-enable sprint
	emotePlayer.OnAutoStopped = function()
		Net.EmoteService.RequestStopEmote.Invoke():catch(function(err: any)
			warn(`[EmoteClient] Auto-stop network error: {err}`)
		end)

		local sprintCtrl = ServiceUtils.Get("SprintClient")
		if sprintCtrl then
			sprintCtrl.Enable()
		end
	end
end

function EmoteClient.Start()
	-------------------------------------------------
	-- Player observation (SFX/VFX for all players)
	-------------------------------------------------
	local function observePlayer(player: Player)
		local function onCharacterAdded(character: Model)
			local oldObserver = characterObservers[player]
			if oldObserver then
				oldObserver:Destroy()
				characterObservers[player] = nil
			end

			characterObservers[player] = CharacterEmoteObserver.new(character)
		end

		if player.Character then
			task.spawn(onCharacterAdded, player.Character)
		end

		player.CharacterAdded:Connect(onCharacterAdded)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		observePlayer(player)
	end

	Players.PlayerAdded:Connect(observePlayer)

	Players.PlayerRemoving:Connect(function(player: Player)
		local observer = characterObservers[player]
		if observer then
			observer:Destroy()
			characterObservers[player] = nil
		end
	end)

	-------------------------------------------------
	-- Network event listeners
	-------------------------------------------------
	Net.EmoteService.EmoteStarted.On(function(data: { Player: unknown, EmoteId: string })
		local targetPlayer = data.Player :: Player?
		if targetPlayer == localPlayer and emotePlayer.CurrentEmoteId ~= data.EmoteId then
			EmoteClient.StartLocalEmote(data.EmoteId)
		end
	end)

	Net.EmoteService.EmoteStopped.On(function(data: { Player: unknown })
		local targetPlayer = data.Player :: Player?
		if targetPlayer == localPlayer and emotePlayer:IsPlaying() then
			EmoteClient.StopLocalEmote()

				local sprintCtrl = ServiceUtils.Get("SprintClient")
			if sprintCtrl then
				sprintCtrl.Enable()
			end
		end
	end)
end

return EmoteClient
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="454">
            <Properties>
              <string name="Name">CharacterEmoteObserver</string>
              <string name="Source"><![CDATA[--// CharacterEmoteObserver
-- Observes a character's Animator for emote animations and creates
-- EmoteTrackState instances to manage their SFX/VFX lifecycle.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local EmoteTrackState = require(script.Parent.EmoteTrackState)

-------------------------------------------------
--// CharacterEmoteObserver Class
-------------------------------------------------
local CharacterEmoteObserver = {}
CharacterEmoteObserver.__index = CharacterEmoteObserver

export type CharacterEmoteObserver = typeof(setmetatable({} :: {
	Character: Model,
	Connections: { RBXScriptConnection },
	ActiveTracks: { [AnimationTrack]: EmoteTrackState.EmoteTrackState },
}, CharacterEmoteObserver))

function CharacterEmoteObserver.new(character: Model): CharacterEmoteObserver
	local self = setmetatable({
		Character = character,
		Connections = {} :: { RBXScriptConnection },
		ActiveTracks = {} :: { [AnimationTrack]: EmoteTrackState.EmoteTrackState },
	}, CharacterEmoteObserver)

	self:_startObserving()
	return self
end

-------------------------------------------------
--// Private Methods
-------------------------------------------------

function CharacterEmoteObserver._startObserving(self: CharacterEmoteObserver)
	local humanoid = self.Character:WaitForChild("Humanoid", 5) :: Humanoid?
	if not humanoid then
		return
	end

	local animator = humanoid:WaitForChild("Animator", 5) :: Animator?
	if not animator then
		return
	end

	local function processTrack(track: AnimationTrack)
		local anim = track.Animation
		if not anim then
			return
		end

		local cleanId = string.match(anim.AnimationId, "%d+") or anim.AnimationId
		local emoteConfig = EmoteData.ByAnimationId[cleanId] or EmoteData.ByAnimationId[anim.AnimationId]
		if not emoteConfig then
			return
		end
		track:AdjustSpeed(emoteConfig.PlaybackSpeed or 1)

		if self.ActiveTracks[track] then
			return
		end

		local trackState = EmoteTrackState.new(self.Character, track, emoteConfig, function()
			self.ActiveTracks[track] = nil
		end)
		self.ActiveTracks[track] = trackState
	end

	local playConn = animator.AnimationPlayed:Connect(processTrack)
	table.insert(self.Connections, playConn)

	-- Process any tracks that are already playing
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		processTrack(track)
	end
end

-------------------------------------------------
--// Public Methods
-------------------------------------------------

function CharacterEmoteObserver.Destroy(self: CharacterEmoteObserver)
	for _, conn in ipairs(self.Connections) do
		conn:Disconnect()
	end
	table.clear(self.Connections)

	for _, trackState in pairs(self.ActiveTracks) do
		trackState:Destroy()
	end
	table.clear(self.ActiveTracks)
end

return CharacterEmoteObserver
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="455">
            <Properties>
              <string name="Name">CharacterUtils</string>
              <string name="Source"><![CDATA[--// CharacterUtils
-- Character-related utility functions for the emote system.

local CharacterUtils = {}

--[[ Returns the root part (HumanoidRootPart) of a character. ]]
function CharacterUtils.GetRootPart(character: Model): BasePart?
	return character.PrimaryPart or (character:FindFirstChild("HumanoidRootPart") :: BasePart?)
end

return CharacterUtils
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="456">
            <Properties>
              <string name="Name">EmoteTrackState</string>
              <string name="Source"><![CDATA[--// EmoteTrackState
-- Manages the lifecycle of a single emote AnimationTrack:
-- sound playback, keyframe events (SFX/VFX), and automatic cleanup.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EmitParticles = require(ReplicatedStorage.Shared.Modules.Utils.EmitParticles)
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local CharacterUtils = require(script.Parent.CharacterUtils)
local ServiceUtils = require(script.Parent.ServiceUtils)

-------------------------------------------------
--// Types
-------------------------------------------------
type EmoteConfig = EmoteData.EmoteConfig
type KeyframeEventData = EmoteData.KeyframeEventData

-------------------------------------------------
--// Constants
-------------------------------------------------
local DEFAULT_SOUND_VOLUME = 1
local DEFAULT_SOUND_DISTANCE = 100

-------------------------------------------------
--// EmoteTrackState Class
-------------------------------------------------
local EmoteTrackState = {}
EmoteTrackState.__index = EmoteTrackState

export type EmoteTrackState = typeof(setmetatable({} :: {
	Character: Model,
	Track: AnimationTrack,
	EmoteConfig: EmoteConfig,
	OnDestroy: () -> (),
	Connections: { RBXScriptConnection },
	Sounds: { any },
}, EmoteTrackState))

function EmoteTrackState.new(
	character: Model,
	track: AnimationTrack,
	emoteConfig: EmoteConfig,
	onDestroy: () -> ()
): EmoteTrackState
	local self = setmetatable({
		Character = character,
		Track = track,
		EmoteConfig = emoteConfig,
		OnDestroy = onDestroy,
		Connections = {} :: { RBXScriptConnection },
		Sounds = {} :: { any },
	}, EmoteTrackState)

	self:_initialize()
	return self
end

-------------------------------------------------
--// Initialization
-------------------------------------------------

function EmoteTrackState._initialize(self: EmoteTrackState)
	self:_setupSound()
	self:_setupKeyframeEvents()

	local stopConn = self.Track.Stopped:Once(function()
		self:Destroy()
	end)
	table.insert(self.Connections, stopConn)
end

function EmoteTrackState._setupSound(self: EmoteTrackState)
	local soundId = self.EmoteConfig.SoundId
	if not soundId then
		return
	end

	local rootPart = CharacterUtils.GetRootPart(self.Character)
	if not rootPart then
		return
	end

	local audioCtrl = ServiceUtils.Get("AudioController")
	if not audioCtrl then
		return
	end

	local soundPlayer = audioCtrl.PlayOn3D(
		soundId,
		self.EmoteConfig.SoundVolume or DEFAULT_SOUND_VOLUME,
		self.EmoteConfig.SoundDistance or DEFAULT_SOUND_DISTANCE,
		rootPart,
		self.EmoteConfig.SoundLooped,
		self.EmoteConfig.SoundDistance or DEFAULT_SOUND_DISTANCE
	)
	if soundPlayer then
		table.insert(self.Sounds, soundPlayer)
	end
end

function EmoteTrackState._setupKeyframeEvents(self: EmoteTrackState)
	local keyframeEvents = self.EmoteConfig.KeyframeEvents
	if not keyframeEvents then
		return
	end

	task.spawn(function()
		if self.Track.Length == 0 then
			self.Track:GetPropertyChangedSignal("Length"):Wait()
		end

		local keyframeConn = self.Track.KeyframeReached:Connect(function(keyframeName)
			local eventData = keyframeEvents[keyframeName]
			if eventData then
				self:_handleKeyframeEvent(eventData)
			end
		end)
		table.insert(self.Connections, keyframeConn)
	end)
end

-------------------------------------------------
--// Keyframe Event Handlers
-------------------------------------------------

function EmoteTrackState._handleKeyframeEvent(self: EmoteTrackState, eventData: KeyframeEventData)
	local rootPart = CharacterUtils.GetRootPart(self.Character)
	if not rootPart then
		return
	end

	if eventData.SFX then
		self:_playKeyframeSFX(eventData, rootPart)
	end

	if eventData.VFXRecipes then
		self:_playKeyframeVFXRecipes(eventData)
		return
	end

	if eventData.VFX then
		self:_playKeyframeVFX(eventData)
	end
end

function EmoteTrackState._playKeyframeSFX(self: EmoteTrackState, eventData: KeyframeEventData, rootPart: BasePart)
	local audioCtrl = ServiceUtils.Get("AudioController")
	if not audioCtrl then
		return
	end

	local soundPlayer = audioCtrl.PlayOn3D(
		eventData.SFX,
		eventData.Volume or DEFAULT_SOUND_VOLUME,
		eventData.Distance or DEFAULT_SOUND_DISTANCE,
		rootPart
	)
	if soundPlayer then
		table.insert(self.Sounds, soundPlayer)
	end
end

function EmoteTrackState._playKeyframeVFXRecipes(self: EmoteTrackState, eventData: KeyframeEventData)
	local vfxCtrl = ServiceUtils.Get("VFXController")
	if not vfxCtrl then
		return
	end

	local recipes = if typeof(eventData.VFXRecipes) == "table"
		then eventData.VFXRecipes
		else (vfxCtrl.GetRecipes(eventData.VFXRecipes, "Emote") or vfxCtrl.GetRecipes("Emote", eventData.VFXRecipes))

	if recipes then
		vfxCtrl.PlayVFX(recipes, self.Character, self.Character)
	end
end

function EmoteTrackState._playKeyframeVFX(self: EmoteTrackState, eventData: KeyframeEventData)
	local vfxCtrl = ServiceUtils.Get("VFXController")
	local recipes = vfxCtrl
		and vfxCtrl.GetRecipes
		and (vfxCtrl.GetRecipes(eventData.VFX, "Emote") or vfxCtrl.GetRecipes("Emote", eventData.VFX))

	if recipes then
		vfxCtrl.PlayVFX(recipes, self.Character, self.Character)
		return
	end

	local vfxTarget = self.Character:FindFirstChild(eventData.VFX, true)
	if vfxTarget then
		EmitParticles(vfxTarget)
	end
end

-------------------------------------------------
--// Cleanup
-------------------------------------------------

function EmoteTrackState.Destroy(self: EmoteTrackState)
	for _, sound in ipairs(self.Sounds) do
		if sound and typeof(sound.Stop) == "function" then
			sound:Stop()
		end
	end
	table.clear(self.Sounds)

	for _, conn in ipairs(self.Connections) do
		conn:Disconnect()
	end
	table.clear(self.Connections)

	if self.OnDestroy then
		self.OnDestroy()
	end
end

return EmoteTrackState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="457">
            <Properties>
              <string name="Name">ServiceUtils</string>
              <string name="Source"><![CDATA[--// ServiceUtils
-- Cached service locator for the emote system.
-- Avoids repeated ServiceRegistry:GetService() calls.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)

local ServiceUtils = {}

local cachedServices: { [string]: any } = {}

--[[ Returns a cached service from ServiceRegistry. Returns nil if not found. ]]
function ServiceUtils.Get(serviceName: string): any
	local cached = cachedServices[serviceName]
	if cached then
		return cached
	end

	local success, service = pcall(function()
		return ServiceRegistry:GetService(serviceName)
	end)

	if success and service then
		cachedServices[serviceName] = service
		return service
	end

	return nil
end

return ServiceUtils
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="458">
          <Properties>
            <string name="Name">IndexClient</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net.client)
local Promise = require(ReplicatedStorage.Packages.Promise)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local Vide = require(ReplicatedStorage.Packages.Vide)

export type Collection = {
	Units: { [string]: boolean },
	Items: { [string]: boolean },
}

local IndexClient = {}

IndexClient.Collection = Vide.source({ Units = {}, Items = {} } :: Collection)
IndexClient.Units = Vide.source({} :: { [string]: boolean })
IndexClient.Items = Vide.source({} :: { [string]: boolean })

local InventoryClient
local activeRequest = nil
local requestVersion = 0

local function setCollection(value: any): Collection
	local collection = if typeof(value) == "table" then table.clone(value) else {}
	collection.Units = if typeof(collection.Units) == "table" then collection.Units else {}
	collection.Items = if typeof(collection.Items) == "table" then collection.Items else {}
	IndexClient.Collection(collection)
	IndexClient.Units(collection.Units)
	IndexClient.Items(collection.Items)
	return collection
end

function IndexClient.Refresh()
	requestVersion += 1
	local version = requestVersion
	local request = Net.DataService.GetDataValue.Invoke("Collection"):andThen(function(value)
		if version == requestVersion then
			activeRequest = nil
			return setCollection(value)
		end
		return IndexClient.Collection()
	end):catch(function(err)
		if version == requestVersion then activeRequest = nil end
		return Promise.reject(err)
	end)
	activeRequest = request
	return request
end

function IndexClient.Fetch()
	return activeRequest or IndexClient.Refresh()
end

local function discoverUnit(towerName: string)
	local current = IndexClient.Units()
	if current[towerName] then return end
	local updated = table.clone(current)
	updated[towerName] = true
	local collection = table.clone(IndexClient.Collection())
	collection.Units = updated
	IndexClient.Collection(collection)
	IndexClient.Units(updated)
end

local function discoverCurrentItems(inventory)
	local ownedItems = inventory and inventory.Items
	if typeof(ownedItems) ~= "table" then return end
	local current = IndexClient.Items()
	local updated = table.clone(current)
	local changed = false
	for itemName, count in ownedItems do
		if typeof(count) == "number" and count > 0 and not updated[itemName] then
			updated[itemName] = true
			changed = true
		end
	end
	if changed then
		local collection = table.clone(IndexClient.Collection())
		collection.Items = updated
		IndexClient.Collection(collection)
		IndexClient.Items(updated)
	end
end

function IndexClient.Init()
	InventoryClient = ServiceRegistry:GetService("InventoryClient")
end

function IndexClient.Start()
	InventoryClient.TowerAdded:Connect(discoverUnit)
	InventoryClient.InventoryChanged:Connect(discoverCurrentItems)
	IndexClient.Refresh():catch(function(err)
		warn(`[IndexClient] Failed to load collection: {err}`)
	end)
end

return IndexClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="459">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--/Modules
local Input = require(ReplicatedStorage.Packages.Input)
local Signal = require(ReplicatedStorage.Packages.Signal)
local Fn = require(ReplicatedStorage.Shared.Modules.Utils.Fn)

local Keyboard = Input.Keyboard.new()
local Mouse = Input.Mouse.new()
local Touch = Input.Touch.new()

export type Scope = {
	Name: string,
	Priority: number,
	Sink: boolean,
	Enabled: boolean,

	Actions: { [string]: Action },
	Enable: (self: Scope) -> nil,
	Disable: (self: Scope) -> nil,
}
export type Action = {
	Name: string,
	Scope: Scope,
	ActionInfo: ActionInfo,
	Began: typeof(Signal.new()),
	Ended: typeof(Signal.new()),
}

export type ActionInfo = {
	KeyCodes: { Enum.KeyCode },
	GuiButtons: { GuiButton },
}

type Options = {
	Priority: number?,
	Sink: boolean?,
}
type Keycodes = Enum.KeyCode | Enum.UserInputState | "Touch" | "DoubleTap"

local KeyMap = {}

local lastTapTime = 0
local DOUBLE_TAP_THRESHOLD = 0.25

-------------------------------------------------
--// InputController
-------------------------------------------------
local InputController = {}

function InputController.Scope(scopeName: string, actions: { [string]: Action }, options: Options?): Scope
	local self = {}
	self.Name = scopeName
	self.Priority = (options and options.Priority) or 0
	self.Sink = (options and options.Sink) or false
	self.Enabled = false

	self.Actions = {}
	for _, action in actions do
		self.Actions[action.Name] = action
		action.Scope = self
	end

	self.Enable = function()
		self.Enabled = true

		return self
	end
	self.Disable = function()
		self.Enabled = false

		return self
	end

	self.Enabled = false

	return self
end

function InputController.Action(actionName: string, actionInfo: ActionInfo): Action
	local self = {}
	self.Name = actionName
	self.ActionInfo = actionInfo

	self.Scope = nil

	self.Began = Signal.new()
	self.Ended = Signal.new()

	if actionInfo.KeyCodes then
		for _, keyCode in actionInfo.KeyCodes do
			if not KeyMap[keyCode] then
				KeyMap[keyCode] = {}
			end
			table.insert(KeyMap[keyCode], self)
		end
	end
	if actionInfo.GuiButtons then
		for _, button in actionInfo.GuiButtons do
			button.MouseButton1Down:Connect(Fn.Bind(InputController._HandleButton, self, "Began"))
			button.MouseButton1Up:Connect(Fn.Bind(InputController._HandleButton, self, "Ended"))
		end
	end

	return self
end

function InputController.Info(keyCodes: Keycodes?, guiButtons: { GuiButton }?): ActionInfo
	return { KeyCodes = keyCodes, GuiButtons = guiButtons }
end

function InputController._HandleInput(inputState: string, keyCode: Keycodes, processed: boolean?)
	if processed then
		return
	end

	local keyActions = KeyMap[keyCode]
	if not keyActions then
		return
	end

	local candidates = {}

	for _, action in keyActions do
		if action.Scope and action.Scope.Enabled then
			table.insert(candidates, action)
			--action[inputState]:Fire()
		end
	end

	table.sort(candidates, function(a, b): boolean
		return a.Scope.Priority > b.Scope.Priority
	end)

	local currentPriority = 0
	local sinkEnabled = false
	for _, action in ipairs(candidates) do
		if currentPriority > action.Scope.Priority and sinkEnabled then
			break
		elseif currentPriority < action.Scope.Priority then
			currentPriority = action.Scope.Priority
			sinkEnabled = action.Scope.Sink
		end

		action[inputState]:Fire()
	end
end

function InputController._HandleButton(action: Action, inputState: string)
	if action.Scope and action.Scope.Enabled then
		action[inputState]:Fire()
	end
end

function InputController.Init() end

function InputController.Start()
	Keyboard.KeyDown:Connect(Fn.Bind(InputController._HandleInput, "Began"))
	Keyboard.KeyUp:Connect(Fn.Bind(InputController._HandleInput, "Ended"))

	Mouse.LeftDown:Connect(Fn.Bind(InputController._HandleInput, "Began", Enum.UserInputType.MouseButton1))
	Mouse.LeftUp:Connect(Fn.Bind(InputController._HandleInput, "Ended", Enum.UserInputType.MouseButton1))

	Touch.TouchStarted:Connect(function(_, processed: boolean?)
		InputController._HandleInput("Began", "Touch", processed)

		local currentTime = os.clock()
		if (currentTime - lastTapTime) <= DOUBLE_TAP_THRESHOLD then
			InputController._HandleInput("Began", "DoubleTap", processed)
		end
		lastTapTime = currentTime
	end)

	Touch.TouchEnded:Connect(Fn.Bind(InputController._HandleInput, "Ended", "Touch"))
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="460">
          <Properties>
            <string name="Name">InventoryClient</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net.client)
local Promise = require(ReplicatedStorage.Packages.Promise)
local Signal = require(ReplicatedStorage.Packages.Signal)
local ItemUtils = require(ReplicatedStorage.Shared.Modules.Utils.ItemUtils)
local NotificationFeed = require(ReplicatedStorage.Shared.Modules.UI.Notifications.NotificationFeed)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local Vide = require(ReplicatedStorage.Packages.Vide)

local MAX_TOWER_KEY_ID = 4_294_967_295
local MAX_LOADOUT_SIZE = 5
local MAX_EMOTE_SLOTS = 4
local MAX_EMOJI_SLOTS = 4

export type TowerKey = string | number
export type OwnedTowers = { [string]: { [string]: any } }
export type LoadoutEntry = {
	Name: string?,
	Key: string?,
	towerName: string?,
	towerKey: string?,
}
export type Loadout = { [string | number]: LoadoutEntry }
export type StackInventory = { [string]: number }
export type GeneralInventory = {
	Items: StackInventory,
	Skins: StackInventory,
	Emotes: StackInventory,
	Emojis: StackInventory,
	[string]: any,
}

type LoadoutRequestType = "Equip" | "Unequip" | "UnequipAll"
type TowerAddedData = { towerData: any, towerIndex: number, towerKeyId: number }
type TowerRemovedData = { towerIndex: number, towerKeyId: number }
type CountUpdatedData = { category: string, itemName: string, newCount: number }

local InventoryClient = {}

InventoryClient.Towers = Vide.source({} :: OwnedTowers)
InventoryClient.Loadout = Vide.source({} :: Loadout)
InventoryClient.Inventory = Vide.source({ Items = {}, Skins = {}, Emotes = {}, Emojis = {} } :: GeneralInventory)
InventoryClient.Items = Vide.source({} :: StackInventory)
InventoryClient.Skins = Vide.source({} :: StackInventory)
InventoryClient.Emotes = Vide.source({} :: StackInventory)
InventoryClient.Emojis = Vide.source({} :: StackInventory)
InventoryClient.EmoteLoadout = Vide.source({})
InventoryClient.EmojiLoadout = Vide.source({})

InventoryClient.TowersChanged = Signal.new()
InventoryClient.LoadoutChanged = Signal.new()
InventoryClient.InventoryChanged = Signal.new()
InventoryClient.TowerAdded = Signal.new()
InventoryClient.TowerRemoved = Signal.new()
InventoryClient.CountUpdated = Signal.new()

local towersRequest = nil
local loadoutRequest = nil
local inventoryRequest = nil
local emoteLoadoutRequest = nil
local emojiLoadoutRequest = nil
local towersLoaded = false
local loadoutLoaded = false
local inventoryLoaded = false
local emoteLoadoutLoaded = false
local emojiLoadoutLoaded = false
local towersRequestVersion = 0
local loadoutRequestVersion = 0
local inventoryRequestVersion = 0
local emoteLoadoutRequestVersion = 0
local emojiLoadoutRequestVersion = 0
local inventorySyncScheduled = false
local hasInventorySnapshot = false

local function normalizeItemStacks(rawItems: any): StackInventory
	return ItemUtils.NormalizeStacks(rawItems)
end

local function normalizeTowerKey(towerKey: TowerKey): (string?, number?)
	local keyId

	if typeof(towerKey) == "number" then
		keyId = towerKey
	else
		local keyIdText = string.match(towerKey, "^t_(%d+)$") or string.match(towerKey, "^(%d+)$")
		keyId = if keyIdText then tonumber(keyIdText) else nil
	end

	if not keyId or keyId % 1 ~= 0 or keyId < 0 or keyId > MAX_TOWER_KEY_ID then
		return nil, nil
	end

	return `t_{keyId}`, keyId
end

local function getTowerName(towerIndex: number): string?
	local towerInfo = TowerData.ByIndex[towerIndex]
	return if towerInfo then towerInfo.Name else nil
end

local function setTowers(towers: OwnedTowers)
	InventoryClient.Towers(towers)
	InventoryClient.TowersChanged:Fire(towers)
end

local function setLoadout(loadout: Loadout)
	InventoryClient.Loadout(loadout)
	InventoryClient.LoadoutChanged:Fire(loadout)
end

local function setInventory(inventory: GeneralInventory)
	local normalized = table.clone(inventory)
	normalized.Items = normalizeItemStacks(inventory.Items)
	normalized.Skins = if typeof(inventory.Skins) == "table" then inventory.Skins else {}
	normalized.Emotes = if typeof(inventory.Emotes) == "table" then inventory.Emotes else {}
	normalized.Emojis = if typeof(inventory.Emojis) == "table" then inventory.Emojis else {}
	if hasInventorySnapshot then
		local previousItems = InventoryClient.Items()
		for itemName, amount in normalized.Items do
			local gained = amount - (previousItems[itemName] or 0)
			if gained > 0 then
				NotificationFeed.PullItem(itemName, gained)
			end
		end
	end
	hasInventorySnapshot = true

	InventoryClient.Inventory(normalized)
	InventoryClient.Items(normalized.Items)
	InventoryClient.Skins(normalized.Skins)
	InventoryClient.Emotes(normalized.Emotes)
	InventoryClient.Emojis(normalized.Emojis)
	InventoryClient.InventoryChanged:Fire(normalized)
end

local function setEmoteLoadout(loadout)
	InventoryClient.EmoteLoadout(if typeof(loadout) == "table" then loadout else {})
end

local function setEmojiLoadout(loadout)
	InventoryClient.EmojiLoadout(if typeof(loadout) == "table" then loadout else {})
end

local function loadEmojiLoadout(forceRefresh: boolean?)
	if emojiLoadoutRequest and not forceRefresh then return emojiLoadoutRequest end
	if emojiLoadoutLoaded and not forceRefresh then return Promise.resolve(InventoryClient.EmojiLoadout()) end
	emojiLoadoutRequestVersion += 1
	local requestVersion = emojiLoadoutRequestVersion
	local request = Net.DataService.GetDataValue.Invoke("EmojiLoadout"):andThen(function(value)
		local loadout = if typeof(value) == "table" then value else {}
		if requestVersion == emojiLoadoutRequestVersion then
			emojiLoadoutLoaded = true
			emojiLoadoutRequest = nil
			setEmojiLoadout(loadout)
		end
		return loadout
	end):catch(function(err)
		if requestVersion == emojiLoadoutRequestVersion then emojiLoadoutRequest = nil end
		return Promise.reject(err)
	end)
	emojiLoadoutRequest = request
	return request
end

local function loadEmoteLoadout(forceRefresh: boolean?)
	if emoteLoadoutRequest and not forceRefresh then return emoteLoadoutRequest end
	if emoteLoadoutLoaded and not forceRefresh then return Promise.resolve(InventoryClient.EmoteLoadout()) end

	emoteLoadoutRequestVersion += 1
	local requestVersion = emoteLoadoutRequestVersion
	local request = Net.DataService.GetDataValue.Invoke("EmoteLoadout"):andThen(function(value)
		local loadout = if typeof(value) == "table" then value else {}
		if requestVersion == emoteLoadoutRequestVersion then
			emoteLoadoutLoaded = true
			emoteLoadoutRequest = nil
			setEmoteLoadout(loadout)
		end
		return loadout
	end):catch(function(err)
		if requestVersion == emoteLoadoutRequestVersion then emoteLoadoutRequest = nil end
		return Promise.reject(err)
	end)
	emoteLoadoutRequest = request
	return request
end

local function loadTowers(forceRefresh: boolean?)
	if towersRequest and not forceRefresh then
		return towersRequest
	end
	if towersLoaded and not forceRefresh then
		return Promise.resolve(InventoryClient.Towers())
	end

	towersRequestVersion += 1
	local requestVersion = towersRequestVersion

	local request = Net.DataService.GetDataValue
		.Invoke("OwnedTowers")
		:andThen(function(value)
			local towers = if typeof(value) == "table" then value else {}

			if requestVersion == towersRequestVersion then
				towersLoaded = true
				towersRequest = nil
				setTowers(towers)
			end

			return towers
		end)
		:catch(function(err)
			if requestVersion == towersRequestVersion then
				towersRequest = nil
			end

			return Promise.reject(err)
		end)

	towersRequest = request
	return request
end

local function loadLoadout(forceRefresh: boolean?)
	if loadoutRequest and not forceRefresh then
		return loadoutRequest
	end
	if loadoutLoaded and not forceRefresh then
		return Promise.resolve(InventoryClient.Loadout())
	end

	loadoutRequestVersion += 1
	local requestVersion = loadoutRequestVersion

	local request = Net.DataService.GetDataValue
		.Invoke("Loadout")
		:andThen(function(value)
			local loadout = if typeof(value) == "table" then value else {}

			if requestVersion == loadoutRequestVersion then
				loadoutLoaded = true
				loadoutRequest = nil
				setLoadout(loadout)
			end

			return loadout
		end)
		:catch(function(err)
			if requestVersion == loadoutRequestVersion then
				loadoutRequest = nil
			end

			return Promise.reject(err)
		end)

	loadoutRequest = request
	return request
end

local function loadInventory(forceRefresh: boolean?)
	if inventoryRequest and not forceRefresh then
		return inventoryRequest
	end
	if inventoryLoaded and not forceRefresh then
		return Promise.resolve(InventoryClient.Inventory())
	end

	inventoryRequestVersion += 1
	local requestVersion = inventoryRequestVersion
	local request = Net.DataService.GetDataValue
		.Invoke("Inventory")
		:andThen(function(value)
			local inventory = if typeof(value) == "table" then value else {}
			if requestVersion == inventoryRequestVersion then
				inventoryLoaded = true
				inventoryRequest = nil
				setInventory(inventory)
			end
			return inventory
		end)
		:catch(function(err)
			if requestVersion == inventoryRequestVersion then
				inventoryRequest = nil
			end
			return Promise.reject(err)
		end)

	inventoryRequest = request
	return request
end

local function getEntryTowerName(entry: LoadoutEntry): string?
	return entry.Name or entry.towerName
end

local function getEntryTowerKey(entry: LoadoutEntry): string?
	local towerKey = entry.Key or entry.towerKey
	if not towerKey then
		return nil
	end

	local normalizedKey = normalizeTowerKey(towerKey)
	return normalizedKey
end

local function requestLoadoutChange(requestType: LoadoutRequestType, towerName: string?, towerKey: TowerKey?)
	local payload = {
		requestType = requestType,
	}

	if requestType ~= "UnequipAll" then
		if typeof(towerName) ~= "string" or towerKey == nil then
			return Promise.resolve(false)
		end

		local _, towerKeyId = normalizeTowerKey(towerKey)
		if not towerKeyId then
			return Promise.resolve(false)
		end

		payload.targetTower = {
			towerName = towerName,
			towerKey = towerKeyId,
		}
	end

	return Net.LoadoutService.SetLoadout.Invoke(payload):andThen(function(success)
		if success ~= true then
			return false
		end

		return InventoryClient.RefreshLoadout():andThenReturn(true)
	end)
end

local function onTowerAdded(data: TowerAddedData)
	local towerName = getTowerName(data.towerIndex)
	if not towerName then
		warn(`[InventoryClient] Unknown tower index received: {data.towerIndex}`)
		return
	end

	local towerKey = `t_{data.towerKeyId}`
	local currentTowers = InventoryClient.Towers()
	local updatedTowers = table.clone(currentTowers)
	local towersOfType = table.clone(currentTowers[towerName] or {})

	towersOfType[towerKey] = data.towerData
	updatedTowers[towerName] = towersOfType
	setTowers(updatedTowers)
	InventoryClient.TowerAdded:Fire(towerName, towerKey, data.towerData)
end

local function onTowerRemoved(data: TowerRemovedData)
	local towerName = getTowerName(data.towerIndex)
	local towerKey = `t_{data.towerKeyId}`
	local currentTowers = InventoryClient.Towers()
	local currentTowersOfType = if towerName then currentTowers[towerName] else nil

	if not towerName or not currentTowersOfType or currentTowersOfType[towerKey] == nil then
		return
	end

	local updatedTowers = table.clone(currentTowers)
	local updatedTowersOfType = table.clone(currentTowersOfType)
	updatedTowersOfType[towerKey] = nil

	if next(updatedTowersOfType) then
		updatedTowers[towerName] = updatedTowersOfType
	else
		updatedTowers[towerName] = nil
	end

	setTowers(updatedTowers)
	InventoryClient.TowerRemoved:Fire(towerName, towerKey)
end

function InventoryClient.Load()
	return Promise.all({ loadTowers(), loadLoadout(), loadInventory(), loadEmoteLoadout(), loadEmojiLoadout() }):andThen(function(values)
		return {
			Towers = values[1],
			Loadout = values[2],
			Inventory = values[3],
			EmoteLoadout = values[4],
			EmojiLoadout = values[5],
		}
	end)
end

function InventoryClient.RefreshEmoteLoadout()
	return loadEmoteLoadout(true)
end

function InventoryClient.RefreshEmojiLoadout()
	return loadEmojiLoadout(true)
end

function InventoryClient.GetEmojiSlot(slotNumber: number): string?
	if slotNumber % 1 ~= 0 or slotNumber < 1 or slotNumber > MAX_EMOJI_SLOTS then return nil end
	local loadout = InventoryClient.EmojiLoadout()
	return loadout[tostring(slotNumber)] or loadout[slotNumber]
end

function InventoryClient.FindEquippedEmojiSlot(emojiId: string): number?
	for slot = 1, MAX_EMOJI_SLOTS do
		if InventoryClient.GetEmojiSlot(slot) == emojiId then return slot end
	end
	return nil
end

local function requestEmojiLoadout(action: "Equip" | "Unequip", slot: number, emojiId: string?)
	return Promise.new(function(resolve, reject)
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("RuntimeRemotes", 5)
			local remote = remotes and remotes:WaitForChild("EmojiLoadoutAction", 5)
			if not remote or not remote:IsA("RemoteFunction") then
				reject("Emoji loadout service is unavailable.")
				return
			end
			local ok, result = pcall(remote.InvokeServer, remote, {
				Action = action,
				Slot = slot,
				EmojiId = emojiId,
			})
			if not ok then reject(result) return end
			if type(result) ~= "table" then reject("Invalid emoji loadout response.") return end
			if result.Success == true and type(result.Loadout) == "table" then
				emojiLoadoutRequestVersion += 1
				emojiLoadoutRequest = nil
				emojiLoadoutLoaded = true
				setEmojiLoadout(result.Loadout)
			elseif result.Success == true then
				reject("The server returned an invalid emoji loadout.")
				return
			end
			resolve(result)
		end)
	end)
end

function InventoryClient.EquipEmoji(emojiId: string, slot: number)
	return requestEmojiLoadout("Equip", slot, emojiId)
end

function InventoryClient.UnequipEmoji(emojiId: string)
	local slot = InventoryClient.FindEquippedEmojiSlot(emojiId)
	if not slot then return Promise.resolve({ Success = true, Loadout = InventoryClient.EmojiLoadout() }) end
	return requestEmojiLoadout("Unequip", slot, nil)
end

function InventoryClient.GetEmoteSlot(slotNumber: number): string?
	if slotNumber % 1 ~= 0 or slotNumber < 1 or slotNumber > MAX_EMOTE_SLOTS then return nil end
	local loadout = InventoryClient.EmoteLoadout()
	return loadout[tostring(slotNumber)] or loadout[slotNumber]
end

function InventoryClient.FindEquippedEmoteSlot(emoteName: string): number?
	for slot = 1, MAX_EMOTE_SLOTS do
		if InventoryClient.GetEmoteSlot(slot) == emoteName then return slot end
	end
	return nil
end

local function requestEmoteLoadout(action: "Equip" | "Unequip", slot: number, emoteName: string?)
	return Promise.new(function(resolve, reject)
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("RuntimeRemotes", 5)
			local remote = remotes and remotes:WaitForChild("EmoteLoadoutAction", 5)
			if not remote or not remote:IsA("RemoteFunction") then
				reject("Emote loadout service is unavailable.")
				return
			end
			local ok, result = pcall(remote.InvokeServer, remote, {
				Action = action,
				Slot = slot,
				EmoteName = emoteName,
			})
			if not ok then reject(result) return end
			if type(result) ~= "table" then reject("Invalid emote loadout response.") return end
			if result.Success == true and type(result.Loadout) == "table" then
				setEmoteLoadout(result.Loadout)
			elseif result.Success == true then
				reject("The server returned an invalid emote loadout.")
				return
			end
			resolve(result)
		end)
	end)
end

function InventoryClient.EquipEmote(emoteName: string, slot: number)
	return requestEmoteLoadout("Equip", slot, emoteName)
end

function InventoryClient.UnequipEmote(emoteName: string)
	local slot = InventoryClient.FindEquippedEmoteSlot(emoteName)
	if not slot then return Promise.resolve({ Success = true, Loadout = InventoryClient.EmoteLoadout() }) end
	return requestEmoteLoadout("Unequip", slot, nil)
end

function InventoryClient.RefreshInventory()
	return loadInventory(true)
end

function InventoryClient.FetchInventory()
	return loadInventory()
end

function InventoryClient.PerformUnitAction(action: "ToggleUnitLock" | "SellUnit", towerName: string, towerKey: TowerKey)
	return Promise.new(function(resolve, reject)
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("RuntimeRemotes", 5)
			local remote = remotes and remotes:FindFirstChild("InventoryAction")
			if not remote or not remote:IsA("RemoteFunction") then
				reject("Inventory action service is unavailable.")
				return
			end

			local success, result = pcall(function()
				return remote:InvokeServer({
					Action = action,
					TowerName = towerName,
					TowerKey = towerKey,
				})
			end)
			if not success then
				reject(result)
				return
			end
			if typeof(result) ~= "table" then
				reject("Invalid unit action response.")
				return
			end

			if result.Success == true then
				Promise.all({ InventoryClient.RefreshTowers(), InventoryClient.RefreshLoadout() }):andThen(function()
					resolve(result)
				end):catch(reject)
			else
				resolve(result)
			end
		end)
	end)
end

function InventoryClient.RefreshTowers()
	return loadTowers(true)
end

function InventoryClient.RefreshLoadout()
	return loadLoadout(true)
end

function InventoryClient.FetchTowers()
	return loadTowers()
end

function InventoryClient.FetchLoadout()
	return loadLoadout()
end

function InventoryClient.Refresh()
	return Promise.all({
		InventoryClient.RefreshTowers(),
		InventoryClient.RefreshLoadout(),
		InventoryClient.RefreshInventory(),
		InventoryClient.RefreshEmoteLoadout(),
		InventoryClient.RefreshEmojiLoadout(),
	}):andThen(function(values)
		return {
			Towers = values[1],
			Loadout = values[2],
			Inventory = values[3],
			EmoteLoadout = values[4],
			EmojiLoadout = values[5],
		}
	end)
end

function InventoryClient.GetTower(towerName: string, towerKey: TowerKey): any?
	local normalizedKey = normalizeTowerKey(towerKey)
	local towersOfType = InventoryClient.Towers()[towerName]
	return if normalizedKey and towersOfType then towersOfType[normalizedKey] else nil
end

function InventoryClient.OwnsTower(towerName: string, towerKey: TowerKey): boolean
	return InventoryClient.GetTower(towerName, towerKey) ~= nil
end

function InventoryClient.UpdateTowerField(towerName: string, towerKey: TowerKey, field: string, value: any): boolean
	local normalizedKey = normalizeTowerKey(towerKey)
	local currentTowers = InventoryClient.Towers()
	local currentTowersOfType = if normalizedKey then currentTowers[towerName] else nil
	local currentTower = if currentTowersOfType then currentTowersOfType[normalizedKey] else nil
	if not normalizedKey or not currentTowersOfType or not currentTower then
		return false
	end

	local updatedTowers = table.clone(currentTowers)
	local updatedTowersOfType = table.clone(currentTowersOfType)
	local updatedTower = table.clone(currentTower)
	updatedTower[field] = value
	updatedTowersOfType[normalizedKey] = updatedTower
	updatedTowers[towerName] = updatedTowersOfType
	setTowers(updatedTowers)
	return true
end

function InventoryClient.GetLoadoutSlot(slotNumber: number): LoadoutEntry?
	if slotNumber % 1 ~= 0 or slotNumber < 1 or slotNumber > MAX_LOADOUT_SIZE then
		return nil
	end

	local loadout = InventoryClient.Loadout()
	return loadout[tostring(slotNumber)] or loadout[slotNumber]
end

function InventoryClient.FindEquippedSlot(towerName: string, towerKey: TowerKey): number?
	local normalizedKey = normalizeTowerKey(towerKey)
	if not normalizedKey then
		return nil
	end

	for slotNumber = 1, MAX_LOADOUT_SIZE do
		local entry = InventoryClient.GetLoadoutSlot(slotNumber)
		if entry and getEntryTowerName(entry) == towerName and getEntryTowerKey(entry) == normalizedKey then
			return slotNumber
		end
	end

	return nil
end

function InventoryClient.IsEquipped(towerName: string, towerKey: TowerKey): boolean
	return InventoryClient.FindEquippedSlot(towerName, towerKey) ~= nil
end

function InventoryClient.EquipTower(towerName: string, towerKey: TowerKey)
	return requestLoadoutChange("Equip", towerName, towerKey)
end

function InventoryClient.UnequipTower(towerName: string, towerKey: TowerKey)
	return requestLoadoutChange("Unequip", towerName, towerKey)
end

function InventoryClient.UnequipAll()
	return requestLoadoutChange("UnequipAll")
end

function InventoryClient.SetEquipped(towerName: string, towerKey: TowerKey, equipped: boolean)
	if equipped then
		return InventoryClient.EquipTower(towerName, towerKey)
	end

	return InventoryClient.UnequipTower(towerName, towerKey)
end

function InventoryClient.ToggleTower(towerName: string, towerKey: TowerKey)
	return InventoryClient.SetEquipped(towerName, towerKey, not InventoryClient.IsEquipped(towerName, towerKey))
end

function InventoryClient.Init() end

function InventoryClient.Start()
	Net.DataService.OwnedTowersAdded.On(onTowerAdded)
	Net.DataService.OwnedTowersRemoved.On(onTowerRemoved)
	Net.GlobalExistService.CountUpdated.On(function(data: CountUpdatedData)
		InventoryClient.CountUpdated:Fire(data.category, data.itemName, data.newCount)
	end)
	Net.DataService.CurrencyChanged.On(function(data)
		if data.CurrencyName ~= "Inventory" or inventorySyncScheduled then
			return
		end
		inventorySyncScheduled = true
		task.defer(function()
			inventorySyncScheduled = false
			InventoryClient.RefreshInventory():catch(function(err)
				warn(`[InventoryClient] Failed to synchronize inventory: {err}`)
			end)
		end)
	end)

	InventoryClient.Load():catch(function(err)
		warn(`[InventoryClient] Failed to load inventory: {err}`)
	end)
end

return InventoryClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="461">
          <Properties>
            <string name="Name">PartyController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Promise = require(ReplicatedStorage.Packages.Promise)
local Signal = require(ReplicatedStorage.Packages.Signal)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local MatchProtocol = require(ReplicatedStorage.Shared.Modules.Core.MatchProtocol)

export type PartySnapshot = MatchProtocol.PartySnapshot
export type PartyEvent = MatchProtocol.PartyEvent
export type Settings = MatchProtocol.Settings
export type SettingsPatch = { Map: string?, Difficulty: string? }
export type Result<T> = MatchProtocol.Result<T>
export type Connection = { Connected: boolean, Disconnect: (self: Connection) -> () }

-- The installed Promise package does not export a Luau Promise<T> type.
export type Request<T> = {
	andThen: (self: Request<T>, callback: (T) -> any) -> any,
	catch: (self: Request<T>, callback: (any) -> any) -> any,
	finally: (self: Request<T>, callback: () -> ()) -> any,
	await: (self: Request<T>) -> (boolean, T),
	expect: (self: Request<T>) -> T,
}

local REQUEST_TIMEOUT = 20
local cachedParty: PartySnapshot? = nil
local lastSequence = -1
local lastEventSequence = -1
local requestRemote: RemoteFunction? = nil
local changedConnection: RBXScriptConnection? = nil
local ready = nil
local destroyed = false
local generation = 0
local snapshotChanged = Signal.new()

local PartyController = {}

local function publish(party: PartySnapshot?, sequence: number, event: PartyEvent?)
	if
		destroyed
		or sequence < lastSequence
		or (sequence == lastSequence and (not event or sequence <= lastEventSequence))
	then
		return
	end

	lastSequence = sequence
	if event then
		lastEventSequence = sequence
	end
	cachedParty = if party then TableUtils.DeepFreeze(TableUtils.DeepCopy(party)) else nil
	local frozenEvent = if event then TableUtils.DeepFreeze(TableUtils.DeepCopy(event)) else nil
	snapshotChanged:Fire(cachedParty, frozenEvent)
end

local function connect()
	if destroyed then
		return Promise.reject("NOT_READY")
	end
	if ready then
		return ready
	end
	local currentGeneration = generation

	ready = Promise.new(function(resolve, reject)
		local folder = ReplicatedStorage:WaitForChild("RuntimeRemotes", 10)
		local remote = folder and folder:WaitForChild("PartyRequest", 10)
		local event = folder and folder:WaitForChild("PartyChanged", 10)
		if
			destroyed
			or generation ~= currentGeneration
			or not remote
			or not remote:IsA("RemoteFunction")
			or not event
			or not event:IsA("RemoteEvent")
		then
			reject("NOT_READY")
			return
		end

		requestRemote = remote
		changedConnection = event.OnClientEvent:Connect(function(update: PartyEvent)
			publish(update.Party, update.Sequence, update)
		end)
		resolve()
	end):catch(function(err)
		if generation == currentGeneration then
			ready = nil
		end
		return Promise.reject(err)
	end)
	return ready
end

local function request(action: string, payload: any?, updatesOwnParty: boolean?): any
	local currentGeneration = generation
	return connect()
		:andThen(function()
			return Promise.new(function(resolve)
				local ok, result = pcall(function()
					return (requestRemote :: RemoteFunction):InvokeServer(action, payload)
				end)
				if destroyed or generation ~= currentGeneration then
					resolve({ Success = false, Code = "NOT_READY" })
					return
				end
				if not ok or type(result) ~= "table" or type(result.Success) ~= "boolean" then
					resolve({ Success = false, Code = "NETWORK_ERROR" })
					return
				end

				if updatesOwnParty and result.Success and type(result.Sequence) == "number" then
					publish(result.Data, result.Sequence, nil)
				end
				resolve(TableUtils.DeepFreeze(result))
			end)
		end)
		:timeout(REQUEST_TIMEOUT, "REQUEST_TIMEOUT")
		:catch(function(err)
			local code = if err == "NOT_READY" or err == "REQUEST_TIMEOUT" then err else "NETWORK_ERROR"
			return table.freeze({ Success = false, Code = code })
		end)
end

-- Calls resolve with Result<T>, including network failures. Inspect Success and Code.
function PartyController:CreateParty(settings: SettingsPatch?): Request<Result<PartySnapshot>>
	return request("CreateParty", settings, true)
end

function PartyController:JoinParty(partyId: string): Request<Result<PartySnapshot>>
	return request("JoinParty", partyId, true)
end

function PartyController:LeaveParty(): Request<Result<PartySnapshot>>
	return request("LeaveParty", nil, true)
end

function PartyController:TransferLeadership(userId: number): Request<Result<PartySnapshot>>
	return request("TransferLeadership", userId, true)
end

function PartyController:KickMember(userId: number): Request<Result<PartySnapshot>>
	return request("KickMember", userId, true)
end

function PartyController:DisbandParty(): Request<Result<PartySnapshot>>
	return request("DisbandParty", nil, true)
end

function PartyController:UpdateSettings(settings: SettingsPatch): Request<Result<PartySnapshot>>
	return request("UpdateSettings", settings, true)
end

-- Starting a Retryable party rejoins the existing reserved match.
function PartyController:StartParty(): Request<Result<PartySnapshot>>
	return request("StartParty", nil, true)
end

function PartyController:GetParty(partyId: string?): Request<Result<PartySnapshot>>
	return request("GetParty", partyId, partyId == nil)
end

function PartyController:ListParties(): Request<Result<{ PartySnapshot }>>
	return request("ListParties", nil, false)
end

-- Snapshots are deeply frozen; callers cannot change the controller's cache.
function PartyController:GetCachedParty(): PartySnapshot?
	return cachedParty
end

-- Immediately receives the current snapshot, then server-confirmed changes.
-- event is nil for the initial callback or a query response.
function PartyController:ObserveParty(callback: (PartySnapshot?, PartyEvent?) -> ()): Connection
	local connection = snapshotChanged:Connect(callback)
	callback(cachedParty, nil)
	return connection
end

function PartyController.Init()
	destroyed = false
end

function PartyController.Start()
	PartyController:GetParty()
end

function PartyController.Destroy()
	destroyed = true
	generation += 1
	if changedConnection then
		changedConnection:Disconnect()
		changedConnection = nil
	end
	snapshotChanged:DisconnectAll()
	requestRemote = nil
	ready = nil
	cachedParty = nil
	lastSequence = -1
	lastEventSequence = -1
end

return PartyController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="462">
          <Properties>
            <string name="Name">SettingsClient</string>
            <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)
local Promise = require(ReplicatedStorage.Packages.Promise)
local Net = require(ReplicatedStorage.Shared.Net)
local SettingsData = require(ReplicatedStorage.Settings.Data.SettingsData)

local AudioController

local Settings = {}
local dirtySettings = {}
local pendingAutoSellFlush = {}

local activeTimeTween

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function smoothSetTime(targetTime: number, duration: number?)
	duration = duration or 1.5

	if activeTimeTween then
		activeTimeTween:Cancel()
		activeTimeTween = nil
	end

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	activeTimeTween = TweenService:Create(Lighting, tweenInfo, { ClockTime = targetTime })

	activeTimeTween:Play()

	activeTimeTween.Completed:Connect(function()
		activeTimeTween = nil
	end)
end

local SettingApplier = {
	Shadows = function(value: boolean)
		Lighting.GlobalShadows = value
	end,
	Night = function(value: boolean)
		smoothSetTime(if value then 0 else 11, 3)
		if AudioController then
			AudioController.SetBGMState(
				nil,
				nil,
				if value then "rbxassetid://79315968132597" else "rbxassetid://109718857077158"
			)
		end
	end,

	MusicVolume = function(value: number)
		if AudioController then
			AudioController.SetBGMState(nil, (value / 50))
		end
	end,
	SFXVolume = function(value: number)
		if AudioController then
			AudioController.SFXVolume = (value / 50)
		end
	end,
}

-------------------------------------------------
--// SettingsClient
-------------------------------------------------
local SettingsClient = {}
SettingsClient.LoadedPromise = nil

function SettingsClient.ApplySetting(settingName: string, value: any)
	if Settings[settingName] == value then
		return value
	end

	Settings[settingName] = value
	dirtySettings[settingName] = true
	local settingInfo = SettingsData.ByName[settingName]
	if settingInfo and settingInfo.Category == "Auto Sell" then
		pendingAutoSellFlush[settingName] = value
	end

	local handler = SettingApplier[settingName]
	if handler then
		task.spawn(handler, value)
	end

	SettingsClient._SaveSettings()

	return value
end

-- Save changed auto-sell toggles once more as an awaited barrier immediately
-- before summoning. This removes the race between a quick toggle and summon.
function SettingsClient.FlushAutoSellSettings()
	local requests = {}
	for settingName, value in pendingAutoSellFlush do
		local capturedName = settingName
		local capturedValue = value
		table.insert(requests, Net.SettingsService.SaveSetting.Invoke({
			SettingName = capturedName,
			Value = capturedValue,
		}):andThen(function(saved)
			if saved ~= true then
				error(`Server rejected auto-sell setting "{capturedName}".`)
			end
			if pendingAutoSellFlush[capturedName] == capturedValue then
				pendingAutoSellFlush[capturedName] = nil
			end
		end))
	end

	return if #requests > 0 then Promise.all(requests) else Promise.resolve(true)
end

function SettingsClient.GetSettings()
	if SettingsClient.LoadedPromise then
		SettingsClient.LoadedPromise:expect()
	else
		SettingsClient.FetchSettings():expect()
	end

	return TableUtils.DeepCopy(Settings)
end

function SettingsClient.FetchSettings()
	if SettingsClient.LoadedPromise then
		return SettingsClient.LoadedPromise
	end

	SettingsClient.LoadedPromise = Net.SettingsService.GetSettings
		.Invoke()
		:andThen(function(playerSettings)
			if type(playerSettings) == "table" then
				Settings = playerSettings
			end
		end)
		:catch(function(err)
			warn(`설정값 불러오기 실패: {err}`)
			Settings = {}
		end)
		:andThen(function()
			for key, info in pairs(SettingsData.ByName) do
				if Settings[key] == nil then
					Settings[key] = info.Default
				end
			end

			for key, val in pairs(Settings) do
				local handler = SettingApplier[key]
				if handler then
					task.spawn(handler, val)
				end
			end

			return Settings
		end)

	return SettingsClient.LoadedPromise
end

function SettingsClient._SaveSettings()
	if not next(dirtySettings) then
		return
	end

	local savingKeys = {}
	for key in pairs(dirtySettings) do
		savingKeys[key] = Settings[key]
		dirtySettings[key] = nil
	end

	for key, val in pairs(savingKeys) do
		print(key)
		Net.SettingsService.SaveSetting
			.Invoke({
				SettingName = key,
				Value = val,
			})
			:catch(function(err)
				warn(`설정 저장 실패 ({key}):`, err)

				if Settings[key] == val then
					dirtySettings[key] = true
				end
			end)
	end
end

function SettingsClient.Init(services)
	AudioController = services:GetService("AudioController")

	SettingsClient.FetchSettings()
end

return SettingsClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="463">
          <Properties>
            <string name="Name">SprintClient</string>
            <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local SetMobileStyle = require(ReplicatedStorage.Shared.Modules.UI.SetMobileStyle)

local camera = workspace.CurrentCamera
local player = Players.LocalPlayer
local normalSpeed = 16
local sprintSpeed = 48

local currentHumanoid: Humanoid? = nil
local isSprinting = false
local isEnabled = true

local SprintClient = {}

local function updateMobileVisual()
	local mobileButton = ContextActionService:GetButton("Sprint")
	if mobileButton then
		SetMobileStyle.SetToggleState(mobileButton, isSprinting and isEnabled)
	end
end

local function updateSpeed()
	if not currentHumanoid or not isEnabled then
		return
	end
	currentHumanoid.WalkSpeed = isSprinting and sprintSpeed or normalSpeed
	updateMobileVisual()
end

local function handleSprint(_, inputState)
	if not currentHumanoid or not isEnabled then
		return
	end

	if inputState == Enum.UserInputState.Begin then
		isSprinting = not isSprinting
		updateSpeed()
	end
end

function SprintClient.SetEnabled(enabled: boolean, sprinting: boolean?)
	isEnabled = enabled
	if not enabled then
		isSprinting = false
	elseif sprinting ~= nil then
		isSprinting = sprinting
	end
	updateSpeed()
	updateMobileVisual()
end

function SprintClient.Enable()
	SprintClient.SetEnabled(true)
end

function SprintClient.Disable()
	SprintClient.SetEnabled(false)
end

function SprintClient.IsSprinting(): boolean
	return isSprinting
end

function SprintClient.IsEnabled(): boolean
	return isEnabled
end

function SprintClient.Init() end

function SprintClient.Start()
	local function onCharacterAdded(character: Model)
		currentHumanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
		if currentHumanoid and isEnabled then
			currentHumanoid.WalkSpeed = normalSpeed
		end
		isSprinting = false
	end

	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	ContextActionService:BindAction("Sprint", handleSprint, true, Enum.KeyCode.LeftControl)
	ContextActionService:SetImage("Sprint", "rbxassetid://95175163838191")

	if UserInputService.TouchEnabled then
		task.spawn(function()
			local mobileButton = nil
			for _ = 1, 10 do
				mobileButton = ContextActionService:GetButton("Sprint")
				if mobileButton then
					break
				end
				task.wait()
			end

			if mobileButton then
				local viewportX = camera.ViewportSize.X > 0 and camera.ViewportSize.X or 800
				local viewportY = camera.ViewportSize.Y > 0 and camera.ViewportSize.Y or 600

				local minAxis = math.min(viewportX, viewportY)
				local isSmallScreen = minAxis <= 500
				local buttonSize = isSmallScreen and 50 or 100

				mobileButton.Size = UDim2.fromOffset(buttonSize, buttonSize)
				ContextActionService:SetPosition("Sprint", UDim2.new(0.4, -buttonSize, 0.3, -buttonSize))

				SetMobileStyle.Toggle(mobileButton)
			end
		end)
	end
end

return SprintClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="464">
          <Properties>
            <string name="Name">TraitClient</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Promise = require(ReplicatedStorage.Packages.Promise)

local InventoryClient
local TraitClient = {}

function TraitClient.Roll(towerName: string, towerKey: string | number)
	return Promise.new(function(resolve, reject)
		task.spawn(function()
			local remotes = ReplicatedStorage:WaitForChild("RuntimeRemotes", 5)
			local remote = remotes and remotes:FindFirstChild("TraitRoll")
			if not remote or not remote:IsA("RemoteFunction") then
				reject("Trait service is unavailable.")
				return
			end
			local ok, result = pcall(function()
				return remote:InvokeServer({ TowerName = towerName, TowerKey = towerKey })
			end)
			if not ok then reject(result) return end
			if typeof(result) ~= "table" then reject("Invalid trait response.") return end
			if result.Success == true then
				InventoryClient.UpdateTowerField(towerName, towerKey, "Trait", result.Trait)
			end
			resolve(result)
		end)
	end)
end

function TraitClient.Init(services)
	InventoryClient = services:GetService("InventoryClient")
end

TraitClient.Dependencies = { "InventoryClient" }
function TraitClient.Start() end

return TraitClient
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="465">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Vide = require(ReplicatedStorage.Packages.Vide)
local Topbarplus = require(ReplicatedStorage.Packages.Topbarplus)

local source = Vide.source

local activeView = source(nil :: string?)
local isLocked = source(false)
local exclusiveView = source(nil :: string?)

local CORE_GUI_TYPES = {
	Enum.CoreGuiType.Backpack,
	Enum.CoreGuiType.Chat,
	Enum.CoreGuiType.Health,
	Enum.CoreGuiType.PlayerList,
	Enum.CoreGuiType.EmotesMenu,
}

local focusModeActive = false
local topbarWasEnabled = true
local coreGuiState = {}

local UIController = {}

local function setFocusMode(enabled: boolean)
	if focusModeActive == enabled then
		return
	end

	focusModeActive = enabled
	if enabled then
		topbarWasEnabled = Topbarplus.topbarEnabled ~= false
		Topbarplus.setTopbarEnabled(false)

		table.clear(coreGuiState)
		for _, coreGuiType in CORE_GUI_TYPES do
			local readSuccess, wasEnabled = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, coreGuiType)
			if readSuccess then
				coreGuiState[coreGuiType] = wasEnabled
				pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreGuiType, false)
			end
		end
		return
	end

	Topbarplus.setTopbarEnabled(topbarWasEnabled)
	for coreGuiType, wasEnabled in coreGuiState do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, coreGuiType, wasEnabled)
	end
	table.clear(coreGuiState)
end

function UIController:IsOpen(name: string): boolean
	return activeView() == name
end

function UIController:IsVisible(name: string): () -> boolean
	return function()
		return activeView() == name
	end
end

function UIController:GetActiveView(): string?
	return activeView()
end

function UIController:IsExclusive(): boolean
	return exclusiveView() ~= nil
end

function UIController:Open(name: string): boolean
	local exclusive = exclusiveView()
	if isLocked() or name == "" or (exclusive ~= nil and exclusive ~= name) then
		return false
	end

	activeView(name)
	return true
end

function UIController:OpenExclusive(name: string): boolean
	if isLocked() or name == "" then
		return false
	end

	setFocusMode(true)
	exclusiveView(name)
	activeView(name)
	return true
end

function UIController:Close(name: string): boolean
	if isLocked() or activeView() ~= name then
		return false
	end

	activeView(nil)
	if exclusiveView() == name then
		exclusiveView(nil)
		setFocusMode(false)
	end
	return true
end

function UIController:CloseAll(): boolean
	if isLocked() or exclusiveView() ~= nil or activeView() == nil then
		return false
	end

	activeView(nil)
	return true
end

function UIController:Toggle(name: string): boolean
	if self:IsOpen(name) then
		return self:Close(name)
	end

	return self:Open(name)
end

function UIController:Lock(locked: boolean)
	isLocked(locked)
end

function UIController.Init() end
function UIController.Start() end

return UIController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="466">
          <Properties>
            <string name="Name">VFXController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Promise = require(ReplicatedStorage.Packages.Promise)
local VFXCaches = require(script.VFXCaches)
local VFXRecipes = require(ReplicatedStorage.Settings.Visuals.VFXRecipes)
local Steps = require(ReplicatedStorage.Settings.Visuals.VFXRecipes.Steps)
local CharacterUtils = require(ReplicatedStorage.Shared.Modules.Utils.CharacterUtils)
local EmitParticles = require(ReplicatedStorage.Shared.Modules.Utils.EmitParticles)
local CustomHandlers = require(script.CustomHandlers)

local RANDOM = Random.new()

local DEFAULT_LIFETIME = 2.5
local DEFAULT_PROJECTILE_SPEED = 300
local PROJECTILE_OFFSET = 0.2
local BEAM_CHECK_RATE = 1 / 15

export type Recipes = { Steps.Recipe }

local ActiveBeams = {}

local function getBezierPoint(t: number, p0: Vector3, p1: Vector3, p2: Vector3): Vector3
	local oneMinusT = 1 - t
	return oneMinusT * oneMinusT * p0 + 2 * oneMinusT * t * p1 + t * t * p2
end

local function getBezierTangent(t: number, p0: Vector3, p1: Vector3, p2: Vector3): Vector3
	return 2 * (1 - t) * (p1 - p0) + 2 * t * (p2 - p1)
end

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function resolveInstance(value: any, sourceModel: Model, targetModel: Model)
	if typeof(value) == "BasePart" then
		return value
	end

	if type(value) ~= "string" then
		return
	end

	local parts = string.split(value, ".")
	local rootName = parts[1]

	local rootModel
	if rootName == "Source" then
		rootModel = sourceModel
	elseif rootName == "Target" then
		rootModel = targetModel
	else
		warn(`잘못된 경로: {rootName}`)
		return
	end

	if #parts == 1 then
		if rootModel.PrimaryPart then
			return rootModel.PrimaryPart
		end

		return
	end

	local current = rootModel
	for i = 2, #parts do
		if parts[i] == "@Ground" then
			return current.PrimaryPart, true
		end

		current = current:FindFirstChild(parts[i])

		if not current then
			warn(`경로를 찾을 수 없음: {value}`)
			return
		end
	end

	return current
end

local function getAttachment(parentPart: BasePart)
	local attachment = parentPart:FindFirstChild("BeamAttachment")
	if attachment then
		return attachment
	end

	attachment = Instance.new("Attachment")
	attachment.Name = "BeamAttachment"
	attachment.Parent = parentPart

	return attachment
end

local function isAlive(model): boolean
	if not model or not model:IsDescendantOf(workspace) then
		return false
	end

	return model.PrimaryPart:GetAttribute("Dead") ~= true
end

local function getBeamKey(recipe)
	return `{recipe.Effect}|{recipe.From}->{recipe.To}`
end

-------------------------------------------------
--// VFXService
-------------------------------------------------
local VFXService = {}

function VFXService.GetRecipes(sourceName: string, effectType: string, sourceLevel: number?): Recipes?
	local sourceRecipes = VFXRecipes[sourceName]
	if not sourceRecipes then
		return nil
	end

	local effectRecipes = sourceRecipes[effectType]
	if not effectRecipes then
		return nil
	end

	if effectRecipes[1] then
		return effectRecipes
	end

	local level = sourceLevel or 0

	for currentLevel = level, 0, -1 do
		local recipes = effectRecipes[currentLevel]

		if recipes then
			return recipes
		end
	end

	warn(`{sourceName}.{effectType}의 {level}레벨 이하 VFX 정보가 존재하지 않음.`)
	return nil
end

function VFXService.PlayVFX(vfxRecipes: Recipes, sourceModel: Model, targetModel: Model, range: number?, delay: number?)
	if typeof(vfxRecipes) ~= "table" then
		return
	end
	for _, recipe in vfxRecipes do
		if (recipe.Delay and recipe.Delay > 0) or delay then
			local delayedRecipe = table.clone(recipe)
			local totalDelay = (delay or 0) + (delayedRecipe.Delay or 0)

			delayedRecipe.Delay = nil

			Promise.delay(totalDelay):andThen(function()
				VFXService.PlayVFX({ delayedRecipe }, sourceModel, targetModel, range)
			end)

			continue
		end

		if recipe.Type == "Emit" then
			VFXService._PlayEmitType(recipe, sourceModel, targetModel)
		elseif recipe.Type == "Projectile" then
			VFXService._PlayProjectileType(recipe, sourceModel, targetModel)
		elseif recipe.Type == "Beam" then
			VFXService._PlayBeamType(recipe, sourceModel, targetModel, range)
		elseif recipe.Type == "Custom" then
			VFXService._PlayCustomType(recipe, sourceModel, targetModel)
		else
			warn(`알 수 없는 VFX Type: {recipe.Type}`)
		end
	end
end

function VFXService._PlayCustomType(recipe: Steps.CustomStep, sourceModel: Model, targetModel: Model)
	local handler = CustomHandlers[recipe.Effect]
	if handler then
		task.spawn(function()
			local success, err = pcall(handler, recipe, sourceModel, targetModel)
			if not success then
				warn(`커스텀 VFX 실행 실패 ({recipe.Effect}): {err}`)
			end
		end)
	else
		warn(`커스텀 VFX 핸들러를 찾을 수 없음: {recipe.Effect}`)
	end
end

function VFXService._PlayEmitType(recipe: Steps.EmitStep, sourceModel: Model, targetModel: Model)
	local playPart, isGround = resolveInstance(recipe.At, sourceModel, targetModel)
	if not playPart then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	local playCFrame
	if isGround then
		playCFrame = playPart.CFrame - Vector3.new(0, CharacterUtils.GetHipHeight(playPart.Parent), 0)
	else
		playCFrame = playPart.CFrame
	end

	if not playCFrame then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	local effect, runId = VFXCaches.Get(recipe.Effect, playCFrame)
	if not effect or not runId then
		return
	end

	if recipe.LockToSource then
		local connection
		local offset = playPart.CFrame:ToObjectSpace(playCFrame)
		connection = RunService.PreRender:Connect(function()
			if effect:GetAttribute("VFXRunId") ~= runId or not playPart:IsDescendantOf(workspace) then
				connection:Disconnect()
				return
			end
			VFXCaches.SetCFrame(effect, playPart.CFrame * offset)
		end)
	end

	EmitParticles(effect)
	VFXCaches.ReturnAfter(recipe.Effect, effect, runId, (recipe.Lifetime or DEFAULT_LIFETIME))
end

function VFXService._PlayProjectileType(recipe: Steps.ProjectileStep, sourceModel: Model, targetModel: Model)
	local sourceCFrame = resolveInstance(recipe.From, sourceModel, targetModel).CFrame
	local targetCFrame = resolveInstance(recipe.To, sourceModel, targetModel).CFrame
	if not sourceCFrame or not targetCFrame then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	local startPos = sourceCFrame.Position
	local endPos = targetCFrame.Position
	local direction = endPos - startPos
	local distance = direction.Magnitude

	if distance <= 0 then
		return
	end

	local spawnCFrame = CFrame.lookAt(startPos, endPos)
	local effect, runId = VFXCaches.Get(recipe.Effect, spawnCFrame)
	if not effect or not runId then
		return
	end

	if not effect:IsA("BasePart") then
		warn(`Effect가 BasePart 타입이 아님: {recipe.Effect}`)
		VFXCaches.Return(recipe.Effect, effect)
		return
	end

	local travelTime
	if recipe.TravelTime then
		travelTime = recipe.TravelTime
	else
		travelTime = distance / (recipe.Speed or DEFAULT_PROJECTILE_SPEED)
	end

	local goalOffset = Vector3.new(
		RANDOM:NextNumber(-PROJECTILE_OFFSET, PROJECTILE_OFFSET),
		RANDOM:NextNumber(-PROJECTILE_OFFSET, PROJECTILE_OFFSET),
		RANDOM:NextNumber(-PROJECTILE_OFFSET, PROJECTILE_OFFSET)
	)
	local goalCFrame = CFrame.lookAt(endPos, endPos + direction.Unit) + goalOffset
	EmitParticles(effect)

	local isBezier = (recipe.CurveHeight and recipe.CurveHeight ~= 0)
		or (recipe.CurveOffset and recipe.CurveOffset ~= 0)

	if isBezier then
		local midPoint = (startPos + endPos) / 2
		local controlPoint = midPoint
		if recipe.CurveHeight then
			controlPoint = controlPoint + Vector3.new(0, recipe.CurveHeight, 0)
		end
		if recipe.CurveOffset then
			local directionUnit = direction.Magnitude > 0 and direction.Unit or Vector3.new(0, 0, 1)
			local up = Vector3.new(0, 1, 0)
			local side = directionUnit:Cross(up)

			if side.Magnitude > 0 then
				side = side.Unit
			else
				side = Vector3.new(1, 0, 0)
			end

			local randomSign = RANDOM:NextInteger(1, 2) == 1 and 1 or -1

			controlPoint = controlPoint + side * (recipe.CurveOffset * randomSign)
		end

		task.spawn(function()
			RunService.PreRender:Wait()

			local elapsed = 0
			local connection
			connection = RunService.PreRender:Connect(function(dt)
				if not effect or not effect.Parent or effect:GetAttribute("VFXRunId") ~= runId then
					connection:Disconnect()
					return
				end

				elapsed = math.min(travelTime, elapsed + dt)
				local t = elapsed / travelTime

				local currentPos = getBezierPoint(t, startPos, controlPoint, endPos + goalOffset)
				local tangent = getBezierTangent(t, startPos, controlPoint, endPos + goalOffset)

				if tangent.Magnitude > 0 then
					effect.CFrame = CFrame.lookAt(currentPos, currentPos + tangent.Unit)
				else
					effect.CFrame = CFrame.new(currentPos)
				end

				if elapsed >= travelTime then
					connection:Disconnect()

					if recipe.OnHit then
						VFXService.PlayVFX({ recipe.OnHit }, sourceModel, targetModel)
					end

					RunService.PreRender:Wait()
					VFXCaches.Return(recipe.Effect, effect)
				end
			end)
		end)
	else
		local tween = TweenService:Create(
			effect,
			TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = goalCFrame }
		)

		tween.Completed:Once(function()
			if effect:GetAttribute("VFXRunId") ~= runId then
				return
			end
			if recipe.OnHit then
				VFXService.PlayVFX({ recipe.OnHit }, sourceModel, targetModel)
			end

			RunService.PreRender:Wait()
			VFXCaches.Return(recipe.Effect, effect)
		end)

		task.spawn(function()
			RunService.PreRender:Wait()
			tween:Play()
		end)
	end
end

function VFXService._PlayBeamType(recipe: Steps.BeamStep, sourceModel: Model, targetModel: Model, range: number?)
	local beamKey = getBeamKey(recipe)
	if not ActiveBeams[sourceModel] then
		ActiveBeams[sourceModel] = {}
	end
	if ActiveBeams[sourceModel][beamKey] then
		return
	end
	if not isAlive(sourceModel) or targetModel:GetAttribute("DeadByBeam") then
		return
	end

	local fromInstance = resolveInstance(recipe.From, sourceModel, targetModel)
	local toInstance = resolveInstance(recipe.To, sourceModel, targetModel)
	if not fromInstance or not toInstance then
		warn(`위치를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	if not fromInstance or not toInstance then
		warn(`Instance를 찾을 수 없음: {recipe.Effect}`)
		return
	end

	if not fromInstance:IsA("BasePart") or not toInstance:IsA("BasePart") then
		warn(`Beam 위치는 BasePart여야 함: {recipe.Effect}`)
		return
	end

	local sourceAttachment = getAttachment(fromInstance)
	local targetAttachment = getAttachment(toInstance)

	local effect, runId = VFXCaches.Get(recipe.Effect, CFrame.new())
	if not effect or not runId then
		return
	end

	local state = {
		Target = targetModel,
		Effect = effect,
		RunId = runId,
		Connection = nil,
		Instances = {},
		Cleaned = false,
	}

	ActiveBeams[sourceModel][beamKey] = state

	local function track(instance: Instance)
		table.insert(state.Instances, instance)
		return instance
	end

	local startAttach = effect:FindFirstChild("Start")
	local endAttach = effect:FindFirstChild("End")

	if startAttach then
		for _, eff in startAttach:GetChildren() do
			if not (eff:IsA("ParticleEmitter") or eff:IsA("Beam") or eff:IsA("Trail")) then
				continue
			end

			local clonedEff = track(eff:Clone())
			clonedEff.Parent = sourceAttachment
		end
	end

	if endAttach then
		for _, eff in endAttach:GetChildren() do
			if not (eff:IsA("ParticleEmitter") or eff:IsA("Beam") or eff:IsA("Trail")) then
				continue
			end

			local clonedEff = track(eff:Clone())
			clonedEff.Parent = targetAttachment
		end
	end

	for _, beam in effect:GetChildren() do
		if not beam:IsA("Beam") then
			continue
		end

		local clonedBeam = track(beam:Clone())
		clonedBeam.Attachment0 = sourceAttachment
		clonedBeam.Attachment1 = targetAttachment

		clonedBeam.Enabled = true
		clonedBeam.Parent = sourceAttachment
	end

	EmitParticles(sourceAttachment)
	EmitParticles(targetAttachment)

	local function cleanup()
		if state.Cleaned then
			return
		end
		state.Cleaned = true

		if state.Connection then
			state.Connection:Disconnect()
			state.Connection = nil
		end

		for _, inst in state.Instances do
			if inst.Parent then
				inst:Destroy()
			end
		end

		table.clear(state.Instances)

		if ActiveBeams[sourceModel] then
			ActiveBeams[sourceModel][beamKey] = nil

			if not next(ActiveBeams[sourceModel]) then
				ActiveBeams[sourceModel] = nil
			end
		end

		if effect:GetAttribute("VFXRunId") == runId then
			VFXCaches.Return(recipe.Effect, effect)
		end
	end

	local passedTime = 0
	state.Connection = RunService.PreRender:Connect(function(dt)
		passedTime += dt
		if passedTime < BEAM_CHECK_RATE then
			return
		end
		passedTime = 0

		if not isAlive(sourceModel) or not isAlive(targetModel) then
			RunService.PreRender:Wait()
			targetModel:SetAttribute("DeadByBeam", true)
			cleanup()
			return
		end
		if not sourceAttachment:IsDescendantOf(workspace) or not targetAttachment:IsDescendantOf(workspace) then
			cleanup()
			return
		end

		if range then
			local offset = targetAttachment.WorldPosition - sourceAttachment.WorldPosition
			local distanceSq = offset.X * offset.X + offset.Z * offset.Z

			if distanceSq > range * range then
				cleanup()
				return
			end
		end
	end)
end

function VFXService.Init() end

function VFXService.Start() end

return VFXService
]]></string>
          </Properties>
