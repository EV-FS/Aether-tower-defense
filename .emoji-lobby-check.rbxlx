									local column = zeroBasedRank % VIRTUAL_COLUMNS
									local row = math.floor(zeroBasedRank / VIRTUAL_COLUMNS)
									return UDim2.new(
										VIRTUAL_OUTER_PADDING_X
											+ column * (VIRTUAL_CELL_WIDTH + VIRTUAL_PADDING_X),
										0,
										0,
