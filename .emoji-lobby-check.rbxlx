        <Item class="ModuleScript" referent="688">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local SettingsData = require(ReplicatedStorage.Settings.Data.SettingsData)
local DataService

local SettingsService = {}

function SettingsService:SaveSetting(player: Player, settingName: string, value: any)
	local playerData = DataService:GetData(player)
	local settingInfo = SettingsData.ByName[settingName]
	if not playerData or not settingInfo then
		return false
	end

	if settingInfo.Type == "boolean" then
		if typeof(value) ~= "boolean" then
			return false
		end
	elseif settingInfo.Type == "number" then
		if typeof(value) ~= "number" or value ~= value or value < settingInfo.Min or value > settingInfo.Max then
			return false
		end
	else
		return false
	end

	if settingName == "AutoSkip" and value == true then
		if not player:IsInGroupAsync(492293332) then
			return false
		end
	end

	DataService:UpdateData(player, "Settings", value, settingName)

	return true
end

function SettingsService:GetSettings(player: Player, settingName: string?)
	local playerData = DataService:GetData(player)
	if not playerData then
		return if settingName then nil else {}
	end
	if settingName then
		if not SettingsData.ByName[settingName] then
			return nil
		end
		return playerData.Settings[settingName]
	end

	return playerData.Settings
end

function SettingsService:Reconcile(player: Player)
	local playerData = DataService:GetData(player)
	if not playerData then
		return
	end
	if playerData.Settings.AutoSkip == true then
		if not player:IsInGroupAsync(492293332) then
			DataService:UpdateData(player, "Settings", false, "AutoSkip")
		end
	end

	for key, settingInfo in SettingsData.ByName do
		if playerData.Settings[key] ~= nil then
			continue
		end
		DataService:UpdateData(player, "Settings", settingInfo.Default, key)
	end
end

function SettingsService.Init(services)
	DataService = services:GetService("DataService")
end

function SettingsService.Start()
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			if DataService:GetProfile(player) then
				SettingsService:Reconcile(player)
			end
		end)
	end

	Players.PlayerAdded:Connect(function(player)
		if DataService:GetProfile(player) then
			SettingsService:Reconcile(player)
		end
	end)

	Net.SettingsService.SaveSetting.On(function(player: Player, data: { SettingName: string, Value: any })
		return SettingsService:SaveSetting(player, data.SettingName, data.Value)
	end)

	Net.SettingsService.GetSettings.On(function(player: Player, settingName: string?)
		return SettingsService:GetSettings(player, settingName)
	end)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="689">
          <Properties>
            <string name="Name">StoreService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PurchaseData = require(ReplicatedStorage.Settings.Data.PurchaseData)
local DataService

local StoreService = {}

function StoreService.SyncGamePasses(player: Player)
	if not DataService:GetProfile(player) then
		warn(`{player.Name}의 데이터 로드 실패.`)
		return
	end

	for _, passData in PurchaseData.ByName.GamePasses do
		local success, isOwn = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passData.Id)
		end)
		if success then
			if isOwn then
				StoreService.OnPurchaseGamePass(player, passData.Id, true)
			end
		else
			warn(`플레이어 {player.Name}의 게임패스({passData.Id}) 확인 실패: {tostring(isOwn)}`)
		end
	end
end

function StoreService.OnPurchaseGamePass(player: Player, gamePassId: number, wasPurchased: boolean)
	if not wasPurchased then
		return
	end

	if DataService:IsOwnGamePass(player, tostring(gamePassId)) then
		return
	end

	DataService:AddGamePass(player, gamePassId, "Owned")
end

function StoreService.OnPurchaseDevProduct(receiptInfo): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local result = DataService:ProcessProduct(player, receiptInfo)

	return result or Enum.ProductPurchaseDecision.NotProcessedYet
end

function StoreService.Init(services)
	DataService = services:GetService("DataService")
end

function StoreService.Start()
	for _, player in Players:GetPlayers() do
		task.spawn(StoreService.SyncGamePasses, player)
	end

	Players.PlayerAdded:Connect(function(player: Player)
		task.spawn(StoreService.SyncGamePasses, player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(StoreService.OnPurchaseGamePass)
	MarketplaceService.ProcessReceipt = StoreService.OnPurchaseDevProduct
end

return StoreService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="690">
          <Properties>
            <string name="Name">SummonService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local AutoSellConfig = require(ReplicatedStorage.Settings.Data.AutoSellConfig)
local SummonConfig = require(ReplicatedStorage.Settings.Data.SummonConfig)
local UnitSellRewards = require(ReplicatedStorage.Settings.Data.UnitSellRewards)
local Banner = require(script.Banner)
local DataService

local SummonService = {}
local RANDOM = Random.new()
local PRICES = SummonConfig.Prices
local BANNER_TIMER_DURATION = SummonConfig.BannerTimerDuration
local MYTHIC_PITY_LIMIT = SummonConfig.Pity.Mythic.Limit
local ABSOLUTE_PITY_LIMIT = SummonConfig.Pity.Absolute.Limit
local MYTHIC_PITY_ATTRIBUTE = SummonConfig.Pity.Mythic.Attribute
local ABSOLUTE_PITY_ATTRIBUTE = SummonConfig.Pity.Absolute.Attribute

local ActiveSummons = {}

local function sanitizePity(value, limit: number): number
	return math.clamp(math.floor(tonumber(value) or 0), 0, limit - 1)
end

local function getPity(playerData)
	local savedPity = if type(playerData.SummonPity) == "table" then playerData.SummonPity else {}
	return {
		Mythic = sanitizePity(savedPity.Mythic, MYTHIC_PITY_LIMIT),
		Absolute = sanitizePity(savedPity.Absolute, ABSOLUTE_PITY_LIMIT),
	}
end

local function syncPityAttributes(player: Player, pity)
	player:SetAttribute(MYTHIC_PITY_ATTRIBUTE, pity.Mythic)
	player:SetAttribute(ABSOLUTE_PITY_ATTRIBUTE, pity.Absolute)
end

local function rollSingleUnit(bannerData)
	local randomNum = RANDOM:NextNumber(0, bannerData.TotalWeight)
	local currentWeight = 0

	for _, unitData in ipairs(bannerData.Units) do
		currentWeight += unitData.Weight
		if randomNum <= currentWeight then
			return unitData.Unit, unitData.Rarity
		end
	end

	warn("Summon roll failed to select a unit.")
	return nil, nil
end

function SummonService.Summon(player: Player, amount: number)
	if type(amount) ~= "number" or not PRICES[amount] then
		warn(`Invalid summon amount: {amount}`)
		return { Success = false, PulledUnits = {} }
	end

	if ActiveSummons[player] then
		warn(`A summon is already active for {player.Name}.`)
		return { Success = false, PulledUnits = {} }
	end

	local playerData = DataService:GetData(player)
	local totalCost = PRICES[amount]

	if not playerData or playerData.Coins < totalCost then
		warn(`Not enough coins to summon for {player.Name}.`)
		return { Success = false, PulledUnits = {} }
	end

	ActiveSummons[player] = true

	local ok, success, pulledUnits = pcall(function()
		local currentBanner = Banner.GetActiveBanner()
		if currentBanner.TotalWeight <= 0 or #currentBanner.Units == 0 then
			warn("Summon banner has no units with usable tower models.")
			return false, {}
		end

		DataService:AddData(player, "Coins", -totalCost)

		local pity = getPity(playerData)
		local results = {}
		local autoSellCoins = 0
		local autoSellShards = 0

		for _ = 1, amount do
			pity.Mythic += 1
			pity.Absolute += 1

			local forcedRarity
			if pity.Absolute >= ABSOLUTE_PITY_LIMIT then
				forcedRarity = "Absolute"
			elseif pity.Mythic >= MYTHIC_PITY_LIMIT then
				forcedRarity = "Mythic"
			end

			local unitName, rarity
			if forcedRarity then
				unitName = Banner.GetUnitForRarity(forcedRarity)
				if unitName then
					rarity = forcedRarity
				else
					unitName, rarity = rollSingleUnit(currentBanner)
				end
			else
				unitName, rarity = rollSingleUnit(currentBanner)
			end

			if unitName then
				local autoSellEntry = AutoSellConfig.ByRarity[rarity]
				local wasAutoSold = autoSellEntry ~= nil and playerData.Settings[autoSellEntry.SettingName] == true
				local sellPrice = if wasAutoSold then autoSellEntry.Price else 0
				table.insert(results, {
					UnitName = unitName,
					Rarity = rarity,
					Sold = wasAutoSold,
					SellPrice = sellPrice,
				})
				if wasAutoSold then
					autoSellCoins += sellPrice
					if UnitSellRewards.Roll(rarity, RANDOM) then
						autoSellShards += 1
					end
				else
					DataService:AddTower(player, unitName)
				end
			end

			if rarity == "Absolute" then
				pity.Absolute = 0
				pity.Mythic = 0
			elseif rarity == "Mythic" then
				pity.Mythic = 0
			end
		end

		DataService:UpdateData(player, "SummonPity", pity)
		if autoSellCoins > 0 then
			DataService:AddData(player, "Coins", autoSellCoins)
		end
		if autoSellShards > 0 then
			DataService:AddData(player, "Inventory", autoSellShards, "Items", UnitSellRewards.ItemName)
		end
		syncPityAttributes(player, pity)

		return true, results
	end)

	ActiveSummons[player] = nil

	if not ok then
		warn(`Summon failed:\n{success}`)
		return { Success = false, PulledUnits = {} }
	end

	return { Success = success, PulledUnits = pulledUnits }
end

function SummonService.Init(services)
	DataService = services:GetService("DataService")
end

function SummonService.Start()
	Players.PlayerRemoving:Connect(function(player)
		ActiveSummons[player] = nil
	end)

	task.spawn(function()
		while true do
			local serverTime = workspace:GetServerTimeNow()
			local secondsUntilTimerReset = BANNER_TIMER_DURATION - (serverTime % BANNER_TIMER_DURATION)
			task.wait(secondsUntilTimerReset)
			Net.SummonService.BannerUpdated.FireAll(Banner.GetClientFormat())
		end
	end)

	Net.SummonService.GetBanner.On(function(player: Player)
		local playerData = DataService:GetData(player)
		if playerData then
			syncPityAttributes(player, getPity(playerData))
		end
		return Banner.GetClientFormat()
	end)

	Net.SummonService.DoSummon.On(function(player: Player, amount: number)
		return SummonService.Summon(player, amount)
	end)
end

return SummonService
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="691">
            <Properties>
              <string name="Name">Banner</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SummonConfig = require(ReplicatedStorage.Settings.Data.SummonConfig)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)

local Banner = {}

Banner.UnitPool = SummonConfig.UnitPool
Banner.RarityRates = SummonConfig.RarityRates

local SECRET_SERVER_SALT = 8472957102
local BANNER_TIMER_DURATION = SummonConfig.BannerTimerDuration
local currentBanner = nil

local function hasTowerModel(unitName: string): boolean
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local towers = assets and assets:FindFirstChild("Towers")
	local towerModel = towers and towers:FindFirstChild(unitName)
	return towerModel ~= nil and towerModel:IsA("Model")
end

local function getModelBackedPool(rarity: string, configuredPool: { string }): { string }
	local validPool = {}
	for _, unitName in configuredPool do
		local unitInfo = TowerData.ByName[unitName]
		if unitInfo and unitInfo.Rarity == rarity and hasTowerModel(unitName) then
			table.insert(validPool, unitName)
		elseif not unitInfo or unitInfo.Rarity ~= rarity then
			warn(`[SummonBanner] Ignoring invalid {rarity} unit: {unitName}`)
		end
	end

	if #validPool > 0 then
		return validPool
	end

	-- If every configured candidate is missing a model, keep the rarity slot and
	-- repopulate it from all model-backed towers of that same rarity.
	for unitName, unitInfo in TowerData.ByName do
		if unitInfo.Rarity == rarity and hasTowerModel(unitName) then
			table.insert(validPool, unitName)
		end
	end
	table.sort(validPool)
	return validPool
end

function Banner.GetActiveBanner()
	if currentBanner then
		return currentBanner
	end

	local activeLineup = {}
	local totalWeight = 0

	for i, rateData in ipairs(Banner.RarityRates) do
		local pool = Banner.UnitPool[rateData.Rarity]
		if not pool or #pool == 0 then
			continue
		end

		local validPool = getModelBackedPool(rateData.Rarity, pool)
		if #validPool == 0 then
			continue
		end

		local rng = Random.new(SECRET_SERVER_SALT + (i * 9999))
		local selectedUnit = validPool[rng:NextInteger(1, #validPool)]

		table.insert(activeLineup, {
			Unit = selectedUnit,
			Rarity = rateData.Rarity,
			Weight = rateData.Weight,
		})
		totalWeight += rateData.Weight
	end

	currentBanner = {
		Units = activeLineup,
		TotalWeight = totalWeight,
	}

	return currentBanner
end

function Banner.GetUnitForRarity(rarity: string): string?
	for _, unitData in ipairs(Banner.GetActiveBanner().Units) do
		if unitData.Rarity == rarity then
			return unitData.Unit
		end
	end

	return nil
end

function Banner.GetClientFormat()
	local activeBanner = Banner.GetActiveBanner()
	local serverTime = workspace:GetServerTimeNow()
	local clientData = {
		NextRerollTime = math.floor(serverTime + (BANNER_TIMER_DURATION - (serverTime % BANNER_TIMER_DURATION))),
		Units = {},
	}

	for _, data in ipairs(activeBanner.Units) do
		table.insert(clientData.Units, {
			Rarity = data.Rarity,
			Name = data.Unit,
			RateText = tostring(data.Weight) .. "%",
		})
	end

	return clientData
end

return Banner
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="692">
          <Properties>
            <string name="Name">TimerService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local MemoryStoreService = game:GetService("MemoryStoreService")
local EnemyData = require(ReplicatedStorage.Settings.Data.EnemyData)
local RaidSettings = require(ReplicatedStorage.Settings.Game.RaidSettings)
local Net = require(ReplicatedStorage.Shared.Net)

local KST_OFFSET = 9 * 3600
local BOSS_MEMORY_MAP = MemoryStoreService:GetHashMap("RaidBossMap")

local TimerService = {}

local lastTargetTime = 0
local debugOverrideTime = nil

local TARGET_COMPONENTS_MAP = {}
local MAP = workspace:WaitForChild("MAP", 10)

local function findComponents(parent)
    for _, child in parent:GetDescendants() do
        for _, bossColors in pairs(RaidSettings.ComponentColors) do
            if bossColors[child.Name] then
                if not TARGET_COMPONENTS_MAP[child.Name] then
                    TARGET_COMPONENTS_MAP[child.Name] = {}
                end
                table.insert(TARGET_COMPONENTS_MAP[child.Name], child)
                break
            end
        end
    end
end

for _, child in MAP:GetDescendants() do
    if child.Name == "RaidPortal" or child.Name == "PortalArea" or child.Name == "PortalLantern" or child.Name == "PortalStone" or child.Name == "Portalfloor" or child.Name == "SmokeVFX" then
        findComponents(child)
    end
end

function TimerService.Init() end

function TimerService.ForceTimer(seconds)
	debugOverrideTime = os.time() + seconds
	ReplicatedStorage:SetAttribute("NextHourTimestamp", debugOverrideTime)
end

function TimerService.SelectRaidBoss()
	local success, currentBoss = pcall(function()
		return BOSS_MEMORY_MAP:GetAsync("ActiveBoss")
	end)

	if success and currentBoss then
		print("기존 레이드 보스 불러옴: " .. currentBoss)
		TimerService.TransitionPortalColor(currentBoss, 3)
		Net.RaidService.RaidBossSpawned.FireAll({
			BossName = currentBoss
		})
		return
	end

	local totalWeight = 0
	for _, weight in pairs(RaidSettings.BossWeights) do
		totalWeight += weight
	end

	local randomValue = math.random() * totalWeight
	local currentWeight = 0
	local selectedBoss = nil

	for bossName, weight in pairs(RaidSettings.BossWeights) do
		currentWeight += weight
		if randomValue <= currentWeight then
			selectedBoss = bossName
			break
		end
	end

	if selectedBoss then
		print("새로운 레이드 보스 선택됨: " .. selectedBoss)
        
		pcall(function()
			-- Store for the remainder of the hour (max 3600 seconds)
			local secondsLeftInHour = 3600 - ((os.time() + KST_OFFSET) % 3600)
			BOSS_MEMORY_MAP:SetAsync("ActiveBoss", selectedBoss, secondsLeftInHour)
		end)

        TimerService.TransitionPortalColor(selectedBoss, 3)

		Net.RaidService.RaidBossSpawned.FireAll({
			BossName = selectedBoss
		})
	end
end

function TimerService.ApplyColor(child, color)
    if child:IsA("ParticleEmitter") or child:IsA("Beam") then
        child.Color = ColorSequence.new(color)
    elseif child:IsA("Light") then
        child.Color = color
    elseif child:IsA("BasePart") then
        child.Color = color
    elseif child:IsA("Decal") or child:IsA("Texture") then
        child.Color3 = color
    end
end

function TimerService.GetStartColor(child)
    if child:IsA("ParticleEmitter") or child:IsA("Beam") then
        return child.Color.Keypoints[1].Value
    elseif child:IsA("Light") or child:IsA("BasePart") then
        return child.Color
    elseif child:IsA("Decal") or child:IsA("Texture") then
        return child.Color3
    end
    return nil
end

function TimerService.TransitionPortalColor(bossName, duration)
    local colorMap = RaidSettings.ComponentColors[bossName]
    if not colorMap then return end

    local steps = 30
    local interval = duration / steps

    local startColors = {}
    for name, instances in pairs(TARGET_COMPONENTS_MAP) do
        local targetColor = colorMap[name]
        if targetColor then
            for _, child in instances do
                startColors[child] = TimerService.GetStartColor(child)
            end
        end
    end

    task.spawn(function()
        for i = 1, steps do
            local alpha = i / steps
            local smoothAlpha = 0.5 - 0.5 * math.cos(alpha * math.pi)
            
            for child, startColor in pairs(startColors) do
                local targetColor = colorMap[child.Name]
                if targetColor and startColor then
                    TimerService.ApplyColor(child, startColor:Lerp(targetColor, smoothAlpha))
                end
            end
            task.wait(interval)
        end
    end)
end

function TimerService.Start()
	local function UpdateNextHour()
		local now = os.time()
		
		local secondsPassedInHour = (now + KST_OFFSET) % 3600
		local nextHour = now + (3600 - secondsPassedInHour)
		
		if nextHour ~= lastTargetTime then
			lastTargetTime = nextHour
			ReplicatedStorage:SetAttribute("NextHourTimestamp", nextHour)
			
			TimerService.SelectRaidBoss()
		end
	end

	UpdateNextHour()

	task.spawn(function()
		while true do
			task.wait(1)
			UpdateNextHour()
		end
	end)
end

return TimerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="693">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local TradeSession = require(script.TradeSession)
local DataService
local SettingsService

--/Types
type OfferData = TradeSession.OfferData
type Session = TradeSession.Session
type RequestLog = { [string]: number }

local REQUEST_COOLDOWN = 15
local REQUEST_TIMEOUT = 30

local RequestLog: RequestLog = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function HasTradeRequest(requester: Player, receiver: Player)
	return RequestLog[`{requester.UserId}-{receiver.UserId}`] ~= nil
end

-------------------------------------------------
--// TradeService
-------------------------------------------------
local TradeService = {}

function TradeService.SendRequest(requester: Player, receiver: Player): (boolean, string?)
	if not SettingsService:GetSettings(requester, "Trade") then
		return false, "Trading is turned off. Enable it in Settings to send trade requests."
	end

	if not SettingsService:GetSettings(receiver, "Trade") then
		return false, `{receiver.DisplayName} isn't accepting trade requests right now.`
	end

	if HasTradeRequest(receiver, requester) then
		return TradeService.AcceptRequest(receiver, requester)
	end

	local key = `{requester.UserId}-{receiver.UserId}`
	local lastRequest = RequestLog[key]
	if lastRequest and os.clock() - lastRequest < REQUEST_COOLDOWN then
		return false,
			`You're sending trade requests too quickly. Try again in {REQUEST_COOLDOWN - (os.clock() - lastRequest)} seconds.`
	end
	if requester == receiver then
		return false, "You can't trade with yourself."
	end
	if not DataService:GetData(requester) or not DataService:GetData(receiver) then
		return false, "Player data is still loading. Please try again in a moment."
	end
	if TradeSession.GetSessionFromPlayer(requester) or TradeSession.GetSessionFromPlayer(receiver) then
		return false, "One of the players is already in a trade."
	end

	local requestedAt = os.clock()
	RequestLog[key] = requestedAt

	task.delay(REQUEST_TIMEOUT, function()
		if RequestLog[key] == requestedAt then
			RequestLog[key] = nil
		end
	end)

	Net.TradeService.RequestReceived.Fire(receiver, requester)

	return true
end

function TradeService.AcceptRequest(requester: Player, acceptor: Player): (boolean, string?)
	if not SettingsService:GetSettings(requester, "Trade") then
		return false, `{requester.DisplayName} has turned off trading.`
	end

	if not SettingsService:GetSettings(acceptor, "Trade") then
		return false, "Trading is turned off. Enable it in Settings to accept trade requests."
	end

	local key = `{requester.UserId}-{acceptor.UserId}`
	local lastRequest = RequestLog[key]
	if not lastRequest then
		return false, "This trade request is no longer available."
	end

	if os.clock() - lastRequest > REQUEST_TIMEOUT then
		return false, "This trade request has expired."
	end
	if TradeSession.GetSessionFromPlayer(requester) or TradeSession.GetSessionFromPlayer(acceptor) then
		return false, "One of the players is already in a trade."
	end

	RequestLog[key] = nil
	TradeService.StartTrade(requester, acceptor)

	return true
end

function TradeService.StartTrade(player1: Player, player2: Player): Session?
	if player1 == player2 then
		return
	end
	if not DataService:GetData(player1) or not DataService:GetData(player2) then
		return
	end
	if TradeSession.GetSessionFromPlayer(player1) or TradeSession.GetSessionFromPlayer(player2) then
		return
	end

	local session: Session = TradeSession.new(player1, player2)

	Net.TradeService.TradeStarted.FireList({ session.Player1, session.Player2 }, {
		Player1 = session.Player1,
		Player2 = session.Player2,
	})

	return session
end

function TradeService.AddOffer(sessionId: string, player: Player, offerData: OfferData)
	local targetSession = TradeSession.GetSessionFromId(sessionId)
	if not targetSession then
		warn(`요청 한 세션: {sessionId}가 존재하지 않음`)
		return
	end

	local success = targetSession:AddOffer(player, offerData.offerType, offerData.offerName, offerData.offerArg)
	if success then
		Net.TradeService.OfferChanged.FireList({ targetSession.Player1, targetSession.Player2 }, {
			Offerer = player,
			Offer = targetSession.Offers[player],
			Version = targetSession.Version,
		})
	end
end

function TradeService.RemoveOffer(sessionId: string, player: Player, offerData: OfferData)
	local targetSession = TradeSession.GetSessionFromId(sessionId)
	if not targetSession then
		warn(`요청 한 세션: {sessionId}가 존재하지 않음`)
		return
	end

	local success = targetSession:RemoveOffer(player, offerData.offerType, offerData.offerName, offerData.offerArg)
	if success then
		Net.TradeService.OfferChanged.FireList({ targetSession.Player1, targetSession.Player2 }, {
			Offerer = player,
			Offer = targetSession.Offers[player],
			Version = targetSession.Version,
		})
	end
end

function TradeService.SetReady(sessionId: string, player: Player, action: boolean, clientVersion: number): boolean
	local targetSession = TradeSession.GetSessionFromId(sessionId)
	if not targetSession then
		warn(`요청 한 세션: {sessionId}가 존재하지 않음`)
		return false
	end

	return targetSession:SetReady(player, action, clientVersion)
end

function TradeService.CancelTrade(sessionId: string, reason: string?)
	local targetSession = TradeSession.GetSessionFromId(sessionId)
	if not targetSession then
		warn(`요청 한 세션: {sessionId}가 존재하지 않음`)
		return false
	end

	targetSession:Break(reason or "The trade has been cancelled.")
	return true
end

function TradeService.Init(services: any)
	DataService = services:GetService("DataService")
	SettingsService = services:GetService("SettingsService")

	TradeSession.Init(services)
end

function TradeService.Start()
	Players.PlayerRemoving:Connect(function(player: Player)
		local playerSession = TradeSession.GetSessionFromPlayer(player)
		if playerSession then
			TradeService.CancelTrade(
				playerSession.SessionId,
				`The trade was cancelled because {player.DisplayName} left the game.`
			)
		end
	end)

	--/Event
	TradeSession.ReadyChanged:Connect(function(sessionId: string, player: Player, isReady: boolean)
		local session = TradeSession.GetSessionFromId(sessionId)
		if not session then
			return
		end

		Net.TradeService.ReadyChanged.FireList({ session.Player1, session.Player2 }, {
			UserId = player.UserId,
			IsReady = isReady,
		})
	end)
	TradeSession.TradeEnded:Connect(function(sessionId: string, endType: "Completed" | "Cancelled", reason: string)
		local targetSession = TradeSession.GetSessionFromId(sessionId)
		if not targetSession then
			return
		end

		Net.TradeService.TradeEnded.FireList({ targetSession.Player1, targetSession.Player2 }, {
			EndType = endType,
			Reason = reason,
		})
	end)

	--/Functions: Request
	Net.TradeService.SendRequest.On(function(player: Player, receiver: Player): { Success: boolean, Reason: string? }
		local success, reason = TradeService.SendRequest(player, receiver)
		return { Success = success, Reason = reason }
	end)
	Net.TradeService.AcceptRequest.On(function(player: Player, requester: Player): { Success: boolean, Reason: string? }
		local success, reason = TradeService.AcceptRequest(requester, player)
		return { Success = success, Reason = reason }
	end)

	--/Functions: OnTrading
	Net.TradeService.AddOffer.On(function(player: Player, offerData: OfferData)
		local targetSession = TradeSession.GetSessionFromPlayer(player)
		if not targetSession then
			return
		end

		TradeService.AddOffer(targetSession.SessionId, player, offerData)
	end)
	Net.TradeService.RemoveOffer.On(function(player: Player, offerData: OfferData)
		local targetSession = TradeSession.GetSessionFromPlayer(player)
		if not targetSession then
			return
		end

		TradeService.RemoveOffer(targetSession.SessionId, player, offerData)
	end)
	Net.TradeService.SetReady.On(function(player: Player, data: { Action: boolean, Version: number })
		local targetSession = TradeSession.GetSessionFromPlayer(player)
		if not targetSession then
			return false
		end

		return TradeService.SetReady(targetSession.SessionId, player, data.Action, data.Version)
	end)
	Net.TradeService.CancelTrade.On(function(player: Player)
		local targetSession = TradeSession.GetSessionFromPlayer(player)
		if not targetSession then
			return
		end

		TradeService.CancelTrade(targetSession.SessionId)
	end)
end

return TradeService
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="694">
            <Properties>
              <string name="Name">TradeSession</string>
              <string name="Source"><![CDATA[--/Services
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

--/Modules
local Signal = require(ReplicatedStorage.Packages.Signal)
local DataService: any = require(ServerScriptService.Server.Services.DataService)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

--/Types
export type OfferType = "Tower" | "Item"
export type TowerSnapshot = { [string]: any }
export type TowerOffers = { [string]: { [string]: TowerSnapshot } }
export type ItemOffers = { [string]: number }

export type TradeOffer = {
	Towers: TowerOffers,
	Items: ItemOffers,
}

export type TradeState = "Building" | "Countdown" | "Committing" | "Completed" | "Cancelled"

export type OfferData = {
	offerType: OfferType,
	offerName: string,
	offerArg: (string | number)?,
}

export type Session = {
	SessionId: string,
	Player1: Player,
	Player2: Player,
	Version: number,
	Offers: { [Player]: TradeOffer },
	Ready: { [Player]: boolean },
	_CountdownConn: thread?,
	CurrentState: TradeState,

	AddOffer: (
		self: Session,
		offerGiver: Player,
		offerType: OfferType,
		offerName: string,
		offerArg: (string | number)?
	) -> (),
	RemoveOffer: (
		self: Session,
		offerGiver: Player,
		offerType: OfferType,
		offerName: string,
		offerArg: (string | number)?
	) -> (),
	SetReady: (self: Session, player: Player, action: boolean, clientVersion: number) -> boolean,
	ResetReady: (self: Session) -> (),
	BeginCountdown: (self: Session) -> (),
	CancelCountdown: (self: Session) -> (),
	ValidateTrade: (self: Session) -> (boolean, string?),
	CommitTrade: (self: Session) -> (),
	Destroy: (self: Session) -> (),
}

--/Constants
local COUNTDOWN_TIME = 5

--/Variables
local ActiveSessions: { [string]: Session } = {}
local PlayerToSession: { [Player]: Session } = {}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function GetTblPath(parentTable: TowerOffers, key: string): { [string]: TowerSnapshot }
	parentTable[key] = parentTable[key] or {}

	return parentTable[key]
end

local function FindParticipant(targetPlayer: Player, plr1: Player, plr2: Player): Player?
	if targetPlayer == plr1 then
		return plr1
	elseif targetPlayer == plr2 then
		return plr2
	else
		return nil
	end
end

local function VerifyTower(player: Player, towerName: string, towerKey: string): TowerSnapshot?
	local playerData = DataService:GetData(player)
	if not playerData then
		return nil
	end

	local towerCategory = playerData.OwnedTowers[towerName]
	if not towerCategory then
		return nil
	end

	local targetTower = towerCategory[towerKey]
	if not targetTower then
		return nil
	end

	return targetTower
end

local function VerifyItem(player: Player, itemName: string, amount: number): boolean
	local playerData = DataService:GetData(player)
	if not playerData then
		return false
	end

	local targetItem = playerData.Inventory.Items[itemName]
	if not targetItem or targetItem < (amount or 1) then
		return false
	end

	return true
end

local function ApplyDeductions(player: Player, offer: TradeOffer)
	for towerName, towerKeys in offer.Towers do
		for towerKey in towerKeys do
			DataService:RemoveTower(player, towerName, towerKey)
		end
	end

	for itemName, amount in offer.Items do
		DataService:AddData(player, "Inventory", -amount, "Items", itemName)
	end
end

local function GrantResult(player: Player, offer: TradeOffer)
	for towerName, towerKeys in offer.Towers do
		for _, towerData in towerKeys do
			DataService:AddTower(player, towerName, towerData)
		end
	end

	for itemName, amount in offer.Items do
		DataService:AddData(player, "Inventory", amount, "Items", itemName)
	end
end

-------------------------------------------------
--// TradeSession
-------------------------------------------------
local TradeSession = {}
TradeSession.__index = TradeSession
TradeSession.ReadyChanged = Signal.new()
TradeSession.StartCountdown = Signal.new()
TradeSession.TradeEnded = Signal.new()

function TradeSession.GetSessionFromId(sessionId: string): Session?
	return ActiveSessions[sessionId]
end

function TradeSession.GetSessionFromPlayer(player: Player): Session?
	return PlayerToSession[player]
end

function TradeSession.new(plr1: Player, plr2: Player): Session
	local self = setmetatable({}, TradeSession)
	self.SessionId = HttpService:GenerateGUID(false)
	self.Player1 = plr1
	self.Player2 = plr2
	self.Version = 0

	self.Offers = {
		[self.Player1] = {
			Towers = {},
			Items = {},
		},
		[self.Player2] = {
			Towers = {},
			Items = {},
		},
	}
	self.Ready = {
		[self.Player1] = false,
		[self.Player2] = false,
	}

	self._CountdownConn = nil
	self.CurrentState = "Building"

	ActiveSessions[self.SessionId] = self
	PlayerToSession[self.Player1] = self
	PlayerToSession[self.Player2] = self

	return self
end

function TradeSession:OnOfferChanged()
	self.Version += 1
	self:ResetReady()
end

function TradeSession:AddOffer(
	offerGiver: Player,
	offerType: OfferType,
	offerName: string,
	offerArg: (string | number)?
)
	if self.CurrentState ~= "Building" then
		return false
	end

	local targetPlayer = FindParticipant(offerGiver, self.Player1, self.Player2)
	if not targetPlayer then
		return false
	end

	if offerType == "Tower" then
		if typeof(offerArg) ~= "string" then
			return false
		end

		local targetTower = VerifyTower(targetPlayer, offerName, offerArg)
		if not targetTower then
			return false
		end

		GetTblPath(self.Offers[targetPlayer].Towers, offerName)[offerArg] = TableUtils.DeepCopy(targetTower)
	elseif offerType == "Item" then
		if typeof(offerArg) == "string" then
			return false
		end

		local currentAmount = self.Offers[targetPlayer].Items[offerName] or 0
		if currentAmount < 0 then
			return false
		end

		local canAffort = VerifyItem(targetPlayer, offerName, currentAmount + (offerArg or 1))
		if not canAffort then
			return false
		end

		self.Offers[targetPlayer].Items[offerName] += (offerArg or 1)
	else
		warn(`알 수 없는 OfferType: {offerType}.`)
		return false
	end

	self:OnOfferChanged()

	return true
end

function TradeSession:RemoveOffer(
	offerGiver: Player,
	offerType: OfferType,
	offerName: string,
	offerArg: (string | number)?
)
	if self.CurrentState ~= "Building" then
		return false
	end

	local targetPlayer = FindParticipant(offerGiver, self.Player1, self.Player2)
	if not targetPlayer then
		return false
	end

	if offerType == "Tower" then
		if typeof(offerArg) ~= "string" then
			return false
		end

		local offeredCategory = self.Offers[targetPlayer].Towers[offerName]
		if not offeredCategory then
			return false
		end

		local offeredTower = self.Offers[targetPlayer].Towers[offerName][offerArg]
		if not offeredTower then
			return false
		end

		GetTblPath(self.Offers[targetPlayer].Towers, offerName)[offerArg] = nil
	elseif offerType == "Item" then
		if typeof(offerArg) == "string" then
			return false
		end

		local subtractValue = self.Offers[targetPlayer].Items[offerName] - (offerArg or 1)
		self.Offers[targetPlayer].Items[offerName] = math.max(subtractValue, 0)
	else
		warn(`알 수 없는 OfferType: {offerType}.`)
		return false
	end

	self:OnOfferChanged()

	return true
end

function TradeSession:SetReady(player: Player, action: boolean, clientVersion: number)
	if self.CurrentState ~= "Building" and self.CurrentState ~= "Countdown" then
		return false
	end

	if typeof(clientVersion) ~= "number" or self.Version ~= clientVersion then
		return false
	end

	local targetPlayer = FindParticipant(player, self.Player1, self.Player2)
	if not targetPlayer then
		return false
	end
	if self.Ready[targetPlayer] == action then
		return false
	end

	self.Ready[targetPlayer] = action
	self.ReadyChanged:Fire(self.SessionId, targetPlayer, action)

	if action == true then
		local otherPlayer = if targetPlayer == self.Player1 then self.Player2 else self.Player1
		if self.Ready[otherPlayer] == true then
			self:BeginCountdown()
		end
	elseif action == false then
		if self.CurrentState == "Countdown" then
			self:CancelCountdown()
		end
	end

	return true
end

function TradeSession:ResetReady()
	for _, player in { self.Player1, self.Player2 } do
		if not self.Ready[player] then
			continue
		end

		self.Ready[player] = false
		self.ReadyChanged:Fire(self.SessionId, player, false)
	end
end

function TradeSession:BeginCountdown()
	if self.CurrentState ~= "Building" then
		return
	end

	self.CurrentState = "Countdown"

	self._CountdownConn = task.delay(COUNTDOWN_TIME, function()
		self._CountdownConn = nil
		self:CommitTrade()
	end)
end

function TradeSession:CancelCountdown()
	if self.CurrentState == "Committing" then
		return
	end

	self:ResetReady()
	self.CurrentState = "Building"

	if self._CountdownConn then
		task.cancel(self._CountdownConn)
		self._CountdownConn = nil
	end
end

function TradeSession:ValidateTrade(): (boolean, string?)
	if not self.Player1:IsDescendantOf(Players) or not self.Player2:IsDescendantOf(Players) then
		return false, "A player left the game before the trade could be completed."
	end

	for player, offers in self.Offers do
		local playerData = DataService:GetData(player)
		if not playerData then
			return false, `Couldn't load {player.DisplayName}'s data. The trade has been cancelled.`
		end

		for towerName, towerKeys in offers.Towers do
			if not playerData.OwnedTowers[towerName] then
				return false, `{player.DisplayName} no longer has the {towerName} tower. The trade has been cancelled.`
			end

			for towerKey in towerKeys do
				if not playerData.OwnedTowers[towerName][towerKey] then
					return false,
						`{player.DisplayName} no longer has the {towerName} tower. The trade has been cancelled.`
				end
			end
		end

		for itemName, amount in offers.Items do
			if (playerData.Inventory.Items[itemName] or 0) < amount then
				return false, `{player.DisplayName} no longer has enough {itemName}. The trade has been cancelled.`
			end
		end
	end

	return true
end

function TradeSession:CommitTrade()
	if self.CurrentState ~= "Countdown" then
		return
	end

	self.CurrentState = "Committing"

	local valid, reason = self:ValidateTrade()
	if not valid then
		self:Break(reason)
		return
	end

	ApplyDeductions(self.Player1, self.Offers[self.Player1])
	ApplyDeductions(self.Player2, self.Offers[self.Player2])

	GrantResult(self.Player1, self.Offers[self.Player2])
	GrantResult(self.Player2, self.Offers[self.Player1])

	DataService:SaveData(self.Player1)
	DataService:SaveData(self.Player2)

	self:Complete()
end

function TradeSession:Complete()
	self.CurrentState = "Completed"

	self.TradeEnded:Fire(self.SessionId, "Completed")
	self:EndSession()
end

function TradeSession:Break(reason: string?)
	self.CurrentState = "Cancelled"

	self.TradeEnded:Fire(self.SessionId, "Cancelled", reason)
	self:EndSession()
end

function TradeSession:EndSession()
	if self._CountdownConn then
		task.cancel(self._CountdownConn)
		self._CountdownConn = nil
	end

	task.defer(function()
		ActiveSessions[self.SessionId] = nil
		PlayerToSession[self.Player1] = nil
		PlayerToSession[self.Player2] = nil
	end)
end

function TradeSession.Init(services)
	DataService = services:GetService("DataService")
end

return TradeSession
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="695">
          <Properties>
            <string name="Name">TradeServiceSmf</string>
            <string name="Source"><![CDATA[--/Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

--/Modules
local Net = require(ReplicatedStorage.Shared.Net)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

local DataService: any -- Init 시점 지연 로드

--/Variables
local TradeLogStore = DataStoreService:GetDataStore("TradeLogs_v1")
local PendingTradeStore = DataStoreService:GetDataStore("PendingTrades_v1") -- 크래시 재정산용 에스크로 원장

local ActiveSessions: { [string]: TradeSession } = {}
local PlayerToSession: { [Player]: string } = {}

local SESSION_TIMEOUT = 300 -- 마지막 상호작용 후 5분 경과 시 자동 파기
local MAX_ID_LENGTH = 64 -- 경계단 문자열 길이 상한
local LOG_FLUSH_INTERVAL = 60 -- 거래 로그 배치 저장 주기(초)
local MAX_LOG_QUEUE = 500 -- 큐 상한. 초과 시 가장 오래된 로그부터 폐기
local LOG_BATCH_MAX = 50 -- 한 키에 담는 최대 레코드 수

local LogQueue: { SerializedSession } = {}

--/Configuration (취약점 해소: 내부 데이터 거래 방지용 화이트리스트)
local TradeConfig = {
	-- 거래가 허용된 안전한 재화 목록만 등록하세요.
	-- 주의: "Level", "Exp" 등 내부 데이터 키는 절대 등록하면 안 됩니다.
	AllowedCurrencies = {
		["Coins"] = true,
		["Gems"] = true,
	},
	-- 아이템이 거래 가능한 속성인지 판단하는 함수
	IsItemTradeable = function(itemId: string): boolean
		-- TODO: 실제 게임의 아이템 데이터 모듈과 연동하여 Tradeable 여부를 반환하세요.
		-- 예: return ItemData[itemId].Tradeable == true
		return true
	end,
}

--/Types
type TradeOffer = {
	Currency: { [string]: number },
	Items: { [string]: number },
	Towers: { [string]: string }, -- towerKey -> towerName
}

type TradeSession = {
	Id: string,
	Version: number,
	Created: number,
	LastActivity: number,
	State: "Building" | "Committing" | "Committed" | "Cancelled",
	Members: { Player },
	Offers: { [Player]: TradeOffer },
	Confirmed: { [Player]: boolean },
}

type TowerSnapshot = {
	Name: string,
	Data: any,
}

type TradeSidePayload = {
	Currency: { [string]: number },
	Items: { [string]: number },
	Towers: { [string]: TowerSnapshot },
}

type TradeSide = {
	TradeId: string,
	At: number,
	Gives: TradeSidePayload,
	Receives: TradeSidePayload,
}

type SerializedSession = {
	Id: string,
	Version: number,
	State: string,
	Created: number,
	SavedAt: number,
	Members: { string },
	Offers: { [string]: TradeOffer },
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function NewOffer(): TradeOffer
	return { Currency = {}, Items = {}, Towers = {} }
end

local function IsValidId(value: any): boolean
	return type(value) == "string" and #value > 0 and #value <= MAX_ID_LENGTH
end

local function IsValidAmount(value: any): boolean
	return type(value) == "number" and value > 0 and value % 1 == 0 and value < 1e15
end

local function SafeFire(remote: any, player: Player, payload: any?)
	if player and player.Parent == Players then
		remote.Fire(player, payload)
	end
end

local function BroadcastState(session: TradeSession)
	local payload = {
		SessionId = session.Id,
		Version = session.Version,
		State = session.State,
		Offers = {},
		Confirmed = {},
	}
	for _, member in session.Members do
		local key = tostring(member.UserId)
		payload.Offers[key] = session.Offers[member]
		payload.Confirmed[key] = session.Confirmed[member]
	end
	for _, member in session.Members do
		SafeFire(Net.TradeService.OfferUpdated, member, payload)
	end
end

local function OnOfferChanged(session: TradeSession)
	session.Version += 1
	session.LastActivity = os.time()
	for _, player in session.Members do
		session.Confirmed[player] = false
	end
	BroadcastState(session)
end

local function GetEditableSession(player: Player): (TradeSession?, string?)
	local sessionId = PlayerToSession[player]
	if not sessionId then
		return nil, "진행 중인 거래가 없습니다."
	end
	local session = ActiveSessions[sessionId]
	if not session or session.State ~= "Building" then
		return nil, "지금은 거래 내용을 수정할 수 없습니다."
	end
	return session, nil
end

local function GetSessionAndData(player: Player): (TradeSession?, any, string?)
	local session, err = GetEditableSession(player)
	if not session then
		return nil, nil, err
	end
	local playerData = DataService:GetData(player)
	if not playerData then
		return nil, nil, "데이터 미로드"
	end
	return session, playerData, nil
end

local function IsTowerEquipped(playerData: any, towerKey: string): boolean
	for _, loadoutData in playerData.Loadout do
		if loadoutData.Key == towerKey then
			return true
		end
	end
	return false
end

local function ValidateOffer(player: Player, offer: TradeOffer): (boolean, string?)
	local playerData = DataService:GetData(player)
	if not playerData then
		return false, "데이터 미로드"
	end

	for currencyId, amount in offer.Currency do
		if (playerData[currencyId] or 0) < amount then
			return false, `재화 부족: {currencyId}`
		end
	end

	for itemId, amount in offer.Items do
		if (playerData.Inventory.Items[itemId] or 0) < amount then
			return false, `아이템 부족: {itemId}`
		end
	end

	for towerKey, towerName in offer.Towers do
		local towerType = playerData.OwnedTowers[towerName]
		if not towerType or not towerType[towerKey] then
			return false, `타워 누락: {towerName}`
		end
		if IsTowerEquipped(playerData, towerKey) then
			return false, `장착 중인 타워는 거래할 수 없습니다: {towerName}`
		end
	end

	return true, nil
end

local function CanReceiveOffer(receiver: Player, incoming: TradeOffer): (boolean, string?)
	local receiverData = DataService:GetData(receiver)
	if not receiverData then
		return false, "수신자 데이터 미로드"
	end
	return true, nil
end

local function ApplyTradeSide(player: Player, gives: TradeSidePayload, receives: TradeSidePayload)
	for currencyId, amount in gives.Currency do
		DataService:AddData(player, currencyId, -amount)
	end
	for itemId, amount in gives.Items do
		DataService:AddData(player, "Inventory", -amount, "Items", itemId)
	end
	for towerKey, info in gives.Towers do
		DataService:RemoveTower(player, info.Name, towerKey)
	end

	for currencyId, amount in receives.Currency do
		DataService:AddData(player, currencyId, amount)
	end
	for itemId, amount in receives.Items do
		DataService:AddData(player, "Inventory", amount, "Items", itemId)
	end
	for _, info in receives.Towers do
		DataService:AddTower(player, info.Name, info.Data)
	end
end

local function ValidateSession(session: TradeSession): (boolean, string?)
	local plr1, plr2 = session.Members[1], session.Members[2]
	local ok1, why1 = ValidateOffer(plr1, session.Offers[plr1])
	if not ok1 then
		return false, why1
	end
	local ok2, why2 = ValidateOffer(plr2, session.Offers[plr2])
	if not ok2 then
		return false, why2
	end

	local rOk1, rWhy1 = CanReceiveOffer(plr2, session.Offers[plr1])
	if not rOk1 then
		return false, rWhy1
	end
	local rOk2, rWhy2 = CanReceiveOffer(plr1, session.Offers[plr2])
	if not rOk2 then
		return false, rWhy2
	end

	return true, nil
end

local function SnapshotTowers(player: Player, session: TradeSession): { [string]: TowerSnapshot }
	local data = DataService:GetData(player)
	local snap = {}
	if not data then
		return snap
	end

	for towerKey, towerName in session.Offers[player].Towers do
		local towerData = data.OwnedTowers[towerName] and data.OwnedTowers[towerName][towerKey]
		if towerData then
			snap[towerKey] = {
				Name = towerName,
				Data = TableUtils.DeepCopy(towerData),
			}
		end
	end
	return snap
end

local function BuildTradeSide(
	sessionId: string,
	givesOffer: TradeOffer,
	givesSnap: { [string]: TowerSnapshot },
	receivesOffer: TradeOffer,
	receivesSnap: { [string]: TowerSnapshot }
): TradeSide
	return {
		TradeId = sessionId,
		At = os.time(),
		Gives = {
			Currency = givesOffer.Currency,
			Items = givesOffer.Items,
			Towers = givesSnap,
		},
		Receives = {
			Currency = receivesOffer.Currency,
			Items = receivesOffer.Items,
			Towers = receivesSnap,
		},
	}
end

local function WritePendingEscrow(plr1: Player, plr2: Player, sideA: TradeSide, sideB: TradeSide): boolean
	local escrowOk = pcall(function()
		PendingTradeStore:SetAsync(`Pending_{plr1.UserId}`, sideA)
		PendingTradeStore:SetAsync(`Pending_{plr2.UserId}`, sideB)
	end)
	return escrowOk
end

local function RemovePendingEscrow(plr1: Player, plr2: Player)
	pcall(function()
		PendingTradeStore:RemoveAsync(`Pending_{plr1.UserId}`)
		PendingTradeStore:RemoveAsync(`Pending_{plr2.UserId}`)
	end)
end

local function WriteCommitToken(sessionId: string): boolean
	local commitKey = `Committed_{sessionId}`
	local tokenOk = pcall(function()
		PendingTradeStore:SetAsync(commitKey, { TradeId = sessionId, At = os.time() })
	end)
	return tokenOk
end

local function RemoveCommitToken(sessionId: string)
	local commitKey = `Committed_{sessionId}`
	pcall(function()
		PendingTradeStore:RemoveAsync(commitKey)
	end)
end

local function SettlePlayerTrade(player: Player, side: TradeSide, sessionId: string)
	ApplyTradeSide(player, side.Gives, side.Receives)
	DataService:UpdateData(player, "LastTradeId", sessionId)
	local saveOk = pcall(function()
		DataService:SaveData(player)
	end)
	if saveOk then
		pcall(function()
			PendingTradeStore:RemoveAsync(`Pending_{player.UserId}`)
		end)
	end
	SafeFire(Net.TradeService.TradeCompleted, player, { SessionId = sessionId })
end

local function SerializeSession(session: TradeSession): SerializedSession
	local serialized: SerializedSession = {
		Id = session.Id,
		Version = session.Version,
		State = session.State,
		Created = session.Created,
		SavedAt = os.time(),
		Members = {},
		Offers = {},
	}
	for _, player in session.Members do
		local userId = tostring(player.UserId)
		table.insert(serialized.Members, userId)
		serialized.Offers[userId] = TableUtils.DeepCopy(session.Offers[player])
	end
	return serialized
end

-------------------------------------------------
--// TradeService
-------------------------------------------------
local TradeService = {}

function TradeService.IsPlayerTrading(player: Player): boolean
	local sessionId = PlayerToSession[player]
	if not sessionId then
		return false
	end

	local session = ActiveSessions[sessionId]
	return session and (session.State == "Building" or session.State == "Committing")
end

function TradeService.CreateSession(plr1: Player, plr2: Player): (TradeSession?, string?)
	if plr1 == plr2 then
		return nil, "자기 자신과는 거래할 수 없습니다."
	end
	if PlayerToSession[plr1] or PlayerToSession[plr2] then
		return nil, "이미 다른 거래가 진행 중입니다."
	end
	if not DataService:GetData(plr1) or not DataService:GetData(plr2) then
		return nil, "참가자의 데이터가 아직 로드되지 않았습니다."
	end

	local sessionId = HttpService:GenerateGUID(false)
	local now = os.time()

	local session: TradeSession = {
		Id = sessionId,
		Version = 1,
		Created = now,
		LastActivity = now,
		State = "Building",
		Members = { plr1, plr2 },
		Offers = { [plr1] = NewOffer(), [plr2] = NewOffer() },
		Confirmed = { [plr1] = false, [plr2] = false },
	}

	ActiveSessions[sessionId] = session
	PlayerToSession[plr1] = sessionId
	PlayerToSession[plr2] = sessionId
	return session, nil
end

function TradeService.LogSession(session: TradeSession, id: string?): boolean
	local key = id or session.Id
	local serializable = SerializeSession(session)

	local ok, err = pcall(function()
		TradeLogStore:SetAsync(key, serializable)
	end)
	if not ok then
		warn(`거래 세션 {key} 저장 실패: {err}`)
		return false
	end
	return true
end

function TradeService.AddItem(player: Player, id: string, amount: number): (boolean, string?)
	if not IsValidId(id) then
		return false, "잘못된 아이템 식별자입니다."
	end
	if not IsValidAmount(amount) then
		return false, "잘못된 수량입니다."
	end
	if not TradeConfig.IsItemTradeable(id) then
		return false, "거래가 불가능한 아이템입니다."
	end

	local session, playerData, err = GetSessionAndData(player)
	if not session or not playerData then
		return false, err
	end

	local offer = session.Offers[player]
	local owned = playerData.Inventory.Items[id] or 0
	local alreadyOffered = offer.Items[id] or 0
	if owned < alreadyOffered + amount then
		return false, "보유 수량보다 많이 올릴 수 없습니다."
	end

	offer.Items[id] = alreadyOffered + amount
	OnOfferChanged(session)
	return true, nil
end

function TradeService.RemoveItem(player: Player, id: string, amount: number?): (boolean, string?)
	if not IsValidId(id) then
		return false, "잘못된 아이템 식별자입니다."
	end
	local session, err = GetEditableSession(player)
	if not session then
		return false, err
	end

	local offer = session.Offers[player]
	local current = offer.Items[id]
	if not current then
		return false, "올려둔 아이템이 아닙니다."
	end

	if amount == nil or amount >= current then
		offer.Items[id] = nil
	elseif IsValidAmount(amount) then
		offer.Items[id] = current - amount
	else
		return false, "잘못된 수량입니다."
	end

	OnOfferChanged(session)
	return true, nil
end

function TradeService.AddCurrency(player: Player, currencyId: string, amount: number): (boolean, string?)
	if not IsValidId(currencyId) then
		return false, "잘못된 재화 식별자입니다."
	end
	if not IsValidAmount(amount) then
		return false, "잘못된 수량입니다."
	end
	if not TradeConfig.AllowedCurrencies[currencyId] then
		return false, "거래할 수 없는 재화입니다."
	end

	local session, playerData, err = GetSessionAndData(player)
	if not session or not playerData then
		return false, err
	end

	local offer = session.Offers[player]
	local alreadyOffered = offer.Currency[currencyId] or 0
	if (playerData[currencyId] or 0) < alreadyOffered + amount then
		return false, "보유한 재화보다 많이 올릴 수 없습니다."
	end

	offer.Currency[currencyId] = alreadyOffered + amount
	OnOfferChanged(session)
	return true, nil
end

function TradeService.RemoveCurrency(player: Player, currencyId: string): (boolean, string?)
	if not IsValidId(currencyId) then
		return false, "잘못된 재화 식별자입니다."
	end
	local session, err = GetEditableSession(player)
	if not session then
		return false, err
	end
	session.Offers[player].Currency[currencyId] = nil
	OnOfferChanged(session)
	return true, nil
end

function TradeService.AddTower(player: Player, towerName: string, towerKey: string): (boolean, string?)
	if not IsValidId(towerName) or not IsValidId(towerKey) then
		return false, "잘못된 식별자입니다."
	end
	local session, playerData, err = GetSessionAndData(player)
	if not session or not playerData then
		return false, err
	end

	local towerType = playerData.OwnedTowers[towerName]
	if not towerType or not towerType[towerKey] then
		return false, "보유하지 않은 타워입니다."
	end
	if IsTowerEquipped(playerData, towerKey) then
		return false, "장착 중인 타워는 거래할 수 없습니다."
	end

	session.Offers[player].Towers[towerKey] = towerName
	OnOfferChanged(session)
	return true, nil
end

function TradeService.RemoveTower(player: Player, towerKey: string): (boolean, string?)
	if not IsValidId(towerKey) then
		return false, "잘못된 타워 식별자입니다."
	end
	local session, err = GetEditableSession(player)
	if not session then
		return false, err
	end
	session.Offers[player].Towers[towerKey] = nil
	OnOfferChanged(session)
	return true, nil
end

function TradeService.Confirm(player: Player, clientVersion: number): (boolean, string?)
	local sessionId = PlayerToSession[player]
	local session = sessionId and ActiveSessions[sessionId]
	if not session or session.State ~= "Building" then
		return false, "지금은 확정할 수 없습니다."
	end
	if type(clientVersion) ~= "number" or session.Version ~= clientVersion then
		return false, "거래 내용이 변경되었습니다. 다시 확인해 주세요."
	end

	session.Confirmed[player] = true
	session.LastActivity = os.time()
	BroadcastState(session)

	for _, member in session.Members do
		if not session.Confirmed[member] then
			return true, nil
		end
	end
	return TradeService._Commit(session)
end

function TradeService._Commit(session: TradeSession): (boolean, string?)
	if session.State ~= "Building" then
		return false, "이미 처리 중인 거래입니다."
	end
	session.State = "Committing"

	local plr1, plr2 = session.Members[1], session.Members[2]

	-- 1) 최종 검증
	local valid, err = ValidateSession(session)
	if not valid then
		TradeService.Cancel(session.Id)
		return false, err
	end

	-- 2) 타워 스냅샷 및 사이드 데이터 구축
	local snap1 = SnapshotTowers(plr1, session)
	local snap2 = SnapshotTowers(plr2, session)
	local sideA = BuildTradeSide(session.Id, session.Offers[plr1], snap1, session.Offers[plr2], snap2)
	local sideB = BuildTradeSide(session.Id, session.Offers[plr2], snap2, session.Offers[plr1], snap1)

	-- 3) 에스크로 선기록
	if not WritePendingEscrow(plr1, plr2, sideA, sideB) then
		RemovePendingEscrow(plr1, plr2)
		TradeService.Cancel(session.Id)
		return false, "거래 기록 저장에 실패하여 취소되었습니다."
	end

	-- 4) 이탈 감지 (에스크로 저장 Yield 동안 이탈 검사)
	if not plr1.Parent or not plr2.Parent then
		RemovePendingEscrow(plr1, plr2)
		TradeService.Cancel(session.Id)
		return false, "거래 처리 중 참가자가 이탈하여 취소되었습니다."
	end

	-- [TOCTOU 이중 지불 방어] 에스크로 저장 Yield 동안의 데이터 변동 재검증
	local recheck1, recheckErr1 = ValidateOffer(plr1, session.Offers[plr1])
	local recheck2, recheckErr2 = ValidateOffer(plr2, session.Offers[plr2])
	if not recheck1 or not recheck2 then
		RemovePendingEscrow(plr1, plr2)
		TradeService.Cancel(session.Id)
		return false, "거래 대기 중 재화가 변동되어 취소되었습니다. (중복 사용 차단)"
	end

	-- 5) 원자적 커밋 결정 토큰 기록
	if not WriteCommitToken(session.Id) then
		RemovePendingEscrow(plr1, plr2)
		TradeService.Cancel(session.Id)
		return false, "거래 확정에 실패하여 취소되었습니다."
	end

	-- 6) 커밋 토큰 기록 Yield 동안 이탈 감지
	if not plr1.Parent or not plr2.Parent then
		if plr1.Parent then
			SettlePlayerTrade(plr1, sideA, session.Id)
		end
		if plr2.Parent then
			SettlePlayerTrade(plr2, sideB, session.Id)
		end

		session.State = "Committed"
		for _, member in session.Members do
			PlayerToSession[member] = nil
		end
		ActiveSessions[session.Id] = nil
		TradeService._QueueLog(session)
		return true, nil
	end

	-- 7) 거래 실행 및 저장
	ApplyTradeSide(plr1, sideA.Gives, sideA.Receives)
	ApplyTradeSide(plr2, sideB.Gives, sideB.Receives)

	DataService:UpdateData(plr1, "LastTradeId", session.Id)
	DataService:UpdateData(plr2, "LastTradeId", session.Id)
	pcall(function()
		DataService:SaveData(plr1)
		DataService:SaveData(plr2)
	end)

	-- 8) 데이터 저장 후 아티팩트 해제
	RemoveCommitToken(session.Id)
	RemovePendingEscrow(plr1, plr2)
	TradeService._QueueLog(session)

	session.State = "Committed"
	for _, member in session.Members do
		SafeFire(Net.TradeService.TradeCompleted, member, { SessionId = session.Id })
		PlayerToSession[member] = nil
	end
	ActiveSessions[session.Id] = nil
	return true, nil
end

function TradeService.Cancel(sessionId: string)
	local session = ActiveSessions[sessionId]
	-- [취약점 해소: Cancel 충돌 버그 방어]
	if not session or session.State == "Committing" or session.State == "Committed" then
		return
	end

	session.State = "Cancelled"
	for _, member in session.Members do
		SafeFire(Net.TradeService.TradeCancelled, member, { SessionId = session.Id })
		PlayerToSession[member] = nil
	end
	ActiveSessions[sessionId] = nil
end

function TradeService._QueueLog(session: TradeSession)
	local record = SerializeSession(session)
	if #LogQueue >= MAX_LOG_QUEUE then
		table.remove(LogQueue, 1)
		warn("거래 로그 큐 상한 초과 — 가장 오래된 로그 폐기.")
	end
	table.insert(LogQueue, record)
end

function TradeService._FlushLogs()
	if #LogQueue == 0 then
		return
	end

	local batch = {}
	for _ = 1, math.min(LOG_BATCH_MAX, #LogQueue) do
		table.insert(batch, table.remove(LogQueue, 1))
	end

	local key = `Batch_{os.time()}_{HttpService:GenerateGUID(false)}`
	local ok, err = pcall(function()
		TradeLogStore:SetAsync(key, batch)
	end)
	if not ok then
		warn(`거래 로그 배치 저장 실패: {err}`)
		for i = #batch, 1, -1 do
			if #LogQueue >= MAX_LOG_QUEUE then
				break
			end
			table.insert(LogQueue, 1, batch[i])
		end
	end
end

function TradeService.RecoverPendingTrade(player: Player)
	local key = `Pending_{player.UserId}`

	local record
	local readOk = pcall(function()
		record = PendingTradeStore:GetAsync(key)
	end)
	if not readOk or not record then
		return
	end

	local playerData = DataService:GetData(player)
	if not playerData then
		return
	end

	local commitKey = `Committed_{record.TradeId}`
	local committed = false
	local checkOk = pcall(function()
		committed = PendingTradeStore:GetAsync(commitKey) ~= nil
	end)

	if not checkOk then
		warn(`커밋 토큰 확인 실패 — {player.Name}의 재정산을 다음 접속으로 연기.`)
		return
	end

	if not committed or playerData.LastTradeId == record.TradeId then
		pcall(function()
			PendingTradeStore:RemoveAsync(key)
		end)
		return
	end

	ApplyTradeSide(player, record.Gives, record.Receives)
	DataService:UpdateData(player, "LastTradeId", record.TradeId)

	local saveOk = pcall(function()
		DataService:SaveData(player)
	end)
	if not saveOk then
		warn(`{player.Name} 재정산 저장 실패 — 펜딩 레코드 보존.`)
		return
	end

	warn(`{player.Name}의 중단된 거래 {record.TradeId} 재정산 완료.`)
	pcall(function()
		PendingTradeStore:RemoveAsync(key)
	end)
end

-------------------------------------------------
function TradeService.Init(services: any)
	DataService = services:GetService("DataService")
end

function TradeService.Start()
	Players.PlayerRemoving:Connect(function(player: Player)
		local sessionId = PlayerToSession[player]
		if sessionId then
			TradeService.Cancel(sessionId)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(30)
			local now = os.time()
			for sessionId, session in ActiveSessions do
				if session.State == "Building" and (now - session.LastActivity) > SESSION_TIMEOUT then
					TradeService.Cancel(sessionId)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(LOG_FLUSH_INTERVAL)
			local guard = 0
			while #LogQueue > 0 and guard < 20 do
				TradeService._FlushLogs()
				guard += 1
			end
		end
	end)

	game:BindToClose(function()
		local guard = 0
		while #LogQueue > 0 and guard < 20 do
			TradeService._FlushLogs()
			guard += 1
		end
	end)

	Net.TradeService.AddItem.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.AddItem(player, data.id, data.amount)
	end)

	Net.TradeService.RemoveItem.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.RemoveItem(player, data.id, data.amount)
	end)

	Net.TradeService.AddCurrency.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.AddCurrency(player, data.id, data.amount)
	end)

	Net.TradeService.RemoveCurrency.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.RemoveCurrency(player, data.id)
	end)

	Net.TradeService.AddTower.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.AddTower(player, data.towerName, data.towerKey)
	end)

	Net.TradeService.RemoveTower.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.RemoveTower(player, data.towerKey)
	end)

	Net.TradeService.Confirm.On(function(player: Player, data: any)
		if type(data) ~= "table" then
			return false, "잘못된 요청입니다."
		end
		return TradeService.Confirm(player, data.version)
	end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="696">
          <Properties>
            <string name="Name">TraitService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TraitData = require(ReplicatedStorage.Settings.Data.TraitData)

local REMOTES_FOLDER_NAME = "RuntimeRemotes"
local REMOTE_NAME = "TraitRoll"
local REQUEST_COOLDOWN = 0.5
local MAX_TOWER_NAME_LENGTH = 80
local MAX_TOWER_KEY_ID = 4_294_967_295
local RANDOM = Random.new()

local DataService
local lastRequestAt: { [Player]: number } = {}
local activeRequests: { [Player]: boolean } = {}
local TraitService = {}

local function response(success: boolean, message: string, extra: { [string]: any }?)
	local result = extra or {}
	result.Success = success
	result.Message = message
	return result
end

local function normalizeTowerKey(value: any): string?
	if typeof(value) ~= "string" and typeof(value) ~= "number" then return nil end
	local text = tostring(value)
	local idText = string.match(text, "^t_(%d+)$") or string.match(text, "^(%d+)$")
	local id = if idText then tonumber(idText) else nil
	if not id or id % 1 ~= 0 or id < 0 or id > MAX_TOWER_KEY_ID then return nil end
	return `t_{id}`
end

local function getRandomTrait(): string
	local totalWeight = 0
	for _, trait in TraitData.ByIndex do totalWeight += trait.Chance end
	local roll = RANDOM:NextNumber(0, totalWeight)
	local cursor = 0
	for _, trait in TraitData.ByIndex do
		cursor += trait.Chance
		if roll <= cursor then return trait.Name end
	end
	return TraitData.ByIndex[#TraitData.ByIndex].Name
end

function TraitService:RollTrait(player: Player, data: any)
	local now = os.clock()
	if lastRequestAt[player] and now - lastRequestAt[player] < REQUEST_COOLDOWN then
		return response(false, "Please wait before rolling again.")
	end
	lastRequestAt[player] = now

	if typeof(data) ~= "table" then return response(false, "Invalid trait request.") end
	local towerName = data.TowerName
	local towerKey = normalizeTowerKey(data.TowerKey)
	if typeof(towerName) ~= "string" or towerName == "" or #towerName > MAX_TOWER_NAME_LENGTH or not towerKey then
		return response(false, "Invalid unit selection.")
	end

	local playerData = DataService:GetData(player)
	if not playerData then return response(false, "Your data is still loading.") end
	local ownedTower = playerData.OwnedTowers[towerName] and playerData.OwnedTowers[towerName][towerKey]
	if typeof(ownedTower) ~= "table" then return response(false, "You do not own this unit.") end
	if (playerData.Gems or 0) < TraitData.RollCost then
		return response(false, `You need {TraitData.RollCost} Gems.`)
	end

	local gems = DataService:AddData(player, "Gems", -TraitData.RollCost)
	if gems == nil then return response(false, "Could not spend Gems.") end
	local newTrait = getRandomTrait()
	DataService:AdjustTower(player, towerName, towerKey, "Trait", newTrait)
	return response(true, `Rolled {newTrait}!`, {
		Trait = newTrait, Gems = gems, TowerName = towerName, TowerKey = towerKey,
	})
end

function TraitService.Init(services)
	DataService = services:GetService("DataService")
end

TraitService.Dependencies = { "DataService" }

function TraitService.Start()
	local remotesFolder = ReplicatedStorage:FindFirstChild(REMOTES_FOLDER_NAME)
	if not remotesFolder then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = REMOTES_FOLDER_NAME
		remotesFolder.Parent = ReplicatedStorage
	end
	local remote = remotesFolder:FindFirstChild(REMOTE_NAME)
	if not remote then
		remote = Instance.new("RemoteFunction")
		remote.Name = REMOTE_NAME
		remote.Parent = remotesFolder
	end
	assert(remote:IsA("RemoteFunction"), "TraitRoll runtime remote must be a RemoteFunction")
	remote.OnServerInvoke = function(player, data)
		if activeRequests[player] then return response(false, "A roll is already in progress.") end
		activeRequests[player] = true
		local ok, result = pcall(TraitService.RollTrait, TraitService, player, data)
		activeRequests[player] = nil
		if not ok then
			warn(`[TraitService] Roll failed: {result}`)
			return response(false, "Could not roll the trait. Please try again.")
		end
		return result
	end
	Players.PlayerRemoving:Connect(function(player)
		lastRequestAt[player] = nil
		activeRequests[player] = nil
	end)
end

return TraitService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
