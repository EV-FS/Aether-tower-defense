function SerdesFunctions.LoadoutService_ReadFUNCTION_DATA_SetLoadout(): ({ requestType: ("Equip" | "Unequip" | "UnequipAll"), targetTower: { towerName: string, towerKey: number }? })
	-- Read BLOCK: 2 bytes
	local BLOCK_START = Read(2)
	local Value = {} :: any
	Value.requestType = true :: any
	local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	if Index == 0 then
		Value.requestType = "Equip"
	elseif Index == 1 then
		Value.requestType = "Unequip"
	elseif Index == 2 then
		Value.requestType = "UnequipAll"
	else
		error(`Unexpected enum: {Index}`)
	end
	if buffer.readu8(RecieveBuffer, BLOCK_START + 1) == 1 then
		-- Read BLOCK: 6 bytes
		local BLOCK_START = Read(6)
		Value.targetTower = {} :: any
		local Length = buffer.readu16(RecieveBuffer, BLOCK_START + 0)
		Value.targetTower.towerName = buffer.readstring(RecieveBuffer, Read(Length), Length)
		Value.targetTower.towerKey = buffer.readu32(RecieveBuffer, BLOCK_START + 2)
	end
	return Value
end

