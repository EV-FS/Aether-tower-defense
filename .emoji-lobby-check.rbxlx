        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">EmojiUI</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local NotificationFeed = require(ReplicatedStorage.Shared.Modules.UI.Notifications.NotificationFeed)
local EmojiData = require(ReplicatedStorage.Settings.Data.EmojiData)
local EmojiWheel = require(ReplicatedStorage.UI.Components.EmojiWheel)
local EmoteOverlay = require(ReplicatedStorage.Shared.Modules.UI.Emote.EmoteOverlay)

local create = Vide.create
local source = Vide.source

local VIEW_ID = "EmojiWheel"
local equipMode = source(nil :: string?)
local equipPending = source(false)
local returnView = source(nil :: string?)
local EmojiClient
local InventoryClient
local InputController
local UIController

local emojiSlots = {}
for slot = 1, 4 do
	table.insert(emojiSlots, function()
		if not InventoryClient then return nil end
		local emojiId = InventoryClient.GetEmojiSlot(slot)
		local config = emojiId and EmojiData.ByName[emojiId]
		if not config then return nil end
		return {
			Id = config.Id,
			Name = config.Id,
			DisplayName = config.DisplayName,
			Image = config.Image,
			Symbol = config.Symbol,
		}
	end)
end

local EmojiUI = {}

function EmojiUI.OnSelected(emojiId: string)
	if EmojiClient then EmojiClient.ShowEmoji(emojiId) end
	EmojiUI.Close()
end

function EmojiUI.OnSlotSelected(slot: number, emojiId: string?)
	local target = equipMode()
	if target then
		if equipPending() then return end
		equipPending(true)
		InventoryClient.EquipEmoji(target, slot):andThen(function(result)
			equipPending(false)
			if result.Success then
				EmojiUI.Close()
			else
				NotificationFeed.Pull(result.Message or "Could not equip emoji.", "Error")
			end
		end):catch(function(err)
			equipPending(false)
			NotificationFeed.Pull(`Could not equip emoji: {tostring(err)}`, "Error")
		end)
		return
	end
	if emojiId then EmojiUI.OnSelected(emojiId) end
end

function EmojiUI.RenderUI()
	return create("Frame")({
		Name = "EmojiUI",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		EmoteOverlay({
			Name = "EmojiOverlay",
			IsOpen = UIController:IsVisible(VIEW_ID),
			OnClose = function()
				if not equipPending() then EmojiUI.Close() end
			end,
			Content = EmojiWheel({
				Emojis = emojiSlots,
				EquipMode = function() return equipMode() ~= nil end,
				InteractionDisabled = equipPending,
				OnSelected = EmojiUI.OnSelected,
				OnSlotSelected = EmojiUI.OnSlotSelected,
			}),
		}),
	})
end

function EmojiUI.Open()
	equipMode(nil)
	returnView(nil)
	if UIController and not UIController:IsOpen(VIEW_ID) then
		InventoryClient.RefreshEmojiLoadout():catch(function(err)
			warn(`[EmojiUI] Could not refresh emoji slots: {err}`)
		end)
		UIController:Open(VIEW_ID)
	end
end

function EmojiUI.OpenEquipMode(emojiId: string): boolean
	if not InventoryClient or not EmojiData.ByName[emojiId]
		or (InventoryClient.Emojis()[emojiId] or 0) <= 0 then
		return false
	end
	local previousView = UIController and UIController:GetActiveView() or nil
	local opened = UIController and UIController:OpenExclusive(VIEW_ID) or false
	if not opened then return false end
	returnView(previousView or "Inventory")
	equipMode(emojiId)
	equipPending(false)
	return true
end

function EmojiUI.Close()
	if UIController and UIController:IsOpen(VIEW_ID) then
		if equipPending() then return end
		local targetView = returnView()
		equipMode(nil)
		equipPending(false)
		returnView(nil)
		UIController:Close(VIEW_ID)
		if targetView and targetView ~= VIEW_ID then UIController:Open(targetView) end
	end
end

function EmojiUI.Init()
	EmojiClient = ServiceRegistry:GetService("EmojiClient")
	InventoryClient = ServiceRegistry:GetService("InventoryClient")
	InputController = ServiceRegistry:GetService("InputController")
	UIController = ServiceRegistry:GetService("UIController")
end

function EmojiUI.Start()
	local scope = InputController.Scope("EmojiInput", {
		InputController.Action("Toggle", InputController.Info({ Enum.KeyCode.B })),
	}):Enable()
	scope.Actions.Toggle.Began:Connect(function()
		if equipPending() then return end
		if UIController:IsOpen(VIEW_ID) then EmojiUI.Close() else EmojiUI.Open() end
	end)
end

return EmojiUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EmoteUI</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local EmoteRadialMenu = require(ReplicatedStorage.Shared.Modules.UI.Emote.EmoteRadialMenu)
local EmoteOverlay = require(ReplicatedStorage.Shared.Modules.UI.Emote.EmoteOverlay)
local EmoteClient
local InventoryClient
local InputController
local UIController

local create = Vide.create
local effect = Vide.effect
local source = Vide.source

local VIEW_ID = "EmoteWheel"
local EmoteInput
local emoteIcon = source(nil :: any)
local equipMode = source(nil :: string?)
local equipPending = source(false)
local returnView = source(nil :: string?)

local emoteSlots = {}
for slot = 1, 4 do
	table.insert(emoteSlots, function()
		if not InventoryClient then return nil end
		local emoteName = InventoryClient.GetEmoteSlot(slot)
		return emoteName and EmoteData.ByName[emoteName] or nil
	end)
end

local EmoteUI = {}

function EmoteUI.OnSelected(emoteName: string)
	if EmoteClient then
		EmoteClient.PlayEmote(emoteName)
	end

	EmoteUI.Close()
end

function EmoteUI.OnSlotSelected(slotIndex: number, emoteName: string?)
	local targetEmote = equipMode()
	if targetEmote then
		if equipPending() then return end
		equipPending(true)
		InventoryClient.EquipEmote(targetEmote, slotIndex):andThen(function(result)
			equipPending(false)
			if result.Success then
				EmoteUI.Close()
			else
				local message = tostring(result.Message or "The server rejected this slot change.")
				warn(`[EmoteUI] Could not equip emote: {message}`)
			end
		end):catch(function(err)
			equipPending(false)
			warn(`[EmoteUI] Could not equip emote: {err}`)
		end)
		return
	end

	if emoteName then EmoteUI.OnSelected(emoteName) end
end

function EmoteUI.RenderUI()
	effect(function()
		local icon = emoteIcon()
		if not icon or not UIController then return end

		local isOpen = UIController:IsOpen(VIEW_ID)
		if isOpen and not icon.isSelected then
			icon:select()
		elseif not isOpen and icon.isSelected then
			icon:deselect()
		end
	end)

	return create("Frame")({
		Name = "EmoteUI",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),

		EmoteOverlay({
			Name = "EmoteOverlay",
			IsOpen = UIController:IsVisible(VIEW_ID),
			OnClose = function()
				if not equipPending() then EmoteUI.Close() end
			end,
			Content = EmoteRadialMenu({
				Emotes = emoteSlots,
				EquipMode = function() return equipMode() ~= nil end,
				OnSelected = EmoteUI.OnSelected,
				OnSlotSelected = EmoteUI.OnSlotSelected,
				SlotActionText = function(_slotIndex, equippedName)
					if equipMode() then return if equippedName then "Tap to Replace" else "Tap to Equip" end
					return "Tap to play"
				end,
				InteractionDisabled = equipPending,
			}),
		}),
	})
end

function EmoteUI.BindTopbarIcon(icon: any)
	emoteIcon(icon)
end

function EmoteUI.Open()
	equipMode(nil)
	returnView(nil)
	if UIController and not UIController:IsOpen(VIEW_ID) then
		InventoryClient.RefreshEmoteLoadout():catch(function(err)
			warn(`[EmoteUI] Could not refresh emote slots: {err}`)
		end)
		UIController:Open(VIEW_ID)
	end
end

function EmoteUI.OpenEquipMode(emoteName: string): boolean
	if not InventoryClient or not EmoteData.ByName[emoteName] or (InventoryClient.Emotes()[emoteName] or 0) <= 0 then
		return false
	end

	local previousView = UIController and UIController:GetActiveView() or nil
	local opened = UIController and UIController:OpenExclusive(VIEW_ID) or false
	if not opened then
		return false
	end

	returnView(previousView or "Inventory")
	equipMode(emoteName)
	equipPending(false)
	return true
end

function EmoteUI.Close()
	if UIController and UIController:IsOpen(VIEW_ID) then
		if equipPending() then return end
		local targetView = returnView()
		equipMode(nil)
		equipPending(false)
		returnView(nil)
		UIController:Close(VIEW_ID)
		if targetView and targetView ~= VIEW_ID then
			UIController:Open(targetView)
		end
	end
end

function EmoteUI.Init()
	EmoteClient = ServiceRegistry:GetService("EmoteClient")
	InventoryClient = ServiceRegistry:GetService("InventoryClient")
	InputController = ServiceRegistry:GetService("InputController")
	UIController = ServiceRegistry:GetService("UIController")
end

function EmoteUI.Start()
	local iScope = InputController.Scope
	local iAction = InputController.Action
	local iInfo = InputController.Info

	EmoteInput = iScope("EmoteInput", {
		iAction("Toggle", iInfo({ Enum.KeyCode.E })),
	}):Enable()

	EmoteInput.Actions.Toggle.Began:Connect(function()
		if equipPending() then return end
		if UIController:IsOpen(VIEW_ID) then EmoteUI.Close() else EmoteUI.Open() end
	end)

end

return EmoteUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">EventShopUI</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local useMenuMotion = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useMenuMotion)
local EventShopData = require(ReplicatedStorage.Settings.Data.EventShopData)
local ServiceRegistry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local useButtonEffect = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useButtonEffect)
local NotificationFeed = require(ReplicatedStorage.Shared.Modules.UI.Notifications.NotificationFeed)

local create = Vide.create
local source = Vide.source

local VIEW_ID = "EventShop"
local BLOSSOM_ICON = "rbxassetid://129066851213188"

local DataClient
local InventoryClient
local UIController
local purchaseBusy = source(nil :: string?)

local EventShopUI = {}

local function formatNumber(value: number): string
	return DataClient.FormatNumber(value)
end

local function ownsProduct(product: EventShopData.Product): boolean
	if not product.Unique then
		return false
	end

	local inventory = if product.RewardCategory == "Skins" then InventoryClient.Skins() else InventoryClient.Items()
	return (inventory[product.RewardName] or 0) > 0
end

local function canPurchase(product: EventShopData.Product): boolean
	return purchaseBusy() == nil and not ownsProduct(product) and DataClient.Blossom() >= product.Price
end

local function purchaseProduct(product: EventShopData.Product)
	if purchaseBusy() ~= nil then
		return
	end
	if ownsProduct(product) then
		NotificationFeed.Pull("You already own this reward.", "Error")
		return
	end
	if DataClient.Blossom() < product.Price then
		NotificationFeed.Pull(`You need {product.Price} Blossoms to purchase this.`, "Error")
		return
	end

	purchaseBusy(product.Id)
	task.spawn(function()
		local ok, result = pcall(function()
			local folder = ReplicatedStorage:WaitForChild("RuntimeRemotes", 5)
			local remote = folder and folder:WaitForChild("EventShopPurchase", 5)
			if not remote or not remote:IsA("RemoteFunction") then
				error("EventShopPurchase remote is unavailable")
			end
			return remote:InvokeServer(product.Id)
		end)

		purchaseBusy(nil)
		if not ok or typeof(result) ~= "table" then
			warn("[EventShopUI] Purchase failed")
			NotificationFeed.Pull("Purchase failed. Please try again.", "Error")
			return
		end

		if typeof(result.Balance) == "number" then
			DataClient.Blossom(result.Balance)
		end

		if result.Success then
			InventoryClient.RefreshInventory():catch(function(err)
				warn(`[EventShopUI] Failed to refresh inventory: {err}`)
			end)
		else
			warn(`[EventShopUI] Purchase rejected: {result.Message or "Unknown reason"}`)
			NotificationFeed.Pull(result.Message or "Purchase unavailable.", "Error")
		end
	end)
end

local function giftButton()
	return create("ImageButton")({
		Name = "GiftButton",
		Active = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Image = "rbxassetid://98844680499099",
		Position = UDim2.fromScale(0.881898, 0.842459),
		Size = UDim2.fromScale(0.173667, 0.249376),
		create("UIGradient")({
			Color = ColorSequence.new(Color3.fromRGB(255, 160, 43), Color3.fromRGB(255, 215, 123)),
			Rotation = 90,
		}),
		create("UIAspectRatioConstraint")({}),
		create("ImageLabel")({
			Name = "Icon",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = "rbxassetid://128557996574921",
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.70253, 0.687405),
			ZIndex = 10,
			create("UIAspectRatioConstraint")({ AspectRatio = 0.83 }),
		}),
	})
end

local function purchaseButton(product: EventShopData.Product)
	return create("ImageButton")({
		Name = "PurchaseButton",
		Active = function()
			return purchaseBusy() == nil
		end,
		Interactable = function()
			return purchaseBusy() == nil
		end,
		AnchorPoint = Vector2.new(0.5, 0.5),
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Image = "rbxassetid://139274506988816",
		ImageTransparency = function()
			return if canPurchase(product) then 0 else 0.14
		end,
		Position = UDim2.fromScale(0.387631, 0.842459),
		Size = UDim2.fromScale(0.757759, 0.249376),
		Activated = function()
			purchaseProduct(product)
		end,
		useButtonEffect(0.94, 1.05),
		create("TextLabel")({
			Name = "Title",
			BackgroundTransparency = 1,
			FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json"),
			Position = UDim2.fromScale(0.149276, 0.214464),
			Size = UDim2.fromScale(0.68577, 0.527425),
			Text = function()
				if ownsProduct(product) then
					return "OWNED"
				end
				return if purchaseBusy() == product.Id then "WAIT..." else "PURCHASE"
			end,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			create("UIStroke")({}),
		}),
		create("UIGradient")({
			Color = ColorSequence.new(Color3.fromRGB(13, 255, 0), Color3.fromRGB(234, 255, 0)),
		}),
		create("UIStroke")({ Color = Color3.new(1, 1, 1) }),
		create("UICorner")({}),
	})
end

local function blossomPrice(product: EventShopData.Product)
	return create("Frame")({
		Name = "Blossom",
		BackgroundColor3 = Color3.new(),
		BackgroundTransparency = 0.2,
		BorderColor3 = Color3.new(),
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.103804, 0.491441),
		Size = UDim2.fromScale(0.728345, 0.217537),
		create("ImageLabel")({
			Name = "ImageLabel",
			BackgroundTransparency = 1,
			Image = BLOSSOM_ICON,
			Position = UDim2.fromScale(0.140759, -0.0579331),
