Unreliable.OnServerEvent:Connect(function(Player: Player, Buffer: buffer, Instances: {Instance})
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstances = Instances
	RecieveInstanceCursor = 0
	local Size = buffer.len(RecieveBuffer)
	if SerdesThread and coroutine.status(SerdesThread) == "suspended" then
		warn(`[Blink]: Yielded in a Sync call. Event "{SerdesEvent}" uses a Sync call, consider using an Async call instead.`)
		coroutine.close(SerdesThread)
	end
	SerdesThread = coroutine.running()
	while (RecieveCursor < Size) do
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
	end
end)


local Returns = table.freeze({
	StepReplication = StepReplication,

	GroupReward = {
		SendPromptJoin = {
			Fire = function(Player: Player, Value: nil): ()
				Load(PlayersMap[Player])
				SerdesFunctions.GroupReward_WriteEVENT_SendPromptJoin(Value)
				PlayersMap[Player] = Save()
			end,
			FireAll = function(Value: nil): ()
				Load()
				SerdesFunctions.GroupReward_WriteEVENT_SendPromptJoin(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in Players:GetPlayers() do
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
			FireList = function(List: {Player}, Value: nil): ()
				Load()
				SerdesFunctions.GroupReward_WriteEVENT_SendPromptJoin(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in List do
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
			FireExcept = function(Except: Player, Value: nil): ()
				Load()
				SerdesFunctions.GroupReward_WriteEVENT_SendPromptJoin(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in Players:GetPlayers() do
					if Player == Except then
						continue
					end
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
		},
	},
	NotificationService = {
		Popup = {
			Fire = function(Player: Player, Value: { Message: string, LogType: string, DurationMs: number }): ()
				Load(PlayersMap[Player])
				SerdesFunctions.NotificationService_WriteEVENT_Popup(Value)
				PlayersMap[Player] = Save()
			end,
			FireAll = function(Value: { Message: string, LogType: string, DurationMs: number }): ()
				Load()
				SerdesFunctions.NotificationService_WriteEVENT_Popup(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in Players:GetPlayers() do
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
			FireList = function(List: {Player}, Value: { Message: string, LogType: string, DurationMs: number }): ()
				Load()
				SerdesFunctions.NotificationService_WriteEVENT_Popup(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in List do
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
			FireExcept = function(Except: Player, Value: { Message: string, LogType: string, DurationMs: number }): ()
				Load()
				SerdesFunctions.NotificationService_WriteEVENT_Popup(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in Players:GetPlayers() do
					if Player == Except then
						continue
					end
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
		},
	},
	EmoteService = {
		RequestPlayEmote = {
		On = function(Listener: (Player, { EmoteId: string }) -> (boolean)): ()
			Events.Reliable[2] = function(Player: Player, Value: { EmoteId: string }, InvocationIdentifier: number): ()
				local ReturnValue: boolean;
				local Success, Error = pcall(function ()
					ReturnValue = Listener(Player, Value)
				end)
				Load(PlayersMap[Player])
				if Success ~= true then
					local Position = Allocate(3)
					buffer.writeu8(SendBuffer, Position, 2)
					buffer.writeu8(SendBuffer, Position + 1, InvocationIdentifier)
					buffer.writeu8(SendBuffer, Position + 2, 0)
					warn(`"RequestPlayEmote" encountered an error, {Error}`)
				else
					SerdesFunctions.EmoteService_WriteFUNCTION_RETURN_RequestPlayEmote(ReturnValue, InvocationIdentifier)
				end
				PlayersMap[Player] = Save()
			end
			task.spawn(function (): ()
				local EventQueue = Queue.Reliable[2] or {}
				Queue.Reliable[2] = nil
				for Index, Arguments in EventQueue do
					Events.Reliable[2](table.unpack(Arguments))
				end
			end)
		end
		},
		RequestStopEmote = {
		On = function(Listener: (Player, nil) -> (boolean)): ()
			Events.Reliable[3] = function(Player: Player, Value: nil, InvocationIdentifier: number): ()
				local ReturnValue: boolean;
				local Success, Error = pcall(function ()
					ReturnValue = Listener(Player, Value)
				end)
				Load(PlayersMap[Player])
				if Success ~= true then
					local Position = Allocate(3)
					buffer.writeu8(SendBuffer, Position, 3)
					buffer.writeu8(SendBuffer, Position + 1, InvocationIdentifier)
					buffer.writeu8(SendBuffer, Position + 2, 0)
					warn(`"RequestStopEmote" encountered an error, {Error}`)
				else
					SerdesFunctions.EmoteService_WriteFUNCTION_RETURN_RequestStopEmote(ReturnValue, InvocationIdentifier)
				end
				PlayersMap[Player] = Save()
			end
			task.spawn(function (): ()
				local EventQueue = Queue.Reliable[3] or {}
				Queue.Reliable[3] = nil
				for Index, Arguments in EventQueue do
					Events.Reliable[3](table.unpack(Arguments))
				end
			end)
		end
		},
		EmoteStarted = {
			Fire = function(Player: Player, Value: { Player: Instance, EmoteId: string }): ()
				Load(PlayersMap[Player])
				SerdesFunctions.EmoteService_WriteEVENT_EmoteStarted(Value)
				PlayersMap[Player] = Save()
			end,
			FireAll = function(Value: { Player: Instance, EmoteId: string }): ()
				Load()
				SerdesFunctions.EmoteService_WriteEVENT_EmoteStarted(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in Players:GetPlayers() do
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
			FireList = function(List: {Player}, Value: { Player: Instance, EmoteId: string }): ()
				Load()
				SerdesFunctions.EmoteService_WriteEVENT_EmoteStarted(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in List do
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
			FireExcept = function(Except: Player, Value: { Player: Instance, EmoteId: string }): ()
				Load()
				SerdesFunctions.EmoteService_WriteEVENT_EmoteStarted(Value)
				local Buffer, Size, Instances = SendBuffer, SendCursor, SendInstances
				for _, Player in Players:GetPlayers() do
					if Player == Except then
						continue
					end
					Load(PlayersMap[Player])
					local Position = Allocate(Size)
					buffer.copy(SendBuffer, Position, Buffer, 0, Size)
					table.move(Instances, 1, #Instances, #SendInstances + 1, SendInstances)
					PlayersMap[Player] = Save()
				end
			end,
		},
		EmoteStopped = {
			Fire = function(Player: Player, Value: { Player: Instance }): ()
				Load(PlayersMap[Player])
				SerdesFunctions.EmoteService_WriteEVENT_EmoteStopped(Value)
				PlayersMap[Player] = Save()
			end,
