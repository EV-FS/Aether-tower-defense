			create("UIStroke")({ Thickness = 2 }),
		}),
	})
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">CardRarityStyle</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)
local useColorSequenceCycle = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useColorSequenceCycle)

local create = Vide.create
local read = Vide.read

type Reactive<T> = T | (() -> T)

export type Props = {
	Rarity: Reactive<string>,
	Enabled: Reactive<boolean>?,
	FallbackGradient: ColorSequence?,
	PerformanceMode: boolean?,
	ShimmerEnabled: boolean?,
	GlowEnabled: boolean?,
	BorderEnabled: boolean?,
}

local DEFAULT_FALLBACK = ColorSequence.new(Color3.fromRGB(72, 76, 86))

local function enabled(props: Props): boolean
	return props.Enabled == nil or read(props.Enabled)
end

local function presentation(props: Props)
	return RarityRegistry.Get(read(props.Rarity)).Presentation
end

local function effectLevel(props: Props): number
	if not enabled(props) then
		return 0
	end
	return math.clamp(8 - RarityRegistry.GetOrder(read(props.Rarity)), 1, 7)
end

return function(props: Props)
	local shimmerEnabled = props.ShimmerEnabled ~= false and props.PerformanceMode ~= true
	local glowEnabled = props.GlowEnabled ~= false and props.PerformanceMode ~= true
	local borderEnabled = props.BorderEnabled ~= false
	local gradient = function()
		return if enabled(props) then presentation(props).Gradient else props.FallbackGradient or DEFAULT_FALLBACK
	end
	local cycleTime = function()
		return math.max(5.4 - effectLevel(props) * 0.48, 2.5)
	end
	local cycles = function()
		return shimmerEnabled and enabled(props) and effectLevel(props) >= 3
	end

	return {
		create("UIGradient")({
			Name = "CardRarityBackground",
			Color = gradient,
			Rotation = 45,
			if shimmerEnabled then useColorSequenceCycle(gradient, cycleTime, cycles) else nil,
		}),
		if glowEnabled then create("UIShadow")({
			Name = "CardRarityGlow",
			BlurRadius = function()
				return UDim.new(0.018 + effectLevel(props) * 0.008, 0)
			end,
			Color = function()
				return presentation(props).Glow
			end,
			Transparency = function()
				local level = effectLevel(props)
				if level <= 1 then return 1 end
				return math.max(1.04 - level * 0.115, 0.32)
			end,
			ZIndex = -1,
		}) else nil,
		if borderEnabled then create("UIStroke")({
			Name = "CardRarityStroke",
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Color = Color3.new(1, 1, 1),
			Thickness = function()
				return 0.75 + effectLevel(props) * 0.27
			end,
			Transparency = function()
				local level = effectLevel(props)
				return if level > 0 then math.max(0.82 - level * 0.135, 0.02) else 1
			end,

			create("UIGradient")({
				Name = "CardRarityStrokeGradient",
				Color = gradient,
				Rotation = 45,
				if shimmerEnabled then useColorSequenceCycle(gradient, cycleTime, cycles) else nil,
			}),
		}) else nil,
	}
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">EmojiCard</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local EmojiData = require(ReplicatedStorage.Settings.Data.EmojiData)
local CardFrame = require(ReplicatedStorage.UI.Components.Card.CardFrame)

local create = Vide.create

return function(props)
	local info = EmojiData.ByName[props.EmojiId]
	return CardFrame({
		Name = props.EmojiId,
		Active = true,
		LayoutOrder = props.LayoutOrder,
		Size = UDim2.fromScale(0.239841, 0.354932),
		CornerRadius = UDim.new(0.06, 0),
		Rarity = "Rare",
		Selected = props.IsSelected,
		ShimmerEnabled = false,
		GlowEnabled = false,
		RarityBorderEnabled = false,
		PressedScale = 0.96,
		HoverScale = 1.025,
		HoverEnabled = false,
		Activated = props.Activated,
		Content = {
			create("UIAspectRatioConstraint")({}),
			create("ImageLabel")({
				Name = "Preview",
				BackgroundTransparency = 1,
				Image = if info then info.Image else "",
				Position = UDim2.fromScale(0.12, 0.1),
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromScale(0.76, 0.66),
				Visible = info ~= nil and info.Image ~= "",
				ZIndex = 5,
			}),
			create("TextLabel")({
				Name = "Symbol",
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = UDim2.fromScale(0.12, 0.1),
				Size = UDim2.fromScale(0.76, 0.66),
				Text = if info then info.Symbol else "?",
				TextColor3 = Color3.fromRGB(115, 215, 255),
				TextScaled = true,
				Visible = info == nil or info.Image == "",
				ZIndex = 5,
			}),
			create("TextLabel")({
				Name = "EmojiName",
				AnchorPoint = Vector2.new(0, 1),
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = UDim2.fromScale(0.075, 0.94),
				Size = UDim2.fromScale(0.82, 0.14),
				Text = if info then info.DisplayName else props.EmojiId,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 9,
				create("UIStroke")({ Thickness = 2 }),
			}),
			create("ImageLabel")({
				Name = "EquippedCheck",
				AnchorPoint = Vector2.new(1, 0),
				BackgroundTransparency = 1,
				Image = "rbxassetid://91966631627808",
				Position = UDim2.fromScale(0.96, 0.04),
				Size = UDim2.fromScale(0.2, 0.2),
				ScaleType = Enum.ScaleType.Fit,
				Visible = props.IsEquipped,
				ZIndex = 10,
				create("UIAspectRatioConstraint")({}),
			}),
		},
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">EmojiWheel</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local EmoteRadialMenu = require(ReplicatedStorage.Shared.Modules.UI.Emote.EmoteRadialMenu)

local create = Vide.create

export type EmojiEntry = { Id: string, Name: string, DisplayName: string, Image: string, Symbol: string }
export type Props = {
	Emojis: { () -> EmojiEntry? },
	EquipMode: (() -> boolean)?,
	InteractionDisabled: (() -> boolean)?,
	OnSelected: (string) -> (),
	OnSlotSelected: ((number, string?) -> ())?,
}

return function(props: Props)
	return EmoteRadialMenu({
		Emotes = props.Emojis,
		EquipMode = props.EquipMode,
		InteractionDisabled = props.InteractionDisabled,
		OnSelected = props.OnSelected,
		OnSlotSelected = props.OnSlotSelected,
		SlotActionText = function(_slot, emojiId)
			if props.EquipMode and props.EquipMode() then
				return if emojiId then "Tap to Replace" else "Tap to Equip"
			end
			return "Tap to show"
		end,
		RenderPreview = function(_slot, getEmoji)
			return create("Frame")({
				Name = "EmojiPreview",
				BackgroundTransparency = 1,
				Position = UDim2.fromScale(0.08, 0.08),
				Size = UDim2.fromScale(0.84, 0.67),
				ZIndex = 34,
				create("ImageLabel")({
					Name = "EmojiImage",
					BackgroundTransparency = 1,
					Image = function()
						local emoji = getEmoji()
						return if emoji then emoji.Image else ""
					end,
					ScaleType = Enum.ScaleType.Fit,
					Size = UDim2.fromScale(1, 1),
					Visible = function()
						local emoji = getEmoji()
						return emoji ~= nil and emoji.Image ~= ""
					end,
				}),
				create("TextLabel")({
					Name = "EmojiSymbol",
					BackgroundTransparency = 1,
					FontFace = Font.fromEnum(Enum.Font.FredokaOne),
					Size = UDim2.fromScale(1, 1),
					Text = function()
						local emoji = getEmoji()
						return if emoji then emoji.Symbol else "+"
					end,
					TextColor3 = Color3.fromRGB(115, 215, 255),
					TextScaled = true,
					Visible = function()
						local emoji = getEmoji()
						return emoji == nil or emoji.Image == ""
					end,
					create("UIStroke")({ Thickness = 3, Color = Color3.fromRGB(20, 28, 62) }),
				}),
			})
		end,
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EmojiWheel.story</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)

local EmojiWheel = require(script.Parent.EmojiWheel)
local EmojiData = require(ReplicatedStorage.Settings.Data.EmojiData)

local mount = Vide.mount
local source = Vide.source

return function(target: Instance)
	local container = Instance.new("Frame")
	container.Name = "EmojiWheelStoryContainer"
	container.BackgroundColor3 = Color3.fromRGB(25, 35, 55)
	container.Size = UDim2.fromScale(1, 1)
	container.Parent = target

	local entries = {}
	for index = 1, 4 do
		local config = EmojiData.ByIndex[index]
		table.insert(entries, source({
			Id = config.Id,
			Name = config.Id,
			DisplayName = config.DisplayName,
			Image = config.Image,
			Symbol = config.Symbol,
		}))
	end
	local props = {
		Emojis = entries,
		EquipMode = source(false),
		OnSelected = function(emojiId: string)
			print(`Selected emoji: {emojiId}`)
		end,
	}

	local destroyVide = mount(function()
		return EmojiWheel(props)
	end, container)

	return function()
		destroyVide()
		container:Destroy()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">EmoteCard</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)
local CardFrame = require(ReplicatedStorage.UI.Components.Card.CardFrame)
local PlayerCharacter = require(ReplicatedStorage.Shared.Modules.UI.Emote.PlayerCharacter)

local create = Vide.create

export type Props = {
	EmoteName: string,
	LayoutOrder: number | (() -> number),
	IsSelected: () -> boolean,
	IsEquipped: () -> boolean,
	Activated: () -> (),
}

return function(props: Props)
	local info = EmoteData.ByName[props.EmoteName]
	local camera = create("Camera")({
		FieldOfView = 42,
		CFrame = CFrame.lookAt(Vector3.new(0, 0.35, -6.2), Vector3.new(0, -0.35, 0)),
	})

	return CardFrame({
		Name = props.EmoteName,
		Active = true,
		LayoutOrder = props.LayoutOrder,
		Size = UDim2.fromScale(0.239841, 0.354932),
		CornerRadius = UDim.new(0.06, 0),
		Rarity = "Rare",
		Selected = props.IsSelected,
		ShimmerEnabled = false,
		GlowEnabled = false,
		RarityBorderEnabled = false,
		PressedScale = 0.96,
		HoverScale = 1.025,
		HoverEnabled = false,
		Activated = props.Activated,
		Content = {
			create("UIAspectRatioConstraint")({}),
			create("ViewportFrame")({
				Name = "Preview",
				BackgroundTransparency = 1,
				CurrentCamera = camera,
				Position = UDim2.fromScale(0.035, 0.02),
				Size = UDim2.fromScale(0.93, 0.9),
				ZIndex = 5,
				camera,
				if info then PlayerCharacter({
					UseWorldModel = true,
					Origin = CFrame.new(0, -2.35, 1.5),
					IntroAnimationId = info.IntroAnimationId,
					AnimationId = info.AnimationId,
					Looped = info.Looped == true,
					PlaybackSpeed = info.PlaybackSpeed or 1,
				}) else nil,
			}),
			create("TextLabel")({
				Name = "EmoteName",
				AnchorPoint = Vector2.new(0, 1),
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = UDim2.fromScale(0.075, 0.94),
				Size = UDim2.fromScale(0.82, 0.14),
				Text = info and (info.DisplayName or info.Name) or props.EmoteName,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 9,
				create("UIStroke")({ Thickness = 2 }),
			}),
			create("ImageLabel")({
				Name = "EquippedCheck",
				AnchorPoint = Vector2.new(1, 0),
				BackgroundTransparency = 1,
				Image = "rbxassetid://91966631627808",
				Position = UDim2.fromScale(0.96, 0.04),
				Size = UDim2.fromScale(0.2, 0.2),
				ScaleType = Enum.ScaleType.Fit,
				Visible = props.IsEquipped,
				ZIndex = 10,
				create("UIAspectRatioConstraint")({}),
			}),
		},
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">ItemCard</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ItemData = require(ReplicatedStorage.Settings.Data.ItemData)
local CardFrame = require(ReplicatedStorage.UI.Components.Card.CardFrame)
local CardName = require(ReplicatedStorage.UI.Components.Card.CardName)
local CardQuantity = require(ReplicatedStorage.UI.Components.Card.CardQuantity)

local create = Vide.create

export type Props = {
	ItemName: string,
	Count: number,
	Category: string,
	LayoutOrder: number | (() -> number),
	IsSelected: () -> boolean,
	Activated: () -> (),
}

return function(props: Props)
	local info = ItemData.ByName[props.ItemName] or {
		Rarity = if props.Category == "Skin" then "Secret" else "Common",
		ItemImage = "",
	}

	return CardFrame({
		Name = props.ItemName,
		Active = true,
		LayoutOrder = props.LayoutOrder,
		Size = UDim2.fromScale(0.239841, 0.354932),
		CornerRadius = UDim.new(0.06, 0),
		Rarity = info.Rarity,
		Selected = props.IsSelected,
		ShimmerEnabled = false,
		GlowEnabled = false,
		RarityBorderEnabled = false,
		PressedScale = 0.96,
		HoverScale = 1.025,
		HoverEnabled = false,
		Activated = props.Activated,
		Content = {
			create("UIAspectRatioConstraint")({ Name = "UIAspectRatioConstraint" }),
			create("ImageLabel")({
				Name = "Item",
				BackgroundTransparency = 1,
				Image = info.ItemImage or "",
				Position = UDim2.fromScale(0.11, 0.102),
				ScaleType = Enum.ScaleType.Fit,
				Size = UDim2.fromScale(0.784, 0.66),
				ZIndex = 5,
			}),
			CardQuantity({ Text = `{props.Count}x` }),
			CardName({ Text = props.ItemName, Name = "ItemName" }),
		},
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">LoadingScreen.story</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ReplicatedFirst = game:GetService("ReplicatedFirst")

local Vide = require(ReplicatedStorage.Packages.Vide)
local LoadingScreen = require(ReplicatedFirst.LoadingScreen)

local mount = Vide.mount
local source = Vide.source

return function(target: Instance)
	local isVisible = source(false)
	local destroyVide = mount(function()
		return LoadingScreen({
			IsVisible = isVisible,
			UseScreenGui = false,
		})
	end, target)

	task.defer(function()
		if target.Parent then
			isVisible(true)

			task.delay(3.5, function()
				if not target.Parent then
					return
				end

				isVisible(false)
				task.delay(1.25, function()
					if target.Parent then
						isVisible(true)
					end
				end)
			end)
		end
	end)

	return function()
		destroyVide()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">LoadoutSlot</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local TraitData = require(ReplicatedStorage.Settings.Data.TraitData)
local UnitCatalog = require(ReplicatedStorage.Settings.Data.UnitCatalog)
local UnitViewportProfiles = require(ReplicatedStorage.Settings.Visuals.UnitViewportProfiles)
local TowerViewport = require(ReplicatedStorage.UI.Components.TowerViewport)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)
local CardFrame = require(ReplicatedStorage.UI.Components.Card.CardFrame)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local useDiagonalShine = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useDiagonalShine)

local create = Vide.create
local derive = Vide.derive

local EMPTY_BACKGROUND_GRADIENT = ColorSequence.new(Color3.fromRGB(72, 76, 86))

local LOBBY_SHINE_MOTION = {
	startPosition = UDim2.fromScale(-0.58, -0.46),
	endPosition = UDim2.fromScale(1.58, 1.46),
	duration = 6.2,
	restInterval = 2.4,
}

export type Props = {
	slotNumber: number,
	loadout: () -> { [string | number]: { Name: string?, Key: string?, towerName: string?, towerKey: string? }? },
	units: () -> { [string]: { [string | number]: any } },
	Activated: (() -> ())?,
}

local function createGlowLine(
	name: string,
	color: () -> ColorSequence,
	positionX: number,
	width: number,
	transparency: () -> number
)
	return create("Frame")({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = transparency,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(positionX, 0.5),
		Size = UDim2.fromScale(width, 1),
		ZIndex = 4,

		create("UIGradient")({
			Color = color,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.16, 0.96),
				NumberSequenceKeypoint.new(0.5, 0.22),
				NumberSequenceKeypoint.new(0.84, 0.96),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
end

local function createShinePair(
	name: string,
	color: () -> ColorSequence,
	transparency: () -> number,
	active: () -> boolean,
	delay: number
)
	return create("Frame")({
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Rotation = 18,
		Size = UDim2.fromScale(1.05, 1.62),
		ZIndex = 4,

		createGlowLine("LeadingGlow", color, 0.2, 0.76, transparency),
		createGlowLine("TrailingGlow", color, 0.8, 0.68, function()
			return math.min(transparency() + 0.06, 0.92)
		end),

		useDiagonalShine(active, 1, delay, LOBBY_SHINE_MOTION),
	})
end

return function(props: Props)
	local tower = derive(function()
		local currentLoadout = props.loadout()
		return currentLoadout[tostring(props.slotNumber)] or currentLoadout[props.slotNumber]
	end)

	local towerName = derive(function()
		local equipped = tower()
		if not equipped then
			return ""
		end

		return equipped.Name or equipped.towerName or ""
	end)

	local towerKey = derive(function()
		local equipped = tower()
		return if equipped then equipped.Key or equipped.towerKey else nil
	end)

	local towerProfile = derive(function()
		local name = towerName()
		local key = towerKey()
		local ownedOfType = props.units()[name]
		if not ownedOfType or key == nil then
			return nil
		end

		local keyText = tostring(key)
		local keyId = keyText:match("^t_(%d+)$") or keyText:match("^(%d+)$")
		return ownedOfType[key] or ownedOfType[keyText] or (keyId and ownedOfType[`t_{keyId}`]) or nil
	end)

	local towerLevel = derive(function()
		local profile = towerProfile()
		return if profile and typeof(profile.Lv) == "number" then profile.Lv else 0
	end)
	local traitInfo = derive(function()
		local profile = towerProfile()
		return if profile and profile.Trait then TraitData.ByName[profile.Trait] else nil
	end)
	local traitGradient = derive(function()
		local info = traitInfo()
		return RarityRegistry.Get(if info then info.Rarity else "Common").Presentation.Gradient
	end)

	local hasTower = derive(function()
		return towerName() ~= ""
	end)

	local towerCost = derive(function()
		local towerInfo = TowerData.ByName[towerName()]
		local cost = towerInfo and towerInfo.Stats and towerInfo.Stats[0] and towerInfo.Stats[0].Cost or 0
		return `₩{NumberUtils.FormatComma(cost)}`
	end)

	local rarity = derive(function()
		return UnitCatalog.GetRarity(towerName())
	end)
	local viewportProfile = derive(function()
		return UnitViewportProfiles.GetCard(towerName())
	end)

	local shineGradient = derive(function()
		return RarityRegistry.Get(rarity()).Presentation.Gradient
	end)
	local shineTransparency = derive(function()
		return 0.38
	end)

	return CardFrame({
		Name = `Slot{props.slotNumber}`,
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ClipsDescendants = false,
		Image = "rbxassetid://87496848270095",
		ImageColor3 = Color3.new(1, 1, 1),
		ImageTransparency = function()
			return if hasTower() then 0 else 0.2
		end,
		LayoutOrder = props.slotNumber,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.227, 0.935),
		ZIndex = 1,
		Activated = props.Activated,
		Rarity = rarity,
		RarityEnabled = hasTower,
		FallbackGradient = EMPTY_BACKGROUND_GRADIENT,
		CornerRadius = UDim.new(0, 8),
		HoverRotation = -1.5,
		PressedScale = 0.93,
		HoverScale = 1.07,
		Content = {

		create("UIAspectRatioConstraint")({
			Name = "UIAspectRatioConstraint",
		}),

		create("ImageLabel")({
			Name = "Level",
			BackgroundTransparency = 1,
			Image = "rbxassetid://104083646922843",
			Position = UDim2.fromScale(-0.013, -0.05),
			Size = UDim2.fromScale(0.653434, 0.238322),
			Visible = hasTower,
			ZIndex = 10,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
				AspectRatio = 3.2,
			}),

			create("TextLabel")({
				Name = "TextLabel",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.new(
					"rbxasset://fonts/families/SourceSansPro.json",
					Enum.FontWeight.Bold,
					Enum.FontStyle.Normal
				),
				Position = UDim2.fromScale(0.3, 0.489),
				Size = UDim2.fromScale(0.477775, 0.75514),
				Text = function()
					return `Level {towerLevel()}`
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,

				create("UIStroke")({
					Name = "UIStroke",
					Thickness = 2,
				}),

				create("UIGradient")({
					Name = "UIGradient",
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(104, 106, 211)),
					}),
					Rotation = 90,
				}),
			}),
		}),

		create("ImageLabel")({
			Name = "Trait",
			BackgroundTransparency = 1,
			Image = function()
				local info = traitInfo()
				return if info then info.Image else ""
			end,
			Position = UDim2.fromScale(0.64, 0.03),
			Size = UDim2.fromScale(0.359565, 0.31687),
			Visible = function()
				return traitInfo() ~= nil
			end,
			ZIndex = 12,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
			}),

			create("UIGradient")({
				Name = "RarityGradient",
				Color = traitGradient,
				Rotation = 30,
			}),
		}),

		create("TextLabel")({
			Name = "Price",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.108, 0.782623),
			Size = UDim2.fromScale(0.641, 0.2),
			Text = towerCost,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,
			Visible = hasTower,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),

			create("UIGradient")({
				Name = "UIGradient",
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 152, 62)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 160, 26)),
				}),
				Rotation = 90,
			}),
		}),

		create("TextLabel")({
			Name = "Rarity",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.108, 0.535),
			Size = UDim2.fromScale(0.7, 0.105),
			Text = function()
				return string.upper(rarity())
			end,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Visible = hasTower,
			ZIndex = 10,

			create("UIGradient")({
				Color = shineGradient,
			}),

			create("UIStroke")({
				Thickness = 1.5,
			}),
		}),

		create("TextLabel")({
			Name = "Name",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.108, 0.618754),
			Size = UDim2.fromScale(0.848871, 0.172688),
			Text = towerName,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,
			Visible = hasTower,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),
		}),

		TowerViewport({
			Name = "UnitViewport",
			Active = hasTower,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			TowerName = towerName,
			AnimationName = "Idle",
			AnimationLevel = towerLevel,
			AnimationFadeTime = 0,
			AnimationLooped = true,
			AnimationSpeed = 1,
			UseViewportModel = true,
			UseCharacterBounds = function()
				return viewportProfile().BoundsMode == "Character"
			end,
			UsePortraitBounds = function()
				return viewportProfile().BoundsMode == "Portrait"
			end,
			CenterOnRoot = function()
				return not viewportProfile().CenterOnBounds
			end,
			RenderEffects = false,
			FitPadding = function()
				return viewportProfile().FitPadding
			end,
			FieldOfView = 35,
			FocusYOffset = function()
				return viewportProfile().FocusYOffset
			end,
			CameraDirection = Vector3.new(0, 0, -1),
			ModelRotation = 15,
			Ambient = Color3.fromRGB(205, 205, 205),
			Position = UDim2.fromScale(0.5, 0.51),
			Size = UDim2.fromScale(0.9, 0.9),
			ZIndex = 5,
			Visible = hasTower,
		}),

		create("CanvasGroup")({
			Name = "DiagonalShineMask",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			GroupTransparency = 0,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.94, 0.94),
			Visible = hasTower,
			ZIndex = 4,

			create("UICorner")({
				Name = "ShineCorner",
				CornerRadius = UDim.new(0, 8),
			}),

			createShinePair(
				"WideDiagonalLights",
				shineGradient,
				shineTransparency,
				hasTower,
				(props.slotNumber - 1) * 0.24
			),
		}),
		},
	})
end
]]></string>
