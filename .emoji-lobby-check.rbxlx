        <Item class="ModuleScript" referent="441">
          <Properties>
            <string name="Name">UnitViewportProfiles</string>
            <string name="Source"><![CDATA[export type BoundsMode = "Portrait" | "Character" | "Visual"

export type Profile = {
	BoundsMode: BoundsMode,
	CenterOnBounds: boolean,
	FitPadding: number,
	FocusYOffset: number,
}

local CARD_DEFAULT: Profile = {
	BoundsMode = "Portrait",
	CenterOnBounds = false,
	FitPadding = 1.25,
	FocusYOffset = 0.5,
}

-- Detail previews include weapons/accessories in the distance calculation, but
-- retain HumanoidRootPart as the composition center.
local DETAIL_DEFAULT: Profile = {
	BoundsMode = "Visual",
	CenterOnBounds = false,
	FitPadding = 1.15,
	FocusYOffset = 0.18,
}

-- Weapon-inclusive full-model fitting made Galahad's face much smaller than
-- other units. All humanoids now share the animated bust composition.
local OVERRIDES: { [string]: Profile } = {}

local UnitViewportProfiles = {}

function UnitViewportProfiles.GetCard(unitName: string): Profile
	return OVERRIDES[unitName] or CARD_DEFAULT
end

function UnitViewportProfiles.GetDetail(_unitName: string): Profile
	return DETAIL_DEFAULT
end

-- Compatibility for existing card callers.
UnitViewportProfiles.Get = UnitViewportProfiles.GetCard
UnitViewportProfiles.CardDefault = CARD_DEFAULT
UnitViewportProfiles.DetailDefault = DETAIL_DEFAULT
UnitViewportProfiles.Overrides = OVERRIDES

return table.freeze(UnitViewportProfiles)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="442">
          <Properties>
            <string name="Name">VFXRecipes</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Steps = require(script.Steps)
local TableUtils = require(ReplicatedStorage.Shared.Modules.Utils.TableUtils)

--[ 예시 ]--
--[[
{
	["Source Name"] = {
		["Attack"] = {
			[0(Level)] = {
				Steps.Emit("Towers/TestTower/Emit", {
					Delay = 0.2,
					Lifetime = 3,

					At = ("Source" | "Target"),
				}),
				Steps.Projectile("Towers/TestTower/Projectile", {
					Delay = 0.5,
					Lifetime = 3,

					From = "Source.GunModel.Muzzle",
					To = "Target",

					Speed = 5555,
					OnHit = Steps.Emit(...)
				}),
				Steps.Beam("Towers/TestTower/Beam", {
					Delay = 1.5,

					From = "Source.GunModel.Muzzle",
					To = "Target",
				}),
			},
			[1] = {
				...
			}
		},
		["SecondAttack"] = {
			...
		}	
	}
}
--]]

return TableUtils.DeepFreeze({
	--/Emotes
	["CameraFlash"] = {
		Emote = {
			Steps.Emit("Emote/CameraFlash", { At = "Source.EmoteProps.Camera" }),
		},
	},

	--/Towers
	["TowerShared"] = {
		Place_Common = {
			Steps.Emit("Towers/Shared/CommonPlace", { At = "Source.@Ground" }),
		},
		Place_Rare = {
			Steps.Emit("Towers/Shared/RarePlace", { At = "Source.@Ground" }),
		},
		Place_Epic = {
			Steps.Emit("Towers/Shared/EpicPlace", { At = "Source.@Ground" }),
		},
		Place_Legendary = {
			Steps.Emit("Towers/Shared/LegendaryPlace", { At = "Source.@Ground" }),
		},
		Place_Mythic = {
			Steps.Emit("Towers/Shared/MythicPlace", { At = "Source.@Ground" }),
		},
		Place_Absolute = {
			Steps.Emit("Towers/Shared/AbsolutePlace", { At = "Source.@Ground" }),
		},

		Upgrade_Common = {
			Steps.Emit("Towers/Shared/CommonUpgrade", { At = "Source.@Ground" }),
		},
		Upgrade_Rare = {
			Steps.Emit("Towers/Shared/RareUpgrade", { At = "Source.@Ground" }),
		},
