          <Item class="ModuleScript" referent="634">
            <Properties>
              <string name="Name">TouchZone</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Signal = require(ReplicatedStorage.Packages.Signal)

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function GetCharacters()
	local characters = {}

	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			characters[#characters + 1] = character
		end
	end

	return characters
end

local function GetPlayerFromPart(part: BasePart): (Player?, Model?)
	local character = part:FindFirstAncestorOfClass("Model")
	if not character then
		return
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end

	return player, character
end

-------------------------------------------------
--// TouchZone
-------------------------------------------------
local TouchZone = {}
TouchZone.__index = TouchZone

TouchZone.DefaultInterval = 0.2

function TouchZone.new(zonePart: BasePart)
	local self = setmetatable({}, TouchZone)

	self.ZonePart = zonePart
	self.Interval = TouchZone.DefaultInterval
	self.OverlapParams = OverlapParams.new()
	self.OverlapParams.FilterType = Enum.RaycastFilterType.Include
	self.OverlapParams.FilterDescendantsInstances = {}

	self.Touched = Signal.new()
	self.TouchEnded = Signal.new()

	self._inside = {}
	self._elapsed = 0
	self._connection = nil

	return self
end

function TouchZone:Start()
	if self._connection then
		return
	end

	self._connection = RunService.Heartbeat:Connect(function(dt)
		self._elapsed += dt

		if self._elapsed < self.Interval then
			return
		end

		self._elapsed = 0
		self:_Update()
	end)
end

function TouchZone:Stop()
	if not self._connection then
		return
	end

	self._connection:Disconnect()
	self._connection = nil
end

function TouchZone:Destroy()
	self:Stop()

	self.Touched:Destroy()
	self.TouchEnded:Destroy()

	table.clear(self._inside)
	table.clear(self)
end

function TouchZone:_GetCurrent(): { [Player]: Model }
	local current = {}

	self.OverlapParams.FilterDescendantsInstances = GetCharacters()

	for _, part in workspace:GetPartsInPart(self.ZonePart, self.OverlapParams) do
		local player, character = GetPlayerFromPart(part)

		if player then
			current[player] = character
		end
	end

	return current
end

function TouchZone:_Update()
	local current = self:_GetCurrent()

	for player, character in current do
		if self._inside[player] then
			continue
		end

		self._inside[player] = character
		self.Touched:Fire(player, character)
	end

	for player, character in self._inside do
		if current[player] then
			continue
		end

		self._inside[player] = nil
		self.TouchEnded:Fire(player, character)
	end
end

function TouchZone:IsTouching(player: Player): boolean
	return self._inside[player] ~= nil
end

return TouchZone
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="635">
            <Properties>
              <string name="Name">ViewportModel</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="636">
            <Properties>
              <string name="Name">ViewportModel</string>
              <string name="Source"><![CDATA[--[[
MIT License

Copyright (c) 2021 EgoMoose

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
--]]

local BLOCK = { 0, 1, 2, 3, 4, 5, 6, 7 }
local WEDGE = { 0, 1, 3, 4, 5, 7 }
local CORNER_WEDGE = { 0, 1, 4, 5, 6 }
local CHARACTER_BODY_PART_NAMES = {
	Head = true,
	Torso = true,
	UpperTorso = true,
	LowerTorso = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
}
local PORTRAIT_PART_NAMES = {
	Head = true,
	Torso = true,
	UpperTorso = true,
	LowerTorso = true,
}

-- Class

local ViewportModelClass = {}
ViewportModelClass.__index = ViewportModelClass
ViewportModelClass.ClassName = "ViewportModel"

-- Private

local function getIndices(part)
	if part:IsA("WedgePart") then
		return WEDGE
	elseif part:IsA("CornerWedgePart") then
		return CORNER_WEDGE
	end
	return BLOCK
end

local function getCorners(cf, size2, indices)
	local corners = {}
	for j, i in pairs(indices) do
		corners[j] = cf
			* (size2 * Vector3.new(2 * (math.floor(i / 4) % 2) - 1, 2 * (math.floor(i / 2) % 2) - 1, 2 * (i % 2) - 1))
	end
	return corners
end

local function isVisualPart(part)
	if part.Transparency < 0.99 then
		return true
	end

	for _, descendant in pairs(part:GetDescendants()) do
		if
			(descendant:IsA("Decal") or descendant:IsA("Texture"))
			and descendant.Transparency < 0.99
		then
			return true
		end
	end

	return false
end

local function getModelPointCloud(model, visualOnly, characterBodyOnly, portraitOnly)
	local points = {}
	for _, part in pairs(model:GetDescendants()) do
		if
			part:IsA("BasePart")
			and (not visualOnly or isVisualPart(part))
			and (not characterBodyOnly or CHARACTER_BODY_PART_NAMES[part.Name])
			and (not portraitOnly or PORTRAIT_PART_NAMES[part.Name])
		then
			local indices = getIndices(part)
			local corners = getCorners(part.CFrame, part.Size / 2, indices)
			for _, wp in pairs(corners) do
				table.insert(points, wp)
			end
		end
	end
	return points
end

local function viewProjectionEdgeHits(cloud, axis, depth, tanFov2)
	local max, min = -math.huge, math.huge

	for _, lp in pairs(cloud) do
		local distance = depth - lp.Z
		local halfSpan = tanFov2 * distance

		local a = lp[axis] + halfSpan
		local b = lp[axis] - halfSpan

		max = math.max(max, a, b)
		min = math.min(min, a, b)
	end

	return max, min
end

-- Public Constructors

function ViewportModelClass.new(vpf, camera)
	local self = setmetatable({}, ViewportModelClass)

	self.Model = nil
	self.ViewportFrame = vpf
	self.Camera = camera

	self._points = {}
	self._modelCFrame = CFrame.new()
	self._modelSize = Vector3.new()
	self._modelRadius = 0

	self._viewport = {}

	self:Calibrate()

	return self
end

-- Public Methods

-- Used to set the model that is being focused on
-- should be used for new models and/or a change in the current model
-- e.g. parts added/removed from the model or the model cframe changed
function ViewportModelClass:SetModel(model, useCharacterBounds, usePortraitBounds, cachedPoints)
	self.Model = model

	-- Measure portrait previews from the head/torso, so weapons, effects and
	-- oversized accessories cannot make otherwise similar units look tiny.
	local points = cachedPoints
	if not points then
		points = if usePortraitBounds then getModelPointCloud(model, true, true, true) else {}
		if #points == 0 and useCharacterBounds then
			points = getModelPointCloud(model, true, true, false)
		end
		if #points == 0 then
			points = getModelPointCloud(model, true, false, false)
		end
		if #points == 0 then
			points = getModelPointCloud(model, false, false, false)
		end
		if #points == 0 then
			points = { model:GetPivot().Position }
		end
	end

	local minimum = points[1]
	local maximum = points[1]
	for index = 2, #points do
		local point = points[index]
		minimum = Vector3.new(
			math.min(minimum.X, point.X),
			math.min(minimum.Y, point.Y),
			math.min(minimum.Z, point.Z)
		)
		maximum = Vector3.new(
			math.max(maximum.X, point.X),
			math.max(maximum.Y, point.Y),
			math.max(maximum.Z, point.Z)
		)
	end

	local size = maximum - minimum
	self._points = points
	self._modelCFrame = CFrame.new((minimum + maximum) * 0.5)
	self._modelSize = size
	self._modelRadius = size.Magnitude / 2
	return points
end

-- Should be called when something about the viewport frame / camera changes
-- e.g. the frame size or the camera field of view
function ViewportModelClass:Calibrate()
	local viewport = {}
	local size = self.ViewportFrame.AbsoluteSize
	size = Vector2.new(math.max(size.X, 1), math.max(size.Y, 1))

	viewport.aspect = size.X / size.Y

	viewport.yFov2 = math.rad(self.Camera.FieldOfView / 2)
	viewport.tanyFov2 = math.tan(viewport.yFov2)

	viewport.xFov2 = math.atan(viewport.tanyFov2 * viewport.aspect)
	viewport.tanxFov2 = math.tan(viewport.xFov2)

	viewport.cFov2 = math.atan(viewport.tanyFov2 * math.min(1, viewport.aspect))
	viewport.sincFov2 = math.sin(viewport.cFov2)

	self._viewport = viewport
end

-- returns a fixed distance that is guarnteed to encapsulate the full model
-- this is useful for when you want to rotate freely around an object w/o expensive calculations
-- focus position can be used to set the origin of where the camera's looking
-- otherwise the model's center is assumed
function ViewportModelClass:GetFitDistance(focusPosition)
	local displacement = focusPosition and (focusPosition - self._modelCFrame.Position).Magnitude or 0
	local radius = self._modelRadius + displacement

	return radius / self._viewport.sincFov2
end

-- returns the optimal camera cframe that would be needed to best fit
-- the model in the viewport frame at the given orientation.
-- keep in mind this functions best when the model's point-cloud is correct
-- as such models that rely heavily on meshesh, csg, etc will only return an accurate
-- result as their point cloud
function ViewportModelClass:GetMinimumFitCFrame(orientation, focusPosition)
	if not self.Model then
		return CFrame.new()
	end

	local rotation = orientation - orientation.Position
	local rInverse = rotation:Inverse()

	-- Character portraits should stay anchored to a stable rig part (normally
	-- HumanoidRootPart). This prevents different pivots, idle poses and held
	-- equipment from pulling otherwise identical cards in different directions.
	if focusPosition then
		local localFocus = rInverse * focusPosition
		local requiredDistance = 0
		for _, worldPoint in self._points do
			local point = rInverse * worldPoint - localFocus
			requiredDistance = math.max(
				requiredDistance,
				point.Z + math.abs(point.X) / self._viewport.tanxFov2,
				point.Z + math.abs(point.Y) / self._viewport.tanyFov2
			)
		end

		return orientation * CFrame.new(localFocus.X, localFocus.Y, localFocus.Z + requiredDistance)
	end

	local wcloud = self._points
	local cloud = { rInverse * wcloud[1] }
	local furthest = cloud[1].Z

	for i = 2, #wcloud do
		local lp = rInverse * wcloud[i]
		furthest = math.min(furthest, lp.Z)
		cloud[i] = lp
	end

	local hMax, hMin = viewProjectionEdgeHits(cloud, "X", furthest, self._viewport.tanxFov2)
	local vMax, vMin = viewProjectionEdgeHits(cloud, "Y", furthest, self._viewport.tanyFov2)

	local distance =
		math.max(((hMax - hMin) / 2) / self._viewport.tanxFov2, ((vMax - vMin) / 2) / self._viewport.tanyFov2)

	return orientation * CFrame.new((hMax + hMin) / 2, (vMax + vMin) / 2, furthest + distance)
end

--

return ViewportModelClass
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="637">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="638">
      <Properties>
        <string name="Name">ETDAdmin</string>
      </Properties>
      <Item class="ModuleScript" referent="639">
        <Properties>
          <string name="Name">Audit</string>
          <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Config = require(script.Parent.Config)
local Audit = {}
local entries, queue = {}, {}
local deliveryStatus = Config.WebhookUrl == "" and "Discord webhook is not configured." or "Discord delivery is ready."
if RunService:IsStudio() and Config.WebhookUrl ~= "" and not Config.WebhookEnabledInStudio then
	deliveryStatus = "Discord audit is configured; delivery is disabled in Studio."
end
local sequence = 0
local function truncate(text, limit)
	text = tostring(text)
	if #text <= limit then return text end
	local nextCharacter = utf8.offset(text, 0, limit + 1)
	return text:sub(1, (nextCharacter or limit + 1) - 1)
end
function Audit.Record(actor, role, action, targetId, outcome, detail)
	sequence += 1
	local entry = {
		id = sequence, time = os.time(), actor = actor.Name, actorId = actor.UserId,
		role = role, action = truncate(action, 48), targetId = targetId,
		outcome = outcome, detail = truncate(detail or "", 300),
		placeId = game.PlaceId, jobId = game.JobId,
	}
	table.insert(entries, 1, entry)
	if #entries > Config.AuditCapacity then table.remove(entries) end
	if Config.WebhookUrl ~= "" and (not RunService:IsStudio() or Config.WebhookEnabledInStudio) then
		if #queue < 100 then table.insert(queue, entry) else deliveryStatus = "Discord queue is full; check server output." end
	end
	if outcome == "denied" then warn("[ETD Admin] denied", entry.actorId, entry.action, entry.detail) end
	return entry
end
function Audit.Read(actor, role, studio)
	local result = {}
	for _, entry in ipairs(entries) do
		if studio or role == "Owner" or role == "Head developer" or entry.actorId == actor.UserId then
			table.insert(result, table.clone(entry))
			if #result == 30 then break end
		end
	end
	return result
end
function Audit.Status() return deliveryStatus end
task.spawn(function()
	while true do
		task.wait(5)
		if #queue == 0 then continue end
		local batch = {}
		-- Three bounded records fit without silently dropping trailing audit entries.
		for _ = 1, math.min(#queue, 3) do table.insert(batch, table.remove(queue, 1)) end
		local lines = {}
		for _, entry in ipairs(batch) do
			table.insert(lines, string.format("[%s] %s (%d) · %s · %s → %s · %s", entry.outcome, entry.actor, entry.actorId, entry.role, entry.action, tostring(entry.targetId), entry.detail))
		end
		local ok, response = pcall(function()
			local body = HttpService:JSONEncode({username="Aether Admin", content=truncate(table.concat(lines, "\n"), 1900), allowed_mentions={parse={}}})
			return HttpService:RequestAsync({Url=Config.WebhookUrl, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
		end)
		if ok and response.Success then
			deliveryStatus = "Discord audit delivered at " .. os.date("!%H:%M:%S UTC")
		else
			deliveryStatus = "Discord delivery failed; check HTTP access and server webhook configuration."
			warn("[ETD Admin] " .. deliveryStatus)
			-- Bounded retries; do not flood Discord or grow memory indefinitely.
			for _, entry in ipairs(batch) do
				entry.retries = (entry.retries or 0) + 1
				if entry.retries < 3 and #queue < 100 then table.insert(queue, entry) end
			end
			task.wait(10)
		end
	end
end)
return Audit
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="640">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TextService = game:GetService("TextService")
local MessagingService = game:GetService("MessagingService")
local GroupService = game:GetService("GroupService")
local Config = require(script.Parent.Config)
local Policy = require(script.Parent.Policy)
local Audit = require(script.Parent.Audit)
local Persistent = require(script.Parent.Persistent)
local Match = require(script.Parent.Match)
local studio = RunService:IsStudio() and Config.StudioFullAccess == true
local folder = ReplicatedStorage:WaitForChild("ETDAdmin")
local request = folder:WaitForChild("Request")
local notice = folder:WaitForChild("Notice")
local roles, buckets, busy, pending, lastDenial, commandTimes = {}, {}, {}, {}, {}, {}
local targetLocks = {}
local subscriptionReady = false
local dangerous = {Ban=true, Kick=true, Unban=true, ResetData=true}
local persistentActions = {GiveItem=true, GiveCurrency=true, GiveTower=true, TowerLevel=true, Trait=true, ResetData=true}
local matchActions = {SpawnUnit=true, SpawnEnemy=true, Money=true, GameSpeed=true}
local currencyIds = {Coins=true, Gems=true, Blossom=true}
local cooldowns = {Announce=5, Ban=2, Kick=2, Unban=2, ResetData=3, SpawnEnemy=1, SpawnUnit=1, GiveTower=1}

local function roleFor(player)
	if studio then return "Owner" end
	local cached = roles[player]
	if cached and os.clock() - cached.at < 60 then return cached.role end
	local role = "None"
	if table.find(Config.OwnerUserIds, player.UserId) or (game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId) then
		role = "Owner"
	elseif Policy.ValidRole(Config.UserRoles[player.UserId]) then
		role = Policy.NormalizeRole(Config.UserRoles[player.UserId])
	elseif Config.GroupId > 0 then
		local rankRoles, nameRoles = Config.GroupRankRoles or {}, Config.GroupNameRoles or {}
		local ok, membership = pcall(function()
			return GroupService:GetRolesInGroupAsync(player.UserId, Config.GroupId)
		end)
		if ok then
			role = Policy.GroupMembershipRole(membership, rankRoles, nameRoles) or "None"
		else
			-- Compatibility with Studio versions that do not expose the multi-role API yet.
			local rankOk, rank = pcall(player.GetRankInGroupAsync, player, Config.GroupId)
			if rankOk then
				local groupRole = Policy.GroupRole(rank, nil, rankRoles, nameRoles)
				if not groupRole and rank > 0 then
					local nameOk, name = pcall(player.GetRoleInGroupAsync, player, Config.GroupId)
					if nameOk then groupRole = Policy.GroupRole(rank, name, rankRoles, nameRoles) end
				end
				role = groupRole or "None"
			end
		end
	end
	roles[player] = {role=role, at=os.clock()}
	return role
end
local function consume(player)
	local now = os.clock()
	local bucket = buckets[player] or {tokens=Config.RequestBurst, at=now}
	bucket.tokens = math.min(Config.RequestBurst, bucket.tokens + (now - bucket.at) * Config.RequestsPerSecond)
	bucket.at = now
	buckets[player] = bucket
	if bucket.tokens < 1 then return false end
	bucket.tokens -= 1
	return true
end
local function fail(message)
	message = tostring(message):gsub("^.-:%d+: ", "")
	return {ok=false, message=message}
end
local function finite(n) return type(n) == "number" and n == n and math.abs(n) < math.huge end
local function cleanArgs(args)
	if args == nil then return {} end
	if type(args) ~= "table" then error("Invalid command arguments.", 0) end
	local result, count = {}, 0
	for key, value in pairs(args) do
		count += 1
		if count > 12 or type(key) ~= "string" or #key > 32 then error("Invalid command arguments.", 0) end
		if type(value) == "number" then
			if not finite(value) then error("Numbers must be finite.", 0) end
		elseif type(value) == "string" then
			if #value > 500 or not utf8.len(value) then error("Text must be valid and at most 500 bytes.", 0) end
		elseif type(value) ~= "boolean" then error("Unsupported command argument.", 0) end
		result[key] = value
	end
	return result
end
local function targetFor(actor, action, id)
	id = id == nil and actor.UserId or id
	if not finite(id) or id % 1 ~= 0 then error("Select a valid player.", 0) end
	local target = Players:GetPlayerByUserId(id)
	if not target and action ~= "Ban" and action ~= "Unban" then error("That player is no longer in this server.", 0) end
	if not target and id <= 0 then error("A positive Roblox UserId is required.", 0) end
	return target, id
end
local function authorize(actor, role, action, targetId)
	local allowed, reason = Policy.Allowed(role, studio, action, actor.UserId, targetId, #Players:GetPlayers())
	if not allowed then
		Audit.Record(actor, role, action, targetId, "denied", reason)
		error(reason, 0)
	end
end
local function reasonFor(args)
	local reason = args.reason
	if type(reason) ~= "string" or not reason:match("%S") or #reason > 200 then error("Enter a moderation reason (1–200 bytes).", 0) end
	return reason
end
local function filtered(text, actor)
	if RunService:IsStudio() then return text end
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, actor.UserId, Enum.TextFilterContext.PublicChat):GetNonChatStringForBroadcastAsync()
	end)
	if not ok then error("Roblox text filtering is unavailable. Nothing was sent.", 0) end
	return result
end
local seen, seenOrder = {}, {}
-- A seeded random hue gives each announcer one consistent color across servers.
-- Identity and color are generated here, never taken from client arguments.
local function announcerFor(actor)
	local random = Random.new(math.abs(actor.UserId) % 2147483647)
	local color = Color3.fromHSV(random:NextNumber(), 0.48, 1)
	return {userId=actor.UserId, displayName=actor.DisplayName, color={r=color.R, g=color.G, b=color.B}}
end
local function validAnnouncer(announcer)
	if type(announcer) ~= "table" or not finite(announcer.userId) or announcer.userId % 1 ~= 0 then return false end
	if type(announcer.displayName) ~= "string" or #announcer.displayName == 0 or #announcer.displayName > 100 or not utf8.len(announcer.displayName) then return false end
	if type(announcer.color) ~= "table" then return false end
	for _, channel in ipairs({"r", "g", "b"}) do
		local value = announcer.color[channel]
		if not finite(value) or value < 0 or value > 1 then return false end
	end
	return true
end
local function deliverAnnouncement(data)
	if type(data) ~= "table" or (data.version ~= 1 and data.version ~= 2) or type(data.id) ~= "string" or #data.id > 64 or seen[data.id] then return end
	if type(data.text) ~= "string" or #data.text > 650 or type(data.title) ~= "string" or #data.title > 100 then return end
	if (data.version == 2 or data.announcer ~= nil) and not validAnnouncer(data.announcer) then return end
	if not finite(data.time) or math.abs(os.time() - data.time) > 120 then return end
	seen[data.id] = true
	table.insert(seenOrder, data.id)
	if #seenOrder > 100 then seen[table.remove(seenOrder, 1)] = nil end
	notice:FireAllClients({text=data.text, title=data.title, announcer=data.announcer})
end
task.spawn(function()
	if RunService:IsStudio() then return end
	for attempt = 1, 3 do
		local ok = pcall(function()
			MessagingService:SubscribeAsync(Config.AnnouncementTopic, function(message) deliverAnnouncement(message.Data) end)
		end)
		if ok then subscriptionReady = true; return end
		task.wait(attempt * 5)
	end
	warn("[ETD Admin] Universe announcement subscription unavailable.")
end)
local function perform(actor, role, action, target, targetId, args)
	if persistentActions[action] then
		if action == "GiveCurrency" then
			if Match.Available() then error("Currency grants are available in the lobby only.", 0) end
			if type(args.currencyId) ~= "string" or not currencyIds[args.currencyId] then error("Select Coins, Gems, or Blossom.", 0) end
			if not finite(args.amount) or args.amount % 1 ~= 0 or args.amount < 1 or args.amount > 1_000_000 then
				error("Currency amount must be a whole number between 1 and 1000000.", 0)
			end
			-- Forward only the allowlisted currency and amount, never arbitrary profile fields.
			args = {currencyId=args.currencyId, amount=args.amount}
		end
		local message = Persistent.Perform(action, actor, target, args)
		notice:FireClient(target, {kind="DataChanged"})
		if action == "ResetData" and not RunService:IsStudio() then
			task.delay(0.5, function() if target.Parent == Players then target:Kick("Your data was reset by an administrator. Please rejoin.") end end)
		end
		return message
	end
	if matchActions[action] then return Match.Perform(action, actor, target, args) end
	if action == "Announce" then
		if type(args.text) ~= "string" or not args.text:match("%S") or #args.text > 400 then error("Enter an announcement (1–400 bytes).", 0) end
		if args.scope ~= "Server" and args.scope ~= "Universe" then error("Select Server or Universe announcement scope.", 0) end
		local data = {version=1, id=HttpService:GenerateGUID(false), time=os.time(), text=filtered(args.text, actor), title=actor.DisplayName, announcer=announcerFor(actor)}
		if args.scope == "Universe" and not RunService:IsStudio() then
			if not subscriptionReady then error("Universe announcements are not connected yet.", 0) end
			local ok = pcall(MessagingService.PublishAsync, MessagingService, Config.AnnouncementTopic, data)
			if not ok then error("Universe announcement could not be published.", 0) end
		end
		deliverAnnouncement(data)
		return RunService:IsStudio() and "Studio announcement displayed in this test session only." or ("Announcement sent: " .. args.scope)
	elseif action == "Kick" then
		local reason = filtered(reasonFor(args), actor)
		target:Kick(reason)
		return "Kicked " .. target.Name
	elseif action == "Ban" then
		local reason = reasonFor(args)
		local duration = args.duration
		if not finite(duration) or duration % 1 ~= 0 or (duration ~= -1 and (duration < 60 or duration > 31536000)) then error("Ban duration must be 60–31536000 seconds, or -1 for permanent.", 0) end
		if RunService:IsStudio() then return "Studio ban simulation passed for UserId " .. targetId .. "; no live ban was created." end
		local ok = pcall(Players.BanAsync, Players, {UserIds={targetId}, Duration=duration, DisplayReason=filtered(reason, actor), PrivateReason=string.format("Admin %s (%d): %s", actor.Name, actor.UserId, reason), ExcludeAltAccounts=true, ApplyToUniverse=true})
		if not ok then error("Roblox could not apply the ban. Check BanningEnabled and server output.", 0) end
		return "Universe ban applied to " .. targetId
	elseif action == "Unban" then
		reasonFor(args)
		if RunService:IsStudio() then return "Studio unban simulation passed for UserId " .. targetId .. "; live bans were unchanged." end
		local ok = pcall(Players.UnbanAsync, Players, {UserIds={targetId}, ApplyToUniverse=true})
		if not ok then error("Roblox could not remove the ban.", 0) end
		return "Universe ban removed for " .. targetId
	end
	error("Unknown action.", 0)
end
local function run(actor, role, action, target, targetId, args)
	authorize(actor, role, action, targetId)
	local times = commandTimes[actor] or {}
	commandTimes[actor] = times
	local now = os.clock()
	if times[action] and now - times[action] < (cooldowns[action] or 0.25) then error("Please wait before repeating that action.", 0) end
	times[action] = now
	local lockKey = (action == "SpawnUnit" or action == "SpawnEnemy" or action == "GameSpeed") and "match" or targetId
	if targetLocks[lockKey] then return fail("Another admin command for this target is running. Please wait.") end
	targetLocks[lockKey] = true
	local ok, message = pcall(perform, actor, role, action, target, targetId, args)
	targetLocks[lockKey] = nil
	local detail = message
	if args.reason then detail = tostring(message) .. " · reason: " .. args.reason end
	if action == "Money" or action == "GiveItem" then detail = tostring(message) .. " · amount: " .. tostring(args.amount) end
	if action == "GiveCurrency" then detail = tostring(message) .. " · currency: " .. tostring(args.currencyId) .. " · amount: " .. tostring(args.amount) end
	Audit.Record(actor, role, action, targetId, ok and "success" or "failed", detail)
	if not ok then return fail(tostring(message):sub(1, 350)) end
	return {ok=true, message=message}
end
local function snapshot(actor, role)
	local catalog, warnings = {}, {}
	local ok, data = pcall(Persistent.Catalog)
	if ok then for key, value in pairs(data) do catalog[key] = value end else table.insert(warnings, "Player data is not ready: " .. tostring(data):sub(1, 180)) end
	local matchReady = Match.Available()
	if matchReady then
		local matchOk, matchData = pcall(Match.Catalog)
		if matchOk then for key, value in pairs(matchData) do catalog[key] = value end end
	end
	local capabilities = {}
	for _, action in ipairs(Policy.Actions) do
		capabilities[action] = Policy.Allowed(role, studio, action, actor.UserId, actor.UserId, #Players:GetPlayers())
			and (not matchActions[action] or matchReady) and (action ~= "GiveCurrency" or not matchReady)
	end
	local playerList = {}
	for _, player in ipairs(Players:GetPlayers()) do table.insert(playerList, {userId=player.UserId, name=player.Name, displayName=player.DisplayName}) end
	table.sort(playerList, function(a,b) return a.name:lower() < b.name:lower() end)
	table.insert(warnings, Audit.Status())
	if studio then table.insert(warnings, "STUDIO: all commands unlocked; profile changes use session-only mock data. Bans and universe announcements are simulated.") end
	if role == "Developer" or role == "Keonroot" then table.insert(warnings, "Self only. Shared match controls require a solo server.") end
	return {ok=true, role=role, studio=studio, placeKind=matchReady and "Match" or "Lobby", capabilities=capabilities, catalog=catalog, players=playerList, warnings=warnings, audit=Audit.Read(actor, role, studio)}
end
local function handle(actor, payload)
	local role = roleFor(actor)
	if role == "None" then
		if not lastDenial[actor] or os.clock()-lastDenial[actor]>5 then
			lastDenial[actor] = os.clock()
			Audit.Record(actor, role, "Access", actor.UserId, "denied", "Unprivileged remote request")
		end
		return fail("You do not have admin access.")
	end
	if type(payload) ~= "table" or type(payload.action) ~= "string" or #payload.action > 32 then return fail("Malformed request.") end
	local action = payload.action
	if action == "Snapshot" then return snapshot(actor, role) end
	if action == "Inventory" then
		local target, id = targetFor(actor, action, payload.targetUserId)
		authorize(actor, role, "TowerLevel", id)
		return {ok=true, towers=Persistent.Inventory(target)}
	end
	if action == "Confirm" then
		local intent = pending[actor]
		pending[actor] = nil -- Single-use even when confirmation fails.
		if not intent or type(payload.token) ~= "string" or intent.token ~= payload.token or os.clock() > intent.expires then return fail("Confirmation expired. Open the action again.") end
		local target, id = targetFor(actor, intent.action, intent.targetId)
		return run(actor, role, intent.action, target, id, intent.args)
	end
	if action == "Cancel" then
		local intent = pending[actor]
		if intent and type(payload.token) == "string" and intent.token == payload.token then pending[actor] = nil end
		return {ok=true, message="Action cancelled."}
	end
	if action == "Prepare" then
		local command = payload.command
		if not dangerous[command] then return fail("This command does not use confirmation.") end
		local args = cleanArgs(payload.args)
		local target, id = targetFor(actor, command, payload.targetUserId)
		authorize(actor, role, command, id)
		if command ~= "ResetData" then reasonFor(args) end
		if command == "Ban" and (not finite(args.duration) or args.duration % 1 ~= 0 or (args.duration ~= -1 and (args.duration < 60 or args.duration > 31536000))) then return fail("Enter a valid ban duration in seconds.") end
		local targetLabel = target and (target.DisplayName .. " (@" .. target.Name .. ")") or ("User " .. id)
		local titles = {Ban="Ban player?", Kick="Kick player?", Unban="Unban player?", ResetData="Reset player data?"}
		local summary = "Target: " .. targetLabel
		if args.reason then summary ..= "\nReason: " .. args.reason end
		if command == "Ban" then
			local duration
			if args.duration == -1 then duration = "Permanent"
			elseif args.duration % 86400 == 0 then duration = (args.duration / 86400) .. " day(s)"
			elseif args.duration % 3600 == 0 then duration = (args.duration / 3600) .. " hour(s)"
			elseif args.duration % 60 == 0 then duration = (args.duration / 60) .. " minute(s)"
			else duration = args.duration .. " seconds" end
			summary ..= "\nDuration: " .. duration
		end
		if command == "ResetData" then summary ..= studio and "\nResets this Studio session's profile." or "\nResets saved progress and disconnects the target." end
		local token = HttpService:GenerateGUID(false)
		pending[actor] = {token=token, action=command, targetId=id, args=args, expires=os.clock()+Config.ConfirmationSeconds}
		Audit.Record(actor, role, command, id, "prepared", summary)
		return {ok=true, token=token, title=titles[command], summary=summary}
	end
	if dangerous[action] then return fail("Prepare and confirm this action first.") end
	local args = cleanArgs(payload.args)
	local target, id = targetFor(actor, action, payload.targetUserId)
	return run(actor, role, action, target, id, args)
end
request.OnServerInvoke = function(actor, payload)
	if not consume(actor) then
		if not lastDenial[actor] or os.clock()-lastDenial[actor]>5 then
			lastDenial[actor] = os.clock()
			Audit.Record(actor, roles[actor] and roles[actor].role or "Unknown", "RateLimit", actor.UserId, "denied", "Remote request flood blocked")
		end
		return fail("Too many requests. Please wait a moment.")
	end
	if busy[actor] then return fail("Your previous command is still running.") end
	busy[actor] = true
	local ok, result = pcall(handle, actor, payload)
	busy[actor] = nil
	if not ok then return fail(tostring(result):sub(1, 350)) end
	return result
end
Players.PlayerRemoving:Connect(function(player)
	roles[player]=nil; buckets[player]=nil; busy[player]=nil; pending[player]=nil; lastDenial[player]=nil; commandTimes[player]=nil
end)
print("[ETD Admin] Ready · " .. (Match.Available() and "In Game" or "Lobby") .. (studio and " · Studio full access" or " · server permissions enforced"))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="641">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Server-only settings. Never move this module into ReplicatedStorage.
return {
	StudioFullAccess = true,
	-- Studio never sends Discord webhooks or calls Roblox's persistent ban API.
	WebhookUrl = "https://discord.com/api/webhooks/1507585620757975131/CKuar5nPeDA6fjsYKvP0W8_Dv9a25oJ8ahnhzsPc0gVtSRRWgpGI6x_AdRaJNiqoxlom",
	WebhookEnabledInStudio = false,
	GroupId = 486359985,
	-- Exact numeric group ranks; leave empty until your roles exist.
	GroupRankRoles = {}, -- [255] = "Owner", [200] = "Head developer"
	-- Exact group role names; the pictured HeadOwner role has Owner permissions.
	GroupNameRoles = {
		KeonRoot = "Keonroot", Keonroot = "Keonroot",
		Admin = "Admin", Developer = "Developer",
		HeadDeveloper = "Head developer", ["Head developer"] = "Head developer",
		HeadOwner = "Owner", Owner = "Owner",
	},
	UserRoles = {}, -- [123456789] = "Developer" (use immutable UserIds)
	OwnerUserIds = {7092748279}, -- EvanforsaIe: full access,
	AnnouncementTopic = "ETD_Admin_Announcement_v1",
	AuditCapacity = 100,
	ConfirmationSeconds = 30,
	RequestBurst = 12,
	RequestsPerSecond = 3,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="642">
        <Properties>
          <string name="Name">Match</string>
          <string name="Source"><![CDATA[-- Server-only bridge to Eternal Tower Defense's existing match services.
-- Permission checks belong to the admin server before calling Perform.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Match = {}
local MAX_ACTIVE_ENEMIES = 300
local MAX_ACTIVE_UNITS = 150
local MAX_OWNED_ADMIN_UNITS = 50

local function find(root, ...)
	local current = root
	for _, name in { ... } do
		current = current and current:FindFirstChild(name)
	end
	return current
end

function Match.Available()
	return find(ServerScriptService, "Server", "Services", "Entities", "EnemyService") ~= nil
		and find(ServerScriptService, "Server", "Services", "Entities", "UnitService") ~= nil
		and find(ReplicatedStorage, "Shared", "Services", "System", "EconomyService") ~= nil
end

local function sortedNames(data)
	local names = {}
	for name in pairs(data.ByName or {}) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

function Match.Catalog()
	if not Match.Available() then
		return { units = {}, enemies = {} }
	end
	local data = assert(find(ReplicatedStorage, "Settings", "Data"), "Match catalogs are unavailable.")
	return {
		units = sortedNames(require(data.UnitData)),
		enemies = sortedNames(require(data.EnemyData)),
	}
end

local function number(value, name, minimum, maximum, integer)
	assert(type(value) == "number" and value == value and math.abs(value) < math.huge,
		name .. " must be a finite number.")
	assert(value >= minimum and value <= maximum,
		string.format("%s must be between %s and %s.", name, minimum, maximum))
	assert(not integer or value % 1 == 0, name .. " must be a whole number.")
	return value
end

local function service(name)
	local module = assert(find(ReplicatedStorage, "Shared", "Modules", "Core", "ServiceRegistry"),
		"Game services are unavailable in this place.")
	local registry = require(module)
	local value = registry._services[name]
	assert(registry._isStarted and value, "Game services are still starting. Try again shortly.")
	return value
end

local function readyPath()
	local gameService = service("GameService")
	local map = workspace:FindFirstChild("Map")
	assert(gameService.IsMapLoaded and map and map:GetAttribute("GameplayReady") == true,
		"Wait for the match map to finish loading.")
	local paths = require(ReplicatedStorage.Shared.Modules.Core.GetPath)
	assert(paths.CachedPath and paths.Paths[1], "The match route is not ready.")
	return paths
end

local function livePlayer(player)
	assert(typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players,
		"Select a player who is in this server.")
end

local function countEntries(entries)
	local count = 0
	for _ in pairs(entries) do count += 1 end
	return count
end

local function validEntity(kind, name)
	assert(type(name) == "string" and #name > 0 and #name <= 80, "Select a valid " .. kind .. ".")
	local moduleName = kind == "enemy" and "EnemyData" or "UnitData"
	local data = require(ReplicatedStorage.Settings.Data[moduleName])
	assert(data.ByName[name], "Unknown " .. kind .. ": " .. name)
	local assetFolder = kind == "enemy" and "Enemies" or "Units"
	local model = find(ReplicatedStorage, "Assets", assetFolder, name)
	assert(model and model:IsA("Model") and model.PrimaryPart,
		"This " .. kind .. " has no usable model: " .. name)
	return name
end

local function virtualSummoner(owner)
	local Signal = require(ReplicatedStorage.Packages.Signal)
	local events = {}
	local summoner = {
		Id = 0, -- Real tower registry IDs start at 1; clients accept an absent summoner.
		Owner = owner,
		Stats = {},
		IsAdminSummoner = true,
	}
	function summoner:GetEvent(name)
		if not events[name] then events[name] = Signal.new() end
		return events[name]
	end
	function summoner:Destroy()
		self.IsDestroyed = true
		for _, event in pairs(events) do event:Destroy() end
		table.clear(events)
	end
	return summoner
end

function Match.Perform(action, actor, target, args)
	assert(Match.Available(), "In-game controls are available in the In Game place.")
	assert(type(args) == "table", "Missing command arguments.")
	livePlayer(actor)

	if action == "Money" then
		livePlayer(target)
		local amount = number(args.amount, "Money", 0, 1_000_000_000, true)
		local economy = service("EconomyService")
		assert(economy.GetCash(target) ~= nil, "This player's match cash is still loading.")
		economy.SetCash(target, amount)
		return string.format("Set %s's match money to %s.", target.Name, amount)
	elseif action == "GameSpeed" then
		readyPath()
		local speed = number(args.speed, "Game speed", 0.25, 5, false)
		-- Existing network packets encode speed * 10 as an integer. Keep both sides in sync.
		speed = math.round(speed * 10) / 10
		service("TimeService"):SetGameSpeed(speed)
		return string.format("Set server game speed to %.1fx.", speed)
	elseif action == "SpawnEnemy" then
		readyPath()
		local name = validEntity("enemy", args.enemyId)
		local amount = number(args.count or 1, "Spawn count", 1, 25, true)
		local enemies = service("EnemyService")
		assert(countEntries(enemies.GetAll()) + amount <= MAX_ACTIVE_ENEMIES,
			"The server already has too many active enemies. Wait for some to despawn.")
		-- An explicit route guarantees count means total enemies, even on multi-route maps.
		for _ = 1, amount do
			enemies.SetupNewEnemy(name, false, 0, 1)
		end
		return string.format("Spawned %d %s on route 1.", amount, name)
	elseif action == "SpawnUnit" then
		livePlayer(target)
		readyPath()
		local name = validEntity("unit", args.unitId or args.towerId)
		local amount = number(args.count or 1, "Spawn count", 1, 25, true)
		local units = service("UnitService")
		local active = units.GetAll()
		assert(countEntries(active) + amount <= MAX_ACTIVE_UNITS,
			"The server already has too many active allied units. Wait for some to despawn.")
		local owned = 0
		for _, unit in pairs(active) do
			local summoner = unit.Summoner
			if summoner and summoner.IsAdminSummoner and summoner.Owner == target then owned += 1 end
		end
		assert(owned + amount <= MAX_OWNED_ADMIN_UNITS, "This player already has too many admin-spawned allied units.")
		for _ = 1, amount do
			local summoner = virtualSummoner(target)
			local ok, unit = pcall(units.Spawn, summoner, name, 1, false)
			if not ok then
				summoner:Destroy()
				error(unit, 0)
			end
			unit.Destroyed:Connect(function()
				task.defer(function() summoner:Destroy() end)
			end)
		end
		return string.format("Spawned %d %s for %s.", amount, name, target.Name)
	end
	error("Unknown in-game action: " .. tostring(action))
end

return Match
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="643">
        <Properties>
          <string name="Name">Persistent</string>
          <string name="Source"><![CDATA[-- Server-only bridge to the existing profile services in both places.
-- Authorization and per-target request serialization belong to the admin server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Registry = require(ReplicatedStorage.Shared.Modules.Core.ServiceRegistry)
local Constants = require(ReplicatedStorage.Settings.Data.DataConstants)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local ItemData = require(ReplicatedStorage.Settings.Data.ItemData)
local TraitData = require(ReplicatedStorage.Settings.Data.TraitData)

local Persistent = {}
local MAX_ITEM_GRANT = 1000000
local MAX_ITEM_TOTAL = 1000000000
local CURRENCIES = {Coins=true, Gems=true, Blossom=true}
local MAX_CURRENCY_GRANT = 1000000
local MAX_CURRENCY_TOTAL = 1000000000
local MAX_TOWER_GRANT = 50
local MAX_OWNED_TOWERS = 2000
local MAX_TOWER_ID = 4294967294

local function integer(value, low, high, label)
	assert(type(value) == "number" and value == value and value > -math.huge and value < math.huge,
		label .. " must be a finite number.")
	assert(value % 1 == 0 and value >= low and value <= high,
		label .. " must be an integer from " .. low .. " to " .. high .. ".")
	return value
end

local function identifier(value, catalog, label)
	assert(type(value) == "string" and #value > 0 and #value <= 160 and catalog[value] ~= nil,
		"Select a valid " .. label .. " from the catalog.")
	return value
end

local function sortedKeys(dictionary)
	local result = {}
	for name in pairs(dictionary) do
		if type(name) == "string" then
			table.insert(result, name)
		end
	end
	table.sort(result)
	return result
end

local function context(target, writing)
	assert(typeof(target) == "Instance" and target:IsA("Player") and target.Parent == Players,
		"The target player is no longer in this server.")
	local dataService = Registry:GetService("DataService")
	if writing and RunService:IsStudio() then
		assert(dataService.AdminStudioSandbox == true,
			"Studio profile sandbox is not enabled. Persistent actions are blocked until the mock profile store is configured.")
	end
	local profile = dataService:GetProfile(target)
	assert(profile and profile:IsActive() and type(profile.Data) == "table", "The target profile has not loaded yet.")
	assert(target.Parent == Players, "The target player left the server.")
	local data = profile.Data
	assert(type(data.OwnedTowers) == "table" and type(data.Inventory) == "table" and type(data.Inventory.Items) == "table",
		"The target profile has an unsupported inventory schema.")
	return dataService, data
end

local function findOwned(data, unitId)
	assert(type(unitId) == "string" and #unitId <= 32 and unitId:match("^t_%d+$"),
		"Select a tower instance from the target inventory.")
	local foundName, foundTower
	for name, copies in pairs(data.OwnedTowers) do
		if type(copies) == "table" and copies[unitId] then
			assert(foundTower == nil, "The profile contains a duplicate tower identifier.")
			foundName, foundTower = name, copies[unitId]
		end
	end
	assert(foundName and type(foundTower) == "table" and TowerData.ByName[foundName],
		"The selected tower is not owned by this player or is no longer in the catalog.")
	return foundName, foundTower
end

local function ownedCount(data)
	local count = 0
	for _, copies in pairs(data.OwnedTowers) do
		if type(copies) == "table" then
			for _ in pairs(copies) do count += 1 end
		end
	end
	return count
end

function Persistent.Catalog()
	return {
		towers = sortedKeys(TowerData.ByName),
		items = sortedKeys(ItemData.ByName),
		traits = sortedKeys(TraitData.ByName),
		currencies = sortedKeys(CURRENCIES),
		maxCurrencyGrant = MAX_CURRENCY_GRANT,
		maxTowerLevel = Constants.MAX_TOWER_LEVEL or 30,
		maxOwnedTowers = MAX_OWNED_TOWERS,
	}
end

function Persistent.Inventory(player)
	local _, data = context(player, false)
	local result = {}
	for name, copies in pairs(data.OwnedTowers) do
		if type(copies) == "table" and TowerData.ByName[name] then
			for key, tower in pairs(copies) do
				if type(key) == "string" and type(tower) == "table" then
					table.insert(result, {
						id = key,
						name = name,
						level = tower.Lv or 0,
						trait = tower.Trait or "None",
					})
				end
			end
		end
	end
	table.sort(result, function(a, b)
		if a.name == b.name then return a.id < b.id end
		return a.name < b.name
	end)
	return result
end

function Persistent.Perform(action, _actor, target, args)
	assert(type(args) == "table", "Action arguments are required.")
	assert(action == "GiveCurrency" or action == "GiveItem" or action == "GiveTower" or action == "TowerLevel" or action == "Trait" or action == "ResetData",
		"Unknown persistent action.")
	local service, data = context(target, true)
	local message
	if action == "GiveCurrency" then
		local currencyId = identifier(args.currencyId, CURRENCIES, "currency")
		local amount = integer(args.amount, 1, MAX_CURRENCY_GRANT, "Currency amount")
		local current = integer(data[currencyId], 0, MAX_CURRENCY_TOTAL, "Current currency balance")
		assert(current + amount <= MAX_CURRENCY_TOTAL, "The currency balance would exceed the limit.")
		local balance = service:AddData(target, currencyId, amount)
		assert(balance == current + amount, "The currency grant could not be applied.")
		message = ("Granted %d %s to %s. Balance: %d."):format(amount, currencyId, target.Name, balance)
	elseif action == "GiveItem" then
		local itemId = identifier(args.itemId, ItemData.ByName, "item")
		local amount = integer(args.amount, 1, MAX_ITEM_GRANT, "Amount")
		local current = integer(data.Inventory.Items[itemId] or 0, 0, MAX_ITEM_TOTAL, "Current item count")
		assert(current + amount <= MAX_ITEM_TOTAL, "The item total would exceed the inventory limit.")
		service:AddData(target, "Inventory", amount, "Items", itemId)
		message = ("Granted %d × %s to %s."):format(amount, itemId, target.Name)
	elseif action == "GiveTower" then
		local towerId = identifier(args.towerId, TowerData.ByName, "tower")
		local count = integer(args.count, 1, MAX_TOWER_GRANT, "Tower count")
		assert(ownedCount(data) + count <= MAX_OWNED_TOWERS, "The target inventory is full (2,000 towers).")
		local nextId = integer(data._NextId, 1, MAX_TOWER_ID - count, "Next tower ID")
		for _, copies in pairs(data.OwnedTowers) do
			if type(copies) == "table" then
				for id = nextId, nextId + count - 1 do
					assert(copies["t_" .. id] == nil, "The profile tower ID counter needs repair.")
				end
			end
		end
		for _ = 1, count do service:AddTower(target, towerId) end
		message = ("Granted %d × %s to %s."):format(count, towerId, target.Name)
	elseif action == "TowerLevel" then
		local level = integer(args.level, 0, Constants.MAX_TOWER_LEVEL or 30, "Tower level")
		local name, tower = findOwned(data, args.unitId)
		local previousLevel = tower.Lv or 0
		service:UpdateData(target, "OwnedTowers", level, name, args.unitId, "Lv")
		service:UpdateData(target, "OwnedTowers", 0, name, args.unitId, "Exp")
		service:FireChanged(target, "TowerExpChanged", {
			TowerName = name, TowerKey = args.unitId, Exp = 0,
			Level = level, HasLevelUp = level > previousLevel,
		})
		message = ("Set %s (%s) to level %d."):format(name, args.unitId, level)
	elseif action == "Trait" then
		local traitId = identifier(args.traitId, TraitData.ByName, "trait")
		local name = findOwned(data, args.unitId)
		service:AdjustTower(target, name, args.unitId, "Trait", traitId)
		message = ("Set %s (%s) trait to %s."):format(name, args.unitId, traitId)
	else
		-- The admin server must require confirmation before dispatch.
		-- ClearData replaces only profile.Data; the active session lock is preserved.
		-- Mirror removals before re-adding the normal starter inventory.
		local oldTowers = data.OwnedTowers
		service:ClearData(target)
		for name, copies in pairs(oldTowers) do
			if TowerData.ByName[name] and type(copies) == "table" then
				for key in pairs(copies) do
					local numericId = type(key) == "string" and tonumber(key:match("^t_(%d+)$"))
					if numericId then
						service:FireChanged(target, "OwnedTowersRemoved", { towerName = name, towerKeyId = numericId })
					end
				end
			end
		end
		local resetData = service:GetData(target)
		assert(resetData and resetData ~= data, "The profile reset failed.")
		-- Use UpdateData so leaderstats and currency observers refresh too.
		for _, key in ipairs({ "Coins", "Gems", "Blossom", "Level", "Exp", "Quests", "Inventory", "Loadout" }) do
			if resetData[key] ~= nil then service:UpdateData(target, key, resetData[key]) end
		end
		if TowerData.ByName[Constants.STARTER_TOWER] then
			local starterKey = "t_" .. resetData._NextId
			service:AddTower(target, Constants.STARTER_TOWER)
			service:UpdateData(target, "_StarterTowerReceived", true)
			service:UpdateData(target, "Loadout", { Name = Constants.STARTER_TOWER, Key = starterKey }, "1")
		end
		message = ("Reset %s's profile and restored the starter tower. Deployed match towers are unchanged; rejoin for a fresh match."):format(target.Name)
	end
	service:SaveData(target)
	return message
end

return Persistent
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="644">
        <Properties>
          <string name="Name">Policy</string>
          <string name="Source"><![CDATA[-- Pure permission rules, shared by requests and their confirmation step.
local Policy = {}
Policy.Actions = {"SpawnUnit", "SpawnEnemy", "Money", "GameSpeed", "Announce", "Ban", "Kick", "Unban", "GiveItem", "GiveCurrency", "ResetData", "GiveTower", "TowerLevel", "Trait"}
-- Only these exact spellings are accepted; display strings are canonical everywhere else.
local roleAliases = {
	Keonroot="Keonroot", KeonRoot="Keonroot", Admin="Admin", Developer="Developer",
	["Head developer"]="Head developer", HeadDeveloper="Head developer",
	Owner="Owner", HeadOwner="Owner",
}
function Policy.NormalizeRole(role)
	return type(role) == "string" and roleAliases[role] or nil
end
function Policy.ValidRole(role)
	return Policy.NormalizeRole(role) ~= nil
end
function Policy.GroupRole(rank, name, rankRoles, nameRoles)
	if type(rank) ~= "number" or rank ~= rank or rank % 1 ~= 0 or rank < 1 or rank > 255 then return nil end
	if rank == 255 then return "Owner" end
	-- An explicit numeric override takes priority, including invalid entries that fail closed.
	if rankRoles[rank] ~= nil then return Policy.NormalizeRole(rankRoles[rank]) end
	if type(name) == "string" then return Policy.NormalizeRole(nameRoles[name]) end
	return nil
end
function Policy.GroupMembershipRole(membership, rankRoles, nameRoles)
	if type(membership) ~= "table" or membership.IsMember ~= true or type(membership.Roles) ~= "table" then return nil end
	local role, highestRank = nil, -1
	for _, groupRole in ipairs(membership.Roles) do
		if type(groupRole) == "table" then
			local candidate = Policy.GroupRole(groupRole.Rank, groupRole.Name, rankRoles, nameRoles)
			if candidate and groupRole.Rank > highestRank then
				role, highestRank = candidate, groupRole.Rank
			end
		end
	end
	return role
end
local known = {}
for _, action in ipairs(Policy.Actions) do known[action] = true end
local selfActions = {SpawnUnit=true, SpawnEnemy=true, Money=true, GameSpeed=true, GiveItem=true, GiveCurrency=true, ResetData=true, GiveTower=true, TowerLevel=true, Trait=true}
local sharedMatch = {SpawnUnit=true, SpawnEnemy=true, GameSpeed=true}
function Policy.Allowed(role, studio, action, actorId, targetId, playerCount)
	if not known[action] then return false, "Unknown command." end
	role = Policy.NormalizeRole(role)
	if studio or role == "Owner" or role == "Head developer" then return true end
	if role == "Admin" then
		return action == "Ban" or action == "Kick", "Admins can ban and kick only."
	end
	if role == "Developer" or role == "Keonroot" then
		if not selfActions[action] then return false, "This role cannot moderate or announce." end
		if targetId ~= actorId then return false, "Your role can change your own data only." end
		if sharedMatch[action] and playerCount > 1 then
			return false, "Spawns and match speed affect everyone; your role can use them in a solo server only."
		end
		return true
	end
	return false, "You do not have admin access."
end
return Policy
]]></string>
        </Properties>
      </Item>
