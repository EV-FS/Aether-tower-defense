                <string name="Source">return {
	package = {
		authors = {"Stephen Leitnick"},
		description = "Trove class for tracking and cleaning up objects",
		license = "MIT",
		name = "sleitnick/trove",
		realm = "shared",
		registry = "https://github.com/UpliftGames/wally-index",
		version = "1.8.0",
	},
}</string>
