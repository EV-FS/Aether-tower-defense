				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = "rbxassetid://76595093118022",
				Position = UDim2.new(0.49878, 0, 0.484331, 4),
				Size = UDim2.fromScale(0.67, 0.60215),

				create("ImageButton")({
					Name = "CancelButton",
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundTransparency = 1,
					Image = "rbxassetid://97669663501555",
					Position = spring(function()
						return if isVisible() then UDim2.fromScale(0.987, 0.04) else UDim2.fromScale(0.987, 0.08)
					end, 0.5, 0.65),
					Size = UDim2.fromScale(0.0455964, 0.0784857),
					ZIndex = 3,

					MouseButton1Click = function()
						isVisible(false)
					end,

					useButtonEffect(),

					create("UIAspectRatioConstraint")({}),
				}),

				create("ImageLabel")({
					Name = "Icon",
					BackgroundTransparency = 1,
					Image = "rbxassetid://137286113984807",
					ImageTransparency = spring(function()
						return if isVisible() then 0 else 1
					end, 0.5, 1),

					Position = spring(function()
						return if isVisible()
							then UDim2.fromScale(0.0184762, 0.0549331)
							else UDim2.fromScale(0, 0.0549331)
					end, 0.5, 1),
					Size = UDim2.fromScale(0.0739609, 0.110878),

					create("UIAspectRatioConstraint")({}),
				}),

				create("TextLabel")({
					Name = "Title",
					BackgroundTransparency = 1,
					FontFace = Font.new(
						"rbxasset://fonts/families/SourceSansPro.json",
						Enum.FontWeight.Bold,
						Enum.FontStyle.Normal
					),
					Rotation = spring(function()
						return if isVisible() then 0 else -8
					end, 0.5, 0.45),
					Position = spring(function()
						return if isVisible() then UDim2.fromScale(0.09, 0.0607155) else UDim2.fromScale(0, 0.0607155)
					end, 0.5, 1),
					Size = UDim2.fromScale(0.138753, 0.0954101),
					Text = "Summon",
					TextTransparency = spring(function()
						return if isVisible() then 0 else 1
					end, 0.7, 1),

					TextColor3 = Color3.fromRGB(214, 207, 150),
					TextScaled = true,
				}),

				create("Frame")({
					Name = "LeftFrame",
					Position = UDim2.fromScale(0.011, 0.197),
					Size = UDim2.fromScale(0.236, 0.575),

					BackgroundTransparency = 1,

					create("ImageLabel")({
						Image = "rbxassetid://127755102717021",
						Size = UDim2.fromScale(1, 1),
						BackgroundTransparency = 1,
					}),

					create("ScrollingFrame")({
						Name = "Category",
						Active = true,
						AnchorPoint = Vector2.new(0.5, 0.5),
						BackgroundTransparency = 1,
						Position = spring(function()
							return if isVisible() then UDim2.fromScale(0.5, 0.5) else UDim2.fromScale(0.4, 0.5)
						end, 0.5, 1),
						ScrollBarThickness = 0,
						Size = UDim2.fromScale(1, 1),

						create("ImageButton")({
							Name = "BestCategory",
							BackgroundTransparency = 1,
							Image = "rbxassetid://133178243441481",
							ImageTransparency = spring(function()
								return if isVisible() then 0 else 1
							end, 0.5, 1),

							Size = UDim2.fromScale(1, 0.09),

							create("ImageLabel")({
								Name = "Icon",
								BackgroundTransparency = 1,
								Image = "rbxassetid://76397723941177",
								Position = UDim2.fromScale(0.0737704, 0.183541),
								Size = UDim2.fromScale(0.197095, 0.704737),

								create("UIGradient")({
