          <Item class="ModuleScript" referent="626">
            <Properties>
              <string name="Name">NumberUtils</string>
              <string name="Source"><![CDATA[local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

local NumberUtils = {}

function NumberUtils.FormatComma(num: number): string
	local str = tostring(num)
	local integer, decimal = str:match("^(%-?%d+)(%.?%d*)$")

	if not integer then
		return str
	end

	integer = integer:reverse():gsub("(%d%d%d)", "%1,"):gsub(",$", ""):reverse()

	return integer .. decimal
end

function NumberUtils.Abbreviate(num: number, decimalPlaces: number?): string
	local dp = decimalPlaces or 1
	local absNum = math.abs(num)
	local isNegative = num < 0

	if absNum < 1000 then
		return tostring(math.floor(num + 0.5))
	end

	local index = math.floor(math.log10(absNum) / 3)
	local suffix = SUFFIXES[math.min(index + 1, #SUFFIXES)]
	local value = absNum / (10 ^ (index * 3))

	local formatStr = "%." .. dp .. "f%s"
	local result = string.format(formatStr, value, suffix):gsub("%.0+$", "")

	return (isNegative and "-" or "") .. result
end

function NumberUtils.FormatTime(seconds: number): string
	local mins = math.floor(seconds / 60)
	local secs = math.floor(seconds % 60)
	return string.format("%02d:%02d", mins, secs)
end

function NumberUtils.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

return NumberUtils
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="627">
            <Properties>
              <string name="Name">ResolveSoundAsset</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Recipe paths are relative to ReplicatedStorage.Assets.SFX.
local function ResolveSoundAsset(soundPath: string): Sound?
	if soundPath == "" then
		return nil
	end

	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local current: Instance? = assets and assets:FindFirstChild("SFX")

	for name in string.gmatch(soundPath, "[^/]+") do
		current = current and current:FindFirstChild(name)
		if not current then
			return nil
		end
	end

	return if current and current:IsA("Sound") then current else nil
end

return ResolveSoundAsset
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="628">
            <Properties>
              <string name="Name">TableUtils</string>
              <string name="Source"><![CDATA[local DeepCopy = require(script.Tools.DeepCopy)
local DeepFreeze = require(script.Tools.DeepFreeze)
local DictionaryLength = require(script.Tools.DictionaryLength)
local DictionaryRandom = require(script.Tools.DictionaryRandom)
local TableUtils = {}

function TableUtils.DeepCopy<T>(newTable): T
	return DeepCopy(newTable)
end

function TableUtils.DeepFreeze<T>(newTable): T
	return DeepFreeze(newTable)
end

function TableUtils.Length(countTable): number
	return DictionaryLength(countTable)
end

function TableUtils.Random(randomTable): (any, any)
	return DictionaryRandom(randomTable)
end

return TableUtils
]]></string>
            </Properties>
            <Item class="Folder" referent="629">
              <Properties>
                <string name="Name">Tools</string>
              </Properties>
              <Item class="ModuleScript" referent="630">
                <Properties>
                  <string name="Name">DeepCopy</string>
                  <string name="Source"><![CDATA[return function<T>(original): T
	if type(original) ~= "table" then
		return original
	end

	local function recurse(value)
		if type(value) ~= "table" then
			return value
		end

		local newTable = {}

		for key, val in pairs(value) do
			local newKey = recurse(key)
			local newVal = recurse(val)
			newTable[newKey] = newVal
		end

		return newTable
	end

	return recurse(original)
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="631">
                <Properties>
                  <string name="Name">DeepFreeze</string>
                  <string name="Source"><![CDATA[return function<T>(tbl): T
	if typeof(tbl) ~= "table" then
		return tbl
	end

	local function recurse(value)
		if typeof(value) ~= "table" or table.isfrozen(value) then
			return value
		end

		for _, val in pairs(value) do
			recurse(val)
		end

		return table.freeze(value)
	end

	return recurse(tbl)
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="632">
                <Properties>
                  <string name="Name">DictionaryLength</string>
                  <string name="Source"><![CDATA[return function(countTable): number
	local count = 0
	for _ in pairs(countTable) do
		count += 1
	end

	return count
end
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="633">
                <Properties>
                  <string name="Name">DictionaryRandom</string>
                  <string name="Source"><![CDATA[local RANDOM = Random.new()

return function(randomTable): (any, any)
	local length = 0
	for _ in pairs(randomTable) do
		length += 1
	end

	local randomIndex = RANDOM:NextInteger(1, length)
	local count = 1
	for idx, val in pairs(randomTable) do
		if randomIndex == count then
			return idx, val
		end
	end

	return nil
end
]]></string>
                </Properties>
