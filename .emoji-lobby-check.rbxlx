          <Item class="ModuleScript" referent="471">
            <Properties>
              <string name="Name">Loader</string>
              <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Components = require(ReplicatedStorage.Shared.Components)

local registered = {}
local addedConnection

local function registerLeaf(world, leaf)
	if registered[leaf] then
		return
	end
	registered[leaf] = true

	world:spawn(Components.Leaf({
		LeafModel = leaf,
	}))
end

return function(world)
	if not addedConnection then
		addedConnection = CollectionService:GetInstanceAddedSignal("Leaf"):Connect(function(leaf)
			registerLeaf(world, leaf)
		end)
	end

	for _, leaf in CollectionService:GetTagged("Leaf") do
		registerLeaf(world, leaf)
	end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="472">
            <Properties>
              <string name="Name">System</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

--/Modules
local Matter = require(ReplicatedStorage.Packages.Matter)
local Components = require(ReplicatedStorage.Shared.Components)

--/Constants
local MAX_DISTANCE = 150
local MAX_DISTANCE_SQ = MAX_DISTANCE * MAX_DISTANCE

local UPDATE_RATE = 1 / 45

local COMPUTE_RATE = 1 / 30

local WIND_DIRECTION = Vector3.new(0.7, 0, 0.4).Unit
local WIND_SPEED = 20
local WIND_POWER = 0.5

local FOLLOW_SPEED = 16

local DEFAULT_SWAY_MULTIPLIER = 1

--/Variables
local updateAccumulator = 0
local computeAccumulator = 0
local elapsedTime = 0

local partsToMove = {}
local cframesToMove = {}

type LeafState = {
	Part: BasePart,

	Origin: CFrame,
	PivotOffset: CFrame,

	Current: CFrame,
	Target: CFrame,

	Seed: number,
	SwayMultiplier: number,

	LastSeenFrame: number,
}

local states: { [number]: LeafState } = {}
local frameId = 0

-------------------------------------------------
--// Local Functions
-------------------------------------------------

local function createLeafState(part: BasePart): LeafState
	local origin = part.CFrame

	return {
		Part = part,

		Origin = origin,
		PivotOffset = part.PivotOffset,

		Current = origin,
		Target = origin,

		Seed = math.random() * 1000,
		SwayMultiplier = part:GetAttribute("SwayMultiplier") or DEFAULT_SWAY_MULTIPLIER,

		LastSeenFrame = frameId,
	}
end

local function computeTarget(state: LeafState)
	local part = state.Part

	state.PivotOffset = part.PivotOffset
	state.SwayMultiplier = part:GetAttribute("SwayMultiplier") or DEFAULT_SWAY_MULTIPLIER

	local origin = state.Origin
	local pivotOffset = state.PivotOffset
	local seed = state.Seed
	local multiplier = state.SwayMultiplier

	local frequency = elapsedTime * (WIND_SPEED * 0.08)
	local amplitude = WIND_POWER * 0.1 * multiplier

	local rotationX = math.noise(frequency, seed, 0) * amplitude
	local rotationY = math.noise(frequency, 0, seed) * amplitude * 0.35
	local rotationZ = math.noise(frequency, seed, seed) * amplitude

	local windNoise = 0.5 + math.noise(frequency * 0.7, seed, -seed)
	local windOffset = WIND_DIRECTION * windNoise * amplitude

	local worldPivot = origin * pivotOffset

	state.Target = (worldPivot * CFrame.Angles(rotationX, rotationY, rotationZ) + windOffset) * pivotOffset:Inverse()
end

local function cleanupUnusedStates()
	for id, state in states do
		if state.LastSeenFrame ~= frameId then
			states[id] = nil
		end
	end
end

-------------------------------------------------
--// System
-------------------------------------------------

return function(world)
	local dt = Matter.useDeltaTime()

	elapsedTime += dt
	updateAccumulator += dt
	computeAccumulator += dt

	if updateAccumulator < UPDATE_RATE then
		return
	end

	local updateDt = updateAccumulator
	updateAccumulator %= UPDATE_RATE

	local shouldCompute = computeAccumulator >= COMPUTE_RATE

	if shouldCompute then
		computeAccumulator %= COMPUTE_RATE
	end

	frameId += 1

	local camera = Workspace.CurrentCamera
	local cameraPosition = camera and camera.CFrame.Position

	local followAlpha = math.min(1, updateDt * FOLLOW_SPEED)

	for id, leaf in world:query(Components.Leaf) do
		local part = leaf.LeafModel

		if not part or not part:IsA("BasePart") or not part.Parent then
			states[id] = nil
			continue
		end

		local state = states[id]

		if not state or state.Part ~= part then
			state = createLeafState(part)
			states[id] = state
		end

		state.LastSeenFrame = frameId

		local originPosition = state.Origin.Position

		if cameraPosition then
			local offset = originPosition - cameraPosition
			local distanceSq = offset:Dot(offset)

			if distanceSq > MAX_DISTANCE_SQ then
				continue
			end
		end

		if shouldCompute then
			computeTarget(state)
		end

		state.Current = state.Current:Lerp(state.Target, followAlpha)

		table.insert(partsToMove, part)
		table.insert(cframesToMove, state.Current)
	end

	cleanupUnusedStates()

	if #partsToMove > 0 then
		Workspace:BulkMoveTo(partsToMove, cframesToMove, Enum.BulkMoveMode.FireCFrameChanged)

		table.clear(partsToMove)
		table.clear(cframesToMove)
	end
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="473">
          <Properties>
            <string name="Name">Mover</string>
            <string name="Source"><![CDATA[local Loader = require(script.Loader)
local System = require(script.System)

return {
    ["Loader"] = Loader,
    ["System"] = System,
}
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="474">
            <Properties>
              <string name="Name">Loader</string>
              <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Components = require(ReplicatedStorage.Shared.Components)

return function(world)
    local entities = {}

    local function onAdded(instance)
        local startPos = instance:GetAttribute("StartPosition") or (instance:IsA("Model") and instance:GetPivot().Position or instance.Position)
        local endPos = instance:GetAttribute("EndPosition") or (startPos + Vector3.new(0, 10, 0))
        local speed = instance:GetAttribute("Speed") or 5

        local id = world:spawn(Components.Mover({
            TargetPart = instance,
            StartPosition = startPos,
            EndPosition = endPos,
            Speed = speed,
            Progress = 0,
            Direction = 1,
        }))
        entities[instance] = id
    end

    local function onRemoved(instance)
        if entities[instance] then
            world:despawn(entities[instance])
            entities[instance] = nil
        end
    end

    CollectionService:GetInstanceAddedSignal("Mover"):Connect(onAdded)
    CollectionService:GetInstanceRemovedSignal("Mover"):Connect(onRemoved)

    for _, instance in ipairs(CollectionService:GetTagged("Mover")) do
        onAdded(instance)
    end
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="475">
            <Properties>
              <string name="Name">System</string>
              <string name="Source"><![CDATA[--/Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

--/Modules
local Matter = require(ReplicatedStorage.Packages.Matter)
local Components = require(ReplicatedStorage.Shared.Components)

return function(world)
	local dt = Matter.useDeltaTime()
	local time = os.clock()

	for id, mover in world:query(Components.Mover) do
		local part = mover.TargetPart
		
		-- Smooth sine-based movement
		local newProgress = (math.sin(time * mover.Speed * 0.5) + 1) / 2
		
		-- Calculate Position (Lerp + Small sine bob)
		local basePosition = mover.StartPosition:Lerp(mover.EndPosition, newProgress)
		local bob = Vector3.new(0, math.sin(time * 2) * 0.5, 0)
		local newPosition = basePosition + bob
		
		-- Apply transformation
		if part:IsA("Model") then
			local pivot = part:GetPivot()
			part:PivotTo(CFrame.new(newPosition) * (pivot - pivot.Position))
		else
			part.CFrame = CFrame.new(newPosition) * (part.CFrame - part.CFrame.Position)
		end
	end
end
]]></string>
