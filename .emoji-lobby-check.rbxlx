        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ModalOverlay</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local spring = Vide.spring

export type Props = {
	Name: string,
	Title: string,
	IsOpen: () -> boolean,
	OnClose: () -> (),
	Content: GuiObject,
}

return function(props: Props)
	return create("Frame")({
		Name = props.Name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = props.IsOpen,
		ZIndex = 20,

		create("TextButton")({
			Name = "Backdrop",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(7, 12, 22),
			BackgroundTransparency = spring(function()
				return if props.IsOpen() then 0.35 else 1
			end, 0.2, 0.9),
			Size = UDim2.fromScale(1, 1),
			Text = "",
			ZIndex = 20,

			Activated = props.OnClose,
		}),

		create("TextLabel")({
			Name = "Title",
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			FontFace = Font.fromEnum(Enum.Font.GothamBold),
			Position = spring(function()
				return if props.IsOpen() then UDim2.fromScale(0.5, 0.12) else UDim2.fromScale(0.5, 0.15)
			end, 0.4, 0.6),
			Size = UDim2.fromScale(0.4, 0.05),
			Text = props.Title,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			ZIndex = 31,

			create("UIStroke")({
				StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
				Thickness = 0.08,
			}),
		}),

		create("Frame")({
			Name = "Content",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),

			Rotation = spring(function()
				return if props.IsOpen() then 0 else -90
			end, 0.6, 0.75),

			Size = spring(function()
				return if props.IsOpen() then UDim2.fromScale(1, 1) else UDim2.fromScale(0, 0)
			end, 0.6, 0.75),

			ZIndex = 30,

			props.Content,
		}),
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PortraitCamera</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

-- One connection for visible portraits; callbacks use cached body parts only.
local updates = {}
local connection: RBXScriptConnection? = nil
local PortraitCamera = {}

function PortraitCamera.FindPart(model: Model, name: string): BasePart?
	local direct = model:FindFirstChild(name)
	if direct and direct:IsA("BasePart") then
		return direct
	end
	for _, part in model:GetDescendants() do
		if part.Name == name and part:IsA("BasePart")
			and not part:FindFirstAncestorWhichIsA("Accessory")
			and not part:FindFirstAncestorWhichIsA("Tool") then
			return part
		end
	end
	return nil
end

function PortraitCamera.Track(model: Model, frame: ViewportFrame, camera: Camera, options)
	local head = PortraitCamera.FindPart(model, "Head")
	if not head then
		return nil
	end
	local torso = PortraitCamera.FindPart(model, "UpperTorso")
		or PortraitCamera.FindPart(model, "Torso")
		or PortraitCamera.FindPart(model, "HumanoidRootPart")
	local lowerTorso = PortraitCamera.FindPart(model, "LowerTorso")
	local torsoHeight = if torso then torso.Size.Y else head.Size.Y * 2
	if lowerTorso then
		torsoHeight += lowerTorso.Size.Y
	end
	-- Dimensions, not the authored pose, establish a stable bust scale.
	local height = math.max(head.Size.Y + torsoHeight, 0.1) * options.Padding
	local width = math.max(head.Size.X, if torso then torso.Size.X * 1.5 else head.Size.X)
	local depth = math.max(head.Size.Magnitude, if torso then torso.Size.Magnitude else 0) * 0.5
	local direction = options.Direction
	direction = if direction.Magnitude > 0 then direction.Unit else Vector3.new(0, 0, -1)
	local orientation = CFrame.lookAt(Vector3.zero, -direction)
	local tangent = math.tan(math.rad(options.FieldOfView) * 0.5)
	local updateInterval = math.max(options.UpdateInterval or 0, 0)
	local nextUpdate = 0
	local function update(now: number?)
		if now and now < nextUpdate then
			return
		end
		if now then
			nextUpdate = now + updateInterval
		end
		local size = frame.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 or not model.Parent then
			return
		end
		local aspect = size.X / size.Y
		local distance = math.max(height / (2 * tangent), width / (2 * tangent * aspect)) + depth
		-- Keep the face above the rarity/name overlay. Following translation only
		-- preserves the idle's rotation and limb movement without zoom pumping.
		local headDepth = distance
		local focus = head.Position - orientation.UpVector * (headDepth * tangent * 0.5)
			+ orientation.UpVector * options.FocusYOffset
		camera.FieldOfView = options.FieldOfView
		camera.CFrame = CFrame.new(focus + direction * distance) * orientation.Rotation
	end
	update()
	updates[update] = true
	if not connection then
		connection = RunService.Heartbeat:Connect(function()
			local now = os.clock()
			for callback in updates do
				callback(now)
			end
		end)
	end
	return function()
		updates[update] = nil
		if next(updates) == nil and connection then
			connection:Disconnect()
			connection = nil
		end
	end
end

return PortraitCamera
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">QuadrantWheel</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create

export type SlotConfig = {
	Index: number,
	AnchorPoint: Vector2,
	Position: UDim2,
	Image: string,
}

export type Props = {
	Name: string,
	ZIndex: number?,
	RenderSlot: (SlotConfig) -> GuiObject,
}

local SLOT_CONFIGS: { SlotConfig } = {
	{
		Index = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(0.49, 0.49),
		Image = "rbxassetid://74473551495859",
	},
	{
		Index = 2,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0.51, 0.49),
		Image = "rbxassetid://140267716361991",
	},
	{
		Index = 3,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.49, 0.51),
		Image = "rbxassetid://80073985698143",
	},
	{
		Index = 4,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(0.51, 0.51),
		Image = "rbxassetid://125749684762510",
	},
}

return function(props: Props)
	local slots = table.create(#SLOT_CONFIGS)

	for _, slotConfig in ipairs(SLOT_CONFIGS) do
		table.insert(slots, props.RenderSlot(slotConfig))
	end

	return create("Frame")({
		Name = props.Name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.49, 0.49),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		ZIndex = props.ZIndex or 1,

		unpack(slots),
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">RigViewport</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local cleanup = Vide.cleanup
local create = Vide.create
local effect = Vide.effect
local read = Vide.read
local source = Vide.source
local untrack = Vide.untrack

local DEFAULT_CAMERA_DIRECTION = Vector3.new(0, 0, -1)
local DEFAULT_FIELD_OF_VIEW = 35
local DEFAULT_FIT_PADDING = 1.1
local MINIMUM_RADIUS = 0.01

type Reactive<T> = T | (() -> T)

type RigState = {
	Model: Model,
	Center: Vector3,
	Radius: number,
}

export type Props = {
	--GuiObject
	Active: Reactive<boolean>?,
	AnchorPoint: Reactive<Vector2>?,
	BackgroundColor3: Reactive<Color3>?,
	BackgroundTransparency: Reactive<number>?,
	ClipsDescendants: Reactive<boolean>?,
	LayoutOrder: Reactive<number>?,
	Name: Reactive<string>?,
	Position: Reactive<UDim2>?,
	Rotation: Reactive<number>?,
	Size: Reactive<UDim2>?,
	Visible: Reactive<boolean>?,
	ZIndex: Reactive<number>?,

	--ViewportFrame
	Ambient: Reactive<Color3>?,
	ImageColor3: Reactive<Color3>?,
	ImageTransparency: Reactive<number>?,
	LightColor: Reactive<Color3>?,
	LightDirection: Reactive<Vector3>?,

	--RigViewport
	Rig: Reactive<Model?>?,
	CenterOffset: Reactive<Vector3>?,
	FieldOfView: Reactive<number>?,
	CameraDirection: Reactive<Vector3>?,
	FitPadding: Reactive<number>?,
	Zoom: Reactive<number>?,
	RigRotation: Reactive<Vector3>?,
	UseWorldModel: boolean?,
	OnRigChanged: ((Model?) -> ())?,

	--RigAnmation
	Animation: Reactive<Animation?>?,
	AutoPlay: boolean?,
	AnimationLooped: Reactive<boolean>?,
	AnimationSpeed: Reactive<number>?,
	AnimationFadeTime: number?,
	OnTrackChanged: ((AnimationTrack?) -> ())?,
}

-------------------------------------------------
--// Local Functions
-------------------------------------------------
local function prepareRig(model: Model): RigState?
	local root = model:FindFirstChild("HumanoidRootPart", true)
	if not root or not root:IsA("BasePart") then
		warn(`[RigViewport] Rig "{model.Name}" needs a HumanoidRootPart to create a preview.`)
		return nil
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.LocalTransparencyModifier = 0
		end
	end

	-- Frame and rotate around the root only; limbs and accessories may be cropped.
	model.PrimaryPart = root
	root.PivotOffset = CFrame.identity
	root.Anchored = true
	model:PivotTo(CFrame.identity)

	return {
		Model = model,
		Center = root.Position,
		Radius = math.max(root.Size.Magnitude * 0.5, MINIMUM_RADIUS),
	}
end

local function getAnimator(model: Model): Animator
	local controller = model:FindFirstChildWhichIsA("Humanoid", true)
		or model:FindFirstChildWhichIsA("AnimationController", true)
	if not controller then
		controller = Instance.new("AnimationController")
		controller.Parent = model
	end

	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end

	return animator
end

local function getRigCFrame(props: Props): CFrame
	local rotation = read(props.RigRotation) or Vector3.zero
	return CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))
end

local function updateCamera(camera: Camera, state: RigState, size: Vector2, props: Props)
	local fieldOfView = math.clamp(read(props.FieldOfView) or DEFAULT_FIELD_OF_VIEW, 1, 120)
	local direction = read(props.CameraDirection) or DEFAULT_CAMERA_DIRECTION
	direction = if direction.Magnitude > 0 then direction.Unit else DEFAULT_CAMERA_DIRECTION

	local aspectRatio = if size.X > 0 and size.Y > 0 then size.X / size.Y else 1
	local halfAngle = math.atan(math.tan(math.rad(fieldOfView) * 0.5) * math.min(aspectRatio, 1))
	local padding = math.max(read(props.FitPadding) or DEFAULT_FIT_PADDING, 1)
	local zoom = math.max(read(props.Zoom) or 1, 0.01)
	local distance =
		math.max(state.Radius / math.sin(halfAngle) * padding / zoom, state.Radius + math.abs(camera.NearPlaneZ))
	local focus = getRigCFrame(props):PointToWorldSpace(state.Center + (read(props.CenterOffset) or Vector3.zero))
	local up = if math.abs(direction:Dot(Vector3.yAxis)) > 0.999 then Vector3.zAxis else Vector3.yAxis

	camera.FieldOfView = fieldOfView
	camera.Focus = CFrame.new(focus)
	camera.CFrame = CFrame.lookAt(focus + direction * distance, focus, up)
end

-------------------------------------------------
--// RigViewPort
-------------------------------------------------
return function(props: Props): ViewportFrame
	local camera = create("Camera")({
		Name = "RigCamera",
		CameraType = Enum.CameraType.Scriptable,
		FieldOfViewMode = Enum.FieldOfViewMode.Vertical,
	})
	local worldModel = props.UseWorldModel == true and create("WorldModel")({
		Name = "RigWorld",
	})

	local viewport = create("ViewportFrame")({
		Name = props.Name or "RigViewport",
		Active = props.Active,
		AnchorPoint = props.AnchorPoint,
		BackgroundColor3 = props.BackgroundColor3,
		BackgroundTransparency = props.BackgroundTransparency or 1,
		BorderSizePixel = 0,
		ClipsDescendants = props.ClipsDescendants,
		LayoutOrder = props.LayoutOrder,
		Position = props.Position,
		Rotation = props.Rotation,
		Size = props.Size or UDim2.fromScale(1, 1),
		Visible = props.Visible,
		ZIndex = props.ZIndex,

		Ambient = props.Ambient or Color3.fromRGB(180, 180, 180),
		ImageColor3 = props.ImageColor3,
		ImageTransparency = props.ImageTransparency,
		LightColor = props.LightColor or Color3.new(1, 1, 1),
		LightDirection = props.LightDirection or Vector3.new(-1, -1, -1),
		CurrentCamera = camera,

		camera,
		worldModel,
	})

	local rigState = source(nil :: RigState?)
	local activeTrack = source(nil :: AnimationTrack?)
	local viewportSize = source(viewport.AbsoluteSize)
	cleanup(viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		viewportSize(viewport.AbsoluteSize)
	end))
	cleanup(function()
		rigState(nil)
		viewport:Destroy()
	end)

	effect(function()
		local rig = read(props.Rig)
		if not rig then
			return
		end

		local model = rig:Clone()
		if not model then
			warn(`[RigViewport] Rig "{rig.Name}" must be Archivable to create a preview.`)
			return
		end
		local state = prepareRig(model)
		if not state then
			model:Destroy()
			return
		end
		cleanup(function()
			rigState(nil)
			model:Destroy()
		end)
		model.Parent = viewport
		rigState(state)
	end)

	effect(function()
		local state = rigState()
		if not state then
			return
		end
		state.Model:PivotTo(getRigCFrame(props))
	end)

	effect(function()
		local state = rigState()
		if not state then
			return
		end
		updateCamera(camera, state, viewportSize(), props)
	end)

	effect(function()
		local state = rigState()
		if state and props.OnRigChanged then
			cleanup(function()
				untrack(function()
					props.OnRigChanged(nil)
				end)
			end)
			untrack(function()
				props.OnRigChanged(state.Model)
			end)
		end
	end)

	effect(function()
		local state = rigState()
		local animation = read(props.Animation)
		if not state or not animation then
			return
		end
		if not props.UseWorldModel then
			warn("애니메이션을 재생하기 위해선 WorldModel을 사용해야 함.")
			return
		end

		local track
		local loadThread = task.defer(function()
			while not state.Model:IsDescendantOf(game) do
				state.Model.AncestryChanged:Wait()
			end

			local ok, result = pcall(function()
				return getAnimator(state.Model):LoadAnimation(animation)
			end)
			if not ok then
				warn(`Failed to load animation "{animation.AnimationId}": {result}`)
				return
			end

			track = result
			if props.AutoPlay ~= false then
				track:Play(math.max(props.AnimationFadeTime or 0.1, 0))
			end
			activeTrack(track)
		end)
		cleanup(function()
			if loadThread ~= coroutine.running() and coroutine.status(loadThread) ~= "dead" then
				task.cancel(loadThread)
			end
			activeTrack(nil)
			if track then
				track:Stop(0)
				track:Destroy()
			end
		end)
	end)

	effect(function()
		local track = activeTrack()
		if not track then
			return
		end
		local looped = read(props.AnimationLooped)
		local speed = read(props.AnimationSpeed)
		if looped ~= nil then
			track.Looped = looped
		end
		if speed ~= nil then
			track:AdjustSpeed(speed)
		end
	end)

	effect(function()
		local track = activeTrack()
		if track and props.OnTrackChanged then
			cleanup(function()
				untrack(function()
					props.OnTrackChanged(nil)
				end)
			end)
			untrack(function()
				props.OnTrackChanged(track)
			end)
		end
	end)

	return viewport
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Slot</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)
local useButtonEffect = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useButtonEffect)
local useButtonHoverEffect = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useButtonHoverEffect)
local useColorSequenceCycle = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useColorSequenceCycle)

local action = Vide.action
local create = Vide.create
local derive = Vide.derive
local read = Vide.read

type Reactive<T> = T | (() -> T)

type Props = {
	Active: Reactive<boolean>?,
	AnchorPoint: Reactive<Vector2>?,
	ClipsDescendants: Reactive<boolean>?,
	LayoutOrder: Reactive<number>?,
	Name: Reactive<string>?,
	Position: Reactive<UDim2>?,
	Rotation: Reactive<number>?,
	Size: Reactive<UDim2>?,
	Visible: Reactive<boolean>?,
	ZIndex: Reactive<number>?,

	AssetType: string?,
	AssetProps: any?,
	Rarity: Reactive<string>?,
	UseButtonEffect: boolean?,

	OnActivated: (() -> nil)?,
}

local AssetComponents = {
	Currency = require(script.Currency),
	Tower = require(script.Tower),
	Item = require(script.Item),
}

local function set(reactive, default)
	return function()
		return read(reactive) or default
	end
end

return function(props: Props)
	local gradientData = derive(function()
		local rarityEntity = RarityRegistry.Get(props.Rarity)

		return rarityEntity and rarityEntity.Presentation
	end)

	return create("ImageButton")({
		Active = props.Active,
		AnchorPoint = set(props.AnchorPoint, Vector2.new(0.5, 0.5)),
		ClipsDescendants = props.ClipsDescendants,
		BackgroundTransparency = 1,
		Image = "rbxassetid://87496848270095",
		LayoutOrder = props.LayoutOrder,
		Name = set(props.Name, "Slot"),
		Position = props.Position,
		Rotation = props.Rotation,
		Size = set(props.Size, UDim2.fromScale(0.186, 0.339)),
		Visible = props.Visible,
		ZIndex = props.ZIndex,

		create("UIAspectRatioConstraint")({}),

		create("UIGradient")({
			useColorSequenceCycle(function()
				return gradientData().Gradient or ColorSequence.new(Color3.new())
			end, function()
				return gradientData().ShimmerSpeed or 1
			end),

			Rotation = 45,
		}),

		create("UICorner")({
			CornerRadius = UDim.new(0.1, 0),
		}),

		if props.UseButtonEffect then useButtonEffect() else nil,
		if props.UseButtonEffect then useButtonHoverEffect() else nil,

		action(function(slotFrame)
			local targetComponent = AssetComponents[props.AssetType]
			if targetComponent then
				local content = targetComponent(props.AssetProps)

				content.Parent = slotFrame
			end
		end),
	})
end
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Currency</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local CurrencyData = require(ReplicatedStorage.Settings.Data.CurrencyData)

type Reactive<T> = T | (() -> T)
type Props = {
	CurrencyName: Reactive<string>,
	CurrencyQuantity: Reactive<number>?,
}

local create = Vide.create
local read = Vide.read
local derive = Vide.derive

return function(props: Props)
	local currencyInfo = derive(function()
		return CurrencyData.ByName[read(props.CurrencyName)]
	end)

	return create("Frame")({
		Name = "Content",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),

		create("ImageLabel")({
			Name = "ItemIcon",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.465),
			Size = UDim2.fromScale(0.7, 0.7),
			Image = function()
				return if currencyInfo() then currencyInfo().CurrencyImage else ""
			end,
		}),

		create("TextLabel")({
			Name = "Name",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.076095, 0.730419),
			Size = UDim2.fromScale(0.84887, 0.172688),
			Text = props.CurrencyName,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),
		}),

		create("ImageLabel")({
			Name = "Quantity",
			BackgroundTransparency = 1,
			Image = "rbxassetid://104083646922843",
			Position = UDim2.fromScale(-0.0129994, -0.05),
			Size = UDim2.fromScale(0.653434, 0.238322),
			ZIndex = 10,
			Visible = function()
				return read(props.CurrencyQuantity) ~= nil
			end,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
				AspectRatio = 3.2,
			}),

			create("TextLabel")({
				Name = "TextLabel",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.new(
					"rbxasset://fonts/families/SourceSansPro.json",
					Enum.FontWeight.Bold,
					Enum.FontStyle.Normal
				),
				Position = UDim2.fromScale(0.3, 0.489),
				Size = UDim2.fromScale(0.477775, 0.75514),
				Text = function()
					return `{read(props.CurrencyQuantity)}x`
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,

				create("UIStroke")({
					Name = "UIStroke",
					Thickness = 2,
				}),

				create("UIGradient")({
					Name = "UIGradient",
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(104, 106, 211)),
					}),
					Rotation = 90,
				}),
			}),
		}),
	})
end
]]></string>
            </Properties>
