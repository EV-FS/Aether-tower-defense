          <Item class="ModuleScript" referent="517">
            <Properties>
              <string name="Name">CutsceneValidator</string>
              <string name="Source"><![CDATA[local CutsceneValidator = {}
local ScreenEffects = require(script.Parent.ScreenEffects)
local LightingSession = require(script.Parent.LightingSession)
local ScenePaths = require(script.Parent.ScenePaths)

local function isFinite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

local function validatePositive(value: any, label: string)
	assert(isFinite(value) and value > 0, `{label} must be a positive finite number`)
end

local function validateFrame(value: any, label: string)
	assert(isFinite(value) and value >= 0 and value % 1 == 0, `{label} must be a nonnegative integer`)
end

local function getLastSampleFrame(samples): number
	local lastFrame = nil
	for frame, value in samples do
		validateFrame(frame, "FOV sample frame")
		assert(isFinite(value) and value > 0, `FOV sample at frame {frame} must be positive and finite`)
		if not lastFrame or frame > lastFrame then
			lastFrame = frame
		end
	end
	assert(lastFrame ~= nil, "FOV samples cannot be empty")
	return lastFrame
end

local function validateTrackEndFrames(config)
	local endFrame = nil
	local function add(label: string, value: any)
		validatePositive(value, `{label}.EndFrame`)
		assert(value % 1 == 0, `{label}.EndFrame must be an integer`)
		if endFrame and endFrame ~= value then
			warn(`[CutsceneValidator] {label}.EndFrame ({value}) differs from another track EndFrame ({endFrame})`)
		else
			endFrame = value
		end
	end

	for label, track in {
		ScreenEffects = config.ScreenEffects,
		ImpactFrames = config.ImpactFrames,
		VFX = config.VFX,
	} do
		if track then
			add(label, track.EndFrame)
			if track.FPS ~= nil then validatePositive(track.FPS, `{label}.FPS`) end
		end
	end

	if config.FPS ~= nil then validatePositive(config.FPS, "Cutscene.FPS") end
	return endFrame
end

function CutsceneValidator.Validate(name: string, config)
	assert(type(config) == "table", `Missing cutscene config: {name}`)
	assert(type(config.Camera) == "table", `Cutscene "{name}" is missing Camera config`)
	assert(type(config.Camera.Model) == "string" and config.Camera.Model ~= "", `Cutscene "{name}" has an invalid camera model`)
	assert(type(config.Camera.Part) == "string" and config.Camera.Part ~= "", `Cutscene "{name}" has an invalid camera part`)
	assert(type(config.Animations) == "table", `Cutscene "{name}" is missing Animations`)
	assert(config.Animations[config.Camera.Model] ~= nil, `Cutscene "{name}" is missing the camera animation "{config.Camera.Model}"`)
	if config.Actors then
		assert(type(config.Actors) == "table", `Cutscene "{name}" Actors must be a table`)
		for actorName, role in config.Actors do
			assert(type(actorName) == "string" and config.Animations[actorName] ~= nil,
				`Cutscene "{name}" actor {tostring(actorName)} has no animation`)
			assert(role == "Self" or role == "Friend", `Cutscene "{name}" actor {actorName} has invalid role`)
		end
	end
	if config.SceneTransform ~= nil then
		assert(typeof(config.SceneTransform) == "CFrame", `Cutscene "{name}" has an invalid SceneTransform`)
		assert(not config.UseWorkspaceScene, `Cutscene "{name}" cannot transform a live Workspace scene`)
	end

	local fov = config.Camera.FOV
	local fovEndFrame = nil
	if fov then
		assert(type(fov.Samples) == "table", `Cutscene "{name}" has invalid FOV samples`)
		fovEndFrame = getLastSampleFrame(fov.Samples)
		if fov.FPS ~= nil then validatePositive(fov.FPS, "Camera.FOV.FPS") end
	end

	local trackEndFrame = validateTrackEndFrames(config)
	if config.ScreenEffects then
		ScreenEffects.Validate(config.ScreenEffects)
	end
	if config.VFX then
		local vfx = config.VFX
		assert(type(vfx.Events) == "table", `Cutscene "{name}" VFX.Events must be a table`)
		for frame, event in vfx.Events do
			validateFrame(frame, "VFX event frame")
			assert(frame <= vfx.EndFrame, `Cutscene "{name}" VFX event exceeds EndFrame`)
			assert(type(event) == "table", `Cutscene "{name}" VFX event at {frame} must be a table`)
			local count = 0
			for _, kind in { "Emit", "AbsoluteEmit" } do
				local paths = event[kind]
				if paths then
					assert(type(paths) == "table", `Cutscene "{name}" VFX {kind} at {frame} must be a table`)
					for _, path in paths do
						assert(type(path) == "table", `Cutscene "{name}" VFX path at {frame} must be a table`)
						ScenePaths.Key(path)
						count += 1
					end
				end
			end
			assert(count > 0, `Cutscene "{name}" VFX event at {frame} has no targets`)
		end
	end
	if config.Audio then
		assert(type(config.Audio) == "table", `Cutscene "{name}" Audio must be a table`)
		assert(isFinite(config.Audio.SoundId) and config.Audio.SoundId > 0
			and config.Audio.SoundId % 1 == 0, `Cutscene "{name}" has an invalid audio asset ID`)
		if config.Audio.Volume ~= nil then
			assert(isFinite(config.Audio.Volume) and config.Audio.Volume >= 0,
				`Cutscene "{name}" has an invalid audio volume`)
		end
	end
	if config.Presentation then
		assert(type(config.Presentation) == "table", `Cutscene "{name}" Presentation must be a table`)
		for _, field in { "ReadyHold", "BlackHold", "ReturnHold", "FadeIn", "FadeOut" } do
			local value = config.Presentation[field]
			assert(isFinite(value) and value >= 0, `Cutscene "{name}" Presentation.{field} must be nonnegative`)
		end
		validatePositive(config.Presentation.PreloadTimeout, `Cutscene "{name}" Presentation.PreloadTimeout`)
		if config.Presentation.ExitFOVScale ~= nil then
			local exitFOVScale = config.Presentation.ExitFOVScale
			assert(isFinite(exitFOVScale) and exitFOVScale > 0 and exitFOVScale <= 1,
				`Cutscene "{name}" Presentation.ExitFOVScale must be in (0, 1]`)
		end
	end
	if config.Lighting then
		LightingSession.Validate(config.Lighting)
	end
	if fovEndFrame and trackEndFrame and fovEndFrame ~= trackEndFrame then
		warn(`[CutsceneValidator] {name}: FOV ends at frame {fovEndFrame}, other tracks end at frame {trackEndFrame}`)
	end
	return true
end

return CutsceneValidator
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="518">
            <Properties>
              <string name="Name">ECS</string>
            </Properties>
            <Item class="ModuleScript" referent="519">
              <Properties>
                <string name="Name">AudioSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)

return function(world)
	for entity, session, audio in world:query(Components.Session, Components.AudioTrack) do
		local start = session.State:GetAttribute("StartedAt")
		if audio.Started or not start or not session.State.Parent then continue end
		local elapsed = workspace:GetServerTimeNow() - start
		if elapsed < 0 or not audio.Sound.IsLoaded then continue end
		-- Seek once on start to compensate for a late frame; never seek every frame.
		if audio.Sound.TimeLength <= 0 or elapsed < audio.Sound.TimeLength then
			audio.Sound.TimePosition = elapsed
			audio.Sound:Play()
		end
		world:insert(entity, audio:patch({ Started = true }))
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="520">
              <Properties>
                <string name="Name">CameraRuntime</string>
                <string name="Source"><![CDATA[local Matter = require(game:GetService("ReplicatedStorage").Packages.Matter)
local Components = require(script.Parent.Components)
local SampleTrack = require(script.Parent.SampleTrack)
local CameraSystem = require(script.Parent.CameraSystem)
local VFXSystem = require(script.Parent.VFXSystem)
local AudioSystem = require(script.Parent.AudioSystem)
local ImpactSystem = require(script.Parent.ImpactSystem)
local ScreenEffectSystem = require(script.Parent.ScreenEffectSystem)
local ScreenEffects = require(script.Parent.Parent.ScreenEffects)
local LightingSession = require(script.Parent.Parent.LightingSession)
local ImpactFrames = require(script.Parent.Parent.ImpactFrames)
local VFXContext = require(script.Parent.Parent.VFXContext)
local PlaybackClock = require(script.Parent.Parent.PlaybackClock)
local Prepare = require(script.Parent.Parent.Prepare)
local ActorView = require(script.Parent.Parent.ActorView)
local Cleanup = require(script.Parent.Parent.Cleanup)

local CameraRuntime = {}
CameraRuntime.__index = CameraRuntime

function CameraRuntime.new(state, reference, config, tracks)
	local world = Matter.World.new()
	local entity = world:spawn(
		Components.Session({ State = state, Elapsed = 0 }),
		Components.CameraTarget({ Reference = reference })
	)
	local self = setmetatable({ World = world, Entity = entity, State = state, Tracks = tracks }, CameraRuntime)
	local ok, err = xpcall(function()
	if config and config.Lighting then
		local lightingOk, lighting = pcall(LightingSession.new, config.Lighting)
		if lightingOk then
			self.LightingSession = lighting
		else
			warn(`[CameraRuntime] Cutscene lighting could not be applied: {lighting}`)
		end
	end
	local fov = config and config.Camera.FOV
	local vfx = config and config.VFX
	if fov then
		assert(not fov.FPS or fov.FPS > 0, "FOV FPS must be positive")
		world:insert(entity, Components.FOVTrack({
			Samples = fov.Samples,
			Keys = SampleTrack.Keys(fov.Samples),
			FPS = fov.FPS or config.FPS,
			Cuts = fov.Cuts,
		}))
	end
	local jobs = {}
	local actorView = nil
	if config and config.Actors then
		jobs.Actors = { Timeout = 15,
			Run = function() return ActorView.new(state, config, tracks, function(view) actorView = view; self.ActorView = view end) end,
			Cancel = function() if actorView then actorView:Destroy() end end,
		}
	end
	local sound = nil
	if config and config.Audio then
		sound = Instance.new("Sound")
		self.Sound = sound
		sound.Name = "CutsceneAudio"
		sound.SoundId = "rbxassetid://" .. config.Audio.SoundId
		sound.Volume = config.Audio.Volume or 1
		sound.Looped = false
		sound.Parent = game:GetService("SoundService")
		jobs.Audio = { Timeout = 8, Run = function()
			game:GetService("ContentProvider"):PreloadAsync({ sound })
		end }
		world:insert(entity, Components.AudioTrack({ Sound = sound, Started = false }))
	end
	if vfx then
		jobs.VFX = { Timeout = 25, Run = function() return VFXContext.new(state, vfx.Events) end }
	end
	if config and config.ImpactFrames then
		jobs.Impact = { Timeout = 10, Run = function() return ImpactFrames.new(config.ImpactFrames) end }
	end
	if config and config.ScreenEffects then
		jobs.Screen = { Timeout = 5, Run = function() return ScreenEffects.new(config.ScreenEffects) end }
	end
	local prepared = Prepare.All(jobs)
	local context = prepared.VFX and prepared.VFX.Success and prepared.VFX.Value or nil
	self.VFXContext = context
	self.ImpactView = prepared.Impact and prepared.Impact.Success and prepared.Impact.Value or nil
	self.ScreenView = prepared.Screen and prepared.Screen.Success and prepared.Screen.Value or nil
	-- Assign every successfully created resource before a required-job assertion,
	-- so the outer failure cleanup can destroy parallel jobs as well.
	if config and config.ScreenEffects then
		local screenResult = prepared.Screen
		assert(screenResult and screenResult.Success,
			"Screen effect preparation failed: " .. tostring(screenResult and screenResult.Error))
	end
	if context then
		local keys = {}
		for frame in vfx.Events do table.insert(keys, frame) end
		table.sort(keys)
		world:insert(entity, Components.VFXTrack({
			Events = vfx.Events,
			Keys = keys,
			NextIndex = 1,
			EndFrame = vfx.EndFrame,
			FPS = vfx.FPS or config.FPS,
			Run = function(event) context:Run(event) end,
		}))
	end
	local impactView = prepared.Impact and prepared.Impact.Success and prepared.Impact.Value or nil
	local screenView = prepared.Screen and prepared.Screen.Success and prepared.Screen.Value or nil
	if screenView then
		local screen = config.ScreenEffects
		world:insert(entity, Components.ScreenEffectTrack({
			View = screenView, EndFrame = screen.EndFrame, FPS = screen.FPS or config.FPS,
		}))
	end
	if impactView then
		local impact = config.ImpactFrames
		world:insert(entity, Components.ImpactTrack({
			Events = impact.Events,
			EndFrame = impact.EndFrame,
			FPS = impact.FPS or config.FPS,
			View = impactView,
		}))
	end
	end, debug.traceback)
	if not ok then self:Destroy(); error(err, 0) end
	return self
end

-- Called before Animator evaluates poses. Rendering uses this exact sample.
function CameraRuntime:PreAnimation()
	if self.Destroyed or not self.State.Parent then return end
	if self.ActorView then self.ActorView:PreAnimation() end
	local elapsed = PlaybackClock.Elapsed(self.State, workspace:GetServerTimeNow())
	PlaybackClock.Apply(self.Tracks, elapsed)
	self.World:insert(self.Entity, Components.Session({ State = self.State, Elapsed = elapsed }))
end

function CameraRuntime:Step()
	CameraSystem(self.World)
	ScreenEffectSystem(self.World)
	ImpactSystem(self.World)
	AudioSystem(self.World)
	VFXSystem(self.World)
end

function CameraRuntime:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	if self.ActorView then Cleanup.Try("Actors", function() self.ActorView:Destroy() end); self.ActorView = nil end
	if self.ScreenView then
		Cleanup.Try("Screen effects", function() self.ScreenView:Destroy() end)
		self.ScreenView = nil
	end
	if self.LightingSession then
		Cleanup.Try("Lighting", function() self.LightingSession:Destroy() end)
		self.LightingSession = nil
	end
	if self.VFXContext then
		Cleanup.Try("VFX", function() self.VFXContext:Destroy() end)
		self.VFXContext = nil
	end
	if self.ImpactView then
		Cleanup.Try("Impact images", function() self.ImpactView:Destroy() end)
		self.ImpactView = nil
	end
	if self.Sound then
		Cleanup.Try("Stop audio", function() self.Sound:Stop() end)
		Cleanup.Try("Destroy audio", function() self.Sound:Destroy() end)
		self.Sound = nil
	end
	Cleanup.Try("ECS session", function() self.World:despawn(self.Entity) end)
end

return CameraRuntime
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="521">
              <Properties>
                <string name="Name">CameraSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)
local SampleTrack = require(script.Parent.SampleTrack)

return function(world)
	local camera = workspace.CurrentCamera
	if not camera then return end
	for _, session, target in world:query(Components.Session, Components.CameraTarget) do
		local part = target.Reference.Value
		if session.State.Parent and part and part.Parent then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = part.CFrame
		end
	end
	for _, session, track in world:query(Components.Session, Components.FOVTrack) do
		if not session.State.Parent then continue end
		local elapsed = session.Elapsed
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS
		if not fps then
			fps = if duration and duration > 0 then track.Keys[#track.Keys] / duration else 0
		end
		camera.FieldOfView = math.clamp(
			SampleTrack.Read(track.Samples, track.Keys, elapsed * fps, track.Cuts), 1, 120
		)
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="522">
              <Properties>
                <string name="Name">Components</string>
                <string name="Source"><![CDATA[local Matter = require(game:GetService("ReplicatedStorage").Packages.Matter)

return {
	Session = Matter.component("CutsceneSession"),
	CameraTarget = Matter.component("CutsceneCameraTarget"),
	FOVTrack = Matter.component("CutsceneFOVTrack"),
	VFXTrack = Matter.component("CutsceneVFXTrack"),
	AudioTrack = Matter.component("CutsceneAudioTrack"),
	ImpactTrack = Matter.component("CutsceneImpactTrack"),
	ScreenEffectTrack = Matter.component("CutsceneScreenEffectTrack"),
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="523">
              <Properties>
                <string name="Name">CubicBezier</string>
                <string name="Source"><![CDATA[-- Solve x(t) = progress, then sample y(t); y may overshoot while x must be monotonic.
local CubicBezier = {}

function CubicBezier.Create(params)
	params = params or {}
	local x1, y1 = params.X1 or params.x1 or 0.25, params.Y1 or params.y1 or 0.1
	local x2, y2 = params.X2 or params.x2 or 0.25, params.Y2 or params.y2 or 1
	for _, value in { x1, y1, x2, y2 } do
		assert(type(value) == "number" and value == value and math.abs(value) < math.huge, "Bezier controls must be finite numbers")
	end
	assert(x1 >= 0 and x1 <= 1 and x2 >= 0 and x2 <= 1, "Bezier X controls must be in [0, 1]")
	local function sample(t, a, b)
		local inverse = 1 - t
		return 3 * inverse * inverse * t * a + 3 * inverse * t * t * b + t * t * t
	end
	return function(alpha)
		if alpha <= 0 then return 0 end
		if alpha >= 1 then return 1 end
		local guess = alpha
		for _ = 1, 6 do
			local errorX = sample(guess, x1, x2) - alpha
			if math.abs(errorX) < 1e-7 then return sample(guess, y1, y2) end
			local inverse = 1 - guess
			local derivative = 3 * inverse * inverse * x1 + 6 * inverse * guess * (x2 - x1)
				+ 3 * guess * guess * (1 - x2)
			if math.abs(derivative) < 1e-7 then break end
			local nextGuess = guess - errorX / derivative
			if nextGuess < 0 or nextGuess > 1 then break end
			guess = nextGuess
		end
		local low, high = 0, 1
		for _ = 1, 30 do
			guess = (low + high) * 0.5
			local x = sample(guess, x1, x2)
			if math.abs(x - alpha) < 1e-7 then break end
			if x < alpha then low = guess else high = guess end
		end
		return sample(guess, y1, y2)
	end
end

return CubicBezier
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="524">
              <Properties>
                <string name="Name">ImpactSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)
local ImpactTrack = require(script.Parent.ImpactTrack)

return function(world)
	for _, session, track in world:query(Components.Session, Components.ImpactTrack) do
		local startedAt = session.State:GetAttribute("StartedAt")
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS or (duration and duration > 0 and track.EndFrame / duration)
		if not session.State.Parent or not startedAt or workspace:GetServerTimeNow() < startedAt or not fps then
			track.View:Show(false, false)
			continue
		end
		-- Use the same PreAnimation sample as rig poses and FOV, without yielding/tweens.
		track.View:Show(ImpactTrack.Read(track.Events, track.View.Keys, session.Elapsed * fps), true)
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="525">
              <Properties>
                <string name="Name">ImpactTrack</string>
                <string name="Source"><![CDATA[-- A held image state, not a queue of callbacks: skipped frames never replay old flashes.
local ImpactTrack = {}

function ImpactTrack.Keys(events)
	local keys = {}
	for frame, imageId in pairs(events) do
		assert(type(frame) == "number" and frame >= 0 and frame % 1 == 0, "Impact frame must be a nonnegative integer")
		assert(imageId == false or (type(imageId) == "number" and imageId > 0 and imageId % 1 == 0), "Impact image must be an asset ID or false")
		table.insert(keys, frame)
	end
	table.sort(keys)
	return keys
end

function ImpactTrack.Read(events, keys, frame)
	local low, high = 1, #keys
	local result = false
	while low <= high do
		local middle = math.floor((low + high) / 2)
		if keys[middle] <= frame then
			result = events[keys[middle]]
			low = middle + 1
		else
			high = middle - 1
		end
	end
	return result
end

return ImpactTrack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="526">
              <Properties>
                <string name="Name">PropertyTrack</string>
                <string name="Source"><![CDATA[-- Stateless sampling: no private clock, connections, Tween instances or accumulated dt.
local PropertyTrack = {}

function PropertyTrack.Prepare(keys, expectedType, resolveEase)
	assert(type(keys) == "table", "Property track must be a table")
	local prepared = {}
	local sequence = keys.Sequence or keys -- support old arrays and new Moon exports
	assert(type(sequence) == "table", "Property Sequence must be an array")
	if keys.Default ~= nil then
		assert(typeof(keys.Default) == expectedType, "Property Default must be " .. expectedType)
		if expectedType == "number" then
			assert(keys.Default == keys.Default and math.abs(keys.Default) < math.huge, "Property Default must be finite")
		end
		prepared.Default = keys.Default
	end
	for _, key in ipairs(sequence) do
		assert(type(key.Frame) == "number" and key.Frame >= 0 and key.Frame < math.huge
			and key.Frame % 1 == 0, "Property key Frame must be a nonnegative integer")
		assert(typeof(key.Value) == expectedType, "Property key Value must be " .. expectedType)
		if expectedType == "number" then
			assert(key.Value == key.Value and math.abs(key.Value) < math.huge, "Property value must be finite")
		end
		table.insert(prepared, {
			Frame = key.Frame, Value = key.Value,
			Ease = if key.Ease and resolveEase then resolveEase(key.Ease) else nil,
		})
	end
	table.sort(prepared, function(a, b) return a.Frame < b.Frame end)
	for index = 2, #prepared do
		assert(prepared[index - 1].Frame ~= prepared[index].Frame, "Duplicate property key frame")
	end
	return prepared
end

function PropertyTrack.Read(track, frame)
	if #track == 0 then return track.Default end
	if frame < track[1].Frame then
		return if track.Default ~= nil then track.Default else track[1].Value
	end
	if frame == track[1].Frame then return track[1].Value end
	if frame >= track[#track].Frame then return track[#track].Value end
	local low, high = 1, #track
	while high - low > 1 do
		local middle = math.floor((low + high) / 2)
		if track[middle].Frame <= frame then low = middle else high = middle end
	end
	local left, right = track[low], track[high]
	local kind = typeof(left.Value)
	-- Discrete values switch at the actual key, not early when an easing overshoots.
	if kind == "boolean" then return left.Value end
	local alpha = (frame - left.Frame) / (right.Frame - left.Frame)
	if left.Ease then alpha = left.Ease(alpha) end
	if kind == "number" then return left.Value + (right.Value - left.Value) * alpha end
	if kind == "Color3" or kind == "Vector2" or kind == "Vector3" then
		return left.Value:Lerp(right.Value, alpha)
	end
	return left.Value
end

return PropertyTrack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="527">
              <Properties>
                <string name="Name">SampleTrack</string>
                <string name="Source"><![CDATA[local SampleTrack = {}

function SampleTrack.Keys(samples)
	local keys = {}
	for frame, value in samples do
		assert(type(frame) == "number" and type(value) == "number", "FOV samples must be numeric")
		table.insert(keys, frame)
	end
	table.sort(keys)
	assert(#keys > 0, "Empty FOV track")
	return keys
end

function SampleTrack.Read(samples, keys, frame, cuts)
	if frame <= keys[1] then return samples[keys[1]] end
	if frame >= keys[#keys] then return samples[keys[#keys]] end
	local low, high = 1, #keys
	while high - low > 1 do
		local middle = math.floor((low + high) / 2)
		if keys[middle] <= frame then low = middle else high = middle end
	end
	local left, right = keys[low], keys[high]
	if cuts and cuts[right] then return samples[left] end
	local alpha = (frame - left) / (right - left)
	return samples[left] + (samples[right] - samples[left]) * alpha
end

return SampleTrack
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="528">
              <Properties>
                <string name="Name">ScreenEffectSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)

return function(world)
	for _, session, track in world:query(Components.Session, Components.ScreenEffectTrack) do
		local start = session.State:GetAttribute("StartedAt")
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS or (duration and duration > 0 and track.EndFrame / duration)
		if not session.State.Parent or not start or workspace:GetServerTimeNow() < start or not fps then
			track.View:ApplyFrame(0, false)
			continue
		end
		-- Same PreAnimation sample as the camera pose, FOV and impact images.
		track.View:ApplyFrame(session.Elapsed * fps, true)
	end
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="529">
              <Properties>
                <string name="Name">VFXSystem</string>
                <string name="Source"><![CDATA[local Components = require(script.Parent.Components)

return function(world)
	for entity, session, track in world:query(Components.Session, Components.VFXTrack) do
		local startedAt = session.State:GetAttribute("StartedAt")
		-- Frame zero fires only once the server's scheduled start is reached.
		if not session.State.Parent or not startedAt or workspace:GetServerTimeNow() < startedAt then continue end
		local duration = session.State:GetAttribute("CameraDuration")
		local fps = track.FPS or (duration and duration > 0 and track.EndFrame / duration)
		if not fps then continue end
		local frame = session.Elapsed * fps
		local nextIndex = track.NextIndex
		while nextIndex <= #track.Keys and track.Keys[nextIndex] <= frame do
			local event = track.Events[track.Keys[nextIndex]]
			nextIndex += 1
			-- Reserve the event before dispatching potentially yielding third-party VFX.
			task.spawn(track.Run, event)
		end
		if nextIndex ~= track.NextIndex then
			world:insert(entity, track:patch({ NextIndex = nextIndex }))
		end
	end
end
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="530">
            <Properties>
              <string name="Name">FriendSelection</string>
              <string name="Source"><![CDATA[-- Select only IDs returned by Roblox for this user's friends; never invent a fallback ID.
local FriendSelection = {}
function FriendSelection.FromPage(page, userId, randomIndex)
	local candidates, seen = {}, {}
	for _, item in page do
		local id = item.Id
		if type(id) == "number" and id > 0 and id % 1 == 0 and id ~= userId and not seen[id] then
			seen[id] = true
			table.insert(candidates, id)
		end
	end
	if #candidates == 0 then return nil end
	return candidates[randomIndex(#candidates)]
end
return FriendSelection
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="531">
            <Properties>
              <string name="Name">ImpactFrames</string>
              <string name="Source"><![CDATA[local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local Prepare = require(script.Parent.Prepare)
local ImpactTrack = require(script.Parent.ECS.ImpactTrack)

local ImpactFrames = {}
ImpactFrames.__index = ImpactFrames

function ImpactFrames.new(config)
	assert(config.EndFrame > 0, "ImpactFrames.EndFrame must be positive")
	assert(not config.FPS or config.FPS > 0, "ImpactFrames.FPS must be positive")
	local keys = ImpactTrack.Keys(config.Events)
	local gui = Instance.new("ScreenGui")
	gui.Name = "CutsceneImpactFrames"
	gui.IgnoreGuiInset = true
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ClipToDeviceSafeArea = false
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10000
	gui.Enabled = false
	local images, assets = {}, {}
	for _, frame in ipairs(keys) do
		local imageId = config.Events[frame]
		if imageId and not images[imageId] then
			local label = Instance.new("ImageLabel")
			label.Name = tostring(imageId)
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.BorderSizePixel = 0
			label.Image = "rbxassetid://" .. imageId
			label.ScaleType = Enum.ScaleType.Stretch
			label.ZIndex = 1
			label.Visible = false
			label.Parent = gui
			images[imageId] = label
			table.insert(assets, label)
		end
	end
	local persistentImage = nil
	if config.PersistentImage then
		local settings = config.PersistentImage
		persistentImage = Instance.new("ImageLabel")
		persistentImage.Name = "PersistentImage"
		persistentImage.Size = UDim2.fromScale(1, 1)
		persistentImage.BackgroundTransparency = 1
		persistentImage.BorderSizePixel = 0
		persistentImage.Image = "rbxassetid://" .. settings.ImageId
		persistentImage.ImageTransparency = settings.ImageTransparency or 0
		persistentImage.ScaleType = Enum.ScaleType.Stretch
		persistentImage.ZIndex = 2
		persistentImage.Parent = gui
		table.insert(assets, persistentImage)
	end
	-- Preload the actual labels before the client acknowledges cutscene readiness.
	local loaded = Prepare.Try("Impact image preload", 8, function()
		local failed = {}
		ContentProvider:PreloadAsync(assets, function(assetId, status)
			if status ~= Enum.AssetFetchStatus.Success then
				table.insert(failed, assetId .. " (" .. status.Name .. ")")
			end
		end)
		assert(#failed == 0, "Impact images failed: " .. table.concat(failed, ", "))
	end)
	if not loaded then
		gui:Destroy()
		warn("[CutsceneImpactFrames] Disabled for this playback because images were not ready; check image permissions/network.")
		return nil
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return setmetatable({ Gui = gui, Images = images, Current = false, Keys = keys, PersistentImage = persistentImage }, ImpactFrames)
end

function ImpactFrames:Show(imageId, isPlaying)
	-- Hiding a timed impact must not hide the persistent overlay. Update even
	-- when the event stays false across the scheduled start/end boundary.
	self.Gui.Enabled = isPlaying and (imageId ~= false or self.PersistentImage ~= nil)
	if self.Current == imageId then return end
	if self.Current then self.Images[self.Current].Visible = false end
	if imageId then self.Images[imageId].Visible = true end
	self.Current = imageId
end

function ImpactFrames:Destroy()
	self.Gui.Enabled = false
	self.Gui:Destroy()
end

return ImpactFrames
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="532">
            <Properties>
              <string name="Name">LightingSession</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Cleanup = require(script.Parent.Cleanup)

local LightingSession = {}
LightingSession.__index = LightingSession
local activeSession = nil

local LIGHTING_PROPERTIES = {
	Ambient = "Color3",
	Brightness = "number",
	ClockTime = "number",
	ColorShift_Bottom = "Color3",
	ColorShift_Top = "Color3",
	EnvironmentDiffuseScale = "number",
	EnvironmentSpecularScale = "number",
	ExposureCompensation = "number",
	FogColor = "Color3",
	FogEnd = "number",
	FogStart = "number",
	GeographicLatitude = "number",
	GlobalShadows = "boolean",
	OutdoorAmbient = "Color3",
	ShadowSoftness = "number",
}

local CHILD_PROPERTIES = {
	BlurEffect = { Enabled = "boolean", Size = "number" },
	BloomEffect = { Enabled = "boolean", Intensity = "number", Size = "number", Threshold = "number" },
	Sky = {
		CelestialBodiesShown = "boolean", MoonAngularSize = "number", MoonTextureId = "string",
		SkyboxBk = "string", SkyboxDn = "string", SkyboxFt = "string",
		SkyboxLf = "string", SkyboxRt = "string", SkyboxUp = "string",
		SkyboxOrientation = "Vector3", StarCount = "number",
		SunAngularSize = "number", SunTextureId = "string",
	},
	Atmosphere = {
		Color = "Color3", Decay = "Color3", Density = "number",
		Glare = "number", Haze = "number", Offset = "number",
	},
	ColorCorrectionEffect = {
		Brightness = "number", Contrast = "number", Enabled = "boolean",
		Saturation = "number", TintColor = "Color3",
	},
	DepthOfFieldEffect = {
		Enabled = "boolean", FarIntensity = "number", FocusDistance = "number",
		InFocusRadius = "number", NearIntensity = "number",
	},
}

local function validateProperties(properties, allowed, label)
	assert(type(properties) == "table", `{label}.Properties must be a table`)
	for name, value in properties do
		local expected = allowed[name]
		assert(expected, `{label}.{name} cannot be set by a cutscene lighting profile`)
		assert(typeof(value) == expected, `{label}.{name} must be {expected}`)
		if expected == "number" then
			assert(value == value and math.abs(value) < math.huge, `{label}.{name} must be finite`)
		end
	end
end

function LightingSession.Validate(profile)
	assert(type(profile) == "table", "Cutscene Lighting must be a table")
	validateProperties(profile.Properties, LIGHTING_PROPERTIES, "Lighting")
	assert(type(profile.Children) == "table", "Lighting.Children must be an array")
	for index, child in profile.Children do
		assert(type(child) == "table", `Lighting.Children[{index}] must be a table`)
		assert(type(child.ClassName) == "string" and CHILD_PROPERTIES[child.ClassName],
			`Unsupported cutscene lighting child at index {index}`)
		assert(type(child.Name) == "string" and child.Name ~= "", `Lighting.Children[{index}] needs a name`)
		validateProperties(child.Properties, CHILD_PROPERTIES[child.ClassName], child.Name)
	end
	return true
end

local function isVisualChild(instance: Instance): boolean
	return instance:IsA("Sky") or instance:IsA("Atmosphere") or instance:IsA("PostEffect")
end

function LightingSession.new(profile)
	LightingSession.Validate(profile)
	-- Only one cutscene can own the client's rendered Lighting at a time.
	-- Retire the previous owner before taking a new baseline snapshot.
	if activeSession then
		activeSession:Destroy()
	end
	local self = setmetatable({
		SavedProperties = {},
		Owned = {},
		Connections = {},
		Parked = Instance.new("Folder"),
		Destroyed = false,
	}, LightingSession)
	self.Parked.Name = "SuspendedCutsceneLighting"
	local ok, err = xpcall(function()
		for name in profile.Properties do
			self.SavedProperties[name] = Lighting[name]
		end
		for _, child in Lighting:GetChildren() do
			if isVisualChild(child) then
				child.Parent = self.Parked
			end
		end
		for name, value in profile.Properties do
			Lighting[name] = value
		end
		for _, definition in profile.Children do
			local child = Instance.new(definition.ClassName)
			table.insert(self.Owned, child)
			child.Name = definition.Name
			for name, value in definition.Properties do
				child[name] = value
			end
			child.Parent = Lighting
		end
		-- A day/night tween or a settings update can otherwise overwrite the shot.
		for name, value in profile.Properties do
			table.insert(self.Connections, Lighting:GetPropertyChangedSignal(name):Connect(function()
				if not self.Destroyed and Lighting[name] ~= value then
					Lighting[name] = value
				end
			end))
		end
	end, debug.traceback)
	if not ok then
		self:Destroy()
		error(err, 0)
	end
	activeSession = self
	return self
end

function LightingSession:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	if activeSession == self then
		activeSession = nil
	end
	for _, connection in self.Connections do
		connection:Disconnect()
	end
	for _, child in self.Owned do
		Cleanup.Try("Cutscene lighting child", function() child:Destroy() end)
	end
	for name, value in self.SavedProperties do
		Cleanup.Try("Lighting." .. name, function() Lighting[name] = value end)
	end
	for _, child in self.Parked:GetChildren() do
		Cleanup.Try("Restore Lighting child " .. child.Name, function() child.Parent = Lighting end)
	end
	self.Parked:Destroy()
end

return LightingSession
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="533">
            <Properties>
              <string name="Name">LocalActorView</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Cleanup = require(script.Parent.Cleanup)

local BODY_PARTS = {
	HumanoidRootPart = true, Head = true, Torso = true,
	["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
	UpperTorso = true, LowerTorso = true,
	LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
	RightUpperArm = true, RightLowerArm = true, RightHand = true,
	LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
	RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
}
local SCALE_PROPERTIES = {
	"HeightScale", "WidthScale", "DepthScale", "HeadScale", "BodyTypeScale", "ProportionScale",
}

local LocalActorView = {}
LocalActorView.__index = LocalActorView

function LocalActorView.new(name: string, source: Model, animationId: number, tracks: { AnimationTrack }, isCurrent: () -> boolean)
	return setmetatable({
		Name = name,
		Source = source,
		AnimationId = animationId,
		Tracks = tracks,
		IsCurrent = isCurrent,
		Closed = false,
		Finished = false,
		Committed = false,
		Hidden = {},
	}, LocalActorView)
end

function LocalActorView:_alive(): boolean
	return not self.Closed and self.Source.Parent ~= nil and self.IsCurrent()
end

function LocalActorView:_hideSource(item: Instance)
	local source = self.RigModel or self.Source
	if not item:IsDescendantOf(source) then return end
	local part = if item:IsA("BasePart") then item else item.Parent
	local isAppearance = part and part.Parent == source and BODY_PARTS[part.Name] == true
	local ancestor = item
	while ancestor and ancestor ~= source do
		if ancestor:IsA("Accessory") then
			isAppearance = true
			break
		end
		ancestor = ancestor.Parent
	end
	if not isAppearance then return end -- Leave authored weapons and VFX alone.
	local property = if item:IsA("BasePart") then "LocalTransparencyModifier"
		elseif item:IsA("Decal") then "Transparency" else nil
	if property then
		table.insert(self.Hidden, { Instance = item, Property = property, Value = item[property] })
		item[property] = 1
	end
end

function LocalActorView:_build(deadline: number)
	local source = self.Source
	local sourceRoot = assert(source:FindFirstChild("HumanoidRootPart", true), `{self.Name} needs HumanoidRootPart`)
	assert(sourceRoot:IsA("BasePart"), `{self.Name} HumanoidRootPart must be a BasePart`)
	self.RigModel = if sourceRoot.Parent and sourceRoot.Parent:IsA("Model") then sourceRoot.Parent else source
	local sourceHumanoid = self.RigModel:FindFirstChildOfClass("Humanoid")
	local rigType = if sourceHumanoid then sourceHumanoid.RigType
		elseif self.RigModel:FindFirstChild("UpperTorso") then Enum.HumanoidRigType.R15
		elseif self.RigModel:FindFirstChild("Torso") then Enum.HumanoidRigType.R6 else nil
	assert(rigType, `{self.Name} needs a standard R6 or R15 skeleton`)

	local player = Players.LocalPlayer
	local characterHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local description = nil
	if characterHumanoid and player:HasAppearanceLoaded() then
		local applied, result = pcall(function() return characterHumanoid:GetAppliedDescription() end)
		if applied then description = result end
	end
	if not description then
		description = Players:GetHumanoidDescriptionFromUserIdAsync(player.UserId)
	end
	if not self:_alive() then description:Destroy(); return end
	local authored = nil
	if sourceHumanoid then
		local applied, result = pcall(function() return sourceHumanoid:GetAppliedDescription() end)
		if applied then authored = result end
	end
	if authored then
		for _, property in SCALE_PROPERTIES do
			description[property] = authored[property]
		end
		authored:Destroy()
	end

	local made, model = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(description, rigType)
	end)
	description:Destroy()
	assert(made, tostring(model))
	if not self:_alive() then model:Destroy(); return end
	self.Model = model
	model.Name = `LocalCutscene_{self.Name}`
	model:SetAttribute("ActorUserId", player.UserId)
	local root = assert(model:FindFirstChild("HumanoidRootPart"), "Player avatar has no root")
	assert(root:IsA("BasePart"), "Player avatar root must be a BasePart")
	local humanoid = assert(model:FindFirstChildOfClass("Humanoid"), "Player avatar has no Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.AutoRotate = false
	humanoid.BreakJointsOnDeath = false
	humanoid.EvaluateStateMachine = false

	local visibility = {}
	for _, item in model:GetDescendants() do
		if item:IsA("BaseScript") then
			item:Destroy()
		elseif item:IsA("BasePart") then
			item.Anchored = item == root
			item.CanCollide, item.CanTouch, item.CanQuery = false, false, false
			item.Massless = true
			visibility[item] = { Property = "LocalTransparencyModifier", Value = item.LocalTransparencyModifier }
			item.LocalTransparencyModifier = 1
		elseif item:IsA("Decal") then
			visibility[item] = { Property = "Transparency", Value = item.Transparency }
			item.Transparency = 1
		end
	end
	model:ScaleTo(self.RigModel:GetScale())
	model:PivotTo(sourceRoot.CFrame * root.CFrame:Inverse() * model:GetPivot())
	model.Parent = workspace -- The real Player.Character is never moved or replaced.
	self.Root = root
	self.SourceRoot = sourceRoot
	self.Animation = Instance.new("Animation")
	self.Animation.AnimationId = `rbxassetid://{self.AnimationId}`
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = humanoid
	self.Track = animator:LoadAnimation(self.Animation)
	self.Track.Priority = Enum.AnimationPriority.Action4
	self.Track.Looped = false
	self.Track:Play(0, 1, 0)
	local animationDeadline = math.min(deadline, os.clock() + 3)
	while self:_alive() and os.clock() < animationDeadline and self.Track.Length <= 0 do
		RunService.Heartbeat:Wait()
	end
	if not self:_alive() then return end
	if self.Track.Length <= 0 then
		warn(`[CutsceneActors] {self.Name} avatar animation {self.AnimationId} was unavailable; using the personalized model in its default pose`)
		self.Track:Stop(0)
		self.Track:Destroy()
		self.Track = nil
		self.Animation:Destroy()
		self.Animation = nil
	else
	self.Track:AdjustSpeed(0)
	self.Track.TimePosition = 0
	end

	-- Keep the authored rig, its joints, props, and effect targets. Hide only
	-- its body after the personal avatar has a working animation track.
	for _, item in source:GetDescendants() do self:_hideSource(item) end
	self.Connection = source.DescendantAdded:Connect(function(item) self:_hideSource(item) end)
	if sourceHumanoid then
		table.insert(self.Hidden, {
			Instance = sourceHumanoid, Property = "DisplayDistanceType", Value = sourceHumanoid.DisplayDistanceType,
		})
		sourceHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	for item, saved in visibility do
		if item.Parent then item[saved.Property] = saved.Value end
	end
	if self.Track then table.insert(self.Tracks, self.Track) end
	self.Committed = true
end

function LocalActorView:Prepare(timeout: number): boolean
	local deadline = os.clock() + timeout
	task.spawn(function()
		local ok, err = xpcall(function() self:_build(deadline) end, debug.traceback)
		self.Finished = true
		if not ok then
			warn(`[CutsceneActors] {self.Name} avatar failed: {tostring(err)}`)
		end
	end)
	while self:_alive() and not self.Finished and os.clock() < deadline do
		RunService.Heartbeat:Wait()
	end
	if not self.Finished or not self.Committed then
		if not self.Finished and self:_alive() then
			warn(`[CutsceneActors] {self.Name} avatar construction exceeded {timeout}s`)
		end
		self:Destroy()
		return false
	end
	return true
end

function LocalActorView:PreAnimation()
	if self.Committed and self:_alive() and self.Root.Parent and self.SourceRoot.Parent then
		self.Root.CFrame = self.SourceRoot.CFrame
	end
end

function LocalActorView:Destroy()
	if self.Closed then return end
	self.Closed = true
	if self.Connection then self.Connection:Disconnect(); self.Connection = nil end
	for _, saved in self.Hidden do
		Cleanup.Try("Restore actor appearance", function()
			if saved.Instance.Parent then saved.Instance[saved.Property] = saved.Value end
		end)
	end
	table.clear(self.Hidden)
	if self.Track then
		local index = table.find(self.Tracks, self.Track)
		if index then table.remove(self.Tracks, index) end
		Cleanup.Try("Stop avatar track", function() self.Track:Stop(0) end)
		Cleanup.Try("Destroy avatar track", function() self.Track:Destroy() end)
		self.Track = nil
	end
	if self.Animation then self.Animation:Destroy(); self.Animation = nil end
	if self.Model then self.Model:Destroy(); self.Model = nil end
end

return LocalActorView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="534">
            <Properties>
              <string name="Name">LocalAudio</string>
              <string name="Source"><![CDATA[local SoundService = game:GetService("SoundService")

local LocalAudio = {}
LocalAudio.__index = LocalAudio

function LocalAudio.new(config)
	local sound = Instance.new("Sound")
	sound.Name = "CutsceneAudio"
	sound.SoundId = `rbxassetid://{config.SoundId}`
	sound.Volume = config.Volume or 1
	sound.Looped = false
	sound.Parent = SoundService
	return setmetatable({ Sound = sound, Paused = false, Destroyed = false }, LocalAudio)
end

-- Called with the same elapsed time as poses, camera, FOV, and screen effects.
function LocalAudio:Step(elapsed: number, paused: boolean)
	if self.Destroyed then return end
	local sound = self.Sound
	if not sound.IsLoaded then
		if elapsed >= 8 and not self.Warned then
			self.Warned = true
			warn(`[CutsceneAudio] {sound.SoundId} has not loaded; check asset permissions.`)
		end
		return
	end
	if sound.TimeLength > 0 and elapsed >= sound.TimeLength then
		if sound.IsPlaying then sound:Stop() end
		return
	end
	if paused then
		if sound.IsPlaying then
			sound:Pause()
			self.Paused = true
		end
		return
	end
	if self.Paused then
		sound.TimePosition = elapsed
		sound:Resume()
		self.Paused = false
		return
	end
	if not sound.IsPlaying then
		-- Play resets TimePosition; seek immediately after starting, including
		-- when the asset loads after the cutscene has already begun.
		sound:Play()
		sound.TimePosition = elapsed
	elseif math.abs(sound.TimePosition - elapsed) > 0.15 then
		-- Correct actual drift without seeking on every rendered frame.
		sound.TimePosition = elapsed
	end
end

function LocalAudio:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	self.Sound:Stop()
	self.Sound:Destroy()
end

return LocalAudio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="535">
            <Properties>
              <string name="Name">LocalVFX</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ScenePaths = require(script.Parent.ScenePaths)

local LocalVFX = {}
LocalVFX.__index = LocalVFX

function LocalVFX.new(sceneRoots: { Instance }, events)
	local targets = {}
	for key, path in ScenePaths.Collect(events) do
		local target, reason = ScenePaths.ResolveTopLevel(sceneRoots, path)
		if target then
			targets[key] = target
		else
			warn(`[CutsceneVFX] {reason} (disabled for this playback)`)
		end
	end

	local frames = {}
	for frame in events do
		table.insert(frames, frame)
	end
	table.sort(frames)

	local forge = require(ReplicatedStorage.Shared.Modules.Utils.EmitModule)
	forge.init()
	local particles = nil
	for _, event in events do
		if event.AbsoluteEmit then
			local module = ReplicatedStorage:FindFirstChild("Part_Icles")
			if module then
				local ok, result = pcall(require, module)
				if ok then particles = result else warn(`[CutsceneVFX] {tostring(result)}`) end
			else
				warn("[CutsceneVFX] ReplicatedStorage.Part_Icles is missing; AbsoluteEmit is unavailable")
			end
			break
		end
	end
	return setmetatable({
		Events = events,
		Frames = frames,
		NextIndex = 1,
		Targets = targets,
		Forge = forge,
		Particles = particles,
		Handles = {},
		Warned = {},
		Destroyed = false,
	}, LocalVFX)
end

function LocalVFX:Run(event)
	if self.Destroyed then return end
	local function emitPaths(paths, callback)
		for _, path in paths or {} do
			if self.Destroyed then return end
			local key = ScenePaths.Key(path)
			local target = self.Targets[key]
			if not target then continue end
			if not target:IsDescendantOf(workspace) then
				if not self.Warned[key] then
					self.Warned[key] = true
					warn(`[CutsceneVFX] Target was removed: {table.concat(path, ".")}`)
				end
				continue
			end
			local ok, result = pcall(callback, target)
			if not ok then
				warn(`[CutsceneVFX] {table.concat(path, ".")}: {tostring(result)}`)
			elseif type(result) == "table" and result.Clear and result.Finished then
				if self.Destroyed then
					result:Clear()
				else
					self.Handles[result] = true
					result.Finished:finally(function()
						self.Handles[result] = nil
					end):catch(function(err)
						warn(`[CutsceneVFX] Emit failed: {tostring(err)}`)
					end)
				end
			end
		end
	end
	emitPaths(event.Emit, function(target) return self.Forge.emit(target) end)
	if self.Particles and event.AbsoluteEmit then
		local ok, err = pcall(function() self.Particles:Activate() end)
		if not ok then warn(`[CutsceneVFX] {tostring(err)}`); return end
		emitPaths(event.AbsoluteEmit, function(target) return self.Particles:AbsoluteEmit(target) end)
	end
end

function LocalVFX:Step(frame: number)
	if self.Destroyed then return end
	while self.NextIndex <= #self.Frames and self.Frames[self.NextIndex] <= frame + 1e-4 do
		local event = self.Events[self.Frames[self.NextIndex]]
		self.NextIndex += 1 -- Reserve before running an effect that may yield.
		task.spawn(function()
			self:Run(event)
		end)
	end
end

function LocalVFX:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	local handles = {}
	for handle in self.Handles do table.insert(handles, handle) end
	for _, handle in handles do
		local ok, err = pcall(handle.Clear, handle)
		if not ok then warn(`[CutsceneVFX] Cleanup: {tostring(err)}`) end
	end
	table.clear(self.Handles)
	table.clear(self.Targets)
end

return LocalVFX
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="536">
            <Properties>
              <string name="Name">MoonLightingTracks</string>
              <string name="Source"><![CDATA[-- Converts Moon Animator 2 Lighting Exporter v1.0.0 data to the cutscene's
-- clock-driven screen effect format. The export stays immutable and data-only.
local MoonLightingTracks = {}

local PROPERTY_TYPES = {
	Brightness = "number",
	Contrast = "number",
	Enabled = "boolean",
	Saturation = "number",
	TintColor = "Color3",
}

local function finiteNumber(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function MoonLightingTracks.ColorCorrection(export, itemId)
	assert(type(export) == "table" and type(export.Meta) == "table", "Moon lighting export needs Meta")
	local meta = export.Meta
	assert(meta.Format == "MoonAnimator2LightingTracks", "Unsupported Moon lighting export format")
	assert(meta.ExporterVersion == "1.0.0", "Unsupported Moon lighting exporter version")
	assert(finiteNumber(meta.FPS) and meta.FPS > 0, "Moon lighting FPS must be positive")
	assert(finiteNumber(meta.LengthFrames) and meta.LengthFrames > 0
		and meta.LengthFrames % 1 == 0, "Moon lighting LengthFrames must be a positive integer")
	assert(type(export.Items) == "table" and type(export.ItemOrder) == "table", "Moon lighting export needs Items and ItemOrder")
	assert(meta.ItemCount == #export.ItemOrder, "Moon lighting ItemCount does not match ItemOrder")
	assert(finiteNumber(meta.LengthSeconds)
		and math.abs(meta.LengthSeconds - meta.LengthFrames / meta.FPS) < 1e-4,
		"Moon lighting length does not match FPS")
	if itemId == nil then
		assert(#export.ItemOrder == 1, "Select an ItemId when the Moon lighting export contains multiple items")
		itemId = export.ItemOrder[1]
	end
	local found = false
	for _, orderedId in export.ItemOrder do
		if orderedId == itemId then found = true; break end
	end
	assert(found, `Moon lighting ItemId {itemId} is not in ItemOrder`)
	local item = assert(export.Items[itemId], `Moon lighting ItemId {itemId} is missing`)
	assert(item.ItemId == itemId and type(item.Target) == "table", "Moon lighting item identity is invalid")
	local target = item.Target
	assert(target.ClassName == "ColorCorrectionEffect"
		and target.ItemType == "ColorCorrectionEffect"
		and target.ItemId == itemId, "Moon lighting item must target a ColorCorrectionEffect")
	assert(type(target.InstanceNames) == "table" and target.InstanceNames[1] == "game"
		and target.InstanceNames[2] == "Lighting" and target.InstanceNames[3] == target.Name
		and type(target.Name) == "string" and target.Name ~= "", "Moon lighting target must be under game.Lighting")
	assert(target.Path == `game.Lighting.{target.Name}`,
		"Moon lighting target path does not match game.Lighting")
	assert(type(item.Properties) == "table", "Moon lighting item needs Properties")

	local tracks = {}
	local propertyCount = 0
	local keyframeCount = 0
	for name, property in item.Properties do
		local expected = assert(PROPERTY_TYPES[name], `Unsupported Moon ColorCorrectionEffect property: {name}`)
		assert(type(property) == "table" and property.Name == name,
			`Moon lighting property {name} has an invalid name`)
		assert(property.DefaultType == expected and property.HasDefault == true
			and typeof(property.Default) == expected, `Moon lighting {name} has an invalid default`)
		assert(type(property.Keyframes) == "table", `Moon lighting {name} needs Keyframes`)
		assert(property.KeyframeCount == #property.Keyframes,
			`Moon lighting {name} KeyframeCount does not match the export`)
		local lastFrame = -1
		for _, key in property.Keyframes do
			assert(finiteNumber(key.Frame) and key.Frame % 1 == 0
				and key.Frame > lastFrame and key.Frame <= meta.LengthFrames,
				`Moon lighting {name} has an invalid key frame`)
			assert(key.ValueType == expected and typeof(key.Value) == expected,
				`Moon lighting {name} has an invalid key value`)
			assert(finiteNumber(key.Time) and math.abs(key.Time - key.Frame / meta.FPS) < 1e-4,
				`Moon lighting {name} key time does not match FPS`)
			if expected == "number" then
				assert(finiteNumber(key.Value), `Moon lighting {name} has a nonfinite value`)
			end
			lastFrame = key.Frame
		end
		if expected == "number" then
			assert(finiteNumber(property.Default), `Moon lighting {name} has a nonfinite default`)
		end
		-- Sequence keeps each original key's outgoing Ease for PropertyTrack.
		tracks[name] = { Default = property.Default, Sequence = property.Keyframes }
		propertyCount += 1
		keyframeCount += #property.Keyframes
	end
	assert(propertyCount == item.PropertyCount and keyframeCount == item.KeyframeCount,
		"Moon lighting item counts do not match the export")
	if meta.ItemCount == 1 then
		assert(propertyCount == meta.PropertyCount and keyframeCount == meta.KeyframeCount,
			"Moon lighting total counts do not match the export")
	end
	return {
		Name = target.Name,
		Tracks = tracks,
		EndFrame = meta.LengthFrames,
		-- The export's Time fields are Frame / FPS. Preserve that clock rather
		-- than stretching flashes to an animation asset's reported length.
		FPS = meta.FPS,
	}
end

return MoonLightingTracks
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="537">
            <Properties>
              <string name="Name">PlaybackClock</string>
              <string name="Source"><![CDATA[local PlaybackClock = {}

function PlaybackClock.Elapsed(state, now)
	local start = state:GetAttribute("StartedAt")
	return if start then math.max(0, now - start) else 0
end

function PlaybackClock.Apply(tracks, elapsed)
	for _, track in tracks do
		-- Recover a stopped track instead of silently leaving the actor frozen.
		if not track.IsPlaying then track:Play(0, 1, 0) end
		-- No independent advancement between sampling and pose evaluation.
		track:AdjustSpeed(0)
		track.TimePosition = math.clamp(elapsed, 0, math.max(0, track.Length - 0.000001))
	end
end

function PlaybackClock.Duration(cameraLength, maximum)
	assert(type(cameraLength) == "number" and cameraLength > 0 and cameraLength < math.huge, "Invalid camera duration")
	maximum = maximum or 60
	assert(maximum > 0 and maximum < math.huge, "Invalid maximum duration")
	return math.min(cameraLength, maximum)
end

return PlaybackClock
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="538">
            <Properties>
              <string name="Name">Prepare</string>
              <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Prepare = {}

-- External asset loaders must not indefinitely prevent the camera-ready signal.
function Prepare.Try(label, timeout, callback, onCancel)
	local finished, success, result = false, false, nil
	local thread = task.spawn(function()
		success, result = pcall(callback)
		finished = true
	end)
	local deadline = os.clock() + timeout
	while not finished and os.clock() < deadline do RunService.Heartbeat:Wait() end
	if not finished then
		if onCancel then pcall(onCancel) end
		pcall(task.cancel, thread)
		local message = label .. " timed out after " .. timeout .. "s"
		warn("[CutscenePrepare] " .. message)
		return false, nil, message
	end
	if not success then
		if onCancel then pcall(onCancel) end
		warn("[CutscenePrepare] " .. label .. ": " .. tostring(result))
		return false, nil, result
	end
	return true, result, nil
end

-- Independent bounded jobs share the preparation window instead of stacking it.
function Prepare.All(jobs)
	local results = {}
	local pending = 0
	for _ in jobs do pending += 1 end
	for name, job in jobs do
		task.spawn(function()
			local ok, value, err = Prepare.Try(name, job.Timeout, job.Run, job.Cancel)
			results[name] = { Success = ok, Value = value, Error = err }
			pending -= 1
		end)
	end
	while pending > 0 do RunService.Heartbeat:Wait() end
	return results
end

return Prepare
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="539">
            <Properties>
              <string name="Name">ScenePaths</string>
              <string name="Source"><![CDATA[local ScenePaths = {}

function ScenePaths.Key(path)
	assert(#path > 0, "Empty VFX path")
	local segments = {}
	for _, name in path do
		assert(type(name) == "string" and name ~= "", "Invalid VFX path segment")
		table.insert(segments, #name .. ":" .. name)
	end
	return table.concat(segments)
end

function ScenePaths.Collect(events)
	local paths = {}
	for _, event in events or {} do
		for _, kind in { "Emit", "AbsoluteEmit" } do
			for _, path in event[kind] or {} do paths[ScenePaths.Key(path)] = path end
		end
	end
	return paths
end

local function finishResolve(candidates, path)
	for index = 2, #path do
		local nextCandidates = {}
		for _, current in candidates do
			for _, child in current:GetChildren() do
				if child.Name == path[index] then table.insert(nextCandidates, child) end
			end
		end
		candidates = nextCandidates
	end
	if #candidates == 1 then return candidates[1] end
	if #candidates == 0 then return nil, "Missing scene path: " .. table.concat(path, ".") end
	local names = {}
	for _, candidate in candidates do table.insert(names, candidate:GetFullName()) end
	return nil, "Ambiguous scene path: " .. table.concat(path, ".") .. " -> " .. table.concat(names, ", ")
end

-- Local scenes retain a single cloned container. The first segment names one
-- of its direct children; every later segment names a direct child of the
-- previous segment. Descendants with the same name cannot shadow that path.
function ScenePaths.ResolveTopLevel(containers, path)
	local candidates = {}
	for _, container in containers do
		for _, child in container:GetChildren() do
			if child.Name == path[1] then table.insert(candidates, child) end
		end
	end
	return finishResolve(candidates, path)
end

-- Server cutscenes mount each top-level scene object separately. Preserve
-- their existing unique-descendant shorthand until those assets are migrated.
function ScenePaths.Resolve(roots, path)
	local candidates = {}
	for _, root in roots do
		if root.Name == path[1] then table.insert(candidates, root) end
	end
	if #candidates == 0 then
		for _, root in roots do
			for _, child in root:GetDescendants() do
				if child.Name == path[1] then table.insert(candidates, child) end
			end
		end
	end
	return finishResolve(candidates, path)
end

return ScenePaths
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="540">
            <Properties>
              <string name="Name">SceneTransform</string>
              <string name="Source"><![CDATA[local SceneTransform = {}

local POSITION_TOLERANCE = 0.025
local AXIS_DOT_TOLERANCE = 0.99999

local function move(instance: Instance, transform: CFrame)
	if instance:IsA("PVInstance") then
		instance:PivotTo(transform * instance:GetPivot())
		return
	end
	for _, child in instance:GetChildren() do
		move(child, transform)
	end
end

-- Apply one world-space transform while the complete clone is still off-world.
-- A folder can contain several unrelated models, so moving only its camera or
-- a single model pivot would change the authored staging.
function SceneTransform.Apply(scene: Instance, transform: CFrame?): number
	if transform == nil then
		return 0
	end
	assert(typeof(transform) == "CFrame", "SceneTransform must be a CFrame")
	for _, component in { transform:GetComponents() } do
		assert(component == component and math.abs(component) < math.huge, "SceneTransform must be finite")
	end
	local originalParts = {}
	local originalModels = {}
	local partCount = 0
	local function capture(instance: Instance)
		if instance:IsA("BasePart") then
			originalParts[instance] = instance.CFrame
			partCount += 1
		elseif instance:IsA("Model") then
			originalModels[instance] = instance:GetPivot()
		end
	end
	capture(scene)
	for _, descendant in scene:GetDescendants() do
		capture(descendant)
	end
	assert(partCount > 0, `Cutscene scene "{scene.Name}" has no BaseParts to place`)

	move(scene, transform)

	local function matches(actual: CFrame, expected: CFrame): boolean
		return (actual.Position - expected.Position).Magnitude <= POSITION_TOLERANCE
			and actual.RightVector:Dot(expected.RightVector) >= AXIS_DOT_TOLERANCE
			and actual.UpVector:Dot(expected.UpVector) >= AXIS_DOT_TOLERANCE
	end
	for part, original in originalParts do
		assert(matches(part.CFrame, transform * original),
			`Cutscene placement changed the position of "{part:GetFullName()}"`)
	end
	for model, original in originalModels do
		assert(matches(model:GetPivot(), transform * original),
			`Cutscene placement changed the pivot of "{model:GetFullName()}"`)
	end
	return partCount
end

return SceneTransform
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="541">
            <Properties>
              <string name="Name">ScreenEffects</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local PropertyTrack = require(script.Parent.ECS.PropertyTrack)
local CubicBezier = require(script.Parent.ECS.CubicBezier)

local ScreenEffects = {}
ScreenEffects.__index = ScreenEffects
local PROPERTY_TYPES = {
	Enabled = "boolean", Saturation = "number", Contrast = "number",
	Brightness = "number", TintColor = "Color3",
}

local function enumValue(enumType, value, fallback)
	if typeof(value) == "EnumItem" then
		return if value.EnumType == enumType then value else fallback
	end
	if type(value) == "string" then
		return enumType[value]
	end
	return fallback
end

local function resolveEase(info)
	if type(info) == "string" or typeof(info) == "EnumItem" then
		info = { Type = info }
	end
	assert(type(info) == "table", "Ease must be a table, string, or EnumItem")

	local rawType = info.Type or info.Style or info.EasingStyle or "Linear"
	local typeName = if typeof(rawType) == "EnumItem" then rawType.Name else rawType
	-- Moon's None/Constant segments hold until the next authored key.
	if typeName == "None" or typeName == "Constant" then
		return function() return 0 end
	end
	if typeName == "Bezier" or typeName == "CubicBezier" then
		local ok, curve = pcall(CubicBezier.Create, info.Params)
		if ok then return curve end
		warn("[CutsceneScreen] Invalid Bezier; using Linear: " .. tostring(curve))
		return nil
	end
	local params = info.Params or {}
	local style = enumValue(Enum.EasingStyle, rawType, nil)
	local rawDirection = info.Direction or info.EasingDirection or params.Direction or params.Dir or "In"
	local direction = enumValue(Enum.EasingDirection, rawDirection, nil)
	if not style or not direction then
		warn("[CutsceneScreen] Invalid easing; using Linear")
		return nil
	end
	if style == Enum.EasingStyle.Linear then return nil end
	return function(alpha) return TweenService:GetValue(alpha, style, direction) end
end

local function prepareConfig(config)
	assert(type(config) == "table", "ScreenEffects config must be a table")
	assert(config.Name == nil or (type(config.Name) == "string" and config.Name ~= ""),
		"ScreenEffects.Name must be a nonempty string")
	assert(config.EndFrame > 0 and config.EndFrame < math.huge, "ScreenEffects.EndFrame must be positive and finite")
	assert(not config.FPS or (config.FPS > 0 and config.FPS < math.huge), "ScreenEffects.FPS must be positive and finite")
	local tracks = {}
	-- Validate/copy before creating any instance; exported frozen data stays untouched.
	assert(type(config.Tracks) == "table", "ScreenEffects.Tracks must be a property-track table")
	for property, keys in config.Tracks do
		local expectedType = assert(PROPERTY_TYPES[property], "Unsupported screen property: " .. property)
		tracks[property] = PropertyTrack.Prepare(keys, expectedType, resolveEase)
		local lastKey = tracks[property][#tracks[property]]
		assert(not lastKey or lastKey.Frame <= config.EndFrame,
			`ScreenEffects.{property} has a key after EndFrame ({config.EndFrame})`)
	end
	return tracks
end

function ScreenEffects.Validate(config): boolean
	prepareConfig(config)
	return true
end

function ScreenEffects.new(config)
	local tracks = prepareConfig(config)
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = config.Name or "CutsceneColorCorrection"
	effect.Enabled = false
	effect.Saturation = 0
	effect.Contrast = 0
	effect.Brightness = 0
	effect.TintColor = Color3.new(1, 1, 1)
	-- Local, session-owned instance: never overwrite the map's existing effects.
	effect.Parent = Lighting
	return setmetatable({ Effect = effect, Tracks = tracks, EndFrame = config.EndFrame }, ScreenEffects)
end

function ScreenEffects:ApplyFrame(frame, playing)
	if self.Destroyed then return end
	if not playing then
		self.Effect.Enabled = false
		return
	end
	frame = math.clamp(frame, 0, self.EndFrame)
	local enabled = true
	for property, track in self.Tracks do
		-- Preserve authored values: Saturation > 1 and high Contrast are valid.
		local value = PropertyTrack.Read(track, frame)
		if value ~= nil then
			if property == "Enabled" then enabled = value else self.Effect[property] = value end
		end
	end
	self.Effect.Enabled = enabled
end

function ScreenEffects:Destroy()
	if self.Destroyed then return end
	self.Destroyed = true
	-- Neutralize before removal so a delayed render cannot show the last dark key.
	self.Effect.Enabled = false
	self.Effect.Brightness = 0
	self.Effect.Contrast = 0
	self.Effect.Saturation = 0
	self.Effect.TintColor = Color3.new(1, 1, 1)
	self.Effect:Destroy()
end

return ScreenEffects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="542">
            <Properties>
              <string name="Name">VFXContext</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ScenePaths = require(script.Parent.ScenePaths)
local VFXContext = {}
VFXContext.__index = VFXContext

function VFXContext.new(state, events)
	local wanted = ScenePaths.Collect(events)
	local targets, unavailable = {}, {}
	local deadline = os.clock() + 20
	local pending = {}
	repeat
		assert(state.Parent, "Cutscene removed during VFX preparation")
		table.clear(pending)
		local manifest = state:FindFirstChild("VFXTargets")
		local references = {}
		for _, reference in if manifest then manifest:GetChildren() else {} do
			local key = reference:GetAttribute("PathKey")
			if key then references[key] = reference end
		end
		for key, path in wanted do
			local reference = references[key]
			local reason = reference and reference:GetAttribute("Unavailable")
			local target = reference and reference.Value
			local descendantCount = reference and reference:GetAttribute("DescendantCount")
			if reason then
				unavailable[key] = reason
			elseif target and target:IsDescendantOf(workspace) and descendantCount
				and #target:GetDescendants() >= descendantCount then
				targets[key] = target
			else
				table.insert(pending, table.concat(path, "."))
			end
		end
		if #pending == 0 then break end
		assert(os.clock() < deadline, "VFX replication timed out: " .. table.concat(pending, ", "))
		RunService.Heartbeat:Wait()
	until false
	for _, reason in unavailable do warn("[CutsceneVFX] " .. reason .. " (disabled for this playback)") end
	local forge = require(ReplicatedStorage.Shared.Modules.Utils.EmitModule)
	forge.init()
	local particles = nil
	for _, event in events do
		if event.AbsoluteEmit then
			local module = ReplicatedStorage:WaitForChild("Part_Icles", 3)
			if module then
				local ok, result = pcall(require, module)
				if ok then particles = result else warn("[CutsceneVFX] " .. tostring(result)) end
			else
				warn("[CutsceneVFX] ReplicatedStorage.Part_Icles is missing; AbsoluteEmit is unavailable")
			end
			break
		end
	end
	return setmetatable({ State = state, Targets = targets, Forge = forge, Particles = particles,
		Handles = {}, Warned = {}, Destroyed = false }, VFXContext)
end

function VFXContext:Run(event)
	if self.Destroyed or not self.State.Parent then return end
	local function emitPaths(paths, callback)
		for _, path in paths or {} do
			if self.Destroyed or not self.State.Parent then return end
			local key = ScenePaths.Key(path)
			local target = self.Targets[key]
			if not target then continue end -- diagnosed during preparation
			if not target:IsDescendantOf(workspace) then
				if not self.Warned[key] then
					self.Warned[key] = true
					warn("[CutsceneVFX] Prepared target was removed: " .. table.concat(path, "."))
				end
				continue
			end
			local ok, result = pcall(callback, target)
			if not ok then
				warn("[CutsceneVFX] " .. table.concat(path, ".") .. ": " .. tostring(result))
			elseif type(result) == "table" and result.Clear and result.Finished then
				if self.Destroyed then result:Clear(); continue end
				self.Handles[result] = true
				result.Finished:finally(function() self.Handles[result] = nil end):catch(function(err)
					warn("[CutsceneVFX] Emit failed: " .. tostring(err))
				end)
			end
		end
	end
	emitPaths(event.Emit, function(target) return self.Forge.emit(target) end)
	if self.Particles and event.AbsoluteEmit then
		local ok, err = pcall(function() self.Particles:Activate() end)
		if not ok then warn("[CutsceneVFX] " .. tostring(err)); return end
		emitPaths(event.AbsoluteEmit, function(target) return self.Particles:AbsoluteEmit(target) end)
	end
end

function VFXContext:Destroy()
	self.Destroyed = true
	-- Snapshot because completion callbacks can remove handles during cancellation.
	local handles = {}
	for handle in self.Handles do table.insert(handles, handle) end
	for _, handle in handles do
		local ok, err = pcall(handle.Clear, handle)
		if not ok then warn("[CutsceneVFX] Cleanup: " .. tostring(err)) end
	end
	table.clear(self.Handles)
	table.clear(self.Targets)
end

return VFXContext
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="543">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="544">
            <Properties>
              <string name="Name">ButtonEffects</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local ButtonEffects = {}

local isPressing = false
local isClicked = false

local DEFAULT_SCALE = 1
local PRESSED_SCALE = 0.88
local TWEEN_INFO = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

type EffectOptions = {
	hoverScale: number?,
	pressScale: number?,
	period: number?,
	damping: number?,
}

function ButtonEffects.ApplyPressEffect(button, pressedScale)
	pressedScale = pressedScale or PRESSED_SCALE

	local scale = button:FindFirstChild("PressScale") or Instance.new("UIScale")
	scale.Name = "PressScale"
	scale.Scale = DEFAULT_SCALE
	scale.Parent = button

	local tween

	local function play(targetScale)
		if tween then
			tween:Cancel()
		end

		tween = TweenService:Create(scale, TWEEN_INFO, {
			Scale = targetScale,
		})

		tween:Play()
	end

	local down = button.MouseButton1Down:Connect(function()
		isPressing = true
		play(pressedScale)
	end)

	local up = button.MouseButton1Up:Connect(function()
		isPressing = false
		if not isClicked then
			play(DEFAULT_SCALE)
		end
	end)

	local leave = button.MouseLeave:Connect(function()
		play(DEFAULT_SCALE)
	end)

	local activated = button.MouseButton1Click:Connect(function()
		isClicked = true
		play(pressedScale)

		task.delay(0.05, function()
			isClicked = false
			if not isPressing then
				play(DEFAULT_SCALE)
			end
		end)
	end)

	return function()
		down:Disconnect()
		up:Disconnect()
		leave:Disconnect()
		activated:Disconnect()

		if tween then
			tween:Cancel()
		end

		scale.Scale = DEFAULT_SCALE
	end
end

return ButtonEffects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="545">
            <Properties>
              <string name="Name">ColorSequenceScroll</string>
              <string name="Source"><![CDATA[-- Scroll a periodic palette by moving its stops, like wrapping texture UVs.
-- Only the two viewport edges need interpolated colors; interior colors stay intact.
local ColorSequenceScroll = {}

export type Palette = {
	Keypoints: { ColorSequenceKeypoint },
	Steps: number,
	IsSolid: boolean,
}

local MAX_STOPS = 20
local EDGE_EPSILON = 1e-6

local function evaluate(keypoints: { ColorSequenceKeypoint }, position: number): Color3
	for index = 2, #keypoints do
		local right = keypoints[index]
		if position <= right.Time then
			local left = keypoints[index - 1]
			local span = right.Time - left.Time
			return left.Value:Lerp(right.Value, if span > 0 then (position - left.Time) / span else 0)
		end
	end
	return keypoints[#keypoints].Value
end

function ColorSequenceScroll.Prepare(sequence: ColorSequence): Palette
	local keypoints = sequence.Keypoints
	local firstColor = keypoints[1].Value
	local isSolid = true
	for _, keypoint in keypoints do
		if keypoint.Value ~= firstColor then
			isSolid = false
			break
		end
	end

	local steps = #keypoints - 1
	if keypoints[#keypoints].Value ~= firstColor then
		steps += 1
		local scale = (steps - 1) / steps
		local closed = table.create(#keypoints + 1)
		for index, keypoint in keypoints do
			closed[index] = ColorSequenceKeypoint.new(keypoint.Time * scale, keypoint.Value)
		end
		closed[#closed + 1] = ColorSequenceKeypoint.new(1, firstColor)
		keypoints = closed
	end

	if #keypoints - 1 > MAX_STOPS - 2 then
		local resampled = table.create(MAX_STOPS - 1)
		for index = 0, MAX_STOPS - 2 do
			local position = index / (MAX_STOPS - 2)
			resampled[index + 1] = ColorSequenceKeypoint.new(position, evaluate(keypoints, position))
		end
		keypoints = resampled
	end

	return { Keypoints = keypoints, Steps = steps, IsSolid = isSolid }
end

function ColorSequenceScroll.Sample(palette: Palette, phase: number): ColorSequence
	phase %= 1
	local keypoints = palette.Keypoints
	local boundaryColor = evaluate(keypoints, (1 - phase) % 1)
	local shifted = table.create(#keypoints + 1)
	shifted[1] = ColorSequenceKeypoint.new(0, boundaryColor)

	local split = #keypoints
	for index = 1, #keypoints - 1 do
		if keypoints[index].Time + phase >= 1 then
			split = index
			break
		end
	end
	for index = split, #keypoints - 1 do
		local keypoint = keypoints[index]
		local position = keypoint.Time + phase - 1
		if position > EDGE_EPSILON and position < 1 - EDGE_EPSILON then
			shifted[#shifted + 1] = ColorSequenceKeypoint.new(position, keypoint.Value)
		end
	end
	for index = 1, split - 1 do
		local keypoint = keypoints[index]
		local position = keypoint.Time + phase
		if position > EDGE_EPSILON and position < 1 - EDGE_EPSILON then
			shifted[#shifted + 1] = ColorSequenceKeypoint.new(position, keypoint.Value)
		end
	end
	shifted[#shifted + 1] = ColorSequenceKeypoint.new(1, boundaryColor)
	return ColorSequence.new(shifted)
end

return ColorSequenceScroll
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="546">
            <Properties>
              <string name="Name">Emote</string>
            </Properties>
            <Item class="ModuleScript" referent="547">
              <Properties>
                <string name="Name">EmoteOverlay</string>
                <string name="Source"><![CDATA[-- Shared modal motion used by lobby and in-game emote wheels.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local spring = Vide.spring
local source = Vide.source
local effect = Vide.effect

export type Props = {
	Name: string,
	IsOpen: () -> boolean,
	OnClose: () -> (),
	Content: GuiObject,
}

return function(props: Props)
	local isMounted = source(false)
	local transition = 0

	effect(function()
		local isOpen = props.IsOpen()
		transition += 1
		local currentTransition = transition

		if isOpen then
			isMounted(true)
		else
			task.delay(0.48, function()
				if transition == currentTransition then
					isMounted(false)
				end
			end)
		end
	end)

	return create("Frame")({
		Name = props.Name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = isMounted,
		ZIndex = 20,

		create("TextButton")({
			Name = "Backdrop",
			Active = props.IsOpen,
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(7, 12, 22),
			BackgroundTransparency = spring(function()
				return if props.IsOpen() then 0.35 else 1
			end, 0.2, 0.9),
			Size = UDim2.fromScale(1, 1),
			Text = "",
			ZIndex = 20,
			Activated = props.OnClose,
		}),

		create("Frame")({
			Name = "Content",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			Rotation = spring(function()
				return if props.IsOpen() then 0 else -3
			end, 0.35, 0.8),
			Size = spring(function()
				return if props.IsOpen() then UDim2.fromScale(1, 1) else UDim2.fromScale(0, 0)
			end, 0.48, 0.78),
			ZIndex = 30,
			props.Content,
		}),
	})
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="548">
              <Properties>
                <string name="Name">EmoteRadialMenu</string>
                <string name="Source"><![CDATA[-- Shared radial emote menu used in every place.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerCharacter = require(script.Parent.PlayerCharacter)
local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local show = Vide.show
local source = Vide.source
local spring = Vide.spring

export type EmoteData = {
	Id: string?,
	Name: string?,
	EmoteName: string?,
	DisplayName: string?,
	AnimationId: (number | string)?,
	IntroAnimationId: (number | string)?,
	Looped: boolean?,
	PlaybackSpeed: number?,
	Image: string?,
	Symbol: string?,
}

export type Props = {
	Emotes: { () -> EmoteData? },
	EquipMode: (boolean | (() -> boolean))?,
	UserId: ((() -> number?) | number)?,
	OnSelected: (emoteName: string) -> (),
	OnSlotSelected: ((slotIndex: number, emoteName: string?) -> ())?,
	SlotActionText: (string | ((slotIndex: number, emoteName: string?) -> string))?,
	InteractionDisabled: (boolean | (() -> boolean))?,
	RenderPreview: ((slotIndex: number, getEntry: () -> EmoteData?) -> GuiObject)?,
}

type SlotConfig = {
	Index: number,
	Image: string,
	Shadow: string,
	Position: UDim2,
	AnchorPoint: Vector2,
	HighlightPosition: UDim2,
	ShadowPosition: UDim2,
	NamePosition: UDim2,
	NameSize: UDim2,
	TooltipPosition: UDim2,
}

local SLOT_CONFIGS: { SlotConfig } = {
	{
		Index = 1,
		Image = "rbxassetid://85375303952247",
		Shadow = "rbxassetid://75984171493972",
		Position = UDim2.fromScale(0.233624, 0.237624),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(0.579434, 0.604107),
		ShadowPosition = UDim2.fromScale(0.51564, 0.51378),
		NamePosition = UDim2.fromScale(0.525554, 0.810958),
		NameSize = UDim2.fromScale(0.451239, 0.140752),
		TooltipPosition = UDim2.fromScale(0.509879, 0.920447),
	},
	{
		Index = 2,
		Image = "rbxassetid://101263877757551",
		Shadow = "rbxassetid://133628792436402",
		Position = UDim2.fromScale(0.756624, 0.237624),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(0.375511, 0.59874),
		ShadowPosition = UDim2.fromScale(0.494174, 0.508413),
		NamePosition = UDim2.fromScale(0.489197, 0.800225),
		NameSize = UDim2.fromScale(0.813235, 0.140752),
		TooltipPosition = UDim2.fromScale(0.445483, 0.915081),
	},
	{
		Index = 3,
		Image = "rbxassetid://93847193101743",
		Shadow = "rbxassetid://101043806354019",
		Position = UDim2.fromScale(0.233624, 0.759624),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(0.547235, 0.330421),
		ShadowPosition = UDim2.fromScale(0.510274, 0.486948),
		NamePosition = UDim2.fromScale(0.548228, 0.12406),
		NameSize = UDim2.fromScale(0.813235, 0.140752),
		TooltipPosition = UDim2.fromScale(0.504513, 0.238916),
	},
	{
		Index = 4,
		Image = "rbxassetid://119095003806239",
		Shadow = "rbxassetid://96998108143818",
		Position = UDim2.fromScale(0.755624, 0.759624),
		AnchorPoint = Vector2.new(0.5, 0.5),
		HighlightPosition = UDim2.fromScale(0.396976, 0.28749),
		ShadowPosition = UDim2.fromScale(0.510274, 0.486948),
		NamePosition = UDim2.fromScale(0.473098, 0.12406),
		NameSize = UDim2.fromScale(0.813235, 0.140752),
		TooltipPosition = UDim2.fromScale(0.428, 0.238916),
	},
}

local function getSlotConfigs(count: number): { SlotConfig }
	if count <= #SLOT_CONFIGS then
		return SLOT_CONFIGS
	end

	local configs = table.create(count)
	for index = 1, count do
		local base = SLOT_CONFIGS[(index - 1) % #SLOT_CONFIGS + 1]
		local angle = -math.pi / 2 + (index - 1) * math.pi * 2 / count
		local position = UDim2.fromScale(0.5 + math.cos(angle) * 0.27, 0.5 + math.sin(angle) * 0.27)
		table.insert(configs, {
			Index = index,
			Image = base.Image,
			Shadow = base.Shadow,
			Position = position,
			AnchorPoint = Vector2.new(0.5, 0.5),
			HighlightPosition = UDim2.fromScale(-0.18, -0.18),
			ShadowPosition = UDim2.fromScale(0.5, 0.5),
			NamePosition = UDim2.fromScale(0.1, 0.78),
			NameSize = UDim2.fromScale(0.8, 0.14),
			TooltipPosition = UDim2.fromScale(0.3, 0.9),
		})
	end

	return configs
end

local function createCamera(): Camera
	return create("Camera")({
		FieldOfView = 50,
		CFrame = CFrame.lookAt(Vector3.new(0, 0, -5.5), Vector3.new(0, -0.3, 0)),
	})
end

local function createGradient(color: Color3)
	return create("UIGradient")({
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, color),
			ColorSequenceKeypoint.new(1, color),
		}),
	})
end

return function(props: Props)
	local emoteGetters = props.Emotes
	local slotConfigs = getSlotConfigs(#emoteGetters)
	local hoveredSlot = source(nil :: number?)
	local pressedSlot = source(nil :: number?)

	local slots = table.create(#slotConfigs)

	for _, config in slotConfigs do
		local emoteGetter = emoteGetters[config.Index]
		local function isEquipMode(): boolean
			return if type(props.EquipMode) == "function" then props.EquipMode() else props.EquipMode == true
		end
		local function canInteract(): boolean
			local disabled = props.InteractionDisabled
			local isDisabled = if type(disabled) == "function" then disabled() else disabled == true
			return not isDisabled and (isEquipMode() or emoteGetter() ~= nil)
		end
		local camera = createCamera()
		local direction = Vector2.new(
			if config.Index % 2 == 1 then -1 else 1,
			if config.Index <= 2 then -1 else 1
		)
		local offset = spring(function()
			if hoveredSlot() == config.Index then
				return 0.03
			elseif hoveredSlot() ~= nil then
				return 0.012
			end
			return 0
		end, 0.18, 0.78)

		table.insert(slots, create("ImageButton")({
			Name = `Emote{config.Index}`,
			Active = canInteract,
			Interactable = canInteract,
			AnchorPoint = config.AnchorPoint,
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			ClipsDescendants = false,
			Image = config.Image,
			ImageTransparency = spring(function()
				return if canInteract() and hoveredSlot() == config.Index then 0 else 0.08
			end, 0.16, 0.82),
			Position = function()
				local amount = offset()
				return UDim2.fromScale(
					config.Position.X.Scale + direction.X * amount,
					config.Position.Y.Scale + direction.Y * amount
				)
			end,
			Rotation = spring(function()
				return if hoveredSlot() == config.Index then direction.X * 1.5 else 0
			end, 0.18, 0.78),
			Size = UDim2.fromScale(0.505, 0.505),
			ZIndex = 31,

			MouseEnter = function()
				hoveredSlot(config.Index)
			end,
			MouseLeave = function()
				if hoveredSlot() == config.Index then
					hoveredSlot(nil)
				end
				if pressedSlot() == config.Index then
					pressedSlot(nil)
				end
			end,
			MouseButton1Down = function()
				pressedSlot(config.Index)
			end,
			MouseButton1Up = function()
				if pressedSlot() == config.Index then
					pressedSlot(nil)
				end
			end,
			Activated = function()
				if not canInteract() then return end
				local emote = emoteGetter and emoteGetter()
				local emoteName = emote and (emote.EmoteName or emote.Name)
				if props.OnSlotSelected then
					props.OnSlotSelected(config.Index, emoteName)
				elseif emoteName then
					props.OnSelected(emoteName)
				end
			end,

			create("UIAspectRatioConstraint")({}),
			create("UIScale")({
				Scale = spring(function()
					if pressedSlot() == config.Index then
						return 0.9
					elseif hoveredSlot() == config.Index then
						return 1.14
					end
					return 1
				end, 0.12, 0.72),
			}),

			create("UIGradient")({
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(86, 86, 86)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(86, 86, 86)),
				}),
			}),

			if props.RenderPreview then props.RenderPreview(config.Index, emoteGetter) else create("ViewportFrame")({
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Position = UDim2.fromScale(0.510283, 0.498906),
				Size = UDim2.fromScale(0.886604, 0.916977),
				CurrentCamera = camera,
				ZIndex = 31,
				camera,

				show(emoteGetter, function()
					return PlayerCharacter({
						UseWorldModel = true,
						Origin = CFrame.new(0, -0.25, 1.5),
						AnimationId = function()
							local emote = emoteGetter()
							return if emote then emote.AnimationId else nil
						end,
						IntroAnimationId = function()
							local emote = emoteGetter()
							return if emote then emote.IntroAnimationId else nil
						end,
						Looped = function()
							local emote = emoteGetter()
							return emote ~= nil and emote.Looped == true
						end,
						PlaybackSpeed = (emoteGetter() and emoteGetter().PlaybackSpeed) or 1,
					})
				end),
			}),

			create("ImageLabel")({
				Name = "HighLight",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = "rbxassetid://84600302742722",
				ImageTransparency = spring(function()
					return if hoveredSlot() == config.Index then 0 else 1
				end, 0.16, 0.82),
				Position = config.HighlightPosition,
				Size = UDim2.fromScale(1.32613, 1.32613),
				ZIndex = -1,
				create("UIAspectRatioConstraint")({}),
				createGradient(Color3.fromRGB(86, 86, 86)),
			}),

			create("ImageLabel")({
				Name = "Shadow",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				Image = config.Shadow,
				Position = config.ShadowPosition,
				Size = UDim2.fromScale(0.941882, 0.941882),
				ZIndex = 33,
				create("UIAspectRatioConstraint")({}),
				createGradient(Color3.fromRGB(86, 86, 86)),
			}),

			create("TextLabel")({
				Name = "EmoteName",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = config.NamePosition,
				Size = config.NameSize,
				Text = function()
					local emote = emoteGetter()
					return if emote then (emote.DisplayName or emote.EmoteName or "") else "Empty"
				end,
				TextColor3 = function()
					return if emoteGetter() then Color3.new(1, 1, 1) else Color3.fromRGB(177, 177, 177)
				end,
				TextScaled = true,
				ZIndex = 35,
				create("UIGradient")({
					Color = ColorSequence.new(Color3.fromRGB(53, 76, 231), Color3.fromRGB(58, 212, 255)),
					Enabled = function() return emoteGetter() ~= nil end,
					Rotation = 90,
				}),
				create("UIStroke")({ Thickness = 3 }),
			}),

			create("TextLabel")({
				Name = "ToolTip",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.fromEnum(Enum.Font.FredokaOne),
				Position = config.TooltipPosition,
				Size = UDim2.fromScale(0.333149, 0.085883),
				Text = function()
					local actionText = props.SlotActionText
					local emote = emoteGetter()
					local emoteName = emote and (emote.EmoteName or emote.Name)
					if type(actionText) == "function" then return actionText(config.Index, emoteName) end
					return actionText or "Tap to play"
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,
				Visible = function() return emoteGetter() ~= nil or isEquipMode() end,
				ZIndex = 35,
				create("UIStroke")({ Thickness = 3 }),
				createGradient(Color3.fromRGB(193, 193, 193)),
			}),
		}))
	end

	return create("Frame")({
		Name = "Container",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.753032, 1),
		ZIndex = 30,

		create("UIAspectRatioConstraint")({
			AspectRatio = 1.547,
			AspectType = Enum.AspectType.ScaleWithParentSize,
		}),

		create("Frame")({
			Name = "Main",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.414108, 0.640625),
			ZIndex = 30,

			create("UIAspectRatioConstraint")({}),
			unpack(slots),
		}),
	})
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="549">
              <Properties>
                <string name="Name">LocalEmotePlayer</string>
                <string name="Source"><![CDATA[--// Shared LocalEmotePlayer
-- Manages the local player's emote animation playback:
-- creating/playing/stopping tracks, saving/restoring walkspeed,
-- and auto-stopping on jump/freefall.
--
-- Does NOT handle networking or sprint control — that's the controller's job.
-- Exposes OnAutoStopped callback for the controller to hook into.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EmoteData = require(ReplicatedStorage.Settings.Data.EmoteData)

-------------------------------------------------
--// Types
-------------------------------------------------
type EmoteConfig = EmoteData.EmoteConfig

-------------------------------------------------
--// Constants
-------------------------------------------------
local EMOTE_COOLDOWN = 0.2
local localPlayer = Players.LocalPlayer

-------------------------------------------------
--// LocalEmotePlayer Class
-------------------------------------------------
local LocalEmotePlayer = {}
LocalEmotePlayer.__index = LocalEmotePlayer

export type LocalEmotePlayer = typeof(setmetatable({} :: {
	CurrentEmoteId: string?,
	CurrentTrack: AnimationTrack?,
	CurrentAnimation: Animation?,
	Connections: { RBXScriptConnection },
	SavedWalkSpeed: number?,
	LastEmoteTime: number,
	OnAutoStopped: (() -> ())?,
}, LocalEmotePlayer))

function LocalEmotePlayer.new(): LocalEmotePlayer
	return setmetatable({
		CurrentEmoteId = nil :: string?,
		CurrentTrack = nil :: AnimationTrack?,
		CurrentAnimation = nil :: Animation?,
		Connections = {} :: { RBXScriptConnection },
		SavedWalkSpeed = nil :: number?,
		LastEmoteTime = 0 :: number,
		OnAutoStopped = nil :: (() -> ())?,
	}, LocalEmotePlayer)
end

-------------------------------------------------
--// Public Methods
-------------------------------------------------

--[[ Returns true if cooldown has elapsed since the last emote request. ]]
function LocalEmotePlayer.CheckCooldown(self: LocalEmotePlayer): boolean
	local now = os.clock()
	if now - self.LastEmoteTime < EMOTE_COOLDOWN then
		return false
	end
	self.LastEmoteTime = now
	return true
end

--[[ Starts playing an emote animation on the local character.
     Skips if the same emote is already playing. ]]
function LocalEmotePlayer.Start(self: LocalEmotePlayer, emoteId: string, emoteConfig: EmoteConfig): boolean
	if self.CurrentEmoteId == emoteId and self.CurrentTrack and self.CurrentTrack.IsPlaying then
		return true
	end

	self:Stop()

	local character = localPlayer.Character
	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator or not humanoid then
		return false
	end

	-- Save walkspeed before modification
	if self.SavedWalkSpeed == nil then
		self.SavedWalkSpeed = humanoid.WalkSpeed
	end

	if emoteConfig.WalkSpeed then
		humanoid.WalkSpeed = emoteConfig.WalkSpeed
	end

	-- Auto-stop on jump or freefall
	local jumpConn = humanoid.Jumping:Connect(function(isJumping: boolean)
		if isJumping then
			self:_autoStop()
		end
	end)
	table.insert(self.Connections, jumpConn)

	local stateConn = humanoid.StateChanged:Connect(function(_, newState: Enum.HumanoidStateType)
		if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
			self:_autoStop()
		end
	end)
	table.insert(self.Connections, stateConn)

	self.CurrentEmoteId = emoteId

	local function playTrack(rawAnimationId, looped: boolean, onStopped: (() -> ())?): AnimationTrack
		local animation = Instance.new("Animation")
		animation.AnimationId = tostring(rawAnimationId)
		animation.Parent = animator
		local track = animator:LoadAnimation(animation)
		track.Priority = emoteConfig.Priority or Enum.AnimationPriority.Action
		track.Looped = looped
		track:AdjustSpeed(emoteConfig.PlaybackSpeed or 1)
		self.CurrentAnimation = animation
		self.CurrentTrack = track
		if onStopped then
			local stopConn = track.Stopped:Once(onStopped)
			table.insert(self.Connections, stopConn)
		end
		track:Play()
		return track
	end

	local function playMainAnimation()
		if self.CurrentEmoteId ~= emoteId then return end
		if self.CurrentTrack then
			self.CurrentTrack:Destroy()
		end
		if self.CurrentAnimation then
			self.CurrentAnimation:Destroy()
		end
		local mainTrack
		mainTrack = playTrack(emoteConfig.AnimationId, emoteConfig.Looped == true, function()
			if self.CurrentEmoteId == emoteId and self.CurrentTrack == mainTrack then
				self:_autoStop()
			end
		end)
	end

	if emoteConfig.IntroAnimationId then
		local introTrack
		introTrack = playTrack(emoteConfig.IntroAnimationId, false, function()
			if self.CurrentEmoteId == emoteId and self.CurrentTrack == introTrack then
				playMainAnimation()
			end
		end)
	else
		playMainAnimation()
	end

	return true
end

--[[ Stops the current emote and restores walkspeed.
     Does not trigger OnAutoStopped. ]]
function LocalEmotePlayer.Stop(self: LocalEmotePlayer)
	for _, conn in ipairs(self.Connections) do
		conn:Disconnect()
	end
	table.clear(self.Connections)

	local currentTrack = self.CurrentTrack
	local currentAnimation = self.CurrentAnimation
	self.CurrentTrack = nil
	self.CurrentAnimation = nil
	self.CurrentEmoteId = nil

	if currentTrack then
		currentTrack:Stop(0)
		pcall(function()
			currentTrack:Destroy()
		end)
	end
	if currentAnimation then
		currentAnimation:Destroy()
	end

	local character = localPlayer.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and self.SavedWalkSpeed ~= nil then
			humanoid.WalkSpeed = self.SavedWalkSpeed
		end
	end
	self.SavedWalkSpeed = nil
end

--[[ Returns true if an emote is currently playing. ]]
function LocalEmotePlayer.IsPlaying(self: LocalEmotePlayer): boolean
	return self.CurrentEmoteId ~= nil
end

-------------------------------------------------
--// Private Methods
-------------------------------------------------

--[[ Called on jump/freefall/track-end. Stops locally and notifies controller via callback. ]]
function LocalEmotePlayer._autoStop(self: LocalEmotePlayer)
	local hadEmote = self.CurrentEmoteId ~= nil
	self:Stop()

	if hadEmote and self.OnAutoStopped then
		self.OnAutoStopped()
	end
end

return LocalEmotePlayer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="550">
              <Properties>
                <string name="Name">PlayerCharacter</string>
                <string name="Source"><![CDATA[-- Shared character preview used by lobby and in-game emote wheels.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local source = Vide.source
local effect = Vide.effect
local cleanup = Vide.cleanup
local read = Vide.read

local characterCache: { [number]: Model } = {}
local loadingCallbacks: { [number]: { (Model) -> () } } = {}

export type Props = {
	UserId: (number | (() -> number))?,
	Origin: (CFrame | (() -> CFrame))?,
	UseWorldModel: (boolean | (() -> boolean))?,
	Children: any?,
	AnimationId: (number | string | (() -> number | string))?,
	IntroAnimationId: (number | string | (() -> number | string))?,
	Looped: (boolean | (() -> boolean))?,
	PlaybackSpeed: number?,
}

local function fetchCharacterModel(userId: number, callback: (Model) -> ())
	local cachedModel = characterCache[userId]
	if cachedModel then
		callback(cachedModel:Clone())
		return
	end

	if loadingCallbacks[userId] then
		table.insert(loadingCallbacks[userId], callback)
		return
	end

	loadingCallbacks[userId] = { callback }

	task.spawn(function()
		local success, result = pcall(function()
			local description = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
			local r6Model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)

			return r6Model
		end)

		local callbacks = loadingCallbacks[userId]
		loadingCallbacks[userId] = nil

		if not success or not result then
			warn(`[PlayerCharacter] Failed to load character model for UserId {userId}: {result}`)
			return
		end

		if result.HumanoidRootPart then
			result.HumanoidRootPart.Anchored = true
		end

		local animateScript = result:FindFirstChild("Animate")
		if animateScript then
			animateScript:Destroy()
		end

		local healthScript = result:FindFirstChild("Health")
		if healthScript then
			healthScript:Destroy()
		end

		characterCache[userId] = result

		for _, cb in callbacks do
			cb(result:Clone())
		end
	end)
end

local function resetPose(model: Model, origin: CFrame?)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			descendant.Transform = CFrame.new()
		end
	end
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and origin then
		hrp.CFrame = origin
	elseif origin then
		model:PivotTo(origin)
	end
end

return function(props: Props)
	local userId = read(props.UserId) or (Players.LocalPlayer and Players.LocalPlayer.UserId) or 1
	local useWorldModel = read(props.UseWorldModel)
	local containerType = if useWorldModel then "WorldModel" else "Model"
	local character = source(nil :: Model?)

	fetchCharacterModel(userId, function(clonedModel)
		character(clonedModel)
	end)

	effect(function()
		local model = character()
		if not model then
			return
		end

		local origin = read(props.Origin) or CFrame.new(0, 0, 0)
		resetPose(model, origin)

		local rawAnimId = read(props.AnimationId)
		local rawIntroAnimId = read(props.IntroAnimationId)
		local playbackSpeed = read(props.PlaybackSpeed) or 1
		if not rawAnimId or rawAnimId == "" then
			return
		end

		local tracks = {}
		local animations = {}
		local connections = {}
		local active = true

		local function loadTrack(animator: Animator, rawId, looped: boolean): AnimationTrack
			local animId = tostring(rawId)
			local animation = Instance.new("Animation")
			animation.AnimationId = if string.sub(animId, 1, 13) == "rbxassetid://" then animId else `rbxassetid://{animId}`
			local track = animator:LoadAnimation(animation)
			track.Looped = looped
			track.Priority = Enum.AnimationPriority.Action4
			track:AdjustSpeed(playbackSpeed)
			table.insert(animations, animation)
			table.insert(tracks, track)
			return track
		end

		task.spawn(function()
			while active and not model:IsDescendantOf(game) do
				model.AncestryChanged:Wait()
			end
			if not active then
				return
			end

			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if not humanoid then
				return
			end

			local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator")
			animator.Parent = humanoid

			local function playLoop()
				if not active then return end
				local loopTrack = loadTrack(animator, rawAnimId, read(props.Looped) ~= false)
				loopTrack:Play()
			end

			if rawIntroAnimId and rawIntroAnimId ~= "" then
				local introTrack = loadTrack(animator, rawIntroAnimId, false)
				table.insert(connections, introTrack.Stopped:Connect(playLoop))
				introTrack:Play()
			else
				playLoop()
			end
		end)

		cleanup(function()
			active = false
			for _, connection in connections do
				connection:Disconnect()
			end
			for _, track in tracks do
				track:Stop()
				track:Destroy()
			end
			for _, animation in animations do
				animation:Destroy()
			end
			if model and model.Parent then
				resetPose(model, origin)
			end
		end)
	end)

	cleanup(function()
		local model = character()
		if model then
			model:Destroy()
		end
	end)

	return create(containerType)({
		character,
		props.Children,
	})
end
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="551">
            <Properties>
              <string name="Name">Hooks</string>
            </Properties>
            <Item class="ModuleScript" referent="552">
              <Properties>
                <string name="Name">useAudio</string>
                <string name="Source"><![CDATA[-- useAudio.luau
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Vide = require(ReplicatedStorage.Packages.Vide)

local create = Vide.create
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

export type Config = {
	Id: Reactive<string | number>,
	Volume: Reactive<number>?,
	Looped: Reactive<boolean>?,
}

return function(config: Config)
	local output = SoundService:FindFirstChild("AudioDeviceOutput")
	assert(output, "AudioDeviceOutput이 먼저 준비되어야 함.")

	local player = create("AudioPlayer")({
		Parent = SoundService,

		Asset = function()
			local id = read(config.Id)
			return if typeof(id) == "number" then `rbxassetid://{id}` else id
		end,

		Volume = config.Volume or 1,
		Looping = config.Looped or false,
	})

	create("Wire")({
		Parent = player,
		SourceInstance = player,
		TargetInstance = output,
	})

	cleanup(function()
		player:Stop()
		player:Destroy()
	end)

	return {
		Play = function()
			player:Stop()
			player.TimePosition = 0
			player:Play()
		end,

		Stop = function()
			player:Stop()
		end,
	}
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="553">
              <Properties>
                <string name="Name">useButtonEffect</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local useAudio = require(script.Parent.useAudio)
local Vide = require(ReplicatedStorage.Packages.Vide)
local UISFX = require(ReplicatedStorage.Settings.Visuals.UISFX)

local source = Vide.source
local spring = Vide.spring
local action = Vide.action
local create = Vide.create

local function useButtonEffect(pressedScale: number?, hoverScale: number?, disableClickSFX: boolean?)
	local pScale = pressedScale or 0.95
	local hScale = hoverScale or 1.05

	local clickSFX = useAudio({
		Id = UISFX.Click.Id,
		Volume = UISFX.Click.Volume,
	})
	local hoverSFX = useAudio({
		Id = UISFX.Hover.Id,
		Volume = UISFX.Hover.Volume,
	})

	return action(function(button: GuiButton)
		local isPressed = source(false)
		local isHovered = source(false)
		local isClicked = source(false)

		local down = button.MouseButton1Down:Connect(function()
			isPressed(true)
			if not disableClickSFX then
				clickSFX:Play()
			end
		end)

		local up = button.MouseButton1Up:Connect(function()
			isPressed(false)
		end)

		local enter = button.MouseEnter:Connect(function()
			isHovered(true)
			hoverSFX:Play()
		end)

		local leave = button.MouseLeave:Connect(function()
			isHovered(false)
			isPressed(false)
		end)

		local click = button.MouseButton1Click:Connect(function()
			isClicked(true)
			task.delay(0.05, function()
				isClicked(false)
			end)
		end)

		local scale = create("UIScale")({
			Parent = button,
			Scale = spring(function()
				if isPressed() or isClicked() then
					return pScale
				elseif isHovered() then
					return hScale
				end
				return 1
			end, 0.15, 0.5),
		})

		Vide.cleanup(function()
			down:Disconnect()
			up:Disconnect()
			enter:Disconnect()
			leave:Disconnect()
			click:Disconnect()
			scale:Destroy()
		end)
	end)
end

return useButtonEffect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="554">
              <Properties>
                <string name="Name">useButtonHoverEffect</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)

local action = Vide.action
local create = Vide.create
local source = Vide.source
local spring = Vide.spring

return function()
	local isHovered = source(false)

	return action(function(button: GuiButton)
		local enter = button.MouseEnter:Connect(function()
			isHovered(true)
		end)

		local leave = button.MouseLeave:Connect(function()
			isHovered(false)
		end)

		local hoverFrame = create("Frame")({
			Name = "HoverFrame",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(),
			BackgroundTransparency = spring(function()
				return if isHovered() then 0.5 else 1
			end, 0.3, 1),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),

			Parent = button,
		})

		local hoverOutline = create("UIStroke")({
			Name = "HoverOutline",
			Color = button.BackgroundColor3,
			StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
			Thickness = 0.04,
			Transparency = spring(function()
				return if isHovered() then 0 else 1
			end, 0.3, 1),

			Parent = button,
		})

		local buttonGradient = button:FindFirstChildOfClass("UIGradient")
		local gradientConnect
		if buttonGradient then
			local cloneGradient = buttonGradient:Clone()
			cloneGradient.Parent = hoverOutline

			gradientConnect = buttonGradient:GetPropertyChangedSignal("Color"):Connect(function()
				cloneGradient.Color = buttonGradient.Color
			end)
		end

		local buttonUICorner = button:FindFirstChildOfClass("UICorner")
		if buttonUICorner then
			buttonUICorner:Clone().Parent = hoverFrame
		end

		Vide.cleanup(function()
			enter:Disconnect()
			leave:Disconnect()

			hoverFrame:Destroy()
			hoverOutline:Destroy()

			if gradientConnect then
				gradientConnect:Disconnect()
			end
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="555">
              <Properties>
                <string name="Name">useColorSequenceCycle</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Vide = require(ReplicatedStorage.Packages.Vide)
local ColorSequenceScroll = require(script.Parent.Parent.ColorSequenceScroll)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

type SharedPalette = {
	prepared: ColorSequenceScroll.Palette,
	users: number,
	lastPhase: number?,
	lastSample: ColorSequence?,
}

type CycleState = {
	colorSequence: Reactive<ColorSequence>,
	transitionTime: Reactive<number>?,
	enabled: Reactive<boolean>?,
	activeSequence: ColorSequence,
	palette: SharedPalette,
	phase: number,
	destroyConnection: RBXScriptConnection?,
}

local UPDATE_INTERVAL = 1 / 20

local accumulatedTime = 0
local palettes: { [ColorSequence]: SharedPalette } = {}
local cycleStates: { [UIGradient]: CycleState } = {}
local renderConnection: RBXScriptConnection? = nil

local function acquirePalette(sequence: ColorSequence): SharedPalette
	local palette = palettes[sequence]
	if not palette then
		palette = { prepared = ColorSequenceScroll.Prepare(sequence), users = 0 }
		palettes[sequence] = palette
	end
	palette.users += 1
	return palette
end

local function releasePalette(state: CycleState)
	state.palette.users -= 1
	if state.palette.users == 0 then
		palettes[state.activeSequence] = nil
	end
end

local function overlapsScrollingViewport(target: GuiObject, scrollingFrame: ScrollingFrame): boolean
	local targetMin = target.AbsolutePosition
	local targetMax = targetMin + target.AbsoluteSize
	local viewportMin = scrollingFrame.AbsolutePosition
	local viewportMax = viewportMin + scrollingFrame.AbsoluteWindowSize

	return targetMax.X > viewportMin.X
		and targetMin.X < viewportMax.X
		and targetMax.Y > viewportMin.Y
		and targetMin.Y < viewportMax.Y
end

local function isVisibleOnScreen(gradient: UIGradient): boolean
	if not gradient.Enabled then
		return false
	end

	local target = gradient.Parent
	if target and target:IsA("UIStroke") then
		if not target.Enabled then
			return false
		end
		target = target.Parent
	end
	if not target or not target:IsA("GuiObject") then
		return false
	end

	if target.AbsoluteSize.X <= 0 or target.AbsoluteSize.Y <= 0 then
		return false
	end

	local ancestor: Instance? = target
	while ancestor do
		if ancestor:IsA("GuiObject") then
			if not ancestor.Visible then
				return false
			end

			if ancestor:IsA("ScrollingFrame") and not overlapsScrollingViewport(target, ancestor) then
				return false
			end
		elseif ancestor:IsA("LayerCollector") and not ancestor.Enabled then
			return false
		end

		ancestor = ancestor.Parent
	end

	return true
end

local function stopSchedulerIfIdle()
	if next(cycleStates) ~= nil or not renderConnection then
		return
	end

	renderConnection:Disconnect()
	renderConnection = nil
	accumulatedTime = 0
end

local function removeState(gradient: UIGradient, state: CycleState)
	if cycleStates[gradient] ~= state then
		return
	end
	cycleStates[gradient] = nil
	releasePalette(state)
	if state.destroyConnection then
		state.destroyConnection:Disconnect()
		state.destroyConnection = nil
	end
	stopSchedulerIfIdle()
end

local function startScheduler()
	if renderConnection then
		return
	end

	renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
		accumulatedTime += deltaTime
		if accumulatedTime < UPDATE_INTERVAL then
			return
		end

		local remainder = accumulatedTime % UPDATE_INTERVAL
		local elapsed = accumulatedTime - remainder
		accumulatedTime = remainder

		for gradient, state in cycleStates do
			if not isVisibleOnScreen(gradient) then
				continue
			end

			local nextSequence = read(state.colorSequence)
			if nextSequence ~= state.activeSequence then
				releasePalette(state)
				state.activeSequence = nextSequence
				state.palette = acquirePalette(nextSequence)
				state.phase = 0
			end

			if (state.enabled ~= nil and not read(state.enabled)) or state.palette.prepared.IsSolid then
				state.phase = 0
				if gradient.Color ~= state.activeSequence then
					gradient.Color = state.activeSequence
				end
				continue
			end

			local duration = math.max(if state.transitionTime then read(state.transitionTime) else 1, 0.01)
			local palette = state.palette
			state.phase = (state.phase + elapsed / (duration * palette.prepared.Steps)) % 1
			if palette.lastPhase ~= state.phase then
				palette.lastPhase = state.phase
				palette.lastSample = ColorSequenceScroll.Sample(palette.prepared, state.phase)
			end
			gradient.Color = palette.lastSample :: ColorSequence
		end
	end)
end

return function(colorSequence: Reactive<ColorSequence>, transitionTime: Reactive<number>?, enabled: Reactive<boolean>?)
	return action(function(instance: Instance)
		assert(instance:IsA("UIGradient"), "useColorSequenceCycle must be used on a UIGradient")

		local gradient = instance :: UIGradient
		local previousState = cycleStates[gradient]
		if previousState then
			removeState(gradient, previousState)
		end
		local activeSequence = read(colorSequence)
		local state: CycleState = {
			colorSequence = colorSequence,
			transitionTime = transitionTime,
			enabled = enabled,
			activeSequence = activeSequence,
			palette = acquirePalette(activeSequence),
			phase = 0,
		}

		gradient.Color = activeSequence
		cycleStates[gradient] = state
		state.destroyConnection = gradient.Destroying:Connect(function()
			removeState(gradient, state)
		end)
		startScheduler()

		cleanup(function()
			removeState(gradient, state)
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="556">
              <Properties>
                <string name="Name">useDiagonalShine</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

export type ShineMotion = {
	startPosition: UDim2?,
	endPosition: UDim2?,
	duration: number?,
	restInterval: number?,
}

local START_POSITION = UDim2.fromScale(-0.25, 0.5)
local END_POSITION = UDim2.fromScale(1.25, 0.5)
local TRAVEL_DURATION = 0.62
local REST_INTERVAL = 3.4

return function(
	getActive: Reactive<boolean>,
	getSpeed: Reactive<number>?,
	initialDelay: number?,
	motion: ShineMotion?
)
	return action(function(instance: Instance)
		assert(instance:IsA("GuiObject"), "useDiagonalShine must be used on a GuiObject")

		local shine = instance :: GuiObject
		local startPosition = if motion and motion.startPosition then motion.startPosition else START_POSITION
		local endPosition = if motion and motion.endPosition then motion.endPosition else END_POSITION
		local travelDuration = if motion and motion.duration then motion.duration else TRAVEL_DURATION
		local restInterval = if motion and motion.restInterval then motion.restInterval else REST_INTERVAL
		local isAlive = true
		local activeTween: Tween? = nil
		shine.Position = startPosition
		shine.Visible = false

		local shineThread = task.spawn(function()
			task.wait(initialDelay or 0)

			while isAlive and shine.Parent do
				if not read(getActive) then
					task.wait(0.2)
					continue
				end

				local speed = if getSpeed then math.max(read(getSpeed), 0.35) else 1
				shine.Position = startPosition
				shine.Visible = true

				local tween = TweenService:Create(
					shine,
					TweenInfo.new(travelDuration / speed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
					{ Position = endPosition }
				)
				activeTween = tween
				tween:Play()
				tween.Completed:Wait()
				activeTween = nil
				shine.Visible = false

				task.wait(restInterval / math.sqrt(speed))
			end
		end)

		cleanup(function()
			isAlive = false
			if activeTween then
				activeTween:Cancel()
				activeTween = nil
			end
			pcall(task.cancel, shineThread)
			shine.Visible = false
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="557">
              <Properties>
                <string name="Name">useIsInScrollWindow</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local IsInScrollWindow = require(script.Parent.Parent.IsInScrollWindow)

local action = Vide.action
local cleanup = Vide.cleanup
local source = Vide.source

type CacheEntry = {
	isInView: (() -> boolean) & ((boolean) -> boolean),
	users: number,
	disconnect: () -> (),
}

local cache: { [GuiObject]: CacheEntry } = {}

local function createEntry(instance: GuiObject): CacheEntry
	local isInView = source(false)
	local scrollFrame: ScrollingFrame? = nil
	local scrollConnections: { RBXScriptConnection } = {}

	local function clearScrollConnections()
		for _, connection in scrollConnections do
			connection:Disconnect()
		end

		table.clear(scrollConnections)
	end

	local function update()
		isInView(if scrollFrame then IsInScrollWindow(scrollFrame, instance) else false)
	end

	local function connectScrollFrame()
		local ancestor = instance:FindFirstAncestorOfClass("ScrollingFrame")
		if ancestor == scrollFrame then
			update()
			return
		end

		clearScrollConnections()
		scrollFrame = ancestor

		if not scrollFrame then
			update()
			return
		end

		table.insert(scrollConnections, scrollFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(update))

		table.insert(scrollConnections, scrollFrame:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(update))

		table.insert(scrollConnections, scrollFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(update))

		update()
	end

	local connections = {
		instance:GetPropertyChangedSignal("AbsolutePosition"):Connect(update),
		instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(update),
		instance.AncestryChanged:Connect(connectScrollFrame),
	}

	connectScrollFrame()

	local function disconnect()
		clearScrollConnections()

		for _, connection in connections do
			connection:Disconnect()
		end
	end

	return {
		["isInView"] = isInView,
		users = 0,
		disconnect = disconnect,
	}
end

local function useIsInScrollWindow()
	local currentEntry = source(nil :: CacheEntry?)

	local function isInView(): boolean
		local entry = currentEntry()
		return if entry then entry.isInView() else false
	end

	local bind = action(function(instance: GuiObject)
		local entry = cache[instance]
		if not entry then
			entry = createEntry(instance)
			cache[instance] = entry
		end

		entry.users += 1
		currentEntry(entry)

		cleanup(function()
			entry.users -= 1
			if entry.users == 0 then
				entry.disconnect()
				cache[instance] = nil
			end
		end)
	end)

	return isInView, bind
end

return useIsInScrollWindow
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="558">
              <Properties>
                <string name="Name">useMenuMotion</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local MenuMotion = require(script.Parent.Parent.MenuMotion)

local function scaleSize(size: UDim2, x: number, y: number): UDim2
	return UDim2.new(size.X.Scale * x, size.X.Offset * x, size.Y.Scale * y, size.Y.Offset * y)
end

-- Keep controller visibility authoritative for gameplay; only the presentation
-- stays mounted during an exit. A view switch hides the previous menu immediately.
return function(isVisible: () -> boolean, getActiveView: () -> string?)
	local isOpen = Vide.source(false)
	local isMounted = Vide.source(false)
	local mounted = false
	local generation = 0

	Vide.effect(function()
		local shouldOpen = isVisible()
		local activeView = getActiveView()
		generation += 1
		local token = generation
		if shouldOpen then
			if mounted then
				isOpen(true)
			else
				mounted = true
				isMounted(true)
				-- Let springs start at the closed pose, including an initially open menu.
				task.defer(function()
					if generation == token then
						isOpen(true)
					end
				end)
			end
		else
			isOpen(false)
			if activeView ~= nil then
				mounted = false
				isMounted(false)
			elseif mounted then
				task.delay(MenuMotion.ExitDuration, function()
					if generation == token then
						mounted = false
						isMounted(false)
					end
				end)
			end
		end
	end)
	Vide.cleanup(function()
		generation += 1
	end)

	local motion = { IsOpen = isOpen, IsMounted = isMounted }

	function motion:Spring(open, closed, profileName: string)
		local profile = MenuMotion[profileName]
		assert(profile, `Unknown menu motion profile: {profileName}`)
		local value = Vide.spring(function()
			return if isOpen() then open else closed
		end, profile.Period, profile.Damping)
		return value
	end

	function motion:WindowSize(size: UDim2)
		return self:Spring(size, scaleSize(size, MenuMotion.WindowWidthRatio, 1), "Window")
	end

	function motion:WindowRotation()
		return self:Spring(0, -4, "Rotation")
	end

	function motion:HeaderPosition(position: UDim2)
		return self:Spring(position, position - UDim2.fromScale(0.0426388, 0), "Header")
	end

	function motion:IconRotation()
		return self:Spring(0, -90, "IconRotation")
	end

	function motion:IconSize(size: UDim2)
		return self:Spring(size, scaleSize(size, MenuMotion.IconSizeRatio, MenuMotion.IconSizeRatio), "IconSize")
	end

	function motion:CloudPosition(position: UDim2)
		return self:Spring(position, position - UDim2.fromScale(0.154887, 0), "Cloud")
	end

	function motion:Fade()
		return self:Spring(0, 1, "Fade")
	end

	function motion:ClosePosition(position: UDim2)
		return self:Spring(position, UDim2.new(0.2, position.X.Offset, position.Y.Scale, position.Y.Offset), "ClosePosition")
	end

	function motion:CloseRotation()
		return self:Spring(0, -1800, "CloseRotation")
	end

	function motion:ContentPosition(position: UDim2)
		return self:Spring(position, position - UDim2.fromScale(0.0639824, 0), "Content")
	end

	function motion:SearchSize(size: UDim2)
		return self:Spring(size, scaleSize(size, 0, 1), "Search")
	end

	motion.Transparency = motion:Spring(0, 1, "Visibility")
	return motion
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="559">
              <Properties>
                <string name="Name">useRarityShine</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Vide = require(ReplicatedStorage.Packages.Vide)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

local SHINE_COLORS = {
	Common = Color3.fromRGB(50, 45, 45),
	Rare = Color3.fromRGB(29, 34, 176),
	Epic = Color3.fromRGB(68, 59, 170),
	Legendary = Color3.fromRGB(158, 63, 153),
	Mythic = Color3.fromRGB(106, 67, 28),
	Secret = Color3.fromRGB(17, 0, 1),
	Absolute = Color3.fromRGB(233, 93, 224),
}

local SHINE_SPEED = 10
local SHINE_INTERVAL = 2
local SHINE_WIDTH = 1.1
local SHINE_HEIGHT = 1.55
local SHINE_TRANSPARENCY = 0.1
local START_X = -1.4
local END_X = 1.4

local function useRarityShine(getRarity: Reactive<string>)
	return action(function(instance: Instance)
		assert(instance:IsA("CanvasGroup"), "useRarityShine must be used on a CanvasGroup")

		local frame = instance :: CanvasGroup
		frame.ClipsDescendants = true

		local oldEffect = frame:FindFirstChild("ShineEffect")
		if oldEffect then
			oldEffect:Destroy()
		end

		local shineFolder = Instance.new("Folder")
		shineFolder.Name = "ShineEffect"
		shineFolder.Parent = frame

		local originalCorner = frame:FindFirstChildOfClass("UICorner")
		local shineNumber = 0
		local isAlive = true

		local function createShine()
			if not isAlive or not frame.Parent then
				return
			end

			shineNumber += 1

			local shine = Instance.new("Frame")
			shine.Name = `Shine_{shineNumber}`
			shine.BackgroundTransparency = 1
			shine.BorderSizePixel = 0
			shine.ClipsDescendants = true
			shine.Position = UDim2.fromScale(0, 0)
			shine.Size = UDim2.fromScale(1, 1)
			shine.ZIndex = 1
			shine.Parent = shineFolder

			if originalCorner then
				originalCorner:Clone().Parent = shine
			end

			local light = Instance.new("Frame")
			light.Name = "SoftGlow"
			local rarity = read(getRarity)
			light.BackgroundColor3 = SHINE_COLORS[rarity] or SHINE_COLORS.Common
			light.BackgroundTransparency = SHINE_TRANSPARENCY
			light.BorderSizePixel = 0
			light.Position = UDim2.fromScale(START_X, -0.275)
			light.Rotation = 18
			light.Size = UDim2.fromScale(SHINE_WIDTH, SHINE_HEIGHT)
			light.ZIndex = 2
			light.Parent = shine

			local gradient = Instance.new("UIGradient")
			gradient.Color = ColorSequence.new(Color3.new(1, 1, 1))
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.1, 1),
				NumberSequenceKeypoint.new(0.25, 0.97),
				NumberSequenceKeypoint.new(0.35, 0.88),
				NumberSequenceKeypoint.new(0.42, 0.7),
				NumberSequenceKeypoint.new(0.5, 0.52),
				NumberSequenceKeypoint.new(0.58, 0.7),
				NumberSequenceKeypoint.new(0.65, 0.88),
				NumberSequenceKeypoint.new(0.75, 0.97),
				NumberSequenceKeypoint.new(0.9, 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			gradient.Parent = light

			local tween = TweenService:Create(
				light,
				TweenInfo.new(SHINE_SPEED, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
				{ Position = UDim2.fromScale(END_X, -0.275) }
			)

			tween.Completed:Connect(function()
				if shine.Parent then
					shine:Destroy()
				end
			end)
			tween:Play()
		end

		task.spawn(function()
			while isAlive and frame.Parent do
				createShine()
				task.wait(SHINE_INTERVAL)
			end
		end)

		cleanup(function()
			isAlive = false
			shineFolder:Destroy()
		end)
	end)
end

return useRarityShine
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="560">
              <Properties>
                <string name="Name">useRarityTextShimmer</string>
                <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local RarityGradient = require(ReplicatedStorage.Settings.Visuals.RarityGradient)

local action = Vide.action
local cleanup = Vide.cleanup
local read = Vide.read

type Reactive<T> = T | (() -> T)

local GOLD_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 248, 195)),
	ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 220, 85)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 178, 45)),
})

local function getCycledSequence(colorSequence: ColorSequence, elapsed: number, transitionTime: number): ColorSequence
	local keypoints = colorSequence.Keypoints
	local keypointCount = #keypoints
	if keypointCount < 2 then
		return colorSequence
	end

	local cycleProgress = (elapsed / transitionTime) % keypointCount
	local colorOffset = math.floor(cycleProgress)
	local alpha = cycleProgress - colorOffset
	local cycledKeypoints = table.create(keypointCount)

	for index, keypoint in keypoints do
		local currentIndex = ((index + colorOffset - 1) % keypointCount) + 1
		local nextIndex = (currentIndex % keypointCount) + 1
		local currentColor = keypoints[currentIndex].Value
		local nextColor = keypoints[nextIndex].Value

		cycledKeypoints[index] = ColorSequenceKeypoint.new(keypoint.Time, currentColor:Lerp(nextColor, alpha))
	end

	return ColorSequence.new(cycledKeypoints)
end

local function useGradientShimmer(
	getSequence: Reactive<ColorSequence>,
	getActive: Reactive<boolean>,
	getSpeed: Reactive<number>?
)
	return action(function(instance: Instance)
		assert(instance:IsA("UIGradient"), "useGradientShimmer must be used on a UIGradient")

		local gradient = instance :: UIGradient
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed += deltaTime

			local sequence = read(getSequence)
			local speed = if getSpeed then math.max(read(getSpeed), 0.2) else 0.75

			if read(getActive) then
				gradient.Rotation = (elapsed * 18 * speed) % 360
				gradient.Color = getCycledSequence(sequence, elapsed, 1.8 / speed)
			else
				gradient.Rotation = 90
				gradient.Color = sequence
			end
		end)

		cleanup(connection)
	end)
end

local function useRarityTextShimmer(
	getRarity: Reactive<string>,
	getActive: Reactive<boolean>,
	getSpeedScale: Reactive<number>?
)
	return action(function(instance: Instance)
		assert(instance:IsA("UIGradient"), "useRarityTextShimmer must be used on a UIGradient")

		local gradient = instance :: UIGradient
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed += deltaTime

			local rarity = read(getRarity)
			local sequence = RarityGradient.Gradients[rarity] or RarityGradient.Gradients.Common
			local speed = (RarityGradient.ShimmerSpeed[rarity] or 1) * (if getSpeedScale then read(getSpeedScale) else 1)

			if read(getActive) then
				gradient.Rotation = (elapsed * 24 * speed) % 360
				gradient.Color = getCycledSequence(sequence, elapsed, 1.55 / speed)
			else
				gradient.Rotation = 90
				gradient.Color = sequence
			end
		end)

		cleanup(connection)
	end)
end

local function useShineSweep(getActive: Reactive<boolean>, getSpeed: Reactive<number>?)
	return action(function(instance: Instance)
		assert(instance:IsA("GuiObject"), "useShineSweep must be used on a GuiObject")

		local target = instance :: GuiObject
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			if not read(getActive) then
				return
			end

			local speed = if getSpeed then math.max(read(getSpeed), 0.15) else 1
			elapsed += deltaTime * speed
			local progress = (elapsed % 2.1) / 2.1
			target.Position = UDim2.fromScale(0.06 + progress * 0.88, 0.5)
		end)

		cleanup(connection)
	end)
end

local function useRarityBorderPulse(getRarity: Reactive<string>, getActive: Reactive<boolean>, getIntensity: Reactive<number>?)
	return action(function(instance: Instance)
		assert(instance:IsA("UIStroke"), "useRarityBorderPulse must be used on a UIStroke")

		local stroke = instance :: UIStroke
		local elapsed = 0

		local connection = RunService.RenderStepped:Connect(function(deltaTime)
			elapsed += deltaTime

			if not read(getActive) then
				stroke.Transparency = 1
				return
			end

			local rarity = read(getRarity)
			local glow = RarityGradient.Glow[rarity] or RarityGradient.Glow.Common
			local speed = RarityGradient.ShimmerSpeed[rarity] or 1
			local intensity = if getIntensity then read(getIntensity) else 1
			local pulse = (math.sin(elapsed * 3.4 * speed) + 1) * 0.5

			stroke.Color = glow
			stroke.Transparency = 1 - (0.12 + pulse * 0.28) * intensity
		end)

		cleanup(connection)
	end)
end

return {
	Text = useRarityTextShimmer,
	Sweep = useShineSweep,
	BorderPulse = useRarityBorderPulse,
	Gold = function(getActive: Reactive<boolean>, getSpeed: Reactive<number>?)
		return useGradientShimmer(function()
			return GOLD_GRADIENT
		end, getActive, getSpeed)
	end,
	GoldGradient = GOLD_GRADIENT,
}
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="561">
              <Properties>
                <string name="Name">useScale</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local SettingsClient = require(ReplicatedStorage.Shared.Services.System.SettingsClient)

local source = Vide.source
local create = Vide.create
local action = Vide.action
local cleanup = Vide.cleanup

local function useScale()
	return action(function(instance: GuiObject)
		local scaleValue = source(1)

		task.spawn(function()
			local settings = SettingsClient.GetSettings()
			if settings and settings.UIScale ~= nil then
				scaleValue(settings.UIScale / 100)
			end
		end)

		local connection = SettingsClient:GetChangedSignal("UIScale"):Connect(function(newValue)
			if type(newValue) == "number" then
				scaleValue(newValue / 100)
			end
		end)

		local scale = create("UIScale")({
			Parent = instance,
			Scale = scaleValue,
		})

		cleanup(function()
			connection:Disconnect()
			scale:Destroy()
		end)
	end)
end

return useScale
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="562">
              <Properties>
                <string name="Name">useSlider</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Vide = require(ReplicatedStorage.Packages.Vide)

local cleanup = Vide.cleanup
local source = Vide.source

local function updateSliderPosition(inputPosition: Vector3, slider: Frame, handler: GuiButton, valueSource: any)
	local mouseX = inputPosition.X
	local frameLeft = slider.AbsolutePosition.X
	local frameWidth = slider.AbsoluteSize.X

	local percentage = math.clamp((mouseX - frameLeft) / frameWidth, 0, 1)

	handler.Position = UDim2.new(percentage, 0, handler.Position.Y.Scale, handler.Position.Y.Offset)

	if valueSource then
		valueSource(math.floor(percentage * 100))
	end
end

return function(props: { Slider: Frame, Handler: GuiButton, Process: any?, OnRelease: ((value: number) -> ())? })
	local slider = props.Slider
	local handler = props.Handler
	local valueSource = props.Process
	local onRelease = props.OnRelease

	local isDragging = source(false)

	local function stopDragging()
		if isDragging() then
			isDragging(false)

			if onRelease and valueSource then
				onRelease(valueSource())
			end
		end
	end

	local sliderBegan = slider.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			isDragging(true)
			updateSliderPosition(input.Position, slider, handler, valueSource)
		end
	end)

	local handlerBegan = handler.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			isDragging(true)
		end
	end)

	local handlerUp = handler.MouseButton1Up:Connect(function()
		stopDragging()
	end)

	local inputEnded = UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			stopDragging()
		end
	end)

	local inputChanged = UserInputService.InputChanged:Connect(function(input)
		if not isDragging() then
			return
		end

		if
			input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		updateSliderPosition(input.Position, slider, handler, valueSource)
	end)

	local disconnectAll = function()
		sliderBegan:Disconnect()
		handlerBegan:Disconnect()
		handlerUp:Disconnect()
		inputEnded:Disconnect()
		inputChanged:Disconnect()
	end

	local hasCleanupScope = pcall(function()
		cleanup(disconnectAll)
	end)

	if not hasCleanupScope then
		return disconnectAll
	end

	return nil
end
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="563">
            <Properties>
              <string name="Name">IsInScrollWindow</string>
              <string name="Source"><![CDATA[return function(scrollFrame: ScrollingFrame, button: GuiObject): boolean
	local framePos = scrollFrame.AbsolutePosition
	local frameSize = scrollFrame.AbsoluteWindowSize

	local buttonPos = button.AbsolutePosition
	local buttonSize = button.AbsoluteSize

	return buttonPos.X < framePos.X + frameSize.X
		and buttonPos.X + buttonSize.X > framePos.X
		and buttonPos.Y < framePos.Y + frameSize.Y
		and buttonPos.Y + buttonSize.Y > framePos.Y
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="564">
            <Properties>
              <string name="Name">MenuMotion</string>
              <string name="Source"><![CDATA[-- Shared menu choreography, sampled from the Units window.
-- Period is Vide's spring period in seconds (not a tween duration).
return table.freeze({
	ExitDuration = 0.3,
	WindowWidthRatio = 0.675 / 0.721698,
	IconSizeRatio = 0.346017 / 0.184974,
	Window = table.freeze({ Period = 0.5, Damping = 0.5 }),
	Rotation = table.freeze({ Period = 0.5, Damping = 1 }),
	Header = table.freeze({ Period = 0.5, Damping = 1 }),
	IconRotation = table.freeze({ Period = 0.5, Damping = 0.7 }),
	IconSize = table.freeze({ Period = 0.5, Damping = 0.8 }),
	Cloud = table.freeze({ Period = 0.7, Damping = 0.8 }),
	Fade = table.freeze({ Period = 0.5, Damping = 1 }),
	Visibility = table.freeze({ Period = 0.18, Damping = 1 }),
	ClosePosition = table.freeze({ Period = 1, Damping = 0.85 }),
	CloseRotation = table.freeze({ Period = 1, Damping = 0.8 }),
	Content = table.freeze({ Period = 0.5, Damping = 0.8 }),
	Detail = table.freeze({ Period = 0.4, Damping = 0.5 }),
	Search = table.freeze({ Period = 0.5, Damping = 0.9 }),
	Action = table.freeze({ Period = 0.75, Damping = 0.65 }),
})
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="565">
            <Properties>
              <string name="Name">Notifications</string>
            </Properties>
            <Item class="ModuleScript" referent="566">
              <Properties>
                <string name="Name">LogMessage</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ItemData = require(ReplicatedStorage.Settings.Data.ItemData)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)

local create = Vide.create
local spring = Vide.spring

local FONT = Font.new("rbxasset://fonts/families/FredokaOne.json")

return function(props)
	local item = if props.ItemName then ItemData.ByName[props.ItemName] else nil
	local rarity = if item then RarityRegistry.Get(item.Rarity).Presentation else nil
	local isError = props.LogType == "Error"

	return create("CanvasGroup")({
		Name = if item then "ItemReward" else "Message",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		LayoutOrder = props.LayoutOrder,
		Size = UDim2.new(1, 0, 0, 40),
		ZIndex = 101,
		create("CanvasGroup")({
			Name = "AnimatedBanner",
			BackgroundTransparency = 1,
			GroupTransparency = spring(function()
				return if props.State() == "Alive" then 0 else 1
			end, 0.3, 1),
			Position = spring(function()
				local state = props.State()
				if state == "Entering" then
					return UDim2.fromScale(-1, 0)
				elseif state == "Leaving" then
					return UDim2.fromScale(1, 0)
				end
				return UDim2.fromScale(0, 0)
			end, 0.3, 1),
			Size = UDim2.fromScale(1, 1),
			ZIndex = 101,
			create("Frame")({
				Name = "FadedBackground",
				BackgroundColor3 = if isError then Color3.fromRGB(175, 38, 43) else Color3.new(),
				BackgroundTransparency = 0.48,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 101,
				create("UIGradient")({
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(0.15, 0.35),
						NumberSequenceKeypoint.new(0.3, 0),
						NumberSequenceKeypoint.new(0.7, 0),
						NumberSequenceKeypoint.new(0.85, 0.35),
						NumberSequenceKeypoint.new(1, 1),
					}),
				}),
			}),
			create("Frame")({
				Name = "Content",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 102,
				create("UIListLayout")({
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					Padding = UDim.new(0, 7),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
				if item then create("ImageLabel")({
					Name = "ItemImage",
					BackgroundTransparency = 1,
					Image = item.ItemImage,
					LayoutOrder = 1,
					ScaleType = Enum.ScaleType.Fit,
					Size = UDim2.fromOffset(30, 30),
					ZIndex = 103,
				}) else nil,
				create("TextLabel")({
					Name = if item then "ItemName" else "MessageText",
					BackgroundTransparency = 1,
					FontFace = FONT,
					LayoutOrder = 2,
					AutomaticSize = if item then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
					Size = if item then UDim2.fromOffset(0, 34) else UDim2.fromScale(1, 1),
					Text = if item then item.Name else props.Message or "",
					TextColor3 = Color3.new(1, 1, 1),
					TextSize = 20,
					TextTruncate = Enum.TextTruncate.AtEnd,
					TextXAlignment = Enum.TextXAlignment.Center,
					ZIndex = 103,
					create("UIStroke")({ Color = Color3.new(), Thickness = 2 }),
					if rarity then create("UIGradient")({ Color = rarity.Gradient }) else nil,
				}),
				if item then create("TextLabel")({
					Name = "Quantity",
					BackgroundTransparency = 1,
					FontFace = FONT,
					LayoutOrder = 3,
					Size = UDim2.fromOffset(55, 34),
					Text = `x{props.Amount}`,
					TextColor3 = Color3.new(1, 1, 1),
					TextSize = 18,
					TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = 103,
					create("UIStroke")({ Color = Color3.new(), Thickness = 2 }),
				}) else nil,
			}),
		}),
	})
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="567">
              <Properties>
                <string name="Name">NotificationFeed</string>
                <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ItemData = require(ReplicatedStorage.Settings.Data.ItemData)
local LogMessage = require(script.Parent.LogMessage)

local create = Vide.create
local source = Vide.source
local values = Vide.values

local entries = source({})
local nextId = 0
local DEFAULT_LIFETIME = 3
local MAX_ENTRIES = 5

local NotificationFeed = {}

local function push(entry, lifetime: number?)
	nextId += 1
	entry.Id = nextId
	entry.State = source("Entering")

	local updated = table.clone(entries())
	table.insert(updated, entry)
	while #updated > MAX_ENTRIES do
		table.remove(updated, 1)
	end
	entries(updated)

	-- Leave one render frame in the entering state so the spring can animate in.
	task.delay(0.05, function()
		entry.State("Alive")
	end)
	task.delay(lifetime or DEFAULT_LIFETIME, function()
		entry.State("Leaving")
		task.delay(0.4, function()
			local current = table.clone(entries())
			local index = table.find(current, entry)
			if index then
				table.remove(current, index)
				entries(current)
			end
		end)
	end)
end

function NotificationFeed.Pull(message: string, logType: string?, lifetime: number?)
	push({ Message = message or "", LogType = logType or "Normal" }, lifetime)
end

function NotificationFeed.PullItem(itemName: string, amount: number, lifetime: number?)
	if not ItemData.ByName[itemName] or typeof(amount) ~= "number" or amount <= 0 then
		return
	end
	push({ ItemName = itemName, Amount = amount }, lifetime)
end

function NotificationFeed.RenderUI()
	return create("Frame")({
		Name = "Log",
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.075),
		Size = UDim2.fromScale(0.45, 0.5),
		Visible = true,
		ZIndex = 100,
		values(entries, function(entry)
			return LogMessage({
				Message = entry.Message,
				LogType = entry.LogType,
				ItemName = entry.ItemName,
				Amount = entry.Amount,
				LayoutOrder = entry.Id,
				State = entry.State,
			})
		end),
		create("UIListLayout")({
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 2),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

return NotificationFeed
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="568">
            <Properties>
              <string name="Name">PlayerOverheadService</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")

local GROUP_ID = 492293332
local DEVELOPER_MIN_RANK = 250
local DEFAULT_LEVEL = 1

local DISPLAY_DISTANCE = 100
-- Scale components on a BillboardGui are measured in world-space studs.
-- This makes the whole tag naturally shrink as the camera moves away.
local BILLBOARD_SIZE = UDim2.new(3.4, 0, 1.2, 0)
local BILLBOARD_OFFSET = Vector3.new(0, 2.55, 0)
local DISPLAY_FONT = Font.new("rbxasset://fonts/families/FredokaOne.json")

type PlayerState = {
	billboard: BillboardGui?,
	titleLabel: TextLabel?,
	levelLabel: TextLabel?,
	titleConnection: RBXScriptConnection?,
	levelConnection: RBXScriptConnection?,
	leaderstatsConnection: RBXScriptConnection?,
	playerChildConnection: RBXScriptConnection?,
	characterConnection: RBXScriptConnection?,
}

local PlayerOverheadService = {}
local playerStates: { [Player]: PlayerState } = {}

local function disconnect(connection: RBXScriptConnection?)
	if connection then
		connection:Disconnect()
	end
end

local function addTextStroke(label: TextLabel, thicknessScale: number)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Color = Color3.fromRGB(12, 10, 18)
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize
	stroke.Thickness = thicknessScale
	stroke.Transparency = 0
	stroke.Parent = label
end

local function createLabel(name: string, heightScale: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, heightScale)
	label.FontFace = DISPLAY_FONT
	label.TextScaled = true
	label.RichText = true
	label.TextWrapped = false
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center

	return label
end

local function escapeRichText(value: string): string
	return value:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
end

local function refreshTitle(player: Player)
	local state = playerStates[player]
	if not state or not state.titleLabel then return end
	local title = player:GetAttribute("ChatRoleTag")
	local visible = type(title) == "string" and title ~= ""
	state.titleLabel.Text = if visible then escapeRichText(title) else ""
	state.titleLabel.Visible = visible
end

local function currentLevel(player: Player): number
	local leaderstats = player:FindFirstChild("leaderstats")
	local levelValue = leaderstats and leaderstats:FindFirstChild("Level")
	if levelValue and levelValue:IsA("IntValue") then
		return math.max(1, levelValue.Value)
	end

	return DEFAULT_LEVEL
end

local function refreshLevel(player: Player)
	local state = playerStates[player]
	if state and state.levelLabel then
		state.levelLabel.Text = `Level {currentLevel(player)}`
	end
end

local function bindLevelValue(player: Player, levelValue: Instance?)
	local state = playerStates[player]
	if not state then
		return
	end

	disconnect(state.levelConnection)
	state.levelConnection = nil

	if levelValue and levelValue:IsA("IntValue") then
		state.levelConnection = levelValue:GetPropertyChangedSignal("Value"):Connect(function()
			refreshLevel(player)
		end)
	end

	refreshLevel(player)
end

local function bindLeaderstats(player: Player, leaderstats: Instance?)
	local state = playerStates[player]
	if not state then
		return
	end

	disconnect(state.leaderstatsConnection)
	state.leaderstatsConnection = nil

	if leaderstats then
		bindLevelValue(player, leaderstats:FindFirstChild("Level"))
		state.leaderstatsConnection = leaderstats.ChildAdded:Connect(function(child)
			if child.Name == "Level" then
				bindLevelValue(player, child)
			end
		end)
	else
		bindLevelValue(player, nil)
	end
end

local function createOverhead(player: Player, character: Model)
	local state = playerStates[player]
	if not state then
		return
	end

	local head = character:WaitForChild("Head", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not head or not head:IsA("BasePart") or not humanoid or not humanoid:IsA("Humanoid") then
		return
	end

	if player.Character ~= character then
		return
	end

	if state.billboard then
		state.billboard:Destroy()
	end

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PlayerOverhead"
	billboard.Adornee = head
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = DISPLAY_DISTANCE
	-- Keep the BillboardGui itself fully world-scaled. A positive upper limit
	-- freezes its minimum screen size and makes distant tags look pixel-fixed.
	billboard.DistanceLowerLimit = 0
	billboard.DistanceUpperLimit = -1
	billboard.DistanceStep = 0
	billboard.Size = BILLBOARD_SIZE
	billboard.SizeOffset = Vector2.zero
	billboard.StudsOffsetWorldSpace = BILLBOARD_OFFSET
	billboard.Parent = head

	local container = Instance.new("Frame")
	container.Name = "Container"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Parent = billboard

	local layout = Instance.new("UIListLayout")
	layout.Name = "Layout"
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Padding = UDim.new(-0.02, 0)
	layout.Parent = container

	local titleLabel = createLabel("Title", 0.26)
	titleLabel.LayoutOrder = 0
	-- These belong to the actual title, not only the shared name/level labels.
	titleLabel.TextScaled = true
	titleLabel.RichText = true
	titleLabel.TextColor3 = Color3.fromRGB(207, 139, 255)
	addTextStroke(titleLabel, 0.15)
	local titleGradient = Instance.new("UIGradient")
	titleGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 191, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(156, 104, 255)),
	})
	titleGradient.Parent = titleLabel
	titleLabel.Parent = container

	local levelLabel = createLabel("Level", 0.3)
	levelLabel.LayoutOrder = 1
	levelLabel.TextScaled = true
	levelLabel.RichText = true
	levelLabel.Text = `Level {currentLevel(player)}`
	levelLabel.TextColor3 = Color3.fromRGB(255, 182, 43)
	addTextStroke(levelLabel, 0.145)

	local levelGradient = Instance.new("UIGradient")
	levelGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 237, 106)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 169, 35)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 116, 24)),
	})
	levelGradient.Rotation = 90
	levelGradient.Parent = levelLabel
	levelLabel.Parent = container

	local nameLabel = createLabel("PlayerName", 0.37)
	nameLabel.LayoutOrder = 2
	nameLabel.TextScaled = true
	nameLabel.RichText = true
	nameLabel.Text = escapeRichText(player.DisplayName)
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	addTextStroke(nameLabel, 0.14)
	nameLabel.Parent = container

	state.billboard = billboard
	state.titleLabel = titleLabel
	state.levelLabel = levelLabel
	refreshTitle(player)
end

local function resolveDeveloperRole(player: Player)
	local success, rank = pcall(player.GetRankInGroupAsync, player, GROUP_ID)
	local isDeveloper = success and type(rank) == "number" and rank >= DEVELOPER_MIN_RANK
	player:SetAttribute("IsDeveloper", isDeveloper)

	if isDeveloper then
		local roleSuccess, roleName = pcall(player.GetRoleInGroupAsync, player, GROUP_ID)
		player:SetAttribute(
			"ChatRoleTag",
			if roleSuccess and type(roleName) == "string" and roleName ~= "" then roleName else "Developer"
		)
	else
		player:SetAttribute("ChatRoleTag", nil)
	end
	refreshTitle(player)

end

local function playerAdded(player: Player)
	if playerStates[player] then
		return
	end

	local state: PlayerState = {}
	playerStates[player] = state

	state.playerChildConnection = player.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then
			bindLeaderstats(player, child)
		end
	end)
	state.titleConnection = player:GetAttributeChangedSignal("ChatRoleTag"):Connect(function()
		refreshTitle(player)
	end)

	state.characterConnection = player.CharacterAdded:Connect(function(character)
		task.spawn(createOverhead, player, character)
	end)

	bindLeaderstats(player, player:FindFirstChild("leaderstats"))
	task.spawn(resolveDeveloperRole, player)

	if player.Character then
		task.spawn(createOverhead, player, player.Character)
	end
end

local function playerRemoving(player: Player)
	local state = playerStates[player]
	if not state then
		return
	end

	disconnect(state.levelConnection)
	disconnect(state.titleConnection)
	disconnect(state.leaderstatsConnection)
	disconnect(state.playerChildConnection)
	disconnect(state.characterConnection)
	if state.billboard then
		state.billboard:Destroy()
	end
	playerStates[player] = nil
end

function PlayerOverheadService.Start()
	for _, player in Players:GetPlayers() do
		playerAdded(player)
	end

	Players.PlayerAdded:Connect(playerAdded)
	Players.PlayerRemoving:Connect(playerRemoving)
end

return PlayerOverheadService
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="569">
            <Properties>
              <string name="Name">SetMobileStyle</string>
              <string name="Source"><![CDATA[local SetMobileStyle = {}

local function updateToggleVisual(imageButton: ImageButton, toggled: boolean)
	local visualLabel = imageButton:FindFirstChild("MobileStyleVisual") :: ImageLabel?
	if not visualLabel then
		return
	end

	imageButton:SetAttribute("IsToggled", toggled)

	local imageLabel = imageButton:FindFirstChild("ActionIcon") :: ImageLabel?
	local textLabel = imageButton:FindFirstChild("ActionTitle") :: TextLabel?

	if toggled then
		visualLabel.ImageRectOffset = Vector2.new(146, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(0, 0, 0)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(0, 0, 0)
		end
	else
		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(1, 1, 1)
		end
	end
end

function SetMobileStyle.Default(imageButton: ImageButton)
	local imageLabel = imageButton:FindFirstChild("ActionIcon") :: ImageLabel?
	local textLabel = imageButton:FindFirstChild("ActionTitle") :: TextLabel?

	local visualLabel = imageButton:FindFirstChild("MobileStyleVisual") :: ImageLabel?
	if not visualLabel then
		visualLabel = Instance.new("ImageLabel")
		visualLabel.Name = "MobileStyleVisual"
		visualLabel.BackgroundTransparency = 1
		visualLabel.Image = "rbxassetid://130691448656069"
		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		visualLabel.Parent = imageButton
		visualLabel.ZIndex = -1
		visualLabel.Size = UDim2.fromScale(1, 1)
	end

	imageButton.ImageTransparency = 1

	if imageLabel then
		imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		imageLabel.ImageTransparency = 0.5
	end
	if textLabel then
		textLabel.TextColor3 = Color3.new(1, 1, 1)
		textLabel.TextTransparency = 0.5
	end

	local touchObject = nil
	imageButton.InputBegan:Connect(function(inputObject)
		if
			touchObject
			or inputObject.UserInputType ~= Enum.UserInputType.Touch
			or inputObject.UserInputState ~= Enum.UserInputState.Begin
		then
			return
		end

		touchObject = inputObject
		visualLabel.ImageRectOffset = Vector2.new(146, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(0, 0, 0)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(0, 0, 0)
		end
	end)

	imageButton.InputEnded:Connect(function(inputObject)
		if inputObject ~= touchObject then
			return
		end

		touchObject = nil

		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		if imageLabel then
			imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		end
		if textLabel then
			textLabel.TextColor3 = Color3.new(1, 1, 1)
		end
	end)
end

function SetMobileStyle.SetToggleState(imageButton: ImageButton, toggled: boolean)
	updateToggleVisual(imageButton, toggled)
end

function SetMobileStyle.Toggle(imageButton: ImageButton)
	local imageLabel = imageButton:FindFirstChild("ActionIcon") :: ImageLabel?
	local textLabel = imageButton:FindFirstChild("ActionTitle") :: TextLabel?

	local visualLabel = imageButton:FindFirstChild("MobileStyleVisual") :: ImageLabel?
	if not visualLabel then
		visualLabel = Instance.new("ImageLabel")
		visualLabel.Name = "MobileStyleVisual"
		visualLabel.BackgroundTransparency = 1
		visualLabel.Image = "rbxassetid://130691448656069"
		visualLabel.ImageRectOffset = Vector2.new(1, 146)
		visualLabel.ImageRectSize = Vector2.new(144, 144)
		visualLabel.Parent = imageButton
		visualLabel.ZIndex = -1
		visualLabel.Size = UDim2.fromScale(1, 1)
	end

	imageButton.ImageTransparency = 1

	if imageLabel then
		imageLabel.ImageColor3 = Color3.new(1, 1, 1)
		imageLabel.ImageTransparency = 0.5
	end
	if textLabel then
		textLabel.TextColor3 = Color3.new(1, 1, 1)
		textLabel.TextTransparency = 0.5
	end

	updateToggleVisual(imageButton, imageButton:GetAttribute("IsToggled") == true)
end

return SetMobileStyle
]]></string>
            </Properties>
          </Item>
