              <Item class="ModuleScript" referent="606">
                <Properties>
                  <string name="Name">logger</string>
                  <string name="Source"><![CDATA[local function msg(...: string)
  return `[Forge Emit API]: {table.concat({ ... }, " ")}`
end

local logger = {}

function logger.error(...)
  error(msg(..., "\n"))
end

function logger.warn(...)
  warn(msg(...))
  warn(msg(debug.traceback("stack trace:")))
end

function logger.info(...)
  print(msg(...))
end

return logger
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="607">
                <Properties>
                  <string name="Name">recolor</string>
                  <string name="Source"><![CDATA[local colorProps = {
  Single = {
    Color3 = {
      "Decal",
      "Texture",
    },

    Color = {
      "Part",
      "Union",
      "MeshPart",

      "SpotLight",
      "PointLight",
      "SurfaceLight",

      "SurfaceAppearance",
    },
  },

  Sequence = {
    Color = {
      "Beam",
      "Trail",
      "ParticleEmitter",
    },
  },
}

local function warp(x: number)
  return ((x % 1) + 1) % 1
end

local function multiplyHue(h0: number, h1: number)
  local rotation = (h1 - 0.5) * 1
  return warp(h0 + rotation)
end

local function multiplyChannel(c0: number, c1: number)
  local t = 2 * c1 - 1

  if t >= 0 then
    return math.clamp(c0 + (1 - c0) * t, 0, 1)
  else
    return math.clamp(c0 - c0 * math.abs(t), 0, 1)
  end
end

local function normalizeColor(color: Color3)
  local r, g, b = color.R, color.G, color.B
  local f = math.max(1, r, g, b)
  return f, Color3.new(r / f, g / f, b / f)
end

local function multiplyRGB(color: Color3, factor: number)
  return Color3.new(color.R * factor, color.G * factor, color.B * factor)
end

local function recolorObj(obj: Instance, color: Color3, mode: string, isDirect: boolean)
  if not isDirect and obj:IsA("BasePart") then
    return
  end

  local hue, sat, val = color:ToHSV()

  for _, info in colorProps do
    for k, v in info do
      if not table.find(v, obj.ClassName) then
        continue
      end

      local c = obj[k]

      if mode == "multiply" then
        if typeof(c) == "Color3" then
          local f, col = normalizeColor(c)
          local h0, s0, v0 = col:ToHSV()

          local h2 = multiplyHue(h0, hue)
          local s2 = multiplyChannel(s0, sat)
          local v2 = multiplyChannel(v0, val)

          obj[k] = multiplyRGB(Color3.fromHSV(h2, s2, v2), f)
        elseif typeof(c) == "ColorSequence" then
          local res = {}

          for _, kp in c.Keypoints do
            local f, col = normalizeColor(kp.Value)
            local h0, s0, v0 = col:ToHSV()

            local h2 = multiplyHue(h0, hue)
            local s2 = multiplyChannel(s0, sat)
            local v2 = multiplyChannel(v0, val)

            table.insert(res, ColorSequenceKeypoint.new(kp.Time, multiplyRGB(Color3.fromHSV(h2, s2, v2), f)))
          end

          obj[k] = ColorSequence.new(res)
        end
      else
        if typeof(c) == "Color3" then
          local f = normalizeColor(c)
          obj[k] = Color3.new(color.R * f, color.G * f, color.B * f)
        elseif typeof(c) == "ColorSequence" then
          obj[k] = ColorSequence.new(color)
        end
      end
    end
  end
end

local function recolor(color: Color3, mode: "replace" | "multiply", ...: Instance)
  for _, instance in { ... } do
    recolorObj(instance, color, mode, true)

    for _, desc in instance:GetDescendants() do
      recolorObj(desc, color, mode, false)
    end
  end
end

return recolor
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="608">
                <Properties>
                  <string name="Name">resize</string>
                  <string name="Source"><![CDATA[local utility = require("./utility")

local resize = {}

function resize.apply(obj: Instance, factor: number)
  if obj:IsA("ParticleEmitter") then
    obj.Size = utility.scaleNumberSequence(obj.Size, factor)
    obj.Speed = NumberRange.new(obj.Speed.Min * factor, obj.Speed.Max * factor)
    obj.Acceleration *= factor
  elseif obj:IsA("Beam") then
    utility.scaleAttribute(obj, factor, "Width0_Start")
    utility.scaleAttribute(obj, factor, "Width1_Start")
    utility.scaleAttribute(obj, factor, "Width0_End")
    utility.scaleAttribute(obj, factor, "Width1_End")

    utility.scaleAttribute(obj, factor, "CurveSize0_Start")
    utility.scaleAttribute(obj, factor, "CurveSize1_Start")
    utility.scaleAttribute(obj, factor, "CurveSize0_End")
    utility.scaleAttribute(obj, factor, "CurveSize1_End")

    utility.scaleAttribute(obj, factor, "Length_Scale_Start")
    utility.scaleAttribute(obj, factor, "Length_Scale_End")

    obj.Width0 *= factor
    obj.Width1 *= factor
    obj.CurveSize0 *= factor
    obj.CurveSize1 *= factor

    local a0, a1 = obj.Attachment0, obj.Attachment1
    utility.scaleAttachmentDistance(a0, a1, factor)
  elseif obj:IsA("Trail") then
    local a0, a1 = obj.Attachment0, obj.Attachment1
    utility.scaleAttachmentDistance(a0, a1, factor)
  elseif obj:IsA("Sound") then
    obj.RollOffMinDistance *= factor
    obj.RollOffMaxDistance *= factor

    utility.scaleAttribute(obj, factor, "RollOff_Start")
    utility.scaleAttribute(obj, factor, "RollOff_End")
  elseif obj:IsA("Model") then
    if utility.isMeshVFX(obj) then
      local start = obj:FindFirstChild("Start")
      local goal = obj:FindFirstChild("End")

      if start and goal then
        start.Size *= factor
        goal.Size *= factor

        local startMesh = start:FindFirstChildOfClass("SpecialMesh")
        local goalMesh = goal:FindFirstChildOfClass("SpecialMesh")

        if startMesh and goalMesh then
          startMesh.Scale *= factor
          goalMesh.Scale *= factor
        end
      end
    else
      utility.scaleAttribute(obj, factor, "Scale_Start")
      utility.scaleAttribute(obj, factor, "Scale_End")
    end
  elseif obj:IsA("Attachment") and obj:HasTag(utility.LIGHTNING_TAG) then
    utility.scaleAttribute(obj, factor, "OffsetScale")
    utility.scaleAttribute(obj, factor, "Width_Start")
    utility.scaleAttribute(obj, factor, "Width_End")
  elseif
    obj:IsA("BasePart")
    and obj.Parent
    and utility.findFirstClassWithTag(obj.Parent, "Attachment", utility.SHOCKWAVE_TAG)
  then
    utility.scaleAttribute(obj, factor, "Radius")
    utility.scaleAttribute(obj, factor, "Length")
    utility.scaleAttribute(obj, factor, "MinSize")
    utility.scaleAttribute(obj, factor, "MaxSize")

    if obj:GetAttribute("LinearMagnitude") then
      obj.Size *= factor
      utility.scaleAttribute(obj, factor, "LinearMagnitude")
      utility.scaleAttribute(obj, factor, "AngularMagnitude")
    end
  elseif obj:IsA("RayValue") and obj:HasTag(utility.SCREENSHAKE_TAG) then
    utility.scaleAttribute(obj, factor, "Falloff")
  end
end

function resize.batch(factor: number, ...: Instance)
  for _, instance in { ... } do
    resize.apply(instance, factor)

    for _, desc in instance:GetDescendants() do
      resize.apply(desc, factor)
    end
  end
end

return resize
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="609">
                <Properties>
                  <string name="Name">retime</string>
                  <string name="Source"><![CDATA[local utility = require("./utility")

local retime = {}

function retime.apply(obj: Instance, factor: number, invFactor: number)
  if obj:IsA("ParticleEmitter") then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "TimeScale_Duration")

    obj.Speed = NumberRange.new(obj.Speed.Min * factor, obj.Speed.Max * factor)
    obj.RotSpeed = NumberRange.new(obj.RotSpeed.Min * factor, obj.RotSpeed.Max * factor)
    obj.Lifetime = NumberRange.new(obj.Lifetime.Min / factor, obj.Lifetime.Max / factor)

    obj.Acceleration *= factor ^ 2
    obj.Drag *= factor
    obj.Rate *= factor
  elseif obj:IsA("Beam") then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "EffectDuration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")
    utility.scaleAttribute(obj, invFactor, "Duration")

    obj.TextureSpeed *= factor
  elseif obj:IsA("Trail") then
    obj.Lifetime *= invFactor
  elseif obj:IsA("Sound") then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "EmitInterval")
    utility.scaleAttribute(obj, invFactor, "RepeatInterval")
    utility.scaleAttribute(obj, invFactor, "FadeOutTime")

    utility.scaleAttribute(obj, invFactor, "Volume_Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")
    utility.scaleAttribute(obj, invFactor, "RollOff_Duration")
  elseif obj:IsA("Model") then
    if utility.isMeshVFX(obj) then
      utility.scaleAttribute(obj, invFactor, "EmitDelay")
      utility.scaleAttribute(obj, invFactor, "DestroyDelay")
      utility.scaleAttribute(obj, invFactor, "EmitDuration")
      utility.scaleAttribute(obj, invFactor, "EffectDuration")
      utility.scaleAttribute(obj, invFactor, "Speed_Duration")
      utility.scaleAttribute(obj, invFactor, "Duration")

      utility.scaleAttribute(obj, factor, "Rate")
      utility.scaleAttribute(obj, factor, "Part_RotSpeed_Start")
      utility.scaleAttribute(obj, factor, "Part_RotSpeed_End")
    else
      utility.scaleAttribute(obj, factor, "SpinRotation")

      utility.scaleAttribute(obj, invFactor, "EmitDelay")
      utility.scaleAttribute(obj, invFactor, "ResetDelay")

      utility.scaleAttribute(obj, invFactor, "SpinDuration")
      utility.scaleAttribute(obj, invFactor, "Scale_Duration")
      utility.scaleAttribute(obj, invFactor, "SpinSpeed_Duration")
    end
  elseif obj:IsA("Attachment") and obj:HasTag(utility.BEZIER_TAG) then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "DestroyDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")

    utility.scaleAttribute(obj, factor, "ProjectileSpeed")
    utility.scaleAttribute(obj, invFactor, "ProjectileLifetime")
    utility.scaleAttribute(obj, factor, "Rate")
    utility.scaleAttribute(obj, factor, "Part_RotSpeed_Start")
    utility.scaleAttribute(obj, factor, "Part_RotSpeed_End")
  elseif obj:IsA("Attachment") and obj:HasTag(utility.LIGHTNING_TAG) then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "DestroyDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")

    utility.scaleAttribute(obj, invFactor, "Color_Duration")
    utility.scaleAttribute(obj, invFactor, "Fill_Color_Duration")
    utility.scaleAttribute(obj, invFactor, "Fade_In_Duration")
    utility.scaleAttribute(obj, invFactor, "Fade_Out_Duration")
    utility.scaleAttribute(obj, invFactor, "Dissipate_Duration")

    utility.scaleAttribute(obj, factor, "ProjectileSpeed")
    utility.scaleAttribute(obj, invFactor, "ProjectileLifetime")
    utility.scaleAttribute(obj, factor, "Rate")
    utility.scaleAttribute(obj, factor, "RefreshRate")
  elseif
    obj:IsA("BasePart")
    and obj.Parent
    and utility.findFirstClassWithTag(obj.Parent, "Attachment", utility.SHOCKWAVE_TAG)
  then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "Size_Duration")
    utility.scaleAttribute(obj, invFactor, "Transparency_Duration")
    utility.scaleAttribute(obj, invFactor, "Lifetime")
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, factor, "Rate_Start")
    utility.scaleAttribute(obj, factor, "Rate_End")
  elseif obj:IsA("RayValue") and obj:HasTag(utility.SCREENSHAKE_TAG) then
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
    utility.scaleAttribute(obj, invFactor, "EmitDuration")
    utility.scaleAttribute(obj, invFactor, "Scale_Duration")
  elseif obj:IsA("RayValue") then
    utility.scaleAttribute(obj, invFactor, "Duration")
    utility.scaleAttribute(obj, invFactor, "Speed_Duration")
    utility.scaleAttribute(obj, invFactor, "EmitDelay")
  end
end

function retime.batch(factor: number, ...: Instance)
  local invFactor = 1 / factor

  for _, instance in { ... } do
    retime.apply(instance, factor, invFactor)

    for _, desc in instance:GetDescendants() do
      retime.apply(desc, factor, invFactor)
    end
  end
end

return retime
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="610">
                <Properties>
                  <string name="Name">shape</string>
                  <string name="Source"><![CDATA[--!native
--!optimize 2
local utility = require("./utility")

local shape = {}

function shape.getSurfaceCFrame(cf: CFrame, n: Vector3, pos: Vector3)
  local up = math.abs(n:Dot(Vector3.yAxis)) > 0.99 and Vector3.zAxis or Vector3.yAxis
  local rot = CFrame.lookAt(Vector3.zero, n, up)
  return cf * CFrame.new(pos) * rot
end

function shape.getPointWithinBox(seed: number, cframe: CFrame, size: Vector3, normal: Enum.NormalId)
  debug.profilebegin("getPointWithinBox")

  local rng = Random.new(seed)

  local half = size / 2

  -- stylua: ignore
  local pos = Vector3.new(
    rng:NextNumber(-1, 1),
    rng:NextNumber(-1, 1),
    rng:NextNumber(-1, 1)
  ) * half

  local cf = shape.getSurfaceCFrame(cframe, Vector3.FromNormalId(normal), pos)

  debug.profileend()

  return cf
end

function shape.getPointOnBox(seed: number, cframe: CFrame, size: Vector3, normal: Enum.NormalId)
  debug.profilebegin("getPointOnBox")

  local rng = Random.new(seed)

  local n = Vector3.FromNormalId(normal)

  local half = size / 2
  local axes = Vector3.one - n:Abs()

  -- stylua: ignore
  local s = Vector3.new(
    rng:NextNumber(-1, 1),
    rng:NextNumber(-1, 1),
    rng:NextNumber(-1, 1)
  ) * half * axes

  local cf = shape.getSurfaceCFrame(cframe, n, s + n * half)

  debug.profileend()

  return cf
end

function shape.getPointWithinCylinder(
  seed: number,
  min_radius: number,
  partial: number,
  cframe: CFrame,
  size: Vector3,
  normal: Enum.NormalId
)
  debug.profilebegin("getPointWithinCylinder")

  local rng = Random.new(seed)

  local r = math.sqrt(rng:NextNumber(min_radius, 1))
  local theta = rng:NextNumber(0, 2 * math.pi)

  if normal == Enum.NormalId.Left or normal == Enum.NormalId.Right then
    cframe *= CFrame.fromOrientation(0, math.pi / 2 * (normal == Enum.NormalId.Right and -1 or 1), 0)
    size = Vector3.new(size.Z, size.Y, size.X)
  elseif normal == Enum.NormalId.Front or normal == Enum.NormalId.Back then
    cframe *= CFrame.fromOrientation(0, math.pi, 0)
  end

  local z = rng:NextNumber()
  local t = 1 - z ^ utility.lerp(0.5, 1, math.sqrt(partial))

  local width = utility.lerp(1, partial, t)

  -- stylua: ignore
  local pos = Vector3.new(
    t * 2 - 1,
    r * math.sin(theta) * width,
    r * math.cos(theta) * width
  ) * size / 2

  -- stylua: ignore
  local pos2 = Vector3.new(
    0,
    math.sin(theta) * width,
    math.cos(theta) * width
  ) * size / 2

  local tangent = Vector3.new(0, math.cos(theta) * width, -math.sin(theta) * width) * size / 2
  local up = tangent.Magnitude > 0.001 and tangent.Unit or cframe.UpVector
  local res = cframe * CFrame.new(pos) * CFrame.lookAt(Vector3.zero, pos2, up)

  debug.profileend()

  return res
end

function shape.getPointWithinSphere(
  seed: number,
  min_radius: number,
  partial: number,
  cframe: CFrame,
  size: Vector3,
  normal: Enum.NormalId
)
  debug.profilebegin("getPointWithinSphere")

  local rng = Random.new(seed)

  local u = rng:NextNumber()
  local v = rng:NextNumber()

  local theta = u * 2 * math.pi
  local phi = math.acos(2 * v - 1) * partial
  local r = rng:NextNumber(min_radius, 1) ^ (1 / 3)

  local sinTheta = math.sin(theta)
  local cosTheta = math.cos(theta)
  local sinPhi = math.sin(phi)
  local cosPhi = math.cos(phi)

  local n = Vector3.FromNormalId(normal)

  if normal == Enum.NormalId.Left or normal == Enum.NormalId.Right then
    size = Vector3.new(size.Z, size.Y, size.X)
  elseif normal == Enum.NormalId.Top or normal == Enum.NormalId.Bottom then
    size = Vector3.new(size.X, size.Z, size.Y)
  end

  local half = size / 2
  local cf = shape.getSurfaceCFrame(cframe, n, Vector3.zero)

  -- stylua: ignore
  local pos = Vector3.new(
    r * sinPhi * cosTheta,
    r * sinPhi * sinTheta,
    r * cosPhi
  ) * half

  local tangent = Vector3.new(-sinPhi * sinTheta, sinPhi * cosTheta, 0) * half

  local up = if tangent.Magnitude > 0.001 then tangent.Unit else Vector3.new(1, 0, 0)
  local res = cf * CFrame.Angles(0, math.pi, 0) * CFrame.new(pos) * CFrame.lookAt(Vector3.zero, pos, up)

  debug.profileend()

  return res
end

function shape.getPointWithinDisc(
  seed: number,
  min_depth: number,
  partial: number,
  cframe: CFrame,
  size: Vector3,
  normal: Enum.NormalId
)
  debug.profilebegin("getPointWithinDisc")

  local rng = Random.new(seed)

  local n = Vector3.FromNormalId(normal)
  local axes = Vector3.one - n:Abs() * min_depth

  local half = size / 2

  local z = rng:NextNumber(min_depth, 1)
  local d = utility.lerp(1, 0.5, partial ^ 4)

  local t = z

  local r = rng:NextNumber(1 - partial, 1) ^ d
  local theta = rng:NextNumber(0, 2 * math.pi)

  -- stylua: ignore
  local s = Vector3.new(
    t * 2 - 1,
    r * math.sin(theta),
    r * math.cos(theta)
  )

  if normal == Enum.NormalId.Bottom or normal == Enum.NormalId.Top then
    s = Vector3.new(s.Z, s.X, s.Y)
  elseif normal == Enum.NormalId.Front or normal == Enum.NormalId.Back then
    s = Vector3.new(s.Y, s.Z, s.X)
  end

  s *= half * axes

  local cf = shape.getSurfaceCFrame(cframe, n, s + n * min_depth * half)

  debug.profileend()

  return cf
end

return shape
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="611">
                <Properties>
                  <string name="Name">tween</string>
                  <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local logger = require("./logger")
local utility = require("./utility")

local Bezier = require("../obj/Bezier")

local tween = {}

tween.bezier_cache = {} :: { [string]: Bezier.Bezier }

function tween.fromParams(
  params: string,
  duration: number,
  animator: (alpha: number, deltaTime: number, elapsed: number) -> number?,
  awaitTween: RBXScriptConnection?,
  onFinish: ((organic: boolean) -> ())?,
  startAtZero: boolean?,
  stepAtPriority: number?,
  useGameTime: boolean?
)
  local bezier = tween.bezier_cache[params]

  if not bezier then
    local success, points = pcall(function()
      return utility.deserializePath(params)
    end)

    if not success then
      logger.error(`failed to decode bezier path data with error: {points}`)
    end

    -- use 0 accuracy as it saves performance because there is no need to calculate the length
    bezier = Bezier.new(points, 0)
    tween.bezier_cache[params] = bezier
  end

  local elapsed = 0

  local cleanupStepper

  local function step(deltaTime)
    if useGameTime ~= false then
      deltaTime = utility.getGameDelta(deltaTime)
    end

    -- roblox tweens apparently don't start from alpha=0
    if not startAtZero and elapsed == 0 then
      elapsed = math.clamp(elapsed + deltaTime, 0, math.max(duration, 0))
    end

    local t = math.clamp(elapsed / duration, 0, 1)
    local alpha = 1 - bezier:getEase(t).y

    local result = animator(alpha, deltaTime, elapsed)

    if
      (result == nil or (if duration ~= 0 then elapsed >= duration else elapsed > duration))
      and (not awaitTween or not awaitTween.Connected)
    then
      cleanupStepper()

      if onFinish then
        onFinish(true)
      end

      return
    end

    if result then
      elapsed = math.clamp(elapsed + result, 0, math.max(duration, 0.001))
    end
  end

  if not stepAtPriority then
    local connection: RBXScriptConnection
    connection = RunService.RenderStepped:Connect(step)

    cleanupStepper = function()
      connection:Disconnect()
    end

    return connection
  else
    local id = utility.getRandomId()

    RunService:BindToRenderStep(id, stepAtPriority, step)

    local bound = true

    cleanupStepper = function()
      if not bound then
        return
      end

      bound = false

      RunService:UnbindFromRenderStep(id)
    end

    return cleanupStepper
  end
end

function tween.timer(
  duration: number,
  counter: (deltaTime: number, elapsed: number) -> number,
  awaitTween: RBXScriptConnection?,
  scope: {}?,
  stepAtPriority: number?,
  useGameTime: boolean?
)
  local main = coroutine.running()

  local elapsed = 0

  local cleanupStepper

  local function step(deltaTime)
    if useGameTime ~= false then
      deltaTime = utility.getGameDelta(deltaTime)
    end

    local result = counter(deltaTime, elapsed)

    if
      (result == nil or (if duration ~= 0 then elapsed >= duration else elapsed > duration))
      and (not awaitTween or not awaitTween.Connected)
    then
      cleanupStepper()
      task.spawn(main)
      return
    end

    if result then
      elapsed = math.clamp(elapsed + result, 0, math.max(duration, 0.001))
    end
  end

  if not stepAtPriority then
    local connection = RunService.RenderStepped:Connect(step)

    cleanupStepper = function()
      connection:Disconnect()
    end
  else
    local id = utility.getRandomId()

    RunService:BindToRenderStep(id, stepAtPriority, step)

    local bound = true

    cleanupStepper = function()
      if not bound then
        return
      end

      bound = false

      RunService:UnbindFromRenderStep(id)
    end
  end

  if scope then
    table.insert(scope, cleanupStepper)
  end

  coroutine.yield()
end

return tween
]]></string>
                </Properties>
              </Item>
              <Item class="ModuleScript" referent="612">
                <Properties>
                  <string name="Name">utility</string>
                  <string name="Source"><![CDATA[--!native
--!nolint LocalShadow
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local attr = require("./attributes")
local logger = require("./logger")

local Promise = require(ReplicatedStorage.Packages.Promise)

local utility = {}

local configuredTimeService: any = nil
local didResolveTimeService = false

local function resolveTimeService()
	if didResolveTimeService then
		return configuredTimeService
	end

	didResolveTimeService = true

	local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
	local servicesFolder = sharedFolder and sharedFolder:FindFirstChild("Services")
	local systemFolder = servicesFolder and servicesFolder:FindFirstChild("System")
	local timeServiceModule = systemFolder and systemFolder:FindFirstChild("TimeService")

	if not timeServiceModule or not timeServiceModule:IsA("ModuleScript") then
		return nil
	end

	local ok, timeService = pcall(require, timeServiceModule)
	if ok and type(timeService) == "table" then
		configuredTimeService = timeService
	end

	return configuredTimeService
end

utility.PLUGIN_CONTEXT = script:FindFirstAncestorOfClass("Plugin")
	or (RunService:IsStudio() and not RunService:IsRunning())

utility.SERVER_CONTEXT = RunService:IsServer() or utility.PLUGIN_CONTEXT

utility.DEG_TO_RAD = math.pi / 180

utility.BEZIER_TAG = "BezierParticle"
utility.LIGHTNING_TAG = "LightningBolt"
utility.SHOCKWAVE_TAG = "Shockwave"
utility.SCREENSHAKE_TAG = "CameraShake"

utility.PROPERTY_TWEENER_TAG = "PropertyTweener"
utility.PROPERTY_RANDOMIZER_TAG = "PropertyRandomizer"

utility.ATTRIBUTE_TWEENER_TAG = "AttributeTweener"
utility.ATTRIBUTE_RANDOMIZER_TAG = "AttributeRandomizer"

utility.ENABLED_VFX_TAG = "ConstantVFX"
utility.TEXTURE_LOAD_TAG = "LoadVFXTextures"

utility.CLEANUP_TAG = "__forge__cleanupOnExit"
utility.EMIT_EXCLUDE_TAG = "__forge_excludeFromEmit"

utility.RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1

utility.COLLISION_GROUPS = {
	StudioSelectable = {},

	ForgeDebris = {
		ForgeDebris = false,
	},

	ForgeMouseIgnore = {
		StudioSelectable = false,
	},
}

function utility.setTimeService(timeService)
	configuredTimeService = timeService
	didResolveTimeService = true
end

function utility.getGameSpeed(): number
	local timeService = resolveTimeService()
	if not timeService or type(timeService.GetGameSpeed) ~= "function" then
		return 1
	end

	local speed = timeService:GetGameSpeed()
	return if typeof(speed) == "number" then math.max(0, speed) else 1
end

function utility.getGameDelta(deltaTime: number): number
	return deltaTime * utility.getGameSpeed()
end

function utility.gameWait(duration: number): number
	local timeService = resolveTimeService()

	-- Preserve task.wait(0)'s one-frame yield used by Forge emitters.
	if duration <= 0 or not timeService or type(timeService.DeltaWait) ~= "function" then
		return task.wait(duration)
	end

	return timeService.DeltaWait(duration)
end

utility.COPY_SPECIALMESH_PROPERTIES = {
	"MeshId",
	"MeshType",
	"Offset",
	"Scale",
	"TextureId",
	"VertexColor",
}

utility.COPY_PART_PROPERTIES = {
	"CastShadow",

	"Color",

	"Material",
	"MaterialVariant",
	"Reflectance",

	"Shape",

	"FrontSurface",
	"BackSurface",
	"LeftSurface",
	"RightSurface",
	"TopSurface",
	"BottomSurface",
}

utility.COPY_EXTENDED_PART_PROPERTIES = {
	"Size",
	"Transparency",

	"CustomPhysicalProperties",

	"CanCollide",
	"CanQuery",
	"CanTouch",

	"CollisionGroup",
}

local LOCKS = setmetatable({} :: { [Instance]: boolean }, { __mode = "k" })

function utility.lock(ref: Instance)
	if LOCKS[ref] then
		return true
	end

	LOCKS[ref] = coroutine.running()

	return false
end

function utility.unlock(ref: Instance, key: thread?)
	local thread = LOCKS[ref]

	if coroutine.running() ~= thread and key ~= thread then
		logger.error("attempt to unlock an instance owned by a different thread")
	end

	LOCKS[ref] = nil
end

function utility.setCollisionGroups(groups)
	local rules = {}

	for name, list in groups do
		PhysicsService:RegisterCollisionGroup(name)

		if not name:match("Studio") or RunService:IsStudio() then
			rules[name] = list
		end
	end

	for name, list in rules do
		for group, collidable in list do
			if group:match("Studio") and not RunService:IsStudio() then
				continue
			end

			PhysicsService:CollisionGroupSetCollidable(name, group, collidable)
		end
	end
end

local last_id = 0

function utility.getRandomId()
	last_id += 1
	return tostring(last_id)
end

function utility.copyProperties(from: Instance, to: Instance, list: { string })
	for _, k in list do
		to[k] = from[k]
	end
end

function utility.lerp(a: number, b: number, t: number)
	return a + (b - a) * t
end

function utility.try<R...>(msg: string, func: (...any) -> R..., ...: any): (boolean, R...)
	local res = { xpcall(func, function(err)
		logger.warn(string.format(msg, err))
	end, ...) }

	return res[1], table.unpack(res, 2)
end

function utility.reboundfn<A>(sec: number, func: (...A) -> never): (...A) -> never
	local lastRunThread

	return function(...)
		if lastRunThread then
			task.cancel(lastRunThread)
		end

		local args = { ... }

		lastRunThread = task.delay(sec, function()
			lastRunThread = nil
			func(table.unpack(args))
		end)
	end
end

function utility.randomUnitVector(min: Vector3, max: Vector3, rng: Random?)
	local rng = rng or Random.new()
	return Vector3.new(rng:NextNumber(min.X, max.X), rng:NextNumber(min.Y, max.Y), rng:NextNumber(min.Z, max.Z))
end

function utility.getImpulseForce(start: Vector3, goal: Vector3, duration: number)
	return (goal - start) / duration + Vector3.new(0, workspace.Gravity * duration * 0.5, 0)
end

function utility.isMeshVFX(obj: Instance)
	return obj
		and obj:IsA("Model")
		and obj:FindFirstChild("Start")
		and (obj :: any).Start:IsA("BasePart")
		and obj:FindFirstChild("End")
		and (obj :: any).End:IsA("BasePart")
end

function utility.isSpinModelStatic(model: Model)
	return attr.get(model, "SpinRotation", vector.zero, true) == vector.zero
		and attr.get(model, "Scale_Start", 1, true) == 1
		and attr.get(model, "Scale_End", 1, true) == 1
		and (attr.get(model, "SyncPosition", false, true) == false)
end

function utility.shouldSkipNested(obj: Instance)
	return obj:IsA("Beam")
		or obj:HasTag(utility.BEZIER_TAG)
		or obj:HasTag(utility.LIGHTNING_TAG)
		or utility.isMeshVFX(obj)
		or (obj:IsA("BasePart") and utility.findFirstClassWithTag(obj, "Attachment", utility.SHOCKWAVE_TAG) ~= nil)
end

function utility.getTarget(obj: Instance): Instance?
	local objectValue = obj:FindFirstChildOfClass("ObjectValue")

	if objectValue and objectValue.Value then
		return objectValue.Value
	end

	local parent = obj.Parent

	if not parent then
		return nil
	end

	while parent:IsA("Folder") do
		parent = parent.Parent

		if not parent then
			return nil
		end
	end

	return parent
end

function utility.createEmitPromise(
	effects: any,
	instance: Instance,
	effectDepth: number,
	emitFunc: any,
	context: { _promises: { any } }?
)
	local promise = Promise.new(function(resolve, _, onCancel)
		local scope: { [any]: any } = {}
		scope.depth = effectDepth
		scope.effects = effects
		scope._context = context

		onCancel(function()
			if scope._onCancel then
				for _, cb in scope._onCancel do
					cb()
				end
			end

			utility.cleanupScope(scope)
		end)

		emitFunc(scope)

		utility.cleanupScope(scope)

		resolve()
	end)

	if context then
		table.insert(context._promises, promise)
	end

	return promise
end

function utility.onCancel(scope: { [any]: any }, callback: () -> ())
	if not scope._onCancel then
		scope._onCancel = {}
	end

	table.insert(scope._onCancel, callback)
end

local ENABLED_CANCEL_TOKENS: { [Instance]: { _promises: { any }, _scopes: { { unknown } } } } = setmetatable(
	{},
	{ __mode = "k" }
) :: any

local FORCE_EMIT_SET: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any

function utility.forceEmit(obj: Instance, value: boolean)
	FORCE_EMIT_SET[obj] = if value then true else nil :: any
end

function utility.isForceEmitting(obj: Instance): boolean
	return FORCE_EMIT_SET[obj] == true
end

function utility.setEnabledCancelToken(obj: Instance, token: { _promises: { any }, _scopes: { { unknown } } }?)
	ENABLED_CANCEL_TOKENS[obj] = token :: any
end

function utility.getEnabledCancelToken(obj: Instance)
	return ENABLED_CANCEL_TOKENS[obj]
end

function utility.cancelToken(token: { _promises: { any }, _scopes: { { unknown } } })
	for _, promise in token._promises do
		promise:cancel()
	end

	for _, scope in token._scopes do
		utility.cleanupScope(scope, true)
	end

	table.clear(token._promises)
	table.clear(token._scopes)
end

function utility.stopEmitDuration(ref: Instance)
	local token = utility.getEnabledCancelToken(ref)

	attr.trigger(ref, "Enabled", false)
	attr.clearState(ref)
	utility.forceEmit(ref, false)

	return token
end

function utility.awaitEmitDuration(token: { _promises: { any } }?)
	if not token then
		return
	end

	local pending = {}

	for _, promise in token._promises do
		table.insert(pending, promise)
	end

	if #pending > 0 then
		Promise.all(pending):await()
	end
end

function utility.cleanupScope(scope: { [any]: any }, syncFunctions: boolean?)
	local depth = scope.depth
	local effects = scope.effects

	local context = scope._context
	local onCancelCbs = scope._onCancel

	for k, v in scope do
		-- Skip scope metadata fields
		if k == "depth" or k == "effects" or k == "_context" or k == "_onCancel" then
			continue
		end

		local t = typeof(v)

		if t == "Instance" then
			v:Destroy()
		elseif t == "RBXScriptConnection" then
			v:Disconnect()
		elseif t == "thread" then
			if coroutine.status(v) ~= "dead" then
				task.cancel(v)
			end
		elseif t == "function" then
			if syncFunctions then
				v()
			else
				task.spawn(v)
			end
		elseif t == "table" then
			utility.cleanupScope(v)
		end
	end

	table.clear(scope)

	scope.depth = depth
	scope.effects = effects

	scope._context = context
	scope._onCancel = onCancelCbs
end

function utility.protectParent(scope: { [any]: any }, parent: Instance)
	table.insert(
		scope,
		parent.AncestryChanged:Connect(function(_, new)
			if parent.Parent == workspace.Terrain then
				return
			end

			parent.Parent = workspace.Terrain
		end)
	)
end

function utility.findFirstClassWithTag(obj: Instance?, class: string, tag: string)
	if not obj or obj.Parent == game then
		return
	end

	if obj.ClassName == class and obj:HasTag(tag) then
		return obj
	else
		return utility.findFirstClassWithTag(obj.Parent, class, tag)
	end
end

function utility.cloneParticleAncestry(
	particle: ParticleEmitter,
	map: { [Instance?]: Instance }
): (Instance?, Instance?)
	if not particle:FindFirstAncestorWhichIsA("BasePart") and not particle:FindFirstAncestorOfClass("Attachment") then
		return
	end

	local function findAncestor(obj: Instance?)
		if not obj then
			return
		end

		local ancestor = obj

		if obj.Parent and (obj.Parent:IsA("BasePart") or obj.Parent:IsA("Attachment")) then
			ancestor = findAncestor(obj.Parent)
		end

		return ancestor
	end

	local function recurse(obj: Instance?)
		if not obj then
			return
		end

		local created = map[obj]

		if created then
			return created, if obj == particle then map[obj.Parent] else map[findAncestor(obj.Parent)] or map[obj]
		end

		local clone = Instance.fromExisting(obj)
		clone.Archivable = false

		if clone:IsA("BasePart") then
			clone.Locked = true
		end

		local ancestor = clone

		if map then
			map[obj] = clone
		end

		if obj.Parent and (obj.Parent:IsA("BasePart") or obj.Parent:IsA("Attachment")) then
			local parent, pa = recurse(obj.Parent)

			if pa then
				ancestor = pa
			end

			if parent then
				clone.Parent = parent
			end
		end

		return clone, ancestor
	end

	return recurse(particle.Parent)
end

function utility.getTransformedOriginExtents(parent: Instance)
	local originCFrame, originSize = CFrame.identity, vector.zero

	if parent:IsA("BasePart") then
		originSize = parent.Size
		originCFrame = parent.CFrame
	elseif parent:IsA("Attachment") then
		originCFrame = parent.WorldCFrame

		local newParent = parent.Parent

		-- step 1: find the full origin cframe by walking up the tree, and processing the upmost attachment
		local positionScale = attr.get(parent, "PositionScale", vector.zero, true)

		if newParent then
			if newParent:IsA("BasePart") and positionScale ~= vector.zero then
				local offset = (newParent.Size / 2) * positionScale
				originCFrame = originCFrame + offset
			end
		end

		-- step 2: apply rotation on final origin cframe
		local overrideWorldRotation = attr.get(parent, "OverrideWorldRotation", false, true)
		local worldRotation = attr.get(parent, "WorldRotation", vector.zero, true)

		if overrideWorldRotation then
			local rotRad = worldRotation * utility.DEG_TO_RAD
			local position = originCFrame.Position

			originCFrame = CFrame.new(position) * CFrame.fromOrientation(rotRad.X, rotRad.Y, rotRad.Z)
		end
	end

	return originCFrame, originSize
end

function utility.getMeshDecals(ref: Model, start: BasePart)
	local legacy_isFlipbook = attr.get(ref, "Flipbook", false, true)

	local decals = {}
	local flipbooks = {}
	local fromToMap = {}

	local function filter(list: { Instance }): { Decal }
		local filtered = {}

		for _, v in list do
			if v:IsA("Decal") then
				table.insert(filtered, v)
			end
		end

		return filtered
	end

	if legacy_isFlipbook then
		decals = filter(start:GetChildren())
	else
		local originalEnd = ref:FindFirstChild("End")
		local originalStart = ref:FindFirstChild("Start")

		if originalEnd then
			for _, v in start:GetChildren() do
				if not v:IsA("Decal") then
					continue
				end

				local from = v

				local to = originalEnd:FindFirstChild(v.Name)

				if not to or not to:IsA("Decal") then
					continue
				end

				table.insert(decals, v)

				fromToMap[from] = to

				if not attr.get(v, "FlipbookEnabled", nil) then
					table.insert(decals, v)
				else
					local data = attr.get(v, "FlipbookTextures", nil)

					if data then
						flipbooks[v] = utility.deserializeFlipbook(data)
					end
				end
			end

			for _, v in originalStart:GetChildren() do
				if not v:IsA("Decal") then
					continue
				end

				-- convert children decals to flipbooks
				local children = v:GetChildren()

				do
					local offset = 0

					for i = 1, #children do
						i -= offset

						local obj = children[i]

						if not obj:IsA("Decal") then
							table.remove(children, i)
							offset += 1
						end
					end
				end

				if #children ~= 0 then
					local function idx(str: string)
						return tonumber(str:match("%d+")) or 0
					end

					table.sort(children, function(a, b)
						return idx(a.Name) < idx(b.Name)
					end)

					local ids = {}

					for _, obj in children do
						table.insert(ids, idx(obj.Texture))
						obj:Destroy()
					end

					local buf = utility.serializeFlipbook(ids)

					attr.set(v, "FlipbookEnabled", true)
					attr.set(v, "FlipbookTextures", buffer.tostring(buf))
				end
			end
		end
	end

	return decals, flipbooks, fromToMap
end

function utility.assembleMeshVFX(start: BasePart, scope: { any }, shared_part_cache: any)
	local id = utility.getRandomId()

	if start:IsA("Part") then
		local objAbstr = shared_part_cache:get(id)
		objAbstr.CFrame = start.CFrame

		local obj = objAbstr._getReal()

		utility.copyProperties(start, obj, utility.COPY_PART_PROPERTIES)
		utility.copyProperties(start, obj, utility.COPY_EXTENDED_PART_PROPERTIES)

		local clone = start:Clone()

		for _, child in clone:GetChildren() do
			child.Parent = obj
		end

		clone:Destroy()

		table.insert(scope, function()
			shared_part_cache:free(id)
		end)

		return objAbstr
	else
		local clone = start:Clone()
		clone.Archivable = false
		clone.Locked = true
		clone.Parent = workspace.Terrain

		clone:AddTag(utility.CLEANUP_TAG)

		table.insert(scope, clone)

		return clone
	end
end

function utility.getBezierPoints(root: Attachment, metadata: boolean?)
	local objs = root:GetChildren()

	table.sort(objs, function(a, b)
		return tonumber(a.Name) < tonumber(b.Name)
	end)

	local points: { vector } = {}
	local attachments: { Attachment } = {}
	local attachmentToPointMap: { [Attachment]: vector } = {}

	local function vec(p: Attachment)
		local w = root.WorldCFrame:PointToObjectSpace(p.WorldPosition)
		local pos = vector.create(w.X, w.Y, w.Z)

		table.insert(points, pos)

		if metadata then
			attachmentToPointMap[p] = pos
			table.insert(attachments, p)
		end

		return pos
	end

	for i, p in objs do
		local t0 = p:FindFirstChild("T0")
		local t1 = p:FindFirstChild("T1")

		if i == 1 then
			vec(p)
		end

		-- left
		if i ~= 1 then
			if t1 then
				vec(t1)
			else
				vec(p)
			end
		end

		if i ~= 1 and i ~= #objs then
			vec(p)
		end

		-- right
		if i ~= #objs then
			if t0 then
				vec(t0)
			else
				vec(p)
			end
		end

		if i == #objs then
			vec(p)
		end
	end

	return points, attachments, attachmentToPointMap
end

function utility.scaleNumberSequence(
	seq: NumberSequence,
	scale: number | (value: number, envelope: number) -> (number, number)
)
	if scale == 1 then
		return seq
	end

	local scaled = {}

	for _, keypoint in seq.Keypoints do
		local value, envelope

		if typeof(scale) == "function" then
			value, envelope = scale(keypoint.Value, keypoint.Envelope)
		else
			value, envelope = keypoint.Value * scale, keypoint.Envelope * scale
		end

		table.insert(scaled, NumberSequenceKeypoint.new(keypoint.Time, value, envelope))
	end

	return NumberSequence.new(scaled)
end

function utility.serializePath(points: { Path2DControlPoint })
	local buf = buffer.create(#points * 4 * 6)

	local offset = 0

	for i, p in points do
		local px = p.Position.X.Scale
		local py = p.Position.Y.Scale

		if i ~= 1 then
			buffer.writef32(buf, offset, px + p.LeftTangent.X.Scale)
			buffer.writef32(buf, offset + 4, py + p.LeftTangent.Y.Scale)

			offset += 8
		end

		buffer.writef32(buf, offset, px)
		buffer.writef32(buf, offset + 4, py)

		offset += 8

		if i ~= #points then
			buffer.writef32(buf, offset, px + p.RightTangent.X.Scale)
			buffer.writef32(buf, offset + 4, py + p.RightTangent.Y.Scale)

			offset += 8
		end
	end

	return buf
end

function utility.deserializePath(data: string | buffer)
	local buf = typeof(data) == "string" and buffer.fromstring(data) or data
	local count = buffer.len(buf) / 24

	local points = {}

	for i = 0, count - 1 do
		local offset = i * 4 * 6

		local px = buffer.readf32(buf, offset)
		local py = buffer.readf32(buf, offset + 4)

		table.insert(points, vector.create(px, py))

		if i ~= count - 1 then
			local t1x = buffer.readf32(buf, offset + 8)
			local t1y = buffer.readf32(buf, offset + 12)

			local t2x = buffer.readf32(buf, offset + 16)
			local t2y = buffer.readf32(buf, offset + 20)

			table.insert(points, vector.create(t1x, t1y))
			table.insert(points, vector.create(t2x, t2y))
		end
	end

	return points
end

local flipbook_common = require("./common/flipbook")

utility.serializeFlipbook = flipbook_common.serialize
utility.deserializeFlipbook = flipbook_common.deserialize

-- out cubic
utility.default_bezier = buffer.tostring(utility.serializePath({
	Path2DControlPoint.new(UDim2.fromScale(0, 1), UDim2.new(), UDim2.fromScale(0.215, -0.61)),
	Path2DControlPoint.new(UDim2.fromScale(1, 0), UDim2.fromScale(-0.645, 0), UDim2.new()),
}))

-- linear
utility.linear_bezier = buffer.tostring(utility.serializePath({
	Path2DControlPoint.new(UDim2.fromScale(0, 1)),
	Path2DControlPoint.new(UDim2.fromScale(1, 0)),
}))

function utility.scaleAttribute(obj: Instance, factor: number, name: string)
	local value = attr.get(obj, name, nil)

	if value ~= nil then
		if typeof(value) == "number" then
			attr.set(obj, name, value * factor)
		elseif typeof(value) == "Vector3" then
			attr.set(obj, name, value * factor)
		elseif typeof(value) == "NumberRange" then
			attr.set(obj, name, NumberRange.new(value.Min * factor, value.Max * factor))
		end
	end
end

function utility.scaleAttachmentDistance(a0: Attachment?, a1: Attachment?, factor: number)
	if not a0 or not a1 then
		return
	end

	local midpoint = (a0.Position + a1.Position) / 2

	a0.Position = midpoint + (a0.Position - midpoint) * factor
	a1.Position = midpoint + (a1.Position - midpoint) * factor
end

return utility
]]></string>
