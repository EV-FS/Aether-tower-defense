          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">Tower</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local TraitData = require(ReplicatedStorage.Settings.Data.TraitData)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)
local useColorSequenceCycle = require(ReplicatedStorage.Shared.Modules.UI.Hooks.useColorSequenceCycle)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local RigViewport = require(ReplicatedStorage.UI.Components.RigViewport)
type Reactive<T> = T | (() -> T)

type Props = {
	TowerName: Reactive<string>,
	TowerLevel: Reactive<number>?,
	TraitName: Reactive<string>?,
}

local create = Vide.create
local read = Vide.read
local derive = Vide.derive

return function(props: Props)
	local towerModel = derive(function()
		return ReplicatedStorage.Assets.Towers:FindFirstChild(read(props.TowerName))
	end)

	local idleAnimation = derive(function()
		local animations = ReplicatedStorage.Assets.Animations:FindFirstChild(read(props.TowerName))

		return animations and animations:FindFirstChild("Idle")
	end)

	local towerPrice = derive(function()
		local towerInfo = TowerData.ByName[read(props.TowerName)]
		return towerInfo and towerInfo.Stats[0].Cost
	end)

	local traitInfo = derive(function()
		return TraitData.ByName[read(props.TraitName)]
	end)

	local traitGradientData = derive(function()
		return traitInfo() and RarityRegistry.Get(traitInfo().Rarity).Presentation
	end)

	return create("Frame")({
		Name = "Content",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),

		RigViewport({
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundTransparency = 1,
			Position = UDim2.fromScale(0.5, 0),
			Size = UDim2.fromScale(1, 0.95),

			CenterOffset = Vector3.new(0, 0.55, 0),
			Rig = towerModel,
			UseWorldModel = true,
			Zoom = 0.7,

			Animation = idleAnimation,
			AnimationLooped = true,
			AnimationFadeTime = 0,
		}),

		create("TextLabel")({
			Name = "Name",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.107999, 0.618754),
			Size = UDim2.fromScale(0.84887, 0.172688),
			Text = props.TowerName,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),
		}),

		create("ImageLabel")({
			Name = "Level",
			BackgroundTransparency = 1,
			Image = "rbxassetid://104083646922843",
			Position = UDim2.fromScale(-0.0129994, -0.05),
			Size = UDim2.fromScale(0.653434, 0.238322),
			ZIndex = 10,
			Visible = function()
				return read(props.TowerLevel) ~= nil
			end,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
				AspectRatio = 3.2,
			}),

			create("TextLabel")({
				Name = "TextLabel",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.new(
					"rbxasset://fonts/families/SourceSansPro.json",
					Enum.FontWeight.Bold,
					Enum.FontStyle.Normal
				),
				Position = UDim2.fromScale(0.3, 0.489),
				Size = UDim2.fromScale(0.477775, 0.75514),
				Text = function()
					return `Lv. {read(props.TowerLevel)}`
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,

				create("UIStroke")({
					Name = "UIStroke",
					Thickness = 2,
				}),

				create("UIGradient")({
					Name = "UIGradient",
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(104, 106, 211)),
					}),
					Rotation = 90,
				}),
			}),
		}),

		create("ImageLabel")({
			Name = "Trait",
			BackgroundTransparency = 1,
			Image = function()
				return if traitInfo() then traitInfo().Image else ""
			end,
			Position = UDim2.fromScale(0.64, 0.03),
			Size = UDim2.fromScale(0.359565, 0.31687),
			Visible = function()
				return read(props.TraitName) ~= nil
			end,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
			}),

			create("UIGradient")({
				Name = "UIGradient",
				useColorSequenceCycle(function()
					return if traitGradientData() then traitGradientData().Gradient else ColorSequence.new(Color3.new())
				end, function()
					return if traitGradientData() then traitGradientData().ShimmerSpeed else 1
				end),

				Rotation = 45,
			}),
		}),

		create("TextLabel")({
			Name = "Price",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.108, 0.75),
			Size = UDim2.fromScale(0.641, 0.2),
			Text = function()
				return `₩{NumberUtils.FormatComma(towerPrice() or 0)}`
			end,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,
			Visible = function()
				return towerPrice() ~= nil
			end,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),

			create("UIGradient")({
				Name = "UIGradient",
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 152, 62)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 160, 26)),
				}),
				Rotation = 90,
			}),
		}),
	})
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TowerButton</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local TowerData = require(ReplicatedStorage.Settings.Data.TowerData)
local TraitData = require(ReplicatedStorage.Settings.Data.TraitData)
local UnitCatalog = require(ReplicatedStorage.Settings.Data.UnitCatalog)
local UnitViewportProfiles = require(ReplicatedStorage.Settings.Visuals.UnitViewportProfiles)
local NumberUtils = require(ReplicatedStorage.Shared.Modules.Utils.NumberUtils)
local RarityRegistry = require(ReplicatedStorage.Shared.Modules.Core.Rarity.RarityRegistry)
local CardFrame = require(ReplicatedStorage.UI.Components.Card.CardFrame)
local TowerViewport = require(ReplicatedStorage.UI.Components.TowerViewport)

local create = Vide.create
local read = Vide.read
local show = Vide.show
local spring = Vide.spring

return function(props)
	local performanceMode = props.PerformanceMode == true
	local towerInfo = TowerData.ByName[props.TowerName]
	local rarity = UnitCatalog.GetRarity(props.TowerName)
	local viewportProfile = UnitViewportProfiles.GetCard(props.TowerName)
	local usePortraitBounds = viewportProfile.BoundsMode == "Portrait"
	local useCharacterBounds = viewportProfile.BoundsMode == "Character"
	local isInWindow = props.IsInWindow or function() return true end
	local animateWindowVisibility = props.IsInWindow ~= nil and not performanceMode
	local shouldRenderViewport = function()
		return isInWindow() and (props.LiveViewport == nil or read(props.LiveViewport) == true)
	end
	local function windowSpring(openValue, closedValue, period: number, damping: number)
		if not animateWindowVisibility then
			return openValue
		end
		return spring(function()
			return if isInWindow() then openValue else closedValue
		end, period, damping)
	end
	local cost = if towerInfo
			and towerInfo.Stats
			and towerInfo.Stats[0]
			and towerInfo.Stats[0].Cost
		then towerInfo.Stats[0].Cost
		elseif
			towerInfo
			and towerInfo.Stats
			and towerInfo.Stats[1]
			and towerInfo.Stats[1].Cost
		then towerInfo.Stats[1].Cost
		else 0
	local level = if props.TowerData and typeof(props.TowerData.Lv) == "number" then props.TowerData.Lv else 0
	local traitName = if props.TowerData then props.TowerData.Trait else nil
	local traitInfo = if traitName then TraitData.ByName[traitName] else nil
	local gradient = RarityRegistry.Get(rarity).Presentation.Gradient
	local traitGradient = if traitInfo
		then RarityRegistry.Get(traitInfo.Rarity).Presentation.Gradient
		else RarityRegistry.Get("Common").Presentation.Gradient

	return CardFrame({
		Bind = props.Bind,
		Name = props.Name or "ImageButton",
		Image = "rbxassetid://87496848270095",
		ImageTransparency = windowSpring(0, 1, 0.5, 1),
		LayoutOrder = props.LayoutOrder or 0,
		Position = props.Position,
		Size = props.Size or UDim2.fromScale(0.186, 0.125),
		Activated = props.OnActivated,
		Rarity = rarity,
		PerformanceMode = performanceMode,
		ShimmerEnabled = not performanceMode,
		GlowEnabled = not performanceMode,
		HoverEnabled = not performanceMode,
		ButtonEffect = not performanceMode,
		Selected = props.IsSelected,
		ZIndex = function()
			if props.IsSelected() then
				return 10
			elseif props.IsEquipped() then
				return 5
			end

			return 1
		end,
		Content = {
		create("ImageLabel")({
			Name = "TowerImageFallback",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Image = UnitCatalog.GetImage(props.TowerName),
			Position = UDim2.fromScale(0.5, 0.51),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(0.9, 0.9),
			Visible = function() return not shouldRenderViewport() end,
			ZIndex = 5,
		}),

		show(shouldRenderViewport, function()
		return TowerViewport({
			Name = "TowerImage",
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundTransparency = 1,
			Position = windowSpring(UDim2.fromScale(0.5, 0.51), UDim2.fromScale(0.5, 0.69), 0.3, 0.9),
			Size = UDim2.fromScale(0.9, 0.9),
			TowerName = props.TowerName,
			Active = shouldRenderViewport,
			UseViewportModel = true,
			UseCharacterBounds = useCharacterBounds,
			UsePortraitBounds = usePortraitBounds,
			PortraitUpdateInterval = if performanceMode then 1 / 20 else 0,
			CenterOnRoot = not viewportProfile.CenterOnBounds,
			RenderEffects = false,
			FitPadding = viewportProfile.FitPadding,
			FieldOfView = 35,
			FocusYOffset = viewportProfile.FocusYOffset,
			CameraDirection = Vector3.new(0, 0, -1),
			ModelRotation = 15,
			AnimationName = "Idle",
			AnimationLevel = level,
			AnimationFadeTime = 0,
			AnimationLooped = true,
			AnimationSpeed = 1,
			Ambient = Color3.fromRGB(205, 205, 205),
			ZIndex = 5,
		})
		end),

		create("TextLabel")({
			Name = "Rarity",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.108, 0.535),
			Size = UDim2.fromScale(0.7, 0.105),
			Text = string.upper(rarity),
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,

			create("UIGradient")({
				Color = gradient,
			}),

			create("UIStroke")({
				Thickness = 1.5,
			}),
		}),

		create("TextLabel")({
			Name = "Name",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.107999, 0.618754),
			Size = UDim2.fromScale(0.84887, 0.172688),
			Text = props.TowerName or "Unknown",
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),
		}),

		--[[create("UIAspectRatioConstraint")({
			Name = "UIAspectRatioConstraint",
		}),--]]

		create("ImageLabel")({
			Name = "Level",
			BackgroundTransparency = 1,
			Image = "rbxassetid://104083646922843",
			Position = UDim2.fromScale(-0.0129994, -0.05),
			Size = UDim2.fromScale(0.653434, 0.238322),
			ZIndex = 10,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
				AspectRatio = 3.2,
			}),

			create("TextLabel")({
				Name = "TextLabel",
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				FontFace = Font.new(
					"rbxasset://fonts/families/SourceSansPro.json",
					Enum.FontWeight.Bold,
					Enum.FontStyle.Normal
				),
				Position = UDim2.fromScale(0.3, 0.489),
				Size = UDim2.fromScale(0.477775, 0.75514),
				Text = `Lvl {level}`,
				TextColor3 = Color3.new(1, 1, 1),
				TextScaled = true,

				create("UIStroke")({
					Name = "UIStroke",
					Thickness = 2,
				}),

				create("UIGradient")({
					Name = "UIGradient",
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(104, 106, 211)),
					}),
					Rotation = 90,
				}),
			}),
		}),

		create("ImageLabel")({
			Name = "Trait",
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Image = if traitInfo then traitInfo.Image else "",
			Position = UDim2.fromScale(0.975, 0.2),
			Size = UDim2.fromScale(0.24, 0.24),
			Visible = traitInfo ~= nil,
			ZIndex = 13,

			create("UIAspectRatioConstraint")({
				Name = "UIAspectRatioConstraint",
			}),

			create("UIGradient")({
				Name = "RarityGradient",
				Color = traitGradient,
				Rotation = 30,
			}),
		}),

		create("TextLabel")({
			Name = "Cost",
			BackgroundTransparency = 1,
			FontFace = Font.new(
				"rbxasset://fonts/families/SourceSansPro.json",
				Enum.FontWeight.Bold,
				Enum.FontStyle.Normal
			),
			Position = UDim2.fromScale(0.108, 0.782623),
			Size = UDim2.fromScale(0.641, 0.2),
			Text = `₩{NumberUtils.FormatComma(cost)}`,
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 10,

			create("UIStroke")({
				Name = "UIStroke",
				Thickness = 2,
			}),

			create("UIGradient")({
				Name = "UIGradient",
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 152, 62)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 160, 26)),
				}),
				Rotation = 90,
			}),
		}),
		create("ImageLabel")({
			Name = "EquippedCheck",
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Image = "rbxassetid://91966631627808",
			Position = UDim2.fromScale(1.025, -0.025),
			Size = UDim2.fromScale(0.24, 0.24),
			Visible = props.IsEquipped,
			ZIndex = 14,
			create("UIAspectRatioConstraint")({}),
		}),

		create("ImageLabel")({
			Name = "Locked",
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Image = "rbxassetid://70564113534462",
			Position = UDim2.fromScale(0.96, 0.04),
			Size = UDim2.fromScale(0.25, 0.25),
			Visible = props.IsLocked or false,
			ZIndex = 12,
			create("UIAspectRatioConstraint")({}),
		}),
		},
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">TowerViewport</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ViewportModel = require(ReplicatedStorage.Shared.Modules.Utils.ViewportModel)
local PortraitCamera = require(script.Parent.PortraitCamera)

local cleanup = Vide.cleanup
local create = Vide.create
local effect = Vide.effect
local read = Vide.read
local source = Vide.source
local action = Vide.action

local DEFAULT_CAMERA_DIRECTION = Vector3.new(0, 0, -1)
local DEFAULT_FIELD_OF_VIEW = 35
local DEFAULT_FIT_PADDING = 1.1
local MINIMUM_BOUNDS_RADIUS = 0.01
local MAX_PREPARED_TEMPLATES = 8

type Reactive<T> = T | (() -> T)
type AnimationId = number | string

type ModelState = {
	Instance: Model,
	TowerName: string,
	SourceAsset: Model?,
	RootPart: BasePart?,
	HasPortraitHead: boolean,
	FocusOffset: Vector3,
	BoundsRadius: number,
}

type PreparedTemplate = {
	Model: Model,
	FitPointClouds: { [string]: { Vector3 } },
	HasPortraitHead: boolean,
	FocusOffset: Vector3,
	BoundsRadius: number,
	LastUsed: number,
}

local preparedTemplates: { [Model]: PreparedTemplate } = {}
local preparedTemplateCount = 0
local preparedTemplateClock = 0

export type Props = {
	TowerName: Reactive<string?>,
	Name: string?,
	AnchorPoint: Reactive<Vector2>?,
	Position: Reactive<UDim2>?,
	Size: Reactive<UDim2>?,
	Visible: Reactive<boolean>?,
	Active: Reactive<boolean>?,
	ZIndex: Reactive<number>?,
	BackgroundColor3: Reactive<Color3>?,
	BackgroundTransparency: Reactive<number>?,
	ImageTransparency: Reactive<number>?,
	Ambient: Reactive<Color3>?,
	LightColor: Reactive<Color3>?,
	LightDirection: Reactive<Vector3>?,
	CameraDirection: Reactive<Vector3>?,
	FieldOfView: Reactive<number>?,
	FitPadding: Reactive<number>?,
	UseViewportModel: Reactive<boolean>?,
	UseCharacterBounds: Reactive<boolean>?,
	UsePortraitBounds: Reactive<boolean>?,
	PortraitUpdateInterval: Reactive<number>?,
	CenterOnRoot: Reactive<boolean>?,
	RenderEffects: Reactive<boolean>?,
	FocusYOffset: Reactive<number>?,
	ModelRotation: Reactive<number>?,
	AnimationName: Reactive<string?>?,
	AnimationLevel: Reactive<number?>?,
	AnimationId: Reactive<AnimationId?>?,
	AnimationLooped: Reactive<boolean>?,
	AnimationSpeed: Reactive<number>?,
	AnimationFadeTime: Reactive<number>?,
	OnModelChanged: ((Model?) -> ())?,
}

local function getTowerAsset(towerName: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local towers = assets and assets:FindFirstChild("Towers")
	local towerAsset = towers and towers:FindFirstChild(towerName)

	if not towerAsset or not towerAsset:IsA("Model") then
		warn(`[TowerViewport] Tower model "{towerName}" was not found in ReplicatedStorage.Assets.Towers.`)
		return nil
	end

	return towerAsset
end

local function findRootPart(model: Model): BasePart?
	local humanoidRootPart = model:FindFirstChild("HumanoidRootPart", true)
	if humanoidRootPart and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end

	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function prepareModel(model: Model, towerName: string, renderEffects: boolean): ModelState
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.CanCollide = false
			descendant.LocalTransparencyModifier = 0
		elseif not renderEffects and (
			descendant:IsA("ParticleEmitter")
			or descendant:IsA("Trail")
			or descendant:IsA("Beam")
		) then
			-- These effects were invisible in cards already. Strip them from the
			-- prepared template so every visible clone is smaller as well.
			descendant:Destroy()
		end
	end

	local rootPart = findRootPart(model)
	if rootPart then
		rootPart.Anchored = true
		-- Normalize the clone's pivot as well as selecting the correct anchor.
		-- Authored PrimaryPart/PivotOffset values may point at a weapon or be rotated.
		model.PrimaryPart = rootPart
		rootPart.PivotOffset = CFrame.identity
	end

	-- Every viewport owns its own WorldModel, so the model can use a stable local origin.
	model:PivotTo(CFrame.identity)

	local boundsCFrame, boundsSize = model:GetBoundingBox()
	return {
		Instance = model,
		TowerName = towerName,
		SourceAsset = nil,
		RootPart = rootPart,
		HasPortraitHead = PortraitCamera.FindPart(model, "Head") ~= nil,
		FocusOffset = boundsCFrame.Position + Vector3.new(0, boundsSize.Y * 0.05, 0),
		BoundsRadius = math.max(boundsSize.Magnitude * 0.5, MINIMUM_BOUNDS_RADIUS),
	}
end

local function clonePreparedModel(asset: Model, towerName: string): (Model, ModelState)
	local prepared = preparedTemplates[asset]
	if not prepared then
		local template = asset:Clone()
		local templateState = prepareModel(template, towerName, false)
		prepared = {
			Model = template,
			FitPointClouds = {},
			HasPortraitHead = templateState.HasPortraitHead,
			FocusOffset = templateState.FocusOffset,
			BoundsRadius = templateState.BoundsRadius,
			LastUsed = 0,
		}
		preparedTemplates[asset] = prepared
		preparedTemplateCount += 1
	end
	preparedTemplateClock += 1
	prepared.LastUsed = preparedTemplateClock

	if preparedTemplateCount > MAX_PREPARED_TEMPLATES then
		local oldestAsset: Model? = nil
		local oldestUse = math.huge
		for cachedAsset, entry in preparedTemplates do
			if entry.LastUsed < oldestUse then
				oldestAsset = cachedAsset
				oldestUse = entry.LastUsed
			end
		end
		if oldestAsset then
			preparedTemplates[oldestAsset].Model:Destroy()
			preparedTemplates[oldestAsset] = nil
			preparedTemplateCount -= 1
		end
	end

	local model = prepared.Model:Clone()
	return model, {
		Instance = model,
		TowerName = towerName,
		SourceAsset = asset,
		RootPart = model.PrimaryPart,
		HasPortraitHead = prepared.HasPortraitHead,
		FocusOffset = prepared.FocusOffset,
		BoundsRadius = prepared.BoundsRadius,
	}
end

local function getModelCFrame(rotation: number): CFrame
	return CFrame.Angles(0, math.rad(rotation), 0)
end

local function updateCamera(
	camera: Camera,
	modelState: ModelState,
	modelCFrame: CFrame,
	fieldOfView: number,
	cameraDirection: Vector3,
	fitPadding: number,
	focusYOffset: number
)
	local direction = if cameraDirection.Magnitude > 0 then cameraDirection.Unit else DEFAULT_CAMERA_DIRECTION
	local clampedFieldOfView = math.clamp(fieldOfView, 1, 120)
	local distance = modelState.BoundsRadius / math.sin(math.rad(clampedFieldOfView) * 0.5) * math.max(fitPadding, 0.5)
	local focus = modelCFrame:PointToWorldSpace(modelState.FocusOffset + Vector3.new(0, focusYOffset, 0))

	camera.FieldOfView = clampedFieldOfView
	camera.CFrame = CFrame.lookAt(focus + direction * distance, focus)
end

local function getAnimation(towerName: string, animationName: string, level: number?): Animation?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local animations = assets and assets:FindFirstChild("Animations")
	local towerAnimations = animations and animations:FindFirstChild(towerName)
	if not towerAnimations then
		return nil
	end

	if level then
		for currentLevel = level, 0, -1 do
			local animation = towerAnimations:FindFirstChild(`{animationName}_{currentLevel}`)
			if animation and animation:IsA("Animation") then
				return animation
			end
		end
	end

	local animation = towerAnimations:FindFirstChild(animationName)
	return if animation and animation:IsA("Animation") then animation else nil
end

local function createAnimation(
	towerName: string,
	animationId: AnimationId?,
	animationName: string?,
	animationLevel: number?
): Animation?
	if animationId ~= nil then
		local animation = Instance.new("Animation")
		local id = tostring(animationId)
		animation.AnimationId = if string.sub(id, 1, 13) == "rbxassetid://" then id else `rbxassetid://{id}`
		return animation
	end

	if not animationName or animationName == "" then
		return nil
	end

	local animation = getAnimation(towerName, animationName, animationLevel)
	if not animation then
		warn(`[TowerViewport] Animation "{animationName}" was not found for tower "{towerName}".`)
		return nil
	end

	return animation:Clone()
end

local function getAnimator(model: Model): Animator?
	local controller = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Humanoid")
	if not controller then
		return nil
	end

	local animator = controller:FindFirstChildOfClass("Animator")
	if animator then
		return animator
	end

	animator = Instance.new("Animator")
	animator.Parent = controller
	return animator
end

local function startAnimation(
	model: Model,
	animation: Animation,
	fadeTime: number,
	setActiveTrack: (AnimationTrack?) -> ()
): () -> ()
	local active = true
	local track: AnimationTrack?

	local thread = task.spawn(function()
		while active and not model:IsDescendantOf(game) do
			model.AncestryChanged:Wait()
		end
		if not active then
			return
		end

		local animator = getAnimator(model)
		if not animator then
			warn(`[TowerViewport] Tower "{model.Name}" has no AnimationController or Humanoid.`)
			return
		end

		local success, result = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if not success then
			warn(`[TowerViewport] Failed to load animation for tower "{model.Name}": {result}`)
			return
		end

		track = result
		track:Play(fadeTime)
		setActiveTrack(track)
	end)

	return function()
		active = false
		if coroutine.status(thread) ~= "dead" then
			task.cancel(thread)
		end

		setActiveTrack(nil)
		if track then
			track:Stop(0)
			track:Destroy()
		end
		animation:Destroy()
	end
end

--[[
	TowerViewport({
		TowerName = "Bacon",
		AnimationName = "Idle",
		ModelRotation = rotationSpring,
		Size = UDim2.fromScale(0.5, 0.5),
	})

	The model is cloned only when TowerName changes. Transform, camera, and playback
	properties can be static values or Vide getters without recreating the model.
]]
return function(props: Props)
	local camera = create("Camera")({ Name = "TowerCamera" })
	local worldModel = create("WorldModel")({ Name = "TowerWorld" })
	local modelState = source(nil :: ModelState?)
	local activeTrack = source(nil :: AnimationTrack?)
	local viewportFrame = source(nil :: ViewportFrame?)
	local viewportFitter = source(nil)
	local viewportFitterRevision = source(0)
	local fittedCamera: CFrame?
	local fittedCameraFitter = nil
	local fittedCameraRevision = -1
	local fittedFieldOfView: number?
	local fittedDirection: Vector3?
	local fittedFocusPosition: Vector3?

	-- Model ownership: clone once per tower and keep each viewport fully isolated.
	effect(function()
		local towerName = read(props.TowerName)
		modelState(nil)

		if not towerName or towerName == "" then
			return
		end

		local towerAsset = getTowerAsset(towerName)
		if not towerAsset then
			return
		end

		local renderEffects = read(props.RenderEffects) ~= false
		local model: Model
		local state: ModelState
		if renderEffects then
			model = towerAsset:Clone()
			state = prepareModel(model, towerName, true)
		else
			model, state = clonePreparedModel(towerAsset, towerName)
		end
		model.Parent = worldModel
		if props.OnModelChanged then
			props.OnModelChanged(model)
		end
		cleanup(function()
			if props.OnModelChanged then
				props.OnModelChanged(nil)
			end
			if modelState() == state then
				modelState(nil)
			end
			model:Destroy()
		end)
		modelState(state)
	end)

	-- ViewportModel caches the model bounds and derives a camera distance from the
	-- actual ViewportFrame dimensions. It is opt-in for views that need a tight fit.
	effect(function()
		local state = modelState()
		local frame = viewportFrame()
		viewportFitter(nil)
		if not read(props.UseViewportModel) or not state or not frame then
			return
		end
		local useCharacterBounds = read(props.UseCharacterBounds) == true
		local usePortraitBounds = read(props.UsePortraitBounds) == true
		if usePortraitBounds and state.HasPortraitHead then
			return
		end
		-- Fit the final orientation immediately; do not show sphere bounds first
		-- and then reframe the animated pose half a second later.
		local rotation = read(props.ModelRotation) or 0
		state.Instance:PivotTo(getModelCFrame(rotation))
		local fitter = ViewportModel.new(frame, camera)
		-- Identical card clones have identical authored geometry. Reuse the
		-- measured point cloud instead of traversing every part on every scroll.
		local prepared = if state.SourceAsset and type(props.ModelRotation) == "number"
			then preparedTemplates[state.SourceAsset]
			else nil
		local fitKey = if prepared then `{rotation}:{useCharacterBounds}:{usePortraitBounds}` else nil
		local cachedPoints = if prepared and fitKey then prepared.FitPointClouds[fitKey] else nil
		local points = fitter:SetModel(state.Instance, useCharacterBounds or usePortraitBounds, usePortraitBounds, cachedPoints)
		if prepared and fitKey and not cachedPoints then
			prepared.FitPointClouds[fitKey] = points
		end
		viewportFitter(fitter)

		local sizeConnection = frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if frame.AbsoluteSize.X <= 0 or frame.AbsoluteSize.Y <= 0 or viewportFitter() ~= fitter then
				return
			end
			-- The camera effect performs calibration after this revision changes.
			-- Doing it here as well doubled the work throughout window-size springs.
			viewportFitterRevision(viewportFitterRevision() + 1)
		end)

		cleanup(function()
			sizeConnection:Disconnect()
			if viewportFitter() == fitter then
				viewportFitter(nil)
			end
		end)
	end)

	-- Spring updates only transform the existing clone and its camera.
	effect(function()
		if read(props.Active) == false then
			return
		end

		local state = modelState()
		if not state then
			return
		end

		local modelCFrame = getModelCFrame(read(props.ModelRotation) or 0)
		state.Instance:PivotTo(modelCFrame)
		if read(props.UsePortraitBounds) == true and state.HasPortraitHead then
			return -- Animated portrait camera owns framing for this rig.
		end
		local fitter = viewportFitter()
		local fitPadding = math.max(read(props.FitPadding) or DEFAULT_FIT_PADDING, 0.5)
		if fitter then
			local fitterRevision = viewportFitterRevision()
			camera.FieldOfView = math.clamp(read(props.FieldOfView) or DEFAULT_FIELD_OF_VIEW, 1, 120)
			local direction = read(props.CameraDirection) or DEFAULT_CAMERA_DIRECTION
			direction = if direction.Magnitude > 0 then direction.Unit else DEFAULT_CAMERA_DIRECTION
			local focusPosition = if read(props.CenterOnRoot) == true and state.RootPart
				then state.RootPart.Position
				else nil
			if fittedCameraFitter ~= fitter or fittedCameraRevision ~= fitterRevision
				or fittedFieldOfView ~= camera.FieldOfView or fittedDirection ~= direction
				or fittedFocusPosition ~= focusPosition then
				fitter:Calibrate()
				-- Use the model's part-level bounds instead of its bounding sphere. This
				-- avoids excessive empty space on tall or wide units.
				local orientation = CFrame.lookAt(Vector3.zero, -direction)
				fittedCamera = fitter:GetMinimumFitCFrame(orientation, focusPosition)
				fittedCameraFitter = fitter
				fittedCameraRevision = fitterRevision
				fittedFieldOfView = camera.FieldOfView
				fittedDirection = direction
				fittedFocusPosition = focusPosition
			end

			local paddingDistance = fitter:GetFitDistance() * (fitPadding - 1)
			camera.CFrame = (fittedCamera :: CFrame)
				* CFrame.new(0, read(props.FocusYOffset) or 0, paddingDistance)
			return
		end

		-- Cached bounds avoid an expensive GetBoundingBox call on every spring step.
		updateCamera(
			camera,
			state,
			modelCFrame,
			read(props.FieldOfView) or DEFAULT_FIELD_OF_VIEW,
			read(props.CameraDirection) or DEFAULT_CAMERA_DIRECTION,
			read(props.FitPadding) or DEFAULT_FIT_PADDING,
			read(props.FocusYOffset) or 0
		)
	end)

	-- Track after animation evaluation. No GetBoundingBox/point-cloud traversal
	-- runs per frame; hidden cards unregister from the shared update loop.
	effect(function()
		local state = modelState()
		local frame = viewportFrame()
		if not state or not frame or read(props.Active) == false
			or read(props.Visible) == false or read(props.UsePortraitBounds) ~= true then
			return
		end
		local stop = PortraitCamera.Track(state.Instance, frame, camera, {
			Padding = math.max(read(props.FitPadding) or DEFAULT_FIT_PADDING, 0.5),
			FieldOfView = math.clamp(read(props.FieldOfView) or DEFAULT_FIELD_OF_VIEW, 1, 120),
			Direction = read(props.CameraDirection) or DEFAULT_CAMERA_DIRECTION,
			FocusYOffset = read(props.FocusYOffset) or 0,
			UpdateInterval = read(props.PortraitUpdateInterval) or 0,
		})
		if stop then
			cleanup(stop)
		end
	end)

	-- Reload only when the model or selected animation changes.
	effect(function()
		if read(props.Active) == false then
			return
		end

		local state = modelState()
		if not state then
			return
		end

		local animation = createAnimation(
			state.TowerName,
			read(props.AnimationId),
			read(props.AnimationName),
			read(props.AnimationLevel)
		)
		if not animation then
			return
		end

		cleanup(startAnimation(state.Instance, animation, read(props.AnimationFadeTime), activeTrack))
	end)

	-- Loop and speed updates are cheap and do not restart the animation.
	effect(function()
		local track = activeTrack()
		if not track then
			return
		end

		track.Looped = read(props.AnimationLooped) ~= false
		track:AdjustSpeed(read(props.AnimationSpeed) or 1)
	end)

	return create("ViewportFrame")({
		Name = props.Name or "TowerViewport",
		AnchorPoint = props.AnchorPoint,
		BackgroundColor3 = props.BackgroundColor3,
		BackgroundTransparency = props.BackgroundTransparency or 1,
		ImageTransparency = props.ImageTransparency or 0,
		BorderSizePixel = 0,
		Position = props.Position,
		Size = props.Size or UDim2.fromScale(1, 1),
		Visible = props.Visible,
		ZIndex = props.ZIndex,
		Ambient = props.Ambient or Color3.fromRGB(180, 180, 180),
		LightColor = props.LightColor or Color3.new(1, 1, 1),
		LightDirection = props.LightDirection or Vector3.new(-1, -1, -1),
		CurrentCamera = camera,
		action(function(instance)
			viewportFrame(instance)
		end),

		camera,
		worldModel,
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">TowerViewport.story</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Vide = require(ReplicatedStorage.Packages.Vide)
local TowerViewport = require(script.Parent.TowerViewport)

local create = Vide.create
local mount = Vide.mount
local source = Vide.source
local spring = Vide.spring

return function(target: Instance)
	local container = Instance.new("Frame")
	container.Name = "TowerViewportStoryContainer"
	container.BackgroundColor3 = Color3.fromRGB(30, 35, 50)
	container.Size = UDim2.fromScale(1, 1)
	container.Parent = target

	local towerName = source("Wizard")
	local rotated = source(false)

	local destroyVide = mount(function()
		local leftRotation = spring(function()
			return if rotated() then 45 else -20
		end, 0.6, 0.75)
		local rightRotation = spring(function()
			return if rotated() then -45 else 20
		end, 0.6, 0.75)

		return create("Frame")({
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),

			TowerViewport({
				Name = "LeftTower",
				TowerName = towerName,
				AnimationName = "Idle",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.3, 0.45),
				Size = UDim2.fromScale(0.38, 0.65),
				ModelRotation = leftRotation,
			}),

			TowerViewport({
				Name = "RightTower",
				TowerName = towerName,
				AnimationName = "Idle",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.7, 0.45),
				Size = UDim2.fromScale(0.38, 0.65),
				ModelRotation = rightRotation,
			}),

			create("TextButton")({
				Name = "ToggleRotation",
				AnchorPoint = Vector2.new(0.5, 1),
				BackgroundColor3 = Color3.fromRGB(82, 120, 255),
				Position = UDim2.fromScale(0.5, 0.95),
				Size = UDim2.fromOffset(180, 42),
				Text = function()
					return if rotated() then "Rotate Back" else "Rotate Towers"
				end,
				TextColor3 = Color3.new(1, 1, 1),
				TextSize = 18,

				MouseButton1Click = function()
					rotated(not rotated())
				end,

				create("UICorner")({
					CornerRadius = UDim.new(0, 8),
				}),
			}),
		})
	end, container)

	return function()
		destroyVide()
		container:Destroy()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">UnitPortraits.story</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Vide = require(ReplicatedStorage.Packages.Vide)
local TowerButton = require(script.Parent.TowerButton)

return {
	vide = Vide,
	summary = "Animated portrait regression: compare face scale and alignment across different rigs and weapons.",
	story = function()
		local cards = {}
		for index, name in { "Fighter", "Galahad", "Knight", "Elder Wizard", "Ganet", "Harvester" } do
			cards[index] = TowerButton({
				TowerName = name,
				TowerData = { Lv = 0 },
				LayoutOrder = index,
				PerformanceMode = true,
				IsSelected = function() return false end,
				IsEquipped = function() return false end,
			})
		end
		return Vide.create("Frame")({
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(25, 25, 30),
			Vide.create("UIPadding")({
				PaddingLeft = UDim.new(0, 16), PaddingTop = UDim.new(0, 16),
			}),
			Vide.create("UIGridLayout")({
				CellSize = UDim2.fromOffset(140, 140),
				CellPadding = UDim2.fromOffset(12, 18),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
			cards,
		})
	end,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">WorldTowerDisplay</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Vide = require(ReplicatedStorage.Packages.Vide)
local ForgeVFX = require(ReplicatedStorage.Shared.Modules.Utils.ForgeVFX)

local cleanup = Vide.cleanup
local create = Vide.create
local effect = Vide.effect
local read = Vide.read
local source = Vide.source

type Reactive<T> = T | (() -> T)

type TransparencyTarget = {
	Instance: Instance,
	Original: any,
	OriginalEnabled: boolean?,
}

type ModelState = {
	Instance: Model,
	EffectRootPart: BasePart?,
	BaseHeight: number,
	BaseWidth: number,
	BaseDepth: number,
	BaseLocalCenter: Vector3,
	BaseScale: number,
	LastScale: number,
	LastTransparency: number,
	TransparencyTargets: { TransparencyTarget },
	BurstEffect: BasePart?,
	BurstEnvironment: any?,
	ExtraBurstEffect: BasePart?,
	ExtraBurstEnvironment: any?,
	StaticEffect: BasePart?,
	StaticOverlay: BasePart?,
	StaticOverlayScale: number,
	EffectsStarted: boolean,
	StaticEnabled: boolean,
}

export type Props = {
	TowerName: Reactive<string?>,
	Rarity: Reactive<string?>?,
	RevealKey: Reactive<any>?,
	Visible: Reactive<boolean>?,
	ScreenPosition: Reactive<Vector2>?,
	ScreenHeight: Reactive<number>?,
	ScreenWidth: Reactive<number>?,
	Depth: Reactive<number>?,
	ModelRotation: Reactive<number>?,
	DisplayScale: Reactive<number>?,
	Transparency: Reactive<number>?,
	AnimationName: Reactive<string?>?,
	AnimationLevel: Reactive<number?>?,
	AnimationLooped: Reactive<boolean>?,
	AnimationSpeed: Reactive<number>?,
	AnimationFadeTime: Reactive<number>?,
	UseCharacterBounds: Reactive<boolean>?,
	Darkened: Reactive<boolean>?,
}

local DEFAULT_SCREEN_POSITION = Vector2.new(0.5, 0.39)
local DEFAULT_SCREEN_HEIGHT = 0.44
local DEFAULT_SCREEN_WIDTH = 0.4
local DEFAULT_DEPTH = 7
local MINIMUM_HEIGHT = 0.01
local SUMMON_EFFECT_SCALE = 0.5
local STATIC_OVERLAY_BACK_OFFSET = 0.32
local STATIC_OCCLUSION_MARGIN = 0.65
local STATIC_OCCLUSION_AREA_SCALE = 1.35
local MINIMUM_CAMERA_DISTANCE = 0.75
local OCCLUSION_PADDING = 0.15
local OCCLUSION_SAMPLE_OFFSETS = {
	Vector2.new(0, 0),
	Vector2.new(-0.45, -0.45),
	Vector2.new(0.45, -0.45),
	Vector2.new(-0.45, 0.45),
	Vector2.new(0.45, 0.45),
	Vector2.new(-0.45, 0),
	Vector2.new(0.45, 0),
	Vector2.new(0, -0.45),
	Vector2.new(0, 0.45),
}
local BOUNDS_CORNER_SIGNS = {
	Vector3.new(-1, -1, -1),
	Vector3.new(-1, -1, 1),
	Vector3.new(-1, 1, -1),
	Vector3.new(-1, 1, 1),
	Vector3.new(1, -1, -1),
	Vector3.new(1, -1, 1),
	Vector3.new(1, 1, -1),
	Vector3.new(1, 1, 1),
}
local CHARACTER_BODY_PART_NAMES = {
	Head = true,
	Torso = true,
	UpperTorso = true,
	LowerTorso = true,
	["Left Arm"] = true,
	["Right Arm"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
}

local function isEffectRarity(rarity: string?): boolean
	return rarity ~= nil and rarity ~= ""
end

local function ensureForgeVFX()
	if not ForgeVFX.setup then
		ForgeVFX.init()
	end
end

local function getTowerAsset(towerName: string): Model?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local towers = assets and assets:FindFirstChild("Towers")
	local towerAsset = towers and towers:FindFirstChild(towerName)

	if not towerAsset or not towerAsset:IsA("Model") then
		warn(`[WorldTowerDisplay] Tower model "{towerName}" was not found in ReplicatedStorage.Assets.Towers.`)
		return nil
	end

	return towerAsset
end

local function findRootPart(model: Model): BasePart?
	local humanoidRootPart = model:FindFirstChild("HumanoidRootPart", true)
	if humanoidRootPart and humanoidRootPart:IsA("BasePart") then
		return humanoidRootPart
	end
	if model.PrimaryPart then
		return model.PrimaryPart
	end

	return model:FindFirstChildWhichIsA("BasePart", true)
end

local function isVisualPart(part: BasePart): boolean
	if part.Transparency < 0.99 then
		return true
	end

	for _, descendant in part:GetDescendants() do
		if
			(descendant:IsA("Decal") or descendant:IsA("Texture"))
			and descendant.Transparency < 0.99
		then
			return true
		end
	end

	return false
end

local function getVisualBounds(model: Model, characterBodyOnly: boolean): (Vector3, Vector3)
	local pivot = model:GetPivot()
	local minimum: Vector3? = nil
	local maximum: Vector3? = nil

	for _, descendant in model:GetDescendants() do
		if
			descendant:IsA("BasePart")
			and isVisualPart(descendant)
			and (not characterBodyOnly or CHARACTER_BODY_PART_NAMES[descendant.Name])
		then
			local localCFrame = pivot:ToObjectSpace(descendant.CFrame)
			local halfSize = descendant.Size * 0.5
			for _, sign in BOUNDS_CORNER_SIGNS do
				local point = localCFrame:PointToWorldSpace(halfSize * sign)
				minimum = if minimum
					then Vector3.new(
						math.min(minimum.X, point.X),
						math.min(minimum.Y, point.Y),
						math.min(minimum.Z, point.Z)
					)
					else point
				maximum = if maximum
					then Vector3.new(
						math.max(maximum.X, point.X),
						math.max(maximum.Y, point.Y),
						math.max(maximum.Z, point.Z)
					)
					else point
			end
		end
	end

	if minimum and maximum then
		return (minimum + maximum) * 0.5, maximum - minimum
	end
	if characterBodyOnly then
		return getVisualBounds(model, false)
	end

	local boundsCFrame, boundsSize = model:GetBoundingBox()
	return pivot:PointToObjectSpace(boundsCFrame.Position), boundsSize
end

local function getSummonEffectTemplate(rarity: string, isStatic: boolean): BasePart?
	local effectFolder = ReplicatedStorage:FindFirstChild("Effect")
	local summonFolder = effectFolder and effectFolder:FindFirstChild("Summon")
	local template
	if rarity == "Absolute" and not isStatic then
		local absoluteFolder = summonFolder and summonFolder:FindFirstChild("Absolute")
		template = absoluteFolder and absoluteFolder:FindFirstChild("Absolute")
	else
		local rarityFolder = if isStatic and summonFolder then summonFolder:FindFirstChild("Static") else summonFolder
		template = rarityFolder and rarityFolder:FindFirstChild(rarity)
	end

	if template and template:IsA("BasePart") then
		return template
	end

	warn(
		`[WorldTowerDisplay] Missing {if isStatic then "static " else ""}summon effect for rarity "{rarity}" at ReplicatedStorage.Effect.Summon.`
	)
	return nil
end

local function getAbsolutePlusTemplate(): BasePart?
	local effectFolder = ReplicatedStorage:FindFirstChild("Effect")
	local summonFolder = effectFolder and effectFolder:FindFirstChild("Summon")
	local absoluteFolder = summonFolder and summonFolder:FindFirstChild("Absolute")
	local template = absoluteFolder and absoluteFolder:FindFirstChild("AbsolutePlus")
	return if template and template:IsA("BasePart") then template else nil
end

local function attachEffectPart(
	template: BasePart,
	model: Model,
	rootPart: BasePart,
	name: string,
	worldCFrame: CFrame?
): BasePart
	local effectPart = template:Clone()
	ForgeVFX.resize(SUMMON_EFFECT_SCALE, effectPart)
	effectPart.Name = name
	effectPart.Anchored = false
	effectPart.CanCollide = false
	effectPart.CanQuery = false
	effectPart.CanTouch = false
	effectPart.CastShadow = false
	effectPart.Massless = true
	effectPart.Transparency = 1
	effectPart.CFrame = worldCFrame or rootPart.CFrame
	effectPart.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Name = "SummonEffectWeld"
	weld.Part0 = rootPart
	weld.Part1 = effectPart
	weld.Parent = effectPart

	return effectPart
end

local function setStaticEffectEnabled(effectPart: BasePart, enabled: boolean)
	if enabled then
		ForgeVFX.enable(effectPart)
	else
		ForgeVFX.disable(effectPart)
	end

	-- ForgeVFX handles its tagged effects plus particles and beams. Keep the
	-- remaining continuous Roblox effect classes in sync with the same state.
	for _, descendant in effectPart:GetDescendants() do
		if
			descendant:IsA("Trail")
			or descendant:IsA("Fire")
			or descendant:IsA("Smoke")
			or descendant:IsA("Sparkles")
			or descendant:IsA("Light")
			or descendant:IsA("Highlight")
		then
			descendant.Enabled = enabled
		end
	end
end

local function createStaticOverlay(template: BasePart): BasePart
	local overlay = template:Clone()
	ForgeVFX.resize(SUMMON_EFFECT_SCALE, overlay)
	overlay.Name = "SummonStaticOverlay"
	overlay.Anchored = true
	overlay.CanCollide = false
	overlay.CanQuery = false
	overlay.CanTouch = false
	overlay.CastShadow = false
	overlay.Massless = true
	overlay.Transparency = 1
	overlay.Parent = workspace.CurrentCamera or workspace
	setStaticEffectEnabled(overlay, false)
	return overlay
end

local function prepareSummonEffects(state: ModelState, rarity: string?)
	local rootPart = state.EffectRootPart
	if not rootPart or not isEffectRarity(rarity) then
		return
	end

	ensureForgeVFX()

	local burstTemplate = getSummonEffectTemplate(rarity :: string, false)
	if burstTemplate then
		state.BurstEffect = attachEffectPart(burstTemplate, state.Instance, rootPart, "SummonBurstEffect")
	end
	if rarity == "Absolute" then
		local extraTemplate = getAbsolutePlusTemplate()
		if extraTemplate then
			local pivot = state.Instance:GetPivot()
			local footPosition = pivot:PointToWorldSpace(
				state.BaseLocalCenter - Vector3.new(0, state.BaseHeight * 0.5, 0)
			)
			local footCFrame = CFrame.new(footPosition) * rootPart.CFrame.Rotation
			state.ExtraBurstEffect = attachEffectPart(
				extraTemplate,
				state.Instance,
				rootPart,
				"SummonAbsolutePlusEffect",
				footCFrame
			)
		end
	end

	local staticTemplate = getSummonEffectTemplate(rarity :: string, true)
	if staticTemplate then
		state.StaticEffect = attachEffectPart(staticTemplate, state.Instance, rootPart, "SummonStaticEffect")
		setStaticEffectEnabled(state.StaticEffect, false)
		state.StaticOverlay = createStaticOverlay(staticTemplate)
	end
end

local function updateSummonEffects(state: ModelState, enabled: boolean)
	if enabled and not state.EffectsStarted then
		state.EffectsStarted = true
		if state.BurstEffect then
			state.BurstEnvironment = ForgeVFX.emit(state.BurstEffect)
		end
		if state.ExtraBurstEffect then
			state.ExtraBurstEnvironment = ForgeVFX.emit(state.ExtraBurstEffect)
		end
	end

	if (not state.StaticEffect and not state.StaticOverlay) or state.StaticEnabled == enabled then
		return
	end

	state.StaticEnabled = enabled
	if state.StaticEffect then
		setStaticEffectEnabled(state.StaticEffect, enabled)
	end
	if state.StaticOverlay then
		setStaticEffectEnabled(state.StaticOverlay, enabled)
	end
end

local function cleanupSummonEffects(state: ModelState)
	if state.BurstEnvironment then
		state.BurstEnvironment.Clear()
		state.BurstEnvironment = nil
	end
	if state.ExtraBurstEnvironment then
		state.ExtraBurstEnvironment.Clear()
		state.ExtraBurstEnvironment = nil
	end
	if state.StaticEffect then
		setStaticEffectEnabled(state.StaticEffect, false)
	end
	if state.StaticOverlay then
		setStaticEffectEnabled(state.StaticOverlay, false)
		state.StaticOverlay:Destroy()
		state.StaticOverlay = nil
	end
end

local function updateStaticOverlay(
	state: ModelState,
	camera: Camera,
	targetCenter: Vector3,
	viewDirection: Vector3,
	displayScaleRatio: number,
	backOffset: number
)
	local overlay = state.StaticOverlay
	if not overlay or not overlay.Parent then
		return
	end
	if overlay.Parent ~= camera then
		overlay.Parent = camera
	end

	local clampedScale = math.max(displayScaleRatio, 0.01)
	if math.abs(state.StaticOverlayScale - clampedScale) > 0.002 then
		ForgeVFX.resize(clampedScale / state.StaticOverlayScale, overlay)
		state.StaticOverlayScale = clampedScale
	end

	local anchorPosition = if state.EffectRootPart and state.EffectRootPart.Parent
		then state.EffectRootPart.Position
		else targetCenter
	-- Keep the persistent aura behind the tower. Burst effects remain attached to
	-- the HumanoidRootPart, while this duplicate supplies the readable backdrop.
	local position = anchorPosition + viewDirection.Unit * backOffset
	overlay.CFrame = CFrame.lookAt(position, position - viewDirection, camera.CFrame.UpVector)
end

local function transformSequence(sequence: NumberSequence, alpha: number): NumberSequence
	local keypoints = table.create(#sequence.Keypoints)
	for index, keypoint in sequence.Keypoints do
		keypoints[index] = NumberSequenceKeypoint.new(
			keypoint.Time,
			keypoint.Value + (1 - keypoint.Value) * alpha,
			keypoint.Envelope * (1 - alpha)
		)
	end
	return NumberSequence.new(keypoints)
end

local function applyTransparency(state: ModelState, alpha: number)
	if math.abs(state.LastTransparency - alpha) < 0.002 then
		return
	end
	state.LastTransparency = alpha

	for _, target in state.TransparencyTargets do
		local instance = target.Instance
		if not instance.Parent then
			continue
		end

		if instance:IsA("BasePart") then
			instance.LocalTransparencyModifier = target.Original + (1 - target.Original) * alpha
		elseif instance:IsA("Decal") or instance:IsA("Texture") then
			instance.Transparency = target.Original + (1 - target.Original) * alpha
		elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") then
			instance.Transparency = transformSequence(target.Original, alpha)
			instance.Enabled = target.OriginalEnabled == true and alpha < 0.995
		elseif instance:IsA("Fire") or instance:IsA("Smoke") or instance:IsA("Sparkles") then
			instance.Enabled = target.Original and alpha < 0.995
		end
	end
end

local function getOcclusionSafeDepth(
	camera: Camera,
	viewportSize: Vector2,
	screenPosition: Vector2,
	screenWidth: number,
	screenHeight: number,
	requestedDepth: number,
	halfDepthRatio: number,
	raycastParams: RaycastParams
): number
	local nearestHitDistance = math.huge
	local castDistance = requestedDepth * (1 + halfDepthRatio) + OCCLUSION_PADDING

	for _, offset in OCCLUSION_SAMPLE_OFFSETS do
		local samplePosition = screenPosition + Vector2.new(screenWidth * offset.X, screenHeight * offset.Y)
		local ray = camera:ViewportPointToRay(
			viewportSize.X * math.clamp(samplePosition.X, 0, 1),
			viewportSize.Y * math.clamp(samplePosition.Y, 0, 1),
			0
		)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * castDistance, raycastParams)
		if hit then
			nearestHitDistance = math.min(nearestHitDistance, hit.Distance)
		end
	end

	if nearestHitDistance == math.huge then
		return requestedDepth
	end

	local safeDepth = (nearestHitDistance - OCCLUSION_PADDING) / (1 + halfDepthRatio)
	return math.clamp(safeDepth, MINIMUM_CAMERA_DISTANCE, requestedDepth)
end

local function getOccluderTargetPoints(
	camera: Camera,
	viewportSize: Vector2,
	screenPosition: Vector2,
	screenWidth: number,
	screenHeight: number,
	depth: number
): { Vector3 }
	local targetPoints = table.create(#OCCLUSION_SAMPLE_OFFSETS)

	for _, offset in OCCLUSION_SAMPLE_OFFSETS do
		local samplePosition = screenPosition + Vector2.new(screenWidth * offset.X, screenHeight * offset.Y)
		local ray = camera:ViewportPointToRay(
			viewportSize.X * math.clamp(samplePosition.X, 0, 1),
			viewportSize.Y * math.clamp(samplePosition.Y, 0, 1),
			0
		)
		table.insert(targetPoints, ray.Origin + ray.Direction * depth)
	end

	return targetPoints
end

local function restoreOccluders(occluders: { [BasePart]: number })
	for part, originalTransparency in occluders do
		if part.Parent then
			part.LocalTransparencyModifier = originalTransparency
		end
	end
	table.clear(occluders)
end

local function getIgnoreInstances(state: ModelState): { Instance }
	local instances: { Instance } = { state.Instance }
	if state.StaticOverlay then
		table.insert(instances, state.StaticOverlay)
	end
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(instances, player.Character)
		end
	end
	return instances
end

local function updateOccluders(
	camera: Camera,
	occluders: { [BasePart]: number },
	targetPoints: { Vector3 },
	active: boolean,
	ignoreInstances: { Instance }
)
	if not active then
		restoreOccluders(occluders)
		return
	end

	local nextOccluders: { [BasePart]: boolean } = {}
	local ok, obscuringParts = pcall(function()
		return camera:GetPartsObscuringTarget(targetPoints, ignoreInstances)
	end)
	if not ok then
		return
	end

	for _, instance in obscuringParts do
		if instance:IsA("BasePart") then
			nextOccluders[instance] = true
			if occluders[instance] == nil then
				occluders[instance] = instance.LocalTransparencyModifier
			end
			instance.LocalTransparencyModifier = 1
		end
	end

	for part, originalTransparency in occluders do
		if not nextOccluders[part] then
			if part.Parent then
				part.LocalTransparencyModifier = originalTransparency
			end
			occluders[part] = nil
		end
	end
end

local function prepareModel(model: Model, useCharacterBounds: boolean): ModelState
	local transparencyTargets = {}
	local rootPart = findRootPart(model)

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BaseScript") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			-- Keep rigged limbs animatable while preventing loose VFX helper parts
			-- from falling away under local physics.
			descendant.Anchored = descendant == rootPart or #descendant:GetJoints() == 0
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
			descendant.Massless = true
			descendant.LocalTransparencyModifier = 0
			table.insert(transparencyTargets, {
				Instance = descendant,
				Original = 0,
			})
		elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
			table.insert(transparencyTargets, {
				Instance = descendant,
				Original = descendant.Transparency,
			})
		elseif descendant:IsA("ParticleEmitter") or descendant:IsA("Beam") or descendant:IsA("Trail") then
			table.insert(transparencyTargets, {
				Instance = descendant,
				Original = descendant.Transparency,
				OriginalEnabled = descendant.Enabled,
			})
		elseif descendant:IsA("Fire") or descendant:IsA("Smoke") or descendant:IsA("Sparkles") then
			table.insert(transparencyTargets, {
				Instance = descendant,
				Original = descendant.Enabled,
			})
		end
	end

	model:PivotTo(CFrame.identity)
	local baseScale = model:GetScale()
	local baseLocalCenter, boundsSize = getVisualBounds(model, useCharacterBounds)

	return {
		Instance = model,
		EffectRootPart = rootPart,
		BaseHeight = math.max(boundsSize.Y, MINIMUM_HEIGHT),
		BaseWidth = math.max(boundsSize.X, MINIMUM_HEIGHT),
		BaseDepth = math.max(boundsSize.Z, MINIMUM_HEIGHT),
		BaseLocalCenter = baseLocalCenter,
		BaseScale = baseScale,
		LastScale = baseScale,
		LastTransparency = -1,
		TransparencyTargets = transparencyTargets,
		BurstEffect = nil,
		BurstEnvironment = nil,
		ExtraBurstEffect = nil,
		ExtraBurstEnvironment = nil,
		StaticEffect = nil,
		StaticOverlay = nil,
		StaticOverlayScale = 1,
		EffectsStarted = false,
		StaticEnabled = false,
	}
end

local function getAnimation(towerName: string, animationName: string, level: number?): Animation?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local animations = assets and assets:FindFirstChild("Animations")
	local towerAnimations = animations and animations:FindFirstChild(towerName)
	if not towerAnimations then
		return nil
	end

	if level then
		for currentLevel = level, 0, -1 do
			local animation = towerAnimations:FindFirstChild(`{animationName}_{currentLevel}`)
			if animation and animation:IsA("Animation") then
				return animation:Clone()
			end
		end
	end

	local animation = towerAnimations:FindFirstChild(animationName)
	return if animation and animation:IsA("Animation") then animation:Clone() else nil
end

local function playAnimation(model: Model, towerName: string, props: Props): () -> ()
	local animationName = read(props.AnimationName)
	if not animationName or animationName == "" then
		return function() end
	end

	local animation = getAnimation(towerName, animationName, read(props.AnimationLevel))
	if not animation then
		warn(`[WorldTowerDisplay] Animation "{animationName}" was not found for tower "{towerName}".`)
		return function() end
	end

	local controller = model:FindFirstChildOfClass("AnimationController") or model:FindFirstChildOfClass("Humanoid")
	local animator = controller and controller:FindFirstChildOfClass("Animator")
	if controller and not animator then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end

	if not animator then
		animation:Destroy()
		return function() end
	end

	local ok, loadedTrack = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if not ok then
		warn(`[WorldTowerDisplay] Failed to load animation for tower "{towerName}": {loadedTrack}`)
		animation:Destroy()
		return function() end
	end

	local track = loadedTrack :: AnimationTrack
	track.Looped = read(props.AnimationLooped) ~= false
	track:Play(read(props.AnimationFadeTime) or 0.1)
	track:AdjustSpeed(read(props.AnimationSpeed) or 1)

	return function()
		track:Stop(0)
		track:Destroy()
		animation:Destroy()
	end
end

return function(props: Props)
	local modelState = source(nil :: ModelState?)

	effect(function()
		local towerName = read(props.TowerName)
		local rarity = read(props.Rarity)
		local _revealKey = read(props.RevealKey)
		modelState(nil)
		if not towerName or towerName == "" then
			return
		end

		local towerAsset = getTowerAsset(towerName)
		if not towerAsset then
			return
		end

		local model = towerAsset:Clone()
		model.Name = `SummonDisplay_{towerName}`
		local state = prepareModel(model, read(props.UseCharacterBounds) == true)
		local darkenHighlight = Instance.new("Highlight")
		darkenHighlight.Name = "SummonAutoSoldDarken"
		darkenHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		darkenHighlight.FillColor = Color3.new(0, 0, 0)
		darkenHighlight.FillTransparency = 0.42
		darkenHighlight.OutlineTransparency = 1
		darkenHighlight.Enabled = read(props.Darkened) == true
		darkenHighlight.Parent = model
		prepareSummonEffects(state, rarity)
		model.Parent = workspace.CurrentCamera
		local stopAnimation = playAnimation(model, towerName, props)
		modelState(state)

		cleanup(function()
			cleanupSummonEffects(state)
			stopAnimation()
			if modelState() == state then
				modelState(nil)
			end
			model:Destroy()
		end)
	end)

	effect(function()
		local state = modelState()
		if not state then
			return
		end

		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.IgnoreWater = true
		local occluders: { [BasePart]: number } = {}

		local connection = RunService.PreRender:Connect(function()
			local camera = workspace.CurrentCamera
			if not camera then
				restoreOccluders(occluders)
				return
			end
			if state.Instance.Parent ~= camera then
				state.Instance.Parent = camera
			end

			local visible = read(props.Visible) ~= false
			local darkened = read(props.Darkened) == true
			local darkenHighlight = state.Instance:FindFirstChild("SummonAutoSoldDarken")
			if darkenHighlight and darkenHighlight:IsA("Highlight") then
				darkenHighlight.Enabled = darkened and visible
			end
			local transparency = if visible then math.clamp(read(props.Transparency) or 0, 0, 1) else 1
			applyTransparency(state, transparency)

			local viewportSize = camera.ViewportSize
			if viewportSize.X <= 0 or viewportSize.Y <= 0 then
				restoreOccluders(occluders)
				return
			end

			local screenPosition = read(props.ScreenPosition) or DEFAULT_SCREEN_POSITION
			local screenHeight = math.max(read(props.ScreenHeight) or DEFAULT_SCREEN_HEIGHT, 0.01)
			local screenWidth = math.max(read(props.ScreenWidth) or DEFAULT_SCREEN_WIDTH, 0.01)
			local requestedDepth = math.max(read(props.Depth) or DEFAULT_DEPTH, 2)
			local ignoreInstances = getIgnoreInstances(state)
			raycastParams.FilterDescendantsInstances = ignoreInstances
			local displayScale = math.max(read(props.DisplayScale) or 1, 0.01)
			local visibleWorldHeight = 2 * requestedDepth * math.tan(math.rad(camera.FieldOfView) * 0.5)
			local visibleWorldWidth = visibleWorldHeight * viewportSize.X / viewportSize.Y
			local heightScale = visibleWorldHeight * screenHeight / state.BaseHeight
			local widthScale = visibleWorldWidth * screenWidth / state.BaseWidth
			local requestedScale = state.BaseScale * math.min(heightScale, widthScale) * displayScale
			local requestedScaleRatio = requestedScale / state.BaseScale
			-- Reserve enough depth for the Static layer as well as the tower body.
			-- Without this, Bookrig can sit between the body-only probe and the aura.
			local requestedBackExtent = state.BaseDepth * requestedScaleRatio * 0.5
				+ STATIC_OVERLAY_BACK_OFFSET
				+ STATIC_OCCLUSION_MARGIN
			local halfDepthRatio = requestedBackExtent / requestedDepth
			local depth = getOcclusionSafeDepth(
				camera,
				viewportSize,
				screenPosition,
				screenWidth,
				screenHeight,
				requestedDepth,
				halfDepthRatio,
				raycastParams
			)
			local targetScale = requestedScale * depth / requestedDepth

			if math.abs(state.LastScale - targetScale) > 0.001 then
				state.Instance:ScaleTo(targetScale)
				state.LastScale = targetScale
			end

			local ray = camera:ViewportPointToRay(
				viewportSize.X * screenPosition.X,
				viewportSize.Y * screenPosition.Y,
				0
			)
			local targetCenter = ray.Origin + ray.Direction * depth
			local facing = CFrame.lookAt(targetCenter, targetCenter - ray.Direction, camera.CFrame.UpVector)
			local rotation = facing.Rotation * CFrame.Angles(0, math.rad(read(props.ModelRotation) or 0), 0)
			local scaleRatio = targetScale / state.BaseScale
			local localCenter = state.BaseLocalCenter * scaleRatio
			local pivotPosition = targetCenter - rotation:VectorToWorldSpace(localCenter)
			state.Instance:PivotTo(CFrame.new(pivotPosition) * rotation)
			local depthRatio = depth / requestedDepth
			local staticBackOffset = STATIC_OVERLAY_BACK_OFFSET * depthRatio
			updateStaticOverlay(state, camera, targetCenter, ray.Direction, scaleRatio, staticBackOffset)

			local displayActive = visible and transparency < 0.9
			local halfDepth = state.BaseDepth * scaleRatio * 0.5
			local targetPoints = getOccluderTargetPoints(
				camera,
				viewportSize,
				screenPosition,
				screenWidth * STATIC_OCCLUSION_AREA_SCALE,
				screenHeight * STATIC_OCCLUSION_AREA_SCALE,
				depth
					+ halfDepth
					+ staticBackOffset
					+ STATIC_OCCLUSION_MARGIN * depthRatio
			)
			updateOccluders(camera, occluders, targetPoints, displayActive, ignoreInstances)
			updateSummonEffects(state, displayActive and not darkened)
		end)

		cleanup(function()
			connection:Disconnect()
			restoreOccluders(occluders)
		end)
	end)

	return create("Frame")({
		Name = "WorldTowerDisplayController",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 0),
		Visible = false,
	})
end
]]></string>
          </Properties>
        </Item>
      </Item>
