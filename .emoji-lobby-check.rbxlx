          <Item class="ModuleScript" referent="571">
            <Properties>
              <string name="Name">SliderModule</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Fusion = require(ReplicatedStorage.Packages.Fusion)

local peek = Fusion.peek
local OnEvent = Fusion.OnEvent

local function updateSliderPosition(inputPosition: Vector3, slider: Frame, handler: GuiButton, process: any?)
	local mouseX = inputPosition.X
	local frameLeft = slider.AbsolutePosition.X
	local frameWidth = slider.AbsoluteSize.X

	local percentage = math.clamp((mouseX - frameLeft) / frameWidth, 0, 1)

	handler.Position = UDim2.new(percentage, 0, handler.Position.Y.Scale, handler.Position.Y.Offset)

	if process then
		process:set(math.floor(percentage * 100))
	end
end

return function(scope, props: { Slider: Frame, Handler: GuiButton, Process: any?, OnRelease: ((value: number) -> ())? })
	local slider = props.Slider
	local handler = props.Handler
	local process = props.Process
	local onRelease = props.OnRelease

	local isDragging = scope:Value(false)

	local function stopDragging()
		if peek(isDragging) then
			isDragging:set(false)

			if onRelease and process then
				onRelease(peek(process))
			end
		end
	end

	table.insert(
		scope,
		slider.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				isDragging:set(true)
				updateSliderPosition(input.Position, slider, handler, process)
			end
		end)
	)

	scope:Hydrate(handler)({
		[OnEvent("InputBegan")] = function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				isDragging:set(true)
			end
		end,
		[OnEvent("MouseButton1Up")] = function()
			stopDragging()
		end,
	})

	table.insert(
		scope,
		UserInputService.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				stopDragging()
			end
		end)
	)

	table.insert(
		scope,
		UserInputService.InputChanged:Connect(function(input)
			if not peek(isDragging) then
				return
			end

			if
				input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch
			then
				return
			end

			updateSliderPosition(input.Position, slider, handler, process)
		end)
	)
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="572">
            <Properties>
              <string name="Name">TopbarFactory</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Topbarplus = require(ReplicatedStorage.Packages.Topbarplus)

local TopbarFactory = {}
local Factory = {}
Factory.__index = Factory

TopbarFactory.Assets = table.freeze({
	Emote = "rbxassetid://111864869864776",
	Exit = "rbxassetid://100029434862717",
	Speed = "rbxassetid://108383245414954",
	Settings = "rbxassetid://119479235757807",
})

local ICON_THEME = {
	{ "Widget", "DesiredWidth", 46 },
	{ "Widget", "MinimumWidth", 46 },
	{ "Widget", "MinimumHeight", 46 },
	{ "Widget", "BorderSize", 0 },
	{ "IconButton", "BackgroundColor3", Color3.fromRGB(20, 20, 23) },
	{ "IconButton", "BackgroundTransparency", 1 },
	{ "IconCorners", "CornerRadius", UDim.new(1, 0) },
	{ "IconImageScale", "Value", 0.5 },
	{ "IconSpot", "BackgroundColor3", Color3.fromRGB(18, 18, 21) },
	{ "IconSpot", "BackgroundTransparency", 0.08 },
	{ "IconSpot", "BackgroundTransparency", 0.08, "Selected" },
}

local GROUP_THEME = {
	{ "Widget", "DesiredWidth", 46 },
	{ "Widget", "MinimumWidth", 46 },
	{ "Widget", "MinimumHeight", 46 },
	{ "Widget", "BorderSize", 0 },
	{ "IconButton", "BackgroundColor3", Color3.fromRGB(20, 20, 23) },
	{ "IconButton", "BackgroundTransparency", 1 },
	{ "IconCorners", "CornerRadius", UDim.new(0, 17) },
	{ "IconImageScale", "Value", 0.5 },
	{ "IconSpot", "BackgroundTransparency", 1 },
	{ "IconSpot", "BackgroundTransparency", 1, "Selected" },
}

local GROUP_CONTAINER_THEME = {
	{ "Widget", "MinimumHeight", 46 },
	{ "Widget", "BorderSize", 0 },
	{ "IconButton", "BackgroundTransparency", 1 },
	{ "IconCorners", "CornerRadius", UDim.new(1, 0) },
	{ "Menu", "BackgroundColor3", Color3.fromRGB(18, 18, 21) },
	{ "Menu", "BackgroundTransparency", 0.08 },
	{ "MenuUIListLayout", "Padding", UDim.new(0, 0) },
}

function TopbarFactory.new()
	local rightHolder = Topbarplus.container.TopbarStandard.Holders.Right
	local rightLayout = rightHolder:FindFirstChildOfClass("UIListLayout")
	if rightLayout then
		rightLayout.Padding = UDim.new(0, 6)
	end

	return setmetatable({
		_icons = {},
		_connections = {},
	}, Factory)
end

function Factory:_rememberIcon(icon)
	table.insert(self._icons, icon)
	return icon
end

function Factory:TrackConnection(connection)
	table.insert(self._connections, connection)
	return connection
end

function Factory:CreateImage(assetName: string, caption: string, order: number, standalone: boolean?)
	local image = TopbarFactory.Assets[assetName] or assetName
	local icon = self:_rememberIcon(Topbarplus.new())
	icon:setImage(image)
	icon:setImageScale(0.54)
	icon:setCaption(caption)
	icon:setOrder(order)

	if standalone ~= false then
		icon:align("Right")
		icon:modifyTheme(ICON_THEME)
	end

	return icon
end


function Factory:CreateLabel(label: string, caption: string, width: number?)
	local icon = self:_rememberIcon(Topbarplus.new())
	icon:setLabel(label)
	icon:setWidth(width or 64)
	icon:setTextSize(15)
	icon:setCaption(caption)
	return icon
end

function Factory:CreateGroup(icons: { any }, order: number)
	local groupIcon = self:_rememberIcon(Topbarplus.new())
	groupIcon:align("Right")
	groupIcon:setOrder(order)
	groupIcon:modifyChildTheme(GROUP_THEME)
	groupIcon:setFixedMenu(icons)
	groupIcon:modifyTheme(GROUP_CONTAINER_THEME)

	local menu = groupIcon:getInstance("Menu")
	local menuCorner = Instance.new("UICorner")
	menuCorner.Name = "GroupCorner"
	menuCorner.CornerRadius = UDim.new(1, 0)
	menuCorner.Parent = menu

	return groupIcon
end

function Factory:BindToggle(icon, onOpen: () -> (), onClose: () -> ())
	self:TrackConnection(icon.selected:Connect(onOpen))
	self:TrackConnection(icon.deselected:Connect(onClose))
	return icon
end

function Factory:BindOneClick(icon, callback: () -> ())
	icon:oneClick()
	self:TrackConnection(icon.selected:Connect(callback))
	return icon
end

function Factory:Destroy()
	for index = #self._connections, 1, -1 do
		self._connections[index]:Disconnect()
	end
	table.clear(self._connections)

	for index = #self._icons, 1, -1 do
		self._icons[index]:destroy()
	end
	table.clear(self._icons)
end

return TopbarFactory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="573">
            <Properties>
              <string name="Name">UIBillboard</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")

export type Id = number | string

export type View<T> = {
	Gui: GuiObject,
	SetContent: (content: T) -> (),
	Destroy: () -> (),
}

export type Config<T> = {
	Name: string?,
	Parent: Instance?,
	DisplayOrder: number?,
	CreateView: (content: T) -> View<T>,
}

export type Options = {
	Adornee: BasePart,
	Offset: Vector3?,
	Size: Vector2,
	MinHeight: number?,
	Enabled: boolean?,
}

export type Renderer<T> = {
	Attach: (self: Renderer<T>, id: Id, options: Options, content: T) -> (),
	Update: (self: Renderer<T>, id: Id, content: T) -> (),
	SetEnabled: (self: Renderer<T>, id: Id, enabled: boolean) -> (),
	Remove: (self: Renderer<T>, id: Id) -> (),
	Render: (self: Renderer<T>, camera: Camera?) -> (),
	Destroy: (self: Renderer<T>) -> (),
}

type Entry<T> = {
	Adornee: BasePart,
	Offset: Vector3,
	Size: Vector2,
	MinHeight: number,
	Enabled: boolean,
	Content: T,
	Dirty: boolean,
	View: View<T>?,
}

local function getScreenBounds<T>(entry: Entry<T>, camera: Camera, projectionScale: number): (Vector2?, Vector2?, number?)
	if not entry.Enabled or not entry.Adornee.Parent then
		return nil, nil, nil
	end

	local position = camera:WorldToViewportPoint(entry.Adornee.Position + entry.Offset)
	if position.Z <= 0 then
		return nil, nil, nil
	end

	local size = entry.Size * (projectionScale / position.Z)
	if size.Y < entry.MinHeight then
		return nil, nil, nil
	end

	local viewport = camera.ViewportSize
	if
		position.X + size.X / 2 < 0
		or position.X - size.X / 2 > viewport.X
		or position.Y + size.Y / 2 < 0
		or position.Y - size.Y / 2 > viewport.Y
	then
		return nil, nil, nil
	end

	return Vector2.new(position.X, position.Y), size, position.Z
end

local UIBillboard = {}

function UIBillboard.new<T>(config: Config<T>): Renderer<T>
	local entries: { [Id]: Entry<T> } = {}
	local availableViews: { View<T> } = {}
	local destroyed = false

	local container = Instance.new("ScreenGui")
	container.Name = config.Name or "UIBillboards"
	container.IgnoreGuiInset = true
	container.ResetOnSpawn = false
	container.DisplayOrder = config.DisplayOrder or 0
	container.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	container.Enabled = false
	container.Parent = config.Parent or Players.LocalPlayer:WaitForChild("PlayerGui")

	local function releaseView(entry: Entry<T>)
		local view = entry.View
		if view then
			view.Gui.Visible = false
			entry.View = nil
			table.insert(availableViews, view)
		end
	end

	local function clearViews()
		for _, view in availableViews do
			view.Destroy()
		end
		table.clear(availableViews)
	end

	local renderer = {} :: Renderer<T>

	function renderer:Attach(id: Id, options: Options, content: T)
		assert(not destroyed, "Destroyed 된 UIBillboard 개체임.")
		self:Remove(id)
		entries[id] = {
			Adornee = options.Adornee,
			Offset = options.Offset or Vector3.zero,
			Size = options.Size,
			MinHeight = options.MinHeight or 0,
			Enabled = options.Enabled ~= false,
			Content = content,
			Dirty = true,
		}
	end

	function renderer:Update(id: Id, content: T)
		local entry = entries[id]
		if entry then
			entry.Content = content
			entry.Dirty = true
		end
	end

	function renderer:SetEnabled(id: Id, enabled: boolean)
		local entry = entries[id]
		if entry then
			entry.Enabled = enabled
			if not enabled then
				releaseView(entry)
			end
		end
	end

	function renderer:Remove(id: Id)
		local entry = entries[id]
		if not entry then
			return
		end

		releaseView(entry)
		entries[id] = nil
		if next(entries) == nil then
			container.Enabled = false
			clearViews()
		end
	end

	function renderer:Render(camera: Camera?)
		if destroyed then
			return
		end

		local currentCamera = camera or workspace.CurrentCamera
		container.Enabled = currentCamera ~= nil and next(entries) ~= nil
		if not currentCamera or not container.Enabled then
			return
		end

		local projectionScale = currentCamera.ViewportSize.Y / (2 * math.tan(math.rad(currentCamera.FieldOfView) * 0.5))
		for _, entry in entries do
			local position, size, depth = getScreenBounds(entry, currentCamera, projectionScale)
			if not position or not size or not depth then
				releaseView(entry)
				continue
			end

			local view = entry.View
			if not view then
				view = table.remove(availableViews) or config.CreateView(entry.Content)
				view.Gui.Visible = false
				view.Gui.AnchorPoint = Vector2.new(0.5, 0.5)
				view.Gui.Parent = container
				entry.View = view
				entry.Dirty = true
			end

			if entry.Dirty then
				view.SetContent(entry.Content)
				entry.Dirty = false
			end

			local gui = view.Gui
			local guiPosition = UDim2.fromOffset(position.X, position.Y)
			local guiSize = UDim2.fromOffset(size.X, size.Y)
			local guiIndex = -depth * 2
			if gui.Position ~= guiPosition then
				gui.Position = guiPosition
			end
			if gui.Size ~= guiSize then
				gui.Size = guiSize
			end
			if gui.ZIndex ~= guiIndex then
				gui.ZIndex = guiIndex
			end
			gui.Visible = true
		end
	end

	function renderer:Destroy()
		if destroyed then
			return
		end
		destroyed = true
		for _, entry in entries do
			releaseView(entry)
		end
		table.clear(entries)
		clearViews()
		container:Destroy()
	end

	return renderer
end

return UIBillboard
]]></string>
            </Properties>
